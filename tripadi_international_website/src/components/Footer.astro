---
import { allCategories, allUseCases, companyInfo } from '../lib/catalog';
const year = new Date().getFullYear();
---
<footer class="hairline mt-0 bg-mist">
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="text-[17px] font-semibold tracking-[-0.02em] text-ink-900">Tripadi International</p>
        <p class="mt-3 max-w-xs text-[14px] leading-relaxed text-ink-600">
          {companyInfo.positioning}
        </p>
        <p class="mt-5 text-[13px] text-ink-500">
          {companyInfo.address.city}, {companyInfo.address.state}<br />
          {companyInfo.address.country}
        </p>
        <div class="mt-5 flex flex-wrap gap-3 text-[13px]">
          <a href={`tel:${companyInfo.phone.replace(/\s/g, '')}`} class="text-brass-600 hover:text-brass-700">{companyInfo.phone}</a>
          <span class="text-ink-300">·</span>
          <a href={`mailto:${companyInfo.email}`} class="text-brass-600 hover:text-brass-700">{companyInfo.email}</a>
        </div>
      </div>

      <div class="md:col-span-2">
        <p class="text-[13px] font-semibold text-ink-900">Collections</p>
        <ul class="mt-4 space-y-2.5">
          {allCategories.map((c) => (
            <li><a href={`/collections/${c.slug}`} class="text-[13px] text-ink-600 hover:text-ink-900">{c.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="text-[13px] font-semibold text-ink-900">In Use</p>
        <ul class="mt-4 space-y-2.5">
          {allUseCases.slice(0, 6).map((u) => (
            <li><a href={`/in-use/${u.slug}`} class="text-[13px] text-ink-600 hover:text-ink-900">{u.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="text-[13px] font-semibold text-ink-900">Trade</p>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/wholesale" class="text-[13px] text-ink-600 hover:text-ink-900">Bulk & wholesale</a></li>
          <li><a href="/enquiry" class="text-[13px] text-ink-600 hover:text-ink-900">My enquiry list</a></li>
          <li><a href="/private-label" class="text-[13px] text-ink-600 hover:text-ink-900">Private label & OEM</a></li>
          <li><a href="/export" class="text-[13px] text-ink-600 hover:text-ink-900">Export & shipping</a></li>
          <li><a href="/materials-and-finishes" class="text-[13px] text-ink-600 hover:text-ink-900">Materials & finishes</a></li>
          <li><a href="/catalogue" class="text-[13px] text-ink-600 hover:text-ink-900">Download catalogue</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="text-[13px] font-semibold text-ink-900">Company</p>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/about" class="text-[13px] text-ink-600 hover:text-ink-900">About</a></li>
          <li><a href="/factory" class="text-[13px] text-ink-600 hover:text-ink-900">The factory</a></li>
          <li><a href="/shop" class="text-[13px] text-ink-600 hover:text-ink-900">Shop</a></li>
          <li><a href="/contact" class="text-[13px] text-ink-600 hover:text-ink-900">Contact</a></li>
          <li><a href="/journal" class="text-[13px] text-ink-600 hover:text-ink-900">Journal</a></li>
        </ul>
      </div>
    </div>

    <div class="hairline mt-14 flex flex-col gap-4 pt-6 text-[12px] text-ink-500 md:flex-row md:items-center md:justify-between">
      <p>© {year} {companyInfo.name}. Manufacturer & exporter, Moradabad, India.</p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/terms" class="hover:text-ink-800">Terms</a>
        <a href="/privacy" class="hover:text-ink-800">Privacy</a>
        <a href="/shipping-and-returns" class="hover:text-ink-800">Shipping & returns</a>
        <a href="/sitemap-index.xml" class="hover:text-ink-800">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
