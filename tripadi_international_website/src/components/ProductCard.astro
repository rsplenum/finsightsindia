---
import Photo from './Photo.astro';
import { metalLabels, formatINR, type Product } from '../lib/catalog';

interface Props {
  product: Product;
  showPrice?: boolean;
  eager?: boolean;
}
const { product, showPrice = false, eager = false } = Astro.props;
---
<article class="reveal group">
  <a href={`/products/${product.slug}`} class="block">
    <Photo
      src={product.images.hero}
      alt={product.name}
      label={product.name}
      ratio="4 / 3"
      priority={eager}
      class="rounded-xl transition-[transform,box-shadow] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:shadow-[0_18px_50px_-24px_rgba(0,0,0,0.35)]"
    />
    <div class="mt-4">
      <p class="text-[11px] font-medium tracking-[0.1em] text-ink-500 uppercase">
        {metalLabels[product.metal]}
      </p>
      <h3 class="mt-1.5 text-[16px] leading-snug font-medium text-ink-900">{product.name}</h3>
      <p class="mt-1.5 line-clamp-2 text-[13px] leading-relaxed text-ink-600">{product.summary}</p>
      <div class="mt-3 flex items-center gap-3 text-[12px]">
        {showPrice && product.retail.available ? (
          <span class="font-medium text-ink-900">{formatINR(product.retail.price_inr)}</span>
        ) : (
          <span class="text-ink-500">MOQ {product.moq} pcs</span>
        )}
        <span class="text-ink-300">·</span>
        <span class="text-brass-600 transition-transform duration-300 group-hover:translate-x-0.5">View</span>
      </div>
    </div>
  </a>
</article>
