---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { companyInfo } from '../lib/catalog';
import { breadcrumbSchema } from '../lib/seo';
const siteUrl = Astro.site?.toString() ?? '';
---
<BaseLayout
  title="Inside the Factory — Nine Processes Under One Roof | Tripadi International"
  description="Spinning, casting, hammering, welding, polishing, plating, PVD and in-house tool making — the nine processes behind every piece of Tripadi metalware, in our own factory in Moradabad."
  schema={breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'The Factory', url: '/factory' }], siteUrl)}
>
  <section class="relative">
    <Photo src="/lifestyle/factory-floor.jpg" alt="The Tripadi International factory floor" label="Factory floor" ratio="21 / 9" priority={true} tone="dark" sizes="100vw" class="min-h-[50vh] w-full" />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0">
      <div class="container-page pb-10 md:pb-16">
        <p class="text-[12px] font-semibold tracking-[0.14em] text-white/80 uppercase">The factory</p>
        <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-[-0.024em] text-white md:text-5xl md:leading-[1.08]">
          Nine processes, one roof, one owner.
        </h1>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow">Why it matters</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.022em] text-ink-900 md:text-4xl">
            A factory that outsources its plating cannot promise you a finish.
          </h2>
        </div>
        <div class="lg:col-span-7 space-y-5 text-[16px] leading-relaxed text-ink-700">
          <p>
            Most workshops in this city do one or two operations and job out the rest. The piece
            travels — to a polisher across town, to a plating shop, to somebody else's welder. Every
            move is a week and a chance for a batch to come back inconsistent.
          </p>
          <p>
            We do all of it here. That is why we can hold a lead time, why a batch of five hundred
            charger plates matches, and why a change of mind on day ten of an order is a conversation
            rather than a catastrophe.
          </p>
          <p>
            It is also why we cut our own dies. If you bring us a drawing, the tool is made in this
            building, it stays in this building, and your pattern is not quietly offered to the next
            buyer who walks in.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist section-tight">
    <div class="container-page">
      <p class="eyebrow">The processes</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-0.022em] text-ink-900 md:text-4xl">
        Sheet and ingot in one door, finished piece out the other.
      </h2>
      <ol class="mt-12 grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
        {companyInfo.factory.processes.map((p, i) => (
          <li class="reveal border-t border-ink-300 pt-4">
            <span class="text-[12px] font-semibold text-brass-600">{String(i + 1).padStart(2, '0')}</span>
            <p class="mt-2 text-[16px] font-medium text-ink-900">{p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <Photo src="/lifestyle/factory-polishing.jpg" alt="Polishing at the Tripadi factory" label="Polishing bay" ratio="4 / 3" class="rounded-2xl" sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
        <div class="lg:col-span-6">
          <p class="eyebrow">Quality</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">
            Checked four times, and you can watch any of them.
          </h2>
          <dl class="mt-8 divide-y divide-ink-200 border-t border-ink-200">
            {[
              { t: 'Incoming material', d: 'Grade and gauge verified on every coil and ingot. 304 where 304 is specified — the single most common substitution in this industry, and the easiest to catch at the door.' },
              { t: 'In process', d: 'Weld seams, wall thickness after spinning, and the seat of every hinge before it is pinned.' },
              { t: 'After finishing', d: 'Plating thickness, antiquing consistency across the batch, and a water test on every piece that pours.' },
              { t: 'Before packing', d: 'Photographs of the packed batch sent to you before the container is sealed. Third-party inspection welcome on any order.' },
            ].map((q) => (
              <div class="py-4">
                <dt class="text-[15px] font-medium text-ink-900">{q.t}</dt>
                <dd class="mt-1.5 text-[14px] leading-relaxed text-ink-600">{q.d}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-6 text-[14px] leading-relaxed text-ink-600">
            Want to see it rather than read about it? We will walk the floor on a video call, on your
            schedule, before you place anything.
          </p>
        </div>
      </div>
    </div>
  </section>

  <InquiryForm variant="wholesale" />
</BaseLayout>
