---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { allProducts, allCategories, companyInfo } from '../../lib/catalog';
import { breadcrumbSchema } from '../../lib/seo';

const retail = allProducts.filter((p) => p.retail.available);
const siteUrl = Astro.site?.toString() ?? '';
---
<BaseLayout
  title="Shop — Buy Hotel-Grade Metalware Direct from the Factory | Tripadi International"
  description="Buy chafing dishes, copper handis, hammered trays, wine coolers and charger plates one piece at a time, direct from our Moradabad factory. Secure card, UPI and netbanking. Delivered across India."
  schema={breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Shop', url: '/shop' }], siteUrl)}
>
  <section class="section-tight border-b border-ink-200">
    <div class="container-page">
      <p class="eyebrow">Retail</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.025em] text-ink-900 md:text-[52px] md:leading-[1.06]">
        The same pieces we ship to hotels. One at a time.
      </h1>
      <p class="mt-6 max-w-xl text-[16px] leading-relaxed text-ink-600">
        No retailer between you and the factory, so the price is what a hotel would pay for a small
        quantity rather than what a shop would charge you.
      </p>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-[13px] text-ink-700">
        <span>Free delivery above ₹{companyInfo.retail.free_shipping_above_inr.toLocaleString('en-IN')}</span>
        <span class="text-ink-300">·</span>
        <span>{companyInfo.retail.returns_days}-day returns</span>
        <span class="text-ink-300">·</span>
        <span>Secure card, UPI & netbanking</span>
        <span class="text-ink-300">·</span>
        <span>Prices include GST</span>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-page">
      <nav class="flex flex-wrap gap-2" aria-label="Shop categories">
        <a href="/shop" class="rounded-full bg-ink-900 px-4 py-2 text-[13px] font-medium text-white">All</a>
        {allCategories.map((c) => (
          <a href={`/collections/${c.slug}`} class="rounded-full border border-ink-300 px-4 py-2 text-[13px] font-medium text-ink-700 transition-colors hover:border-ink-900">
            {c.name}
          </a>
        ))}
      </nav>

      <div class="mt-14 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {retail.map((p, i) => <ProductCard product={p} showPrice={true} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <section class="bg-mist section-tight">
    <div class="container-page">
      <div class="mx-auto grid max-w-4xl gap-10 md:grid-cols-3">
        {[
          { t: 'Made, not sourced', d: 'Every piece here is made in our own factory in Moradabad. Nothing on this site is bought in and re-badged.' },
          { t: 'Hotel specification', d: 'These are not a domestic version of the trade range. They are the trade range, sold in ones.' },
          { t: 'Talk to the maker', d: 'A question about a finish or a size goes to the factory, not to a call centre.' },
        ].map((f) => (
          <div>
            <h3 class="text-[16px] font-medium text-ink-900">{f.t}</h3>
            <p class="mt-2.5 text-[14px] leading-relaxed text-ink-600">{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
