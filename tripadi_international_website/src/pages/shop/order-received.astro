---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { companyInfo } from '../../lib/catalog';
---
<BaseLayout title="Order received | Tripadi International" description="Thank you for your order." noindex={true}>
  <section class="section">
    <div class="container-page">
      <div class="mx-auto max-w-xl text-center">
        <svg viewBox="0 0 48 48" class="mx-auto h-12 w-12 text-brass-500" fill="none" stroke="currentColor" stroke-width="1.2">
          <circle cx="24" cy="24" r="21" />
          <path d="m15 24.5 6.5 6.5L33 19" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h1 class="mt-8 text-3xl font-semibold tracking-[-0.024em] text-ink-900 md:text-4xl">Thank you.</h1>
        <p class="mt-5 text-[16px] leading-relaxed text-ink-600">
          Your order has reached the factory. You will get a confirmation by email, and we will be in
          touch if anything about the finish or the delivery needs a decision.
        </p>
        <p class="mt-4 text-[14px] text-ink-500" data-ref hidden></p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="/shop" class="rounded-full bg-ink-900 px-6 py-3 text-[14px] font-medium text-white transition-opacity hover:opacity-85">Continue shopping</a>
          <a href={`mailto:${companyInfo.sales_email}`} class="rounded-full border border-ink-300 px-6 py-3 text-[14px] font-medium text-ink-800 transition-colors hover:border-ink-900">Contact us about this order</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const ref = new URLSearchParams(location.search).get('ref');
  const el = document.querySelector<HTMLElement>('[data-ref]');
  if (ref && el) {
    el.textContent = `Payment reference: ${ref}`;
    el.hidden = false;
  }
</script>
