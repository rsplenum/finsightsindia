---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { faqSchema, breadcrumbSchema } from '../lib/seo';
const siteUrl = Astro.site?.toString() ?? '';
const faqs = [
  { q: 'What does tooling cost and who owns it?', a: 'A die for an embossed rim or a logo typically runs a few hundred dollars depending on complexity, quoted once, before anything is made. You own the pattern: we do not offer it to another buyer, and on repeat programmes we will amortise the tooling into the unit price so the up-front number disappears.' },
  { q: 'What is your minimum for a private-label run?', a: 'Lower than you expect. Logo etching starts at 50 pieces because it needs no tool. An embossed or cast logo starts at 200, because that is where cutting a die makes sense. A bespoke shape from your drawing depends entirely on the shape — send it and we will tell you honestly.' },
  { q: 'Can you produce to our drawings and our packaging?', a: 'Yes to both. We work from CAD, from a technical drawing, from a photograph, or from a physical sample you post to us. Packaging can be neutral, your own printed carton, or retail-ready with your barcodes.' },
  { q: 'Will you make something you already make for someone else?', a: 'Our own catalogue, yes — it is our catalogue. A piece developed against another buyer\'s drawing or tool, never. That distinction is the whole basis of a private-label relationship.' },
  { q: 'How long does development take?', a: 'A finish swatch: about a week. A sample from an existing tool with your branding: 7–10 days. A new tool and first sample: typically 3–4 weeks, then production on normal lead times.' },
];
---
<BaseLayout
  title="Private Label & OEM Metalware Manufacturing | Tripadi International"
  description="Private-label and OEM hospitality metalware from our own factory in Moradabad. Your drawings or ours, your logo on the piece, your packaging. In-house tooling from 200 pieces."
  schema={[faqSchema(faqs), breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Private Label', url: '/private-label' }], siteUrl)]}
>
  <section class="section-tight">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">Private label & OEM</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-[-0.025em] text-ink-900 md:text-[52px] md:leading-[1.06]">
            Your name on the piece. Your tool in our building.
          </h1>
          <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-ink-700">
            We cut our own dies, which changes what is possible. A bespoke rim, a cast crest, a
            handle profile that is yours alone — these are quoted here as a tooling cost and a unit
            price, not refused as impossible below ten thousand pieces.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#inquiry" class="rounded-full bg-ink-900 px-6 py-3 text-[14px] font-medium text-white transition-opacity hover:opacity-85">Start a programme</a>
            <a href="/factory" class="rounded-full border border-ink-300 px-6 py-3 text-[14px] font-medium text-ink-800 transition-colors hover:border-ink-900">See the tool room</a>
          </div>
        </div>
        <div class="lg:col-span-5">
          <Photo src="/lifestyle/tool-room.jpg" alt="Die and tool making at the Tripadi factory" label="Tool room" ratio="4 / 3" priority={true} class="rounded-2xl" sizes="(min-width: 1024px) 42vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist section-tight">
    <div class="container-page">
      <p class="eyebrow">Four ways to make it yours</p>
      <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {[
          { t: 'Branding on our range', d: 'Our pieces, your logo — etched, embossed, chased or plated. From 50 pieces. No tooling for etched work.', moq: 'From 50 pcs' },
          { t: 'Finish development', d: 'Our shapes in a finish developed against your scheme. Swatch first, then a sample, then production.', moq: 'From 100 pcs' },
          { t: 'Bespoke pieces', d: 'Your drawing, our tool room. A new die, a first sample for approval, then a production run that is yours alone.', moq: 'From 200 pcs' },
          { t: 'Full private label', d: 'Your brand end to end — piece, finish, printed carton, barcodes, and documentation in your name for your own customers.', moq: 'Talk to us' },
        ].map((o) => (
          <div class="reveal rounded-2xl border border-ink-200 bg-white p-7">
            <h3 class="text-[17px] font-medium text-ink-900">{o.t}</h3>
            <p class="mt-3 text-[14px] leading-relaxed text-ink-600">{o.d}</p>
            <p class="mt-5 text-[12px] font-medium tracking-[0.08em] text-brass-600 uppercase">{o.moq}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">The awkward questions, answered</h2>
        <div class="mt-8 divide-y divide-ink-200 border-y border-ink-200">
          {faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-[15px] font-medium text-ink-900">
                {f.q}
                <span class="mt-1 shrink-0 text-ink-400 transition-transform duration-300 group-open:rotate-45">
                  <svg viewBox="0 0 14 14" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 1v12M1 7h12" stroke-linecap="round"/></svg>
                </span>
              </summary>
              <p class="mt-3 text-[14px] leading-relaxed text-ink-700">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <InquiryForm variant="private-label" id="inquiry" />
</BaseLayout>
