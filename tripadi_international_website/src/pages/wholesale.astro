---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { companyInfo, whatsappLink } from '../lib/catalog';
import { faqSchema, breadcrumbSchema } from '../lib/seo';

const siteUrl = Astro.site?.toString() ?? '';

const steps = [
  { n: '01', t: 'Send the list', d: 'Build an enquiry list as you browse, or just describe what you need. Quantities help; exact ones are not required at this stage.' },
  { n: '02', t: 'Quote in one working day', d: 'Unit price by quantity band, MOQ, finish options, packing and a lead time. In your currency, on your Incoterm.' },
  { n: '03', t: 'Samples', d: `Approved samples ship in ${companyInfo.capacity.sample_lead_time_days} days. Sample cost is credited against your first production order.` },
  { n: '04', t: 'Production', d: `${companyInfo.capacity.production_lead_time_days} days. Photographs of the batch before it is packed, so nothing is a surprise at the port.` },
  { n: '05', t: 'Shipping', d: `${companyInfo.trade.incoterms.join(', ')}. Documentation handled here — invoice, packing list, certificate of origin, and any inspection your buyer requires.` },
];

const faqs = [
  { q: 'What is your minimum order quantity?', a: 'It varies by item. Cast brass pieces start at 10; pressed steel items at 20–50. Mixed orders across items are welcome — the MOQ applies per item, not per order. Tell us your list and we will confirm exactly.' },
  { q: 'Do you supply samples before a bulk order?', a: `Yes, and we recommend it. Samples ship in ${companyInfo.capacity.sample_lead_time_days} days and the cost is credited against your first production order. For a custom finish we will send a finish swatch first, which is faster and cheaper than a full sample.` },
  { q: 'Can you make a piece to our own drawing?', a: 'Yes. We cut our own dies, so a bespoke piece is a tooling quote plus a unit price rather than a flat refusal. Send a drawing, a photograph, or a physical sample. Tooling is quoted separately and, on repeat programmes, amortised into the unit price.' },
  { q: 'What are your payment terms?', a: companyInfo.trade.payment_terms },
  { q: 'Which ports do you ship from?', a: `${companyInfo.trade.ports.join(', ')}. We are 170 km from Delhi, so ICD Tughlakabad is usually fastest for LCL and air.` },
  { q: 'Can you put our logo on the pieces?', a: 'Yes — etched, embossed, chased or plated depending on the metal and finish. Logo work adds no lead time on most items. For an embossed logo we cut a die, which is a one-time cost that stays yours.' },
  { q: 'Do you work with distributors on an exclusive basis?', a: 'For a serious volume commitment in a defined territory, yes — that conversation is worth having directly with Rajendra Sharma.' },
  { q: 'How do we know the quality before committing?', a: 'Three ways, in order of cost: a video call walking the factory floor; a paid sample; a third-party pre-shipment inspection (SGS, Bureau Veritas or your own agent) which we will arrange and accommodate on any order.' },
];
---
<BaseLayout
  title="Wholesale & Bulk Orders — Hotel Metalware Direct from the Factory | Tripadi International"
  description="Wholesale chafing dishes, wine coolers, trays and charger plates direct from our Moradabad factory. MOQ from 10 pieces, samples credited, EXW/FOB/CIF/DDP. Quote within one working day."
  schema={[faqSchema(faqs), breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Wholesale', url: '/wholesale' }], siteUrl)]}
>
  <section class="section-tight">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="eyebrow">Wholesale & bulk</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-[-0.025em] text-ink-900 md:text-[52px] md:leading-[1.06]">
            Buy from the factory, not from the middle.
          </h1>
          <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-ink-700">
            Most Moradabad metalware reaches a hotel through an exporter, an agent and a distributor.
            Each one is a margin and a layer of distance from the person who can actually answer a
            question about the metal. We are the factory. You are talking to us.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#inquiry" class="rounded-full bg-ink-900 px-6 py-3 text-[14px] font-medium text-white transition-opacity hover:opacity-85">Request a quote</a>
            <a href={whatsappLink('Hello Tripadi International, I would like to discuss a wholesale order.')} class="rounded-full border border-ink-300 px-6 py-3 text-[14px] font-medium text-ink-800 transition-colors hover:border-ink-900">WhatsApp us</a>
            <a href="/catalogue" class="rounded-full border border-ink-300 px-6 py-3 text-[14px] font-medium text-ink-800 transition-colors hover:border-ink-900">Download the catalogue</a>
          </div>
        </div>
        <div class="lg:col-span-5">
          <Photo src="/lifestyle/wholesale-crates.jpg" alt="Export cartons packed at the Tripadi factory" label="Export packing" ratio="4 / 3" priority={true} class="rounded-2xl" sizes="(min-width: 1024px) 42vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-ink-200 bg-mist">
    <div class="container-page">
      <dl class="grid grid-cols-2 gap-8 py-12 md:grid-cols-4">
        {[
          { n: 'From 10', l: 'Minimum order, cast items' },
          { n: companyInfo.capacity.sample_lead_time_days + ' days', l: 'Sample lead time' },
          { n: companyInfo.capacity.production_lead_time_days + ' days', l: 'Production lead time' },
          { n: '< 1 day', l: 'Quote turnaround' },
        ].map((s) => (
          <div>
            <dt class="text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">{s.n}</dt>
            <dd class="mt-1.5 text-[13px] leading-snug text-ink-600">{s.l}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-page">
      <p class="eyebrow">How an order runs</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-[-0.022em] text-ink-900 md:text-4xl">
        From your first email to the container.
      </h2>
      <div class="mt-14 grid gap-x-8 gap-y-10 md:grid-cols-3 lg:grid-cols-5">
        {steps.map((s) => (
          <div class="reveal">
            <p class="text-[13px] font-semibold text-brass-600">{s.n}</p>
            <h3 class="mt-3 text-[17px] font-medium text-ink-900">{s.t}</h3>
            <p class="mt-2.5 text-[14px] leading-relaxed text-ink-600">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight hairline">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow">Who we supply</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.022em] text-ink-900 md:text-4xl">
            Five kinds of buyer, five different quotes.
          </h2>
          <p class="mt-5 text-[15px] leading-relaxed text-ink-600">
            A hotel fitting out one banquet hall and an importer stocking a warehouse need different
            price bands, different packing and different terms. Tell us which you are and the quote
            arrives shaped for you.
          </p>
        </div>
        <div class="lg:col-span-7">
          <dl class="divide-y divide-ink-200 border-t border-ink-200">
            {[
              { t: 'Hotels & resorts', d: 'Property-wide specification, phased delivery against a pre-opening schedule, logo branding, replacement stock held against your SKU list.' },
              { t: 'Banquet halls & caterers', d: 'High-rotation items in volume, finishes that survive daily service, and repeat top-ups at the same price band.' },
              { t: 'Distributors & importers', d: 'Container-load pricing, territory discussion, neutral or private-label packing, and drop-ship documentation for your own customers.' },
              { t: 'Retailers & e-commerce', d: 'Retail-ready packing, barcodes and photography assets, MOQ per SKU rather than per order.' },
              { t: 'Designers & consultants', d: 'Bespoke pieces from your drawings, finish development against a scheme, and samples for client presentation.' },
            ].map((r) => (
              <div class="py-5">
                <dt class="text-[16px] font-medium text-ink-900">{r.t}</dt>
                <dd class="mt-1.5 text-[14px] leading-relaxed text-ink-600">{r.d}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist section-tight">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <p class="eyebrow">Trade questions</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">
          The eight things buyers ask first
        </h2>
        <div class="mt-8 divide-y divide-ink-200 border-y border-ink-200">
          {faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-[15px] font-medium text-ink-900">
                {f.q}
                <span class="mt-1 shrink-0 text-ink-400 transition-transform duration-300 group-open:rotate-45">
                  <svg viewBox="0 0 14 14" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 1v12M1 7h12" stroke-linecap="round"/></svg>
                </span>
              </summary>
              <p class="mt-3 text-[14px] leading-relaxed text-ink-700">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <InquiryForm variant="wholesale" id="inquiry" />
</BaseLayout>
