---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { buildPseoPages, specRange } from '../lib/pseo';
import { companyInfo, allCategories, whatsappLink } from '../lib/catalog';
import { faqSchema, breadcrumbSchema } from '../lib/seo';

export function getStaticPaths() {
  return buildPseoPages().map((page) => ({ params: { pseo: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const siteUrl = Astro.site?.toString() ?? '';
const range = specRange(page.products)!;

// The FAQ set is assembled from three sources so that no two generated pages
// carry an identical block: the topic's own questions, a question specific to
// this page's axis, and two standing trade questions.
const axisFaq =
  page.kind === 'market' && page.market
    ? [{
        q: `How do you ship ${page.topic.plural} to ${page.market.in_label}?`,
        a: `${page.market.note} ${page.market.detail}`,
      }]
    : page.kind === 'buyer' && page.buyer
      ? [{
          q: `What do ${page.buyer.for_label} usually get wrong when specifying ${page.topic.plural}?`,
          a: `${page.buyer.angle} In practice the fix is ${page.buyer.points[0].charAt(0).toLowerCase()}${page.buyer.points[0].slice(1)}`,
        }]
      : page.intent
        ? [{
            q: `Are you actually the ${page.intent.label.toLowerCase()}, or a trading house?`,
            a: `${page.intent.angle} You are welcome to verify it: we will walk the factory floor on an unscheduled video call whenever suits you.`,
          }]
        : [];

const faqs = [
  ...axisFaq,
  ...page.topic.faq,
  {
    q: `What is the minimum order for ${page.topic.plural}?`,
    a: `Across this range the MOQ runs from ${range.moqMin} to ${range.moqMax} pieces, and it applies per item rather than per order — so a mixed list is normal. Custom finishes and bespoke tooling carry a higher minimum, which we will quote exactly.`,
  },
  {
    q: 'Do you supply samples before a bulk order?',
    a: `Yes, and we recommend it. Samples ship in ${companyInfo.capacity.sample_lead_time_days} days and the cost is credited in full against your first production order.`,
  },
];

const trail = [
  { name: 'Home', url: '/' },
  { name: 'Collections', url: '/collections' },
  { name: page.h1, url: `/${page.slug}` },
];
---
<BaseLayout
  title={page.title}
  description={page.description}
  schema={[faqSchema(faqs), breadcrumbSchema(trail, siteUrl)]}
>
  <section class="section-tight border-b border-ink-200">
    <div class="container-page">
      <nav class="text-[12px] text-ink-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-ink-800">Home</a>
        <span class="mx-2 text-ink-300">/</span>
        <a href="/collections" class="hover:text-ink-800">Collections</a>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <h1 class="text-4xl font-semibold tracking-[-0.025em] text-ink-900 md:text-[50px] md:leading-[1.07]">
            {page.h1}
          </h1>
          <p class="mt-6 text-[17px] leading-relaxed text-ink-700">{page.topic.lede}</p>
          <p class="mt-4 text-[16px] leading-relaxed text-ink-600">
            {page.intent?.angle ?? page.market?.detail ?? page.buyer?.angle}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#enquiry" class="rounded-full bg-ink-900 px-6 py-3 text-[14px] font-medium text-white transition-opacity hover:opacity-85">
              Get a quote
            </a>
            <a href={whatsappLink(`Hello Tripadi International, I am looking for ${page.topic.plural}.`)} class="rounded-full border border-ink-300 px-6 py-3 text-[14px] font-medium text-ink-800 transition-colors hover:border-ink-900">
              WhatsApp us
            </a>
          </div>
        </div>

        <aside class="lg:col-span-5">
          <div class="rounded-2xl border border-ink-200 bg-mist p-6">
            <p class="text-[12px] font-semibold tracking-[0.1em] text-brass-600 uppercase">At a glance</p>
            <dl class="mt-4 space-y-3 text-[14px]">
              <div class="flex justify-between gap-4"><dt class="text-ink-600">Pieces in this range</dt><dd class="text-ink-900">{range.count}</dd></div>
              <div class="flex justify-between gap-4"><dt class="text-ink-600">Minimum order</dt><dd class="text-ink-900">{range.moqMin}–{range.moqMax} pcs</dd></div>
              <div class="flex justify-between gap-4"><dt class="text-ink-600">Finishes</dt><dd class="text-ink-900">{range.finishCount}</dd></div>
              <div class="flex justify-between gap-4"><dt class="text-ink-600">Metals</dt><dd class="text-ink-900">{range.metalCount}</dd></div>
              <div class="flex justify-between gap-4"><dt class="text-ink-600">Sample lead time</dt><dd class="text-ink-900">{companyInfo.capacity.sample_lead_time_days} days</dd></div>
              <div class="flex justify-between gap-4"><dt class="text-ink-600">Production</dt><dd class="text-ink-900">{companyInfo.capacity.production_lead_time_days} days</dd></div>
              {page.market && (
                <div class="hairline pt-3">
                  <dt class="text-ink-600">Logistics</dt>
                  <dd class="mt-1 text-ink-900">{page.market.logistics}</dd>
                </div>
              )}
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- The axis-specific argument. This is the block that makes each generated
       page a different page rather than the same page with a swapped keyword. -->
  <section class="section-tight">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow">
            {page.intent?.proof_heading ?? (page.market ? `Supplying ${page.market.in_label}` : `Specified for ${page.buyer?.for_label}`)}
          </p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.022em] text-ink-900 md:text-4xl">
            {page.intent
              ? 'Why it matters who you are buying from.'
              : page.market
                ? `From our floor to ${page.market.in_label}.`
                : `What ${page.buyer?.for_label} should specify.`}
          </h2>
          <p class="mt-5 text-[15px] leading-relaxed text-ink-600">{page.topic.expertise}</p>
        </div>
        <div class="lg:col-span-7">
          <ul class="divide-y divide-ink-200 border-t border-ink-200">
            {(page.intent?.proof ?? page.buyer?.points ?? [page.market!.note, page.market!.detail]).map((point: string) => (
              <li class="flex gap-4 py-4">
                <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-brass-500"></span>
                <span class="text-[15px] leading-relaxed text-ink-700">{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist section-tight">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">The range</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">
            {range.count} {range.count === 1 ? page.topic.singular : page.topic.plural} we make
          </h2>
        </div>
        <a href="/collections" class="text-[14px] font-medium text-brass-600 hover:text-brass-700">See the full catalogue →</a>
      </div>
      <div class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {page.products.slice(0, 9).map((p, i) => <ProductCard product={p} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <p class="eyebrow">Questions</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">
          What buyers ask us about {page.topic.plural}
        </h2>
        <div class="mt-8 divide-y divide-ink-200 border-y border-ink-200">
          {faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-[15px] font-medium text-ink-900">
                {f.q}
                <span class="mt-1 shrink-0 text-ink-400 transition-transform duration-300 group-open:rotate-45">
                  <svg viewBox="0 0 14 14" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 1v12M1 7h12" stroke-linecap="round"/></svg>
                </span>
              </summary>
              <p class="mt-3 text-[14px] leading-relaxed text-ink-700">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight hairline">
    <div class="container-page">
      <p class="eyebrow">Related</p>
      <div class="mt-6 flex flex-wrap gap-2.5">
        {allCategories.map((c) => (
          <a href={`/collections/${c.slug}`} class="rounded-full border border-ink-300 px-4 py-2 text-[13px] text-ink-700 transition-colors hover:border-ink-900">{c.name}</a>
        ))}
        <a href="/materials-and-finishes" class="rounded-full border border-ink-300 px-4 py-2 text-[13px] text-ink-700 transition-colors hover:border-ink-900">Materials & finishes</a>
        <a href="/export" class="rounded-full border border-ink-300 px-4 py-2 text-[13px] text-ink-700 transition-colors hover:border-ink-900">Export & shipping</a>
        <a href="/private-label" class="rounded-full border border-ink-300 px-4 py-2 text-[13px] text-ink-700 transition-colors hover:border-ink-900">Private label</a>
        <a href="/factory" class="rounded-full border border-ink-300 px-4 py-2 text-[13px] text-ink-700 transition-colors hover:border-ink-900">The factory</a>
      </div>
    </div>
  </section>

  <InquiryForm variant="wholesale" id="enquiry" />
</BaseLayout>
