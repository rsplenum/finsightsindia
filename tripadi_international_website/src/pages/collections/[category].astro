---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import ProductCard from '../../components/ProductCard.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { allCategories, productsInCategory, allUseCases } from '../../lib/catalog';
import { breadcrumbSchema } from '../../lib/seo';

export function getStaticPaths() {
  return allCategories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const products = productsInCategory(category.slug);
const siteUrl = Astro.site?.toString() ?? '';

// The settings where this category actually appears — derived, not curated,
// so it can never drift out of sync with the product data.
const settings = allUseCases.filter((u) =>
  products.some((p) => u.products.includes(p.id))
);
---
<BaseLayout
  title={`${category.name} — Manufacturer & Exporter | Tripadi International`}
  description={`${category.intro} ${products.length} pieces made in our own factory in Moradabad. Wholesale and retail.`}
  image={category.hero}
  schema={breadcrumbSchema(
    [
      { name: 'Home', url: '/' },
      { name: 'Collections', url: '/collections' },
      { name: category.name, url: `/collections/${category.slug}` },
    ],
    siteUrl
  )}
>
  <section class="section-tight">
    <div class="container-page">
      <nav class="text-[12px] text-ink-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-ink-800">Home</a>
        <span class="mx-2 text-ink-300">/</span>
        <a href="/collections" class="hover:text-ink-800">Collections</a>
        <span class="mx-2 text-ink-300">/</span>
        <span class="text-ink-800">{category.name}</span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <h1 class="text-4xl font-semibold tracking-[-0.025em] text-ink-900 md:text-[52px] md:leading-[1.06]">
            {category.name}
          </h1>
          <p class="mt-5 text-[17px] leading-relaxed text-ink-800">{category.tagline}</p>
          <p class="mt-5 text-[16px] leading-relaxed text-ink-600">{category.intro}</p>

          <div class="mt-8 rounded-xl border border-ink-200 bg-mist p-6">
            <p class="text-[12px] font-semibold tracking-[0.1em] text-brass-600 uppercase">How to specify</p>
            <p class="mt-2.5 text-[14px] leading-relaxed text-ink-700">{category.buyer_note}</p>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#pieces" class="rounded-full bg-ink-900 px-5 py-2.5 text-[14px] font-medium text-white transition-opacity hover:opacity-85">
              See {products.length} pieces
            </a>
            <a href="/wholesale" class="rounded-full border border-ink-300 px-5 py-2.5 text-[14px] font-medium text-ink-800 transition-colors hover:border-ink-900">
              Wholesale quote
            </a>
          </div>
        </div>
        <div class="lg:col-span-6">
          <Photo src={category.hero} alt={category.name} label={category.name} ratio="4 / 3" priority={true} class="rounded-2xl" sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <section id="pieces" class="section-tight hairline">
    <div class="container-page">
      <div class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p, i) => <ProductCard product={p} eager={i < 3} />)}
      </div>
    </div>
  </section>

  {settings.length > 0 && (
    <section class="bg-mist section-tight">
      <div class="container-page">
        <p class="eyebrow">Where it goes</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">
          {category.name} in a working room
        </h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {settings.map((u) => (
            <a href={`/in-use/${u.slug}`} class="reveal group block">
              <Photo src={u.hero} alt={u.name} label={u.name} ratio="3 / 2" class="rounded-xl" />
              <h3 class="mt-3.5 text-[16px] font-medium text-ink-900">{u.name}</h3>
              <p class="mt-1.5 text-[13px] leading-relaxed text-ink-600">{u.headline}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <InquiryForm variant="wholesale" />
</BaseLayout>
