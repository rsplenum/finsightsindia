---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import { allUseCases } from '../../lib/catalog';
import { breadcrumbSchema } from '../../lib/seo';
const siteUrl = Astro.site?.toString() ?? '';
---
<BaseLayout
  title="In Use — Hotel Metalware in Seven Working Settings | Tripadi International"
  description="See chafing dishes, wine coolers, trays and charger plates in the rooms they were made for: banquet buffets, fine dining, poolside brunch, room service, bars, breakfast counters and the home table."
  schema={breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'In Use', url: '/in-use' }], siteUrl)}
>
  <section class="section-tight border-b border-ink-200">
    <div class="container-page">
      <p class="eyebrow">In use</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.025em] text-ink-900 md:text-[52px] md:leading-[1.06]">
        A photograph of the object tells you what it is. A photograph of the room tells you whether
        you need it.
      </h1>
      <p class="mt-6 max-w-2xl text-[16px] leading-relaxed text-ink-600">
        Seven settings, each with the pieces that belong in it and the specification notes that go
        with them. If you are fitting out a property, start here rather than in the catalogue.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid gap-x-8 gap-y-16 md:grid-cols-2">
        {allUseCases.map((u, i) => (
          <a href={`/in-use/${u.slug}`} class={`reveal group block ${i === 0 ? 'md:col-span-2' : ''}`}>
            <Photo
              src={u.hero}
              alt={u.name}
              label={u.name}
              ratio={i === 0 ? '21 / 9' : '3 / 2'}
              priority={i < 2}
              class="rounded-2xl transition-shadow duration-500 group-hover:shadow-[0_18px_50px_-24px_rgba(0,0,0,0.35)]"
              sizes={i === 0 ? '100vw' : '(min-width: 768px) 50vw, 100vw'}
            />
            <div class={i === 0 ? 'mt-6 max-w-2xl' : 'mt-5'}>
              <h2 class={`font-medium tracking-[-0.015em] text-ink-900 ${i === 0 ? 'text-2xl md:text-3xl' : 'text-[20px]'}`}>
                {u.name}
              </h2>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-700">{u.headline}</p>
              <p class="mt-2.5 line-clamp-2 text-[14px] leading-relaxed text-ink-600">{u.intro}</p>
              <span class="mt-3 inline-block text-[13px] text-brass-600 transition-transform duration-300 group-hover:translate-x-0.5">
                See the setting →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
