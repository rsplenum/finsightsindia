---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import ProductCard from '../../components/ProductCard.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { allUseCases, productsForUseCase } from '../../lib/catalog';
import { breadcrumbSchema } from '../../lib/seo';

export function getStaticPaths() {
  return allUseCases.map((useCase) => ({ params: { slug: useCase.slug }, props: { useCase } }));
}

const { useCase } = Astro.props;
const products = productsForUseCase(useCase.slug);
const others = allUseCases.filter((u) => u.slug !== useCase.slug).slice(0, 3);
const siteUrl = Astro.site?.toString() ?? '';
---
<BaseLayout
  title={`${useCase.name} — What to Specify | Tripadi International`}
  description={`${useCase.headline} ${useCase.intro.slice(0, 110)}… The pieces and the specification notes for ${useCase.name.toLowerCase()}.`}
  image={useCase.hero}
  schema={breadcrumbSchema(
    [{ name: 'Home', url: '/' }, { name: 'In Use', url: '/in-use' }, { name: useCase.name, url: `/in-use/${useCase.slug}` }],
    siteUrl
  )}
>
  <section class="relative">
    <Photo src={useCase.hero} alt={useCase.name} label={useCase.name} ratio="21 / 9" priority={true} tone="dark" sizes="100vw" class="min-h-[52vh] w-full" />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0">
      <div class="container-page pb-10 md:pb-16">
        <p class="text-[12px] font-semibold tracking-[0.14em] text-white/80 uppercase">In use</p>
        <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-[-0.024em] text-white md:text-5xl md:leading-[1.08]">
          {useCase.name}
        </h1>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p class="text-[21px] leading-[1.55] font-medium tracking-[-0.012em] text-ink-900 md:text-[26px]">
            {useCase.headline}
          </p>
          <p class="mt-6 text-[16px] leading-relaxed text-ink-700">{useCase.intro}</p>
        </div>
        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-ink-200 bg-mist p-6">
            <p class="text-[12px] font-semibold tracking-[0.1em] text-brass-600 uppercase">The scenario</p>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-800">{useCase.scenario}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist section-tight">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <p class="eyebrow">What to specify</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">
          The four decisions that matter here
        </h2>
        <ol class="mt-10 space-y-8">
          {useCase.what_to_specify.map((point, i) => (
            <li class="flex gap-6">
              <span class="w-8 shrink-0 text-[13px] font-semibold text-brass-600">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[16px] leading-relaxed text-ink-800">{point}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">The pieces</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">
            Specified for this setting
          </h2>
        </div>
        <a href="/wholesale" class="text-[14px] font-medium text-brass-600 hover:text-brass-700">
          Quote the whole setting →
        </a>
      </div>
      <div class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p, i) => <ProductCard product={p} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <section class="section-tight hairline">
    <div class="container-page">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">Other settings</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {others.map((u) => (
          <a href={`/in-use/${u.slug}`} class="reveal group block">
            <Photo src={u.hero} alt={u.name} label={u.name} ratio="3 / 2" class="rounded-xl" />
            <h3 class="mt-3.5 text-[16px] font-medium text-ink-900">{u.name}</h3>
            <p class="mt-1.5 text-[13px] leading-relaxed text-ink-600">{u.headline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <InquiryForm variant="wholesale" />
</BaseLayout>
