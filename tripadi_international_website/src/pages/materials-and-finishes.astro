---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allProducts, metalLabels } from '../lib/catalog';
import { faqSchema, breadcrumbSchema } from '../lib/seo';
const siteUrl = Astro.site?.toString() ?? '';

const metals = [
  {
    slug: 'stainless-steel',
    lede: 'The default for anything that lives in a dishwasher, in the sun, or against food.',
    body: 'We work in grade 304 for every food-contact surface and grade 201 for frames and structural parts where corrosion resistance matters less than cost. The distinction is worth insisting on: 201 costs about a fifth less and will pit within a season in a coastal property or a chlorinated pool deck. Any supplier who will not tell you which grade is where is telling you something.',
    finishes: ['Mirror polish', 'Satin brushed', 'Hammered', 'Gold PVD', 'Rose-gold PVD', 'Copper PVD', 'Black PVD'],
    note: 'PVD is a vacuum-deposited coating, not a plating. It is harder than the steel underneath, dishwasher-safe, and it does not tarnish — which is why a PVD-gold charger plate outlives a gold-plated one several times over.',
  },
  {
    slug: 'brass',
    lede: 'Warm under low light. The material for a room that wants to look more expensive than it cost.',
    body: 'Brass is cast, spun and pressed here. It is the only one of the three metals we can cast into shape, which is why every finial, handle and tripod leg on this site is brass even when the body is not. Left raw it develops a patina; lacquered it stays bright and needs nothing but a damp cloth; antiqued it is chemically darkened into the recesses so the highlights stand out.',
    finishes: ['Polished & lacquered', 'Antique brass', 'Bronze', 'Nickel over brass', 'Silver plate', 'Gold plate'],
    note: 'Antiquing is chemical, so it is in the metal and cannot chip. It also means a batch varies very slightly piece to piece. A set of five hundred perfectly identical "antique" plates has been sprayed, and spray comes off.',
  },
  {
    slug: 'copper',
    lede: 'The most photographed metal we work in, and the one with the strictest rule attached.',
    body: 'Every copper piece we make that touches food or drink is lined in 304 stainless. Copper reacts with anything acidic and the reaction is not good for the food or the guest. Unlined copper here is decorative only — the outside of a chafing dish, the back of a platter, the body of a shaker whose interior is steel. Copper is also hand-raised rather than machine-spun on most shapes, which is why an oval platter takes five hours and no two are identical.',
    finishes: ['Natural, lacquered', 'Antique copper', 'Hammered', 'Nickel-lined', 'Copper PVD over steel'],
    note: 'If a supplier offers you unlined copper cookware or drinkware for hospitality use, walk away. It is a food-safety failure waiting for an audit.',
  },
];

const faqs = [
  { q: 'What is the difference between PVD gold and gold plating?', a: 'Gold plating is a thin layer of gold deposited electrochemically; it is soft, it wears at the rim first, and it will not survive a commercial dishwasher for long. PVD is a vacuum-deposited titanium-nitride-family coating tuned to a gold colour. It is harder than the steel beneath it, dishwasher-safe and does not tarnish. For hospitality volume, PVD is almost always the right answer; for a presentation piece where a genuine precious-metal surface matters, plating is.' },
  { q: 'Will lacquered brass tarnish?', a: 'Not while the lacquer is intact. Lacquer fails when it is scoured with an abrasive pad or run through a dishwasher, after which the brass will tarnish in patches wherever the lacquer was cut. We relacquer pieces sent back to us, and we will supply a spare set of care cards for your housekeeping team.' },
  { q: 'Is hammered or smooth better for daily hotel service?', a: 'Hammered, almost always. A hand-hammered face scatters light, and scuffing from service scatters light in exactly the same way — so marks disappear into the surface instead of sitting on it. A mirror-polished piece looks better on day one and worse on day ninety.' },
  { q: 'Can you match a finish we already have?', a: 'Yes. Send us a physical sample of the existing piece — a photograph is not enough, because finish is about how a surface handles light. We will produce a swatch for approval before any production runs.' },
  { q: 'Which metal is best for outdoor and poolside use?', a: 'Stainless 304 or PVD-coated steel. Lacquered brass chalks in direct UV, and any plated finish is on borrowed time in salt air. If the piece lives outdoors, specify 304 and a hammered or satin face.' },
];
---
<BaseLayout
  title="Materials & Finishes — Steel, Brass and Copper for Hospitality | Tripadi International"
  description="Stainless steel 304, brass and copper: which metal for which room, every finish we offer, and the questions to ask a supplier. From the factory floor in Moradabad."
  schema={[faqSchema(faqs), breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Materials & Finishes', url: '/materials-and-finishes' }], siteUrl)]}
>
  <section class="section-tight border-b border-ink-200">
    <div class="container-page">
      <p class="eyebrow">Materials & finishes</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.025em] text-ink-900 md:text-[52px] md:leading-[1.06]">
        Three metals, twenty finishes, and the reasons to choose between them.
      </h1>
      <p class="mt-6 max-w-2xl text-[16px] leading-relaxed text-ink-600">
        Most specification mistakes in hospitality metalware are material mistakes, and they show up
        in year two rather than week one. This page is what we would tell you on the phone.
      </p>
    </div>
  </section>

  {metals.map((m) => (
    <section id={m.slug} class="section-tight hairline scroll-mt-20">
      <div class="container-page">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <h2 class="text-3xl font-semibold tracking-[-0.022em] text-ink-900 md:text-4xl">{metalLabels[m.slug]}</h2>
            <p class="mt-4 text-[17px] leading-relaxed text-ink-800">{m.lede}</p>
            <p class="mt-6 text-[13px] text-ink-500">
              {allProducts.filter((p) => p.metal === m.slug).length} pieces in this metal
            </p>
          </div>
          <div class="lg:col-span-7">
            <p class="text-[16px] leading-relaxed text-ink-700">{m.body}</p>
            <div class="mt-8">
              <p class="text-[13px] font-medium text-ink-900">Finishes available</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {m.finishes.map((f) => (
                  <span class="rounded-full border border-ink-300 px-3 py-1.5 text-[12px] text-ink-700">{f}</span>
                ))}
              </div>
            </div>
            <div class="mt-8 rounded-xl bg-mist p-5">
              <p class="text-[12px] font-semibold tracking-[0.1em] text-brass-600 uppercase">Worth knowing</p>
              <p class="mt-2.5 text-[14px] leading-relaxed text-ink-700">{m.note}</p>
            </div>
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
              {allProducts.filter((p) => p.metal === m.slug).slice(0, 4).map((p) => (
                <a href={`/products/${p.slug}`} class="rounded-lg border border-ink-200 px-4 py-3 text-[14px] text-ink-800 transition-colors hover:border-ink-900">{p.name}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="bg-mist section-tight">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">Finish questions we are asked most</h2>
        <div class="mt-8 divide-y divide-ink-200 border-y border-ink-200">
          {faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-[15px] font-medium text-ink-900">
                {f.q}
                <span class="mt-1 shrink-0 text-ink-400 transition-transform duration-300 group-open:rotate-45">
                  <svg viewBox="0 0 14 14" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 1v12M1 7h12" stroke-linecap="round"/></svg>
                </span>
              </summary>
              <p class="mt-3 text-[14px] leading-relaxed text-ink-700">{f.a}</p>
            </details>
          ))}
        </div>
        <div class="mt-10">
          <a href="/wholesale" class="rounded-full bg-ink-900 px-6 py-3 text-[14px] font-medium text-white transition-opacity hover:opacity-85">
            Ask for a finish swatch
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
