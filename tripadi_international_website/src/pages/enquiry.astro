---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
---
<BaseLayout
  title="My Enquiry List | Tripadi International"
  description="The pieces you have selected, ready to send as one wholesale quote request."
  noindex={true}
>
  <section class="section-tight">
    <div class="container-page">
      <p class="eyebrow">Trade enquiry</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-[-0.025em] text-ink-900 md:text-5xl">Your enquiry list</h1>
      <p class="mt-5 max-w-xl text-[16px] leading-relaxed text-ink-600">
        Adjust quantities here, then send the whole list as one quote request. We come back with unit
        prices by quantity band, finish options and a lead time — normally the same day.
      </p>

      <div class="mt-12" data-enquiry-page>
        <div class="hidden rounded-2xl border border-ink-200 p-10 text-center" data-empty>
          <p class="text-[16px] text-ink-700">Your enquiry list is empty.</p>
          <p class="mt-2 text-[14px] text-ink-500">
            Add pieces from any product page, or tell us what you need in the form below.
          </p>
          <a href="/collections" class="mt-6 inline-block rounded-full bg-ink-900 px-6 py-3 text-[14px] font-medium text-white transition-opacity hover:opacity-85">
            Browse the collection
          </a>
        </div>

        <div class="hidden" data-list-wrap>
          <ul class="divide-y divide-ink-200 border-y border-ink-200" data-list></ul>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <button type="button" data-clear class="text-[13px] text-ink-500 underline hover:text-ink-800">Clear the list</button>
            <a href="/collections" class="text-[13px] text-brass-600 hover:text-brass-700">Add more pieces →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <InquiryForm variant="wholesale" id="inquiry" />
</BaseLayout>

<script>
  import { read, setQty, remove, clear } from '../scripts/basket';

  interface Entry { name: string; slug: string; moq: number; price: number | null; image: string }
  const PRODUCTS: Record<string, Entry> = JSON.parse(
    document.getElementById('product-index')?.textContent || '{}'
  );

  const root = document.querySelector<HTMLElement>('[data-enquiry-page]');
  const list = root?.querySelector<HTMLElement>('[data-list]');
  const wrap = root?.querySelector<HTMLElement>('[data-list-wrap]');
  const empty = root?.querySelector<HTMLElement>('[data-empty]');

  function render() {
    if (!list || !wrap || !empty) return;
    const items = read('enquiry');
    empty.classList.toggle('hidden', items.length > 0);
    wrap.classList.toggle('hidden', items.length === 0);

    list.innerHTML = items
      .map((item) => {
        const p = PRODUCTS[item.id];
        const name = p?.name ?? item.id;
        const href = p ? `/products/${p.slug}` : '#';
        const moqNote = p && item.qty < p.moq ? `<span class="text-brass-600">Below the ${p.moq}-piece MOQ — we will still quote it.</span>` : `MOQ ${p?.moq ?? '—'} pcs`;
        return `
          <li class="flex flex-wrap items-center gap-4 py-5" data-row="${item.id}">
            <div class="min-w-0 flex-1">
              <a href="${href}" class="text-[15px] font-medium text-ink-900 hover:text-brass-600">${name}</a>
              <p class="mt-1 text-[12px] text-ink-500">${item.id} · ${moqNote}</p>
            </div>
            <label class="sr-only" for="q-${item.id}">Quantity for ${name}</label>
            <input id="q-${item.id}" type="number" min="1" value="${item.qty}" data-qty="${item.id}"
              class="w-24 rounded-lg border border-ink-300 px-3 py-2 text-[14px] text-ink-900 outline-none focus:border-brass-500" />
            <button type="button" data-remove="${item.id}" class="text-[13px] text-ink-500 underline hover:text-ink-900">Remove</button>
          </li>`;
      })
      .join('');

    list.querySelectorAll<HTMLInputElement>('[data-qty]').forEach((input) => {
      input.addEventListener('change', () => {
        setQty('enquiry', input.dataset.qty!, parseInt(input.value, 10) || 1);
        render();
      });
    });
    list.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => {
        remove('enquiry', btn.dataset.remove!);
        render();
      });
    });
  }

  root?.querySelector<HTMLButtonElement>('[data-clear]')?.addEventListener('click', () => {
    clear('enquiry');
    render();
    // The attached-summary block in the form below is rendered on load; the
    // simplest correct thing after a clear is to re-render the page state.
    location.reload();
  });

  render();
</script>
