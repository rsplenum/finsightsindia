---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import journal from '../../data/journal.json';
import { breadcrumbSchema } from '../../lib/seo';
const siteUrl = Astro.site?.toString() ?? '';
const articles = [...journal].sort((a, b) => b.date.localeCompare(a.date));
---
<BaseLayout
  title="Journal — Buying and Specifying Hotel Metalware | Tripadi International"
  description="Specification guides, material notes and sourcing advice for hospitality metalware, written by the factory that makes it."
  schema={breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Journal', url: '/journal' }], siteUrl)}
>
  <section class="section-tight border-b border-ink-200">
    <div class="container-page">
      <p class="eyebrow">Journal</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.025em] text-ink-900 md:text-[52px] md:leading-[1.06]">
        What we would tell you on the phone, written down.
      </h1>
      <p class="mt-6 max-w-2xl text-[16px] leading-relaxed text-ink-600">
        Specification guides and sourcing notes for people buying hospitality metalware. No sales
        copy — if the honest answer is "buy the cheaper one", that is what it says.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((a, i) => (
          <a href={`/journal/${a.slug}`} class="reveal group block">
            <Photo src={a.hero} alt={a.title} label={a.title} ratio="3 / 2" class="rounded-xl" priority={i < 3} />
            <p class="mt-4 text-[11px] font-medium tracking-[0.1em] text-ink-500 uppercase">
              {a.topic} · {a.reading_minutes} min
            </p>
            <h2 class="mt-2 text-[19px] leading-snug font-medium text-ink-900">{a.title}</h2>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-600">{a.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
