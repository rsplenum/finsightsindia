---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allCategories } from '../lib/catalog';
---
<BaseLayout title="Page not found | Tripadi International" description="That page does not exist." noindex={true}>
  <section class="section">
    <div class="container-page">
      <div class="mx-auto max-w-xl text-center">
        <p class="eyebrow">404</p>
        <h1 class="mt-4 text-3xl font-semibold tracking-[-0.024em] text-ink-900 md:text-5xl">
          This one is not in the catalogue.
        </h1>
        <p class="mt-5 text-[16px] leading-relaxed text-ink-600">
          The page you were looking for has moved or never existed. The collection is all still here.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="/collections" class="rounded-full bg-ink-900 px-6 py-3 text-[14px] font-medium text-white transition-opacity hover:opacity-85">See the collection</a>
          <a href="/contact" class="rounded-full border border-ink-300 px-6 py-3 text-[14px] font-medium text-ink-800 transition-colors hover:border-ink-900">Ask us</a>
        </div>
        <div class="hairline mt-14 flex flex-wrap justify-center gap-x-6 gap-y-2 pt-8 text-[13px]">
          {allCategories.map((c) => (
            <a href={`/collections/${c.slug}`} class="text-ink-600 hover:text-brass-600">{c.name}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
