---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  allProducts, categoryOf, relatedProducts, metalLabels, formatINR,
  dimensionsLabel, allUseCases, companyInfo, whatsappLink,
} from '../../lib/catalog';
import { productSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export function getStaticPaths() {
  return allProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const category = categoryOf(product)!;
const related = relatedProducts(product, 3);
const siteUrl = Astro.site?.toString() ?? '';
const gallery = [product.images.hero, ...(product.images.gallery ?? [])];
const settings = allUseCases.filter((u) => u.products.includes(product.id));

const specs = [
  { label: 'SKU', value: product.id },
  { label: 'Material', value: product.materials.join(' · ') },
  { label: 'Capacity', value: product.capacity },
  { label: 'Dimensions', value: dimensionsLabel(product.dimensions_mm) },
  { label: 'Weight', value: `${product.weight_kg} kg` },
  { label: 'Finishes', value: product.finishes.join(' · ') },
  { label: 'Minimum order', value: `${product.moq} pieces` },
  { label: 'Lead time', value: `${product.lead_time_days} days from order confirmation` },
  { label: 'HS code', value: product.hs_code },
  { label: 'Packing', value: companyInfo.trade.packing },
];

// Questions a buyer asks before they write in. Answering them on the page is
// worth more than answering them in an email, and it earns the FAQ rich result.
const faqs = [
  {
    q: `What is the minimum order quantity for the ${product.name}?`,
    a: `The MOQ is ${product.moq} pieces in a stock finish. Custom finishes, bespoke tooling and logo branding carry a higher minimum — tell us what you need and we will quote the exact figure.`,
  },
  {
    q: `How long does production take?`,
    a: `${product.lead_time_days} days from order confirmation for a standard order, plus shipping. Samples ship in ${companyInfo.capacity.sample_lead_time_days} days.`,
  },
  {
    q: `Can we put our hotel's logo on it?`,
    a: `Yes. ${product.customisation.join('. ')}. Branding is normally etched, embossed or chased depending on the metal and the finish.`,
  },
  {
    q: `Do you export the ${product.name}?`,
    a: `Yes. We ship on ${companyInfo.trade.incoterms.join(', ')} terms through ${companyInfo.trade.ports.join(', ')}. HS code ${product.hs_code}.`,
  },
  {
    q: `How should it be cleaned?`,
    a: product.care,
  },
];

const waMessage = `Hello Tripadi International. I would like a quote for the ${product.name} (${product.id}).`;
---
<BaseLayout
  title={`${product.name} — ${metalLabels[product.metal]} | Tripadi International`}
  description={`${product.summary} MOQ ${product.moq} pieces. Made in our own factory in Moradabad, India. Wholesale and retail.`}
  image={product.images.hero}
  schema={[
    productSchema(product, siteUrl),
    breadcrumbSchema(
      [
        { name: 'Home', url: '/' },
        { name: 'Collections', url: '/collections' },
        { name: category.name, url: `/collections/${category.slug}` },
        { name: product.name, url: `/products/${product.slug}` },
      ],
      siteUrl
    ),
    faqSchema(faqs),
  ]}
>
  <div class="container-page pt-8">
    <nav class="text-[12px] text-ink-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink-800">Home</a>
      <span class="mx-2 text-ink-300">/</span>
      <a href="/collections" class="hover:text-ink-800">Collections</a>
      <span class="mx-2 text-ink-300">/</span>
      <a href={`/collections/${category.slug}`} class="hover:text-ink-800">{category.name}</a>
      <span class="mx-2 text-ink-300">/</span>
      <span class="text-ink-800">{product.name}</span>
    </nav>
  </div>

  <section class="pt-8 pb-16 md:pt-12 md:pb-24">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <!-- Gallery -->
        <div class="lg:col-span-7">
          <div data-gallery>
            <Photo
              src={gallery[0]}
              alt={product.name}
              label={product.name}
              ratio="4 / 3"
              priority={true}
              sizes="(min-width: 1024px) 58vw, 100vw"
              class="rounded-2xl"
            />
            {gallery.length > 1 && (
              <div class="mt-4 grid grid-cols-4 gap-3">
                {gallery.map((src, i) => (
                  <Photo src={src} alt={`${product.name} — view ${i + 1}`} label={`View ${i + 1}`} ratio="1 / 1" class="rounded-lg" sizes="150px" />
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- The decision column -->
        <div class="lg:col-span-5">
          <p class="text-[11px] font-medium tracking-[0.12em] text-ink-500 uppercase">
            {metalLabels[product.metal]} · {category.name}
          </p>
          <h1 class="mt-3 text-3xl font-semibold tracking-[-0.024em] text-ink-900 md:text-[40px] md:leading-[1.08]">
            {product.name}
          </h1>
          <p class="mt-5 text-[16px] leading-relaxed text-ink-700">{product.summary}</p>

          <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 border-y border-ink-200 py-6">
            <div>
              <dt class="text-[11px] tracking-[0.08em] text-ink-500 uppercase">Capacity</dt>
              <dd class="mt-1 text-[14px] text-ink-900">{product.capacity}</dd>
            </div>
            <div>
              <dt class="text-[11px] tracking-[0.08em] text-ink-500 uppercase">Minimum order</dt>
              <dd class="mt-1 text-[14px] text-ink-900">{product.moq} pieces</dd>
            </div>
            <div>
              <dt class="text-[11px] tracking-[0.08em] text-ink-500 uppercase">Lead time</dt>
              <dd class="mt-1 text-[14px] text-ink-900">{product.lead_time_days} days</dd>
            </div>
            <div>
              <dt class="text-[11px] tracking-[0.08em] text-ink-500 uppercase">Finishes</dt>
              <dd class="mt-1 text-[14px] text-ink-900">{product.finishes.length} available</dd>
            </div>
          </dl>

          <!-- Trade action. Primary, because most visitors here are trade. -->
          <div class="mt-8">
            <p class="text-[12px] font-semibold tracking-[0.1em] text-brass-600 uppercase">Wholesale</p>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <label class="sr-only" for="qty">Quantity</label>
              <input
                id="qty"
                type="number"
                min={product.moq}
                step="1"
                value={product.moq}
                data-qty-for={product.id}
                class="w-24 rounded-lg border border-ink-300 px-3 py-2.5 text-[14px] text-ink-900 outline-none focus:border-brass-500"
              />
              <button
                type="button"
                data-add-enquiry={product.id}
                class="flex-1 rounded-full bg-ink-900 px-6 py-3 text-[14px] font-medium text-white transition-opacity hover:opacity-85"
              >
                Add to enquiry
              </button>
            </div>
            <p class="mt-3 text-[12px] leading-relaxed text-ink-500">
              Build a list across the site, then send it as one quote request. Price, MOQ and lead
              time back within a working day.
            </p>
            <div class="mt-4 flex flex-wrap gap-4 text-[13px]">
              <a href="/wholesale" class="text-brass-600 hover:text-brass-700">Request a quote →</a>
              <a href={whatsappLink(waMessage)} class="text-brass-600 hover:text-brass-700">Ask on WhatsApp →</a>
            </div>
          </div>

          <!-- Retail action. Secondary, and honest about the price status. -->
          {product.retail.available && (
            <div class="mt-8 rounded-xl border border-ink-200 bg-mist p-5">
              <p class="text-[12px] font-semibold tracking-[0.1em] text-ink-500 uppercase">Buy one</p>
              <div class="mt-2.5 flex flex-wrap items-center justify-between gap-4">
                <p class="text-[22px] font-semibold tracking-[-0.02em] text-ink-900">
                  {formatINR(product.retail.price_inr)}
                  <span class="ml-1.5 text-[12px] font-normal text-ink-500">incl. GST</span>
                </p>
                <button
                  type="button"
                  data-add-cart={product.id}
                  class="rounded-full border border-ink-900 px-5 py-2.5 text-[13px] font-medium text-ink-900 transition-colors hover:bg-ink-900 hover:text-white"
                >
                  Add to bag
                </button>
              </div>
              <p class="mt-2.5 text-[12px] text-ink-500">
                Delivered across India. Free above ₹{companyInfo.retail.free_shipping_above_inr.toLocaleString('en-IN')}.
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Why it is made this way. The one paragraph a trading house cannot write. -->
  <section class="bg-mist section-tight">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow">Why it is made this way</p>
        </div>
        <div class="lg:col-span-7">
          <p class="text-[19px] leading-[1.6] text-ink-800 md:text-[21px]">{product.story}</p>
          <ul class="mt-8 grid gap-3">
            {product.highlights.map((h) => (
              <li class="flex gap-3.5">
                <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-brass-500"></span>
                <span class="text-[15px] leading-relaxed text-ink-700">{h}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Specification -->
  <section class="section-tight">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="eyebrow">Specification</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">
            Everything on the datasheet.
          </h2>
          <p class="mt-4 text-[15px] leading-relaxed text-ink-600">
            Need it in a different size, gauge or finish? Almost every dimension here is ours to
            change — we cut our own dies.
          </p>
          <a href="/wholesale" class="mt-6 inline-block rounded-full border border-ink-300 px-5 py-2.5 text-[14px] font-medium text-ink-800 transition-colors hover:border-ink-900">
            Ask for a variation
          </a>
        </div>
        <div class="lg:col-span-7">
          <dl class="divide-y divide-ink-200 border-t border-ink-200">
            {specs.map((s) => (
              <div class="flex flex-wrap gap-x-6 gap-y-1 py-3.5">
                <dt class="w-40 shrink-0 text-[13px] text-ink-500">{s.label}</dt>
                <dd class="flex-1 text-[14px] text-ink-900">{s.value}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-8">
            <p class="text-[13px] font-medium text-ink-900">Customisation available</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {product.customisation.map((c) => (
                <span class="rounded-full border border-ink-300 px-3 py-1.5 text-[12px] text-ink-700">{c}</span>
              ))}
            </div>
          </div>

          <div class="mt-8 rounded-xl bg-mist p-5">
            <p class="text-[13px] font-medium text-ink-900">Care</p>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-700">{product.care}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {settings.length > 0 && (
    <section class="section-tight hairline">
      <div class="container-page">
        <p class="eyebrow">In use</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">
          Where this piece earns its place
        </h2>
        <div class="mt-10 grid gap-8 md:grid-cols-2">
          {settings.map((u) => (
            <a href={`/in-use/${u.slug}`} class="reveal group block">
              <Photo src={u.hero} alt={u.name} label={u.name} ratio="3 / 2" class="rounded-xl" sizes="(min-width: 768px) 50vw, 100vw" />
              <h3 class="mt-4 text-[17px] font-medium text-ink-900">{u.name}</h3>
              <p class="mt-1.5 text-[14px] leading-relaxed text-ink-600">{u.headline}</p>
              <span class="mt-2 inline-block text-[13px] text-brass-600">See the full setting →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="bg-mist section-tight">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <p class="eyebrow">Before you write in</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">Common questions</h2>
        <div class="mt-8 divide-y divide-ink-200 border-y border-ink-200">
          {faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-[15px] font-medium text-ink-900">
                {f.q}
                <span class="mt-1 shrink-0 text-ink-400 transition-transform duration-300 group-open:rotate-45">
                  <svg viewBox="0 0 14 14" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 1v12M1 7h12" stroke-linecap="round"/></svg>
                </span>
              </summary>
              <p class="mt-3 max-w-2xl text-[14px] leading-relaxed text-ink-700">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-tight">
      <div class="container-page">
        <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink-900 md:text-3xl">Also consider</h2>
        <div class="mt-10 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
