# ---------------------------------------------------------------------------
# Tripadi International — environment
#
# Copy this file to `.env` and fill in what you have. EVERY variable is
# optional: with none of them set the site still works end to end, because
# every form falls back to composing an email and a WhatsApp message.
# ---------------------------------------------------------------------------

# Where enquiry forms and retail orders POST as JSON.
# Any service that accepts a JSON POST works — Formspree, Basin, Web3Forms,
# a Netlify/Vercel function, or your own endpoint. See docs/forms.md.
PUBLIC_FORM_ENDPOINT=

# --- Retail payments (Razorpay) --------------------------------------------
# Both of these must be set for card/UPI/netbanking checkout to go live.
# With either one empty, checkout captures the order and tells the customer a
# secure payment link will follow — which is a perfectly good way to start.
#
# PUBLIC_RAZORPAY_KEY_ID is your PUBLISHABLE key (rzp_live_… / rzp_test_…).
# It is safe in the browser. The SECRET key must never appear in this file or
# anywhere in this repository — it lives only in your serverless function's
# environment. See integrations/razorpay/README.md.
PUBLIC_RAZORPAY_KEY_ID=
PUBLIC_ORDER_ENDPOINT=
