---
import Layout from './Layout.astro';
import Hero from '../components/Hero.astro';
import ReadingProgressBar from '../components/ReadingProgressBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

interface Props {
	title: string;
	description: string;
	categoryName: string;
	readTime: string;
	statutoryAct: string;
	currentSlug: string;
	currentCategory: string;
}

const { title, description, categoryName, readTime, statutoryAct, currentSlug, currentCategory } = Astro.props;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": { "@type": "Organization", "name": "FinSight India" },
  "publisher": { "@type": "Organization", "name": "FinSight India" },
  "mainEntityOfPage": { "@type": "WebPage" }
};
---

<Layout title={title} description={description} jsonLd={articleJsonLd} type="article">
	<ReadingProgressBar />
	<!-- Article Hero Section -->
	<section class="hero-glow relative overflow-hidden bg-navy-50 dark:bg-navy-950 border-b border-navy-200 dark:border-navy-800">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12 sm:pt-24 sm:pb-16">
			<Breadcrumbs items={[
				{label: 'Home', href: '/'}, 
				{label: 'Tax Code', href: '/tax-code'}, 
				{label: title}
			]} />
			<div class="flex items-center gap-3 mb-6">
				<span class="badge-gold">{categoryName}</span>
				<span class="text-sm font-medium text-navy-500 dark:text-navy-400">{readTime}</span>
			</div>
			
			<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-navy-900 dark:text-navy-100 tracking-tight leading-tight mb-6">
				{title}
			</h1>
			
			<div class="inline-flex items-center gap-2 px-3 py-1.5 bg-navy-100 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-md text-xs font-semibold text-navy-600 dark:text-navy-400">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
				Statutory Basis: {statutoryAct}
			</div>
		</div>
	</section>

	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-0 pb-8 sm:pb-12">
		<article class="prose prose-slate dark:prose-invert prose-lg max-w-none 
			prose-headings:font-semibold prose-headings:text-navy-900 dark:prose-headings:text-navy-100
			prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b prose-h2:border-navy-200 dark:prose-h2:border-navy-800 prose-h2:first-of-type:mt-0
			prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
			prose-p:text-navy-700 dark:prose-p:text-navy-300 prose-p:leading-relaxed prose-p:first-of-type:mt-0
			prose-a:text-gold-600 dark:prose-a:text-gold-500 prose-a:font-semibold hover:prose-a:text-gold-700
			prose-strong:text-navy-900 dark:prose-strong:text-navy-100 prose-strong:font-bold
			prose-ul:text-navy-700 dark:prose-ul:text-navy-300
			prose-li:my-2
			prose-table:border-collapse prose-th:bg-navy-50 dark:prose-th:bg-navy-900 prose-th:p-3 prose-th:text-left prose-th:border prose-th:border-navy-200 dark:prose-th:border-navy-800
			prose-td:p-3 prose-td:border prose-td:border-navy-200 dark:prose-td:border-navy-800
			prose-code:text-emerald-600 dark:prose-code:text-emerald-400 prose-code:bg-emerald-50 dark:prose-code:bg-emerald-950/50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-sm before:prose-code:content-none after:prose-code:content-none
			prose-img:mix-blend-multiply prose-img:contrast-125 prose-img:brightness-110 dark:prose-img:invert dark:prose-img:mix-blend-screen dark:prose-img:contrast-100 dark:prose-img:brightness-100 prose-img:mx-auto
			">
			<slot />
		</article>
		<ShareButtons title={title} url={Astro.url.href} />
		<RelatedArticles currentSlug={currentSlug} currentCategory={currentCategory} />
	</main>
</Layout>
