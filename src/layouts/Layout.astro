---
import '../styles/global.css';
import '@fontsource/geist-sans';
import '@fontsource/geist-mono';
import defaultOgImage from '../assets/images/crypto-mining-rig.jpg';
import { pwaInfo } from 'virtual:pwa-info';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: string;
	canonicalUrl?: string;
	jsonLd?: Record<string, any>;
}

const { 
	title = "FinSight India — Financial Intelligence Platform",
	description = "India's most trusted financial intelligence platform. Monte Carlo simulators, tax calculators, insurance analyzers, and 100+ expert articles for smart financial decisions.",
	image = defaultOgImage.src,
	type = 'website',
	canonicalUrl,
	jsonLd,
} = Astro.props;

const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="bg-navy-50 text-navy-900 dark:bg-navy-950 dark:text-navy-100">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0A192F" />
		
		<!-- PWA Manifest -->
		{ pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} /> }

		<!-- RSS Auto-Discovery -->
		<link rel="alternate" type="application/rss+xml" title="FinSight India - Direct Tax Guide" href={new URL("rss.xml", Astro.site)} />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonical} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(image, Astro.site).href} />
		<meta property="og:site_name" content="FinSight India" />
		<meta property="og:locale" content="en_IN" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site).href} />

		<!-- JSON-LD Structured Data -->
		{jsonLd && (
		  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		)}

		<!-- Default WebSite Schema (always present) -->
		<script type="application/ld+json" set:html={JSON.stringify({
		  "@context": "https://schema.org",
		  "@type": "WebSite",
		  "name": "FinSight India",
		  "url": "https://finsightindia.in",
		  "description": "India's most trusted financial intelligence platform.",
		  "potentialAction": {
		    "@type": "SearchAction",
		    "target": "https://finsightindia.in/tax-code?q={search_term_string}",
		    "query-input": "required name=search_term_string"
		  }
		})} />

		<!-- Prevent Flash of Unstyled Theme -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="bg-navy-50 text-navy-900 dark:bg-navy-950 dark:text-navy-100 min-h-screen font-sans flex flex-col selection:bg-navy-900 selection:text-white dark:selection:bg-gold-500 dark:selection:text-navy-950 antialiased transition-colors duration-300">
		<a class="skip-link" href="#main-content">Skip to main content</a>
		
		<!-- ====================================================
		     PREMIUM GLASSMORPHISM HEADER
		     ==================================================== -->
		<header class="glass-header sticky top-0 z-50 transition-all duration-300">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex items-center justify-between h-16">
					
					<!-- Logo & Brand -->
					<a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-gold-500 rounded-lg p-1 -m-1">
						<div class="w-9 h-9 rounded-xl bg-gradient-to-br from-navy-900 to-navy-800 dark:from-gold-500 dark:to-gold-400 text-white dark:text-navy-950 flex items-center justify-center font-bold text-sm shadow-md group-hover:shadow-lg group-hover:scale-105 transition-all duration-300 ease-premium">
							₹
						</div>
						<div class="flex items-baseline gap-2">
							<span class="text-base font-bold tracking-tight text-navy-900 dark:text-navy-100">
								FinSight
							</span>
							<span class="text-[11px] font-semibold text-gold-500 uppercase tracking-wider hidden sm:inline-block">
								India
							</span>
						</div>
					</a>
					
					<!-- Desktop Navigation -->
					<nav class="hidden lg:flex items-center gap-1">
						<!-- Calculators Dropdown -->
						<div class="relative group">
							<button class="nav-link text-sm font-medium px-3 py-2 rounded-lg transition-colors text-navy-500 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 flex items-center gap-1">
								Calculators
								<svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
							</button>
							<div class="absolute left-0 top-full mt-1 w-52 bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-700 rounded-xl shadow-[0_10px_40px_-10px_rgba(0,0,0,0.1)] dark:shadow-[0_10px_40px_-10px_rgba(0,0,0,0.5)] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 translate-y-2 transition-all duration-300 transform origin-top-left z-50 p-2">
								<a href="/swp-planner" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">SWP Planner</a>
								<a href="/sip-engine" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">SIP Engine</a>
								<a href="/tax-calculator" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">Tax Calculator</a>
								<a href="/black-scholes" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">Options Lab</a>
								<a href="/insurance-analyzer" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">Policy Analyzer</a>
							</div>
						</div>

						<a href="/tax-code" class={`nav-link text-sm font-medium px-3 py-2 rounded-lg transition-colors ${currentPath.startsWith('/tax-code') ? 'text-gold-500 active' : 'text-navy-500 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100'}`}>
							Tax Code
						</a>
						<a href="/faq" class={`nav-link text-sm font-medium px-3 py-2 rounded-lg transition-colors ${currentPath === '/faq' || currentPath === '/faq/' ? 'text-gold-500 active' : 'text-navy-500 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100'}`}>
							FAQs
						</a>

						<!-- Studio Dropdown -->
						<div class="relative group">
							<button class="nav-link text-sm font-medium px-3 py-2 rounded-lg transition-colors text-navy-500 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 flex items-center gap-1">
								Studio
								<svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
							</button>
							<div class="absolute right-0 top-full mt-1 w-48 bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-700 rounded-xl shadow-[0_10px_40px_-10px_rgba(0,0,0,0.1)] dark:shadow-[0_10px_40px_-10px_rgba(0,0,0,0.5)] opacity-0 invisible group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 translate-y-2 transition-all duration-300 transform origin-top-right z-50 p-2">
								<a href="/creator-log" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">Creator Log</a>
								<a href="/research-ledger" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">Research Ledger</a>
								<a href="/reels" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">Reels Script</a>
								<a href="/solutions" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">Solutions</a>
								<a href="/standards" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">Standards</a>
								<a href="/shelved-ideas" class="block px-3 py-2.5 rounded-lg text-sm font-medium text-navy-600 dark:text-navy-300 hover:bg-navy-50 dark:hover:bg-navy-800 hover:text-gold-600 dark:hover:text-gold-400 transition-colors">Shelved Ideas</a>
							</div>
						</div>
					</nav>

					<!-- Right Controls -->
					<div class="flex items-center gap-2">
						<!-- Theme Toggle -->
						<button 
							id="theme-toggle"
							type="button" 
							aria-label="Toggle theme mode"
							class="h-9 w-9 flex items-center justify-center rounded-xl border border-navy-200 dark:border-navy-700 text-navy-500 dark:text-navy-400 hover:text-gold-500 dark:hover:text-gold-500 hover:border-gold-500/30 dark:hover:border-gold-500/30 hover:bg-gold-500/5 transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-gold-500"
						>
							<!-- Sun Icon (visible in dark mode) -->
							<svg class="w-4 h-4 hidden dark:block fill-current pointer-events-none" viewBox="0 0 24 24">
								<path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z"/>
							</svg>
							<!-- Moon Icon (visible in light mode) -->
							<svg class="w-4 h-4 block dark:hidden fill-current pointer-events-none" viewBox="0 0 24 24">
								<path d="M12.3 2a10 10 0 0 0-1.9 20 10 10 0 0 0 9.6-7c-.1 0-.3.1-.5.1a8 8 0 0 1-7.2-13.1z"/>
							</svg>
						</button>

						<!-- Mobile Menu Toggle -->
						<button 
							id="mobile-menu-toggle"
							type="button"
							aria-label="Open navigation menu"
							class="lg:hidden h-9 w-9 flex items-center justify-center rounded-xl border border-navy-200 dark:border-navy-700 text-navy-500 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-gold-500"
						>
							<svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
							</svg>
						</button>
					</div>
				</div>
			</div>
		</header>

		<!-- ====================================================
		     MOBILE NAVIGATION DRAWER
		     ==================================================== -->
		<div id="mobile-nav-overlay" class="mobile-nav-overlay"></div>
		<nav id="mobile-nav-drawer" class="mobile-nav-drawer">
			<div class="p-6">
				<!-- Close button -->
				<div class="flex items-center justify-between mb-8">
					<div class="flex items-center gap-3">
						<div class="w-9 h-9 rounded-xl bg-gradient-to-br from-navy-900 to-navy-800 dark:from-gold-500 dark:to-gold-400 text-white dark:text-navy-950 flex items-center justify-center font-bold text-sm">₹</div>
						<span class="text-base font-bold text-navy-900 dark:text-navy-100">FinSight <span class="text-gold-500 text-sm">India</span></span>
					</div>
					<button id="mobile-menu-close" class="h-9 w-9 flex items-center justify-center rounded-xl text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 transition-colors cursor-pointer">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>
				</div>

				<!-- Mobile Nav Links -->
				<div class="space-y-1">
					<a href="/swp-planner" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${currentPath === '/swp-planner' || currentPath === '/swp-planner/' ? 'bg-gold-500/10 text-gold-600 dark:text-gold-400' : 'text-navy-600 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800'}`}>
						<svg class="w-5 h-5 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
						SWP Planner
					</a>
					<a href="/sip-engine" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${currentPath.startsWith('/sip-engine') ? 'bg-gold-500/10 text-gold-600 dark:text-gold-400' : 'text-navy-600 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800'}`}>
						<svg class="w-5 h-5 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" /></svg>
						SIP Engine
					</a>
					<a href="/insurance-analyzer" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${currentPath.startsWith('/insurance-analyzer') ? 'bg-gold-500/10 text-gold-600 dark:text-gold-400' : 'text-navy-600 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800'}`}>
						<svg class="w-5 h-5 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
						Policy Analyzer
					</a>
					<a href="/black-scholes" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${currentPath.startsWith('/black-scholes') ? 'bg-gold-500/10 text-gold-600 dark:text-gold-400' : 'text-navy-600 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800'}`}>
						<svg class="w-5 h-5 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" /></svg>
						Options Lab
					</a>
					<a href="/tax-calculator" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${currentPath.startsWith('/tax-calculator') ? 'bg-gold-500/10 text-gold-600 dark:text-gold-400' : 'text-navy-600 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800'}`}>
						<svg class="w-5 h-5 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V18Zm2.498-6.75h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V13.5Zm0 2.25h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V18Zm2.504-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V18Zm2.498-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5ZM8.25 8.25h7.5a2.25 2.25 0 0 1 2.25 2.25v9a2.25 2.25 0 0 1-2.25 2.25h-7.5a2.25 2.25 0 0 1-2.25-2.25v-9a2.25 2.25 0 0 1 2.25-2.25Z" /></svg>
						Tax Calculator
					</a>
					<a href="/tax-code" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${currentPath.startsWith('/tax-code') ? 'bg-gold-500/10 text-gold-600 dark:text-gold-400' : 'text-navy-600 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800'}`}>
						<svg class="w-5 h-5 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
						Tax Code
					</a>
					<a href="/faq" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${currentPath.startsWith('/faq') ? 'bg-gold-500/10 text-gold-600 dark:text-gold-400' : 'text-navy-600 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800'}`}>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						FAQs
					</a>
					<a href="/creator-log" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${currentPath.startsWith('/creator-log') ? 'bg-gold-500/10 text-gold-600 dark:text-gold-400' : 'text-navy-600 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800'}`}>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
