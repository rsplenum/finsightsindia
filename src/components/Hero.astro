---
export interface Props {
	badge?: string;
	title: string;
	description?: string;
}

const { badge, title, description } = Astro.props;
---

<section class="hero-glow reveal max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-6 sm:pt-16 sm:pb-8 flex flex-col items-center text-center">
	{badge && (
		<span class="inline-block text-xs font-semibold tracking-wider text-gold-500 uppercase px-3 py-1 bg-gold-500/10 rounded-md border border-gold-500/20">
			{badge}
		</span>
	)}
	<h1 class="text-hero text-navy-900 dark:text-navy-100 max-w-4xl mt-4">
		<Fragment set:html={title} />
	</h1>
	{description && (
		<p class="mt-5 text-lg sm:text-xl text-navy-500 dark:text-navy-400 max-w-2xl leading-relaxed font-normal">
			{description}
		</p>
	)}
</section>
