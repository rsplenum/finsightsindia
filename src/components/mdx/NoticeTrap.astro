---
export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="my-8 rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50/50 dark:bg-rose-950/20 p-5 shadow-sm">
	<div class="flex items-start gap-4">
		<div class="flex-shrink-0 mt-0.5 bg-rose-100 dark:bg-rose-900/50 p-1.5 rounded-md text-rose-600 dark:text-rose-400">
			<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
			</svg>
		</div>
		<div class="space-y-1.5 w-full">
			<h4 class="text-base font-bold text-rose-800 dark:text-rose-300 tracking-wide m-0">
				{title}
			</h4>
			<div class="text-base text-navy-800 dark:text-navy-200 leading-relaxed 
				[&>p]:m-0 [&>p]:mb-3 last:[&>p]:mb-0 
				[&>p>strong]:text-rose-900 dark:[&>p>strong]:text-rose-200 [&>p>strong]:font-semibold">
				<slot />
			</div>
		</div>
	</div>
</div>
