---
---
<div class="w-full bg-slate-50 dark:bg-slate-900 rounded-2xl p-6 sm:p-10 my-8 border border-slate-200 dark:border-slate-800 shadow-sm relative overflow-hidden">
  
  <!-- Subtle danger background stripes -->
  <div class="absolute inset-0 bg-[repeating-linear-gradient(45deg,transparent,transparent_10px,rgba(239,68,68,0.02)_10px,rgba(239,68,68,0.02)_20px)]"></div>
  
  <h4 class="relative z-10 text-center text-slate-800 dark:text-slate-200 font-black tracking-widest uppercase mb-8 text-sm">Years Later (Late Discovery)</h4>
  
  <div class="relative z-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8">
    
    <!-- Tax + Interest -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border-t-4 border-red-600 shadow-sm w-full sm:w-56 text-center border-x border-b border-slate-200 dark:border-slate-700">
      <div class="text-red-700 dark:text-red-400 font-bold text-lg leading-tight">Tax + Interest</div>
      <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-2">Cash Demand Issued</div>
    </div>
    
    <!-- Plus Sign -->
    <div class="text-slate-400 dark:text-slate-500 text-2xl font-black">+</div>
    
    <!-- Blocked Door -->
    <div class="bg-slate-100 dark:bg-slate-800 p-6 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-600 shadow-sm w-full sm:w-56 text-center relative overflow-hidden">
      <!-- Cross out line -->
      <div class="absolute top-1/2 left-0 right-0 h-0.5 bg-red-500 -rotate-12 -translate-y-1/2 z-0 opacity-50"></div>
      <div class="relative z-10 text-slate-500 dark:text-slate-400 font-bold text-lg">Credit Door Closed</div>
      <div class="relative z-10 text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-2">Time-Barred for ITC</div>
    </div>
    
    <!-- Equals Sign -->
    <div class="text-slate-400 dark:text-slate-500 text-2xl font-black">=</div>
    
    <!-- Pure Loss -->
    <div class="bg-red-50 dark:bg-red-900 p-6 rounded-xl border-t-4 border-red-600 shadow-md w-full sm:w-56 text-center border-x border-b border-red-100 dark:border-slate-700 relative overflow-hidden">
       <!-- Subtle highlight -->
      <div class="absolute inset-0 bg-red-400 opacity-10"></div>
      <div class="relative z-10 text-red-700 dark:text-red-400 font-black text-xl">Pure Cash Loss</div>
      <div class="relative z-10 text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-2">Unrecoverable Liability</div>
    </div>

  </div>
</div>
