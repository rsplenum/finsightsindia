---

<div class="my-10 p-8 bg-slate-50 dark:bg-[#0B1120] rounded-xl border border-slate-200 dark:border-navy-700 shadow-sm relative overflow-hidden flex flex-col items-center">
  
  <div class="w-full max-w-4xl grid grid-cols-1 lg:grid-cols-3 gap-6 relative z-10">
    
    {/* Connection Arrows (Desktop only) */}
    <div class="hidden md:block absolute top-1/2 left-1/3 -translate-x-1/2 -translate-y-1/2 z-0">
      
    </div>
    <div class="hidden md:block absolute top-1/2 right-1/3 translate-x-1/2 -translate-y-1/2 z-0">
      
    </div>

    {/* NRI Balance Sheet */}
    <div class="bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-700 rounded-xl p-5 shadow-sm flex flex-col items-center text-center z-10">
      <div class="w-12 h-12 bg-slate-100 dark:bg-navy-800 rounded-full flex items-center justify-center mb-3">
        
      </div>
      <div class="text-sm font-bold tracking-widest text-slate-800 dark:text-white uppercase mb-4">NRI</div>
      
      <div class="w-full bg-emerald-50 dark:bg-emerald-900/10 border border-emerald-100 dark:border-emerald-800/30 rounded p-3 mb-3">
        <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-1">Asset</div>
        <div class="text-lg font-black text-emerald-600 dark:text-emerald-400">$1 Billion</div>
      </div>
      
      
      
      <div class="w-full bg-slate-50 dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded p-3">
        <div class="text-xs font-bold text-slate-700 dark:text-slate-300">FCNR Deposit</div>
      </div>
    </div>

    {/* BANK Balance Sheet */}
    <div class="bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-700 rounded-xl p-5 shadow-sm flex flex-col items-center text-center z-10 transform md:-translate-y-2">
      <div class="w-12 h-12 bg-emerald-100 dark:bg-emerald-900/30 rounded-full flex items-center justify-center mb-3">
        
      </div>
      <div class="text-sm font-bold tracking-widest text-slate-800 dark:text-white uppercase mb-4">Indian Bank</div>
      
      <div class="w-full bg-rose-50 dark:bg-rose-900/10 border border-rose-100 dark:border-rose-800/30 rounded p-3 mb-2">
        <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-1">Liability</div>
        <div class="text-sm font-bold text-rose-600 dark:text-rose-400">USD Deposit</div>
      </div>
      
      
      
      <div class="w-full bg-indigo-50 dark:bg-indigo-900/10 border border-indigo-100 dark:border-indigo-800/30 rounded p-3 mb-2">
        <div class="text-xs font-bold text-indigo-600 dark:text-indigo-400">FX Swap</div>
      </div>
      
      
      
      <div class="w-full bg-emerald-50 dark:bg-emerald-900/10 border border-emerald-100 dark:border-emerald-800/30 rounded p-3">
        <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-1">Asset</div>
        <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400">INR Liquidity / Assets</div>
      </div>
    </div>

    {/* RBI Balance Sheet */}
    <div class="bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-700 rounded-xl p-5 shadow-sm flex flex-col items-center text-center z-10">
      <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900/30 rounded-full flex items-center justify-center mb-3">
        
      </div>
      <div class="text-sm font-bold tracking-widest text-slate-800 dark:text-white uppercase mb-4">RBI</div>
      
      <div class="w-full bg-emerald-50 dark:bg-emerald-900/10 border border-emerald-100 dark:border-emerald-800/30 rounded p-3 mb-3">
        <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-1">Asset</div>
        <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400">USD Received Today</div>
      </div>
      
      
      
      <div class="w-full bg-rose-50 dark:bg-rose-900/10 border border-rose-100 dark:border-rose-800/30 rounded p-3">
        <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-1">Liability</div>
        <div class="text-sm font-bold text-rose-600 dark:text-rose-400">Future Swap Settlement Obligation</div>
      </div>
    </div>
  </div>

  <div class="mt-12 text-center relative z-10 w-full max-w-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 py-4 px-6 rounded-xl shadow-lg transform -rotate-1 hover:rotate-0 transition-transform">
    <div class="text-lg md:text-2xl font-black tracking-widest uppercase">One Dollar. Three Balance Sheets. One Clock.</div>
  </div>

  <div class="mt-8 pt-4 max-w-2xl mx-auto text-center relative z-10">
    <p class="text-sm text-slate-600 dark:text-slate-400 italic">The FCNR machine does not create dollars. It changes who holds the claim, who carries the currency risk and when the obligation has to be settled.</p>
  </div>
</div>
