---

---

<div class="my-10 p-8 bg-slate-50 dark:bg-[#0B1120] rounded-xl border border-slate-200 dark:border-navy-700 shadow-sm relative overflow-hidden">
  
  <div class="text-xs font-bold tracking-widest text-slate-400 dark:text-navy-400 uppercase mb-12 text-center">Policy Benefit of Foreign-Currency Inflows</div>

  <div class="relative w-full max-w-2xl mx-auto h-80 flex items-end">
    
    {/* SVG Bell Curve */}
    <div class="absolute inset-x-0 bottom-16 h-56 w-full">
      <svg viewBox="0 0 100 50" class="w-full h-full overflow-visible preserve-3d" preserveAspectRatio="none">
        <defs>
          <linearGradient id="bellGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="currentColor" class="text-rose-400/20" />
            <stop offset="50%" stop-color="currentColor" class="text-emerald-500/40" />
            <stop offset="100%" stop-color="currentColor" class="text-rose-400/20" />
          </linearGradient>
          <linearGradient id="lineGradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="currentColor" class="text-rose-500" />
            <stop offset="50%" stop-color="currentColor" class="text-emerald-500" />
            <stop offset="100%" stop-color="currentColor" class="text-rose-500" />
          </linearGradient>
        </defs>
        
        {/* Fill */}
        <path d="M 0 50 C 20 50, 30 5, 50 5 C 70 5, 80 50, 100 50 L 100 50 L 0 50 Z" fill="url(#bellGradient)" />
        {/* Stroke */}
        <path d="M 0 50 C 20 50, 30 5, 50 5 C 70 5, 80 50, 100 50" fill="none" stroke="url(#lineGradient)" stroke-width="0.5" />
        
        {/* Grid lines */}
        <line x1="20" y1="0" x2="20" y2="50" stroke="currentColor" stroke-dasharray="1 2" stroke-width="0.2" class="text-slate-300 dark:text-navy-700" />
        <line x1="50" y1="0" x2="50" y2="50" stroke="currentColor" stroke-dasharray="1 2" stroke-width="0.2" class="text-slate-300 dark:text-navy-700" />
        <line x1="80" y1="0" x2="80" y2="50" stroke="currentColor" stroke-dasharray="1 2" stroke-width="0.2" class="text-slate-300 dark:text-navy-700" />
      </svg>
    </div>

    {/* Marker at 2026 response (just past the peak) */}
    <div class="absolute bottom-[120px] left-[60%] flex flex-col items-center -translate-x-1/2 -translate-y-full z-20">
      <div class="bg-slate-800 dark:bg-white text-white dark:text-slate-900 text-[10px] sm:text-xs font-bold px-3 py-1.5 rounded-md shadow-lg flex items-center gap-1">
        2026 INFLOWS
        
      </div>
      <div class="w-px h-6 bg-slate-800 dark:bg-white"></div>
      <div class="w-2 h-2 bg-slate-800 dark:bg-white rounded-full"></div>
      
      {/* Arrow pointing down-right indicating closing the window */}
      <div class="absolute -right-24 top-2 text-[10px] font-bold text-rose-500 dark:text-rose-400 uppercase tracking-widest bg-white dark:bg-navy-900 border border-rose-200 dark:border-rose-800/50 px-2 py-1 rounded shadow-sm whitespace-nowrap">
        Closing Window
      </div>
    </div>

    {/* Base Axis */}
    <div class="w-full h-1 bg-slate-200 dark:bg-navy-700 absolute bottom-16"></div>

    {/* Labels */}
    <div class="w-full flex justify-between absolute bottom-0 px-2 sm:px-6">
      <div class="text-center w-1/3 pr-2">
        <div class="text-xs font-bold text-slate-800 dark:text-white uppercase mb-1">Too Little</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">External pressure</div>
      </div>
      
      <div class="text-center w-1/3 px-2">
        <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase mb-1">Optimal</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">FX stability &<br/>reserve rebuilding</div>
      </div>
      
      <div class="text-center w-1/3 pl-2">
        <div class="text-xs font-bold text-rose-500 dark:text-rose-400 uppercase mb-1">Too Much</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">Excess liquidity<br/>Future liability<br/>Distortion</div>
      </div>
    </div>
  </div>

  <div class="mt-12 border-t border-slate-200 dark:border-navy-700 pt-4 max-w-2xl mx-auto text-center">
    <p class="text-sm text-slate-600 dark:text-slate-400 italic">For a central bank, the objective is not to maximise foreign inflows. It is to find the quantity that improves external stability without creating a new imbalance.</p>
  </div>
</div>
