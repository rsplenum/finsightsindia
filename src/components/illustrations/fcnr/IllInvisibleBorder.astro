---
---
<div class="my-10 p-8 bg-slate-50 dark:bg-[#0B1121] rounded-2xl border border-slate-200 dark:border-navy-800 shadow-sm relative overflow-hidden">
  
  <!-- The Vertical Wall -->
  <div class="absolute inset-y-0 left-1/2 w-px bg-gradient-to-b from-transparent via-slate-300 dark:via-navy-600 to-transparent z-0"></div>
  <div class="absolute inset-y-0 left-1/2 -ml-[1px] w-[3px] bg-white/50 dark:bg-navy-900/50 blur-[1px] z-0"></div>

  <div class="grid grid-cols-2 gap-12 relative z-10">
    
    <!-- LEFT: NRI World -->
    <div class="flex flex-col items-center">
      <div class="text-sm font-bold tracking-widest text-slate-400 dark:text-navy-400 uppercase mb-6">Offshore</div>
      <div class="bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl p-6 shadow-sm w-full max-w-[200px] flex flex-col items-center">
        <div class="w-12 h-12 bg-emerald-100 dark:bg-emerald-900/30 rounded-full flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-xl mb-3 border border-emerald-200 dark:border-emerald-800/50">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div class="font-semibold text-slate-800 dark:text-slate-200 tracking-wide text-center">NRI</div>
        <div class="text-sm text-emerald-600 dark:text-emerald-400 font-sans mt-1 font-semibold text-center">USD WEALTH</div>
      </div>
    </div>

    <!-- RIGHT: India World -->
    <div class="flex flex-col items-center">
      <div class="text-sm font-bold tracking-widest text-slate-400 dark:text-navy-400 uppercase mb-6">Onshore</div>
      <div class="bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-700 rounded-xl p-6 shadow-sm w-full max-w-[200px] flex flex-col items-center">
        <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900/30 rounded-full flex items-center justify-center text-indigo-600 dark:text-indigo-400 text-xl mb-3 border border-indigo-200 dark:border-indigo-800/50">
          <span class="font-serif italic font-bold">₹</span>
        </div>
        <div class="font-semibold text-slate-800 dark:text-slate-200 tracking-wide text-center">INDIA</div>
        <div class="text-sm text-slate-500 dark:text-navy-400 font-medium mt-1 text-center leading-tight">Rupee loans<br/>Indian banks</div>
      </div>
    </div>

  </div>

  <!-- The Bridges -->
  <div class="mt-12 space-y-8 relative z-10">
    
    <!-- NRE Bridge -->
    <div class="relative group">
      <div class="text-sm font-bold tracking-widest text-slate-500 dark:text-navy-400 mb-2 pl-4">PATH 1: NRE DEPOSIT</div>
      <div class="bg-white dark:bg-navy-800/80 border border-slate-200 dark:border-navy-700 rounded-lg p-4 flex items-center justify-between shadow-sm">
        <div class="flex items-center space-x-3 w-1/3">
          <div class="text-emerald-600 dark:text-emerald-400 font-sans font-bold text-sm bg-emerald-50 dark:bg-emerald-900/20 px-2 py-1 rounded border border-emerald-100 dark:border-emerald-800/30">USD</div>
        </div>
        
        <div class="flex-1 flex flex-col items-center relative px-4">
          <div class="w-full border-t-2 border-dashed border-rose-300 dark:border-rose-800/50 absolute top-1/2 -translate-y-1/2"></div>
          <div class="bg-rose-50 dark:bg-rose-900/20 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800/30 px-3 py-1 rounded-full text-sm font-bold tracking-wide z-10 flex items-center space-x-1 shadow-sm">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <span>CONVERT TO INR</span>
          </div>
        </div>

        <div class="flex items-center justify-end w-1/3">
          <div class="text-indigo-600 dark:text-indigo-400 font-sans font-bold text-sm bg-indigo-50 dark:bg-indigo-900/20 px-3 py-1.5 rounded border border-indigo-100 dark:border-indigo-800/30 text-right">
            INR DEPOSIT<br/>
            <span class="text-xs text-rose-500 dark:text-rose-400 tracking-normal font-sans">Currency risk assumed</span>
          </div>
        </div>
      </div>
    </div>

    <!-- FCNR Bridge -->
    <div class="relative group">
      <div class="text-sm font-bold tracking-widest text-gold-600 dark:text-gold-500 mb-2 pl-4 flex items-center gap-2">
        PATH 2: FCNR(B) DEPOSIT
        <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse hidden"></span>
      </div>
      <div class="bg-gold-50/50 dark:bg-gold-900/10 border border-gold-200 dark:border-gold-800/50 rounded-lg p-4 flex items-center justify-between shadow-sm relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 dark:via-white/5 to-transparent -translate-x-full"></div>
        
        <div class="flex items-center space-x-3 w-1/3 z-10">
          <div class="text-emerald-600 dark:text-emerald-400 font-sans font-bold text-sm bg-emerald-50 dark:bg-emerald-900/20 px-2 py-1 rounded border border-emerald-100 dark:border-emerald-800/30">USD</div>
        </div>
        
        <div class="flex-1 flex flex-col items-center relative px-4 z-10">
          <div class="w-full border-t-2 border-solid border-emerald-300 dark:border-emerald-700 absolute top-1/2 -translate-y-1/2"></div>
          <div class="bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/30 px-3 py-1 rounded-full text-sm font-bold tracking-wide z-10 shadow-sm">
            NO CONVERSION
          </div>
        </div>

        <div class="flex items-center justify-end w-1/3 z-10">
          <div class="text-emerald-700 dark:text-emerald-400 font-sans font-bold text-sm bg-emerald-50 dark:bg-emerald-900/20 px-3 py-1.5 rounded border border-emerald-100 dark:border-emerald-800/30 text-right">
            USD CLAIM<br/>
            <span class="text-xs text-emerald-600 dark:text-emerald-500 tracking-normal font-sans">Denomination preserved</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
