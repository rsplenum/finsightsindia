<div class="my-10 p-8 bg-slate-50 dark:bg-[#0B1120] rounded-xl border border-slate-200 dark:border-navy-700 shadow-sm relative flex flex-col items-center">
  
  <div class="bg-rose-50 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800/50 px-6 py-2 rounded-full text-sm font-bold tracking-widest uppercase shadow-sm whitespace-nowrap mb-6">
    India Needs Foreign Currency
  </div>

  

  <div class="bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800/50 px-6 py-2 rounded-lg text-sm font-bold tracking-wide shadow-sm text-center mb-6 w-full max-w-sm">
    RBI changes the economics of FX
  </div>

  {/* Two columns: Deposit Pricing and FX Hedge */}
  <div class="flex flex-col lg:flex-row gap-6 w-full max-w-2xl mb-6">
    <div class="flex-1 flex flex-col items-center">
      
      <div class="bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-700 p-4 rounded-xl shadow-sm text-center w-full">
        <div class="text-sm font-bold text-slate-800 dark:text-white uppercase mb-1">Higher FCNR Rates</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">BANKS</div>
      </div>
      
      <div class="bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-700 p-4 rounded-xl shadow-sm text-center w-full">
        <div class="text-sm font-bold text-slate-800 dark:text-white uppercase mb-1">NRIs Respond</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">USD INFLOW</div>
      </div>
    </div>
    
    <div class="flex-1 flex flex-col items-center">
      
      <div class="bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-700 p-4 rounded-xl shadow-sm text-center w-full">
        <div class="text-sm font-bold text-slate-800 dark:text-white uppercase mb-1">Concessional FX Swap</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">Regulatory / reporting support</div>
      </div>
      
      <div class="bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-700 p-4 rounded-xl shadow-sm text-center w-full">
        <div class="text-sm font-bold text-slate-800 dark:text-white uppercase mb-1">RBI Swap</div>
        <div class="text-[10px] text-slate-500 dark:text-slate-400 leading-tight">BANK ↔ RBI</div>
      </div>
    </div>
  </div>

  

  {/* Three outcomes */}
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 w-full max-w-3xl mb-8">
    <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800/40 p-4 rounded-lg text-center">
      <div class="text-sm font-bold text-emerald-700 dark:text-emerald-400">FX Liquidity</div>
    </div>
    <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800/40 p-4 rounded-lg text-center">
      <div class="text-sm font-bold text-emerald-700 dark:text-emerald-400">External Buffer</div>
    </div>
    <div class="bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800/40 p-4 rounded-lg text-center">
      <div class="text-sm font-bold text-rose-700 dark:text-rose-400">2029–31 Maturity</div>
      <div class="text-[10px] text-rose-600/70 dark:text-rose-500 mt-1 uppercase">Future Obligation</div>
    </div>
  </div>

  

  <div class="bg-slate-900 dark:bg-white text-white dark:text-slate-900 border border-slate-800 dark:border-slate-200 px-8 py-4 rounded-xl text-lg font-black tracking-widest uppercase shadow-lg text-center w-full max-w-sm">
    India Gets Time
  </div>

</div>
