<div class="my-10 p-8 bg-slate-50 dark:bg-[#0B1120] rounded-xl border border-slate-200 dark:border-navy-700 shadow-sm relative overflow-hidden flex flex-col items-center">
  {/* Background decorative elements */}
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-300 dark:via-navy-600 to-transparent"></div>
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-slate-200 dark:bg-navy-800 rounded-full blur-3xl opacity-20"></div>

  <div class="text-xs font-bold tracking-widest text-slate-400 dark:text-navy-400 uppercase mb-8">Treasury Control Panel</div>

  <div class="flex flex-col lg:flex-row items-center justify-center gap-8 w-full max-w-3xl relative z-10">
    {/* Left Input: Deposit Pricing */}
    <div class="flex flex-col items-center flex-1">
      <div class="w-16 min-h-[4rem] bg-white dark:bg-navy-900 rounded-full border-2 border-emerald-500 dark:border-emerald-400 flex items-center justify-center mb-4 shadow-sm">
        
      </div>
      <div class="text-sm font-bold tracking-widest text-slate-800 dark:text-white uppercase text-center mb-1">Deposit Pricing</div>
      <div class="text-xs text-slate-500 dark:text-slate-400 text-center font-medium">Higher permissible<br/>FCNR rate</div>
      <div class="h-12 border-l-2 border-dashed border-emerald-300 dark:border-emerald-800 my-2"></div>
      <div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold tracking-wider">PULLS COST DOWN</div>
    </div>

    {/* Center Dial: Bank's Cost */}
    <div class="relative flex flex-col items-center z-20 mx-4">
      <div class="w-56 h-56 bg-white dark:bg-navy-900 rounded-full border-8 border-slate-100 dark:border-navy-800 shadow-xl flex items-center justify-center relative overflow-hidden">
        {/* Dial markings */}
        <div class="absolute inset-0 border-4 border-slate-200 dark:border-navy-700 rounded-full m-2"></div>
        <div class="absolute top-4 w-1 h-4 bg-rose-400 dark:bg-rose-500 rounded-full"></div>
        <div class="absolute top-6 right-10 w-1 h-3 bg-slate-300 dark:bg-navy-600 rotate-45"></div>
        <div class="absolute top-6 left-10 w-1 h-3 bg-slate-300 dark:bg-navy-600 -rotate-45"></div>
        
        {/* The Needle pointing DOWN */}
        <div class="absolute w-1 h-20 bg-emerald-500 dark:bg-emerald-400 origin-top rounded-full top-1/2 rotate-180 shadow-sm"></div>
        <div class="absolute w-4 h-4 bg-slate-800 dark:bg-white rounded-full"></div>
        
        <div class="absolute top-1/4 text-center">
          <div class="text-[10px] sm:text-xs font-bold tracking-widest text-slate-400 dark:text-navy-400 uppercase">Cost of USD</div>
          <div class="text-lg font-bold text-slate-800 dark:text-white leading-none mt-1">FUNDING</div>
        </div>
      </div>
      
      {/* Output Pipe */}
      <div class="w-12 h-16 bg-gradient-to-b from-slate-200 to-slate-100 dark:from-navy-800 dark:to-navy-900 border-x-2 border-slate-300 dark:border-navy-700 relative -mt-2 z-10 flex items-center justify-center">
         
      </div>
      <div class="bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800/50 px-6 py-3 rounded-xl shadow-sm text-center w-full max-w-[200px]">
        <div class="text-emerald-600 dark:text-emerald-400 font-bold text-sm tracking-widest uppercase">USD INFLOW</div>
        <div class="text-xs text-emerald-700/70 dark:text-emerald-500 font-medium mt-1">To Indian Banking System</div>
      </div>
    </div>

    {/* Right Input: FX Hedge */}
    <div class="flex flex-col items-center flex-1">
      <div class="w-16 min-h-[4rem] bg-white dark:bg-navy-900 rounded-full border-2 border-emerald-500 dark:border-emerald-400 flex items-center justify-center mb-4 shadow-sm">
        
      </div>
      <div class="text-sm font-bold tracking-widest text-slate-800 dark:text-white uppercase text-center mb-1">FX Hedge</div>
      <div class="text-xs text-slate-500 dark:text-slate-400 text-center font-medium">Concessional<br/>RBI swap</div>
      <div class="h-12 border-l-2 border-dashed border-emerald-300 dark:border-emerald-800 my-2"></div>
      <div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold tracking-wider">PULLS COST DOWN</div>
    </div>
  </div>

  <div class="mt-10 border-t border-slate-200 dark:border-navy-700 pt-4 max-w-2xl text-center">
    <p class="text-sm text-slate-600 dark:text-slate-400 italic">RBI did not simply make dollars more expensive for itself. It changed the economics of the entire chain through which banks acquire, hedge and deploy foreign currency.</p>
  </div>
</div>
