---
<div class="my-10 p-6 bg-slate-50 dark:bg-navy-900/50 rounded-xl border border-slate-200 dark:border-navy-700 shadow-sm overflow-x-auto">
  <div class="flex flex-col items-center justify-center min-w-[350px] font-sans text-sm space-y-3">
    
    <!-- NRI -->
    <div class="bg-indigo-100 dark:bg-indigo-900/40 border border-indigo-200 dark:border-indigo-700/50 px-6 py-2 rounded shadow-sm text-indigo-900 dark:text-indigo-200 font-semibold tracking-wide w-48 text-center">
      NRI
    </div>
    
    <!-- Flow -->
    <div class="flex flex-col items-center h-12 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="absolute top-1/2 -translate-y-1/2 bg-slate-50 dark:bg-[#111827] px-3 py-1 rounded-full text-xs font-medium text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50 shadow-sm">
        $$
      </div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- FCNR Deposit Booked -->
    <div class="bg-slate-100 dark:bg-navy-800 border border-slate-300 dark:border-navy-600 px-6 py-3 rounded-lg shadow-md font-bold tracking-wider text-slate-700 dark:text-slate-300 w-56 text-center">
      FCNR deposit booked
    </div>
    
    <!-- Time Lag Flow -->
    <div class="flex flex-col items-center h-20 relative w-full">
      <div class="w-[2px] h-full border-l-2 border-dashed border-slate-400 dark:border-navy-500"></div>
      <div class="absolute top-1/2 -translate-y-1/2 bg-rose-50 dark:bg-rose-900/20 px-4 py-1.5 rounded-full text-xs font-bold tracking-wider text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800/50 shadow-sm">
        ⏳ TIME LAG
      </div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-500 dark:border-navy-400 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- Bank holds FX -->
    <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/50 px-6 py-3 rounded-lg shadow-sm font-semibold tracking-wide text-amber-800 dark:text-amber-300 w-56 text-center">
      Bank holds FX
    </div>
    
    <!-- Flow -->
    <div class="flex flex-col items-center h-10 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- RBI FX swap -->
    <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800/50 px-6 py-3 rounded-lg shadow-sm font-semibold tracking-wide text-blue-800 dark:text-blue-300 w-56 text-center">
      RBI FX swap
    </div>
    
    <!-- Flow -->
    <div class="flex flex-col items-center h-10 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- RBI foreign assets -->
    <div class="bg-orange-50 dark:bg-orange-900/20 border border-orange-300 dark:border-orange-700/50 px-8 py-4 rounded-xl shadow-md font-bold tracking-widest text-orange-900 dark:text-orange-300 w-64 text-center text-base">
      <span class="mr-2">🏦</span> RBI foreign assets
    </div>

  </div>
</div>
