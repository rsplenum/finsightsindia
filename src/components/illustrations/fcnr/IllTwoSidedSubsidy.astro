---
---
<div class="my-10 p-8 bg-slate-50 dark:bg-[#0B1121] rounded-2xl border border-slate-200 dark:border-navy-800 shadow-sm overflow-hidden flex flex-col items-center">
  
  <!-- RBI Dials Section (Top) -->
  <div class="w-full flex justify-center space-x-16 mb-8 relative">
    
    <!-- Dial 1 -->
    <div class="flex flex-col items-center relative z-10">
      <div class="w-16 h-16 rounded-full border-4 border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-900 shadow-inner flex items-center justify-center relative">
        <!-- Knob -->
        <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-navy-800 shadow flex items-center justify-center relative transform rotate-45">
          <div class="w-1.5 h-4 bg-emerald-500 rounded-full absolute top-1"></div>
        </div>
        <!-- Markers -->
        <div class="absolute -left-2 text-sm text-slate-400 font-bold">MIN</div>
        <div class="absolute -right-2 text-sm text-emerald-500 font-bold">MAX</div>
      </div>
      <div class="text-sm font-bold tracking-widest text-slate-500 dark:text-navy-400 uppercase mt-3 mb-1">DIAL 1: DEPOSIT RATE</div>
      <div class="text-sm text-slate-600 dark:text-slate-300 font-sans text-center leading-tight bg-white dark:bg-navy-800 px-2 py-1 border border-slate-200 dark:border-navy-700 rounded shadow-sm">Higher permissible<br/>FCNR pricing</div>
    </div>

    <!-- Center Connection/RBI -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-[80%] flex flex-col items-center">
      <div class="bg-indigo-900 dark:bg-indigo-950 text-white text-sm font-bold tracking-widest px-4 py-1 rounded-full shadow-md border border-indigo-700">RBI</div>
      <div class="h-6 w-px bg-indigo-200 dark:bg-indigo-800/50 mt-1"></div>
    </div>

    <!-- Dial 2 -->
    <div class="flex flex-col items-center relative z-10">
      <div class="w-16 h-16 rounded-full border-4 border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-900 shadow-inner flex items-center justify-center relative">
        <!-- Knob -->
        <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-navy-800 shadow flex items-center justify-center relative transform -rotate-45">
          <div class="w-1.5 h-4 bg-emerald-500 rounded-full absolute top-1"></div>
        </div>
        <!-- Markers -->
        <div class="absolute -left-4 text-sm text-emerald-500 font-bold">CHEAP</div>
        <div class="absolute -right-4 text-sm text-slate-400 font-bold">EXPENSIVE</div>
      </div>
      <div class="text-sm font-bold tracking-widest text-slate-500 dark:text-navy-400 uppercase mt-3 mb-1">DIAL 2: FX HEDGE COST</div>
      <div class="text-sm text-slate-600 dark:text-slate-300 font-sans text-center leading-tight bg-white dark:bg-navy-800 px-2 py-1 border border-slate-200 dark:border-navy-700 rounded shadow-sm">Concessional<br/>RBI swap</div>
    </div>
  </div>

  <!-- Flow Arrows Down -->
  <div class="w-full max-w-[300px] flex justify-between items-end h-8 mb-2 relative">
    <div class="w-px h-full bg-emerald-300 dark:bg-emerald-700 ml-8 relative">
       <div class="w-2 h-2 border-r-2 border-b-2 border-emerald-400 dark:border-emerald-500 transform rotate-45 absolute bottom-0 -left-[3.5px]"></div>
    </div>
    <div class="w-px h-full bg-emerald-300 dark:bg-emerald-700 mr-8 relative">
       <div class="w-2 h-2 border-r-2 border-b-2 border-emerald-400 dark:border-emerald-500 transform rotate-45 absolute bottom-0 -left-[3.5px]"></div>
    </div>
  </div>

  <!-- The Balance Scale -->
  <div class="w-full max-w-[400px] relative">
    
    <!-- Balance Beam -->
    <div class="w-full h-2 bg-slate-300 dark:bg-navy-600 rounded-full relative z-10 shadow-sm border-b border-slate-400 dark:border-navy-500">
      <!-- Fulcrum -->
      <div class="w-6 h-6 bg-slate-400 dark:bg-navy-500 rounded-t-sm absolute left-1/2 -translate-x-1/2 -top-1 clip-triangle"></div>
      <div class="w-2 h-16 bg-slate-400 dark:bg-navy-500 absolute left-1/2 -translate-x-1/2 top-2"></div>
      <div class="w-16 h-2 bg-slate-400 dark:bg-navy-500 absolute left-1/2 -translate-x-1/2 top-[70px] rounded-full"></div>
    </div>

    <!-- The Pans -->
    <div class="flex justify-between px-2 pt-6">
      
      <!-- Left Pan (NRI) -->
      <div class="flex flex-col items-center w-[140px]">
        <div class="w-full h-[60px] border-x-2 border-b-2 border-slate-300 dark:border-navy-600 rounded-b-xl relative flex items-end justify-center pb-2 bg-gradient-to-b from-transparent to-slate-100/50 dark:to-navy-800/50">
          <div class="bg-emerald-100 dark:bg-emerald-900/40 border border-emerald-200 dark:border-emerald-700/50 px-3 py-2 rounded-lg shadow-sm text-center -mt-10 bg-white dark:bg-navy-900 z-10">
            <div class="font-bold text-slate-800 dark:text-slate-200 text-sm">NRI</div>
            <div class="text-sm text-emerald-600 dark:text-emerald-400 font-sans mt-1 font-semibold leading-tight">WANTS HIGHER<br/>RETURN</div>
          </div>
        </div>
      </div>

      <!-- Right Pan (BANK) -->
      <div class="flex flex-col items-center w-[140px]">
        <div class="w-full h-[60px] border-x-2 border-b-2 border-slate-300 dark:border-navy-600 rounded-b-xl relative flex items-end justify-center pb-2 bg-gradient-to-b from-transparent to-slate-100/50 dark:to-navy-800/50">
          <div class="bg-indigo-100 dark:bg-indigo-900/40 border border-indigo-200 dark:border-indigo-700/50 px-3 py-2 rounded-lg shadow-sm text-center -mt-10 bg-white dark:bg-navy-900 z-10">
            <div class="font-bold text-slate-800 dark:text-slate-200 text-sm">BANK</div>
            <div class="text-sm text-indigo-600 dark:text-indigo-400 font-sans mt-1 font-semibold leading-tight">WANTS CHEAPER<br/>USD FUNDING</div>
          </div>
        </div>
      </div>
      
    </div>
  </div>

  <!-- Convergence / Final Outcome -->
  <div class="mt-8 flex flex-col items-center w-full">
    <div class="h-6 w-px bg-emerald-400 dark:bg-emerald-600 mb-2"></div>
    <div class="bg-emerald-500 text-white font-bold tracking-widest uppercase px-6 py-2 rounded-full shadow-lg border-2 border-emerald-400 text-sm flex items-center gap-2">
      MORE DOLLARS INTO INDIA
    </div>
  </div>

</div>

<style>
.clip-triangle {
  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
}
</style>
