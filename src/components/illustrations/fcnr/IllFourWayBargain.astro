---
---
<div class="my-12 py-10 px-4 bg-slate-50 dark:bg-[#0B1121] rounded-2xl border border-slate-200 dark:border-navy-800 shadow-sm relative overflow-x-auto flex flex-col items-center w-full">
  
  <div class="relative w-full min-w-[850px] max-w-[900px] h-[650px] flex items-center justify-center mb-8">
    
    <!-- Central Connection / Arrows Circle -->
    <div class="absolute inset-0 m-auto w-[400px] h-[400px] border-2 border-dashed border-slate-300 dark:border-navy-600 rounded-full animate-[spin_60s_linear_infinite] opacity-50 z-0"></div>
    
    <div class="absolute inset-0 m-auto w-[220px] h-[220px] border border-slate-200 dark:border-navy-700 rounded-full z-0 flex items-center justify-center bg-white/50 dark:bg-navy-900/50 backdrop-blur-sm shadow-sm">
      <div class="w-24 h-24 bg-slate-100 dark:bg-navy-800 rounded-full flex flex-col items-center justify-center border border-slate-200 dark:border-navy-600 shadow-inner">
        <span class="text-3xl">🔄</span>
        <span class="text-sm font-bold tracking-widest text-slate-500 dark:text-navy-400 mt-2 uppercase">Bargain</span>
      </div>
    </div>

    <!-- Node 1: NRI (Top) -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 flex flex-col items-center z-10 w-[280px]">
      <div class="bg-white dark:bg-navy-800 border-t-4 border-emerald-500 rounded-2xl p-5 shadow-lg border-x border-b border-slate-200 dark:border-navy-700 w-full text-center hover:-translate-y-1 transition-transform">
        <div class="font-bold text-slate-800 dark:text-white text-base mb-3 uppercase tracking-wide flex items-center justify-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span> NRI
        </div>
        <div class="text-sm text-slate-600 dark:text-slate-300 space-y-2 text-left bg-slate-50 dark:bg-navy-900/50 p-3 rounded-xl border border-slate-100 dark:border-navy-800/50">
          <div class="flex items-start gap-2"><span class="text-emerald-600 dark:text-emerald-500 font-bold w-[72px] shrink-0">Provides:</span> <span>USD</span></div>
          <div class="flex items-start gap-2"><span class="text-indigo-600 dark:text-indigo-500 font-bold w-[72px] shrink-0">Receives:</span> <span>Interest + dollar claim</span></div>
        </div>
      </div>
    </div>

    <!-- Node 2: BANK (Right) -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2 flex flex-col items-center z-10 w-[280px]">
      <div class="bg-white dark:bg-navy-800 border-r-4 border-indigo-500 rounded-2xl p-5 shadow-lg border-t border-b border-l border-slate-200 dark:border-navy-700 w-full text-center hover:translate-x-1 transition-transform">
        <div class="font-bold text-slate-800 dark:text-white text-base mb-3 uppercase tracking-wide flex items-center justify-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 inline-block"></span> BANK
        </div>
        <div class="text-sm text-slate-600 dark:text-slate-300 space-y-2 text-left bg-slate-50 dark:bg-navy-900/50 p-3 rounded-xl border border-slate-100 dark:border-navy-800/50">
          <div class="flex items-start gap-2"><span class="text-indigo-600 dark:text-indigo-500 font-bold w-[72px] shrink-0">Provides:</span> <span>Deposit pricing & banking relationship</span></div>
          <div class="flex items-start gap-2"><span class="text-emerald-600 dark:text-emerald-500 font-bold w-[72px] shrink-0">Receives:</span> <span>Stable FX funding</span></div>
        </div>
      </div>
    </div>

    <!-- Node 3: RBI (Bottom) -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 flex flex-col items-center z-10 w-[280px]">
      <div class="bg-white dark:bg-navy-800 border-b-4 border-purple-500 rounded-2xl p-5 shadow-lg border-x border-t border-slate-200 dark:border-navy-700 w-full text-center hover:translate-y-1 transition-transform">
        <div class="font-bold text-slate-800 dark:text-white text-base mb-3 uppercase tracking-wide flex items-center justify-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-500 inline-block"></span> RBI
        </div>
        <div class="text-sm text-slate-600 dark:text-slate-300 space-y-2 text-left bg-slate-50 dark:bg-navy-900/50 p-3 rounded-xl border border-slate-100 dark:border-navy-800/50">
          <div class="flex items-start gap-2"><span class="text-purple-600 dark:text-purple-400 font-bold w-[72px] shrink-0">Provides:</span> <span>Concessional FX swap & regulatory support</span></div>
          <div class="flex items-start gap-2"><span class="text-emerald-600 dark:text-emerald-500 font-bold w-[72px] shrink-0">Receives:</span> <span>FX liquidity & policy flexibility</span></div>
        </div>
      </div>
    </div>

    <!-- Node 4: INDIA (Left) -->
    <div class="absolute left-0 top-1/2 -translate-y-1/2 flex flex-col items-center z-10 w-[280px]">
      <div class="bg-white dark:bg-navy-800 border-l-4 border-amber-500 rounded-2xl p-5 shadow-lg border-y border-r border-slate-200 dark:border-navy-700 w-full text-center hover:-translate-x-1 transition-transform">
        <div class="font-bold text-slate-800 dark:text-white text-base mb-3 uppercase tracking-wide flex items-center justify-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span> INDIA
        </div>
        <div class="text-sm text-slate-600 dark:text-slate-300 space-y-2 text-left bg-slate-50 dark:bg-navy-900/50 p-3 rounded-xl border border-slate-100 dark:border-navy-800/50">
          <div class="flex items-start gap-2"><span class="text-amber-600 dark:text-amber-500 font-bold w-[72px] shrink-0">Receives:</span> <span>External financing time</span></div>
        </div>
      </div>
    </div>

  </div>

  <!-- The Thin Line Beneath -->
  <div class="w-full max-w-[600px] mt-6 flex flex-col items-center sticky left-0 right-0 mx-auto">
    <div class="w-full h-px bg-gradient-to-r from-transparent via-rose-400 dark:via-rose-600 to-transparent"></div>
    <div class="bg-rose-50 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 border border-rose-200 dark:border-rose-800/50 px-6 py-2 rounded-full text-sm font-bold tracking-widest uppercase mt-0 -translate-y-1/2 shadow-sm whitespace-nowrap bg-white dark:bg-navy-900">
      Future repayment obligation
    </div>
  </div>

</div>
