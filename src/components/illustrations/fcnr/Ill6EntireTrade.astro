---
<div class="my-10 p-6 bg-slate-50 dark:bg-navy-900/50 rounded-xl border border-slate-200 dark:border-navy-700 shadow-sm overflow-x-auto">
  <div class="flex flex-col items-center justify-center min-w-[500px] font-sans text-sm space-y-3 relative pb-4">
    
    <!-- 2026 Header -->
    <div class="bg-slate-800 dark:bg-slate-200 text-white dark:text-slate-900 px-8 py-2 rounded-full font-bold tracking-widest text-lg shadow-md mb-2">
      2026
    </div>
    
    <div class="flex flex-col items-center h-8 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- NRI has dollars -->
    <div class="bg-indigo-100 dark:bg-indigo-900/40 border border-indigo-200 dark:border-indigo-700/50 px-6 py-2 rounded shadow-sm text-indigo-900 dark:text-indigo-200 font-semibold tracking-wide w-48 text-center">
      NRI has dollars
    </div>
    
    <div class="flex flex-col items-center h-8 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- Pay me more -->
    <div class="bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800/50 px-6 py-2 rounded-lg shadow-sm font-bold tracking-wide text-rose-600 dark:text-rose-400 w-48 text-center italic">
      "Pay me more."
    </div>
    
    <div class="flex flex-col items-center h-8 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- RBI changes rules -->
    <div class="bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800/50 px-6 py-2 rounded-lg shadow-sm font-bold tracking-wider text-orange-800 dark:text-orange-300 w-56 text-center">
      RBI changes rules
    </div>
    
    <!-- Branching -->
    <div class="relative w-full h-12 flex justify-center">
      <div class="w-[2px] h-4 bg-slate-300 dark:bg-navy-600 absolute top-0"></div>
      <div class="w-[280px] h-[2px] bg-slate-300 dark:bg-navy-600 absolute top-4"></div>
      <!-- Left Branch -->
      <div class="absolute top-4 left-1/2 -translate-x-[140px] h-8 w-[2px] bg-slate-300 dark:bg-navy-600"></div>
      <div class="absolute top-12 left-1/2 -translate-x-[140px] w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 -mt-[4px] ml-[1px]"></div>
      <!-- Right Branch -->
      <div class="absolute top-4 left-1/2 translate-x-[140px] h-8 w-[2px] bg-slate-300 dark:bg-navy-600"></div>
      <div class="absolute top-12 left-1/2 translate-x-[140px] w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 -mt-[4px] -ml-[1px]"></div>
    </div>
    
    <!-- Split Elements -->
    <div class="flex justify-center space-x-16 w-full pb-2">
      <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-300 dark:border-emerald-700/50 px-4 py-2 rounded-lg shadow-sm font-bold tracking-wide text-emerald-700 dark:text-emerald-400 w-44 text-center">
        Higher rates
      </div>
      <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-300 dark:border-blue-700/50 px-4 py-2 rounded-lg shadow-sm font-bold tracking-wide text-blue-700 dark:text-blue-400 w-44 text-center">
        Cheap FX swap
      </div>
    </div>
    
    <!-- Re-joining -->
    <div class="relative w-full h-12 flex justify-center mb-2">
      <!-- Left Branch Down -->
      <div class="absolute top-0 left-1/2 -translate-x-[140px] h-6 w-[2px] bg-slate-300 dark:bg-navy-600"></div>
      <!-- Right Branch Down -->
      <div class="absolute top-0 left-1/2 translate-x-[140px] h-6 w-[2px] bg-slate-300 dark:bg-navy-600"></div>
      <!-- Horizontal Merge -->
      <div class="w-[280px] h-[2px] bg-slate-300 dark:bg-navy-600 absolute top-6"></div>
      <!-- Central Merged Line Down -->
      <div class="absolute top-6 left-1/2 -translate-x-1/2 h-6 w-[2px] bg-slate-300 dark:bg-navy-600"></div>
      <div class="absolute top-12 left-1/2 -translate-x-1/2 w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 -mt-[4px]"></div>
    </div>
    
    <!-- NRI deposits -->
    <div class="bg-indigo-100 dark:bg-indigo-900/40 border border-indigo-200 dark:border-indigo-700/50 px-6 py-2 rounded shadow-sm text-indigo-900 dark:text-indigo-200 font-semibold tracking-wide w-48 text-center">
      NRI deposits
    </div>
    
    <div class="flex flex-col items-center h-8 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- Indian banking -->
    <div class="bg-slate-100 dark:bg-navy-800 border border-slate-300 dark:border-navy-600 px-6 py-3 rounded-lg shadow-md font-bold tracking-wider text-slate-700 dark:text-slate-300 w-56 text-center">
      Indian banking
    </div>
    
    <div class="flex flex-col items-center h-8 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- RBI receives / manages FX -->
    <div class="bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800/50 px-6 py-3 rounded-lg shadow-md font-bold tracking-widest text-orange-800 dark:text-orange-300 w-64 text-center">
      <span class="mr-2">🏦</span> RBI receives / manages FX
    </div>
    
    <div class="flex flex-col items-center h-8 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- India gets TIME -->
    <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-300 dark:border-emerald-700/50 px-8 py-4 rounded-xl shadow-md font-bold tracking-widest text-emerald-900 dark:text-emerald-300 w-72 text-center text-lg">
      <span class="mr-2">⏳</span> India gets TIME
    </div>
    
    <!-- Massive Time Skip -->
    <div class="flex flex-col items-center h-24 relative w-full my-2">
      <div class="w-[2px] h-full border-l-[3px] border-dotted border-slate-400 dark:border-navy-500"></div>
      <div class="w-3 h-3 border-r-2 border-b-2 border-slate-500 dark:border-navy-400 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- 2029-31 Header -->
    <div class="bg-slate-800 dark:bg-slate-200 text-white dark:text-slate-900 px-8 py-2 rounded-full font-bold tracking-widest text-lg shadow-md mb-2">
      2029–31
    </div>
    
    <div class="flex flex-col items-center h-8 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- I want my dollars -->
    <div class="bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800/50 px-6 py-2 rounded-lg shadow-sm font-bold tracking-wide text-rose-600 dark:text-rose-400 w-56 text-center italic">
      "I want my dollars."
    </div>
    
    <div class="flex flex-col items-center h-8 relative w-full">
      <div class="w-[2px] h-full bg-slate-300 dark:bg-navy-600"></div>
      <div class="w-2.5 h-2.5 border-r-2 border-b-2 border-slate-400 dark:border-navy-500 transform rotate-45 absolute bottom-0 -mb-[1px]"></div>
    </div>
    
    <!-- THE EXIT -->
    <div class="bg-red-600 dark:bg-red-700 border border-red-800 px-10 py-4 rounded-xl shadow-lg font-black tracking-widest text-white w-72 text-center text-xl uppercase">
      THE EXIT
    </div>

  </div>
</div>
