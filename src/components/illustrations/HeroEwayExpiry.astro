---
---
<div class="w-full bg-white dark:bg-slate-900 rounded-[2rem] p-8 sm:p-12 my-8 border border-slate-200 dark:border-slate-800 shadow-xl dark:shadow-2xl relative overflow-hidden font-sans group">
  <!-- Subtle Grid Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
  
  <div class="relative z-10 flex flex-col items-center w-full">
    <div class="text-center mb-20">
        <h3 class="text-slate-800 dark:text-slate-200 text-lg sm:text-2xl font-black tracking-[0.2em] uppercase mb-4">Digital Transit Timeline</h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          The e-way bill acts as a fixed countdown. A routine transit becomes an immediate detention risk the moment the validity window expires.
        </p>
    </div>
    
    <!-- Journey Container -->
    <div class="w-full max-w-5xl relative h-48 px-4 sm:px-16 mt-4">
      
      <!-- Base Journey Line (The Road) -->
      <div class="absolute top-1/2 left-4 sm:left-16 right-4 sm:right-16 h-1.5 bg-slate-200 dark:bg-slate-800 -translate-y-1/2 rounded-full overflow-hidden">
        <!-- Static Dashed Center Line (Magazine style infographic path) -->
        <div class="absolute inset-0 w-full h-full bg-[repeating-linear-gradient(90deg,transparent,transparent_8px,rgba(100,116,139,0.3)_8px,rgba(100,116,139,0.3)_16px)]"></div>
      </div>
      
      <!-- Valid Green Journey (0% to 60%) -->
      <div class="absolute top-1/2 left-4 sm:left-16 w-[60%] h-1.5 bg-gradient-to-r from-emerald-500 to-blue-500 -translate-y-1/2 rounded-l-full shadow-[0_0_15px_rgba(59,130,246,0.2)]"></div>
      
      <!-- Invalid Red Journey (60% to 100%) -->
      <div class="absolute top-1/2 left-[calc(60%+16px)] sm:left-[calc(60%+64px)] right-4 sm:right-16 h-1.5 bg-gradient-to-r from-red-400 to-red-600 dark:from-red-600 dark:to-red-800 -translate-y-1/2 rounded-r-full border-t-2 border-dashed border-red-200/50 dark:border-red-500/50"></div>

      <!-- NODE 1: Dispatched (0%) -->
      <div class="absolute left-4 sm:left-16 top-1/2 -translate-y-1/2 flex flex-col items-center -translate-x-1/2">
        <div class="absolute bottom-12 flex flex-col items-center opacity-90">
            <span class="text-4xl sm:text-5xl mb-3">🏭</span>
            <div class="text-emerald-700 dark:text-emerald-400 font-bold text-sm uppercase tracking-widest whitespace-nowrap">Dispatched</div>
        </div>
        <div class="w-5 h-5 rounded-full bg-emerald-500 ring-4 ring-white dark:ring-slate-900 z-10 shadow-md"></div>
        <div class="absolute top-12 text-center w-32 opacity-80">
            <div class="text-slate-600 dark:text-slate-400 text-xs uppercase font-bold tracking-wider">Clock Starts</div>
        </div>
      </div>

      <!-- NODE 2: In Transit (35%) -->
      <div class="absolute left-[35%] top-1/2 -translate-y-1/2 flex flex-col items-center -translate-x-1/2 z-20">
        <div class="absolute bottom-12 flex flex-col items-center">
            <!-- Static Speed Lines to convey motion elegantly -->
            <div class="absolute top-4 -left-8 flex flex-col gap-1.5 opacity-40">
              <div class="h-0.5 w-6 bg-slate-400 dark:bg-slate-500 rounded-full"></div>
              <div class="h-0.5 w-8 bg-slate-400 dark:bg-slate-500 rounded-full -ml-3"></div>
              <div class="h-0.5 w-4 bg-slate-400 dark:bg-slate-500 rounded-full"></div>
            </div>
            
            <span class="text-5xl sm:text-6xl mb-2 inline-block -scale-x-100 relative z-10 opacity-90">🚚</span>
            <div class="text-blue-700 dark:text-blue-400 font-bold text-sm uppercase tracking-widest whitespace-nowrap bg-blue-50 dark:bg-slate-900 px-3 py-1 rounded-full border border-blue-100 dark:border-slate-700 shadow-md mt-1">In Transit</div>
        </div>
        <div class="w-4 h-4 rounded-full bg-blue-500 ring-4 ring-white dark:ring-slate-900 z-10 shadow-md"></div>
        <div class="absolute top-12 text-center w-32 opacity-80">
            <div class="text-slate-600 dark:text-slate-400 text-xs uppercase font-bold tracking-wider">Valid Status</div>
        </div>
      </div>

      <!-- NODE 3: Expiry Midnight Breakdown (60%) -->
      <div class="absolute left-[calc(60%+16px)] sm:left-[calc(60%+64px)] top-1/2 -translate-y-1/2 flex flex-col items-center -translate-x-1/2">
        <div class="absolute bottom-14 flex flex-col items-center">
            <div class="relative opacity-90">
                <span class="text-4xl sm:text-5xl mb-3 inline-block">⏳</span>
                <!-- Static Breakdown indicator -->
                <span class="absolute -bottom-2 -right-4 text-xl">🚧</span>
            </div>
            <div class="text-amber-700 dark:text-amber-400 font-black text-sm sm:text-base tracking-widest whitespace-nowrap bg-amber-50 dark:bg-slate-800 px-4 py-1.5 rounded-sm border-l-4 border-amber-400 shadow-md mt-2">
               00:00 MIDNIGHT
            </div>
        </div>
        
        <!-- Elegant Static Marker -->
        <div class="absolute w-px h-32 bg-gradient-to-b from-transparent via-amber-300 dark:via-amber-500/50 to-transparent -z-10"></div>
        <div class="w-8 h-8 rounded-full bg-amber-100 dark:bg-slate-800 border-2 border-amber-500 ring-[6px] ring-white dark:ring-slate-900 z-10 flex items-center justify-center shadow-md">
          <div class="w-2.5 h-2.5 rounded-full bg-amber-500"></div>
        </div>
        
        <div class="absolute top-14 text-center w-48 opacity-90">
            <div class="text-amber-700 dark:text-amber-500 text-xs font-bold uppercase tracking-wider">Validity Expires</div>
            <div class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 mt-1">(Breakdown Delay)</div>
        </div>
      </div>

      <!-- NODE 4: Interception (100%) -->
      <div class="absolute right-4 sm:right-16 top-1/2 -translate-y-1/2 flex flex-col items-center translate-x-1/2">
        <div class="absolute bottom-12 flex flex-col items-center opacity-90">
            <div class="relative">
                <!-- Static Interception indicator -->
                <span class="text-5xl sm:text-6xl mb-2 inline-block">🚓</span>
                <!-- Static siren flashes (abstract visual marker instead of animation) -->
                <div class="absolute -top-2 -right-2 flex gap-1.5">
                  <div class="w-2.5 h-2.5 rotate-45 bg-red-500"></div>
                  <div class="w-2.5 h-2.5 rotate-45 bg-blue-500"></div>
                </div>
            </div>
            <div class="text-red-700 dark:text-red-400 font-bold text-sm uppercase tracking-widest whitespace-nowrap mt-2">Interception</div>
        </div>
        
        <div class="w-6 h-6 rounded-full bg-red-600 ring-[6px] ring-white dark:ring-slate-900 z-10 shadow-md relative">
          <!-- Static target crosshair effect -->
          <div class="absolute inset-[-5px] rounded-full border-2 border-red-300 dark:border-red-500/50"></div>
        </div>
        
        <div class="absolute top-12 text-center w-56 flex justify-center">
            <div class="text-red-800 dark:text-red-200 bg-red-50 dark:bg-slate-800 text-xs sm:text-sm font-black uppercase tracking-wider px-4 py-2 rounded-md border-l-[6px] border-red-600 dark:border-red-500 shadow-md">
              Sec 129 Detention
            </div>
        </div>
      </div>

    </div>
  </div>
</div>
