---
---
<div class="w-full bg-white dark:bg-slate-900 rounded-xl p-6 sm:p-10 my-8 border border-slate-200 dark:border-slate-800 shadow-sm font-sans">
  
  <div class="mb-8">
    <h4 class="text-slate-800 dark:text-slate-200 font-bold mb-1 text-sm uppercase tracking-wide">The 16-Hour Extension Window</h4>
    <p class="text-slate-500 dark:text-slate-400 text-xs">You cannot extend an e-way bill whenever you want. The portal only unlocks the extension button exactly 8 hours before expiry, and locks it permanently 8 hours after expiry.</p>
  </div>
  
  <div class="relative w-full py-8 mt-4">
    <!-- Base Axis -->
    <div class="absolute top-1/2 left-0 right-0 h-0.5 bg-slate-200 dark:bg-slate-800 -translate-y-1/2"></div>
    
    <!-- The Active Window Area (Green Highlight) -->
    <div class="absolute top-1/2 left-[25%] w-[50%] h-12 bg-emerald-50 dark:bg-emerald-900/20 -translate-y-1/2 border-y border-emerald-200 dark:border-emerald-800/50"></div>
    <!-- Active Window Line -->
    <div class="absolute top-1/2 left-[25%] w-[50%] h-1 bg-emerald-500 -translate-y-1/2 shadow-[0_0_8px_rgba(16,185,129,0.4)]"></div>

    <!-- Mark 1: Window Opens (-8 Hrs) -->
    <div class="absolute left-[25%] top-1/2 -translate-y-1/2 flex flex-col items-center -translate-x-1/2">
      <!-- Vertical Dash -->
      <div class="h-16 w-px border-l border-dashed border-slate-300 dark:border-slate-600 absolute -top-8"></div>
      <div class="w-3 h-3 rounded-full bg-emerald-500 ring-4 ring-white dark:ring-slate-900 z-10"></div>
      <div class="absolute bottom-6 text-center w-32">
        <div class="text-slate-500 text-xs font-semibold uppercase">8 Hours Before</div>
      </div>
      <div class="absolute top-6 text-center w-32">
        <div class="text-emerald-700 dark:text-emerald-400 text-xs font-bold">Portal Unlocks</div>
      </div>
    </div>

    <!-- Mark 2: Midnight (Expiry) -->
    <div class="absolute left-[50%] top-1/2 -translate-y-1/2 flex flex-col items-center -translate-x-1/2">
      <div class="h-24 w-px bg-gradient-to-b from-transparent via-amber-300 dark:via-amber-700 to-transparent absolute -top-12"></div>
      <div class="w-5 h-5 rounded-full bg-amber-500 ring-4 ring-white dark:ring-slate-900 z-10 flex items-center justify-center">
        <div class="w-1.5 h-1.5 rounded-full bg-white dark:bg-slate-900"></div>
      </div>
      <div class="absolute bottom-8 text-center w-32">
        <div class="text-amber-600 dark:text-amber-400 text-xs font-black tracking-widest bg-white dark:bg-slate-900 px-2 py-0.5 rounded shadow-sm border border-amber-100 dark:border-slate-800">EXPIRY</div>
      </div>
    </div>

    <!-- Mark 3: Window Closes (+8 Hrs) -->
    <div class="absolute left-[75%] top-1/2 -translate-y-1/2 flex flex-col items-center -translate-x-1/2">
      <div class="h-16 w-px border-l border-dashed border-red-300 dark:border-red-800/50 absolute -top-8"></div>
      <div class="w-3 h-3 rounded-full bg-red-500 ring-4 ring-white dark:ring-slate-900 z-10"></div>
      <div class="absolute bottom-6 text-center w-32">
        <div class="text-slate-500 text-xs font-semibold uppercase">8 Hours After</div>
      </div>
      <div class="absolute top-6 text-center w-32">
        <div class="text-red-600 dark:text-red-400 text-xs font-bold">Portal Locks</div>
      </div>
    </div>
    
  </div>
  
  <!-- Clear Labels at the bottom -->
  <div class="mt-8 flex justify-between items-start border-t border-slate-100 dark:border-slate-800/50 pt-4">
    <div class="w-1/4 text-center pr-2">
      <div class="text-slate-400 text-xs uppercase font-bold tracking-wider mb-1">Too Early</div>
      <div class="text-slate-500 text-xs leading-tight">Cannot extend bill yet</div>
    </div>
    <div class="w-2/4 text-center px-4 border-x border-slate-100 dark:border-slate-800/50">
      <div class="text-emerald-600 dark:text-emerald-500 text-xs uppercase font-bold tracking-wider mb-1">The Golden Window</div>
      <div class="text-slate-600 dark:text-slate-300 text-xs leading-tight font-medium">Update Part B and cite reason (e.g., breakdown)</div>
    </div>
    <div class="w-1/4 text-center pl-2">
      <div class="text-red-500 text-xs uppercase font-bold tracking-wider mb-1">Too Late</div>
      <div class="text-slate-500 text-xs leading-tight">Bill is dead, goods stranded</div>
    </div>
  </div>
</div>
