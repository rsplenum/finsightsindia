---
<div class="w-full bg-slate-50 dark:bg-slate-900 rounded-xl p-6 my-6 border border-slate-200 dark:border-slate-800">
  <h4 class="text-slate-800 dark:text-slate-200 font-semibold mb-4 text-sm uppercase tracking-wide">Validity Distance Clocks</h4>
  
  <div class="flex flex-col gap-6">
    <!-- Standard Cargo -->
    <div>
      <div class="flex justify-between items-center mb-2">
        <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Standard Cargo</span>
        <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-100 dark:bg-emerald-900/30 px-2 py-1 rounded">200 km / Day</span>
      </div>
      <div class="flex w-full h-8 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700">
        <div class="flex-1 bg-emerald-500 flex items-center justify-center text-white text-xs font-bold border-r border-emerald-600">Day 1 (0-200km)</div>
        <div class="flex-1 bg-emerald-400 flex items-center justify-center text-white text-xs font-bold border-r border-emerald-500">Day 2 (+200km)</div>
        <div class="flex-1 bg-emerald-300 flex items-center justify-center text-white text-xs font-bold">Day 3 (+200km)</div>
      </div>
    </div>

    <!-- ODC Cargo -->
    <div>
      <div class="flex justify-between items-center mb-2">
        <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Over Dimensional Cargo (ODC)</span>
        <span class="text-xs font-mono text-amber-600 dark:text-amber-400 bg-amber-100 dark:bg-amber-900/30 px-2 py-1 rounded">20 km / Day</span>
      </div>
      <div class="flex w-full h-8 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700">
        <div class="flex-1 bg-amber-500 flex items-center justify-center text-white text-xs font-bold border-r border-amber-600">Day 1 (0-20km)</div>
        <div class="flex-1 bg-amber-400 flex items-center justify-center text-white text-xs font-bold border-r border-amber-500">Day 2 (+20km)</div>
        <div class="flex-1 bg-amber-300 flex items-center justify-center text-white text-xs font-bold border-r border-amber-400">Day 3 (+20km)</div>
        <div class="flex-1 bg-amber-200 flex items-center justify-center text-amber-900 text-xs font-bold">...</div>
      </div>
    </div>
  </div>
</div>
