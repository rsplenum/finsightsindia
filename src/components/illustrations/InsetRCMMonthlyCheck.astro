---
---
<div class="w-full bg-slate-50 dark:bg-slate-900 rounded-2xl p-6 sm:p-10 my-8 border border-slate-200 dark:border-slate-800 shadow-sm relative overflow-hidden">
  
  <h4 class="relative z-10 text-center text-slate-800 dark:text-slate-200 font-black tracking-widest uppercase mb-10 text-sm">Monthly AP Check</h4>
  
  <div class="relative z-10 flex flex-col sm:flex-row items-stretch justify-center gap-6 sm:gap-4">
    
    <!-- Connecting Line (Desktop) -->
    <div class="hidden sm:block absolute top-1/2 left-[15%] right-[15%] h-0.5 bg-slate-200 dark:bg-slate-700 -translate-y-1/2 z-0"></div>
    
    <!-- Step 1 -->
    <div class="relative z-10 flex-1 flex flex-col items-center">
      <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center shadow-md mb-4 ring-4 ring-slate-50 dark:ring-slate-900">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
        </svg>
      </div>
      <div class="bg-white dark:bg-slate-800 p-5 rounded-xl text-center w-full max-w-[220px] border border-slate-200 dark:border-slate-700 shadow-sm h-full">
        <div class="text-sm font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wide">Foreign Spends</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">Extract card & bank outflow lists</div>
      </div>
    </div>
    
    <!-- Step 2 -->
    <div class="relative z-10 flex-1 flex flex-col items-center">
      <div class="w-10 h-10 bg-indigo-600 rounded-full flex items-center justify-center shadow-md mb-4 ring-4 ring-slate-50 dark:ring-slate-900">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <div class="bg-white dark:bg-slate-800 p-5 rounded-xl text-center w-full max-w-[220px] border border-slate-200 dark:border-slate-700 shadow-sm h-full">
        <div class="text-sm font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wide">Invoice Check</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">Is Indian GST charged on it?</div>
      </div>
    </div>
    
    <!-- Step 3 -->
    <div class="relative z-10 flex-1 flex flex-col items-center">
      <div class="w-10 h-10 bg-emerald-600 rounded-full flex items-center justify-center shadow-md mb-4 ring-4 ring-slate-50 dark:ring-slate-900">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
        </svg>
      </div>
      <div class="bg-white dark:bg-slate-800 p-5 rounded-xl text-center w-full max-w-[220px] border border-slate-200 dark:border-slate-700 shadow-sm h-full">
        <div class="text-sm font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wide">GST Return Line</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">Report RCM in 3B & claim ITC</div>
      </div>
    </div>

  </div>
</div>
