---
// Inset43BDivergence.astro
---
<div class="my-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
  <!-- Left Side: Standard 43B -->
  <div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 p-6 rounded-2xl flex flex-col h-full">
    <div class="flex items-center gap-2 mb-4">
      <div class="w-8 h-8 rounded-full bg-navy-200 dark:bg-navy-800 flex items-center justify-center">
        <svg class="w-4 h-4 text-navy-600 dark:text-navy-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <h4 class="font-bold text-navy-900 dark:text-white">Other 43B Items</h4>
    </div>
    <p class="text-sm text-navy-600 dark:text-navy-400 mb-6 flex-grow">Bonus, commission, bank interest, leave encashment.</p>
    
    <div class="bg-white dark:bg-navy-950 p-4 rounded-xl border border-navy-200 dark:border-navy-700">
      <div class="text-xs font-bold text-navy-500 uppercase tracking-widest mb-2">Grace Period Ends</div>
      <div class="flex items-center justify-between">
        <div class="font-bold text-navy-900 dark:text-white">ITR Due Date</div>
        <div class="bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30 text-xs px-2 py-1 rounded-md font-bold">Allowed</div>
      </div>
    </div>
  </div>

  <!-- Right Side: 43B(h) -->
  <div class="bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 p-6 rounded-2xl flex flex-col h-full">
    <div class="flex items-center gap-2 mb-4">
      <div class="w-8 h-8 rounded-full bg-rose-200 dark:bg-rose-900/50 flex items-center justify-center">
        <svg class="w-4 h-4 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <h4 class="font-bold text-rose-900 dark:text-rose-100">Section 43B(h)</h4>
    </div>
    <p class="text-sm text-rose-700 dark:text-rose-300 mb-6 flex-grow">Micro/Small MSME dues (Manufacturers & Service Providers).</p>
    
    <div class="bg-white dark:bg-navy-950 p-4 rounded-xl border border-rose-200 dark:border-rose-900/50 relative overflow-hidden">
      <div class="absolute right-0 top-0 bottom-0 w-1 bg-rose-500"></div>
      <div class="text-xs font-bold text-rose-500 dark:text-rose-400 uppercase tracking-widest mb-2">Hard Stop Limits</div>
      <div class="flex items-center justify-between">
        <div class="font-bold text-navy-900 dark:text-white">15 or 45 Days</div>
        <div class="bg-rose-100 dark:bg-rose-500/20 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-500/30 text-xs px-2 py-1 rounded-md font-bold">Disallowed</div>
      </div>
    </div>
  </div>
</div>
