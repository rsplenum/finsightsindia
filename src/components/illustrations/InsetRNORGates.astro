---

<div class="my-8 rounded-xl border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 overflow-hidden shadow-sm">
  <div class="bg-navy-50 dark:bg-navy-900/50 px-4 py-3 border-b border-navy-200 dark:border-navy-800 flex items-center gap-2">
    <svg class="w-5 h-5 text-navy-500 dark:text-navy-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
    <h4 class="text-sm font-bold text-navy-900 dark:text-navy-100 m-0">The Dual-Gate RNOR Architecture</h4>
  </div>
  
  <div class="p-4 sm:p-6 grid grid-cols-1 md:grid-cols-2 gap-6 relative">
    
    <!-- Central Divider (Desktop only) -->
    <div class="hidden md:block absolute left-1/2 top-6 bottom-6 w-px bg-navy-200 dark:bg-navy-800/50 -translate-x-1/2"></div>
    
    <!-- Gate A -->
    <div class="relative">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/50 flex items-center justify-center border border-emerald-200 dark:border-emerald-800">
          <span class="font-bold text-emerald-700 dark:text-emerald-400">A</span>
        </div>
        <div>
          <h5 class="text-sm font-bold text-navy-900 dark:text-navy-100 m-0">The Automatic Shield</h5>
          <div class="text-xs font-semibold text-emerald-600 dark:text-emerald-500">Section 6(6)(c) & (d)</div>
        </div>
      </div>
      
      <div class="bg-navy-50/50 dark:bg-navy-900/30 rounded-lg p-4 border border-navy-100 dark:border-navy-800">
        <div class="mb-3">
          <div class="text-xs text-navy-500 dark:text-navy-400 uppercase font-semibold tracking-wider mb-1">Trigger Condition</div>
          <div class="text-sm font-medium text-navy-800 dark:text-navy-200">120 to 181 Days in India</div>
          <div class="text-xs text-navy-600 dark:text-navy-400">+ >₹15L Indian Income</div>
        </div>
        
        <div class="pt-3 border-t border-navy-200/50 dark:border-navy-800/50">
          <div class="text-xs text-navy-500 dark:text-navy-400 uppercase font-semibold tracking-wider mb-1">Result</div>
          <div class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-sm font-bold text-navy-900 dark:text-navy-100">Automatic RNOR Status</span>
          </div>
          <p class="text-xs text-navy-600 dark:text-navy-400 mt-1 pl-6">Statutory fiat grants protection. Global income remains tax-free.</p>
        </div>
      </div>
    </div>

    <!-- Gate B -->
    <div class="relative">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-lg bg-gold-100 dark:bg-gold-900/30 flex items-center justify-center border border-gold-200 dark:border-gold-800">
          <span class="font-bold text-gold-700 dark:text-gold-400">B</span>
        </div>
        <div>
          <h5 class="text-sm font-bold text-navy-900 dark:text-navy-100 m-0">The General Shield</h5>
          <div class="text-xs font-semibold text-gold-600 dark:text-gold-500">Section 6(6)(a) & (b)</div>
        </div>
      </div>
      
      <div class="bg-navy-50/50 dark:bg-navy-900/30 rounded-lg p-4 border border-navy-100 dark:border-navy-800">
        <div class="mb-3">
          <div class="text-xs text-navy-500 dark:text-navy-400 uppercase font-semibold tracking-wider mb-1">Trigger Condition</div>
          <div class="text-sm font-medium text-navy-800 dark:text-navy-200">182+ Days in India</div>
          <div class="text-xs text-navy-600 dark:text-navy-400">Gate A switches off. Fallback to Gate B.</div>
        </div>
        
        <div class="pt-3 border-t border-navy-200/50 dark:border-navy-800/50">
          <div class="text-xs text-navy-500 dark:text-navy-400 uppercase font-semibold tracking-wider mb-2">Historical Test (Pass Either)</div>
          
          <div class="space-y-2">
            <div class="flex items-start gap-2 bg-white dark:bg-navy-900 p-2 rounded border border-navy-200 dark:border-navy-700 shadow-sm">
              <svg class="w-4 h-4 mt-0.5 text-gold-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              <div class="text-xs font-medium text-navy-800 dark:text-navy-200 leading-tight">Non-Resident in 9 of the preceding 10 years</div>
            </div>
            
            <div class="flex items-center justify-center">
              <span class="text-xs font-bold text-navy-400 dark:text-navy-500 uppercase">OR</span>
            </div>
            
            <div class="flex items-start gap-2 bg-white dark:bg-navy-900 p-2 rounded border border-navy-200 dark:border-navy-700 shadow-sm">
              <svg class="w-4 h-4 mt-0.5 text-gold-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <div class="text-xs font-medium text-navy-800 dark:text-navy-200 leading-tight">≤ 729 days in India across preceding 7 years</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
