<div class="w-full bg-slate-50 dark:bg-slate-900 rounded-2xl p-6 sm:p-10 my-8 border border-slate-200 dark:border-slate-800 shadow-sm">
  
  <h4 class="text-center text-slate-800 dark:text-slate-200 font-black tracking-widest uppercase mb-8 text-sm">This Month (On Time)</h4>
  
  <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8">
    
    <!-- Cash Out -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border-t-4 border-red-500 shadow-sm w-full sm:w-48 text-center border-x border-b border-slate-200 dark:border-slate-700">
      <div class="text-red-600 dark:text-red-400 font-bold text-lg">₹ 1,80,000 Out</div>
      <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-2">Paid in Cash Ledger</div>
    </div>
    
    <!-- Plus Sign -->
    <div class="text-slate-400 dark:text-slate-500 text-2xl font-black">+</div>
    
    <!-- Credit In -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-xl border-t-4 border-emerald-500 shadow-sm w-full sm:w-48 text-center border-x border-b border-slate-200 dark:border-slate-700">
      <div class="text-emerald-600 dark:text-emerald-400 font-bold text-lg">₹ 1,80,000 In</div>
      <div class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-2">Claimed as ITC Credit</div>
    </div>
    
    <!-- Equals Sign -->
    <div class="text-slate-400 dark:text-slate-500 text-2xl font-black">=</div>
    
    <!-- Net Zero -->
    <div class="bg-blue-50 dark:bg-slate-800 p-6 rounded-xl border-t-4 border-blue-500 shadow-md w-full sm:w-48 text-center border-x border-b border-blue-100 dark:border-slate-700 relative overflow-hidden">
      <!-- Subtle highlight -->
      <div class="absolute inset-0 bg-blue-400 opacity-10"></div>
      <div class="relative z-10 text-blue-700 dark:text-blue-400 font-black text-xl">Net Zero</div>
      <div class="relative z-10 text-sm text-slate-500 dark:text-slate-400 uppercase tracking-wider mt-2">Cash Impact</div>
    </div>

  </div>
</div>
