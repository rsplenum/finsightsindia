---
// Ill10NinetyDays.astro
---
<div class="my-12 bg-navy-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl max-w-3xl mx-auto not-prose">
  <div class="px-6 py-5 border-b border-slate-800 bg-slate-900/50 text-center">
    <div class="text-[10px] uppercase tracking-widest text-indigo-400 font-semibold mb-1">The Aster File &mdash; Illustration 10</div>
    <h3 class="text-lg text-white font-medium m-0">Ninety Days to Distress</h3>
    <p class="text-xs text-slate-400 mt-2">When the market moves faster than the formula.</p>
  </div>

  <div class="p-8 relative">
    
    <!-- Timeline Line -->
    <div class="absolute top-[80px] left-[10%] right-[10%] h-[2px] bg-slate-700"></div>

    <div class="flex justify-between relative z-10 w-full px-4">
      
      <!-- Point 1 (JAN) -->
      <div class="flex flex-col items-center w-1/3">
        <div class="text-xl font-mono font-bold text-slate-200 mb-2">₹100</div>
        
        <div class="w-4 h-4 rounded-full bg-slate-800 border-2 border-slate-500 mb-6"></div>
        
        <div class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3 bg-slate-800/80 px-3 py-1 rounded">JAN</div>
        <div class="text-center text-sm text-slate-300">
          <p class="mb-1">12 months runway</p>
          <p class="text-xs text-slate-500">Major customer intact</p>
        </div>
      </div>
      
      <!-- Point 2 (JUN) -->
      <div class="flex flex-col items-center w-1/3">
        <div class="text-xl font-mono font-bold text-amber-300 mb-2">₹70</div>
        
        <div class="w-4 h-4 rounded-full bg-slate-800 border-2 border-amber-500 mb-6"></div>
        
        <div class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-3 bg-amber-950/30 border border-amber-900/50 px-3 py-1 rounded">JUN</div>
        <div class="text-center text-sm text-slate-300">
          <p class="mb-1 text-amber-200/80">Customer lost</p>
          <p class="text-xs text-slate-500">5 months runway</p>
        </div>
      </div>
      
      <!-- Point 3 (SEP) -->
      <div class="flex flex-col items-center w-1/3 relative">
        <div class="text-xl font-mono font-bold text-rose-400 mb-2">₹40</div>
        
        <div class="w-4 h-4 rounded-full bg-slate-800 border-2 border-rose-500 mb-6 shadow-[0_0_10px_rgba(244,63,94,0.5)]"></div>
        
        <div class="text-xs font-bold uppercase tracking-widest text-rose-400 mb-3 bg-rose-950/30 border border-rose-900/50 px-3 py-1 rounded">SEP</div>
        <div class="text-center text-sm text-slate-300">
          <p class="mb-1 text-rose-300">Funding fails</p>
          <p class="text-xs text-slate-500">2 months runway</p>
        </div>
        
        <!-- Distress Event -->
        <div class="mt-6 flex flex-col items-center">
          <div class="h-6 w-[2px] bg-gradient-to-b from-rose-900/50 to-rose-500 relative">
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b-2 border-r-2 border-rose-500 transform rotate-45 mb-[-4px]"></div>
          </div>
          <div class="bg-rose-950/60 border border-rose-600/40 rounded px-4 py-2 mt-2 shadow-[0_0_15px_rgba(244,63,94,0.15)] text-center w-40">
            <div class="text-[10px] uppercase tracking-widest font-semibold text-rose-300 leading-tight">Real buyer appears at ₹40</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
