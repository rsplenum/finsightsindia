---
// Ill5ThreeValueTriangle.astro
---
<div class="my-12 bg-navy-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl max-w-2xl mx-auto not-prose">
  <div class="px-6 py-5 border-b border-slate-800 bg-slate-900/50 text-center">
    <div class="text-[10px] uppercase tracking-widest text-indigo-400 font-semibold mb-1">Illustration 5</div>
    <h3 class="text-lg text-white font-medium m-0">The Three-Value Triangle</h3>
    <p class="text-xs text-slate-400 mt-2">Nothing requires those three points to coincide.</p>
  </div>

  <div class="p-8 relative flex flex-col items-center justify-center min-h-[300px]">
    
    <!-- Top Node (Economic Value) -->
    <div class="absolute top-8 left-1/2 -translate-x-1/2 flex flex-col items-center z-10">
      <div class="bg-indigo-950/40 border border-indigo-500/30 rounded-lg px-4 py-2 text-center backdrop-blur-sm shadow-lg">
        <div class="text-[10px] uppercase tracking-wider text-slate-400 mb-1">Economic Value</div>
        <div class="text-xl font-mono text-indigo-300 font-semibold">₹180</div>
      </div>
    </div>

    <!-- Bottom Left Node (Transaction Price) -->
    <div class="absolute bottom-8 left-12 flex flex-col items-center z-10">
      <div class="bg-emerald-950/40 border border-emerald-500/30 rounded-lg px-4 py-2 text-center backdrop-blur-sm shadow-lg">
        <div class="text-[10px] uppercase tracking-wider text-slate-400 mb-1">Transaction Price</div>
        <div class="text-xl font-mono text-emerald-300 font-semibold">₹70</div>
      </div>
    </div>

    <!-- Bottom Right Node (Statutory FMV) -->
    <div class="absolute bottom-8 right-12 flex flex-col items-center z-10">
      <div class="bg-rose-950/40 border border-rose-500/30 rounded-lg px-4 py-2 text-center backdrop-blur-sm shadow-lg">
        <div class="text-[10px] uppercase tracking-wider text-slate-400 mb-1">Statutory FMV</div>
        <div class="text-xl font-mono text-rose-300 font-semibold">₹240</div>
      </div>
    </div>

    <!-- Connecting SVG Lines -->
    <svg class="absolute inset-0 w-full h-full pointer-events-none z-0">
      <defs>
        <marker id="arrowhead" markerWidth="6" markerHeight="4" refX="5" refY="2" orient="auto">
          <polygon points="0 0, 6 2, 0 4" fill="#475569" />
        </marker>
        <marker id="arrowhead-reverse" markerWidth="6" markerHeight="4" refX="1" refY="2" orient="auto-start-reverse">
          <polygon points="0 0, 6 2, 0 4" fill="#475569" />
        </marker>
      </defs>
      
      <!-- Left Edge -->
      <line x1="50%" y1="90" x2="25%" y2="200" stroke="#475569" stroke-width="2" stroke-dasharray="4,4" marker-start="url(#arrowhead-reverse)" marker-end="url(#arrowhead)"/>
      
      <!-- Right Edge -->
      <line x1="50%" y1="90" x2="75%" y2="200" stroke="#475569" stroke-width="2" stroke-dasharray="4,4" marker-start="url(#arrowhead-reverse)" marker-end="url(#arrowhead)"/>
      
      <!-- Bottom Edge -->
      <line x1="35%" y1="230" x2="65%" y2="230" stroke="#475569" stroke-width="2" stroke-dasharray="4,4" />
    </svg>

  </div>
</div>
