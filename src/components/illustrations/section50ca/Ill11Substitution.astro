---
// Ill11Substitution.astro
---
<div class="my-12 bg-slate-50 dark:bg-navy-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-xl max-w-2xl mx-auto not-prose font-sans w-full">
  <div class="px-6 py-5 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 text-center">
    <div class="text-xs uppercase tracking-widest text-indigo-600 dark:text-indigo-400 font-semibold mb-1">Illustration 11</div>
    <h3 class="text-lg text-slate-900 dark:text-white font-medium m-0">FMV Substitution Does Not Always Create a Gain</h3>
    <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">The rule reduces the loss. It does not magically create a gain.</p>
  </div>

  <div class="p-8 flex flex-col md:flex-row gap-8">
    
    <!-- Actual Economics -->
    <div class="flex-1 border border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-800/30 rounded-lg p-6 flex flex-col items-center shadow-inner relative">
      <div class="text-xs text-slate-600 dark:text-slate-400 uppercase tracking-widest mb-6 font-semibold bg-slate-50 dark:bg-slate-900/80 px-4 py-1 border border-slate-300 dark:border-slate-700 rounded-full">Actual Economics</div>
      
      <div class="w-full space-y-4">
        <!-- Consideration -->
        <div class="flex justify-between items-center bg-slate-200 dark:bg-slate-800/80 border border-slate-600 rounded px-4 py-2">
          <span class="text-xs text-slate-600 dark:text-slate-400">Sale Price</span>
          <span class="font-mono text-emerald-600 dark:text-emerald-400 font-semibold">₹50 lakh</span>
        </div>
        
        <!-- Minus -->
        <div class="w-full flex justify-center text-slate-500 font-bold text-lg">-</div>
        
        <!-- Cost -->
        <div class="flex justify-between items-center bg-slate-200 dark:bg-slate-800/80 border border-slate-600 rounded px-4 py-2">
          <span class="text-xs text-slate-600 dark:text-slate-400">Cost</span>
          <span class="font-mono text-slate-700 dark:text-slate-300 font-semibold">₹1.2 crore</span>
        </div>
        
        <!-- Equals -->
        <div class="w-full flex justify-center">
          <div class="h-[1px] bg-slate-600 w-3/4"></div>
        </div>
        <div class="w-full flex justify-center text-slate-500 font-bold text-lg -mt-2">=</div>
        
        <!-- Result -->
        <div class="bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/50 rounded p-4 text-center">
          <div class="text-xl font-mono text-rose-600 dark:text-rose-400 font-bold">₹70 lakh loss</div>
        </div>
      </div>
    </div>

    <!-- Tax Computation -->
    <div class="flex-1 border border-indigo-200 dark:border-indigo-900/50 bg-indigo-50 dark:bg-indigo-950/10 rounded-lg p-6 flex flex-col items-center relative shadow-[inset_0_0_20px_rgba(99,102,241,0.05)]">
      <div class="text-xs text-indigo-600 dark:text-indigo-400/80 uppercase tracking-widest mb-6 font-semibold bg-indigo-50 dark:bg-indigo-950/80 px-4 py-1 border border-indigo-200 dark:border-indigo-800/50 rounded-full text-center">Tax Computation<br><span class="text-xs text-slate-600 dark:text-slate-400 font-normal">After FMV Substitution</span></div>
      
      <div class="w-full space-y-4">
        <!-- Consideration -->
        <div class="flex justify-between items-center bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-300 dark:border-indigo-700/50 rounded px-4 py-2 shadow-sm">
          <span class="text-xs text-indigo-700 dark:text-indigo-300">FMV</span>
          <span class="font-mono text-indigo-600 dark:text-indigo-400 font-semibold">₹1 crore</span>
        </div>
        
        <!-- Minus -->
        <div class="w-full flex justify-center text-slate-500 font-bold text-lg">-</div>
        
        <!-- Cost -->
        <div class="flex justify-between items-center bg-slate-200 dark:bg-slate-800/80 border border-slate-600 rounded px-4 py-2 opacity-80">
          <span class="text-xs text-slate-600 dark:text-slate-400">Cost</span>
          <span class="font-mono text-slate-700 dark:text-slate-300 font-semibold">₹1.2 crore</span>
        </div>
        
        <!-- Equals -->
        <div class="w-full flex justify-center">
          <div class="h-[1px] bg-slate-600 w-3/4"></div>
        </div>
        <div class="w-full flex justify-center text-slate-500 font-bold text-lg -mt-2">=</div>
        
        <!-- Result -->
        <div class="bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/50 rounded p-4 text-center">
          <div class="text-xl font-mono text-rose-600 dark:text-rose-400 font-bold">₹20 lakh loss</div>
        </div>
      </div>
    </div>

  </div>
</div>
