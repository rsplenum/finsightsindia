---
// Ill12LiquidityParadox.astro
---
<div class="my-12 bg-navy-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl max-w-2xl mx-auto not-prose">
  <div class="px-6 py-5 border-b border-slate-800 bg-slate-900/50 text-center">
    <div class="text-[10px] uppercase tracking-widest text-indigo-400 font-semibold mb-1">Illustration 12</div>
    <h3 class="text-lg text-white font-medium m-0">The Liquidity Paradox</h3>
    <p class="text-xs text-slate-400 mt-2">The taxpayer can lack the cash corresponding to the taxable number.</p>
  </div>

  <div class="p-8 flex flex-col md:flex-row gap-8 items-stretch justify-center">
    
    <!-- Founder View -->
    <div class="flex-1 flex flex-col items-center">
      <div class="bg-slate-800 border border-slate-700 rounded-full px-6 py-2 mb-6 shadow w-3/4 text-center">
        <span class="text-sm font-semibold text-slate-200 tracking-widest uppercase">Founder</span>
      </div>

      <div class="bg-slate-800/50 border border-slate-600 rounded px-6 py-4 text-center w-full shadow-inner flex flex-col items-center flex-grow justify-between">
        <div class="w-full text-center mb-4">
          <div class="text-xs text-slate-400 uppercase tracking-widest mb-1">Cash received</div>
          <div class="text-xl font-mono text-emerald-400 font-bold">₹5 lakh</div>
        </div>
        
        <div class="h-10 w-[2px] bg-slate-600 relative my-2">
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b-2 border-r-2 border-slate-500 transform rotate-45 mb-[-4px]"></div>
        </div>

        <div class="w-full text-center mt-4 bg-rose-950/20 border border-rose-900/50 p-3 rounded">
          <div class="text-[10px] text-rose-400/80 uppercase tracking-widest mb-1">Economic Loss</div>
          <div class="text-xl font-mono text-rose-400 font-bold">₹45 lakh</div>
        </div>
      </div>
    </div>

    <!-- Tax Model View -->
    <div class="flex-1 flex flex-col items-center relative">
      <div class="bg-indigo-950/80 border border-indigo-700/50 rounded-full px-6 py-2 mb-6 shadow w-3/4 text-center z-10">
        <span class="text-sm font-semibold text-indigo-300 tracking-widest uppercase">Tax Model</span>
      </div>

      <div class="bg-indigo-950/20 border border-indigo-900/50 rounded px-6 py-4 text-center w-full shadow-[inset_0_0_15px_rgba(99,102,241,0.05)] flex flex-col items-center flex-grow justify-between relative overflow-hidden">
        <!-- Glow -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl"></div>

        <div class="w-full text-center mb-4 relative z-10">
          <div class="text-xs text-indigo-300/80 uppercase tracking-widest mb-1">Deemed consideration</div>
          <div class="text-xl font-mono text-indigo-400 font-bold">₹2 crore</div>
        </div>
        
        <div class="h-10 w-[2px] bg-gradient-to-b from-indigo-800/50 to-rose-700/50 relative my-2 z-10">
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b-2 border-r-2 border-rose-600 transform rotate-45 mb-[-4px]"></div>
        </div>

        <div class="w-full text-center mt-4 bg-indigo-950/50 border border-indigo-700/50 p-3 rounded relative z-10 shadow-[0_0_10px_rgba(99,102,241,0.2)]">
          <div class="text-[10px] text-indigo-300 uppercase tracking-widest mb-1">Illustrative Capital Gain</div>
          <div class="text-2xl font-mono text-white font-bold tracking-tight">₹1.5 crore</div>
        </div>
      </div>
    </div>

  </div>
</div>
