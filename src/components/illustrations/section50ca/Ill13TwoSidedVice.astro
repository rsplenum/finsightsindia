---
// Ill13TwoSidedVice.astro
---
<div class="my-12 bg-navy-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl max-w-2xl mx-auto not-prose">
  <div class="px-6 py-5 border-b border-slate-800 bg-slate-900/50 text-center">
    <div class="text-[10px] uppercase tracking-widest text-indigo-400 font-semibold mb-1">Illustration 13</div>
    <h3 class="text-lg text-white font-medium m-0">The Two-Sided Valuation Vice</h3>
    <p class="text-xs text-slate-400 mt-2">The architecture examines both sides of the same value transfer.</p>
  </div>

  <div class="p-8 flex flex-col items-center">
    
    <!-- Top block -->
    <div class="text-center mb-8 relative">
      <div class="text-sm font-semibold text-slate-200 tracking-widest uppercase bg-slate-800 px-6 py-2 rounded border border-slate-700 inline-block z-10 relative">100,000 Shares</div>
      
      <div class="w-[2px] h-6 bg-slate-600 mx-auto my-2"></div>
      
      <div class="text-xs text-emerald-400/80 uppercase tracking-widest bg-emerald-950/30 border border-emerald-900/50 px-4 py-1 rounded inline-block z-10 relative mb-2">Actual price <span class="font-mono text-emerald-400 ml-1 font-bold">₹10</span></div>
      
      <div class="w-[2px] h-6 bg-slate-600 mx-auto my-2"></div>
      
      <div class="text-xs text-indigo-300/80 uppercase tracking-widest bg-indigo-950/30 border border-indigo-900/50 px-4 py-1 rounded inline-block z-10 relative">FMV <span class="font-mono text-indigo-400 ml-1 font-bold">₹100/share</span></div>
    </div>

    <!-- Tree Split -->
    <div class="relative w-full max-w-md">
      <!-- Lines -->
      <div class="absolute top-[-24px] left-1/2 w-[1px] h-6 bg-slate-600 -translate-x-1/2"></div>
      <div class="absolute top-0 left-[20%] w-[60%] h-[1px] bg-slate-600"></div>
      
      <!-- Seller Branch -->
      <div class="absolute top-0 left-[20%] w-[1px] h-8 bg-slate-600">
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b-2 border-r-2 border-slate-500 transform rotate-45 mb-[-4px]"></div>
      </div>
      
      <!-- Buyer Branch -->
      <div class="absolute top-0 right-[20%] w-[1px] h-8 bg-slate-600">
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b-2 border-r-2 border-slate-500 transform rotate-45 mb-[-4px]"></div>
      </div>

      <div class="flex justify-between w-full pt-10 relative z-10">
        
        <!-- SELLER -->
        <div class="flex flex-col items-center w-[45%] text-center">
          <div class="bg-slate-800 border border-slate-700 rounded-full px-5 py-1 mb-4 shadow w-3/4">
            <span class="text-xs font-semibold text-slate-200 tracking-widest uppercase">Seller</span>
          </div>
          
          <div class="h-16 flex items-center justify-center border-l-2 border-indigo-900/50 pl-3 mb-6">
            <p class="text-xs text-slate-300 leading-relaxed text-left">FMV may replace sale consideration</p>
          </div>
          
          <div class="h-6 w-[2px] bg-indigo-900/50 relative mb-2">
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b border-r border-indigo-500 transform rotate-45 mb-[-2px]"></div>
          </div>
          
          <div class="bg-indigo-950/30 border border-indigo-800/50 rounded px-3 py-3 w-full text-center shadow-[inset_0_0_10px_rgba(99,102,241,0.05)]">
            <div class="text-[10px] uppercase font-bold text-indigo-300 leading-tight">Capital-Gains<br>Question</div>
          </div>
        </div>
        
        <!-- BUYER -->
        <div class="flex flex-col items-center w-[45%] text-center">
          <div class="bg-slate-800 border border-slate-700 rounded-full px-5 py-1 mb-4 shadow w-3/4">
            <span class="text-xs font-semibold text-slate-200 tracking-widest uppercase">Buyer</span>
          </div>
          
          <div class="h-16 flex items-center justify-center border-l-2 border-rose-900/50 pl-3 mb-6">
            <p class="text-xs text-slate-300 leading-relaxed text-left">Shares received below FMV</p>
          </div>
          
          <div class="h-6 w-[2px] bg-rose-900/50 relative mb-2">
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b border-r border-rose-500 transform rotate-45 mb-[-2px]"></div>
          </div>
          
          <div class="bg-rose-950/30 border border-rose-800/50 rounded px-3 py-3 w-full text-center shadow-[inset_0_0_10px_rgba(244,63,94,0.05)]">
            <div class="text-[10px] uppercase font-bold text-rose-300 leading-tight">Inadequate-<br>Consideration<br>Question</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
