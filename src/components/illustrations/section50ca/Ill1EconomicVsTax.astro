---
// Ill1EconomicVsTax.astro
// Visual brief: A ₹10 Lakh Economic Loss Meets a ₹1 Crore Tax Value
// Shows a comparison table and a split flowchart.
---

<div class="my-12 bg-navy-900 border border-slate-800 rounded-xl overflow-hidden shadow-2xl not-prose">
  
  <div class="px-6 py-5 border-b border-slate-800 bg-slate-900/50">
    <div class="text-[10px] uppercase tracking-widest text-emerald-400 font-semibold mb-1">Illustration 1</div>
    <h3 class="text-lg text-white font-medium m-0">A ₹10 Lakh Economic Loss Meets a ₹1 Crore Tax Value</h3>
  </div>

  <div class="p-6">
    <!-- Comparison Table -->
    <div class="overflow-x-auto mb-10">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-slate-700">
            <th class="py-3 font-medium text-slate-400 w-1/3"></th>
            <th class="py-3 font-medium text-slate-300 text-right w-1/3 pr-4">Arjun's economic world</th>
            <th class="py-3 font-medium text-slate-300 text-right w-1/3">Tax computation</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/50">
          <tr>
            <td class="py-3 text-slate-400">Shares</td>
            <td class="py-3 text-slate-200 text-right pr-4 font-mono">100,000</td>
            <td class="py-3 text-slate-200 text-right font-mono">100,000</td>
          </tr>
          <tr>
            <td class="py-3 text-slate-400">Original cost/share</td>
            <td class="py-3 text-slate-200 text-right pr-4 font-mono">₹20</td>
            <td class="py-3 text-slate-200 text-right font-mono">₹20</td>
          </tr>
          <tr>
            <td class="py-3 text-slate-400">Actual sale price/share</td>
            <td class="py-3 text-slate-200 text-right pr-4 font-mono">₹10</td>
            <td class="py-3 text-slate-500 text-right font-mono">—</td>
          </tr>
          <tr>
            <td class="py-3 text-slate-400">Prescribed FMV/share</td>
            <td class="py-3 text-slate-500 text-right pr-4 font-mono">—</td>
            <td class="py-3 text-slate-200 text-right font-mono">₹100</td>
          </tr>
          <tr class="bg-slate-800/20">
            <td class="py-3 text-slate-300 font-medium">Cash actually received</td>
            <td class="py-3 text-emerald-400 text-right pr-4 font-mono font-bold">₹10 lakh</td>
            <td class="py-3 text-slate-500 text-right font-mono">—</td>
          </tr>
          <tr class="bg-slate-800/20">
            <td class="py-3 text-slate-300 font-medium">Deemed consideration</td>
            <td class="py-3 text-slate-500 text-right pr-4 font-mono">—</td>
            <td class="py-3 text-indigo-400 text-right font-mono font-bold">₹1 crore</td>
          </tr>
          <tr>
            <td class="py-3 text-slate-400">Cost</td>
            <td class="py-3 text-slate-200 text-right pr-4 font-mono">₹20 lakh</td>
            <td class="py-3 text-slate-200 text-right font-mono">₹20 lakh</td>
          </tr>
          <tr class="bg-slate-900">
            <td class="py-4 text-slate-200 font-semibold border-t border-slate-700">Result</td>
            <td class="py-4 text-rose-400 text-right pr-4 font-mono font-bold border-t border-slate-700">₹10 lakh loss</td>
            <td class="py-4 text-indigo-400 text-right font-mono font-bold border-t border-slate-700">₹80 lakh capital gain</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Split Flowchart -->
    <div class="relative pt-8 pb-4 border-t border-slate-800/80">
      
      <!-- Top Node -->
      <div class="flex justify-center mb-8">
        <div class="bg-slate-800 px-4 py-2 rounded-full border border-slate-700 text-xs font-medium text-slate-300 uppercase tracking-widest relative z-10">
          One Share Transfer
        </div>
      </div>
      
      <!-- Connecting Lines -->
      <div class="absolute top-[52px] left-1/2 w-[50%] h-[40px] -translate-x-1/2 border-t border-l border-r border-slate-700 rounded-t-xl z-0"></div>
      <div class="absolute top-[92px] left-1/4 w-[1px] h-4 bg-slate-700"></div>
      <div class="absolute top-[92px] left-3/4 w-[1px] h-4 bg-slate-700"></div>

      <!-- Split Paths -->
      <div class="flex w-full">
        <!-- Left Path (Economic) -->
        <div class="w-1/2 flex flex-col items-center pr-4">
          <div class="text-xs text-slate-400 uppercase tracking-wider mb-6 font-medium">Economic Reality</div>
          
          <div class="bg-slate-800/50 px-4 py-3 rounded border border-slate-700 w-full text-center mb-4 relative">
            <div class="text-sm font-mono text-emerald-400">₹10/share</div>
            <div class="absolute -bottom-5 left-1/2 w-[1px] h-4 bg-slate-700"></div>
            <div class="absolute -bottom-3 left-1/2 w-2 h-2 border-b border-r border-slate-500 transform rotate-45 -translate-x-1/2"></div>
          </div>
          
          <div class="bg-slate-800/50 px-4 py-3 rounded border border-slate-700 w-full text-center mb-6 relative">
            <div class="text-xs text-slate-400 mb-1">Received</div>
            <div class="text-sm font-mono text-emerald-400 font-bold">₹10 lakh</div>
            <div class="absolute -bottom-7 left-1/2 w-[1px] h-6 bg-slate-700"></div>
            <div class="absolute -bottom-3 left-1/2 w-2 h-2 border-b border-r border-slate-500 transform rotate-45 -translate-x-1/2"></div>
          </div>

          <div class="bg-rose-950/30 px-4 py-3 rounded border border-rose-900/50 w-full text-center">
            <div class="text-lg font-mono text-rose-400 font-bold">₹10 lakh LOSS</div>
          </div>
        </div>
        
        <!-- Right Path (Tax) -->
        <div class="w-1/2 flex flex-col items-center pl-4">
          <div class="text-xs text-slate-400 uppercase tracking-wider mb-6 font-medium">Tax Reality</div>
          
          <div class="bg-indigo-950/20 px-4 py-3 rounded border border-indigo-900/40 w-full text-center mb-4 relative">
            <div class="text-sm font-mono text-indigo-400">₹100/share</div>
            <div class="absolute -bottom-5 left-1/2 w-[1px] h-4 bg-slate-700"></div>
            <div class="absolute -bottom-3 left-1/2 w-2 h-2 border-b border-r border-slate-500 transform rotate-45 -translate-x-1/2"></div>
          </div>
          
          <div class="bg-indigo-950/20 px-4 py-3 rounded border border-indigo-900/40 w-full text-center mb-6 relative">
            <div class="text-xs text-slate-400 mb-1">Deemed Consideration</div>
            <div class="text-sm font-mono text-indigo-400 font-bold">₹1 crore</div>
            <div class="absolute -bottom-7 left-1/2 w-[1px] h-6 bg-slate-700"></div>
            <div class="absolute -bottom-3 left-1/2 w-2 h-2 border-b border-r border-slate-500 transform rotate-45 -translate-x-1/2"></div>
          </div>

          <div class="bg-indigo-950/40 px-4 py-3 rounded border border-indigo-800/50 w-full text-center">
            <div class="text-lg font-mono text-indigo-400 font-bold">₹80 lakh GAIN</div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</div>
