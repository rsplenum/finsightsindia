---
// Ill3FivePrices.astro
// Visual brief: Illustration 3 — The Company With Five Prices
// A timeline or table displaying the various valuations placed on Aster Data Systems over a short period.
---

<div class="my-12 bg-slate-50 dark:bg-navy-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-2xl not-prose font-sans w-full max-w-2xl mx-auto">
  
  <div class="px-6 py-5 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 flex justify-between items-end">
    <div>
      <div class="text-xs uppercase tracking-widest text-emerald-600 dark:text-emerald-400 font-semibold mb-1">Illustration 3</div>
      <h3 class="text-lg text-slate-900 dark:text-white font-medium m-0">The Company With Five Prices</h3>
    </div>
    <div class="text-xs text-slate-500 font-mono">Aster Data Systems</div>
  </div>

  <div class="p-0">
    <table class="w-full text-left text-sm">
      <thead>
        <tr class="bg-slate-200 dark:bg-slate-800/30 border-b border-slate-300 dark:border-slate-700/50">
          <th class="py-4 pl-6 pr-4 font-medium text-slate-600 dark:text-slate-400">Context</th>
          <th class="py-4 px-4 font-medium text-slate-600 dark:text-slate-400 w-1/4">Regulatory Standard</th>
          <th class="py-4 pl-4 pr-6 font-medium text-slate-700 dark:text-slate-300 text-right w-1/4">Computed Value</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 dark:divide-slate-800/50">
        <tr class="group hover:bg-slate-800/20 transition-colors">
          <td class="py-4 pl-6 pr-4">
            <div class="font-medium text-slate-700 dark:text-slate-300">Initial Subscription</div>
            <div class="text-xs text-slate-500 mt-1">Founder's entry price</div>
          </td>
          <td class="py-4 px-4 text-slate-600 dark:text-slate-400 text-xs font-mono">Commercial Reality</td>
          <td class="py-4 pl-4 pr-6 text-slate-800 dark:text-slate-200 text-right font-mono font-semibold">₹20</td>
        </tr>
        <tr class="group hover:bg-slate-800/20 transition-colors">
          <td class="py-4 pl-6 pr-4">
            <div class="font-medium text-slate-700 dark:text-slate-300">Seed Round Investment</div>
            <div class="text-xs text-slate-500 mt-1">Value justified to avoid Section 56(2)(viib)</div>
          </td>
          <td class="py-4 px-4 text-slate-600 dark:text-slate-400 text-xs font-mono">Rule 11UA(2) <br/><span class="text-xs text-slate-500">DCF Method</span></td>
          <td class="py-4 pl-4 pr-6 text-indigo-600 dark:text-indigo-400 text-right font-mono font-semibold">₹100</td>
        </tr>
        <tr class="group hover:bg-slate-800/20 transition-colors">
          <td class="py-4 pl-6 pr-4">
            <div class="font-medium text-slate-700 dark:text-slate-300">Foreign Direct Investment</div>
            <div class="text-xs text-slate-500 mt-1">Floor price for issuing shares to non-residents</div>
          </td>
          <td class="py-4 px-4 text-slate-600 dark:text-slate-400 text-xs font-mono">FEMA <br/><span class="text-xs text-slate-500">Internationally accepted method</span></td>
          <td class="py-4 pl-4 pr-6 text-indigo-700 dark:text-indigo-300 text-right font-mono font-semibold">₹150</td>
        </tr>
        <tr class="group hover:bg-rose-900/10 transition-colors bg-rose-50 dark:bg-rose-950/5">
          <td class="py-4 pl-6 pr-4">
            <div class="font-medium text-rose-700 dark:text-rose-300">Distress Sale</div>
            <div class="text-xs text-rose-600 dark:text-rose-400/60 mt-1">Actual price negotiated between willing parties</div>
          </td>
          <td class="py-4 px-4 text-rose-600 dark:text-rose-400/80 text-xs font-mono">Economic Reality</td>
          <td class="py-4 pl-4 pr-6 text-rose-600 dark:text-rose-400 text-right font-mono font-bold">₹10</td>
        </tr>
        <tr class="group hover:bg-indigo-900/10 transition-colors bg-indigo-50 dark:bg-indigo-950/10">
          <td class="py-4 pl-6 pr-4">
            <div class="font-medium text-indigo-700 dark:text-indigo-300">Tax Computation for Seller</div>
            <div class="text-xs text-indigo-600 dark:text-indigo-400/60 mt-1">Deemed consideration under Section 50CA</div>
          </td>
          <td class="py-4 px-4 text-indigo-600 dark:text-indigo-400/80 text-xs font-mono">Rule 11UA(1) <br/><span class="text-xs text-indigo-500/60">NAV Method</span></td>
          <td class="py-4 pl-4 pr-6 text-indigo-600 dark:text-indigo-400 text-right font-mono font-bold text-xl">₹100</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
