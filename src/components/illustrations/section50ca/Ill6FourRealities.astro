---
// Ill6FourRealities.astro
---
<div class="my-12 bg-navy-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl max-w-2xl mx-auto not-prose">
  <div class="px-6 py-5 border-b border-slate-800 bg-slate-900/50 text-center">
    <div class="text-[10px] uppercase tracking-widest text-indigo-400 font-semibold mb-1">Illustration 6</div>
    <h3 class="text-lg text-white font-medium m-0">Four Realities, One Share</h3>
    <p class="text-xs text-slate-400 mt-2">Freedom to choose a commercial price is not necessarily freedom to choose the tax base.</p>
  </div>

  <div class="p-8 flex flex-col items-center">
    
    <!-- Top Node -->
    <div class="bg-slate-800 border border-slate-700 rounded px-6 py-2 mb-8 shadow z-10">
      <span class="text-sm font-semibold text-slate-200 tracking-widest uppercase">One Share</span>
    </div>

    <!-- Tree Structure -->
    <div class="relative w-full max-w-lg mb-12">
      <!-- Horizontal Connecting Line -->
      <div class="absolute top-0 left-[15%] w-[70%] h-[1px] bg-slate-700"></div>
      
      <!-- Vertical Lines down to 3 nodes -->
      <div class="absolute top-0 left-[15%] w-[1px] h-6 bg-slate-700"></div>
      <div class="absolute top-0 left-[50%] w-[1px] h-6 bg-slate-700 -translate-x-1/2"></div>
      <div class="absolute top-0 left-[85%] w-[1px] h-6 bg-slate-700"></div>
      
      <!-- Vertical Line down from ONE SHARE to horizontal line -->
      <div class="absolute -top-8 left-[50%] w-[1px] h-8 bg-slate-700 -translate-x-1/2"></div>

      <!-- Row of 3 Nodes -->
      <div class="flex justify-between w-full pt-6 relative z-10">
        <!-- Contract -->
        <div class="flex flex-col items-center w-1/3">
          <div class="text-xs text-slate-400 uppercase tracking-widest mb-2 font-medium">Contract</div>
          <div class="bg-slate-800/50 border border-slate-700 rounded px-4 py-2 w-24 text-center">
            <span class="font-mono text-emerald-400 font-semibold">₹10</span>
          </div>
        </div>
        
        <!-- Bank -->
        <div class="flex flex-col items-center w-1/3">
          <div class="text-xs text-slate-400 uppercase tracking-widest mb-2 font-medium">Bank</div>
          <div class="bg-slate-800/50 border border-slate-700 rounded px-4 py-2 w-24 text-center">
            <span class="font-mono text-emerald-400 font-semibold">₹10</span>
          </div>
        </div>

        <!-- Company -->
        <div class="flex flex-col items-center w-1/3">
          <div class="text-xs text-slate-400 uppercase tracking-widest mb-2 font-medium">Company</div>
          <div class="bg-slate-800/50 border border-slate-700 rounded px-4 py-2 w-24 text-center">
            <span class="font-mono text-emerald-400 font-semibold">₹10</span>
          </div>
        </div>
      </div>
    </div>

    <!-- The Tax Reality Box that bypasses the other 3 -->
    <div class="relative w-full max-w-lg flex flex-col items-center">
      <!-- Big arrow bypassing the rest -->
      <div class="absolute -top-24 left-1/2 w-[1px] h-24 bg-gradient-to-b from-transparent to-rose-700/80 -translate-x-1/2 z-0"></div>
      <div class="absolute -top-2 left-1/2 w-3 h-3 border-b-2 border-r-2 border-rose-700/80 transform rotate-45 -translate-x-1/2 z-0"></div>

      <div class="bg-rose-950/30 border border-rose-900/60 rounded-xl p-5 w-64 text-center z-10 shadow-lg relative overflow-hidden">
        <div class="absolute inset-0 bg-rose-500/5 animate-pulse"></div>
        <div class="relative z-10">
          <div class="text-xs text-rose-400 uppercase tracking-widest mb-2 font-medium">Tax Law</div>
          <div class="text-2xl font-mono text-rose-300 font-bold mb-1">₹100</div>
          <div class="text-[10px] text-rose-400/70 uppercase tracking-wider">Deemed Consideration</div>
        </div>
      </div>
    </div>

  </div>
</div>
