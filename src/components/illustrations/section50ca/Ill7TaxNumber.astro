---
// Ill7TaxNumber.astro
---
<div class="my-12 bg-navy-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl max-w-2xl mx-auto not-prose">
  <div class="px-6 py-5 border-b border-slate-800 bg-slate-900/50 text-center">
    <div class="text-[10px] uppercase tracking-widest text-indigo-400 font-semibold mb-1">The Aster File &mdash; Illustration 7</div>
    <h3 class="text-lg text-white font-medium m-0">Building the Tax Number</h3>
    <p class="text-xs text-slate-400 mt-2">The statutory measurement system at work.</p>
  </div>

  <div class="p-8">
    <div class="rounded-lg border border-slate-700 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-800/80">
            <th class="px-4 py-3 text-xs uppercase tracking-wider text-slate-300 font-semibold border-b border-slate-700">Adjusted Component</th>
            <th class="px-4 py-3 text-xs uppercase tracking-wider text-slate-300 font-semibold border-b border-slate-700 text-right">Illustrative Amount</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/50">
          <tr class="bg-slate-900/40 hover:bg-slate-800/40 transition-colors">
            <td class="px-4 py-3 text-sm text-slate-300">Relevant adjusted assets</td>
            <td class="px-4 py-3 text-sm font-mono text-emerald-400 text-right">₹30 crore</td>
          </tr>
          <tr class="bg-slate-900/20 hover:bg-slate-800/40 transition-colors">
            <td class="px-4 py-3 text-sm text-slate-300">Securities / other prescribed adjustments</td>
            <td class="px-4 py-3 text-sm font-mono text-emerald-400 text-right">₹5 crore</td>
          </tr>
          <tr class="bg-slate-900/40 hover:bg-slate-800/40 transition-colors">
            <td class="px-4 py-3 text-sm text-slate-300">Prescribed immovable-property value</td>
            <td class="px-4 py-3 text-sm font-mono text-emerald-400 text-right">₹10 crore</td>
          </tr>
          <tr class="bg-slate-900/20 hover:bg-slate-800/40 transition-colors">
            <td class="px-4 py-3 text-sm text-slate-300">Relevant liabilities</td>
            <td class="px-4 py-3 text-sm font-mono text-rose-400 text-right">(₹15 crore)</td>
          </tr>
          <tr class="bg-indigo-950/30 border-t-2 border-indigo-500/30">
            <td class="px-4 py-4 text-sm font-semibold text-white">Illustrative adjusted equity value</td>
            <td class="px-4 py-4 text-sm font-mono font-bold text-indigo-300 text-right">₹30 crore</td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <div class="mt-6 bg-slate-800/50 border border-slate-700 rounded-lg p-4 text-center">
      <div class="text-xs text-slate-400 uppercase tracking-widest mb-1">Resulting Value Per Relevant Share</div>
      <div class="text-2xl text-white font-bold">₹100</div>
    </div>
  </div>
</div>
