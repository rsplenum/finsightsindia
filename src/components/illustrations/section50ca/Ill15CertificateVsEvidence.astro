---
// Ill15CertificateVsEvidence.astro
---
<div class="my-12 bg-slate-50 dark:bg-navy-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-xl max-w-2xl mx-auto not-prose font-sans w-full">
  <div class="px-6 py-5 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50 text-center">
    <div class="text-xs uppercase tracking-widest text-indigo-600 dark:text-indigo-400 font-semibold mb-1">Illustration 15</div>
    <h3 class="text-lg text-slate-900 dark:text-white font-medium m-0">Certificate vs Evidence</h3>
    <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">A number tells the authority what you concluded. An evidentiary chain shows why the conclusion existed.</p>
  </div>

  <div class="p-8 flex flex-col md:flex-row gap-8 justify-center">
    
    <!-- Founder A View (Number) -->
    <div class="flex-1 flex flex-col items-center">
      <div class="text-xs font-semibold text-slate-800 dark:text-slate-200 tracking-widest uppercase bg-slate-200 dark:bg-slate-800 px-6 py-2 rounded-full border border-slate-300 dark:border-slate-700 shadow mb-6 text-center w-3/4">Founder A</div>
      
      <div class="bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/50 rounded-lg p-6 w-full text-center relative flex-grow flex flex-col justify-between opacity-80 hover:opacity-100 transition-opacity">
        <div class="text-lg font-mono text-rose-700 dark:text-rose-300 font-bold tracking-tight px-2 py-4 border-b border-rose-200 dark:border-rose-900/30 mb-8 border-dashed">"₹100/share"</div>
        
        <div class="absolute top-[40%] left-1/2 -translate-x-1/2 h-[20%] w-[1px] bg-rose-50 dark:bg-rose-900/50">
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b border-r border-rose-300 dark:border-rose-700 transform rotate-45 mb-[-2px]"></div>
        </div>
        
        <div class="mt-auto bg-slate-50 dark:bg-slate-900/80 border border-slate-300 dark:border-slate-700 rounded px-4 py-3 text-center shadow-inner">
          <span class="text-xl text-slate-600 dark:text-slate-400 tracking-widest font-bold uppercase">NUMBER</span>
        </div>
      </div>
    </div>

    <!-- Founder B View (Story) -->
    <div class="flex-1 flex flex-col items-center">
      <div class="text-xs font-semibold text-slate-800 dark:text-slate-200 tracking-widest uppercase bg-indigo-50 dark:bg-indigo-950/80 px-6 py-2 rounded-full border border-indigo-300 dark:border-indigo-700/50 shadow mb-6 text-center w-3/4">Founder B</div>
      
      <div class="bg-indigo-50 dark:bg-indigo-950/20 border border-indigo-200 dark:border-indigo-900/50 rounded-lg p-5 w-full text-center relative flex-grow flex flex-col justify-between shadow-[inset_0_0_20px_rgba(99,102,241,0.05)]">
        
        <div class="space-y-1 text-left text-sm font-medium text-slate-700 dark:text-slate-300 pb-4 relative z-10 pl-2">
          <div class="flex items-start"><span class="text-indigo-600 dark:text-indigo-400 mr-2 opacity-50">+</span> Financials</div>
          <div class="flex items-start"><span class="text-indigo-600 dark:text-indigo-400 mr-2 opacity-50">+</span> Cap table</div>
          <div class="flex items-start"><span class="text-indigo-600 dark:text-indigo-400 mr-2 opacity-50">+</span> Rights</div>
          <div class="flex items-start"><span class="text-indigo-600 dark:text-indigo-400 mr-2 opacity-50">+</span> Negotiations</div>
          <div class="flex items-start"><span class="text-indigo-600 dark:text-indigo-400 mr-2 opacity-50">+</span> Failed funding</div>
          <div class="flex items-start"><span class="text-indigo-600 dark:text-indigo-400 mr-2 opacity-50">+</span> Offers</div>
          <div class="flex items-start"><span class="text-indigo-600 dark:text-indigo-400 mr-2 opacity-50">+</span> FMV workings</div>
          <div class="flex items-start text-xs"><span class="text-indigo-600 dark:text-indigo-400 mr-2 opacity-50">+</span> Commercial rationale</div>
        </div>
        
        <div class="absolute bottom-[80px] left-1/2 -translate-x-1/2 h-6 w-[2px] bg-indigo-500/50">
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b-2 border-r-2 border-indigo-400 transform rotate-45 mb-[-2px]"></div>
        </div>
        
        <div class="mt-4 bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-600/40 rounded px-4 py-3 text-center shadow-[0_0_15px_rgba(99,102,241,0.15)] relative z-10">
          <span class="text-xl text-indigo-700 dark:text-indigo-300 tracking-widest font-bold uppercase">STORY</span>
        </div>
      </div>
    </div>

  </div>
</div>
