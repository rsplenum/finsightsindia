---
// Ill14OneShareTwoSystems.astro
---
<div class="my-12 bg-navy-900 border border-slate-800 rounded-xl overflow-hidden shadow-xl max-w-2xl mx-auto not-prose">
  <div class="px-6 py-5 border-b border-slate-800 bg-slate-900/50 text-center">
    <div class="text-[10px] uppercase tracking-widest text-indigo-400 font-semibold mb-1">The Aster File &mdash; Illustration 14</div>
    <h3 class="text-lg text-white font-medium m-0">One Share, Two Legal Systems</h3>
    <p class="text-xs text-slate-400 mt-2">Contract law does not automatically dictate tax valuation.</p>
  </div>

  <div class="p-8 flex flex-col md:flex-row gap-8 items-stretch justify-center">
    
    <!-- Agreement View -->
    <div class="flex-1 border border-emerald-900/30 bg-emerald-950/10 rounded-lg p-6 flex flex-col items-center">
      <div class="text-xs text-emerald-400/80 uppercase tracking-widest mb-6 font-semibold bg-emerald-950/80 px-4 py-1 border border-emerald-800/50 rounded-full text-center leading-tight w-4/5 shadow">Shareholders'<br>Agreement</div>
      
      <div class="bg-emerald-900/20 border border-emerald-700/50 rounded px-6 py-3 text-center w-full mb-6 relative">
        <span class="font-mono text-emerald-400 font-bold text-xl">₹1/share</span>
        
        <div class="absolute -bottom-7 left-1/2 -translate-x-1/2 h-6 w-[2px] bg-emerald-800/50">
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b-2 border-r-2 border-emerald-600 transform rotate-45 mb-[-2px]"></div>
        </div>
      </div>
      
      <div class="bg-emerald-950/40 border border-emerald-800/40 rounded px-4 py-3 text-center w-full shadow-inner">
        <div class="text-[10px] text-emerald-300 uppercase tracking-widest mb-1">Cash to Arjun</div>
        <div class="text-lg font-mono text-white font-bold">₹10,000</div>
      </div>
    </div>

    <!-- Tax Law View -->
    <div class="flex-1 border border-rose-900/30 bg-rose-950/10 rounded-lg p-6 flex flex-col items-center relative overflow-hidden">
      <!-- Glow -->
      <div class="absolute -top-10 -right-10 w-32 h-32 bg-rose-500/10 rounded-full blur-3xl"></div>

      <div class="text-xs text-rose-400/80 uppercase tracking-widest mb-6 font-semibold bg-rose-950/80 px-4 py-2 border border-rose-800/50 rounded-full text-center leading-tight shadow z-10 w-4/5">Tax Law</div>
      
      <div class="bg-rose-900/20 border border-rose-700/50 rounded px-6 py-3 text-center w-full mb-6 relative z-10 shadow-[0_0_15px_rgba(244,63,94,0.1)]">
        <span class="font-mono text-rose-400 font-bold text-xl">₹150/share</span>
        
        <div class="absolute -bottom-7 left-1/2 -translate-x-1/2 h-6 w-[2px] bg-gradient-to-b from-rose-800/50 to-rose-500">
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 border-b-2 border-r-2 border-rose-500 transform rotate-45 mb-[-2px]"></div>
        </div>
      </div>
      
      <div class="bg-rose-950/50 border border-rose-600/40 rounded px-4 py-3 text-center w-full shadow-[0_0_15px_rgba(244,63,94,0.15)] z-10">
        <div class="text-[10px] text-rose-300 uppercase tracking-widest mb-1">Potential Deemed Value</div>
        <div class="text-2xl font-mono text-white font-bold tracking-tight">₹15 lakh</div>
      </div>
    </div>

  </div>
</div>
