<div class="my-8 rounded-xl border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 overflow-hidden shadow-sm">
  <div class="bg-navy-50 dark:bg-navy-900/50 px-4 py-3 border-b border-navy-200 dark:border-navy-800 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-navy-500 dark:text-navy-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      <h4 class="text-sm font-bold text-navy-900 dark:text-navy-100 m-0">The 45-Day Rescue Timeline</h4>
    </div>
    <span class="text-xs font-semibold text-navy-500 dark:text-navy-400">MoU Buffer Clause</span>
  </div>
  
  <div class="p-6 relative">
    <!-- Horizontal Line (Hidden on small screens) -->
    <div class="hidden sm:block absolute top-[52px] left-10 right-10 h-0.5 bg-navy-200 dark:bg-navy-800"></div>

    <div class="flex flex-col sm:flex-row justify-between gap-6 relative">
      
      <!-- Step 1 -->
      <div class="flex flex-row sm:flex-col items-center gap-4 sm:gap-2 sm:text-center w-full sm:w-1/3">
        <div class="w-10 h-10 rounded-full bg-navy-100 dark:bg-navy-900 border-2 border-navy-300 dark:border-navy-700 flex items-center justify-center flex-shrink-0 z-10">
          <span class="text-sm font-bold text-navy-700 dark:text-navy-300">1</span>
        </div>
        <div class="flex-1 sm:flex-none">
          <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wide mb-1">Day 1</div>
          <h5 class="text-sm font-bold text-navy-900 dark:text-navy-100 m-0">Sign MoU (Token Advance)</h5>
          <p class="text-xs text-navy-600 dark:text-navy-400 mt-1 leading-tight">Draft agreement containing the "Subject to Section 197" clause.</p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex flex-row sm:flex-col items-center gap-4 sm:gap-2 sm:text-center w-full sm:w-1/3">
        <div class="w-10 h-10 rounded-full bg-gold-100 dark:bg-gold-900/30 border-2 border-gold-400 dark:border-gold-600 flex items-center justify-center flex-shrink-0 z-10 shadow-[0_0_15px_rgba(250,204,21,0.2)]">
          <span class="text-sm font-bold text-gold-700 dark:text-gold-400">2</span>
        </div>
        <div class="flex-1 sm:flex-none">
          <div class="text-xs font-bold text-gold-600 dark:text-gold-400 uppercase tracking-wide mb-1">Days 2 to 40</div>
          <h5 class="text-sm font-bold text-navy-900 dark:text-navy-100 m-0">Form 13 Processing</h5>
          <p class="text-xs text-navy-600 dark:text-navy-400 mt-1 leading-tight">AO reviews 54/54EC proofs, computes liability, issues binding LDC.</p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex flex-row sm:flex-col items-center gap-4 sm:gap-2 sm:text-center w-full sm:w-1/3">
        <div class="w-10 h-10 rounded-full bg-navy-100 dark:bg-navy-900 border-2 border-navy-300 dark:border-navy-700 flex items-center justify-center flex-shrink-0 z-10">
          <span class="text-sm font-bold text-navy-700 dark:text-navy-300">3</span>
        </div>
        <div class="flex-1 sm:flex-none">
          <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wide mb-1">Day 45+</div>
          <h5 class="text-sm font-bold text-navy-900 dark:text-navy-100 m-0">Final Deed Registration</h5>
          <p class="text-xs text-navy-600 dark:text-navy-400 mt-1 leading-tight">Buyer safely withholds lower/nil amount. Full balance transferred.</p>
        </div>
      </div>

    </div>
  </div>
</div>
