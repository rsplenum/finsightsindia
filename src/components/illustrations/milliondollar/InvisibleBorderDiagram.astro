---
// InvisibleBorderDiagram.astro
---

<div class="my-12 bg-slate-50 dark:bg-navy-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-2xl not-prose font-sans w-full max-w-2xl mx-auto">
  
  <div class="px-6 py-5 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50">
    <div class="text-xs uppercase tracking-widest text-emerald-600 dark:text-emerald-400 font-semibold mb-1">Illustration 1</div>
    <h3 class="text-lg text-slate-900 dark:text-white font-medium m-0">The Invisible Border Inside The Ledger</h3>
  </div>

  <div class="p-6 relative flex flex-col items-center">
    
    <!-- Top Node -->
    <div class="bg-slate-200 dark:bg-slate-800/80 border border-slate-300 dark:border-slate-700 px-6 py-4 rounded-lg w-full max-w-sm text-center relative z-10 shadow-sm">
      <div class="text-xl font-bold text-slate-900 dark:text-white font-mono">NRO</div>
      <div class="text-sm text-slate-600 dark:text-slate-400 mt-1">Indian-origin rupee wealth</div>
    </div>

    <!-- Arrow Down -->
    <div class="w-[1px] h-10 bg-slate-400 dark:bg-slate-600 relative">
       <div class="absolute -bottom-2 left-1/2 w-3 h-3 border-b border-r border-slate-400 dark:border-slate-600 transform rotate-45 -translate-x-1/2"></div>
    </div>

    <!-- The Gate -->
    <div class="bg-indigo-50 dark:bg-indigo-950/30 border border-indigo-200 dark:border-indigo-800/50 px-6 py-4 rounded-lg w-full max-w-md text-center relative z-10 shadow-sm my-2">
      <div class="text-sm font-semibold text-indigo-800 dark:text-indigo-300 uppercase tracking-widest mb-2 flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        FEMA / RBI Gate
      </div>
      <div class="flex flex-wrap justify-center gap-2 text-xs text-indigo-700 dark:text-indigo-400">
        <span class="bg-white dark:bg-indigo-900/40 px-2 py-1 rounded shadow-sm border border-indigo-100 dark:border-indigo-800">Source</span>
        <span class="bg-white dark:bg-indigo-900/40 px-2 py-1 rounded shadow-sm border border-indigo-100 dark:border-indigo-800">Tax</span>
        <span class="bg-white dark:bg-indigo-900/40 px-2 py-1 rounded shadow-sm border border-indigo-100 dark:border-indigo-800">Eligibility</span>
        <span class="bg-white dark:bg-indigo-900/40 px-2 py-1 rounded shadow-sm border border-indigo-100 dark:border-indigo-800">Annual Facility</span>
        <span class="bg-white dark:bg-indigo-900/40 px-2 py-1 rounded shadow-sm border border-indigo-100 dark:border-indigo-800">Docs</span>
      </div>
    </div>

    <!-- Arrow Down -->
    <div class="w-[1px] h-10 bg-slate-400 dark:bg-slate-600 relative">
       <div class="absolute -bottom-2 left-1/2 w-3 h-3 border-b border-r border-slate-400 dark:border-slate-600 transform rotate-45 -translate-x-1/2"></div>
    </div>

    <!-- NRE Node -->
    <div class="bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-800/50 px-6 py-4 rounded-lg w-full max-w-sm text-center relative z-10 shadow-sm">
      <div class="text-xl font-bold text-emerald-700 dark:text-emerald-400 font-mono">NRE</div>
      <div class="text-sm text-emerald-600 dark:text-emerald-500/80 mt-1">Repatriable rupee wealth</div>
    </div>
    
    <!-- Arrow Down -->
    <div class="w-[1px] h-10 bg-emerald-400/50 dark:bg-emerald-600/50 relative">
       <div class="absolute -bottom-2 left-1/2 w-3 h-3 border-b border-r border-emerald-400/50 dark:border-emerald-600/50 transform rotate-45 -translate-x-1/2"></div>
    </div>
    
    <!-- Final Node -->
    <div class="bg-slate-100 dark:bg-slate-800/50 border border-dashed border-slate-400 dark:border-slate-600 px-6 py-4 rounded-lg w-full max-w-sm text-center relative z-10">
      <div class="text-slate-800 dark:text-slate-300 font-medium">Foreign Currency / Overseas Wealth</div>
    </div>
    
    <div class="mt-8 text-sm text-slate-500 dark:text-slate-400 text-center italic border-t border-slate-200 dark:border-slate-800/80 pt-6">
      <strong>Core insight:</strong> The physical location of the rupee may not change when NRO becomes NRE. What changes is the <strong>legal mobility attached to the wealth</strong>.
    </div>

  </div>
</div>
