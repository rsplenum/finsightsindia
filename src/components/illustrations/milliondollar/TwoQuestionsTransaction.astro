---
// TwoQuestionsTransaction.astro
---

<div class="my-12 bg-slate-50 dark:bg-navy-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-2xl not-prose font-sans w-full max-w-3xl mx-auto">
  
  <div class="px-6 py-5 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/50">
    <div class="text-xs uppercase tracking-widest text-emerald-600 dark:text-emerald-400 font-semibold mb-1">Illustration 6</div>
    <h3 class="text-lg text-slate-900 dark:text-white font-medium m-0">Two Questions, One Transaction</h3>
  </div>

  <div class="p-8 relative">
    
    <!-- Top Node -->
    <div class="flex justify-center mb-8">
      <div class="bg-slate-800 dark:bg-slate-200 text-white dark:text-slate-900 px-6 py-3 rounded-full font-semibold uppercase tracking-wider text-sm shadow-md z-10 relative">
        The NRI's Remittance
      </div>
    </div>

    <!-- Connecting Lines (Split) -->
    <div class="absolute top-[82px] left-1/2 w-[50%] h-[40px] -translate-x-1/2 border-t-2 border-l-2 border-r-2 border-slate-300 dark:border-slate-700 rounded-t-xl z-0"></div>

    <!-- Split Sections -->
    <div class="flex flex-col md:flex-row gap-6 mt-4">
      
      <!-- Left: FEMA/RBI -->
      <div class="w-full md:w-1/2 bg-indigo-50 dark:bg-indigo-950/20 border border-indigo-200 dark:border-indigo-900/40 rounded-xl p-5 relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-indigo-100 dark:bg-indigo-900 border border-indigo-300 dark:border-indigo-700 px-3 py-1 rounded text-xs font-bold text-indigo-800 dark:text-indigo-300 uppercase tracking-widest">
          FEMA / RBI
        </div>
        
        <div class="text-center mt-4 mb-4">
          <div class="text-lg font-bold text-slate-800 dark:text-slate-200">"Can this wealth move?"</div>
        </div>
        
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400 border-t border-indigo-200 dark:border-indigo-800/50 pt-4">
          <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-indigo-400 dark:bg-indigo-600"></div>Eligibility</li>
          <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-indigo-400 dark:bg-indigo-600"></div>Asset category</li>
          <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-indigo-400 dark:bg-indigo-600"></div>Repatriation facility</li>
          <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-indigo-400 dark:bg-indigo-600"></div>Annual limit</li>
          <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-indigo-400 dark:bg-indigo-600"></div>RBI approval</li>
        </ul>
      </div>

      <!-- Right: Income Tax -->
      <div class="w-full md:w-1/2 bg-rose-50 dark:bg-rose-950/20 border border-rose-200 dark:border-rose-900/40 rounded-xl p-5 relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-rose-100 dark:bg-rose-900 border border-rose-300 dark:border-rose-700 px-3 py-1 rounded text-xs font-bold text-rose-800 dark:text-rose-300 uppercase tracking-widest">
          Income Tax
        </div>
        
        <div class="text-center mt-4 mb-4">
          <div class="text-lg font-bold text-slate-800 dark:text-slate-200">"What does India tax?"</div>
        </div>
        
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400 border-t border-rose-200 dark:border-rose-800/50 pt-4">
          <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-rose-400 dark:bg-rose-600"></div>Income character</li>
          <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-rose-400 dark:bg-rose-600"></div>Capital gains</li>
          <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-rose-400 dark:bg-rose-600"></div>Withholding (TDS)</li>
          <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-rose-400 dark:bg-rose-600"></div>Tax treaty</li>
          <li class="flex items-center gap-2"><div class="w-1.5 h-1.5 rounded-full bg-rose-400 dark:bg-rose-600"></div>Reporting (Forms 145/146)</li>
        </ul>
      </div>

    </div>

    <!-- Connecting Lines (Merge) -->
    <div class="relative h-12 mt-4 hidden md:block">
      <div class="absolute top-0 left-1/4 w-[50%] h-[30px] border-b-2 border-l-2 border-r-2 border-slate-300 dark:border-slate-700 rounded-b-xl"></div>
      <div class="absolute top-[30px] left-1/2 w-[2px] h-[18px] bg-slate-300 dark:border-slate-700 -translate-x-1/2">
         <div class="absolute -bottom-1 left-1/2 w-2 h-2 border-b-2 border-r-2 border-slate-300 dark:border-slate-700 transform rotate-45 -translate-x-1/2"></div>
      </div>
    </div>
    
    <div class="flex justify-center mt-4 md:mt-0 relative z-10">
       <div class="bg-slate-100 dark:bg-slate-800 border-2 border-slate-300 dark:border-slate-600 rounded-xl p-5 w-full max-w-lg text-center shadow-lg">
          <div class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-2">Authorised Dealer Bank</div>
          <div class="text-base font-medium text-slate-900 dark:text-slate-100 italic">"Can the transaction be processed with sufficient evidence?"</div>
       </div>
    </div>

    <div class="mt-8 text-sm text-slate-500 dark:text-slate-400 text-center border-t border-slate-200 dark:border-slate-800/80 pt-6">
      The bank sits where the two regulatory systems meet.
    </div>

  </div>
</div>
