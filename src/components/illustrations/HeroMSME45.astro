---
// HeroMSME45.astro
---
<div class="w-full flex justify-center py-10 my-8 bg-navy-50 dark:bg-navy-950/50 rounded-2xl border border-navy-100 dark:border-navy-800">
  <div class="relative bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-700 rounded-2xl shadow-lg p-8 max-w-sm w-full flex flex-col items-center">
    <!-- Calendar Header -->
    <div class="w-full bg-navy-900 dark:bg-navy-950 text-gold-500 text-center py-2.5 rounded-t-xl absolute top-0 left-0 right-0 font-bold tracking-widest text-xs uppercase border-b border-gold-500/20">
      MSMED Clock
    </div>
    
    <!-- Calendar Body -->
    <div class="mt-10 text-center">
      <div class="text-8xl font-black text-navy-900 dark:text-white tracking-tighter leading-none">
        45
      </div>
      <div class="text-sm text-navy-500 font-bold uppercase tracking-widest mt-3">Maximum Days</div>
    </div>
    
    <!-- Tax Add Back Arrow -->
    <div class="mt-8 relative w-full border-t border-dashed border-navy-300 dark:border-navy-600 pt-6">
      <div class="flex items-center justify-between">
        <span class="text-sm font-bold text-navy-600 dark:text-navy-400">Day 46+ Payment</span>
        <div class="flex items-center text-rose-600 dark:text-rose-400 font-bold text-sm bg-rose-50 dark:bg-rose-500/10 px-3 py-1.5 rounded-md">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m0-16l-4 4m4-4l4 4"/>
          </svg>
          Tax Add-Back
        </div>
      </div>
    </div>
  </div>
</div>
