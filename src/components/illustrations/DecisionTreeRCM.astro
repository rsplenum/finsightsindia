---
---
<div class="w-full bg-slate-50 dark:bg-slate-900 rounded-3xl p-6 sm:p-10 my-8 border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden relative">
  <!-- Subtle background glow -->
  <div class="absolute right-0 top-0 w-64 h-64 bg-blue-500 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 opacity-5"></div>
  
  <h4 class="text-center text-slate-800 dark:text-slate-200 font-black tracking-widest uppercase mb-10 text-sm">RCM Liability Flowchart</h4>
  
  <div class="max-w-3xl mx-auto space-y-4 relative z-10">
    
    <!-- Step 1 -->
    <div class="flex flex-col sm:flex-row items-center sm:items-stretch gap-3 sm:gap-4">
      <div class="w-full sm:w-5/12 bg-white dark:bg-slate-800 p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center justify-between">
        <span class="font-bold text-slate-700 dark:text-slate-200 text-sm">1. Supplier outside India?</span>
      </div>
      <div class="hidden sm:flex items-center justify-center w-8">
         <svg class="w-5 h-5 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </div>
      <div class="w-full sm:w-7/12 flex gap-2">
        <div class="flex-1 bg-slate-100 dark:bg-slate-800 p-3 sm:p-4 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col justify-center items-center text-center opacity-80">
           <span class="text-xs font-black text-slate-400 uppercase tracking-wider mb-1">If No</span>
           <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">Use Domestic GST</span>
        </div>
        <div class="flex-1 bg-blue-50 dark:bg-blue-900 p-3 sm:p-4 rounded-xl border border-blue-200 dark:border-blue-800 flex flex-col justify-center items-center text-center">
           <span class="text-xs font-black text-blue-500 uppercase tracking-wider mb-1">If Yes</span>
           <span class="text-xs text-blue-700 dark:text-blue-400 font-bold">Next Step</span>
        </div>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="flex flex-col sm:flex-row items-center sm:items-stretch gap-3 sm:gap-4">
      <div class="w-full sm:w-5/12 bg-white dark:bg-slate-800 p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center justify-between">
        <span class="font-bold text-slate-700 dark:text-slate-200 text-sm">2. For business in India?</span>
      </div>
      <div class="hidden sm:flex items-center justify-center w-8">
         <svg class="w-5 h-5 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </div>
      <div class="w-full sm:w-7/12 flex gap-2">
        <div class="flex-1 bg-slate-100 dark:bg-slate-800 p-3 sm:p-4 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col justify-center items-center text-center opacity-80">
           <span class="text-xs font-black text-slate-400 uppercase tracking-wider mb-1">If No</span>
           <span class="text-xs text-slate-600 dark:text-slate-400 font-medium leading-tight">Not Import of Service</span>
        </div>
        <div class="flex-1 bg-blue-50 dark:bg-blue-900 p-3 sm:p-4 rounded-xl border border-blue-200 dark:border-blue-800 flex flex-col justify-center items-center text-center">
           <span class="text-xs font-black text-blue-500 uppercase tracking-wider mb-1">If Yes</span>
           <span class="text-xs text-blue-700 dark:text-blue-400 font-bold">Next Step</span>
        </div>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="flex flex-col sm:flex-row items-center sm:items-stretch gap-3 sm:gap-4">
      <div class="w-full sm:w-5/12 bg-white dark:bg-slate-800 p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center justify-between">
        <span class="font-bold text-slate-700 dark:text-slate-200 text-sm">3. GST-registered?</span>
      </div>
      <div class="hidden sm:flex items-center justify-center w-8">
         <svg class="w-5 h-5 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </div>
      <div class="w-full sm:w-7/12 flex gap-2">
         <div class="flex-1 bg-slate-100 dark:bg-slate-800 p-3 sm:p-4 rounded-xl border border-slate-200 dark:border-slate-700 flex flex-col justify-center items-center text-center opacity-80">
           <span class="text-xs font-black text-slate-400 uppercase tracking-wider mb-1">If No</span>
           <span class="text-xs text-slate-600 dark:text-slate-400 font-medium">OIDAR B2C Rules</span>
        </div>
        <div class="flex-1 bg-blue-50 dark:bg-blue-900 p-3 sm:p-4 rounded-xl border border-blue-200 dark:border-blue-800 flex flex-col justify-center items-center text-center">
           <span class="text-xs font-black text-blue-500 uppercase tracking-wider mb-1">If Yes</span>
           <span class="text-xs text-blue-700 dark:text-blue-400 font-bold">Next Step</span>
        </div>
      </div>
    </div>

    <!-- Step 4 (Final Decision) -->
    <div class="flex flex-col sm:flex-row items-center sm:items-stretch gap-3 sm:gap-4 mt-8 relative">
      <div class="w-full sm:w-5/12 bg-slate-800 dark:bg-slate-800 p-4 sm:p-5 rounded-xl border border-slate-700 shadow-md flex items-center justify-between relative z-10">
        <span class="font-bold text-white text-sm">4. Invoice has Indian GST?</span>
      </div>
      <div class="hidden sm:flex items-center justify-center w-8 relative z-10">
         <svg class="w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </div>
      <div class="w-full sm:w-7/12 flex gap-2 relative z-10">
        <div class="flex-1 bg-emerald-50 dark:bg-emerald-900 p-3 sm:p-4 rounded-xl border border-emerald-200 dark:border-emerald-800 flex flex-col justify-center items-center text-center">
           <span class="text-xs font-black text-emerald-500 uppercase tracking-wider mb-1">If Yes</span>
           <span class="text-xs text-emerald-700 dark:text-emerald-400 font-bold">Reconcile (No RCM)</span>
        </div>
        <!-- Action Node -->
        <div class="flex-1 bg-amber-50 dark:bg-amber-900 p-3 sm:p-4 rounded-xl border-2 border-amber-400 dark:border-amber-600 flex flex-col justify-center items-center text-center shadow-md relative overflow-hidden">
           <div class="absolute top-0 right-0 w-8 h-8 bg-amber-400 rounded-bl-full opacity-20"></div>
           <span class="text-xs font-black text-amber-600 dark:text-amber-500 uppercase tracking-wider mb-1">If No</span>
           <span class="text-xs text-amber-800 dark:text-amber-400 font-black">Self-Pay 18% (RCM)</span>
        </div>
      </div>
    </div>

  </div>
</div>
