---
// InsetMSMEFilter.astro
---
<div class="my-8 bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-2xl shadow-sm p-6 sm:p-8">
  <h4 class="text-xs font-bold text-navy-500 dark:text-navy-400 uppercase tracking-widest mb-6">The Section 43B(h) Filter</h4>
  
  <div class="space-y-3 relative">
    <!-- Connecting Line -->
    <div class="absolute left-6 top-6 bottom-6 w-0.5 bg-navy-200 dark:bg-navy-700 z-0 hidden sm:block"></div>
    
    <!-- Level 1 -->
    <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between bg-navy-50 dark:bg-navy-800 p-4 rounded-xl border border-navy-200 dark:border-navy-700 gap-4 sm:gap-0">
      <div class="font-bold text-navy-900 dark:text-white flex items-center gap-3">
        <div class="w-6 h-6 rounded-full bg-gold-500 text-white flex items-center justify-center text-xs">1</div>
        Registration
      </div>
      <div class="flex flex-wrap gap-2 text-sm font-medium ml-9 sm:ml-0">
        <span class="bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30 px-3 py-1 rounded-md">Udyam Registered</span>
        <span class="bg-navy-100 dark:bg-navy-900 text-navy-500 dark:text-navy-500 border border-navy-200 dark:border-navy-700 px-3 py-1 rounded-md opacity-60">Unregistered</span>
      </div>
    </div>
    
    <!-- Level 2 -->
    <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between bg-navy-50 dark:bg-navy-800 p-4 rounded-xl border border-navy-200 dark:border-navy-700 gap-4 sm:gap-0">
      <div class="font-bold text-navy-900 dark:text-white flex items-center gap-3">
        <div class="w-6 h-6 rounded-full bg-gold-500 text-white flex items-center justify-center text-xs">2</div>
        Scale
      </div>
      <div class="flex flex-wrap gap-2 text-sm font-medium ml-9 sm:ml-0">
        <span class="bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30 px-3 py-1 rounded-md">Micro & Small</span>
        <span class="bg-navy-100 dark:bg-navy-900 text-navy-500 dark:text-navy-500 border border-navy-200 dark:border-navy-700 px-3 py-1 rounded-md opacity-60">Medium</span>
      </div>
    </div>
    
    <!-- Level 3 -->
    <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between bg-navy-50 dark:bg-navy-800 p-4 rounded-xl border border-navy-200 dark:border-navy-700 gap-4 sm:gap-0">
      <div class="font-bold text-navy-900 dark:text-white flex items-center gap-3">
        <div class="w-6 h-6 rounded-full bg-gold-500 text-white flex items-center justify-center text-xs">3</div>
        Activity
      </div>
      <div class="flex flex-wrap gap-2 text-sm font-medium ml-9 sm:ml-0">
        <span class="bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30 px-3 py-1 rounded-md">Mfg / Service</span>
        <span class="bg-navy-100 dark:bg-navy-900 text-navy-500 dark:text-navy-500 border border-navy-200 dark:border-navy-700 px-3 py-1 rounded-md opacity-60">Trader</span>
      </div>
    </div>
  </div>
</div>
