---
// P2PRiskTransferFlow.astro
---
<div class="my-10 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden shadow-xl bg-white dark:bg-slate-900 font-sans">
  <div class="bg-slate-50 dark:bg-slate-950 px-6 py-4 border-b border-slate-200 dark:border-slate-800">
    <h3 class="text-lg font-bold text-slate-900 dark:text-white m-0">The Illusion of "Banking Without Banks"</h3>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">P2P removes intermediation, but it transfers the credit risk directly to you.</p>
  </div>
  
  <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Traditional Bank -->
    <div class="relative">
      <div class="absolute -inset-1 bg-gradient-to-r from-blue-100 to-slate-100 dark:from-blue-900/20 dark:to-slate-800/20 rounded-xl blur-sm opacity-50"></div>
      <div class="relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl p-5 flex flex-col items-center">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-4">Traditional Banking</span>
        
        <div class="w-full flex flex-col items-center gap-2">
          <!-- Saver -->
          <div class="bg-slate-100 dark:bg-slate-800 px-4 py-2 rounded-lg w-full text-center text-sm font-medium dark:text-slate-200">You (Saver)</div>
          
          <div class="h-6 w-px bg-slate-300 dark:bg-slate-600 relative">
             <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[10px] bg-slate-50 dark:bg-slate-900 px-2 text-slate-500">7% Return</div>
          </div>
          
          <!-- Bank (Shield) -->
          <div class="bg-blue-500 text-white px-4 py-3 rounded-xl w-full text-center font-bold shadow-md relative overflow-hidden">
            <div class="absolute inset-0 bg-black/10"></div>
            <span class="relative">The Bank</span>
            <div class="text-[10px] font-normal opacity-90 mt-1">Absorbs 100% of defaults</div>
          </div>
          
          <div class="h-6 w-px bg-slate-300 dark:bg-slate-600 relative">
             <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[10px] bg-slate-50 dark:bg-slate-900 px-2 text-slate-500">12% Loan</div>
          </div>
          
          <!-- Borrower -->
          <div class="bg-slate-100 dark:bg-slate-800 px-4 py-2 rounded-lg w-full text-center text-sm font-medium dark:text-slate-200">Borrower</div>
        </div>
      </div>
    </div>

    <!-- P2P Lending -->
    <div class="relative">
      <div class="absolute -inset-1 bg-gradient-to-r from-red-100 to-orange-100 dark:from-red-900/20 dark:to-orange-900/20 rounded-xl blur-sm opacity-50"></div>
      <div class="relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl p-5 flex flex-col items-center">
        <span class="text-xs font-bold uppercase tracking-wider text-red-600 dark:text-red-400 mb-4">P2P Lending</span>
        
        <div class="w-full flex flex-col items-center gap-2">
          <!-- Saver -->
          <div class="bg-slate-100 dark:bg-slate-800 px-4 py-2 rounded-lg w-full text-center text-sm font-medium dark:text-slate-200 ring-2 ring-red-500 ring-offset-2 dark:ring-offset-slate-900">You (Risk Bearer)</div>
          
          <div class="h-6 w-px bg-red-300 dark:bg-red-900/50 relative">
             <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[10px] bg-slate-50 dark:bg-slate-900 px-2 text-red-500 font-bold font-mono">11% - DEFAULTS</div>
          </div>
          
          <!-- Platform -->
          <div class="bg-slate-800 dark:bg-slate-950 text-slate-300 px-4 py-3 rounded-xl w-full text-center font-mono text-sm border border-slate-700 border-dashed">
            <span>Digital Platform</span>
            <div class="text-[10px] text-slate-500 mt-1">Zero credit guarantee</div>
          </div>
          
          <div class="h-6 w-px bg-red-300 dark:bg-red-900/50 relative"></div>
          
          <!-- Borrower -->
          <div class="bg-slate-100 dark:bg-slate-800 px-4 py-2 rounded-lg w-full text-center text-sm font-medium dark:text-slate-200">Borrower</div>
        </div>
      </div>
    </div>
  </div>
</div>
