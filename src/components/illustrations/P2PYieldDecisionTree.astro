---
---
<div class="w-full bg-slate-50 dark:bg-slate-900 rounded-3xl p-6 sm:p-10 my-8 border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden relative">
  <!-- Subtle background glow -->
  <div class="absolute left-1/2 top-0 w-96 h-96 bg-blue-500 rounded-full blur-3xl -translate-y-1/2 -translate-x-1/2 opacity-5"></div>
  
  <h4 class="text-center text-slate-800 dark:text-slate-200 font-black tracking-widest uppercase mb-8 text-sm">Post-Tax Risk Calculation</h4>
  
  <div class="w-full overflow-x-auto">
    <svg viewBox="0 0 800 320" class="w-full min-w-[600px] h-auto font-sans" preserveAspectRatio="xMidYMid meet">
      
      <!-- Top Node: Gross Yield -->
      <rect x="300" y="20" width="200" height="40" rx="6" class="fill-white dark:fill-slate-800 stroke-emerald-500" stroke-width="2" />
      <text x="400" y="45" class="fill-emerald-700 dark:fill-emerald-400 text-sm font-bold" text-anchor="middle">Platform Gross Yield (e.g., 10%)</text>
      
      <!-- Main Spine 1 -->
      <path d="M 400 60 L 400 100" class="stroke-slate-300 dark:stroke-slate-600" stroke-width="2" />
      <circle cx="400" cy="100" r="4" class="fill-slate-300 dark:fill-slate-600" />
      
      <!-- Branch Left: Tax -->
      <path d="M 400 100 L 300 100" class="stroke-rose-300 dark:stroke-rose-800" stroke-width="2" marker-end="url(#arrow_red_tree)" stroke-dasharray="4 2" />
      <rect x="90" y="80" width="200" height="40" rx="6" class="fill-rose-50 dark:fill-rose-900/30 stroke-rose-500" stroke-width="2" />
      <text x="190" y="105" class="fill-rose-700 dark:fill-rose-400 text-sm font-bold" text-anchor="middle">(-) Marginal Tax on Gross</text>
      
      <!-- Main Spine 2 -->
      <path d="M 400 100 L 400 170" class="stroke-slate-300 dark:stroke-slate-600" stroke-width="3" />
      <circle cx="400" cy="170" r="4" class="fill-slate-300 dark:fill-slate-600" />

      <!-- Branch Right: Defaults -->
      <path d="M 400 170 L 500 170" class="stroke-amber-400 dark:stroke-amber-700" stroke-width="2" marker-end="url(#arrow_amber_tree)" stroke-dasharray="4 2" />
      <rect x="510" y="150" width="200" height="40" rx="6" class="fill-amber-50 dark:fill-amber-900/20 stroke-amber-500" stroke-width="2" />
      <text x="610" y="175" class="fill-amber-700 dark:fill-amber-500 text-sm font-bold" text-anchor="middle">(-) Expected Default Rate</text>

      <!-- Main Spine 3 -->
      <path d="M 400 170 L 400 240" class="stroke-slate-300 dark:stroke-slate-600" stroke-width="3" marker-end="url(#arrow_tree)" />

      <!-- Bottom Node: Net Yield -->
      <rect x="300" y="240" width="200" height="50" rx="6" class="fill-white dark:fill-slate-800 stroke-blue-500" stroke-width="3" />
      <text x="400" y="270" class="fill-blue-700 dark:fill-blue-400 text-base font-black uppercase tracking-wide" text-anchor="middle">True Net Yield</text>
      
      <!-- Structural Context Labels -->
      <text x="390" y="140" class="fill-slate-400 dark:fill-slate-500 text-[10px] font-bold tracking-widest uppercase transform -rotate-90 origin-center" text-anchor="middle">Deducted First</text>

      <!-- Markers -->
      <defs>
        <marker id="arrow_tree" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="fill-slate-300 dark:fill-slate-600" />
        </marker>
        <marker id="arrow_red_tree" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="fill-rose-300 dark:fill-rose-800" />
        </marker>
        <marker id="arrow_amber_tree" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="fill-amber-400 dark:fill-amber-700" />
        </marker>
      </defs>
    </svg>
  </div>
</div>
