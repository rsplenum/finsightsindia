---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
  currentCategory: string;
}

const { currentSlug, currentCategory } = Astro.props;

// Fetch all articles
const allArticles = await getCollection('direct-tax');

// Filter by category, excluding current
let related = allArticles.filter(article => 
  article.data.categoryName === currentCategory && article.id !== currentSlug
);

// If less than 3, add random articles from other categories
if (related.length < 3) {
  const otherArticles = allArticles.filter(article => 
    article.data.categoryName !== currentCategory && article.id !== currentSlug
  );
  
  // Shuffle and add needed amount
  const shuffled = otherArticles.sort(() => 0.5 - Math.random());
  const needed = 3 - related.length;
  related = [...related, ...shuffled.slice(0, needed)];
}

// Ensure max 3
const displayArticles = related.slice(0, 3);
---

{displayArticles.length > 0 && (
  <div class="mt-16 border-t border-navy-200 dark:border-navy-800 pt-12">
    <h2 class="text-2xl font-bold text-navy-900 dark:text-navy-100 mb-8">Related Articles</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {displayArticles.map(article => (
        <a href={`/tax-code/${article.id}`} class="group block h-full bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-xl overflow-hidden hover:border-gold-500 dark:hover:border-gold-500 transition-all hover:shadow-lg hover:-translate-y-1">
          <div class="p-5 h-full flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <span class="inline-block px-2.5 py-1 bg-navy-50 dark:bg-navy-950 text-navy-700 dark:text-navy-300 text-xs font-semibold rounded-md border border-navy-100 dark:border-navy-800">
                {article.data.categoryName}
              </span>
              <span class="text-xs text-navy-500 dark:text-navy-400 font-medium flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                {article.data.readTime}
              </span>
            </div>
            
            <h3 class="text-lg font-bold text-navy-900 dark:text-navy-100 group-hover:text-gold-600 dark:group-hover:text-gold-500 transition-colors line-clamp-2 mb-3">
              {article.data.title}
            </h3>
            
            <p class="text-sm text-navy-600 dark:text-navy-400 line-clamp-2 mt-auto">
              {article.data.summary}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
)}
