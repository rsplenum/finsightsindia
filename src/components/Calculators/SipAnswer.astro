---
// SipAnswer.astro — Goal Verdict, Required Compounded Growth & 1-Tap Actionable Levers (Compute Host)
// Pure verdict and mathematical truth: compares required real growth with historical Nifty 50 record.
import CardPremium from '../CardPremium.astro';
---

<section
  id="sipAnswerLayer"
  class="max-w-4xl mx-auto space-y-6 transition-opacity duration-300"
  aria-label="Your savings plan verdict and goal analysis"
>
  <CardPremium glass={true} class="p-6 sm:p-8 space-y-6">

    <!-- Verdict Header & Success Odds -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1.5 text-xs font-bold px-2.5 py-1 rounded-md bg-gold-500/10 text-gold-700 dark:text-gold-400 border border-gold-500/20">
          <span class="w-2 h-2 rounded-full bg-gold-500 animate-pulse"></span>
          <span>Simulation Verdict</span>
        </span>
        <span id="sipAnsOddsBadge" class="text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
          Computing odds...
        </span>
      </div>

      <h2 id="sipAnsHeadline" class="text-xl sm:text-2xl font-bold tracking-tight text-navy-950 dark:text-white leading-snug">
        Stress-testing your plan across 10,000 empirical market paths…
      </h2>

      <p id="sipAnsDetail" class="text-sm sm:text-base text-navy-700 dark:text-navy-300 leading-relaxed"></p>
    </div>

    <!-- Required Growth vs Historical Nifty 50 Benchmark -->
    <div class="p-4 sm:p-5 rounded-xl bg-navy-50/80 dark:bg-navy-900/60 border border-navy-200/80 dark:border-navy-800/80 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs sm:text-sm font-bold text-navy-900 dark:text-navy-100 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-gold-700 dark:text-gold-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
          <span>Required Real Growth vs Historical Nifty 50 Benchmark</span>
        </span>
        <span id="reqRateBadge" class="text-xs font-extrabold px-2 py-0.5 rounded bg-white dark:bg-navy-950 text-navy-900 dark:text-white border border-navy-300 dark:border-navy-700 tabular-nums">
          +0.0% / yr real
        </span>
      </div>

      <p id="reqRateExplanation" class="text-xs sm:text-sm text-navy-600 dark:text-navy-400 leading-relaxed"></p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1 text-xs">
        <div class="p-2.5 rounded-lg bg-white dark:bg-navy-950 border border-navy-200/60 dark:border-navy-800/60 space-y-0.5">
          <span class="text-navy-500 dark:text-navy-400 block font-medium">Challenging History (10th)</span>
          <span class="font-bold text-navy-900 dark:text-white block tabular-nums">+4.1% / yr real</span>
          <span class="text-navy-500 text-xs">Early drawdowns (e.g. 2008)</span>
        </div>
        <div class="p-2.5 rounded-lg bg-gold-50/60 dark:bg-gold-950/30 border border-gold-300/80 dark:border-gold-800/80 space-y-0.5">
          <span class="text-gold-800 dark:text-gold-300 block font-bold">Typical History (50th)</span>
          <span class="font-bold text-gold-900 dark:text-gold-200 block tabular-nums">+7.2% / yr real</span>
          <span class="text-gold-800 dark:text-gold-300 text-xs">25-yr rolling Nifty 50</span>
        </div>
        <div class="p-2.5 rounded-lg bg-white dark:bg-navy-950 border border-navy-200/60 dark:border-navy-800/60 space-y-0.5">
          <span class="text-navy-500 dark:text-navy-400 block font-medium">Boom History (90th)</span>
          <span class="font-bold text-navy-900 dark:text-white block tabular-nums">+10.4% / yr real</span>
          <span class="text-navy-500 text-xs">Sustained bull cycles</span>
        </div>
      </div>
    </div>

    <!-- 1-Tap Actionable Levers (Goal-Seek remedies when short or to optimize) -->
    <div id="sipAnsRemedies" class="hidden pt-2 border-t border-navy-200 dark:border-navy-800 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-navy-700 dark:text-navy-300">
          Actionable Levers to Secure Your Goal
        </span>
        <span class="text-xs text-navy-500">Tap a card to apply instantly</span>
      </div>

      <div id="sipAnsRemedyGrid" class="grid grid-cols-1 md:grid-cols-3 gap-3"></div>
    </div>

  </CardPremium>
</section>

<script>
  import {
    readSipInputs,
    syncAdvancedFromEntry,
    syncEntryFromAdvanced,
  } from '../../utils/sipInputs';

  const $ = (id: string) => document.getElementById(id);
  const grp = (n: number) => n.toLocaleString('en-IN', { maximumFractionDigits: 0 });

  function money(n: number): string {
    const v = Math.round(n);
    if (v >= 10000000) return `₹${(v / 10000000).toFixed(2)} Crore`;
    if (v >= 100000) return `₹${(v / 100000).toFixed(1)} Lakh`;
    return `₹${grp(v)}`;
  }

  /**
   * Computes the required real compound annual return (above inflation)
   * needed to turn the savings stream into the target wealth goal.
   */
  function calcRequiredRealRate(
    seedCapital: number,
    monthlySip: number,
    realStepUpPct: number,
    horizonYears: number,
    targetRealWealth: number
  ): number {
    if (horizonYears <= 0 || targetRealWealth <= 0) return 0;
    
    let low = -0.5;
    let high = 1.5;
    const stepRate = realStepUpPct / 100;
    
    for (let iter = 0; iter < 30; iter++) {
      const mid = (low + high) / 2;
      let fv = seedCapital * Math.pow(1 + mid, horizonYears);
      for (let yr = 1; yr <= horizonYears; yr++) {
        const annualRealInstalment = monthlySip * 12 * Math.pow(1 + stepRate, yr - 1);
        fv += annualRealInstalment * Math.pow(1 + mid, horizonYears - yr + 0.5);
      }
      
      if (fv < targetRealWealth) {
        low = mid;
      } else {
        high = mid;
      }
    }
    
    return ((low + high) / 2) * 100;
  }

  let worker: Worker | null = null;
  const readInputs = readSipInputs;

  function renderAnswer(inputs: any, outlook: any) {
    const headline = $('sipAnsHeadline');
    const detail = $('sipAnsDetail');
    const oddsBadge = $('sipAnsOddsBadge');
    const reqBadge = $('reqRateBadge');
    const reqExp = $('reqRateExplanation');
    if (!headline || !detail) return;

    const years = inputs.horizonYears;
    const odds = Math.round(outlook.odds * 100);
    const targetFormatted = money(outlook.target);
    const typicalFormatted = money(outlook.endReal.p50);
    const worstFormatted = money(outlook.endReal.p10);

    if (oddsBadge) {
      oddsBadge.textContent = `${odds}% Historical Success Odds`;
      if (odds >= 75) {
        oddsBadge.className = 'text-xs font-bold px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20';
      } else if (odds >= 50) {
        oddsBadge.className = 'text-xs font-bold px-2.5 py-1 rounded-md bg-gold-500/10 text-gold-700 dark:text-gold-400 border border-gold-500/20';
      } else {
        oddsBadge.className = 'text-xs font-bold px-2.5 py-1 rounded-md bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20';
      }
    }

    // Required Rate calculation
    const reqRate = calcRequiredRealRate(
      inputs.seedCapital,
      inputs.monthlySip,
      inputs.realStepUp,
      inputs.horizonYears,
      inputs.targetRealWealth
    );

    if (reqBadge) {
      reqBadge.textContent = `+${reqRate.toFixed(1)}% / yr real required`;
    }

    if (reqExp) {
      if (reqRate <= 7.2) {
        reqExp.innerHTML = `To turn your monthly savings of <strong>₹${grp(inputs.monthlySip)}</strong> into <strong>${targetFormatted}</strong> in ${years} years requires a <strong>+${reqRate.toFixed(1)}% / yr real return</strong> above inflation. Because this is below the historical Nifty 50 typical return of <strong>+7.2% real</strong>, your target is achievable in normal market cycles.`;
      } else {
        reqExp.innerHTML = `To reach <strong>${targetFormatted}</strong> in ${years} years with ₹${grp(inputs.monthlySip)}/mo requires an aggressive <strong>+${reqRate.toFixed(1)}% / yr real return</strong> above inflation, which exceeds typical historical equity performance (+7.2% real). Consider using the levers below to bring your plan within safe bounds.`;
      }
    }

    if (outlook.reachYear !== null && outlook.reachYear < years) {
      headline.textContent = `On track to achieve ${targetFormatted} by Year ${outlook.reachYear} of ${years} (ahead of schedule).`;
      detail.innerHTML = `In <strong>${odds} out of 100</strong> market futures, your savings reach or exceed your target. On a typical market run, your terminal corpus reaches <strong>${typicalFormatted}</strong> in today's purchasing power (and <strong>${worstFormatted}</strong> in the bottom 10th percentile challenging run).`;
    } else if (outlook.healthy) {
      headline.textContent = `On track to reach ${targetFormatted} in today's purchasing power in Year ${years}.`;
      detail.innerHTML = `In <strong>${odds} out of 100</strong> market futures, your investment reaches your goal. On a typical market sequence, you finish with <strong>${typicalFormatted}</strong> in today's money.`;
    } else {
      const gap = Math.max(0, outlook.target - outlook.endReal.p50);
      headline.textContent = `Your plan typically finishes with ${typicalFormatted}, falling ${money(gap)} short of your ${targetFormatted} goal.`;
      detail.innerHTML = `In the median market future, your savings reach <strong>${typicalFormatted}</strong> in today's money, giving a <strong>${odds}% probability</strong> of hitting your full target. Use the 3 levers below to comfortably close this gap.`;
    }
  }

  function renderRemedies(inputs: any, remedies: any[]) {
    const box = $('sipAnsRemedies');
    const grid = $('sipAnsRemedyGrid');
    if (!box || !grid) return;
    grid.innerHTML = '';

    if (!remedies.length) {
      box.classList.add('hidden');
      return;
    }
    box.classList.remove('hidden');

    for (const r of remedies) {
      if (r.outOfReach) continue;
      let title = '', sub = '', apply: () => void = () => {};

      if (r.kind === 'invest_more') {
        title = `Save ₹${grp(r.delta)} more / mo`;
        sub = `₹${grp(r.value)} / month total`;
        apply = () => {
          const el = $('monthlySip') as HTMLInputElement | null;
          const slider = $('sipSlider') as HTMLInputElement | null;
          if (el) el.value = r.value.toLocaleString('en-IN');
          if (slider) slider.value = String(r.value);
        };
      } else if (r.kind === 'wait_longer') {
        title = `Extend by ${r.delta} ${r.delta === 1 ? 'Year' : 'Years'}`;
        sub = `${r.value} Years total horizon`;
        apply = () => {
          const el = $('investmentYears') as HTMLInputElement | null;
          const slider = $('yearsSlider') as HTMLInputElement | null;
          if (el) el.value = String(r.value);
          if (slider) slider.value = String(r.value);
        };
      } else {
        title = `Adjust Target to ${money(r.value)}`;
        sub = `${money(r.delta)} revision`;
        apply = () => {
          const el = $('targetRealWealth') as HTMLInputElement | null;
          const slider = $('targetSlider') as HTMLInputElement | null;
          if (el) el.value = r.value.toLocaleString('en-IN');
          if (slider) slider.value = String(r.value);
        };
      }

      const odds = Math.round(r.odds * 100);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className =
        'text-left rounded-xl border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-950 ' +
        'p-4 hover:border-gold-500 dark:hover:border-gold-500 hover:shadow-md transition-all cursor-pointer ' +
        'focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500/50';
      btn.innerHTML =
        `<span class="block text-sm font-bold text-navy-900 dark:text-navy-100">${title}</span>` +
        `<span class="block text-xs text-navy-600 dark:text-navy-400 mt-1">${sub}</span>` +
        `<div class="mt-2.5 pt-2 border-t border-navy-100 dark:border-navy-800 flex justify-between items-center text-xs">` +
        `<span class="font-semibold text-emerald-700 dark:text-emerald-400">${odds}% Success Odds</span>` +
        `<span class="font-bold text-gold-700 dark:text-gold-400">Apply →</span>` +
        `</div>`;
      btn.addEventListener('click', () => {
        apply();
        window.dispatchEvent(new CustomEvent('sip:recompute'));
      });
      grid.appendChild(btn);
    }
  }

  function recalc() {
    const inputs = readInputs();
    if (!inputs.monthlySip && !inputs.seedCapital) return;
    if (!inputs.targetRealWealth) return;

    $('sipAnsHeadline')!.textContent = 'Stress-testing 10,000 market paths…';

    worker?.postMessage(inputs);
  }

  function init() {
    worker = new Worker(new URL('../../workers/sipAdviceWorker.ts', import.meta.url), {
      type: 'module',
    });
    worker.onmessage = (e) => {
      if (!e.data?.ok) {
        $('sipAnsHeadline')!.textContent = 'Something went wrong running the simulation.';
        $('sipAnsDetail')!.textContent = 'Try adjusting one of the input values.';
        return;
      }
      const inputs = readInputs();

      if (e.data.stage === 'remedies') {
        renderRemedies(inputs, e.data.remedies);
        return;
      }
      if (e.data.stage === 'curve') {
        window.dispatchEvent(new CustomEvent('sip:curve', {
          detail: { inputs, curve: e.data.curve },
        }));
        return;
      }
      if (e.data.stage === 'sequence') {
        window.dispatchEvent(new CustomEvent('sip:sequence', {
          detail: { inputs, sequence: e.data.sequence },
        }));
        return;
      }
      if (e.data.stage === 'protection') {
        window.dispatchEvent(new CustomEvent('sip:protection', {
          detail: { inputs, protection: e.data.protection },
        }));
        return;
      }

      renderAnswer(inputs, e.data.outlook);
      window.dispatchEvent(new CustomEvent('sip:result', {
        detail: { inputs, outlook: e.data.outlook, simulation: e.data.simulation },
      }));
    };

    window.addEventListener('sip:recompute', () => recalc());
    recalc();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
