---
/**
 * The insurance analyser's welcome — dd-024.
 *
 * WHAT IT REPLACES MATTERS. The page opened on `Hero`: badge "Smart Policy
 * Reality Check", title "Guaranteed Income ROI Analyzer", and a description
 * carrying XIRR, inflation-adjusted and DIY term replication arbitrage. Four
 * pieces of the analyst's vocabulary before the reader had been told anything,
 * and then six form fields at once. F-13 flagged "TRUE YIELD (XIRR)"; the hero
 * was the same fault one section higher.
 *
 * And it announced a verdict before asking a question — "unmask" the true
 * yield. The reader arrives suspicious of the policy AND of us, often about a
 * decision already made and hard to undo, and a page that has plainly already
 * decided is a page they are right to discount. That is dd-021 as a matter of
 * tone rather than arithmetic: the tool must be as willing to say the policy is
 * good as to say it is poor, and the welcome is where it either earns that or
 * loses it.
 *
 * So: meet the reader, say what the two questions are, promise both answers are
 * printable, hand over the first question. Then get out of the way — answering
 * it collapses this and the workbench takes the space.
 *
 * Register from `antigravity.google` at Rahul's direction, the same as
 * `TaxIntro`: generous space, one confident headline, restrained motion. THE
 * REGISTER, NOT THE ORNAMENT. Nothing bounces, flashes or pulses.
 *
 * Design settled before the component in `InsuranceIntro.checks.md`.
 */
import { POLICY_SHAPES } from '../../utils/insuranceInputs';

/**
 * The brief's three outputs, in the brief's order. If the page ever stops
 * delivering one of them, this welcome is a lie the reader can check.
 */
const promises = [
  {
    title: 'What it really pays you',
    body: 'Premiums out, income back, the amount at the end — collapsed into one rate a year, after tax, so you can set it against anything else you could have done with the money.',
  },
  {
    title: 'What the same thing costs, assembled by hand',
    body: 'The same life cover, the same accident cover, the rest invested. Priced honestly: both routes are charged the same taxes and the same fees.',
  },
  {
    title: 'Which one wins, and by how much',
    body: 'Said outright, either way. Plenty of these policies are poor and some are genuinely good, and the arithmetic is allowed to say so.',
  },
];
---

<section id="insuranceIntro" class="insurance-intro" aria-label="What this analyser does">
  <div class="max-w-3xl mx-auto text-center space-y-5">
    <p class="text-sm font-semibold tracking-tight text-navy-600 dark:text-navy-400">
      Guaranteed income · money-back · endowment policies
    </p>

    <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-navy-900 dark:text-white leading-[1.1]">
      What is this policy<br class="hidden sm:inline" /> actually paying you?
    </h1>

    <p class="text-base sm:text-lg text-navy-600 dark:text-navy-300 leading-relaxed max-w-2xl mx-auto">
      A policy that also invests is two things in one wrapper — protection, and a place to put
      money. Tell us what yours promises and this prices them apart, so you can see what each
      one is really costing you.
    </p>
  </div>

  <!--
    Three promises, not a feature list. Naming how many policy shapes we handle
    or how many assumptions we model would be dd-003/dont-2 exactly — capability
    read as achievement — and it would make the reader brace for a long form
    before they had answered anything.
  -->
  <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-5 sm:gap-6">
    {promises.map((p) => (
      <div class="rounded-2xl border border-navy-200 dark:border-white/10 bg-white dark:bg-navy-900/40 p-5 space-y-2 text-left">
        <h2 class="text-base font-bold text-navy-900 dark:text-navy-100 leading-snug">{p.title}</h2>
        <p class="text-sm text-navy-600 dark:text-navy-400 leading-relaxed">{p.body}</p>
      </div>
    ))}
  </div>

  <!--
    THE WAY IN: Interactive Archetype Selector & Visual Blueprints
    Answering this collapses the welcome and reorganises the screen into the workbench.
  -->
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="text-center space-y-2">
      <h2 class="text-lg sm:text-xl font-bold text-navy-900 dark:text-navy-100">
        Choose your policy type to begin the audit
      </h2>
      <p class="text-sm text-navy-600 dark:text-navy-400 leading-relaxed max-w-xl mx-auto">
        Select what your policy promises. This filters the questions so you only answer what applies to your contract.
      </p>
    </div>

    <!-- 3-Card Visual Archetype Selector Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left">
      <button
        type="button"
        class="archetype-select-card group relative p-5 rounded-2xl border border-navy-200 dark:border-navy-700/80 bg-white dark:bg-navy-900/60 hover:border-navy-400 dark:hover:border-navy-500 hover:shadow-md transition-all text-left flex flex-col justify-between focus:outline-none focus:ring-2 focus:ring-navy-500"
        data-shape="income"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-1 text-xs font-bold rounded-md bg-blue-50 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 border border-blue-200/60 dark:border-blue-900/40">Guaranteed Income</span>
            <span class="text-xs text-navy-500 dark:text-navy-400 font-mono">10-30 Yrs</span>
          </div>
          <h3 class="text-base font-bold text-navy-900 dark:text-navy-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Regular Income, Later</h3>
          <p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed">Pay for a fixed term, then receive guaranteed annual income payouts.</p>
        </div>
        <div class="pt-3 mt-3 border-t border-navy-100 dark:border-navy-800/80">
          <span class="text-[11px] text-navy-500 dark:text-navy-400 block font-medium">Examples: HDFC Sanchay Plus, ICICI GIFT, Tata Fortune</span>
        </div>
      </button>

      <button
        type="button"
        class="archetype-select-card group relative p-5 rounded-2xl border border-navy-200 dark:border-navy-700/80 bg-white dark:bg-navy-900/60 hover:border-navy-400 dark:hover:border-navy-500 hover:shadow-md transition-all text-left flex flex-col justify-between focus:outline-none focus:ring-2 focus:ring-navy-500"
        data-shape="lumpSum"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-1 text-xs font-bold rounded-md bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-900/40">Endowment</span>
            <span class="text-xs text-navy-500 dark:text-navy-400 font-mono">Single Payout</span>
          </div>
          <h3 class="text-base font-bold text-navy-900 dark:text-navy-100 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">One Lump Sum at the End</h3>
          <p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed">Pay annual premiums for a term, then collect a single large maturity benefit.</p>
        </div>
        <div class="pt-3 mt-3 border-t border-navy-100 dark:border-navy-800/80">
          <span class="text-[11px] text-navy-500 dark:text-navy-400 block font-medium">Examples: LIC Jeevan Labh, LIC Jeevan Anand, SBI Smart</span>
        </div>
      </button>

      <button
        type="button"
        class="archetype-select-card group relative p-5 rounded-2xl border border-navy-200 dark:border-navy-700/80 bg-white dark:bg-navy-900/60 hover:border-navy-400 dark:hover:border-navy-500 hover:shadow-md transition-all text-left flex flex-col justify-between focus:outline-none focus:ring-2 focus:ring-navy-500"
        data-shape="both"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-1 text-xs font-bold rounded-md bg-amber-50 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-200/60 dark:border-amber-900/40">Hybrid / Money-Back</span>
            <span class="text-xs text-navy-500 dark:text-navy-400 font-mono">Periodic + Final</span>
          </div>
          <h3 class="text-base font-bold text-navy-900 dark:text-navy-100 group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors">Income + Final Maturity</h3>
          <p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed">Periodic survival payouts during policy life plus a final lump sum at the end.</p>
        </div>
        <div class="pt-3 mt-3 border-t border-navy-100 dark:border-navy-800/80">
          <span class="text-[11px] text-navy-500 dark:text-navy-400 block font-medium">Examples: LIC 20-Yr Money Back, Max Life Guaranteed</span>
        </div>
      </button>
    </div>

    <!-- Underlying Select for full screenreader / keyboard accessibility -->
    <div class="max-w-md mx-auto space-y-2 pt-2">
      <label for="inPolicyShape" class="block text-center text-xs font-semibold text-navy-600 dark:text-navy-400">
        Or select from the list
      </label>
      <select
        id="inPolicyShape"
        class="w-full bg-white dark:bg-navy-900 border border-navy-300 dark:border-navy-700 rounded-xl px-4 py-3 text-sm font-medium text-navy-900 dark:text-navy-100 shadow-xs focus:outline-none focus:ring-2 focus:ring-navy-500"
      >
        <option value="">Choose one to begin</option>
        {POLICY_SHAPES.map((s) => <option value={s.id}>{s.label}</option>)}
      </select>
    </div>
  </div>
</section>

<style>
  /*
    The welcome, and the one transition on the page. Space is the design here
    rather than decoration — dd-024's whole complaint is that a lone control in
    a field of white reads as unfinished.
  */
  .insurance-intro {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding: 1rem 0 2rem;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  /*
    Collapsing to nothing rather than merely fading: a welcome that stays in the
    flow becomes furniture the reader scrolls past on every recompute.
  */
  .insurance-intro[data-collapsed='true'] {
    display: none;
  }

  .insurance-intro[data-leaving='true'] {
    opacity: 0;
    transform: translateY(-0.75rem);
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .insurance-intro {
      gap: 3.5rem;
      padding: 2rem 0 3rem;
    }
  }

  /*
    Motion follows the reader; it never performs at them. Somebody who has asked
    their system for less of it gets the state change with no movement at all.
  */
  @media (prefers-reduced-motion: reduce) {
    .insurance-intro {
      transition: none;
    }
  }
</style>
