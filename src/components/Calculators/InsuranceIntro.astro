---
/**
 * The insurance analyser's welcome — dd-024.
 *
 * WHAT IT REPLACES MATTERS. The page opened on `Hero`: badge "Smart Policy
 * Reality Check", title "Guaranteed Income ROI Analyzer", and a description
 * carrying XIRR, inflation-adjusted and DIY term replication arbitrage. Four
 * pieces of the analyst's vocabulary before the reader had been told anything,
 * and then six form fields at once. F-13 flagged "TRUE YIELD (XIRR)"; the hero
 * was the same fault one section higher.
 *
 * And it announced a verdict before asking a question — "unmask" the true
 * yield. The reader arrives suspicious of the policy AND of us, often about a
 * decision already made and hard to undo, and a page that has plainly already
 * decided is a page they are right to discount. That is dd-021 as a matter of
 * tone rather than arithmetic: the tool must be as willing to say the policy is
 * good as to say it is poor, and the welcome is where it either earns that or
 * loses it.
 *
 * So: meet the reader, say what the two questions are, promise both answers are
 * printable, hand over the first question. Then get out of the way — answering
 * it collapses this and the workbench takes the space.
 *
 * Register from `antigravity.google` at Rahul's direction, the same as
 * `TaxIntro`: generous space, one confident headline, restrained motion. THE
 * REGISTER, NOT THE ORNAMENT. Nothing bounces, flashes or pulses.
 *
 * Design settled before the component in `InsuranceIntro.checks.md`.
 */
import { POLICY_SHAPES } from '../../utils/insuranceInputs';
import uniquePolicies from '../../data/unique_policies.json';

---

<section id="insuranceIntro" class="insurance-intro" aria-label="What this analyser does">
  <div class="space-y-4">
    <p class="text-sm font-semibold tracking-tight text-navy-600 dark:text-navy-400">
      Guaranteed income · money-back · endowment policies
    </p>

    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-navy-900 dark:text-white leading-[1.1]">
      What is this policy<br class="hidden sm:inline" /> actually paying you?
    </h1>

    <p class="text-base text-navy-600 dark:text-navy-300 leading-relaxed">
      A policy that also invests is two things in one wrapper — protection, and a place to put
      money. Tell us what yours promises and this prices them apart, so you can see what each
      one is really costing you.
    </p>

  </div>

  <!-- PRE-FILL / PRESET LOADER -->
  <div class="space-y-6 pt-4 border-t border-navy-200 dark:border-navy-800">
    <div class="space-y-3">
      <label for="presetPolicy" class="block text-base font-bold text-navy-900 dark:text-navy-100">
        Have an illustration? Select it here:
      </label>
      <select
        id="presetPolicy"
        class="w-full bg-white dark:bg-navy-900 border border-navy-300 dark:border-navy-700 rounded-xl px-4 py-3 text-base font-medium text-navy-900 dark:text-navy-100 shadow-sm focus:outline-none focus:ring-2 focus:ring-gold-500"
      >
        <option value="">Choose a popular policy...</option>
        {uniquePolicies.map(p => <option value={p.id}>{p.label}</option>)}
      </select>
    </div>
    
    <div id="presetAgeWrap" class="space-y-3 hidden">
      <label for="presetAge" class="block text-sm font-bold text-navy-900 dark:text-navy-100">
        Your Age
      </label>
      <div class="flex gap-3">
        <input 
          id="presetAge" 
          type="number" 
          min="18" 
          max="65" 
          value="30"
          class="flex-1 bg-white dark:bg-navy-900 border border-navy-300 dark:border-navy-700 rounded-xl px-4 py-3 text-base font-medium text-navy-900 dark:text-navy-100 shadow-sm focus:outline-none focus:ring-2 focus:ring-gold-500 text-center" 
        />
        <button id="btnLoadPreset" class="px-6 py-3 bg-navy-900 dark:bg-white text-white dark:text-navy-900 font-bold rounded-xl shadow-sm hover:opacity-90 transition-opacity">
          Load
        </button>
      </div>
      <p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed">
        We'll load the typical payouts for this age. You can edit the exact numbers on the next screen.
      </p>
    </div>
  </div>

  <div id="policySummaryWrap" hidden class="space-y-6 pt-6 border-t border-navy-200 dark:border-navy-800">
    <p id="policySummary" class="text-base text-navy-800 dark:text-navy-200 leading-relaxed font-medium bg-navy-50 dark:bg-navy-900/50 p-4 rounded-xl border border-navy-100 dark:border-navy-800"></p>
    
    <div id="cashflowSection" class="rounded-2xl border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 p-5 sm:p-6 space-y-4">
      <div class="space-y-1">
        <div class="flex items-start justify-between gap-4">
          <h3 class="text-base font-bold text-navy-900 dark:text-navy-100">The shape of it, year by year</h3>
          <div class="flex items-center gap-2 bg-navy-50 dark:bg-navy-900 rounded-lg p-1 border border-navy-200 dark:border-navy-700">
            <button id="toggleNominal" class="px-2 py-1 text-xs font-bold rounded-md bg-white dark:bg-navy-800 text-navy-900 dark:text-white shadow-sm transition-colors">Nominal</button>
            <button id="toggleReal" class="px-2 py-1 text-xs font-bold rounded-md text-navy-500 hover:text-navy-900 dark:hover:text-white transition-colors">Real</button>
          </div>
        </div>
        <p class="text-sm text-navy-600 dark:text-navy-400 leading-relaxed">
          Money out, then money back. <strong class="text-navy-700 dark:text-navy-300">Tap any bar</strong> to see exactly where each rupee goes.
        </p>
      </div>
      <div class="relative w-full h-[250px]">
        <canvas id="cashflowChart" class="w-full h-full"></canvas>
      </div>
      <div id="chartBreakdown" class="hidden mt-4 p-4 rounded-xl bg-slate-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-700 transition-all">
        <div class="flex justify-between items-center mb-3">
          <h4 id="breakdownTitle" class="text-sm font-bold text-navy-900 dark:text-navy-100">Year X Breakdown</h4>
          <button id="closeBreakdown" class="text-navy-400 hover:text-navy-600 dark:hover:text-white">&times;</button>
        </div>
        <div id="breakdownContent" class="grid grid-cols-2 gap-4 text-sm">
        </div>
      </div>
    </div>
  </div>


  
</section>

<script>
  import uniquePolicies from '../../data/unique_policies.json';
  
  document.addEventListener('DOMContentLoaded', () => {
    const presetPolicy = document.getElementById('presetPolicy') as HTMLSelectElement;
    const presetAgeWrap = document.getElementById('presetAgeWrap');
    const presetAge = document.getElementById('presetAge') as HTMLInputElement;
    const btnLoadPreset = document.getElementById('btnLoadPreset');
    
    if (presetPolicy && presetAgeWrap) {
      presetPolicy.addEventListener('change', () => {
        if (presetPolicy.value) {
          presetAgeWrap.classList.remove('hidden');
        } else {
          presetAgeWrap.classList.add('hidden');
        }
      });
    }
    
    if (btnLoadPreset) {
      btnLoadPreset.addEventListener('click', () => {
        const originalText = btnLoadPreset.innerText;
        btnLoadPreset.innerText = "Loading...";
        btnLoadPreset.disabled = true;
        const policyId = presetPolicy.value;
        const age = parseInt(presetAge.value) || 30;
        const policy = uniquePolicies.find(p => p.id === policyId);
        
        if (policy) {
          // Calculate interpolated multipliers
          // Using 30 and 50 as bounds
          let incMult = policy.age30Inc;
          let matMult = policy.age30Mat;
          
          if (age > 30 && age < 50) {
            const fraction = (age - 30) / 20;
            incMult = policy.age30Inc + fraction * (policy.age50Inc - policy.age30Inc);
            matMult = policy.age30Mat + fraction * (policy.age50Mat - policy.age30Mat);
          } else if (age >= 50) {
            incMult = policy.age50Inc;
            matMult = policy.age50Mat;
          }
          
          // Default premium to 1 Lakh for easy viewing
          const basePremium = 100000;
          const payout = Math.round(basePremium * incMult);
          const maturity = Math.round(basePremium * matMult);
          
          // Set the shape to trigger the form appearance (this triggers the change event)
          const shapeSelect = document.getElementById('inPolicyShapeRestate') as HTMLSelectElement;
          if (shapeSelect) {
            shapeSelect.value = policy.shape;
            shapeSelect.dispatchEvent(new Event('change'));
            
            // Now populate the form fields
            setTimeout(() => {
              const setVal = (id: string, val: number | string) => {
                const el = document.getElementById(id) as HTMLInputElement;
                if (el && val !== undefined) {
                  el.value = val.toString();
                  // Dispatch input event to trigger any formatters/listeners
                  el.dispatchEvent(new Event('input', { bubbles: true }));
                }
              };
              
              setVal('inPremium', basePremium);
              setVal('inPPT', policy.ppt);
              setVal('inTermCover', basePremium * 10);
              
              if (policy.shape === 'income' || policy.shape === 'both') {
                setVal('inPayoutStart', policy.incomeStart);
                setVal('inPayoutYears', policy.incomeEnd - policy.incomeStart + 1);
                setVal('inPayout', payout);
              }
              
              if (policy.shape === 'maturity' || policy.shape === 'both') {
                setVal('inMaturity', maturity);
              }
			  
			  const manualFormDetails = document.getElementById('manualFormDetails');
			  if (manualFormDetails) {
				manualFormDetails.removeAttribute('open');
			  }
			  // Revert button
			  btnLoadPreset.innerText = originalText;
			  btnLoadPreset.disabled = false;
			}, 50); // Small delay to let the form render
          }
        }
      });
    }
  });
</script>

<style>
  /*
    The welcome is now part of the flow on the left column. Space is the design here
    rather than decoration.
  */
  .insurance-intro {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .insurance-intro {
      gap: 3.5rem;
    }
  }
</style>
