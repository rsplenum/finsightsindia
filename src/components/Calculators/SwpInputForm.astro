---
// SwpInputForm.astro — Reimagined Intuitive Input Deck
// Human-centric 3-card layout with live sliders, quick chips, and collapsible assumptions.
import CardPremium from '../CardPremium.astro';
import { REGIME_PRESETS, DEFAULT_REGIME } from '../../utils/regimePresets';
---

<div class="space-y-6">
  <!-- Core 4 Inputs Grid using fractional unit system (1 col mobile, 2 col desktop) -->
  <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr] gap-4 sm:gap-6 transition-all duration-300 ease-in-out" style="transition: all 0.3s ease-in-out;">
    
    <!-- Card 1: Retirement Corpus -->
    <CardPremium glass={true} class="p-4 sm:p-5 flex flex-col space-y-3.5 hover:border-gold-500/40 transition-colors">
      <div>
        <div class="flex items-center justify-between">
          <label for="initialCorpus" class="text-xs font-bold text-navy-800 dark:text-navy-200">
            Retirement Corpus
          </label>
          <span id="corpusFormatted" class="text-xs font-semibold px-2 py-0.5 rounded bg-gold-50 dark:bg-gold-950/40 text-gold-800 dark:text-gold-300 border border-gold-200/60 dark:border-gold-800/60">
            ₹ 1.50 Crore
          </span>
        </div>
        <div class="mt-2 relative rounded-lg border border-navy-200 dark:border-navy-800 focus-within:border-gold-500 dark:focus-within:border-gold-500 bg-white dark:bg-navy-950 transition-colors">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-navy-400 font-semibold text-sm">₹</span>
          <input
            id="initialCorpus"
            type="text"
            inputmode="numeric"
            value="1,50,00,000"
            class="w-full pl-7 pr-3 py-2 text-base sm:text-lg font-bold tabular-nums text-navy-950 dark:text-white bg-transparent focus:outline-none"
          />
        </div>
        <input
          id="corpusSlider"
          type="range"
          min="2500000"
          max="100000000"
          step="500000"
          value="15000000"
          class="w-full mt-2.5 accent-gold-600 dark:accent-gold-500 cursor-pointer"
        />
      </div>

      <!-- Quick Preset Selection Pills (Uniform, Compact & Aligned) -->
      <div class="grid grid-cols-5 gap-1.5 sm:gap-2 pt-2.5 border-t border-navy-100/80 dark:border-navy-900/80">
        <button type="button" data-set-corpus="5000000" class="corpus-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">₹50 L</button>
        <button type="button" data-set-corpus="10000000" class="corpus-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">₹1 Cr</button>
        <button type="button" data-set-corpus="15000000" class="corpus-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-gold-500 bg-gold-50/50 dark:bg-gold-950/30 text-gold-700 dark:text-gold-300 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">₹1.5 Cr</button>
        <button type="button" data-set-corpus="25000000" class="corpus-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">₹2.5 Cr</button>
        <button type="button" data-set-corpus="50000000" class="corpus-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">₹5 Cr</button>
      </div>
    </CardPremium>

    <!-- Card 2: Monthly Income -->
    <CardPremium glass={true} class="p-4 sm:p-5 flex flex-col space-y-3.5 hover:border-gold-500/40 transition-colors">
      <div>
        <div class="flex items-center justify-between">
          <label for="monthlyWithdrawal" class="text-xs font-bold text-navy-800 dark:text-navy-200">
            Monthly Paycheck (Today's Value)
          </label>
          <span id="withdrawalFormatted" class="text-xs font-semibold px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">
            ₹ 40,000 / mo
          </span>
        </div>
        <div class="mt-2 relative rounded-lg border border-navy-200 dark:border-navy-800 focus-within:border-gold-500 dark:focus-within:border-gold-500 bg-white dark:bg-navy-950 transition-colors">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-navy-400 font-semibold text-sm">₹</span>
          <input
            id="monthlyWithdrawal"
            type="text"
            inputmode="numeric"
            value="40,000"
            class="w-full pl-7 pr-12 py-2 text-base sm:text-lg font-bold tabular-nums text-navy-950 dark:text-white bg-transparent focus:outline-none"
          />
          <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-xs text-navy-400">/ mo</span>
        </div>
        <input
          id="withdrawalSlider"
          type="range"
          min="10000"
          max="300000"
          step="5000"
          value="40000"
          class="w-full mt-2.5 accent-gold-600 dark:accent-gold-500 cursor-pointer"
        />
      </div>

      <!-- Quick Preset Selection Pills (Uniform, Compact & Aligned) -->
      <div class="grid grid-cols-5 gap-1.5 sm:gap-2 pt-2.5 border-t border-navy-100/80 dark:border-navy-900/80">
        <button type="button" data-set-withdrawal="25000" class="withdrawal-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">₹25k</button>
        <button type="button" data-set-withdrawal="40000" class="withdrawal-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-gold-500 bg-gold-50/50 dark:bg-gold-950/30 text-gold-700 dark:text-gold-300 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">₹40k</button>
        <button type="button" data-set-withdrawal="60000" class="withdrawal-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">₹60k</button>
        <button type="button" data-set-withdrawal="100000" class="withdrawal-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">₹1 Lakh</button>
        <button type="button" data-set-withdrawal="150000" class="withdrawal-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">₹1.5 L</button>
      </div>
    </CardPremium>

    <!-- Card 3: Duration / Horizon -->
    <CardPremium glass={true} class="p-4 sm:p-5 flex flex-col space-y-3.5 hover:border-gold-500/40 transition-colors">
      <div>
        <div class="flex items-center justify-between">
          <label for="horizonYears" class="text-xs font-bold text-navy-800 dark:text-navy-200">
            Retirement Horizon
          </label>
          <span id="yearsFormatted" class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60">
            30 Years
          </span>
        </div>
        <div class="mt-2 relative rounded-lg border border-navy-200 dark:border-navy-800 focus-within:border-gold-500 dark:focus-within:border-gold-500 bg-white dark:bg-navy-950 transition-colors">
          <input
            id="horizonYears"
            type="number"
            min="5"
            max="60"
            step="1"
            value="30"
            class="w-full px-3 py-2 text-base sm:text-lg font-bold tabular-nums text-navy-950 dark:text-white bg-transparent focus:outline-none"
          />
          <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-xs text-navy-400">Years</span>
        </div>
        <input
          id="yearsSlider"
          type="range"
          min="10"
          max="50"
          step="1"
          value="30"
          class="w-full mt-2.5 accent-gold-600 dark:accent-gold-500 cursor-pointer"
        />
      </div>

      <!-- Quick Preset Selection Pills (Uniform, Compact & Aligned) -->
      <div class="grid grid-cols-5 gap-1.5 sm:gap-2 pt-2.5 border-t border-navy-100/80 dark:border-navy-900/80">
        <button type="button" data-set-years="20" class="years-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">20 Yrs</button>
        <button type="button" data-set-years="25" class="years-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">25 Yrs</button>
        <button type="button" data-set-years="30" class="years-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-gold-500 bg-gold-50/50 dark:bg-gold-950/30 text-gold-700 dark:text-gold-300 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">30 Yrs</button>
        <button type="button" data-set-years="35" class="years-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">35 Yrs</button>
        <button type="button" data-set-years="40" class="years-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">40 Yrs</button>
      </div>
    </CardPremium>

    <!-- Card 4: Lifestyle Step-Up -->
    <CardPremium glass={true} class="p-4 sm:p-5 flex flex-col space-y-3.5 hover:border-gold-500/40 transition-colors">
      <div>
        <div class="flex items-center justify-between">
          <label for="stepUp" class="text-xs font-bold text-navy-800 dark:text-navy-200">
            Lifestyle Step-Up (Above Inflation)
          </label>
          <span id="stepUpFormatted" class="text-xs font-semibold px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/40 text-purple-800 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800/60">
            +0.0% / yr
          </span>
        </div>
        <div class="mt-2 relative rounded-lg border border-navy-200 dark:border-navy-800 focus-within:border-gold-500 dark:focus-within:border-gold-500 bg-white dark:bg-navy-950 transition-colors">
          <input
            id="stepUp"
            type="number"
            value="0.0"
            step="0.5"
            min="0"
            max="10"
            class="w-full px-3 py-2 text-base sm:text-lg font-bold tabular-nums text-navy-950 dark:text-white bg-transparent focus:outline-none"
          />
          <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-xs text-navy-400">% / yr</span>
        </div>
        <input
          id="stepUpSlider"
          type="range"
          min="0"
          max="5"
          step="0.5"
          value="0"
          class="w-full mt-2.5 accent-gold-600 dark:accent-gold-500 cursor-pointer"
        />
      </div>

      <!-- Quick Preset Selection Pills (Uniform, Compact & Aligned) -->
      <div class="grid grid-cols-4 gap-1.5 sm:gap-2 pt-2.5 border-t border-navy-100/80 dark:border-navy-900/80">
        <button type="button" data-set-stepup="0" class="stepup-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-gold-500 bg-gold-50/50 dark:bg-gold-950/30 text-gold-700 dark:text-gold-300 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">0%</button>
        <button type="button" data-set-stepup="1" class="stepup-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">+1% / yr</button>
        <button type="button" data-set-stepup="2" class="stepup-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">+2% / yr</button>
        <button type="button" data-set-stepup="3" class="stepup-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full">+3% / yr</button>
      </div>
    </CardPremium>

  </div>

  <!-- Sanity Warning Notice (if applicable) -->
  <div id="inputSanityWarning" class="hidden p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs leading-relaxed space-y-1">
    <div class="flex items-center gap-2 font-bold">
      <svg class="w-4 h-4 shrink-0 text-amber-700 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <span>Retirement Plan Note</span>
    </div>
    <p id="inputSanityMessage"></p>
  </div>

  <!-- Assumptions & Protections Drawer (Sol-019 Layer 3) -->
  <details id="assumptionsDrawer" class="group rounded-2xl border border-navy-200 dark:border-navy-800 bg-white/70 dark:bg-navy-950/70 backdrop-blur-sm shadow-xs overflow-hidden transition-all">
    <summary class="cursor-pointer list-none flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-5 py-4 hover:bg-navy-50/70 dark:hover:bg-navy-900/60 transition-colors">
      <div class="flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-navy-100 dark:bg-navy-900 flex items-center justify-center text-navy-700 dark:text-navy-300 shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
        </span>
        <div>
          <span class="text-sm font-bold text-navy-900 dark:text-navy-100 block">
            Market Assumptions & Protections
          </span>
          <span id="assumptionsSummaryText" class="text-xs text-navy-500 dark:text-navy-400">
            Nifty 50 Historical (13.3% CAGR, 15% Volatility) · 6.0% Inflation · 12.5% LTCG Tax
          </span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-end sm:self-center">
        <span class="text-xs font-semibold text-gold-700 dark:text-gold-400 group-open:hidden">Customize</span>
        <span class="text-xs font-semibold text-gold-700 dark:text-gold-400 hidden group-open:inline">Hide</span>
        <svg class="w-4 h-4 text-navy-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </summary>

    <!-- Expanded Drawer Content -->
    <div class="p-5 sm:p-6 border-t border-navy-200/80 dark:border-navy-800/80 space-y-6 bg-navy-50/40 dark:bg-navy-950/40">
      
      <!-- Regime Selector -->
      <div class="space-y-3">
        <label class="text-xs font-bold text-navy-800 dark:text-navy-200">
          Historical Market Regimes (Nifty 50)
        </label>
        <div role="radiogroup" aria-label="Select market regime" class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          {REGIME_PRESETS.map((p) => (
            <button
              type="button"
              data-regime={p.id}
              data-growth={String(p.growth)}
              data-roughness={String(p.roughness)}
              class="regime-btn p-3 rounded-xl border text-left transition-all border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 text-navy-800 dark:text-navy-200 hover:border-gold-500/60"
            >
              <span class="block text-xs font-bold text-navy-900 dark:text-white">{p.label}</span>
              <span class="block text-xs text-navy-500 dark:text-navy-400 mt-0.5 tabular-nums">{p.growth}% CAGR · {p.roughness}% σ swings</span>
            </button>
          ))}
        </div>
        <p id="regimeNote" class="text-xs text-navy-500 dark:text-navy-400"></p>
      </div>

      <!-- Fine-tuning Parameters Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        
        <div class="space-y-1">
          <label for="expectedReturn" class="text-xs font-semibold text-navy-700 dark:text-navy-300">Expected CAGR</label>
          <div class="relative rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950">
            <input id="expectedReturn" type="number" step="0.5" value={DEFAULT_REGIME.growth.toFixed(1)} class="w-full px-3 py-1.5 text-xs font-bold tabular-nums text-navy-900 dark:text-white bg-transparent focus:outline-none" />
            <span class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-xs text-navy-400">%</span>
          </div>
        </div>

        <div class="space-y-1">
          <label for="annualVolatility" class="text-xs font-semibold text-navy-700 dark:text-navy-300">Volatility (σ)</label>
          <div class="relative rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950">
            <input id="annualVolatility" type="number" step="0.5" value={DEFAULT_REGIME.roughness.toFixed(1)} class="w-full px-3 py-1.5 text-xs font-bold tabular-nums text-navy-900 dark:text-white bg-transparent focus:outline-none" />
            <span class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-xs text-navy-400">%</span>
          </div>
        </div>

        <div class="space-y-1">
          <label for="expectedInflation" class="text-xs font-semibold text-navy-700 dark:text-navy-300">CPI Inflation</label>
          <div class="relative rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950">
            <input id="expectedInflation" type="number" step="0.5" value="6.0" class="w-full px-3 py-1.5 text-xs font-bold tabular-nums text-navy-900 dark:text-white bg-transparent focus:outline-none" />
            <span class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-xs text-navy-400">%</span>
          </div>
        </div>

        <div class="space-y-1">
          <label for="ltcgTax" class="text-xs font-semibold text-navy-700 dark:text-navy-300">LTCG Tax Rate</label>
          <div class="relative rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950">
            <input id="ltcgTax" type="number" step="0.1" value="12.5" class="w-full px-3 py-1.5 text-xs font-bold tabular-nums text-navy-900 dark:text-white bg-transparent focus:outline-none" />
            <span class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-xs text-navy-400">%</span>
          </div>
        </div>

      </div>

      <!-- Advanced Protections Strip -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        
        <!-- Guardrail Rules -->
        <label for="useGuardrails" class="p-4 rounded-xl border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 flex items-start justify-between gap-4 cursor-pointer min-h-[52px]">
          <div class="space-y-1">
            <span class="text-xs sm:text-sm font-bold text-navy-900 dark:text-white block">Dynamic Spending Guardrails</span>
            <p class="text-xs text-navy-500 dark:text-navy-400 leading-snug">
              Trim monthly withdrawals by 10% during adverse market drawdowns to preserve portfolio life.
            </p>
            <div class="pt-1">
              <a href="#dynamicGuardrailsExplanation" class="text-xs font-semibold text-gold-700 dark:text-gold-400 hover:underline underline-offset-2">Learn more</a>
            </div>
          </div>
          <div class="flex items-center justify-center min-w-[44px] min-h-[44px] shrink-0">
            <input
              type="checkbox"
              id="useGuardrails"
              name="useGuardrails"
              class="w-5 h-5 rounded text-gold-700 focus:ring-gold-500 border-navy-300 dark:border-navy-700 bg-white dark:bg-navy-900 cursor-pointer"
            />
          </div>
        </label>

        <!-- Downside Put Floor Protection -->
        <div class="p-4 rounded-xl border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 flex flex-col gap-3 min-h-[52px]">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1">
              <span class="text-xs sm:text-sm font-bold text-navy-900 dark:text-white block">Downside Put Floor Hedge</span>
