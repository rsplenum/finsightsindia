---
/**
 * Progressive input form for the reimagined SWP planner — dd-022, dd-023.
 *
 * Starts with the 3 core inputs (Corpus, Monthly Income, Horizon), with clean
 * progressive accordions for Inflation & Step-up, Market Regimes, Taxes, and Downside Put Protection.
 *
 * Design settled before the component in `SwpInputForm.checks.md`.
 */
import CardPremium from '../CardPremium.astro';
---

<div class="space-y-6">
  <CardPremium class="p-5 sm:p-6 space-y-6">
    <div class="flex items-center justify-between pb-3 border-b border-navy-100 dark:border-white/10">
      <div>
        <h3 class="text-base sm:text-lg font-bold text-navy-900 dark:text-navy-100">
          Your Retirement Levers
        </h3>
        <p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">
          Adjust your savings, withdrawal amount, and assumptions.
        </p>
      </div>
      <span class="text-xs font-semibold px-2.5 py-1 rounded bg-gold-500/10 text-gold-700 dark:text-gold-400 border border-gold-500/20">
        Live Model
      </span>
    </div>

    <!-- Sanity Warning Container -->
    <div id="inputSanityWarning" class="hidden p-3.5 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 rounded-xl text-xs text-rose-800 dark:text-rose-200">
      <div class="flex items-start gap-2.5">
        <svg class="w-4 h-4 text-rose-700 dark:text-rose-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div id="inputSanityMessage" class="leading-relaxed"></div>
      </div>
    </div>

    <!-- Form container -->
    <form id="swpForm" class="space-y-5" onsubmit="return false;">
      
      <!-- CORE INPUT 1: Initial Savings Corpus -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="initialCorpus" class="text-xs sm:text-sm font-bold text-navy-800 dark:text-navy-200">
            Initial Retirement Corpus
          </label>
          <span id="corpusFormatted" class="text-xs font-semibold text-gold-700 dark:text-gold-400">
            ₹ 1.50 Crore
          </span>
        </div>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-bold text-navy-500 dark:text-navy-400">₹</span>
          <input
            id="initialCorpus"
            type="text"
            inputmode="numeric"
            value="1,50,00,000"
            class="w-full bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-xl pl-8 pr-3 py-2.5 text-sm sm:text-base font-semibold tabular-nums text-navy-900 dark:text-white shadow-2xs focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-gold-500 transition-all"
          />
        </div>
      </div>

      <!-- CORE INPUT 2: Monthly Withdrawal -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="monthlyWithdrawal" class="text-xs sm:text-sm font-bold text-navy-800 dark:text-navy-200">
            Monthly Paycheck (Today's Value)
          </label>
          <span id="withdrawalFormatted" class="text-xs font-semibold text-gold-700 dark:text-gold-400">
            ₹ 40,000 / month
          </span>
        </div>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm font-bold text-navy-500 dark:text-navy-400">₹</span>
          <input
            id="monthlyWithdrawal"
            type="text"
            inputmode="numeric"
            value="40,000"
            class="w-full bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-xl pl-8 pr-3 py-2.5 text-sm sm:text-base font-semibold tabular-nums text-navy-900 dark:text-white shadow-2xs focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-gold-500 transition-all"
          />
        </div>
        <p class="text-xs text-navy-500 dark:text-navy-400 leading-tight">
          Will automatically escalate every year to maintain constant purchasing power.
        </p>
      </div>

      <!-- CORE INPUT 3: Horizon Years -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="horizonYears" class="text-xs sm:text-sm font-bold text-navy-800 dark:text-navy-200">
            Retirement Horizon (Years)
          </label>
          <span class="text-xs font-medium text-navy-500 dark:text-navy-400">
            Typical: 25 - 35 Years
          </span>
        </div>
        <input
          id="horizonYears"
          type="number"
          min="5"
          max="50"
          value="30"
          class="w-full bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-xl px-3.5 py-2.5 text-sm sm:text-base font-semibold tabular-nums text-navy-900 dark:text-white shadow-2xs focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-gold-500 transition-all"
        />
      </div>

      <!-- PROGRESSIVE ACCORDION 1: Inflation & Step-Up -->
      <details class="group rounded-xl border border-navy-200 dark:border-white/10 bg-navy-50/50 dark:bg-navy-900/40 overflow-hidden">
        <summary class="flex items-center justify-between p-3.5 cursor-pointer font-bold text-xs sm:text-sm text-navy-800 dark:text-navy-200 select-none hover:bg-navy-100/50 dark:hover:bg-navy-800/40 transition-colors">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-700 dark:text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            Inflation & Step-Up Adjustments
          </span>
          <svg class="w-4 h-4 text-navy-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="p-3.5 pt-1 space-y-4 border-t border-navy-200/60 dark:border-white/5">
          <div class="space-y-1">
            <div class="flex justify-between text-xs">
              <label for="expectedInflation" class="font-medium text-navy-700 dark:text-navy-300">Expected Annual Inflation</label>
              <span class="font-bold text-navy-900 dark:text-navy-100">6.0%</span>
            </div>
            <div class="relative">
              <input
                id="expectedInflation"
                type="number"
                step="0.1"
                min="0"
                max="15"
                value="6.0"
                class="w-full bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-lg px-3 py-2 text-sm tabular-nums text-navy-900 dark:text-white"
              />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-navy-400">%</span>
            </div>
          </div>

          <div class="space-y-1">
            <div class="flex justify-between text-xs">
              <label for="stepUp" class="font-medium text-navy-700 dark:text-navy-300">Real Lifestyle Step-Up (Beyond Inflation)</label>
              <span class="font-bold text-navy-900 dark:text-navy-100">0.0%</span>
            </div>
            <div class="relative">
              <input
                id="stepUp"
                type="number"
                step="0.5"
                min="0"
                max="10"
                value="0.0"
                class="w-full bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-lg px-3 py-2 text-sm tabular-nums text-navy-900 dark:text-white"
              />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-navy-400">%</span>
            </div>
            <p class="text-xs text-navy-500 dark:text-navy-400 leading-tight">
              0% means your paycheck rises exactly with inflation to keep purchasing power constant.
            </p>
          </div>
        </div>
      </details>

      <!-- PROGRESSIVE ACCORDION 2: Market Regimes & Historical Returns -->
      <details class="group rounded-xl border border-navy-200 dark:border-white/10 bg-navy-50/50 dark:bg-navy-900/40 overflow-hidden">
        <summary class="flex items-center justify-between p-3.5 cursor-pointer font-bold text-xs sm:text-sm text-navy-800 dark:text-navy-200 select-none hover:bg-navy-100/50 dark:hover:bg-navy-800/40 transition-colors">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-700 dark:text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            Market Regime & Returns
          </span>
          <svg class="w-4 h-4 text-navy-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="p-3.5 pt-1 space-y-3.5 border-t border-navy-200/60 dark:border-white/5">
          <div class="space-y-1.5">
            <label class="text-xs font-semibold text-navy-700 dark:text-navy-300">
              Nifty 50 Historical Eras
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <button
                type="button"
                class="regime-btn px-2.5 py-2 rounded-lg border text-xs font-semibold text-left transition-colors border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-950 text-navy-800 dark:text-navy-200"
                data-growth="12.0"
                data-roughness="15.0"
              >
                <span class="block font-bold">2014–2024</span>
                <span class="text-xs text-navy-500 dark:text-navy-400">12% / 15% Vol</span>
              </button>
              <button
                type="button"
                class="regime-btn px-2.5 py-2 rounded-lg border text-xs font-semibold text-left transition-colors border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-950 text-navy-800 dark:text-navy-200"
                data-growth="14.5"
                data-roughness="22.0"
              >
                <span class="block font-bold">2004–2024</span>
                <span class="text-xs text-navy-500 dark:text-navy-400">14.5% / 22% Vol</span>
              </button>
              <button
                type="button"
                class="regime-btn px-2.5 py-2 rounded-lg border text-xs font-semibold text-left transition-colors border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-950 text-navy-800 dark:text-navy-200"
                data-growth="13.5"
                data-roughness="28.0"
              >
                <span class="block font-bold">1994–2024</span>
                <span class="text-xs text-navy-500 dark:text-navy-400">13.5% / 28% Vol</span>
              </button>
            </div>
            <p id="regimeNote" class="text-xs text-navy-500 dark:text-navy-400 italic"></p>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div class="space-y-1">
              <label for="expectedReturn" class="text-xs font-medium text-navy-700 dark:text-navy-300">Expected CAGR</label>
              <div class="relative">
                <input
                  id="expectedReturn"
                  type="number"
                  step="0.5"
                  min="4"
                  max="25"
                  value="12.0"
                  class="w-full bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-lg px-3 py-2 text-sm tabular-nums text-navy-900 dark:text-white"
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-navy-400">%</span>
              </div>
            </div>

            <div class="space-y-1">
              <label for="annualVolatility" class="text-xs font-medium text-navy-700 dark:text-navy-300">Annual Volatility</label>
              <div class="relative">
                <input
                  id="annualVolatility"
                  type="number"
                  step="0.5"
                  min="2"
                  max="40"
                  value="15.0"
                  class="w-full bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-lg px-3 py-2 text-sm tabular-nums text-navy-900 dark:text-white"
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-navy-400">%</span>
              </div>
            </div>
          </div>
        </div>
      </details>

      <!-- PROGRESSIVE ACCORDION 3: LTCG Taxes -->
      <details class="group rounded-xl border border-navy-200 dark:border-white/10 bg-navy-50/50 dark:bg-navy-900/40 overflow-hidden">
        <summary class="flex items-center justify-between p-3.5 cursor-pointer font-bold text-xs sm:text-sm text-navy-800 dark:text-navy-200 select-none hover:bg-navy-100/50 dark:hover:bg-navy-800/40 transition-colors">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-700 dark:text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
            </svg>
            Taxes on Growth (LTCG)
          </span>
          <svg class="w-4 h-4 text-navy-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="p-3.5 pt-1 space-y-3 border-t border-navy-200/60 dark:border-white/5">
          <div class="space-y-1">
            <div class="flex justify-between text-xs">
              <label for="ltcgTax" class="font-medium text-navy-700 dark:text-navy-300">Equity LTCG Tax Rate</label>
              <span class="font-bold text-navy-900 dark:text-navy-100">12.5%</span>
            </div>
            <div class="relative">
              <input
                id="ltcgTax"
                type="number"
                step="0.5"
                min="0"
                max="30"
                value="12.5"
                class="w-full bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-lg px-3 py-2 text-sm tabular-nums text-navy-900 dark:text-white"
              />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-navy-400">%</span>
            </div>
            <p class="text-xs text-navy-500 dark:text-navy-400 leading-tight">
              Section 112A: 12.5% tax on equity capital gains above ₹1.25 Lakh/year.
            </p>
          </div>
        </div>
      </details>

      <!-- PROGRESSIVE ACCORDION 4: Put Option Downside Protection -->
      <details class="group rounded-xl border border-navy-200 dark:border-white/10 bg-navy-50/50 dark:bg-navy-900/40 overflow-hidden">
        <summary class="flex items-center justify-between p-3.5 cursor-pointer font-bold text-xs sm:text-sm text-navy-800 dark:text-navy-200 select-none hover:bg-navy-100/50 dark:hover:bg-navy-800/40 transition-colors">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-700 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Downside Put Protection (Hedging)
          </span>
          <svg class="w-4 h-4 text-navy-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="p-3.5 pt-1 space-y-3.5 border-t border-navy-200/60 dark:border-white/5">
          <label class="flex items-center justify-between cursor-pointer">
            <div>
              <span class="text-xs font-bold text-navy-800 dark:text-navy-200 block">European Put Protection</span>
              <span class="text-xs text-navy-500 dark:text-navy-400">Caps maximum equity drawdown in severe crashes</span>
            </div>
            <input id="bsHedgingToggle" type="checkbox" class="toggle-checkbox w-5 h-5 accent-emerald-600 rounded" />
          </label>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div class="space-y-1">
              <label for="hedgingFloorLimit" class="text-xs font-medium text-navy-700 dark:text-navy-300">Protected Floor</label>
              <select id="hedgingFloorLimit" class="w-full bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-lg px-2.5 py-2 text-xs font-medium text-navy-900 dark:text-white">
                <option value="0.10">-10% Drop</option>
                <option value="0.15">-15% Drop</option>
                <option value="0.20">-20% Drop</option>
              </select>
            </div>
            <div class="space-y-1">
              <label for="hedgingDragCost" class="text-xs font-medium text-navy-700 dark:text-navy-300">Annual Option Drag</label>
              <div class="relative">
                <input
                  id="hedgingDragCost"
                  type="number"
                  step="0.1"
                  min="0.5"
                  max="5"
                  value="1.85"
                  class="w-full bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-lg px-3 py-2 text-xs tabular-nums text-navy-900 dark:text-white"
                />
                <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-navy-400">%</span>
              </div>
            </div>
          </div>
        </div>
      </details>

      <!-- Run / Recompute Button -->
      <button
        id="runSimBtn"
        type="button"
        class="w-full py-3 px-4 rounded-xl bg-navy-900 hover:bg-navy-800 dark:bg-gold-500 dark:hover:bg-gold-400 text-white dark:text-navy-950 font-bold text-sm shadow-sm transition-all flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <span>Re-run Simulation</span>
      </button>

    </form>
  </CardPremium>
</div>
