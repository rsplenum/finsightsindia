---
// SwpWorking.astro — Visual Working workbench for the SWP Planner
// Implements interactive workbench tabs: Monte Carlo percentile trajectory, Recharts bar growth vs target comparison, cashflow schedule, sensitivity, and downside hedging.
import CardPremium from '../CardPremium.astro';
import CorpusGrowthVsTargetChart from './CorpusGrowthVsTargetChart';
---

<div id="swpWorkbenchContainer" class="w-full max-w-full overflow-x-hidden p-4 sm:p-0 space-y-6 font-sans antialiased">
  
  <!-- Top Stat Cards (Sol-019 Layer 2 Metrics) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4 w-full transition-all duration-300 ease-in-out" style="transition: all 0.3s ease-in-out;">
    
    <div class="card-glass rounded-xl p-4 sm:p-5 flex flex-col justify-between border border-navy-200/80 dark:border-navy-800/80 bg-white/70 dark:bg-navy-900/70 backdrop-blur-md shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs sm:text-sm font-semibold text-navy-700 dark:text-navy-300 tracking-normal">
          Success Probability
        </span>
        <span class="text-xs font-medium text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-800 px-2 py-0.5 rounded-md border border-navy-200/60 dark:border-navy-700/60">
          10k runs
        </span>
      </div>
      <div class="my-2.5 text-2xl sm:text-3xl font-extrabold text-navy-950 dark:text-white tracking-tight leading-tight tabular-nums min-h-[36px] flex items-center">
        <span id="metricSuccessRate">--</span>
      </div>
      <div id="metricSuccessSubtext" class="text-xs sm:text-sm text-navy-600 dark:text-navy-400 leading-relaxed">
        Probability of survival
      </div>
    </div>

    <div class="card-glass rounded-xl p-4 sm:p-5 flex flex-col justify-between border border-navy-200/80 dark:border-navy-800/80 bg-white/70 dark:bg-navy-900/70 backdrop-blur-md shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs sm:text-sm font-semibold text-navy-700 dark:text-navy-300 tracking-normal">
          Safe Withdrawal Rate
        </span>
        <span class="text-xs font-medium text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-800 px-2 py-0.5 rounded-md border border-navy-200/60 dark:border-navy-700/60">
          annualized
        </span>
      </div>
      <div class="my-2.5 text-2xl sm:text-3xl font-extrabold text-navy-950 dark:text-white tracking-tight leading-tight tabular-nums min-h-[36px] flex items-center">
        <span id="metricInitialSWR">--</span>
      </div>
      <div id="metricSwrStatus" class="text-xs sm:text-sm text-navy-600 dark:text-navy-400 leading-relaxed">
        Initial withdrawal / corpus
      </div>
    </div>

    <div class="card-glass rounded-xl p-4 sm:p-5 flex flex-col justify-between border border-navy-200/80 dark:border-navy-800/80 bg-white/70 dark:bg-navy-900/70 backdrop-blur-md shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs sm:text-sm font-semibold text-navy-700 dark:text-navy-300 tracking-normal">
          Median Ending Corpus
        </span>
        <span class="text-xs font-medium text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-800 px-2 py-0.5 rounded-md border border-navy-200/60 dark:border-navy-700/60">
          at horizon
        </span>
      </div>
      <div class="my-2.5 text-2xl sm:text-3xl font-extrabold text-navy-950 dark:text-white tracking-tight leading-tight tabular-nums min-h-[36px] flex items-center">
        <span id="metricMedianFinal">--</span>
      </div>
      <div id="metricMedianFinalReal" class="text-xs sm:text-sm text-navy-600 dark:text-navy-400 leading-relaxed">
        In today's value: --
      </div>
    </div>

    <div class="card-glass rounded-xl p-4 sm:p-5 flex flex-col justify-between border border-navy-200/80 dark:border-navy-800/80 bg-white/70 dark:bg-navy-900/70 backdrop-blur-md shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs sm:text-sm font-semibold text-navy-700 dark:text-navy-300 tracking-normal">
          Total Lifetime Income
        </span>
        <span class="text-xs font-medium text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-800 px-2 py-0.5 rounded-md border border-navy-200/60 dark:border-navy-700/60">
          withdrawn
        </span>
      </div>
      <div class="my-2.5 text-2xl sm:text-3xl font-extrabold text-navy-950 dark:text-white tracking-tight leading-tight tabular-nums min-h-[36px] flex items-center">
        <span id="metricTotalWithdrawn">--</span>
      </div>
      <div id="metricMultiplier" class="text-xs sm:text-sm text-navy-600 dark:text-navy-400 leading-relaxed">
        -- x initial capital
      </div>
    </div>

  </div>

  <!-- Workbench Card with Multi-Tab System -->
  <CardPremium glass={true} class="p-4 sm:p-6 space-y-6 overflow-hidden">
    
    <!-- Tab Navigation Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-navy-200 dark:border-navy-800 pb-4">
      <div>
        <h3 class="text-base sm:text-lg font-bold text-navy-900 dark:text-navy-100 tracking-tight">
          Portfolio Workings & Schedule
        </h3>
        <p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">
          Percentile distribution trajectories, yearly cashflows, sensitivity matrix, and hedging ledger.
        </p>
      </div>

      <!-- Tab Buttons Group (Scrollable on mobile) -->
      <div role="tablist" aria-label="SWP Workbench Views" class="flex flex-nowrap overflow-x-auto no-scrollbar scrollbar-none max-w-full p-1.5 rounded-xl bg-navy-100 dark:bg-navy-900 border border-navy-200/80 dark:border-navy-800/80 gap-1.5 shrink-0">
        <button
          type="button"
          role="tab"
          id="tabBtnChart"
          data-tab="chart"
          class="swp-tab-btn active-tab shrink-0 whitespace-nowrap min-h-[44px] px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors bg-white dark:bg-navy-800 text-navy-900 dark:text-white shadow-xs inline-flex items-center justify-center"
        >
          Corpus Trajectory
        </button>
        <button
          type="button"
          role="tab"
          id="tabBtnGrowth"
          data-tab="growth"
          class="swp-tab-btn shrink-0 whitespace-nowrap min-h-[44px] px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 transition-colors inline-flex items-center justify-center"
        >
          Growth vs Target
        </button>
        <button
          type="button"
          role="tab"
          id="tabBtnSchedule"
          data-tab="schedule"
          class="swp-tab-btn shrink-0 whitespace-nowrap min-h-[44px] px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 transition-colors inline-flex items-center justify-center"
        >
          Yearly Schedule
        </button>
        <button
          type="button"
          role="tab"
          id="tabBtnSensitivity"
          data-tab="sensitivity"
          class="swp-tab-btn shrink-0 whitespace-nowrap min-h-[44px] px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 transition-colors inline-flex items-center justify-center"
        >
          Sensitivity Matrix
        </button>
        <button
          type="button"
          role="tab"
          id="tabBtnHedging"
          data-tab="hedging"
          class="swp-tab-btn shrink-0 whitespace-nowrap min-h-[44px] px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 transition-colors inline-flex items-center justify-center"
        >
          Put Floor Ledger
        </button>
      </div>
    </div>

    <!-- Tab Pane 1: Corpus Trajectory Chart -->
    <div id="tabPaneChart" class="w-full max-w-full space-y-4">
      
      <!-- Chart Controls & Legend -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs sm:text-sm">
        <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 sm:gap-4">
          <div class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-sm bg-emerald-600 dark:bg-emerald-500 shrink-0"></span>
            <span class="text-navy-700 dark:text-navy-300 font-medium whitespace-nowrap text-[11px] sm:text-xs">90th Pct (Bull)</span>
          </div>
          <div class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-sm bg-blue-600 dark:bg-blue-500 shrink-0"></span>
            <span class="text-navy-700 dark:text-navy-300 font-medium whitespace-nowrap text-[11px] sm:text-xs">50th Pct (Median)</span>
          </div>
          <div class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-sm bg-amber-600 dark:bg-amber-500 shrink-0"></span>
            <span class="text-navy-700 dark:text-navy-300 font-medium whitespace-nowrap text-[11px] sm:text-xs">10th Pct (Adverse)</span>
          </div>
          <div class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-sm bg-red-600 dark:bg-red-500 shrink-0"></span>
            <span class="text-navy-700 dark:text-navy-300 font-medium whitespace-nowrap text-[11px] sm:text-xs">Zero Line</span>
          </div>
        </div>

        <div class="flex items-center justify-between sm:justify-end gap-2 pt-1 sm:pt-0 border-t sm:border-t-0 border-navy-100 dark:border-navy-800/60">
          <span class="text-navy-600 dark:text-navy-400 text-xs whitespace-nowrap">Values shown in:</span>
          <button
            type="button"
            id="chartRealNominalToggle"
            class="min-h-[38px] sm:min-h-[44px] px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-lg border text-xs sm:text-sm font-semibold border-navy-300 dark:border-navy-700 bg-navy-50 dark:bg-navy-900 text-navy-800 dark:text-navy-200 hover:border-gold-500 transition-colors inline-flex items-center justify-center whitespace-nowrap shrink-0"
          >
            Today's Rupees (Real)
          </button>
        </div>
      </div>

      <!-- Trajectory Chart Canvas / Container with Skeleton (100% responsive width, no horizontal scrolling) -->
      <div id="swpChartCanvasContainer" class="relative w-full max-w-full h-80 sm:h-96 rounded-xl bg-navy-50/70 dark:bg-navy-900/50 border border-navy-200 dark:border-navy-800 p-2 sm:p-3 overflow-hidden flex flex-col justify-end">
        <!-- Dynamic Skeleton overlay during calculation -->
        <div id="swpChartSkeleton" class="absolute inset-0 bg-navy-100/60 dark:bg-navy-950/70 backdrop-blur-[2px] flex flex-col justify-between p-6 skeleton-shimmer pointer-events-none transition-opacity duration-300 opacity-0 hidden">
          <div class="flex justify-between items-center">
            <div class="h-4 w-32 bg-navy-200 dark:bg-navy-800 rounded"></div>
            <div class="h-4 w-20 bg-navy-200 dark:bg-navy-800 rounded"></div>
          </div>
          <div class="space-y-3">
            <div class="h-2 w-full bg-navy-200/80 dark:bg-navy-800/80 rounded"></div>
            <div class="h-2 w-4/5 bg-navy-200/80 dark:bg-navy-800/80 rounded"></div>
            <div class="h-2 w-3/5 bg-navy-200/80 dark:bg-navy-800/80 rounded"></div>
          </div>
          <div class="flex justify-between items-center pt-4">
            <div class="h-3 w-12 bg-navy-200 dark:bg-navy-800 rounded"></div>
            <div class="h-3 w-12 bg-navy-200 dark:bg-navy-800 rounded"></div>
            <div class="h-3 w-12 bg-navy-200 dark:bg-navy-800 rounded"></div>
            <div class="h-3 w-12 bg-navy-200 dark:bg-navy-800 rounded"></div>
          </div>
        </div>

        <!-- SVG Interactive Trajectory Chart Rendered Dynamically -->
        <svg id="swpTrajectorySvg" class="w-full h-full block" viewBox="0 0 800 360">
          <!-- Dynamically populated by client runner script -->
        </svg>
      </div>

      <!-- Chart Footnote -->
      <p class="text-xs sm:text-sm text-navy-500 dark:text-navy-400 leading-relaxed italic">
        * Chart displays 10th (adverse market timing), 50th (median), and 90th percentile trajectories out of 10,000 empirical paths.
      </p>
    </div>

    <!-- Tab Pane 2: Growth vs Target Recharts Bar Chart -->
    <div id="tabPaneGrowth" class="hidden space-y-4">
      <CorpusGrowthVsTargetChart client:load />
    </div>

    <!-- Tab Pane 3: Yearly Schedule Table -->
    <div id="tabPaneSchedule" class="hidden space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <span class="text-xs sm:text-sm text-navy-600 dark:text-navy-400 font-medium">
          Detailed year-by-year cashflows, inflation step-ups, capital gains taxes, and balance.
        </span>
        <button
          type="button"
          id="exportScheduleCsvBtn"
          class="min-h-[44px] px-3.5 py-2 rounded-lg border text-xs sm:text-sm font-medium border-navy-300 dark:border-navy-700 text-navy-700 dark:text-navy-300 hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors inline-flex items-center justify-center gap-2 shrink-0"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          Export CSV
        </button>
      </div>

      <div class="overflow-x-auto max-h-96 rounded-xl border border-navy-200 dark:border-navy-800">
        <table class="w-full text-left text-xs tabular-nums">
          <thead class="bg-navy-100/80 dark:bg-navy-900 sticky top-0 border-b border-navy-200 dark:border-navy-800 text-navy-800 dark:text-navy-200 font-bold">
            <tr>
              <th class="py-2.5 px-3">Year</th>
              <th class="py-2.5 px-3">Age</th>
              <th class="py-2.5 px-3">Nominal Paycheck</th>
              <th class="py-2.5 px-3">Real Purchasing Power</th>
              <th class="py-2.5 px-3">LTCG Tax</th>
              <th class="py-2.5 px-3">Ending (10th %ile)</th>
              <th class="py-2.5 px-3">Ending (Median)</th>
              <th class="py-2.5 px-3">Ending (90th %ile)</th>
            </tr>
          </thead>
          <tbody id="swpScheduleTableBody" class="divide-y divide-navy-200/60 dark:divide-navy-800/60 text-navy-700 dark:text-navy-300">
            <!-- Dynamically populated rows -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tab Pane 3: Sensitivity Matrix -->
    <div id="tabPaneSensitivity" class="hidden space-y-4">
      <div class="space-y-1">
        <h4 class="text-xs font-bold text-navy-900 dark:text-navy-100">
          Withdrawal Rate vs. Horizon Longevity Matrix
        </h4>
        <p class="text-xs text-navy-500 dark:text-navy-400">
          Success probability (%) across varying initial withdrawal rates (3.0% to 6.5%) and retirement durations.
        </p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-navy-200 dark:border-navy-800">
        <table id="swpSensitivityTable" class="w-full text-center text-xs tabular-nums">
          <thead class="bg-navy-100/80 dark:bg-navy-900 text-navy-800 dark:text-navy-200 font-bold border-b border-navy-200 dark:border-navy-800">
            <tr>
              <th class="py-2.5 px-3 text-left">Initial SWR</th>
              <th class="py-2.5 px-3">20 Years</th>
              <th class="py-2.5 px-3">25 Years</th>
              <th class="py-2.5 px-3">30 Years</th>
              <th class="py-2.5 px-3">35 Years</th>
              <th class="py-2.5 px-3">40 Years</th>
            </tr>
          </thead>
          <tbody id="swpSensitivityTableBody" class="divide-y divide-navy-200/60 dark:divide-navy-800/60 text-navy-700 dark:text-navy-300">
            <!-- Dynamically computed sensitivity matrix -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tab Pane 4: Put Floor Ledger -->
    <div id="tabPaneHedging" class="hidden space-y-4">
      <div class="space-y-1">
        <h4 class="text-xs font-bold text-navy-900 dark:text-navy-100">
          Black-Scholes Downside Protection Ledger
        </h4>
        <p class="text-xs text-navy-500 dark:text-navy-400">
          Comparison between Unhedged and Put-Floored portfolio performance during extreme tail crashes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 space-y-3">
          <div class="text-xs font-bold text-navy-800 dark:text-navy-200">
            Unhedged Strategy Performance
          </div>
          <div class="space-y-2 text-xs">
            <div class="flex justify-between py-1 border-b border-navy-100 dark:border-navy-900">
              <span class="text-navy-500 dark:text-navy-400">Adverse 10th Percentile Run</span>
              <span id="unhedgedP10Final" class="font-bold text-navy-900 dark:text-navy-100 tabular-nums">--</span>
            </div>
            <div class="flex justify-between py-1 border-b border-navy-100 dark:border-navy-900">
              <span class="text-navy-500 dark:text-navy-400">Max Peak-to-Trough Drawdown</span>
              <span class="font-bold text-red-600 dark:text-red-400 tabular-nums">-48.5%</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-navy-500 dark:text-navy-400">Protection Cost Drag</span>
              <span class="font-bold text-navy-900 dark:text-navy-100 tabular-nums">0.00%</span>
            </div>
          </div>
        </div>

        <div class="p-4 rounded-xl border border-emerald-500/30 bg-emerald-50/20 dark:bg-emerald-950/20 space-y-3">
          <div class="text-xs font-bold text-emerald-800 dark:text-emerald-300">
            Put-Floored Strategy Performance
          </div>
          <div class="space-y-2 text-xs">
            <div class="flex justify-between py-1 border-b border-emerald-100 dark:border-emerald-900/50">
              <span class="text-navy-600 dark:text-navy-400">Floor-Protected 10th %ile</span>
              <span id="hedgedP10Final" class="font-bold text-emerald-700 dark:text-emerald-300 tabular-nums">--</span>
            </div>
            <div class="flex justify-between py-1 border-b border-emerald-100 dark:border-emerald-900/50">
              <span class="text-navy-600 dark:text-navy-400">Max Absorbed Crash Drop</span>
              <span id="hedgedMaxDrop" class="font-bold text-emerald-700 dark:text-emerald-300 tabular-nums">-10.0%</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-navy-600 dark:text-navy-400">Annual Option Cost Drag</span>
              <span id="hedgedAnnualCost" class="font-bold text-navy-800 dark:text-navy-200 tabular-nums">--</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </CardPremium>
</div>
