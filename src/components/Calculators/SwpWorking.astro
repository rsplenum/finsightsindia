---
/**
 * Comprehensive working, charts, and schedule for the reimagined SWP planner — dd-002, dd-004, dd-008, dd-010.
 *
 * Organized into 3 clear tabs:
 * 1. Plan Summary & Projections (Lifecycle Chart, Micro Cashflow, Key Totals, Sensitivity Matrix)
 * 2. Yearly Schedule & Cashflow (Year-by-year ledger with "Show in Today's Rupees" toggle)
 * 3. Option Hedging & Downside (Black-Scholes Put Floor protection details and ledger)
 *
 * Design settled before the component in `SwpWorking.checks.md`.
 */
import CardPremium from '../CardPremium.astro';
---

<div class="space-y-6">

  <!-- Main Working Container -->
  <CardPremium class="p-4 sm:p-6 space-y-6">
    
    <!-- Top Navigation Tabs & PDF Export -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-navy-200 dark:border-white/10">
      <nav class="flex items-center gap-1 sm:gap-2 overflow-x-auto pb-1 sm:pb-0" aria-label="SWP detail tabs">
        <button
          id="tabPlanSummaryBtn"
          type="button"
          class="px-3.5 py-2 text-xs sm:text-sm font-bold rounded-lg border border-navy-900 bg-navy-900 text-white dark:border-white dark:bg-white dark:text-navy-950 transition-colors shadow-2xs whitespace-nowrap"
        >
          Summary & Projections
        </button>
        <button
          id="tabScheduleBtn"
          type="button"
          class="px-3.5 py-2 text-xs sm:text-sm font-medium rounded-lg border border-transparent text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-white hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors whitespace-nowrap"
        >
          Yearly Schedule
        </button>
        <button
          id="tabHedgingBtn"
          type="button"
          class="px-3.5 py-2 text-xs sm:text-sm font-medium rounded-lg border border-transparent text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-white hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors whitespace-nowrap"
        >
          Downside Hedging
        </button>
      </nav>

      <button
        id="downloadPdfBtn"
        type="button"
        class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg border border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-900 text-xs font-semibold text-navy-700 dark:text-navy-300 hover:border-gold-500 hover:text-gold-700 dark:hover:text-gold-400 transition-colors shadow-2xs self-start sm:self-auto shrink-0"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download PDF Report</span>
      </button>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 1: PLAN SUMMARY & PROJECTIONS                                         -->
    <!-- ========================================================================= -->
    <div id="viewPlanSummary" class="space-y-6">
      
      <!-- Payout Multiplier & Cashflow Summary Card -->
      <div class="rounded-2xl border border-navy-200/80 dark:border-white/10 bg-gradient-to-br from-navy-50/70 via-white to-gold-50/30 dark:from-navy-900/60 dark:via-navy-900/40 dark:to-gold-950/20 p-5 sm:p-6 space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h4 class="text-base font-bold text-navy-900 dark:text-navy-100">
              Lifetime Income vs Initial Savings
            </h4>
            <p class="text-xs text-navy-500 dark:text-navy-400">
              How much wealth your portfolio generates over the full retirement span.
            </p>
          </div>
          <span id="wowMultiplierBadge" class="self-start sm:self-auto px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 font-bold text-xs border border-emerald-300 dark:border-emerald-800">
            --x Lifetime Payout
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
          <div class="p-3.5 rounded-xl bg-white dark:bg-navy-950 border border-navy-200/70 dark:border-white/5 space-y-1">
            <span class="text-xs font-semibold text-navy-500 dark:text-navy-400 block">Initial Corpus</span>
            <div id="wowInitialCorpus" class="text-lg sm:text-xl font-bold text-navy-900 dark:text-navy-100 tabular-nums">₹ 0</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white dark:bg-navy-950 border border-navy-200/70 dark:border-white/5 space-y-1">
            <span class="text-xs font-semibold text-gold-700 dark:text-gold-400 block">Net Lifetime Income</span>
            <div id="wowNetPayout" class="text-lg sm:text-xl font-bold text-gold-700 dark:text-gold-400 tabular-nums">₹ 0</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white dark:bg-navy-950 border border-navy-200/70 dark:border-white/5 space-y-1">
            <span class="text-xs font-semibold text-rose-700 dark:text-rose-400 block">LTCG Tax Paid</span>
            <div id="tier2Taxes" class="text-lg sm:text-xl font-bold text-rose-700 dark:text-rose-400 tabular-nums">₹ 0</div>
          </div>
          <div class="p-3.5 rounded-xl bg-white dark:bg-navy-950 border border-navy-200/70 dark:border-white/5 space-y-1">
            <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 block">Median Final Balance</span>
            <div id="tier2BalanceRemaining" class="text-lg sm:text-xl font-bold text-emerald-700 dark:text-emerald-400 tabular-nums">₹ 0</div>
          </div>
        </div>

        <div class="hidden">
          <span id="tier2Duration"></span>
          <span id="tier2Gross"></span>
          <span id="tier2Net"></span>
          <span id="valLowestPaycheck"></span>
          <span id="valRockBottom"></span>
          <span id="valSacrifice"></span>
          <div id="lifestyleSacrificeAlertBox" class="hidden">
            <span id="valSacrificeTotalCash"></span>
            <span id="valSacrificeRockBottom"></span>
          </div>
          <div id="guardrailsLowestPaycheckRow" class="hidden"></div>
          <div id="guardrailsActiveBadge" class="hidden"></div>
          <div id="weatherForecastContainer" class="hidden"><div id="weatherGrid"></div></div>
        </div>
      </div>

      <!-- Lifecycle Projections Chart -->
      <div class="rounded-2xl border border-navy-200 dark:border-white/10 bg-white dark:bg-navy-950 p-4 sm:p-5 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-navy-100 dark:border-white/10">
          <div>
            <h4 class="text-base font-bold text-navy-900 dark:text-navy-100">
              The Lifecycle of Your Savings
            </h4>
            <p class="text-xs text-navy-500 dark:text-navy-400">
              Monte Carlo simulation showing the full spectrum of market paths.
            </p>
          </div>
          <div class="flex items-center gap-1 bg-navy-100 dark:bg-navy-900 border border-navy-200 dark:border-white/10 rounded-lg p-1 text-xs">
            <button id="viewPercentilesBtn" type="button" class="min-h-[32px] px-3 py-1 rounded-md bg-white dark:bg-navy-950 text-navy-900 dark:text-navy-100 font-semibold shadow-2xs transition-colors">Likelihoods</button>
            <button id="viewSamplePathsBtn" type="button" class="min-h-[32px] px-3 py-1 rounded-md text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-200 transition-colors">Sample Paths</button>
          </div>
        </div>

        <div class="relative w-full h-64 sm:h-80 md:h-96">
          <canvas id="swpChart" class="w-full h-full"></canvas>
        </div>

        <div class="flex flex-wrap items-center justify-between text-xs text-navy-600 dark:text-navy-400 pt-2 gap-3 border-t border-navy-100 dark:border-white/10">
          <div class="flex flex-wrap items-center gap-4 sm:gap-6">
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-600 dark:bg-emerald-400"></span> 90th % (Boom Market)</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-navy-900 dark:bg-navy-100"></span> 50th % (Median Expected)</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-600 dark:bg-rose-400"></span> 10th % (Early Crash)</span>
          </div>
          <span class="text-xs text-navy-500 dark:text-navy-400 font-medium">10,000 Simulated Futures</span>
        </div>
      </div>

      <!-- Micro Cashflow Trajectory Chart -->
      <div class="rounded-2xl border border-navy-200 dark:border-white/10 bg-white dark:bg-navy-950 p-4 sm:p-5 space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-navy-100 dark:border-white/10">
          <h4 class="text-sm font-bold text-navy-900 dark:text-navy-100">
            Monthly Paycheck Trajectory (Nominal Cash vs Real Purchasing Power)
          </h4>
          <span class="text-xs text-navy-500 dark:text-navy-400">Annual Escalation</span>
        </div>
        <div class="relative w-full h-44 sm:h-52">
          <canvas id="cashflowMicroChart" class="w-full h-full"></canvas>
        </div>
      </div>

      <!-- Sensitivity & Diagnostics Grid -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        
        <!-- Volatility Sensitivity Table -->
        <div class="md:col-span-7 rounded-2xl border border-navy-200 dark:border-white/10 bg-white dark:bg-navy-950 p-4 sm:p-5 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-navy-100 dark:border-white/10">
            <div>
              <h4 class="text-sm font-bold text-navy-900 dark:text-navy-100">Market Volatility Sensitivity</h4>
              <p class="text-xs text-navy-500 dark:text-navy-400">Required CAGR to offset sequence drag.</p>
            </div>
            <div class="text-xs text-right">
              <span class="text-navy-500 dark:text-navy-400">Initial Rate:</span>
              <span id="sensIWR" class="font-bold text-gold-700 dark:text-gold-400 ml-1">--%</span>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-xs tabular-nums">
              <thead>
                <tr class="border-b border-navy-200 dark:border-navy-800 text-navy-500 dark:text-navy-400 text-left">
                  <th class="py-2 px-3 font-semibold">Volatility Level</th>
                  <th class="py-2 px-3 text-right font-semibold">Required CAGR</th>
                </tr>
              </thead>
              <tbody id="sensitivityTableBody" class="divide-y divide-navy-100 dark:divide-white/5 font-sans">
                <!-- Dynamically populated -->
              </tbody>
            </table>
          </div>
          <span id="sensVolatilityInput" class="hidden"></span>
        </div>

        <!-- Simulation Diagnostics Panel -->
        <div class="md:col-span-5 rounded-2xl border border-navy-200 dark:border-white/10 bg-navy-50/50 dark:bg-navy-900/40 p-4 sm:p-5 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-navy-200/60 dark:border-white/10">
            <h4 class="text-sm font-bold text-navy-900 dark:text-navy-100">Simulation Diagnostics</h4>
            <button
              type="button"
              id="toggleDiagnosticsBtn"
              class="text-xs font-semibold text-gold-700 dark:text-gold-400 hover:underline"
            >
              Toggle Details
            </button>
          </div>

          <div id="diagnosticsPanel" class="space-y-3 text-xs">
            <div class="grid grid-cols-2 gap-3">
              <div class="p-2.5 rounded-lg bg-white dark:bg-navy-950 border border-navy-200/70 dark:border-white/5">
                <span class="text-navy-500 dark:text-navy-400 block text-xs">Mean Final Bal</span>
                <span id="diagMean" class="font-bold text-navy-900 dark:text-navy-100 text-sm">₹0</span>
              </div>
              <div class="p-2.5 rounded-lg bg-white dark:bg-navy-950 border border-navy-200/70 dark:border-white/5">
                <span class="text-navy-500 dark:text-navy-400 block text-xs">Median Final Bal</span>
                <span id="diagMedian" class="font-bold text-navy-900 dark:text-navy-100 text-sm">₹0</span>
              </div>
              <div class="p-2.5 rounded-lg bg-white dark:bg-navy-950 border border-navy-200/70 dark:border-white/5">
                <span class="text-navy-500 dark:text-navy-400 block text-xs">Std Deviation</span>
                <span id="diagStdDev" class="font-bold text-navy-900 dark:text-navy-100 text-sm">₹0</span>
              </div>
              <div class="p-2.5 rounded-lg bg-white dark:bg-navy-950 border border-navy-200/70 dark:border-white/5">
                <span class="text-navy-500 dark:text-navy-400 block text-xs">Skewness</span>
                <span id="diagSkew" class="font-bold text-navy-900 dark:text-navy-100 text-sm">0.00</span>
              </div>
            </div>
            <p class="text-xs text-navy-500 dark:text-navy-400 leading-tight">
              Positive skew indicates distribution is lifted by long-term compounding in bull runs.
            </p>
          </div>
        </div>

      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- TAB 2: YEARLY SCHEDULE & CASHFLOW                                         -->
    <!-- ========================================================================= -->
    <div id="viewSchedule" class="hidden space-y-5">
      <div class="rounded-2xl border border-navy-200 dark:border-white/10 bg-white dark:bg-navy-950 p-4 sm:p-5 space-y-4">
        
        <!-- Schedule Header & Inflation Deflator Toggle -->
        <div class="pb-4 border-b border-navy-200 dark:border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="space-y-1">
            <h4 class="text-base font-bold text-navy-900 dark:text-navy-100">
              Yearly Cashflow & Inflation Escalation Schedule
            </h4>
            <!-- dd-004 / dd-008: Explicit currency frame notice -->
            <p id="scheduleMoneyFrame" class="text-xs font-semibold text-gold-700 dark:text-gold-400"></p>
          </div>

          <div class="flex flex-wrap items-center gap-3 self-start sm:self-auto">
            <!-- Show in Today's Rupees Toggle -->
            <label class="flex items-center cursor-pointer gap-2 bg-navy-50 dark:bg-navy-900 px-3 py-1.5 rounded-lg border border-navy-200 dark:border-navy-700">
              <span class="text-xs font-semibold text-navy-700 dark:text-navy-300">Show in Today's Rupees</span>
              <div class="relative">
                <input type="checkbox" id="inflationDeflatorToggle" class="sr-only peer">
                <div class="w-8 h-4 bg-navy-200 hover:bg-navy-300 dark:bg-navy-700 dark:hover:bg-navy-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-emerald-500"></div>
              </div>
            </label>

            <span id="scheduleStepUpBadge" class="text-xs text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-900 border border-navy-200 dark:border-white/10 px-2.5 py-1.5 rounded-lg font-medium">
              +6.0% Inflation
            </span>
          </div>
        </div>

        <!-- Schedule Table -->
        <div class="w-full max-h-[600px] overflow-x-auto overflow-y-auto border border-navy-200 dark:border-navy-800 rounded-xl scrollbar-thin scrollbar-thumb-navy-300 dark:scrollbar-thumb-navy-700">
          <table class="w-full min-w-[700px] text-xs tabular-nums">
            <thead class="sticky top-0 z-10 bg-navy-100 dark:bg-navy-900 border-b border-navy-200 dark:border-navy-800 text-navy-700 dark:text-navy-300 shadow-2xs">
              <tr>
                <th class="py-3 px-3.5 text-left font-bold whitespace-nowrap">Year</th>
                <th class="py-3 px-3.5 text-right font-bold whitespace-nowrap">Net Monthly</th>
                <th class="py-3 px-3.5 text-right font-bold whitespace-nowrap">Net Annual</th>
                <th class="py-3 px-3.5 text-right font-bold whitespace-nowrap text-rose-700 dark:text-rose-400">Annual LTCG Tax</th>
                <th class="py-3 px-3.5 text-right font-bold whitespace-nowrap text-emerald-700 dark:text-emerald-400">Additions / Growth</th>
                <th class="py-3 px-3.5 text-right font-bold whitespace-nowrap">Corpus Balance</th>
              </tr>
            </thead>
            <tbody id="scheduleTableBody" class="divide-y divide-navy-100 dark:divide-white/5 font-sans bg-white dark:bg-navy-950">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>

      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 3: DOWNSIDE HEDGING                                                   -->
    <!-- ========================================================================= -->
    <div id="viewHedging" class="hidden space-y-5">
      <div class="rounded-2xl border border-navy-200 dark:border-white/10 bg-white dark:bg-navy-950 p-4 sm:p-6 space-y-5">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-navy-200 dark:border-navy-800">
          <div>
            <h4 class="text-base font-bold text-navy-900 dark:text-navy-100">
              Black-Scholes Put Option Downside Hedging
            </h4>
            <p class="text-xs text-navy-500 dark:text-navy-400">
              Institutional-grade insurance: continuously roll European put options to cap equity drawdowns.
            </p>
          </div>
          <span id="bsStatusBadge" class="badge-warning text-xs self-start sm:self-auto">
            UNHEDGED PORTFOLIO
          </span>
        </div>

        <!-- Strategy Description -->
        <div class="rounded-xl border border-navy-200 dark:border-navy-800 bg-navy-50 dark:bg-navy-900/60 p-4 space-y-2 text-xs text-navy-600 dark:text-navy-400 leading-relaxed font-sans">
          <p>
            <strong class="text-navy-900 dark:text-navy-100">How Put Hedging Works:</strong> By purchasing out-of-the-money (OTM) Nifty 50 LEAPS put options rolling every 12 to 18 months, severe market drawdowns (e.g. beyond -10%) are absorbed by option payoffs.
          </p>
          <p>
            <strong class="text-navy-900 dark:text-navy-100">Hedging vs Guardrails:</strong> Dynamic guardrails force you to cut your lifestyle when markets crash. Option hedging sacrifices a minor 1.5%–2.0% annual yield drag to protect your monthly living standard permanently.
          </p>
        </div>

        <!-- Hedging Metric Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
          <div class="p-3.5 rounded-xl bg-navy-50/60 dark:bg-navy-900/40 border border-navy-200/70 dark:border-white/5 space-y-1">
            <span class="text-xs font-semibold text-navy-500 dark:text-navy-400 block">Option Premium Drag</span>
            <div id="valHedgingDrag" class="text-lg font-bold text-navy-900 dark:text-navy-100 tabular-nums">0.00% / Year</div>
          </div>
          <div class="p-3.5 rounded-xl bg-navy-50/60 dark:bg-navy-900/40 border border-navy-200/70 dark:border-white/5 space-y-1">
            <span class="text-xs font-semibold text-navy-500 dark:text-navy-400 block">Protected Floor</span>
            <div id="valProtectedFloor" class="text-lg font-bold text-navy-900 dark:text-navy-100 tabular-nums">Unprotected</div>
          </div>
          <div class="p-3.5 rounded-xl bg-navy-50/60 dark:bg-navy-900/40 border border-navy-200/70 dark:border-white/5 space-y-1">
            <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 block">Expected Final Balance</span>
            <div id="valAdjustedYield" class="text-lg font-bold text-emerald-700 dark:text-emerald-400 tabular-nums">₹ 0</div>
          </div>
        </div>

        <!-- Hedging Ledger -->
        <div class="space-y-2 pt-2">
          <div class="flex items-center justify-between">
            <h5 class="text-xs font-bold tracking-wide text-navy-700 dark:text-navy-300">
              Year-by-Year Option Cost & Floor Protection Ledger
            </h5>
            <span class="text-xs font-semibold text-gold-700 dark:text-gold-400">In rupees of each year</span>
          </div>
          <p id="swpLedgerCaption" class="text-xs text-navy-500 dark:text-navy-400"></p>

          <div class="w-full max-h-[360px] overflow-x-auto overflow-y-auto border border-navy-200 dark:border-navy-800 rounded-xl scrollbar-thin scrollbar-thumb-navy-300 dark:scrollbar-thumb-navy-700">
            <table class="w-full min-w-[560px] text-xs tabular-nums">
              <thead class="sticky top-0 z-10 bg-navy-100 dark:bg-navy-900 border-b border-navy-200 dark:border-navy-800 text-navy-700 dark:text-navy-300 shadow-2xs">
                <tr>
                  <th class="py-2.5 px-3 text-left font-bold whitespace-nowrap">Year</th>
                  <th class="py-2.5 px-3 text-right font-bold whitespace-nowrap">Annual Withdrawal</th>
                  <th class="py-2.5 px-3 text-right font-bold whitespace-nowrap">Corpus Balance</th>
                  <th class="py-2.5 px-3 text-right font-bold whitespace-nowrap text-rose-700 dark:text-rose-400">Option Fee Paid</th>
                  <th class="py-2.5 px-3 text-right font-bold whitespace-nowrap text-emerald-700 dark:text-emerald-400">Floor Protection Absorbed</th>
                </tr>
              </thead>
              <tbody id="hedgingLedgerBody" class="divide-y divide-navy-100 dark:divide-white/5 font-sans bg-white dark:bg-navy-950">
                <!-- Dynamically populated -->
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>

  </CardPremium>
</div>
