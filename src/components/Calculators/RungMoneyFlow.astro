---
// Rung 2 of the ladder (dd-002): "Where does the money actually go?"
//
// Both moneys are shown side by side rather than behind a toggle (dd-006).
// The difference between the two columns IS the lesson, and a lesson cannot
// be a mode - hiding half of a comparison behind a control turns it into a
// spot-the-difference puzzle.
//
// One prose voice, one size (dd-007). The earlier version cascaded three
// paragraphs through shrinking type, asserting a hierarchy that did not exist.
//
// No new concept is introduced here. Rung 1 already established that prices
// rise and that only the gap matters; this shows what that does in rupees.
---

<section id="rungFlow" class="max-w-3xl mx-auto px-4 sm:px-6 py-4" aria-labelledby="rungFlowQ">
  <div class="card-premium rounded-2xl p-6 sm:p-8 space-y-6">

    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.11em] text-navy-500 dark:text-navy-400">
        Next question
      </p>
      <h2 id="rungFlowQ" class="text-xl sm:text-2xl font-bold tracking-tight text-navy-900 dark:text-navy-100 mt-1">
        Where does the money actually go?
      </h2>
      <p class="text-sm text-navy-500 dark:text-navy-400 mt-2">
        Over <span id="flowYears" class="font-medium text-navy-700 dark:text-navy-300">30</span> years,
        starting from <span id="flowStart" class="font-medium text-navy-700 dark:text-navy-300">—</span>.
      </p>
    </div>

    <div class="overflow-x-auto -mx-2 px-2">
      <table class="w-full text-sm border-collapse">
        <caption class="sr-only">
          Where the money goes, shown both in today's prices and as your statement will report it.
        </caption>
        <thead>
          <tr class="border-b border-navy-200 dark:border-navy-700">
            <th scope="col" class="text-left font-normal text-navy-500 dark:text-navy-400 pb-2"></th>
            <th scope="col" class="text-right pb-2 pl-4">
              <span class="block text-xs font-semibold text-navy-900 dark:text-navy-100">What it buys</span>
              <span class="block text-sm font-normal text-navy-500 dark:text-navy-400">in today's prices</span>
            </th>
            <th scope="col" class="text-right pb-2 pl-4">
              <span class="block text-xs font-semibold text-navy-500 dark:text-navy-400">What your statement says</span>
              <span class="block text-sm font-normal text-navy-500 dark:text-navy-400">the number on the screen</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-navy-100 dark:divide-navy-800">
          <tr>
            <th scope="row" class="text-left font-normal text-navy-700 dark:text-navy-300 py-2.5">You spend</th>
            <td id="cellSpendReal" class="text-right tabular-nums font-semibold text-navy-900 dark:text-navy-100 py-2.5 pl-4">—</td>
            <td id="cellSpendNom" class="text-right tabular-nums text-navy-500 dark:text-navy-400 py-2.5 pl-4">—</td>
          </tr>
          <tr>
            <th scope="row" class="text-left font-normal text-navy-700 dark:text-navy-300 py-2.5">Tax takes</th>
            <td id="cellTaxReal" class="text-right tabular-nums font-semibold text-navy-900 dark:text-navy-100 py-2.5 pl-4">—</td>
            <td id="cellTaxNom" class="text-right tabular-nums text-navy-500 dark:text-navy-400 py-2.5 pl-4">—</td>
          </tr>
          <tr>
            <th scope="row" class="text-left font-normal text-navy-700 dark:text-navy-300 py-2.5">Still there at the end</th>
            <td id="cellLeftReal" class="text-right tabular-nums font-semibold text-navy-900 dark:text-navy-100 py-2.5 pl-4">—</td>
            <td id="cellLeftNom" class="text-right tabular-nums text-navy-500 dark:text-navy-400 py-2.5 pl-4">—</td>
          </tr>
          <tr class="border-t-2 border-navy-300 dark:border-navy-600">
            <th scope="row" class="text-left font-semibold text-navy-900 dark:text-navy-100 py-3">
              What the pot gave you
            </th>
            <td id="cellTotalReal" class="text-right tabular-nums font-bold text-base text-navy-900 dark:text-navy-100 py-3 pl-4">—</td>
            <td id="cellTotalNom" class="text-right tabular-nums font-semibold text-navy-500 dark:text-navy-400 py-3 pl-4">—</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- The one thing the two columns exist to show. -->
    <p id="flowGap" class="rounded-lg bg-gold-500/10 border border-gold-500/30 px-4 py-3 text-sm leading-relaxed text-navy-800 dark:text-navy-200"></p>

    <!-- One idea, one voice, one size. -->
    <p id="flowIdea" class="text-base leading-relaxed text-navy-800 dark:text-navy-200"></p>

    <div class="pt-4 border-t border-navy-200 dark:border-navy-800">
      <p class="text-sm text-navy-600 dark:text-navy-400">
        Which raises the obvious worry:
        <span class="font-medium text-navy-800 dark:text-navy-200">what if growth is slower than 12%?</span>
      </p>
    </div>

  </div>
</section>

<script>
  const $ = (id: string) => document.getElementById(id);

  function money(n: number): string {
    const v = Math.round(Math.abs(n));
    const sign = n < 0 ? '−' : '';
    if (v >= 10000000) return `${sign}₹${(v / 10000000).toFixed(2)} cr`;
    if (v >= 100000) return `${sign}₹${(v / 100000).toFixed(1)} L`;
    return `${sign}₹${v.toLocaleString('en-IN')}`;
  }

  function render(detail: any) {
    const { inputs, outlook } = detail;
    const f = outlook?.flow;
    if (!f?.real) return;

    const realLeft = Math.max(0, f.real.left);
    const nomLeft = Math.max(0, f.left);

    // What the pot gave YOU: spending money plus what you still hold. Tax went
    // to the government, so it is shown but not counted in the total - the
    // three rows above must add to the row below, because a reader will check.
    const realTotal = f.real.netToYou + realLeft;
    const nomTotal = f.netToYou + nomLeft;
    const eaten = nomTotal - realTotal;

    $('flowYears')!.textContent = String(inputs.horizonYears);
    $('flowStart')!.textContent = money(f.started);

    $('cellSpendReal')!.textContent = money(f.real.netToYou);
    $('cellSpendNom')!.textContent = money(f.netToYou);
    $('cellTaxReal')!.textContent = money(f.real.tax);
    $('cellTaxNom')!.textContent = money(f.tax);
    $('cellLeftReal')!.textContent = money(realLeft);
    $('cellLeftNom')!.textContent = money(nomLeft);
    $('cellTotalReal')!.textContent = money(realTotal);
    $('cellTotalNom')!.textContent = money(nomTotal);

    $('flowGap')!.textContent =
      `The two columns are the same money. The ${money(eaten)} between them is ` +
      `inflation — and no statement you ever receive will show you that line.`;

    const multiple = f.started > 0 ? realTotal / f.started : 0;
    $('flowIdea')!.textContent = realLeft > 0
      ? `So a ${money(f.started)} pot pays you ${money(f.real.netToYou)} to live on and ` +
        `still holds ${money(realLeft)} — ${multiple.toFixed(1)} times what you put in, ` +
        `in what it can actually buy. Your savings did not pay you; growth did, and it ` +
        `only worked because you drew ${f.initialRate.toFixed(1)}% while the pot grew faster. ` +
        `The rate you draw matters far more than the amount you start with.`
      : `So a ${money(f.started)} pot pays you ${money(f.real.netToYou)} and then runs out. ` +
        `Drawing ${f.initialRate.toFixed(1)}% in the first year outran what the money could ` +
        `earn. The rate you draw matters far more than the amount you start with — a bigger ` +
        `pot drawn at the same rate runs out at the same time.`;
  }

  window.addEventListener('swp:result', (e) => render((e as CustomEvent).detail));
</script>
