---
// Rung 1 of the ladder (dd-002): "Where does the money actually go?"
//
// The user has just been told whether their savings last. This is the next
// question they have, and it gets one screen, no controls, and one idea to
// carry away (dd-003): your savings do not pay you - growth does, which is
// why the RATE you draw matters more than the amount you start with.
//
// Nothing here is a simplification of something else (dd-001). It is the same
// arithmetic the year-by-year table shows, sequenced so it can be absorbed.
---

<section id="rungFlow" class="max-w-3xl mx-auto px-4 sm:px-6 py-4" aria-labelledby="rungFlowQ">
  <div class="card-premium rounded-2xl p-6 sm:p-8 space-y-6">

    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.11em] text-navy-400 dark:text-navy-500">
        Next question
      </p>
      <h2 id="rungFlowQ" class="text-xl sm:text-2xl font-bold tracking-tight text-navy-900 dark:text-navy-100 mt-1">
        Where does the money actually go?
      </h2>
    </div>

    <!-- Proportional bar. Static by design - editorial, not a game UI. -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <p class="text-xs text-navy-500 dark:text-navy-400">
          Over <span id="flowYears" class="font-semibold text-navy-700 dark:text-navy-300">30</span> years,
          every rupee that passes through the plan:
        </p>
        <!-- dd-004: the frame is a permanent, visible marker, not a caption. -->
        <span class="shrink-0 inline-flex items-center gap-1.5 rounded-md border border-navy-200 dark:border-navy-700 bg-navy-50 dark:bg-navy-900/60 px-2 py-1 text-[11px] font-medium text-navy-600 dark:text-navy-300">
          <span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>
          in today's money — what it would buy now
        </span>
      </div>

      <div class="flex h-9 w-full overflow-hidden rounded-lg border border-navy-200 dark:border-navy-700" role="img" aria-labelledby="flowBarDesc">
        <div id="barSpent" class="bg-gold-500/85 dark:bg-gold-500/70 min-w-[2px]"></div>
        <div id="barTax" class="bg-rose-500/70 dark:bg-rose-500/60 min-w-[2px]"></div>
        <div id="barLeft" class="bg-emerald-500/60 dark:bg-emerald-500/45 min-w-[2px]"></div>
      </div>
      <p id="flowBarDesc" class="sr-only"></p>

      <div class="grid grid-cols-3 gap-3 text-xs">
        <div class="flex items-start gap-2">
          <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-sm bg-gold-500/85 dark:bg-gold-500/70"></span>
          <span>
            <span class="block text-navy-500 dark:text-navy-400">You spend</span>
            <span id="flowSpent" class="block font-semibold tabular-nums text-navy-900 dark:text-navy-100">—</span>
          </span>
        </div>
        <div class="flex items-start gap-2">
          <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-sm bg-rose-500/70 dark:bg-rose-500/60"></span>
          <span>
            <span class="block text-navy-500 dark:text-navy-400">Tax takes</span>
            <span id="flowTax" class="block font-semibold tabular-nums text-navy-900 dark:text-navy-100">—</span>
          </span>
        </div>
        <div class="flex items-start gap-2">
          <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-sm bg-emerald-500/60 dark:bg-emerald-500/45"></span>
          <span>
            <span class="block text-navy-500 dark:text-navy-400">Still there at the end</span>
            <span id="flowLeft" class="block font-semibold tabular-nums text-navy-900 dark:text-navy-100">—</span>
          </span>
        </div>
      </div>
    </div>

    <!-- The idea. This is the part they keep. -->
    <div class="pt-5 border-t border-navy-200 dark:border-navy-800 space-y-3">
      <p id="flowInsight" class="text-base leading-relaxed text-navy-800 dark:text-navy-200"></p>
      <p id="flowIdea" class="text-sm leading-relaxed text-navy-600 dark:text-navy-400"></p>

      <!-- Reconciles this screen with the answer above it. Without this the
           reader meets two different figures for the same quantity one screen
           apart and has to decide which of us is wrong. -->
      <p id="flowReconcile" class="text-xs leading-relaxed text-navy-500 dark:text-navy-400 border-l-2 border-navy-200 dark:border-navy-700 pl-3"></p>
    </div>

    <div class="pt-4 border-t border-navy-200 dark:border-navy-800">
      <p class="text-sm text-navy-600 dark:text-navy-400">
        Which raises the obvious worry:
        <span class="font-medium text-navy-800 dark:text-navy-200">what if growth is slower than 12%?</span>
      </p>
      <p class="text-xs text-navy-400 dark:text-navy-500 mt-1">That is the next step — coming shortly.</p>
    </div>

  </div>
</section>

<script>
  const $ = (id: string) => document.getElementById(id);

  function money(n: number): string {
    const v = Math.round(Math.abs(n));
    const sign = n < 0 ? '-' : '';
    if (v >= 10000000) return `${sign}₹${(v / 10000000).toFixed(2)} crore`;
    if (v >= 100000) return `${sign}₹${(v / 100000).toFixed(1)} lakh`;
    return `${sign}₹${v.toLocaleString('en-IN')}`;
  }

  function render(detail: any) {
    const { inputs, outlook } = detail;
    const f = outlook?.flow;
    if (!f?.real) return;

    // Today's money is what we show. A reader knows what a rupee buys now and
    // has no feel for what one buys in 2056 (dd-004).
    const r = f.real;

    const total = Math.max(1, r.netToYou + r.tax + Math.max(0, r.left));
    const pct = (n: number) => `${Math.max(0, (n / total) * 100).toFixed(2)}%`;

    ($('barSpent') as HTMLElement).style.width = pct(r.netToYou);
    ($('barTax') as HTMLElement).style.width = pct(r.tax);
    ($('barLeft') as HTMLElement).style.width = pct(Math.max(0, r.left));

    $('flowYears')!.textContent = String(inputs.horizonYears);
    $('flowSpent')!.textContent = money(r.netToYou);
    $('flowTax')!.textContent = money(r.tax);
    $('flowLeft')!.textContent = money(Math.max(0, r.left));
    $('flowBarDesc')!.textContent =
      `In today's money you spend ${money(r.netToYou)}, tax takes ${money(r.tax)}, ` +
      `and ${money(Math.max(0, r.left))} is still there at the end.`;

    // The insight adapts to what actually happened, because a plan that
    // depletes teaches the same lesson from the other direction.
    // Real growth as a residual, so the sentence's claim is backed by a figure
    // the reader can check against the three shown above it.
    const realGrowth = r.drawn + r.left - f.started;

    if (r.left > 0) {
      $('flowInsight')!.textContent =
        `In what it can actually buy, you take out ${money(r.drawn)} — ` +
        `${r.multiple.toFixed(1)} times what you started with — and still have ` +
        `${money(r.left)} left at the end. Your savings did not pay you. Growth did: ` +
        `the pot earned ${money(realGrowth)} more than you put in, after allowing ` +
        `for rising prices.`;
      $('flowIdea')!.textContent =
        `That only works because you drew ${f.initialRate.toFixed(1)}% in the first year ` +
        `and the pot grew faster than that. The rate you draw matters far more than ` +
        `the amount you start with: double the savings and draw double, and you are ` +
        `in exactly the same place.`;
    } else {
      $('flowInsight')!.textContent =
        `In what it can actually buy, you take out ${money(r.drawn)} and end with ` +
        `nothing. Drawing ${f.initialRate.toFixed(1)}% in the first year outran what ` +
        `the money could earn.`;
      $('flowIdea')!.textContent =
        `The rate you draw matters far more than the amount you start with. A bigger ` +
        `pot drawn at the same rate runs out at the same time — only a slower rate ` +
        `changes the ending.`;
    }

    // The nominal figures are the opt-in, not the default, and they are named
    // as the same money rather than left to look like a contradiction.
    $('flowReconcile')!.textContent = r.left > 0
      ? `On a statement in ${inputs.horizonYears} years those numbers look bigger — ` +
        `the leftover reads ${money(f.left)} rather than ${money(r.left)}. It is the ` +
        `same money. Prices will have risen too, so it buys what ${money(r.left)} ` +
        `buys today. That gap is why we show you today's money.`
      : `On a statement the yearly figures look bigger than these, because prices ` +
        `rise alongside them. These are what the money would actually buy you.`;
  }

  window.addEventListener('swp:result', (e) => render((e as CustomEvent).detail));
</script>
