---
// FOAuditTrigger.astro
---

<div class="bg-white dark:bg-navy-900 rounded-2xl shadow-xl border border-slate-200 dark:border-navy-700 overflow-hidden my-12 font-sans fo-calculator transition-colors duration-300">
  <div class="bg-brand-navy dark:bg-navy-950 p-6 text-white border-b-4 border-brand-gold">
    <h3 class="text-2xl font-bold m-0 flex items-center">
      <svg class="w-6 h-6 mr-3 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
      Absolute Turnover Engine
    </h3>
    <p class="text-slate-300 dark:text-navy-300 text-sm mt-2 mb-0 opacity-90">Simulate your casual trading habits to see how fast you cross the ₹10 Crore Tax Audit threshold.</p>
  </div>
  
  <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Inputs -->
    <div class="space-y-6">
      
      <div>
        <div class="flex justify-between mb-1">
          <label class="text-sm font-semibold text-slate-700 dark:text-navy-300">Trades per Day</label>
          <span class="text-sm font-bold text-brand-navy dark:text-gold-700 dark:text-gold-500" id="fo-val-trades">20</span>
        </div>
        <input type="range" id="fo-in-trades" min="1" max="100" value="20" class="w-full h-2 bg-slate-200 dark:bg-navy-700 rounded-lg appearance-none cursor-pointer accent-brand-navy dark:accent-gold-500" />
      </div>

      <div>
        <div class="flex justify-between mb-1">
          <label class="text-sm font-semibold text-slate-700 dark:text-navy-300">Avg Profit / Winning Trade</label>
          <span class="text-sm font-bold text-emerald-700 dark:text-emerald-400" id="fo-val-profit">₹1,500</span>
        </div>
        <input type="range" id="fo-in-profit" min="100" max="10000" step="100" value="1500" class="w-full h-2 bg-slate-200 dark:bg-navy-700 rounded-lg appearance-none cursor-pointer accent-emerald-600 dark:accent-emerald-400" />
      </div>

      <div>
        <div class="flex justify-between mb-1">
          <label class="text-sm font-semibold text-slate-700 dark:text-navy-300">Avg Loss / Losing Trade</label>
          <span class="text-sm font-bold text-rose-700 dark:text-rose-400" id="fo-val-loss">₹1,200</span>
        </div>
        <input type="range" id="fo-in-loss" min="100" max="10000" step="100" value="1200" class="w-full h-2 bg-slate-200 dark:bg-navy-700 rounded-lg appearance-none cursor-pointer accent-rose-600 dark:accent-rose-400" />
      </div>

      <div>
        <div class="flex justify-between mb-1">
          <label class="text-sm font-semibold text-slate-700 dark:text-navy-300">Win Rate</label>
          <span class="text-sm font-bold text-brand-navy dark:text-gold-700 dark:text-gold-500" id="fo-val-winrate">45%</span>
        </div>
        <input type="range" id="fo-in-winrate" min="10" max="90" value="45" class="w-full h-2 bg-slate-200 dark:bg-navy-700 rounded-lg appearance-none cursor-pointer accent-brand-navy dark:accent-gold-500" />
      </div>

    </div>

    <!-- Outputs -->
    <div class="bg-slate-50 dark:bg-navy-800 p-6 rounded-xl border border-slate-200 dark:border-navy-700 flex flex-col justify-center transition-colors">
      
      <div class="mb-6">
        <h4 class="text-xs font-bold text-slate-400 dark:text-navy-400 uppercase tracking-wider mb-2">Calculated Absolute Turnover</h4>
        <div id="fo-out-turnover" class="text-4xl font-extrabold font-mono tracking-tight text-brand-navy dark:text-gold-700 dark:text-gold-500">
          ₹0
        </div>
        
        <div class="mt-4">
           <div class="flex justify-between text-xs font-medium text-slate-500 dark:text-navy-400 mb-1">
             <span>₹0</span>
             <span>Tax Audit Threshold (₹10 Cr)</span>
           </div>
           <div class="w-full bg-slate-200 dark:bg-navy-700 rounded-full h-2.5">
              <div id="fo-out-bar" class="h-2.5 rounded-full transition-all duration-500 bg-brand-navy dark:bg-gold-500" style="width: 0%"></div>
           </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 pt-6 border-t border-slate-200 dark:border-navy-700">
        <div>
          <p class="text-xs font-semibold text-slate-500 dark:text-navy-400 mb-1">Total Trades</p>
          <p id="fo-out-total-trades" class="text-lg font-bold text-slate-800 dark:text-white">0</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 dark:text-navy-400 mb-1">Net PnL</p>
          <p id="fo-out-pnl" class="text-lg font-bold">₹0</p>
        </div>
      </div>

      <div id="fo-out-alert" class="mt-6 bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 rounded-lg p-4 flex items-start hidden">
        <svg class="w-5 h-5 text-rose-700 dark:text-rose-500 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <div>
          <p class="text-sm font-bold text-rose-800 dark:text-rose-400 mb-1">Audit Mandatory!</p>
          <p class="text-xs text-rose-700 dark:text-rose-300/80 m-0">Your absolute turnover exceeds ₹10 Crores. Filing without a CA's Tax Audit Report (Form 3CB-3CD) will result in a defective return notice.</p>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function initFOCalculator() {
    const calc = document.querySelector('.fo-calculator');
    if (!calc) return;

    const inTrades = document.getElementById('fo-in-trades');
    const inProfit = document.getElementById('fo-in-profit');
    const inLoss = document.getElementById('fo-in-loss');
    const inWinrate = document.getElementById('fo-in-winrate');

    const valTrades = document.getElementById('fo-val-trades');
    const valProfit = document.getElementById('fo-val-profit');
    const valLoss = document.getElementById('fo-val-loss');
    const valWinrate = document.getElementById('fo-val-winrate');

    const outTurnover = document.getElementById('fo-out-turnover');
    const outBar = document.getElementById('fo-out-bar');
    const outTotalTrades = document.getElementById('fo-out-total-trades');
    const outPnL = document.getElementById('fo-out-pnl');
    const outAlert = document.getElementById('fo-out-alert');

    const formatCurrency = (amount) => {
      return new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
      }).format(amount);
    };

    function calculate() {
      const tradesPerDay = Number(inTrades.value);
      const avgProfit = Number(inProfit.value);
      const avgLoss = Number(inLoss.value);
      const winRate = Number(inWinrate.value);
      const tradingDays = 200;

      valTrades.textContent = tradesPerDay;
      valProfit.textContent = formatCurrency(avgProfit);
      valLoss.textContent = formatCurrency(avgLoss);
      valWinrate.textContent = winRate + '%';

      const totalTrades = tradesPerDay * tradingDays;
      const totalWinningTrades = Math.round(totalTrades * (winRate / 100));
      const totalLosingTrades = totalTrades - totalWinningTrades;

      const totalPositiveDifference = totalWinningTrades * avgProfit;
      const totalNegativeDifference = totalLosingTrades * avgLoss;
      
      const absoluteTurnover = totalPositiveDifference + totalNegativeDifference;
      const netProfit = totalPositiveDifference - totalNegativeDifference;

      outTurnover.textContent = formatCurrency(absoluteTurnover);
      outTotalTrades.textContent = new Intl.NumberFormat('en-IN').format(totalTrades);
      outPnL.textContent = formatCurrency(netProfit);

      if (netProfit >= 0) {
        outPnL.className = "text-lg font-bold text-emerald-700 dark:text-emerald-400";
      } else {
        outPnL.className = "text-lg font-bold text-rose-700 dark:text-rose-400";
      }

      if (absoluteTurnover > 100000000) {
        outTurnover.className = "text-4xl font-extrabold font-mono tracking-tight text-rose-700 dark:text-rose-500";
        outBar.className = "h-2.5 rounded-full transition-all duration-500 bg-rose-600 dark:bg-rose-500";
        outAlert.classList.remove('hidden');
      } else {
        outTurnover.className = "text-4xl font-extrabold font-mono tracking-tight text-brand-navy dark:text-gold-700 dark:text-gold-500";
        outBar.className = "h-2.5 rounded-full transition-all duration-500 bg-brand-navy dark:bg-gold-500";
        outAlert.classList.add('hidden');
      }

      const progress = Math.min((absoluteTurnover / 100000000) * 100, 100);
      outBar.style.width = progress + '%';
    }

    inTrades.addEventListener('input', calculate);
    inProfit.addEventListener('input', calculate);
    inLoss.addEventListener('input', calculate);
    inWinrate.addEventListener('input', calculate);

    calculate(); // Initial run
  }

  // Handle Astro page transitions if they are enabled
  document.addEventListener('astro:page-load', initFOCalculator);
  
  // Fallback for direct loads without view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFOCalculator);
  } else {
    initFOCalculator();
  }
</script>
