---
// SipWorking.astro — Reimagined Visual Working workbench for the SIP Accumulation Planner
// Implements interactive workbench tabs: 10k Monte Carlo percentile trajectory, milestones, compounding analysis, and Black-Scholes put floor ledger.
import CardPremium from '../CardPremium.astro';
---

<div id="sipWorkbenchContainer" class="w-full max-w-full overflow-x-hidden p-4 sm:p-0 space-y-6 font-sans antialiased">
  
  <!-- Top Stat Cards (Sol-019 Layer 2 Metrics) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4 w-full transition-all duration-300 ease-in-out">
    
    <!-- Metric 1: What you put in -->
    <div class="card-glass rounded-xl p-4 sm:p-5 flex flex-col justify-between border border-navy-200/80 dark:border-navy-800/80 bg-white/70 dark:bg-navy-900/70 backdrop-blur-md shadow-xs hover:shadow-md transition-shadow relative overflow-hidden">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs sm:text-sm font-semibold text-navy-700 dark:text-navy-300 tracking-normal">
          Total Invested (Today's Value)
        </span>
        <span class="text-xs font-medium text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-800 px-2 py-0.5 rounded-md border border-navy-200/60 dark:border-navy-700/60">
          Principal
        </span>
      </div>
      <div class="my-2.5 text-2xl sm:text-3xl font-extrabold text-navy-950 dark:text-white tracking-tight leading-tight tabular-nums min-h-[36px] flex items-center">
        <span id="statTotalInvested">₹ 0</span>
      </div>
      <div class="text-xs sm:text-sm text-navy-600 dark:text-navy-400 leading-relaxed">
        Total cash sacrifice over horizon
      </div>
    </div>

    <!-- Metric 2: Typical Wealth Created -->
    <div class="card-glass rounded-xl p-4 sm:p-5 flex flex-col justify-between border border-navy-200/80 dark:border-navy-800/80 bg-white/70 dark:bg-navy-900/70 backdrop-blur-md shadow-xs hover:shadow-md transition-shadow relative overflow-hidden">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs sm:text-sm font-semibold text-navy-700 dark:text-navy-300 tracking-normal">
          Typical Real Wealth (50th)
        </span>
        <button id="taxToggleBtn" type="button" aria-pressed="false" class="px-2 py-0.5 rounded text-xs font-bold tracking-tight transition-all duration-200 bg-navy-200 text-navy-800 dark:bg-navy-800 dark:text-navy-200 border border-navy-300 dark:border-navy-700 cursor-pointer">Before tax</button>
      </div>
      <div class="my-2.5 text-2xl sm:text-3xl font-extrabold text-gold-700 dark:text-gold-400 tracking-tight leading-tight tabular-nums min-h-[36px] flex items-center">
        <span id="statRealWealth">₹ 0</span>
      </div>
      <div id="statNominalEquivalent" class="text-xs sm:text-sm text-navy-600 dark:text-navy-400 leading-relaxed truncate">
        The number on screen that year: ₹ 0
      </div>
    </div>

    <!-- Metric 3: Yours vs Market Growth -->
    <div class="card-glass rounded-xl p-4 sm:p-5 flex flex-col justify-between border border-navy-200/80 dark:border-navy-800/80 bg-white/70 dark:bg-navy-900/70 backdrop-blur-md shadow-xs hover:shadow-md transition-shadow relative overflow-hidden">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs sm:text-sm font-semibold text-navy-700 dark:text-navy-300 tracking-normal">
          Yours vs Compounding
        </span>
        <span id="expectedMultiplierTag" class="text-xs font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-200/60 dark:border-emerald-800/60">
          --x Typical
        </span>
      </div>
      <div class="my-2.5 space-y-1.5 w-full">
        <div class="flex justify-between text-xs tracking-tight font-bold">
          <span class="text-navy-600 dark:text-navy-300">Yours: <span id="pctSacrifice">0%</span></span>
          <span class="text-emerald-700 dark:text-emerald-400">Market: <span id="pctCreated">0%</span></span>
        </div>
        <div class="w-full h-2 flex rounded-full overflow-hidden bg-navy-200 dark:bg-navy-800">
          <div id="barSacrifice" class="h-full bg-navy-500 dark:bg-navy-400 transition-all duration-500" style="width: 50%"></div>
          <div id="barCreated" class="h-full bg-emerald-500 transition-all duration-500" style="width: 50%"></div>
        </div>
      </div>
      <div class="text-xs text-navy-600 dark:text-navy-400 flex justify-between">
        <span id="worstMultiplierTag">--x (10th)</span>
        <span id="bestMultiplierTag">--x (90th)</span>
      </div>
    </div>

    <!-- Metric 4: Real XIRR / Annual Yield -->
    <div class="card-glass rounded-xl p-4 sm:p-5 flex flex-col justify-between border border-navy-200/80 dark:border-navy-800/80 bg-white/70 dark:bg-navy-900/70 backdrop-blur-md shadow-xs hover:shadow-md transition-shadow relative overflow-hidden">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs sm:text-sm font-semibold text-navy-700 dark:text-navy-300 tracking-normal">
          Real Rate of Return (XIRR)
        </span>
        <span class="text-xs font-medium text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-800 px-2 py-0.5 rounded-md border border-navy-200/60 dark:border-navy-700/60">
          annualized
        </span>
      </div>
      <div class="my-2.5 text-xl sm:text-2xl font-extrabold text-navy-950 dark:text-white tracking-tight leading-tight tabular-nums min-h-[36px] flex items-center">
        <span id="valAdjustedYield">0.00% a year</span>
      </div>
      <div class="text-xs sm:text-sm text-navy-600 dark:text-navy-400 leading-relaxed">
        True purchasing power growth rate
      </div>
    </div>

  </div>

  <!-- Workbench Card with Multi-Tab System -->
  <CardPremium glass={true} class="p-4 sm:p-6 space-y-6 overflow-hidden">
    
    <!-- Tab Navigation Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-navy-200 dark:border-navy-800 pb-4">
      <div>
        <h3 class="text-base sm:text-lg font-bold text-navy-900 dark:text-navy-100 tracking-tight">
          Wealth Trajectory & Diagnostic Workings
        </h3>
        <p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">
          10,000-path Monte Carlo cone, milestones timeline, compounding split, and hedging protection ledger.
        </p>
      </div>

      <!-- Tab Buttons Group (Scrollable on mobile) -->
      <div role="tablist" aria-label="SIP Workbench Views" class="flex flex-nowrap overflow-x-auto no-scrollbar scrollbar-none max-w-full p-1.5 rounded-xl bg-navy-100 dark:bg-navy-900 border border-navy-200/80 dark:border-navy-800/80 gap-1.5 shrink-0">
        <button
          type="button"
          role="tab"
          id="tabBtnSipChart"
          data-tab="chart"
          class="sip-tab-btn active-tab shrink-0 whitespace-nowrap min-h-[44px] px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors bg-white dark:bg-navy-800 text-navy-900 dark:text-white shadow-xs inline-flex items-center justify-center cursor-pointer"
        >
          Wealth Trajectory Cone
        </button>
        <button
          type="button"
          role="tab"
          id="tabBtnSipCompounding"
          data-tab="compounding"
          class="sip-tab-btn shrink-0 whitespace-nowrap min-h-[44px] px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 transition-colors inline-flex items-center justify-center cursor-pointer"
        >
          Invested vs Wealth Gained
        </button>
        <button
          type="button"
          role="tab"
          id="tabBtnSipHedging"
          data-tab="hedging"
          class="sip-tab-btn shrink-0 whitespace-nowrap min-h-[44px] px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 transition-colors inline-flex items-center justify-center cursor-pointer"
        >
          Put Floor Protection Ledger
        </button>
        <button
          type="button"
          role="tab"
          id="tabBtnSipEmergency"
          data-tab="emergency"
          class="sip-tab-btn shrink-0 whitespace-nowrap min-h-[44px] px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-100 transition-colors inline-flex items-center justify-center cursor-pointer"
        >
          Emergency Buffer & Risk Protection
        </button>
      </div>
    </div>

    <!-- Tab Pane 1: Wealth Trajectory Cone Chart -->
    <div id="tabPaneSipChart" class="w-full max-w-full space-y-4">
      
      <!-- Chart Controls & Legend -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs sm:text-sm">
        <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center gap-2 sm:gap-4">
          <div class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-sm bg-emerald-600 dark:bg-emerald-500 shrink-0"></span>
            <span class="text-navy-700 dark:text-navy-300 font-medium whitespace-nowrap text-xs">90th Pct (Lucky)</span>
          </div>
          <div class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-sm bg-navy-900 dark:bg-navy-100 shrink-0"></span>
            <span class="text-navy-700 dark:text-navy-300 font-medium whitespace-nowrap text-xs">50th Pct (Typical)</span>
          </div>
          <div class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-sm bg-rose-600 dark:bg-rose-500 shrink-0"></span>
            <span class="text-navy-700 dark:text-navy-300 font-medium whitespace-nowrap text-xs">10th Pct (Unlucky)</span>
          </div>
          <div class="inline-flex items-center gap-1.5">
            <span class="w-3.5 border-t-2 border-dashed border-gold-500 shrink-0"></span>
            <span class="text-navy-700 dark:text-navy-300 font-medium whitespace-nowrap text-xs">Your Target</span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button id="downloadPdfBtn" type="button" class="min-h-[36px] px-3 py-1.5 text-xs font-semibold rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 text-navy-700 dark:text-navy-300 hover:border-gold-500 hover:text-gold-700 dark:hover:text-gold-400 transition-colors inline-flex items-center gap-1.5 cursor-pointer">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>PDF Report</span>
          </button>
          <button id="exportCsvBtn" type="button" class="min-h-[36px] px-3 py-1.5 text-xs font-semibold rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 text-navy-700 dark:text-navy-300 hover:border-gold-500 hover:text-gold-700 dark:hover:text-gold-400 transition-colors inline-flex items-center gap-1.5 cursor-pointer">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <span>Export CSV</span>
          </button>
        </div>
      </div>

      <!-- Chart Canvas Container with Responsive Observer -->
      <div id="sipChartContainer" class="relative w-full h-[320px] sm:h-[380px] bg-white dark:bg-navy-950 rounded-xl border border-navy-200/80 dark:border-navy-800/80 p-3 sm:p-4 flex items-center justify-center">
        <canvas id="sipChart" class="w-full h-full"></canvas>
      </div>

      <!-- Milestone Timeline (In Today's Money) -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-navy-700 dark:text-navy-300">
          Target Milestones (When You Cross Them in Today's Money):
        </span>
        <div id="milestoneTimeline" class="p-3 rounded-xl border border-navy-200 dark:border-navy-800 bg-navy-50/60 dark:bg-navy-900/40 flex flex-wrap gap-2 items-center text-xs min-h-[48px]">
          <!-- Populated by script -->
        </div>
      </div>

      <!-- Unlucky vs Lucky Outcome Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="p-4 rounded-xl border border-rose-200 dark:border-rose-900/60 bg-rose-50/40 dark:bg-rose-950/20 space-y-1">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-rose-800 dark:text-rose-300">If You Are Unlucky (10th Percentile)</span>
            <span class="text-xs text-rose-700 dark:text-rose-400 font-semibold">Bear Sequence</span>
          </div>
          <div id="statBearWealth" class="text-xl sm:text-2xl font-bold tabular-nums text-rose-900 dark:text-rose-200">₹ 0</div>
          <p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed">
            Market suffers repeated downturns or prolonged sideways stagnation across your horizon.
          </p>
        </div>

        <div class="p-4 rounded-xl border border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/40 dark:bg-emerald-950/20 space-y-1">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-emerald-800 dark:text-emerald-300">If You Are Lucky (90th Percentile)</span>
            <span class="text-xs text-emerald-700 dark:text-emerald-400 font-semibold">Bull Sequence</span>
          </div>
          <div id="statBullWealth" class="text-xl sm:text-2xl font-bold tabular-nums text-emerald-900 dark:text-emerald-200">₹ 0</div>
          <p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed">
            Market delivers strong compound expansion with favorable return sequences.
          </p>
        </div>
      </div>

    </div>

    <!-- Tab Pane 2: Invested vs Wealth Gained Breakdown & Year-by-Year Schedule -->
    <div id="tabPaneSipCompounding" class="hidden w-full max-w-full space-y-5">
      
      <!-- Ratio Bar & Wealth Gained Highlights -->
      <div class="p-4 sm:p-5 rounded-xl border border-navy-200 dark:border-navy-800 bg-navy-50/50 dark:bg-navy-900/30 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <h4 class="text-sm font-bold text-navy-900 dark:text-navy-100">
            Invested Amount vs Compounded Wealth Gained
          </h4>
          <span class="text-xs text-navy-600 dark:text-navy-400">
            Inflation-adjusted real purchasing power
          </span>
        </div>

        <!-- Split Progress Bar -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs font-bold">
            <span class="text-navy-700 dark:text-navy-300">
              Invested Capital: <span id="splitInvestedAmount" class="font-extrabold text-navy-950 dark:text-white">₹ 0</span> (<span id="splitInvestedPct">0%</span>)
            </span>
            <span class="text-emerald-700 dark:text-emerald-400">
              Wealth Gained: <span id="splitGainedAmount" class="font-extrabold">₹ 0</span> (<span id="splitGainedPct">0%</span>)
            </span>
          </div>
          <div class="w-full h-3 rounded-full bg-navy-200 dark:bg-navy-800 overflow-hidden flex">
            <div id="splitInvestedBar" class="bg-navy-900 dark:bg-navy-100 h-full transition-all duration-300" style="width: 50%;"></div>
            <div id="splitGainedBar" class="bg-emerald-600 dark:bg-emerald-500 h-full transition-all duration-300" style="width: 50%;"></div>
          </div>
        </div>
      </div>

      <!-- 4-Card Summary Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-4 rounded-xl border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 space-y-1">
          <span class="text-xs font-semibold text-navy-500">Total Invested (Real)</span>
          <div id="compoundingInvestedReal" class="text-lg font-bold tabular-nums text-navy-950 dark:text-white">₹ 0</div>
          <span id="compoundingInvestedNominal" class="text-xs text-navy-500 dark:text-navy-400">Nominal: ₹ 0</span>
        </div>
        <div class="p-4 rounded-xl border border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/40 dark:bg-emerald-950/20 space-y-1">
          <span class="text-xs font-semibold text-emerald-800 dark:text-emerald-300">Wealth Gained (Growth)</span>
          <div id="compoundingGainedReal" class="text-lg font-bold tabular-nums text-emerald-700 dark:text-emerald-400">₹ 0</div>
          <span id="compoundingGainedNominal" class="text-xs text-emerald-800 dark:text-emerald-400">Market gains created</span>
        </div>
        <div class="p-4 rounded-xl border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 space-y-1">
          <span class="text-xs font-semibold text-navy-500">Real Purchasing Power</span>
          <div id="compoundingRealValue" class="text-lg font-bold tabular-nums text-gold-700 dark:text-gold-400">₹ 0</div>
          <span id="compoundingNominalValue" class="text-xs text-navy-500 dark:text-navy-400">Nominal: ₹ 0</span>
        </div>
        <div class="p-4 rounded-xl border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 space-y-1">
          <span class="text-xs font-semibold text-navy-500">Wealth Multiplier</span>
          <div id="compoundingMultiplier" class="text-lg font-bold tabular-nums text-emerald-700 dark:text-emerald-400">--x</div>
          <span id="compoundingRealXirr" class="text-xs text-navy-500 dark:text-navy-400">Real CAGR / XIRR</span>
        </div>
      </div>

      <!-- Year-by-Year Accumulation Schedule Table -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-bold text-navy-800 dark:text-navy-200">
            Year-by-Year Accumulation Schedule (In Today's Money)
          </h4>
          <span class="text-xs text-navy-500">All figures deflated for inflation</span>
        </div>

        <div class="w-full max-h-[360px] overflow-x-auto overflow-y-auto border border-navy-200 dark:border-navy-800 rounded-xl bg-white dark:bg-navy-950 scrollbar-thin">
          <table class="table-premium w-full min-w-[760px] tabular-nums text-xs sm:text-sm">
            <colgroup>
              <col class="w-[10%]" />
              <col class="w-[15%]" />
              <col class="w-[15%]" />
              <col class="w-[15%]" />
              <col class="w-[15%]" />
              <col class="w-[15%]" />
              <col class="w-[15%]" />
            </colgroup>
            <thead class="sticky top-0 z-20 bg-navy-100 dark:bg-navy-900 border-b border-navy-200 dark:border-navy-800">
              <tr>
                <th class="py-2.5 px-3 text-left font-bold text-navy-700 dark:text-navy-300 whitespace-nowrap">Year</th>
                <th class="py-2.5 px-3 text-right font-bold text-navy-700 dark:text-navy-300 whitespace-nowrap">Monthly SIP</th>
                <th class="py-2.5 px-3 text-right font-bold text-navy-700 dark:text-navy-300 whitespace-nowrap">Invested Total</th>
                <th class="py-2.5 px-3 text-right font-bold text-emerald-700 dark:text-emerald-400 whitespace-nowrap">Wealth Gained</th>
                <th class="py-2.5 px-3 text-right font-bold text-rose-700 dark:text-rose-400 whitespace-nowrap">10th Pct (Bear)</th>
                <th class="py-2.5 px-3 text-right font-bold text-navy-900 dark:text-navy-100 whitespace-nowrap">50th Pct (Typical)</th>
                <th class="py-2.5 px-3 text-right font-bold text-emerald-700 dark:text-emerald-400 whitespace-nowrap">90th Pct (Bull)</th>
              </tr>
            </thead>
            <tbody id="sipScheduleTableBody" class="divide-y divide-navy-100 dark:divide-white/5 bg-white dark:bg-navy-950">
              <!-- Populated dynamically -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- Tab Pane 3: Downside Put Protection Ledger -->
    <div id="tabPaneSipHedging" class="hidden w-full max-w-full space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-navy-200 dark:border-navy-800 pb-3">
        <div class="space-y-0.5">
          <h4 class="text-sm font-bold text-navy-900 dark:text-navy-100">
            Rolling Put Protection Cost & Absorption Ledger
          </h4>
          <p class="text-xs text-navy-500 dark:text-navy-400">
            Black-Scholes rolling 12-month puts on the share sleeve.
          </p>
        </div>
        <span id="bsStatusBadge" class="badge-warning text-xs">NO PROTECTION BOUGHT</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-xl p-4 space-y-1">
          <span class="text-xs font-bold text-navy-500 dark:text-navy-400">Annual Option Drag Cost</span>
          <div id="valHedgingDrag" class="text-lg font-bold text-navy-900 dark:text-navy-100">0.00% / Year</div>
          <span class="text-xs text-navy-500 dark:text-navy-400">Charged on the equity sleeve</span>
        </div>
        <div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-xl p-4 space-y-1">
          <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400">Floor Cumulative Payout</span>
          <div id="valProtectedFloor" class="text-lg font-bold text-emerald-700 dark:text-emerald-400">₹ 0</div>
          <span class="text-xs text-navy-500 dark:text-navy-400">Paid out during severe market drops</span>
        </div>
      </div>

      <p id="ledgerCaption" class="text-xs text-navy-500 dark:text-navy-400">
        Every figure below is in today's money and comes from the simulation itself.
      </p>

      <div class="w-full max-h-[360px] overflow-x-auto overflow-y-auto border border-navy-200 dark:border-navy-800 rounded-xl bg-white dark:bg-navy-950 scrollbar-thin">
        <table class="table-premium w-full min-w-[720px] tabular-nums text-xs sm:text-sm">
          <colgroup>
            <col class="w-[10%]" />
            <col class="w-[18%]" />
            <col class="w-[18%]" />
            <col class="w-[18%]" />
            <col class="w-[18%]" />
            <col class="w-[18%]" />
          </colgroup>
          <thead class="sticky top-0 z-20 bg-navy-100 dark:bg-navy-900 border-b border-navy-200 dark:border-navy-800">
            <tr>
              <th class="py-2.5 px-3 text-left font-bold text-navy-700 dark:text-navy-300 whitespace-nowrap">Year</th>
