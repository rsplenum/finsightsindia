---
// SipIntro.astro — Welcome and Single-Entry Question for the SIP Planner (dd-024 / dd-022)
// Presents the 3 core promises and begins with the reader's monthly investment.
import CardPremium from '../CardPremium.astro';
---

<section id="sipIntro" class="max-w-4xl mx-auto py-6 sm:py-10 space-y-8 transition-opacity duration-300">
  
  <!-- Hero Card with The 3 Core Promises -->
  <CardPremium glass={true} class="p-6 sm:p-10 space-y-8">
    <div class="space-y-3 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wide bg-gold-500/10 text-gold-700 dark:text-gold-400 border border-gold-500/20">
        <span class="w-2 h-2 rounded-full bg-gold-500"></span>
        <span>Interactive Wealth Accumulation Simulation</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-navy-900 dark:text-navy-100">
        Systematic Investment & Wealth Goal Planner
      </h1>
      <p class="text-base sm:text-lg text-navy-600 dark:text-navy-300 max-w-2xl leading-relaxed">
        A generic calculator assumes one fixed compound return every year. FinSight stress-tests your savings across 10,000 empirical market paths to reveal what your wealth will actually buy in today's money.
      </p>
    </div>

    <!-- 3 Core Promises Grid (dd-024) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
      
      <div class="rounded-xl p-4 bg-navy-50/70 dark:bg-navy-900/60 border border-navy-200/80 dark:border-navy-800 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 flex items-center justify-center font-bold text-sm">
          01
        </div>
        <h2 class="text-sm font-bold text-navy-900 dark:text-navy-100">10,000 Market Futures</h2>
        <p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed">
          Stress-tested against real historical volatility, boom cycles, and crash sequences of the Nifty 50.
        </p>
      </div>

      <div class="rounded-xl p-4 bg-navy-50/70 dark:bg-navy-900/60 border border-navy-200/80 dark:border-navy-800 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-navy-500/10 text-navy-700 dark:text-navy-300 flex items-center justify-center font-bold text-sm">
          02
        </div>
        <h2 class="text-sm font-bold text-navy-900 dark:text-navy-100">Real Purchasing Power</h2>
        <p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed">
          Adjusted for annual CPI inflation and LTCG taxes, expressed in what your money buys today.
        </p>
      </div>

      <div class="rounded-xl p-4 bg-navy-50/70 dark:bg-navy-900/60 border border-navy-200/80 dark:border-navy-800 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-gold-500/10 text-gold-700 dark:text-gold-400 flex items-center justify-center font-bold text-sm">
          03
        </div>
        <h2 class="text-sm font-bold text-navy-900 dark:text-navy-100">Step-Up & Hedging</h2>
        <p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed">
          Model real career progression raises and test Black-Scholes rolling put protection against deep drawdowns.
        </p>
      </div>

    </div>

    <!-- The Single Question to Start (dd-022 / dd-024) -->
    <div class="pt-6 border-t border-navy-200 dark:border-navy-800 space-y-6">
      <div class="space-y-1">
        <label for="introMonthlySip" class="block text-base sm:text-lg font-bold text-navy-900 dark:text-navy-100">
          How much can you invest every month?
        </label>
        <p class="text-xs sm:text-sm text-navy-500 dark:text-navy-400">
          Your regular monthly savings into equity funds, debt, and gold assets.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <div class="relative flex-1">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-navy-500 dark:text-navy-400 font-semibold text-lg">
            ₹
          </span>
          <input
            id="introMonthlySip"
            type="text"
            inputmode="numeric"
            value="25,000"
            placeholder="25,000"
            class="w-full pl-9 pr-4 py-3 text-lg font-bold text-navy-900 dark:text-navy-100 bg-white dark:bg-navy-950 border border-navy-300 dark:border-navy-700 rounded-xl focus:ring-2 focus:ring-gold-500 focus:border-gold-500 transition-colors shadow-2xs"
            aria-label="Monthly investment amount in rupees"
          />
        </div>
        <button
          id="introSipStartBtn"
          type="button"
          class="min-h-[48px] px-6 py-3 bg-gold-500 hover:bg-gold-400 text-navy-950 font-bold rounded-xl shadow-md transition-all duration-200 flex items-center justify-center gap-2 shrink-0 cursor-pointer"
        >
          <span>Begin Stress-Test</span>
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </button>
      </div>

      <!-- Milestone Quick Starting Chips (dd-022) -->
      <div class="space-y-2 pt-1">
        <span class="text-xs font-semibold text-navy-600 dark:text-navy-400">
          Or pick a starting monthly contribution:
        </span>
        <div class="flex flex-wrap gap-2">
          <button type="button" data-value="10000" class="intro-sip-milestone-btn min-h-[40px] px-3.5 py-1.5 rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 text-xs font-bold text-navy-700 dark:text-navy-300 hover:border-gold-500 hover:text-gold-700 dark:hover:text-gold-400 transition-colors cursor-pointer">
            ₹ 10,000 / mo
          </button>
          <button type="button" data-value="25000" class="intro-sip-milestone-btn min-h-[40px] px-3.5 py-1.5 rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 text-xs font-bold text-navy-700 dark:text-navy-300 hover:border-gold-500 hover:text-gold-700 dark:hover:text-gold-400 transition-colors cursor-pointer">
            ₹ 25,000 / mo
          </button>
          <button type="button" data-value="50000" class="intro-sip-milestone-btn min-h-[40px] px-3.5 py-1.5 rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 text-xs font-bold text-navy-700 dark:text-navy-300 hover:border-gold-500 hover:text-gold-700 dark:hover:text-gold-400 transition-colors cursor-pointer">
            ₹ 50,000 / mo
          </button>
          <button type="button" data-value="100000" class="intro-sip-milestone-btn min-h-[40px] px-3.5 py-1.5 rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 text-xs font-bold text-navy-700 dark:text-navy-300 hover:border-gold-500 hover:text-gold-700 dark:hover:text-gold-400 transition-colors cursor-pointer">
            ₹ 1,00,000 / mo
          </button>
        </div>
      </div>

    </div>

  </CardPremium>

</section>
