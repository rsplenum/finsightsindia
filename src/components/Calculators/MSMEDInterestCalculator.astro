---
// MSMEDInterestCalculator.astro
---

<div class="bg-white dark:bg-navy-900 rounded-2xl shadow-xl border border-slate-200 dark:border-navy-700 overflow-hidden my-12 font-sans msmed-calculator transition-colors duration-300">
  <div class="bg-brand-navy dark:bg-navy-950 p-6 text-white border-b-4 border-brand-gold">
    <h3 class="text-2xl font-bold m-0 flex items-center">
      <svg class="w-6 h-6 mr-3 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      MSMED Penal Interest Calculator
    </h3>
    <p class="text-slate-300 dark:text-navy-300 text-sm mt-2 mb-0 opacity-90">Calculate the Section 16 compound interest liability on delayed MSME payments.</p>
  </div>
  
  <div class="p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Inputs -->
    <div class="space-y-6">
      
      <div>
        <div class="flex justify-between mb-1">
          <label class="text-sm font-semibold text-slate-700 dark:text-navy-300">Invoice Amount</label>
          <span class="text-sm font-bold text-brand-navy dark:text-gold-500" id="msmed-val-amount">₹10,00,000</span>
        </div>
        <input type="range" id="msmed-in-amount" min="10000" max="10000000" step="10000" value="1000000" class="w-full h-2 bg-slate-200 dark:bg-navy-700 rounded-lg appearance-none cursor-pointer accent-brand-navy dark:accent-gold-500" />
      </div>

      <div>
        <div class="flex justify-between mb-1">
          <label class="text-sm font-semibold text-slate-700 dark:text-navy-300">RBI Repo Rate</label>
          <span class="text-sm font-bold text-slate-600 dark:text-slate-400" id="msmed-val-rbi">6.5%</span>
        </div>
        <input type="range" id="msmed-in-rbi" min="4.0" max="10.0" step="0.25" value="6.5" class="w-full h-2 bg-slate-200 dark:bg-navy-700 rounded-lg appearance-none cursor-pointer accent-slate-600 dark:accent-slate-400" />
      </div>

      <div>
        <div class="flex justify-between mb-1">
          <label class="text-sm font-semibold text-slate-700 dark:text-navy-300">Days Delayed (Beyond 45)</label>
          <span class="text-sm font-bold text-rose-600 dark:text-rose-400" id="msmed-val-days">90 Days</span>
        </div>
        <input type="range" id="msmed-in-days" min="1" max="365" step="1" value="90" class="w-full h-2 bg-slate-200 dark:bg-navy-700 rounded-lg appearance-none cursor-pointer accent-rose-600 dark:accent-rose-400" />
      </div>

      <div class="bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 rounded-lg p-3 mt-4">
         <p class="text-xs text-blue-800 dark:text-blue-300 m-0 leading-tight">
           <strong>Section 16 Rule:</strong> Interest is compounded monthly at three times the RBI bank rate.
         </p>
      </div>
    </div>

    <!-- Outputs -->
    <div class="bg-slate-50 dark:bg-navy-800 p-6 rounded-xl border border-slate-200 dark:border-navy-700 flex flex-col justify-center transition-colors">
      
      <div class="mb-6">
        <h4 class="text-xs font-bold text-slate-400 dark:text-navy-400 uppercase tracking-wider mb-2">Penal Interest Owed</h4>
        <div id="msmed-out-interest" class="text-4xl font-extrabold font-mono tracking-tight text-rose-600 dark:text-rose-500">
          ₹0
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 pt-6 border-t border-slate-200 dark:border-navy-700">
        <div>
          <p class="text-xs font-semibold text-slate-500 dark:text-navy-400 mb-1">Total Payable</p>
          <p id="msmed-out-total" class="text-xl font-bold text-slate-800 dark:text-white">₹0</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-slate-500 dark:text-navy-400 mb-1">Effective Rate (3x)</p>
          <p id="msmed-out-rate" class="text-lg font-bold text-brand-navy dark:text-gold-500">19.5% p.a.</p>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function initMSMEDCalculator() {
    const calc = document.querySelector('.msmed-calculator');
    if (!calc) return;

    const inAmount = document.getElementById('msmed-in-amount');
    const inRBI = document.getElementById('msmed-in-rbi');
    const inDays = document.getElementById('msmed-in-days');

    const valAmount = document.getElementById('msmed-val-amount');
    const valRBI = document.getElementById('msmed-val-rbi');
    const valDays = document.getElementById('msmed-val-days');

    const outInterest = document.getElementById('msmed-out-interest');
    const outTotal = document.getElementById('msmed-out-total');
    const outRate = document.getElementById('msmed-out-rate');

    const formatCurrency = (amount) => {
      return new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        maximumFractionDigits: 0
      }).format(amount);
    };

    function calculate() {
      const principal = Number(inAmount.value);
      const rbiRate = Number(inRBI.value);
      const days = Number(inDays.value);

      valAmount.textContent = formatCurrency(principal);
      valRBI.textContent = rbiRate.toFixed(2) + '%';
      valDays.textContent = days + (days === 1 ? ' Day' : ' Days');

      // The MSMED penal rate is 3 times the RBI rate
      const penalRateAnnual = rbiRate * 3;
      outRate.textContent = penalRateAnnual.toFixed(2) + '% p.a.';

      // MSMED specifies compound interest with monthly rests.
      // Time in months (fractional)
      const timeInMonths = days / 30.4167; // average days in a month
      
      // Compound Interest formula: A = P(1 + r/n)^(nt)
      // Since it's monthly rests, n=12, r = penalRateAnnual/100, nt = timeInMonths
      const ratePerMonth = (penalRateAnnual / 100) / 12;
      const totalAmount = principal * Math.pow((1 + ratePerMonth), timeInMonths);
      
      const interestOwed = totalAmount - principal;

      outInterest.textContent = formatCurrency(interestOwed);
      outTotal.textContent = formatCurrency(totalAmount);
    }

    inAmount.addEventListener('input', calculate);
    inRBI.addEventListener('input', calculate);
    inDays.addEventListener('input', calculate);

    calculate(); // Initial run
  }

  // Handle Astro page transitions if they are enabled
  document.addEventListener('astro:page-load', initMSMEDCalculator);
  
  // Fallback for direct loads without view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMSMEDCalculator);
  } else {
    initMSMEDCalculator();
  }
</script>
