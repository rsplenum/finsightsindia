---
// Rung 5 of the ladder: "What does it cost to protect against that?"
//
// SECOND VERSION. The first was reviewed and rejected, and the entries it
// failed were the ones it had already cited by name in its own checks file:
//
//   dd-010 - it headlined survival averaged over all 10,000 futures, which is
//            a statistic and not a lived thing.
//   dd-009 - its verdict line read "- 2 in 100": a difference of two averages,
//            a quantity no reader can picture one instance of.
//   dd-007 - the single most consequential number on the screen, what the
//            protection actually costs, was set in the smallest grey type.
//
// dd-012 was written out of that review, and this rung is built to it:
// insurance does not exist to move an average, it exists for the futures where
// things go wrong, so those futures are what the screen leads with. The
// all-futures survival probability does not appear anywhere.
//
// Structure follows the reader's decision, not a sales order: the bill first,
// then what it buys, then what it does not buy. A limit the reader finds out
// about later is a limit we concealed.
import { REGIME_PRESETS } from '../../utils/regimePresets';
---

<section id="rungProtect" class="max-w-3xl mx-auto px-4 sm:px-6 py-4" aria-labelledby="rungProtectQ">
  <div class="card-premium rounded-2xl p-6 sm:p-8 space-y-7">

    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.11em] text-navy-500 dark:text-navy-400">
        Last question
      </p>
      <h2 id="rungProtectQ" class="text-xl sm:text-2xl font-bold tracking-tight text-navy-900 dark:text-navy-100 mt-1">
        What does it cost to protect against that?
      </h2>
      <p class="text-sm leading-relaxed text-navy-600 dark:text-navy-400 mt-2">
        The last step showed that a bad run early can hollow out a plan. You can
        pay someone to absorb part of it. Here is the bill, and here is what it buys.
      </p>
    </div>

    <!-- Name the thing before using it (dd-009). -->
    <p class="text-sm leading-relaxed text-navy-600 dark:text-navy-400 border-l-2 border-navy-200 dark:border-navy-700 pl-3">
      <b class="text-navy-800 dark:text-navy-200">You can buy a floor.</b>&#32;
      You pay a fee every year, and in exchange no single year can cost you more
      than <span id="pFloorWord">10%</span>. It settles on the <i>year</i>, not the
      month — a market that falls 25% in March and ends the year down 4% pays you
      nothing.
    </p>

    <!-- THE BILL. dd-007: this is the most consequential number on the screen,
         so it is the largest. Version one had it in the smallest grey type. -->
    <div class="rounded-xl border-2 border-rose-500/30 bg-rose-500/5 dark:bg-rose-500/10 p-5 space-y-3">
      <p class="text-sm font-semibold tracking-[0.11em] text-rose-700 dark:text-rose-400">
        What it costs you
      </p>
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span id="pFeeRupees" class="text-3xl sm:text-4xl font-bold tabular-nums text-rose-700 dark:text-rose-400">—</span>
        <span class="text-base text-navy-600 dark:text-navy-400">a year, every year</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
        <div>
          <p class="text-xs text-navy-600 dark:text-navy-400">as a share of savings</p>
          <p id="pFeePct" class="text-base font-semibold tabular-nums text-navy-900 dark:text-navy-100">—</p>
        </div>
        <div>
          <p id="pBiteLabel" class="text-xs text-navy-600 dark:text-navy-400">over 30 years the fee alone takes</p>
          <p id="pFeeBite" class="text-base font-semibold tabular-nums text-navy-900 dark:text-navy-100">—</p>
        </div>
        <div>
          <p class="text-xs text-navy-600 dark:text-navy-400">what that cover is actually worth</p>
          <p id="pFairValue" class="text-base font-semibold tabular-nums text-navy-900 dark:text-navy-100">—</p>
        </div>
      </div>
      <p class="text-sm leading-relaxed text-navy-600 dark:text-navy-400">
        The fee is charged whether the year is calm or brutal. You pay
        <span id="pMarkup" class="font-semibold text-navy-800 dark:text-navy-200">—</span>
        what the cover is worth, because the seller prices for a rougher market
        than anyone expects. That gap is their profit, and it is the reason
        insurance loses money on average.
      </p>
    </div>

    <!-- Floor depth is a PURCHASE, chosen between four alternatives - the case
         dd-006 explicitly allows a mode for. It was a slider first, and
         dragging it rewrote three paragraphs, which is the spot-the-difference
         puzzle that entry exists to forbid. -->
    <div class="space-y-2">
      <span class="block text-sm text-navy-700 dark:text-navy-300">
        How much of a fall you are willing to take yourself
      </span>
      <div id="floorGroup" role="radiogroup" aria-label="How deep a floor to buy"
           class="inline-flex flex-wrap rounded-lg border border-navy-200 dark:border-navy-700 p-0.5 bg-navy-50 dark:bg-navy-900/60"></div>
      <p class="text-xs text-navy-500 dark:text-navy-400">
        A shallower floor hands back less of the fall, so it costs more. You do
        not set the price — it follows from the cover you ask for.
      </p>
    </div>

    <!-- The control. -->
    <div class="space-y-2">
      <div class="flex items-baseline justify-between gap-4">
        <label for="protSlider" class="text-sm text-navy-700 dark:text-navy-300">
          How rough the market turns out to be
        </label>
        <output id="protValue" for="protSlider"
                class="text-lg font-bold tabular-nums text-navy-900 dark:text-navy-100">—</output>
      </div>
      <div class="relative pt-1 pb-6">
        <input id="protSlider" type="range" min="8" max="32" step="1" value="15"
               aria-describedby="protBoundary"
               class="w-full accent-gold-500 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500/50 rounded" />
        <div id="protMark" class="hidden absolute top-0 -translate-x-1/2 pointer-events-none">
          <div class="h-6 w-0.5 bg-rose-500/80 dark:bg-rose-400/80 mx-auto"></div>
          <div id="protMarkLabel"
               class="mt-0.5 whitespace-nowrap text-xs font-semibold text-rose-700 dark:text-rose-400 -translate-x-1/2 relative left-1/2"></div>
        </div>
        <!-- What the market actually did, marked on the track itself. -->
        {REGIME_PRESETS.map((p) => (
          <div class="regime-mark absolute top-0 -translate-x-1/2 pointer-events-none"
               data-roughness={String(p.roughness)} style="display:none">
            <div class="h-6 w-0.5 bg-navy-400/70 dark:bg-navy-500/70 mx-auto"></div>
            <div class="mt-0.5 whitespace-nowrap text-xs font-medium text-navy-500 dark:text-navy-400 -translate-x-1/2 relative left-1/2">
              {p.label.replace('The last ', 'last ')}
            </div>
          </div>
        ))}
      </div>
      <p id="pRoughMeaning" class="text-xs text-navy-500 dark:text-navy-400"></p>
    </div>

    <!-- WHAT IT BUYS - the bad futures, and only those (dd-012). -->
    <div>
      <p class="text-sm font-semibold text-navy-900 dark:text-navy-100 mb-2">
        Out of 100 retirements like yours, the ones where the money ran out
      </p>
      <div class="rounded-xl border border-navy-200 dark:border-navy-700 overflow-hidden">
        <div class="grid grid-cols-2">
          <div class="px-4 py-4 border-r border-navy-200 dark:border-navy-700">
            <p class="text-xs font-medium tracking-tight text-navy-600 dark:text-navy-400">Without the floor</p>
            <p id="pRuinU" class="mt-1 text-2xl font-bold tabular-nums text-navy-900 dark:text-navy-100">—</p>
          </div>
          <div class="px-4 py-4">
            <p class="text-xs font-medium tracking-tight text-navy-600 dark:text-navy-400">With the floor</p>
            <p id="pRuinP" class="mt-1 text-2xl font-bold tabular-nums text-navy-900 dark:text-navy-100">—</p>
          </div>
        </div>
        <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t border-navy-200 dark:border-navy-700 bg-navy-50/60 dark:bg-navy-900/40">
          <span id="pVerdictLabel" class="text-sm font-semibold text-navy-900 dark:text-navy-100">So the floor rescues</span>
          <span id="pVerdict" class="text-lg font-bold tabular-nums">—</span>
        </div>
      </div>
    </div>

    <!-- The boundary. One sentence covering the whole range of the control. -->
    <p id="protBoundary"
       class="rounded-lg bg-gold-500/10 border border-gold-500/30 px-4 py-3 text-sm leading-relaxed text-navy-800 dark:text-navy-200">
      Working out where the floor starts paying for itself…
    </p>

    <!-- WHAT IT DOES NOT BUY. Rahul: a floor that resets is a hard sell, and
         he is right - so the limit is stated rather than discovered later. -->
    <div class="rounded-xl border border-navy-200 dark:border-navy-700 p-5 space-y-2">
      <p class="text-sm font-semibold tracking-[0.11em] text-navy-500 dark:text-navy-400">
        What it does not buy
      </p>
      <p id="pLimit" class="text-sm leading-relaxed text-navy-700 dark:text-navy-300"></p>
    </div>

    <!-- The principle. True at every position, so dragging never rewrites it. -->
    <div class="space-y-4 text-base leading-relaxed text-navy-800 dark:text-navy-200">
      <p>
        Insurance has a fixed price and a variable payout. You pay the same fee
        whether the decade is calm or savage; you are paid only in the savage
        one. So buying it is a bet that the world will turn out rougher than the
        price assumes — and the price was set by people who do this for a
        living, which is why the bet is not a free one.
      </p>
      <p>
        Which is why a floor can make things worse. In a calm market the fee is
        charged every year and the floor almost never triggers, so you have paid
        for a fire you never had. The protection only earns its price once the
        market is rough enough to keep setting fires.
      </p>
    </div>

    <div class="pt-4 border-t border-navy-200 dark:border-navy-800">
      <p class="text-sm text-navy-600 dark:text-navy-400">
        That is the ladder. Everything above was one question at a time; if you
        want all of it at once — every assumption, every year, every figure —&#32;
        <span class="font-medium text-navy-800 dark:text-navy-200">the full workings are below.</span>
      </p>
    </div>

  </div>
</section>

<script>
  const $ = (id: string) => document.getElementById(id);
  const pct = (n: number, dp = 2) => `${n < 0 ? '−' : ''}${Math.abs(n).toFixed(dp)}%`;

  function money(n: number): string {
    const v = Math.round(Math.abs(n));
    if (v >= 10000000) return `₹${(v / 10000000).toFixed(2)} crore`;
    if (v >= 100000) return `₹${(v / 100000).toFixed(2)} lakh`;
    return `₹${v.toLocaleString('en-IN')}`;
  }

  let surface: any = null;
  let curve: any = null;
  let inputs: any = null;

  function pointAt(roughness: number) {
    if (!curve?.points?.length) return null;
    let best = curve.points[0];
    if (!best) return null;
    for (const p of curve.points) {
      if (p && Math.abs(p.roughness - roughness) < Math.abs(best.roughness - roughness)) best = p;
    }
    return best;
  }

  function paintBill() {
    if (!curve || !inputs) return;
    // Values in fixed slots, so switching cover ticks digits in known places
    // rather than rewriting paragraphs (dd-008).
    $('pFeeRupees')!.textContent = money(inputs.initialCorpus * (curve.premium / 100));
    $('pFeePct')!.textContent = `${pct(curve.premium)} a year`;

    // Traceable from the row beside it: the same fee, compounded.
    const bite = (1 - Math.pow(1 - curve.premium / 100, inputs.horizonYears)) * 100;
    $('pBiteLabel')!.textContent = `over ${inputs.horizonYears} years the fee alone takes`;
    $('pFeeBite')!.textContent = pct(bite, 0);

    $('pFairValue')!.textContent = `${pct(curve.fairValueAtReaderRoughness)} a year`;
    $('pMarkup')!.textContent = `${curve.markupAtReaderRoughness.toFixed(1)} times`;
  }

  function paintLimit() {
    if (!curve) return;
    const f = Math.abs(curve.floor);
    const three = (1 - Math.pow(1 - f / 100, 3)) * 100;
    $('pLimit')!.textContent =
      `The floor resets every year, so it stops one terrible year and not a long ` +
      `slide. Three bad years in a row cost you ${pct(f, 0)} each — about ` +
      `${pct(three, 0)} in total — and you pay the fee in all three. It is ` +
      `protection against a crash, not against a decade that simply goes nowhere.`;
  }

  function paintBoundary() {
    if (!curve) return;
    const el = $('protBoundary')!;
    const mark = $('protMark')!;

    if (curve.breakeven === null) {
      el.textContent =
        `Nowhere on this track does the floor leave fewer retirements ruined. ` +
        `At ${pct(curve.premium)} a year for a floor at ${pct(Math.abs(curve.floor), 0)}, ` +
        `the fee costs more plans than the cover saves however rough it gets.`;
      mark.classList.add('hidden');
      return;
    }

    el.textContent =
      `Below about ${pct(curve.breakeven, 0)} roughness this floor ruins more ` +
      `plans than it saves — you are paying for a fire you never have. Above ` +
      `that line it starts earning its price, because the market has turned out ` +
      `rougher than the premium was set for.`;

    const frac = (curve.breakeven - curve.min) / (curve.max - curve.min);
    mark.style.left = `${Math.min(100, Math.max(0, frac * 100))}%`;
    $('protMarkLabel')!.textContent = pct(curve.breakeven, 0);
    mark.classList.remove('hidden');
  }

  function paintRow(roughness: number) {
    const p = pointAt(roughness);
    if (!p) return;

    $('protValue')!.textContent = pct(p.roughness, 0);

    // Roughness defined by its consequence, not by a definition (dd-009).
    $('pRoughMeaning')!.textContent =
      p.oneYearIn > 100
        ? `At this level a year bad enough to trigger the floor almost never happens.`
        : `At this level, about 1 year in ${p.oneYearIn} ends more than ` +
          `${pct(Math.abs(curve.floor), 0)} down — which is when the floor pays.`;

    const u = Math.round(p.ruinedUnprotected);
    const s = Math.round(p.ruinedProtected);
    $('pRuinU')!.textContent = `${u} in 100`;
    $('pRuinP')!.textContent = `${s} in 100`;

    // Colour asserts better-or-worse and nothing else (dd-007).
    const tone = (bad: boolean) =>
      'mt-1 text-2xl font-bold tabular-nums ' +
      (bad ? 'text-rose-700 dark:text-rose-400' : 'text-emerald-700 dark:text-emerald-400');
    ($('pRuinU') as HTMLElement).className = tone(u > s);
    ($('pRuinP') as HTMLElement).className = tone(s > u);

    // The verdict is a COUNT OF RETIREMENTS - something the reader can picture
    // one of. Version one printed a difference of two averages here.
    const saved = u - s;
    const label = $('pVerdictLabel')!;
    const val = $('pVerdict') as HTMLElement;
    if (saved > 0) {
      label.textContent = 'So the floor rescues';
      val.textContent = `${saved} of them`;
      val.className = 'text-lg font-bold tabular-nums text-emerald-700 dark:text-emerald-400';
    } else if (saved < 0) {
      label.textContent = 'So the floor ruins a further';
      val.textContent = `${-saved} of them`;
      val.className = 'text-lg font-bold tabular-nums text-rose-700 dark:text-rose-400';
    } else {
      label.textContent = 'So the floor changes';
      val.textContent = 'nothing';
      val.className = 'text-lg font-bold tabular-nums text-navy-900 dark:text-navy-100';
    }
  }

  const slider = $('protSlider') as HTMLInputElement | null;
  slider?.addEventListener('input', () => paintRow(Number(slider.value)));

  const ON = 'bg-white dark:bg-navy-800 text-navy-900 dark:text-navy-100 shadow-sm';
  const OFF = 'text-navy-500 dark:text-navy-400 hover:text-navy-800 dark:hover:text-navy-200';
  const BTN = 'rounded-md px-3 py-1.5 text-xs font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500/50 ';

  let floorIndex = 0;

  function buildFloorButtons() {
    const group = $('floorGroup');
    if (!group || !surface) return;
    group.innerHTML = '';
    surface.curves.forEach((c: any, i: number) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('role', 'radio');
      b.dataset.index = String(i);
      b.textContent = pct(Math.abs(c.floor), 0);
      b.addEventListener('click', () => selectFloor(i));
      group.appendChild(b);
    });
  }

  function selectFloor(index: number) {
    if (!surface) return;
    floorIndex = Math.max(0, Math.min(surface.curves.length - 1, index));
    curve = surface.curves[floorIndex];
    for (const b of Array.from($('floorGroup')?.children ?? []) as HTMLElement[]) {
      const on = Number(b.dataset.index) === floorIndex;
      b.className = BTN + (on ? ON : OFF);
      b.setAttribute('aria-checked', String(on));
    }
    $('pFloorWord')!.textContent = pct(Math.abs(curve.floor), 0);
    paintBill();
    paintLimit();
    paintBoundary();
    paintRow(Number(slider?.value ?? inputs.annualVolatility));
  }

  window.addEventListener('swp:protection', (e) => {
    const d = (e as CustomEvent).detail;
    surface = d.surface;
    inputs = d.inputs;
    if (!surface?.curves?.length) return;

    if (slider) {
      const c0 = surface.curves[0];
      slider.min = String(c0.min);
      slider.max = String(c0.max);
      slider.step = String(c0.step);
      // Read back from the slider, which snaps to the step - painting the
      // unsnapped value once put a readout on screen that disagreed with where
      // the thumb actually sat.
      slider.value = String(inputs.annualVolatility);
    }
    // Position the historical markers on the track. Hidden if a period falls
    // outside the range rather than clamped to the edge, because a marker at
    // the end of the track would assert a value it does not have.
    for (const m of Array.from(document.querySelectorAll('.regime-mark')) as HTMLElement[]) {
      const r = Number(m.dataset.roughness);
      const c0 = surface.curves[0];
      if (r < c0.min || r > c0.max) { m.style.display = 'none'; continue; }
      m.style.left = `${((r - c0.min) / (c0.max - c0.min)) * 100}%`;
      m.style.display = '';
    }

    buildFloorButtons();
    const at = surface.curves.findIndex((c: any) => c.floor === surface.readerFloor);
    selectFloor(at >= 0 ? at : 0);
  });
</script>
