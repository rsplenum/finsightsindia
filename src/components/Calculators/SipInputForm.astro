---
// SipInputForm.astro — Unified, Intuitive 4-Card Input Deck & Transparent Assumptions
// Human-centric layout with live sliders, instant preset pills, baseline summary strip, and collapsible advanced options.
import CardPremium from '../CardPremium.astro';
import { REGIME_PRESETS, DEFAULT_REGIME } from '../../utils/regimePresets';
import {
  FUND_COST_PLANS, DEFAULT_FUND_COST, SEBI_EQUITY_TER_CAP,
} from '../../utils/fundCosts';
---

<div class="space-y-6">
  <!-- Core 4 Inputs Grid (1 col mobile, 2 col desktop) -->
  <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr] gap-4 sm:gap-6 transition-all duration-300 ease-in-out">
    
    <!-- Card 1: Monthly Investment -->
    <CardPremium glass={true} class="p-4 sm:p-5 flex flex-col justify-between space-y-3.5 hover:border-gold-500/40 transition-colors">
      <div>
        <div class="flex items-center justify-between">
          <label for="monthlySip" class="text-xs sm:text-sm font-bold text-navy-800 dark:text-navy-200">
            Monthly Savings
          </label>
          <span id="sipFormatted" class="text-xs font-semibold px-2 py-0.5 rounded bg-gold-50 dark:bg-gold-950/40 text-gold-800 dark:text-gold-300 border border-gold-200/60 dark:border-gold-800/60">
            ₹ 25,000 / mo
          </span>
        </div>
        <p class="text-xs text-navy-500 dark:text-navy-400 mt-1">
          Regular monthly contribution into equity, debt, and gold funds.
        </p>
        <div class="mt-2.5 relative rounded-lg border border-navy-200 dark:border-navy-800 focus-within:border-gold-500 dark:focus-within:border-gold-500 bg-white dark:bg-navy-950 transition-colors">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-navy-400 font-semibold text-sm">₹</span>
          <input
            id="monthlySip"
            type="text"
            inputmode="numeric"
            value="25,000"
            class="w-full pl-7 pr-12 py-2 text-base sm:text-lg font-bold tabular-nums text-navy-950 dark:text-white bg-transparent focus:outline-none"
          />
          <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-xs text-navy-400">/ mo</span>
        </div>
        <input
          id="sipSlider"
          type="range"
          min="2000"
          max="200000"
          step="1000"
          value="25000"
          class="w-full mt-2.5 accent-gold-600 dark:accent-gold-500 cursor-pointer"
        />
      </div>

      <!-- Quick Preset Selection Pills -->
      <div class="grid grid-cols-5 gap-1.5 sm:gap-2 pt-2.5 border-t border-navy-100/80 dark:border-navy-900/80">
        <button type="button" data-set-sip="10000" class="sip-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">₹10k</button>
        <button type="button" data-set-sip="25000" class="sip-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-gold-500 bg-gold-50/50 dark:bg-gold-950/30 text-gold-700 dark:text-gold-300 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">₹25k</button>
        <button type="button" data-set-sip="50000" class="sip-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">₹50k</button>
        <button type="button" data-set-sip="75000" class="sip-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">₹75k</button>
        <button type="button" data-set-sip="100000" class="sip-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">₹1 Lakh</button>
      </div>
    </CardPremium>

    <!-- Card 2: Investment Horizon -->
    <CardPremium glass={true} class="p-4 sm:p-5 flex flex-col justify-between space-y-3.5 hover:border-gold-500/40 transition-colors">
      <div>
        <div class="flex items-center justify-between">
          <label for="investmentYears" class="text-xs sm:text-sm font-bold text-navy-800 dark:text-navy-200">
            Investment Horizon
          </label>
          <span id="yearsFormatted" class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/60">
            20 Years
          </span>
        </div>
        <p class="text-xs text-navy-500 dark:text-navy-400 mt-1">
          Accumulation duration before starting withdrawals or retirement.
        </p>
        <div class="mt-2.5 relative rounded-lg border border-navy-200 dark:border-navy-800 focus-within:border-gold-500 dark:focus-within:border-gold-500 bg-white dark:bg-navy-950 transition-colors">
          <input
            id="investmentYears"
            type="number"
            min="1"
            max="60"
            step="1"
            value="20"
            class="w-full px-3 py-2 text-base sm:text-lg font-bold tabular-nums text-navy-950 dark:text-white bg-transparent focus:outline-none"
          />
          <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-xs text-navy-400">Years</span>
        </div>
        <input
          id="yearsSlider"
          type="range"
          min="5"
          max="40"
          step="1"
          value="20"
          class="w-full mt-2.5 accent-gold-600 dark:accent-gold-500 cursor-pointer"
        />
      </div>

      <!-- Quick Preset Selection Pills -->
      <div class="grid grid-cols-5 gap-1.5 sm:gap-2 pt-2.5 border-t border-navy-100/80 dark:border-navy-900/80">
        <button type="button" data-set-years="10" class="years-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">10 Yrs</button>
        <button type="button" data-set-years="15" class="years-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">15 Yrs</button>
        <button type="button" data-set-years="20" class="years-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-gold-500 bg-gold-50/50 dark:bg-gold-950/30 text-gold-700 dark:text-gold-300 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">20 Yrs</button>
        <button type="button" data-set-years="25" class="years-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">25 Yrs</button>
        <button type="button" data-set-years="30" class="years-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">30 Yrs</button>
      </div>
    </CardPremium>

    <!-- Card 3: Target / Wealth Goal (In Today's Money) -->
    <CardPremium glass={true} class="p-4 sm:p-5 flex flex-col justify-between space-y-3.5 hover:border-gold-500/40 transition-colors">
      <div>
        <div class="flex items-center justify-between">
          <label for="targetRealWealth" class="text-xs sm:text-sm font-bold text-navy-800 dark:text-navy-200">
            Target Wealth Goal (Today's Purchasing Power)
          </label>
          <span id="targetFormatted" class="text-xs font-semibold px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">
            ₹ 1.00 Crore
          </span>
        </div>
        <p class="text-xs text-navy-500 dark:text-navy-400 mt-1">
          Expressed in what money buys today, not unadjusted future face value.
        </p>
        <div class="mt-2.5 relative rounded-lg border border-navy-200 dark:border-navy-800 focus-within:border-gold-500 dark:focus-within:border-gold-500 bg-white dark:bg-navy-950 transition-colors">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-navy-400 font-semibold text-sm">₹</span>
          <input
            id="targetRealWealth"
            type="text"
            inputmode="numeric"
            value="1,00,00,000"
            class="w-full pl-7 pr-3 py-2 text-base sm:text-lg font-bold tabular-nums text-navy-950 dark:text-white bg-transparent focus:outline-none"
          />
        </div>
        <input
          id="targetSlider"
          type="range"
          min="2500000"
          max="50000000"
          step="500000"
          value="10000000"
          class="w-full mt-2.5 accent-gold-600 dark:accent-gold-500 cursor-pointer"
        />
      </div>

      <!-- Quick Preset Selection Pills -->
      <div class="grid grid-cols-5 gap-1.5 sm:gap-2 pt-2.5 border-t border-navy-100/80 dark:border-navy-900/80">
        <button type="button" data-set-target="5000000" class="target-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">₹50 L</button>
        <button type="button" data-set-target="10000000" class="target-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-gold-500 bg-gold-50/50 dark:bg-gold-950/30 text-gold-700 dark:text-gold-300 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">₹1 Cr</button>
        <button type="button" data-set-target="20000000" class="target-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">₹2 Cr</button>
        <button type="button" data-set-target="30000000" class="target-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">₹3 Cr</button>
        <button type="button" data-set-target="50000000" class="target-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">₹5 Cr</button>
      </div>
    </CardPremium>

    <!-- Card 4: Savings Growth & Career Raise -->
    <CardPremium glass={true} class="p-4 sm:p-5 flex flex-col justify-between space-y-3.5 hover:border-gold-500/40 transition-colors">
      <div>
        <div class="flex items-center justify-between">
          <label for="sipRealStepUp" class="text-xs sm:text-sm font-bold text-navy-800 dark:text-navy-200">
            Annual Career Raise (Above Inflation)
          </label>
          <span id="stepUpFormatted" class="text-xs font-semibold px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/40 text-purple-800 dark:text-purple-300 border border-purple-200/60 dark:border-purple-800/60">
            +0.0% / yr real
          </span>
        </div>
        <p class="text-xs text-navy-500 dark:text-navy-400 mt-1">
          Base plan keeps pace with 6% inflation. Add extra % for salary hikes.
        </p>
        <div class="mt-2.5 relative rounded-lg border border-navy-200 dark:border-navy-800 focus-within:border-gold-500 dark:focus-within:border-gold-500 bg-white dark:bg-navy-950 transition-colors">
          <input
            id="sipRealStepUp"
            type="number"
            value="0"
            step="0.5"
            min="0"
            max="15"
            class="w-full px-3 py-2 text-base sm:text-lg font-bold tabular-nums text-navy-950 dark:text-white bg-transparent focus:outline-none"
          />
          <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-xs text-navy-400">% / yr above inflation</span>
        </div>
        <input
          id="stepUpSlider"
          type="range"
          min="0"
          max="10"
          step="0.5"
          value="0"
          class="w-full mt-2.5 accent-gold-600 dark:accent-gold-500 cursor-pointer"
        />
      </div>

      <!-- Quick Preset Selection Pills -->
      <div class="grid grid-cols-5 gap-1.5 sm:gap-2 pt-2.5 border-t border-navy-100/80 dark:border-navy-900/80">
        <button type="button" data-set-stepup="0" class="stepup-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-gold-500 bg-gold-50/50 dark:bg-gold-950/30 text-gold-700 dark:text-gold-300 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">0%</button>
        <button type="button" data-set-stepup="2" class="stepup-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">+2%</button>
        <button type="button" data-set-stepup="3" class="stepup-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">+3%</button>
        <button type="button" data-set-stepup="5" class="stepup-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">+5%</button>
        <button type="button" data-set-stepup="7" class="stepup-preset-btn min-h-[36px] px-1.5 sm:px-2 py-1.5 rounded-lg text-xs font-semibold border border-navy-200 dark:border-navy-800 hover:border-gold-500 text-navy-600 dark:text-navy-400 transition-all inline-flex items-center justify-center text-center whitespace-nowrap truncate w-full cursor-pointer">+7%</button>
      </div>
    </CardPremium>

  </div>

  <!-- Transparent Assumptions Summary Strip (Directly Visible, High-Contrast, No Scary Jargon) -->
  <div class="rounded-xl p-3 sm:p-4 bg-navy-50/70 dark:bg-navy-900/60 border border-navy-200/80 dark:border-navy-800/80 flex flex-wrap items-center justify-between gap-3 text-xs">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-navy-700 dark:text-navy-300">
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="font-medium text-navy-500 dark:text-navy-400">Asset Mix:</span>
        <span class="font-bold text-navy-900 dark:text-navy-100">70% Equity · 20% Debt · 10% Gold</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        <span class="font-medium text-navy-500 dark:text-navy-400">Inflation:</span>
        <span class="font-bold text-navy-900 dark:text-navy-100">6.0% / yr CPI</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-purple-500"></span>
        <span class="font-medium text-navy-500 dark:text-navy-400">LTCG Tax:</span>
        <span class="font-bold text-navy-900 dark:text-navy-100">12.5% on gains</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-gold-500"></span>
        <span class="font-medium text-navy-500 dark:text-navy-400">Simulation:</span>
        <span class="font-bold text-navy-900 dark:text-navy-100">10,000 Nifty 50 paths</span>
      </div>
    </div>

    <button
      type="button"
      id="openAssumptionsBtn"
      class="text-xs font-bold text-gold-700 dark:text-gold-400 hover:underline inline-flex items-center gap-1 cursor-pointer shrink-0"
    >
      <span>Refine assumptions</span>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
  </div>

  <!-- Sanity & Logic Feedback Warning Notice -->
  <div id="inputSanityWarning" class="hidden p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs leading-relaxed space-y-1">
    <div class="flex items-center gap-2 font-bold text-amber-800 dark:text-amber-300">
      <svg class="w-4 h-4 shrink-0 text-amber-700 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
      <span>Investment Plan Feasibility Notice</span>
    </div>
    <p id="inputSanityMessage" class="text-xs text-navy-700 dark:text-navy-300 leading-normal"></p>
  </div>

  <!-- Collapsible Details: Refine Planning Assumptions & Asset Allocation -->
  <CardPremium glass={true} class="p-0 overflow-hidden border border-navy-200/80 dark:border-navy-800/80">
    <details id="sipAssumptionsDetails" class="group">
      <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer bg-navy-50/50 dark:bg-navy-900/30 hover:bg-navy-100/50 dark:hover:bg-navy-900/60 transition-colors list-none">
        <div class="flex items-center gap-2.5">
          <span class="w-2.5 h-2.5 rounded-full bg-gold-500"></span>
          <span class="text-sm font-bold text-navy-900 dark:text-navy-100">
            Planning Assumptions & Asset Allocation
          </span>
          <span class="hidden sm:inline-block text-xs text-navy-500 dark:text-navy-400">
            (Nifty 50 Regimes, Lump Sum, Asset Allocation & Hedging)
          </span>
        </div>
        <div class="flex items-center gap-2 text-xs font-semibold text-navy-600 dark:text-navy-400">
          <span class="group-open:hidden">Customize</span>
          <span class="hidden group-open:inline">Hide</span>
          <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </summary>

      <div class="p-4 sm:p-6 space-y-6 border-t border-navy-200/80 dark:border-navy-800/80">
        
        <!-- Section A: Contribution Mode & Lump Sum -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <div class="space-y-2">
            <label for="sipContributionMode" class="text-xs font-bold text-navy-800 dark:text-navy-200">
              Contribution Interpretation
            </label>
            <select id="sipContributionMode" class="w-full rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-3 py-2 text-xs text-navy-800 dark:text-navy-200">
              <option value="real" selected>Constant purchasing power — raised each year with prices</option>
              <option value="salary">A fixed share of my monthly income</option>
              <option value="fixed">A flat rupee amount, never raised</option>
            </select>
            <p id="sipModeNote" class="text-xs text-navy-500 dark:text-navy-400 leading-relaxed"></p>

            <div id="sipSalaryFields" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div class="space-y-1">
                <label for="sipMonthlyIncome" class="text-xs font-bold text-navy-700 dark:text-navy-300">Monthly Income (₹)</label>
                <input id="sipMonthlyIncome" type="text" inputmode="numeric" value="1,25,000" class="w-full rounded border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-2 py-1.5 text-xs text-navy-900 dark:text-navy-100" />
              </div>
              <div class="space-y-1">
                <label for="sipSavingsRate" class="text-xs font-bold text-navy-700 dark:text-navy-300">Share You Save (%)</label>
                <input id="sipSavingsRate" type="number" value="20" min="1" max="80" step="1" class="w-full rounded border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-2 py-1.5 text-xs text-navy-900 dark:text-navy-100" />
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <label for="seedCapital" class="text-xs font-bold text-navy-800 dark:text-navy-200">
                Starting Lump Sum (Existing Portfolio)
              </label>
              <span id="seedFormatted" class="text-xs text-navy-500">₹ 0</span>
            </div>
            <div class="relative rounded-lg border border-navy-200 dark:border-navy-800 focus-within:border-gold-500 bg-white dark:bg-navy-950">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-navy-400 font-semibold text-xs">₹</span>
              <input
                id="seedCapital"
                type="text"
                inputmode="numeric"
                value="0"
                class="w-full pl-7 pr-3 py-2 text-xs sm:text-sm font-bold tabular-nums text-navy-950 dark:text-white bg-transparent focus:outline-none"
              />
            </div>
            <p class="text-xs text-navy-500 dark:text-navy-400">
              Existing mutual funds or savings currently invested.
            </p>
          </div>
        </div>

        <hr class="border-navy-200/60 dark:border-navy-800/60" />

        <!-- Section B: Inflation, Tax, Return & Volatility -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="space-y-1.5">
            <label for="inflationRate" class="text-xs font-bold text-navy-800 dark:text-navy-200">Inflation Rate (%)</label>
            <input id="inflationRate" type="number" min="0" max="20" step="0.5" value="6.0" class="w-full rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-3 py-2 text-xs sm:text-sm font-semibold tabular-nums text-navy-900 dark:text-navy-100" />
          </div>

          <div class="space-y-1.5">
            <label for="sipLtcgTax" class="text-xs font-bold text-navy-800 dark:text-navy-200">LTCG Tax Rate (%)</label>
            <input id="sipLtcgTax" type="number" min="0" max="50" step="0.1" value="12.5" class="w-full rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-3 py-2 text-xs sm:text-sm font-semibold tabular-nums text-navy-900 dark:text-navy-100" />
          </div>

          <div class="space-y-1.5">
            <label for="sipExpectedReturn" class="text-xs font-bold text-navy-800 dark:text-navy-200">Equity Growth (%)</label>
            <input id="sipExpectedReturn" type="number" min="0" max="30" step="0.5" value={DEFAULT_REGIME.growth.toFixed(1)} class="w-full rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-3 py-2 text-xs sm:text-sm font-semibold tabular-nums text-navy-900 dark:text-navy-100" />
          </div>

          <div class="space-y-1.5">
            <label for="sipVolatility" class="text-xs font-bold text-navy-800 dark:text-navy-200">Equity Roughness (%)</label>
            <input id="sipVolatility" type="number" min="5" max="50" step="0.5" value={DEFAULT_REGIME.roughness.toFixed(1)} class="w-full rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-3 py-2 text-xs sm:text-sm font-semibold tabular-nums text-navy-900 dark:text-navy-100" />
          </div>
        </div>

        <!-- Empirical Nifty 50 Regimes -->
        <div class="space-y-2">
          <div class="flex items-baseline justify-between gap-3">
            <span class="text-xs font-bold text-navy-700 dark:text-navy-300">
              Or pick an empirical period from Nifty 50 history:
            </span>
            <span class="text-xs text-navy-500">Historical dataset (1990–present)</span>
          </div>
          <div role="radiogroup" aria-label="Take growth and roughness from a real period" class="grid grid-cols-3 gap-2">
            {REGIME_PRESETS.map((p) => (
              <button type="button" role="radio" data-regime={p.id}
                  data-growth={String(p.growth)} data-roughness={String(p.roughness)}
                  class="sip-regime-btn border border-navy-200 dark:border-navy-800 rounded-lg p-2 text-left transition-colors hover:bg-navy-100 dark:hover:bg-navy-800 cursor-pointer">
                <span class="block text-xs font-bold text-navy-700 dark:text-navy-300">{p.label.replace('The last ', '')}</span>
                <span class="block text-xs tabular-nums text-navy-600 dark:text-navy-400">{p.growth}% · {p.roughness}% swings</span>
              </button>
            ))}
          </div>
          <p id="sipRegimeNote" class="text-xs leading-relaxed text-navy-500 dark:text-navy-400"></p>
        </div>

        <!-- Fund Expense Ratio -->
        <div class="space-y-2">
          <div class="flex items-baseline justify-between gap-3">
            <span class="text-xs font-bold text-navy-700 dark:text-navy-300">Fund Expense Ratio Plan</span>
            <span class="text-xs text-navy-500">SEBI equity TER cap: {SEBI_EQUITY_TER_CAP}%</span>
          </div>
          <select id="sipFundPlan" class="w-full rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-3 py-2 text-xs text-navy-800 dark:text-navy-200">
            {FUND_COST_PLANS.map((p) => (
              <option value={p.id} selected={p.id === DEFAULT_FUND_COST.id}>
                {p.label} — {p.expenseRatio.toFixed(2)}% a year
              </option>
            ))}
          </select>
          <p id="sipFundNote" class="text-xs text-navy-500 dark:text-navy-400"></p>
        </div>

        <hr class="border-navy-200/60 dark:border-navy-800/60" />

        <!-- Section C: Asset Allocation -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-navy-800 dark:text-navy-200">Asset Allocation Mix</span>
            <span id="allocationTotalBadge" class="text-xs font-bold text-emerald-700 dark:text-emerald-400">Total: 100%</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <button type="button" data-preset="conservative" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-xs font-bold text-navy-600 dark:text-navy-400 rounded-lg transition-all py-1.5 px-2 text-center min-h-[36px] flex items-center justify-center cursor-pointer">Cautious</button>
            <button type="button" data-preset="balanced" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-xs font-bold text-navy-600 dark:text-navy-400 rounded-lg transition-all py-1.5 px-2 text-center min-h-[36px] flex items-center justify-center cursor-pointer">Balanced</button>
            <button type="button" data-preset="aggressive" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-xs font-bold text-navy-600 dark:text-navy-400 rounded-lg transition-all py-1.5 px-2 text-center min-h-[36px] flex items-center justify-center cursor-pointer">Bold</button>
            <button type="button" data-preset="fire" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-xs font-bold text-navy-600 dark:text-navy-400 rounded-lg transition-all py-1.5 px-2 text-center min-h-[36px] flex items-center justify-center cursor-pointer">Retire in 15</button>
          </div>

          <div class="space-y-2 pt-1">
            <div class="flex justify-between items-center text-xs">
              <span class="text-navy-700 dark:text-navy-300 font-medium">Shares (<span id="sipEquityLabel">historical period</span>)</span>
              <span id="equityVal" class="font-bold text-navy-900 dark:text-navy-100">70%</span>
            </div>
            <input type="range" id="equitySlider" min="0" max="100" value="70" class="w-full accent-navy-900 dark:accent-white cursor-pointer h-1.5 rounded-md bg-navy-200 dark:bg-navy-800" />
          </div>

          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs">
              <span class="text-navy-700 dark:text-navy-300 font-medium">Bonds and fixed income (7.1% a year)</span>
              <span id="debtVal" class="font-bold text-navy-900 dark:text-navy-100">20%</span>
            </div>
            <input type="range" id="debtSlider" min="0" max="100" value="20" class="w-full accent-navy-900 dark:accent-white cursor-pointer h-1.5 rounded-md bg-navy-200 dark:bg-navy-800" />
          </div>

          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs">
              <span class="text-navy-700 dark:text-navy-300 font-medium">Gold (8.5% a year)</span>
              <span id="goldVal" class="font-bold text-navy-900 dark:text-navy-100">10%</span>
            </div>
            <input type="range" id="goldSlider" min="0" max="100" value="10" class="w-full accent-navy-900 dark:accent-white cursor-pointer h-1.5 rounded-md bg-navy-200 dark:bg-navy-800" />
          </div>
        </div>

        <hr class="border-navy-200/60 dark:border-navy-800/60" />

        <!-- Section D: Downside Put Protection -->
        <div class="space-y-3">
          <div class="flex items-center justify-between gap-3">
            <span class="text-xs font-bold text-navy-800 dark:text-navy-200">
              Downside Protection (Rolling Put Options)
            </span>
            <label class="relative inline-flex items-center cursor-pointer shrink-0">
              <input type="checkbox" id="bsHedgingToggle" name="bsHedgingToggle" class="sr-only peer" />
              <div class="w-11 h-6 bg-navy-200 dark:bg-navy-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-navy-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:peer-checked:bg-emerald-500"></div>
            </label>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label for="sipHedgingDrag" class="text-xs font-bold text-navy-700 dark:text-navy-300">Priced Drag Cost (% / yr)</label>
              <input id="sipHedgingDrag" type="number" value="1.85" min="0" max="10" step="0.05" readonly class="w-full rounded-lg border border-navy-200 dark:border-navy-800 bg-navy-50 dark:bg-navy-900/50 px-3 py-2 text-xs font-semibold tabular-nums text-navy-500" />
            </div>
            <div class="space-y-1">
              <label for="sipHedgingFloor" class="text-xs font-bold text-navy-700 dark:text-navy-300">Protection Floor Drop (%)</label>
              <input id="sipHedgingFloor" type="number" value="-10" max="0" min="-50" step="1" class="w-full rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-3 py-2 text-xs font-semibold tabular-nums text-navy-900 dark:text-navy-100" />
            </div>
          </div>
        </div>

      </div>
    </details>
  </CardPremium>
</div>
