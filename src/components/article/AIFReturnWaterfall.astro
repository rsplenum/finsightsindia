---
// AIFReturnWaterfall.astro
// Visual breakdown of gross return vs structural frictions and net investor IRR
---

<div class="my-10 bg-white dark:bg-navy-900 border border-slate-200 dark:border-navy-800 rounded-xl overflow-hidden shadow-sm not-prose font-sans w-full max-w-2xl mx-auto">
  <!-- Header -->
  <div class="px-6 py-4 border-b border-slate-200 dark:border-navy-800 bg-slate-50 dark:bg-navy-950/60 flex items-center justify-between">
    <div>
      <span class="text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 font-semibold block mb-0.5">Structural Breakdown</span>
      <h3 class="text-lg font-bold text-slate-900 dark:text-white m-0">The Return Friction Waterfall</h3>
    </div>
    <span class="text-xs font-semibold px-3 py-1 rounded-full bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800/60">
      -7.5% Structural Friction
    </span>
  </div>

  <!-- Content Rows -->
  <div class="p-6 space-y-3">
    <!-- Step 1: Gross Return -->
    <div class="flex items-center justify-between p-3.5 rounded-lg bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/50">
      <span class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
        Gross Portfolio Return
      </span>
      <span class="text-lg font-bold text-emerald-700 dark:text-emerald-400 tabular-nums">18.0%</span>
    </div>

    <!-- Deductions -->
    <div class="flex items-center justify-between px-4 py-2.5 rounded-lg bg-slate-50/80 dark:bg-navy-800/40 text-slate-700 dark:text-slate-200 text-sm sm:text-base">
      <span>Management Fee (Fixed 1.5–2%)</span>
      <span class="font-semibold text-rose-600 dark:text-rose-400 tabular-nums">-2.0%</span>
    </div>

    <div class="flex items-center justify-between px-4 py-2.5 rounded-lg bg-slate-50/80 dark:bg-navy-800/40 text-slate-700 dark:text-slate-200 text-sm sm:text-base">
      <span>Performance Fee / Carried Interest (20%)</span>
      <span class="font-semibold text-rose-600 dark:text-rose-400 tabular-nums">-2.4%</span>
    </div>

    <div class="flex items-center justify-between px-4 py-2.5 rounded-lg bg-slate-50/80 dark:bg-navy-800/40 text-slate-700 dark:text-slate-200 text-sm sm:text-base">
      <span>Custody, Admin & Statutory Audit</span>
      <span class="font-semibold text-rose-600 dark:text-rose-400 tabular-nums">-0.4%</span>
    </div>

    <!-- Highlighted Tax Drag Row -->
    <div class="flex items-center justify-between px-4 py-3 rounded-lg bg-amber-50/90 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-700/60 text-slate-900 dark:text-slate-100 text-sm sm:text-base">
      <span class="font-semibold text-amber-900 dark:text-amber-200 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        Fund-Level Tax Leakage (MMR / Business Drag)
      </span>
      <span class="font-bold text-rose-700 dark:text-rose-400 tabular-nums">-2.2%</span>
    </div>

    <div class="flex items-center justify-between px-4 py-2.5 rounded-lg bg-slate-50/80 dark:bg-navy-800/40 text-slate-700 dark:text-slate-200 text-sm sm:text-base">
      <span>Cash Reinvestment & Liquidity Lag</span>
      <span class="font-semibold text-rose-600 dark:text-rose-400 tabular-nums">-0.5%</span>
    </div>

    <!-- Step Final: Net Result (Light mode friendly, no jet-black block) -->
    <div class="pt-2">
      <div class="flex items-center justify-between p-4 rounded-xl bg-slate-100 dark:bg-navy-950 border border-slate-300 dark:border-navy-700">
        <div>
          <span class="text-xs uppercase font-bold tracking-wider text-slate-600 dark:text-slate-400 block">Actual Investor Net IRR</span>
          <span class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Net compounding return on family balance sheet</span>
        </div>
        <span class="text-2xl font-bold text-slate-900 dark:text-emerald-400 tabular-nums">10.5%</span>
      </div>
    </div>
  </div>

  <!-- Footnote -->
  <div class="px-6 py-3 bg-slate-50 dark:bg-navy-950/40 border-t border-slate-200 dark:border-navy-800 text-center">
    <p class="text-xs sm:text-sm italic text-slate-500 dark:text-slate-400 m-0">
      The number printed on the fund pitch deck is not the number that compounds in your bank account.
    </p>
  </div>
</div>
