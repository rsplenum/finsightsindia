---
// BonusStrippingHero.astro
---

<div class="relative w-full my-12 bg-navy-900 rounded-2xl overflow-hidden border border-navy-800 shadow-2xl p-6 sm:p-10 font-sans">
  
  <!-- Subtle Grid Background -->
  <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNDAiIGhlaWdodD0iNDAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGcgc3Ryb2tlPSJyZ2JhKDI1NSwyNTUsMjU1LDAuMDUpIiBzdHJva2Utd2lkdGg9IjEiIGZpbGw9Im5vbmUiPjxwYXRoIGQ9Ik00MCAwSDB2NDAiLz48L2c+PC9zdmc+')] opacity-50 z-0"></div>

  <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-8 items-center text-white">
    
    <!-- Left: Original Investment -->
    <div class="flex flex-col items-center">
      <div class="text-xs font-semibold text-navy-400 uppercase tracking-widest mb-3">Before Bonus</div>
      <div class="w-32 h-48 bg-gradient-to-br from-emerald-500 to-emerald-700 rounded-xl shadow-[0_0_40px_rgba(16,185,129,0.3)] flex items-center justify-center border border-emerald-400/30 transform transition-transform hover:scale-105 duration-500">
        <div class="text-center">
          <div class="text-3xl font-bold text-white tracking-tight">₹10L</div>
          <div class="text-xs font-medium text-emerald-100 opacity-80 mt-1">10,000 Units</div>
        </div>
      </div>
    </div>

    <!-- Center: The Action (Bonus Split) -->
    <div class="flex flex-col items-center justify-center relative h-full">
      <div class="hidden md:block absolute w-full h-px bg-gradient-to-r from-navy-700 via-gold-500/50 to-navy-700 top-1/2 -translate-y-1/2 -z-10"></div>
      
      <div class="bg-navy-950/80 backdrop-blur-md border border-navy-700 p-4 rounded-xl shadow-xl z-10 flex flex-col items-center min-w-[140px]">
        <div class="text-gold-400 text-xs font-bold uppercase tracking-widest mb-1">1:1 Bonus</div>
        <svg class="w-6 h-6 text-gold-500 mb-2 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path></svg>
        <div class="flex gap-2 items-center">
          <span class="text-red-400 font-bold">NAV ↓ 50%</span>
        </div>
      </div>
    </div>

    <!-- Right: The Illusion (Split State) -->
    <div class="flex flex-col gap-4 relative">
      <!-- Tax Ledger Overlay (Now in flow) -->
      <div class="bg-red-500/10 backdrop-blur-md border border-red-500/30 rounded-lg px-4 py-2 flex items-center gap-3 shadow-lg transform rotate-2 shadow-red-500/10 mx-auto w-max z-20 mb-2">
        <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        <div>
          <div class="text-[10px] text-red-300 uppercase tracking-widest font-semibold">Tax Ledger</div>
          <div class="text-sm font-bold text-red-400">Apparent ₹5L LOSS</div>
        </div>
      </div>

      <div class="text-xs font-semibold text-navy-400 uppercase tracking-widest text-center">After Sale</div>
      
      <!-- Retained Units -->
      <div class="relative bg-navy-800 border border-emerald-500/30 rounded-xl p-4 flex items-center justify-between overflow-hidden shadow-lg group">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-emerald-500"></div>
        <div>
          <div class="text-sm text-navy-300 font-medium">Retained Units</div>
          <div class="text-xl font-bold text-white mt-1">₹5L <span class="text-xs font-normal text-navy-400 ml-1">(10k units)</span></div>
        </div>
        <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center border border-emerald-500/30 text-emerald-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
        </div>
      </div>

      <!-- Cashed Out -->
      <div class="relative bg-navy-800 border border-gold-500/30 rounded-xl p-4 flex items-center justify-between overflow-hidden shadow-lg group">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gold-500"></div>
        <div>
          <div class="text-sm text-navy-300 font-medium">Cash Realized</div>
          <div class="text-xl font-bold text-white mt-1">₹5L <span class="text-xs font-normal text-navy-400 ml-1">(Original sold)</span></div>
        </div>
        <div class="w-10 h-10 rounded-full bg-gold-500/20 flex items-center justify-center border border-gold-500/30 text-gold-400">
          <span class="font-bold">₹</span>
        </div>
      </div>
    </div>

  </div>

</div>
