---
// EconomicPizzaDiagram.astro
---
<div class="my-10 bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-xl p-8 max-w-3xl mx-auto shadow-sm">
  <div class="text-center mb-8">
    <h3 class="text-lg font-bold text-navy-900 dark:text-white mb-2">The Mathematics of a Bonus</h3>
    <p class="text-sm text-navy-600 dark:text-navy-400">Total wealth remains identical; only the denominator changes.</p>
  </div>

  <div class="flex flex-col md:flex-row items-center justify-center gap-12">
    <!-- Left: Before Bonus -->
    <div class="flex flex-col items-center">
      <div class="relative w-40 h-40 rounded-full border-[12px] border-emerald-500/20 flex items-center justify-center bg-navy-100 dark:bg-navy-950 shadow-inner">
        <!-- 4 Slices simulation using borders/conic-gradient -->
        <div class="absolute inset-0 rounded-full bg-[conic-gradient(var(--tw-gradient-stops))] from-emerald-500 via-emerald-600 to-emerald-500 opacity-90" style="clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);">
           <!-- Slice lines -->
           <div class="absolute inset-0 w-full h-full">
             <div class="absolute top-0 bottom-0 left-1/2 w-1 bg-navy-50 dark:bg-navy-900 -translate-x-1/2"></div>
             <div class="absolute left-0 right-0 top-1/2 h-1 bg-navy-50 dark:bg-navy-900 -translate-y-1/2"></div>
           </div>
        </div>
        <div class="z-10 bg-navy-50 dark:bg-navy-900 rounded-full w-20 h-20 flex items-center justify-center shadow-lg border border-navy-200 dark:border-navy-700">
          <span class="font-bold text-navy-900 dark:text-white">₹10 CR</span>
        </div>
      </div>
      <div class="mt-6 text-center">
        <div class="text-xs uppercase tracking-widest text-navy-500 font-bold mb-1">Pre-Bonus</div>
        <div class="bg-white dark:bg-navy-950 border border-navy-200 dark:border-navy-700 rounded-lg px-4 py-2 text-sm shadow-sm">
          <div class="flex justify-between gap-4 mb-1 border-b border-navy-100 dark:border-navy-800 pb-1">
            <span class="text-navy-600 dark:text-navy-400">Units</span>
            <span class="font-semibold text-navy-900 dark:text-white">10 Lakh</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-navy-600 dark:text-navy-400">NAV</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">₹100</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Arrow -->
    <div class="text-navy-300 dark:text-navy-600 flex flex-col items-center">
      <div class="text-[10px] font-bold uppercase tracking-widest text-gold-500 mb-2">1:1 Bonus</div>
      <svg class="w-8 h-8 rotate-90 md:rotate-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path></svg>
    </div>

    <!-- Right: After Bonus -->
    <div class="flex flex-col items-center">
      <div class="relative w-40 h-40 rounded-full border-[12px] border-emerald-500/20 flex items-center justify-center bg-navy-100 dark:bg-navy-950 shadow-inner">
        <!-- 8 Slices simulation -->
        <div class="absolute inset-0 rounded-full bg-[conic-gradient(var(--tw-gradient-stops))] from-emerald-500 via-emerald-600 to-emerald-500 opacity-90">
           <!-- Slice lines -->
           <div class="absolute inset-0 w-full h-full">
             <div class="absolute top-0 bottom-0 left-1/2 w-0.5 bg-navy-50 dark:bg-navy-900 -translate-x-1/2"></div>
             <div class="absolute left-0 right-0 top-1/2 h-0.5 bg-navy-50 dark:bg-navy-900 -translate-y-1/2"></div>
             <div class="absolute top-0 bottom-0 left-1/2 w-0.5 bg-navy-50 dark:bg-navy-900 -translate-x-1/2 rotate-45"></div>
             <div class="absolute top-0 bottom-0 left-1/2 w-0.5 bg-navy-50 dark:bg-navy-900 -translate-x-1/2 -rotate-45"></div>
           </div>
        </div>
        <div class="z-10 bg-navy-50 dark:bg-navy-900 rounded-full w-20 h-20 flex items-center justify-center shadow-lg border border-navy-200 dark:border-navy-700">
          <span class="font-bold text-navy-900 dark:text-white">₹10 CR</span>
        </div>
      </div>
      <div class="mt-6 text-center">
        <div class="text-xs uppercase tracking-widest text-navy-500 font-bold mb-1">Post-Bonus</div>
        <div class="bg-white dark:bg-navy-950 border border-gold-500/30 rounded-lg px-4 py-2 text-sm shadow-sm ring-1 ring-gold-500/20">
          <div class="flex justify-between gap-4 mb-1 border-b border-navy-100 dark:border-navy-800 pb-1">
            <span class="text-navy-600 dark:text-navy-400">Units</span>
            <span class="font-semibold text-navy-900 dark:text-white">20 Lakh</span>
          </div>
          <div class="flex justify-between gap-4">
            <span class="text-navy-600 dark:text-navy-400">NAV</span>
            <span class="font-bold text-red-500">₹50</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
