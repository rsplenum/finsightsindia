---
// FinalWealthCircle.astro
---
<div class="my-10 bg-gradient-to-br from-navy-900 to-navy-950 border border-navy-800 rounded-2xl p-8 sm:p-12 shadow-2xl">
  <div class="max-w-2xl mx-auto flex flex-col md:flex-row items-center gap-12">
    
    <!-- Left: Original ₹10 Lakh -->
    <div class="flex-1 flex flex-col items-center">
      <div class="text-xs font-bold text-navy-400 uppercase tracking-widest mb-4">Original Wealth</div>
      <div class="w-32 h-32 rounded-full border-4 border-emerald-500/20 bg-navy-800 flex items-center justify-center shadow-inner relative overflow-hidden">
        <div class="absolute inset-0 bg-emerald-500 opacity-20"></div>
        <div class="z-10 text-xl font-bold text-white tracking-tight">₹10 Lakh</div>
      </div>
    </div>

    <!-- Center: Equality -->
    <div class="text-navy-500 hidden md:block">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 9h16M4 15h16"></path></svg>
    </div>
    
    <!-- Right: Split ₹10 Lakh -->
    <div class="flex-1 flex flex-col items-center">
      <div class="text-xs font-bold text-emerald-500 uppercase tracking-widest mb-4">Final Wealth</div>
      <div class="w-32 h-32 rounded-full border-4 border-emerald-500 bg-navy-800 flex flex-col shadow-[0_0_30px_rgba(16,185,129,0.2)] relative overflow-hidden">
        <!-- Top Half: Retained -->
        <div class="flex-1 bg-navy-800 flex items-center justify-center border-b border-navy-700">
          <div class="text-sm font-bold text-white">₹5L <span class="text-[10px] font-normal text-navy-400 block -mt-1">Retained Units</span></div>
        </div>
        <!-- Bottom Half: Cash -->
        <div class="flex-1 bg-gold-500/20 flex items-center justify-center">
          <div class="text-sm font-bold text-gold-400">₹5L <span class="text-[10px] font-normal text-gold-600/70 block -mt-1">Realized Cash</span></div>
        </div>
      </div>
    </div>

  </div>

  <div class="mt-10 text-center max-w-lg mx-auto">
    <p class="text-sm text-navy-300 leading-relaxed italic">
      "You cannot deduct a loss from your taxes when you haven't actually lost any money."
    </p>
  </div>
</div>
