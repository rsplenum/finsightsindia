---
export interface Props {
	id: string;
	label: string;
	required?: boolean;
	helpText?: string;
	tooltip?: string;
	formattedId?: string;
	formattedClass?: string;
	formattedDefault?: string;
	prefix?: string;
	suffix?: string;
	type?: 'text' | 'number';
	inputmode?: 'numeric' | 'text' | 'decimal';
	value?: string | number;
	min?: string | number;
	max?: string | number;
	step?: string | number;
}

const { 
	id, 
	label, 
	required = false, 
	helpText, 
	tooltip,
	formattedId, 
	formattedClass = "text-[11px] text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30 px-2 py-0.5 rounded font-medium border border-emerald-200 dark:border-emerald-800/50",
	formattedDefault,
	prefix, 
	suffix, 
	type = 'text', 
	inputmode = 'numeric',
	value, 
	min, 
	max, 
	step 
} = Astro.props;

// Determine padding based on prefix and suffix
let inputPadding = "py-3"; // increased padding for better touch target and elegance
if (prefix) inputPadding += " pl-9";
else inputPadding += " px-4";

if (suffix && suffix.length > 3) inputPadding += " pr-16";
else if (suffix) inputPadding += " pr-14";
else inputPadding += " pr-4";
---

<div class="flex flex-col gap-1.5">
	<div class="flex justify-between items-end">
		<label for={id} class="text-sm font-semibold text-slate-700 dark:text-slate-300">
			{label} {required && <span class="text-rose-500">*</span>}
		</label>

		{formattedId && (
			<span class={formattedClass} id={formattedId}>
				{formattedDefault}
			</span>
		)}
	</div>
	
	<div class="relative flex items-center group">
		{prefix && <span class="absolute left-3.5 text-base font-medium text-slate-400 dark:text-slate-500 select-none transition-colors group-focus-within:text-slate-600 dark:group-focus-within:text-slate-300">{prefix}</span>}
		<input 
			type={type} 
			inputmode={inputmode}
			id={id} 
			name={id} 
			value={value}
			min={min}
			max={max}
			step={step}
			required={required}
			class={`w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-base font-medium text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 rounded-xl focus:outline-none focus:ring-2 focus:ring-slate-400 dark:focus:ring-slate-500 focus:border-transparent transition-all shadow-sm ${inputPadding}`}
		/>
		{suffix && <span class="absolute right-3.5 text-sm font-medium text-slate-400 dark:text-slate-500 select-none transition-colors group-focus-within:text-slate-600 dark:group-focus-within:text-slate-300">{suffix}</span>}
	</div>

    {(helpText || tooltip) && (
        <p class="text-xs leading-snug text-slate-500 dark:text-slate-400 max-w-[90%]">
            {helpText || tooltip}
        </p>
    )}
</div>
