---
export interface Props {
	id: string;
	label: string;
	required?: boolean;
	tooltip?: string;
	formattedId?: string;
	formattedClass?: string;
	formattedDefault?: string;
	prefix?: string;
	suffix?: string;
	type?: 'text' | 'number';
	inputmode?: 'numeric' | 'text' | 'decimal';
	value?: string | number;
	min?: string | number;
	max?: string | number;
	step?: string | number;
}

const { 
	id, 
	label, 
	required = false, 
	tooltip, 
	formattedId, 
	formattedClass = "text-xs text-emerald-700 dark:text-emerald-300 badge-safe px-2 py-0.5 rounded-md font-medium",
	formattedDefault,
	prefix, 
	suffix, 
	type = 'text', 
	inputmode = 'numeric',
	value, 
	min, 
	max, 
	step 
} = Astro.props;

// Determine padding based on prefix and suffix
let inputPadding = "py-2.5";
if (prefix) inputPadding += " pl-9";
else inputPadding += " px-3.5";

if (suffix && suffix.length > 3) inputPadding += " pr-16";
else if (suffix) inputPadding += " pr-14";
else inputPadding += " pr-3.5";
---

<div>
	<div class="flex justify-between items-center mb-1.5">
		<div class="relative group inline-flex items-center gap-1.5 cursor-pointer">
			<label for={id} class="text-xs font-semibold text-navy-800 dark:text-navy-200 cursor-pointer">
				{label} {required && <span class="text-rose-500">*</span>}
			</label>
			{tooltip && (
				<>
					<svg tabindex="0" role="button" aria-labelledby={`tooltip-${id}`} class="w-3.5 h-3.5 text-navy-400 dark:text-navy-500 hover:text-navy-600 dark:hover:text-navy-300 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-full" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
					</svg>
					<div id={`tooltip-${id}`} role="tooltip" class="absolute z-50 invisible opacity-0 group-hover:visible group-focus-within:visible group-hover:opacity-100 group-focus-within:opacity-100 bg-navy-900 dark:bg-navy-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 sm:right-0 sm:left-auto pointer-events-none font-normal leading-normal">
						{tooltip}
					</div>
				</>
			)}
		</div>

		{formattedId && (
			<span class={formattedClass} id={formattedId}>
				{formattedDefault}
			</span>
		)}
	</div>
	<div class="relative flex items-center">
		{prefix && <span class="absolute left-3.5 text-sm text-navy-400 dark:text-navy-500 select-none">{prefix}</span>}
		<input 
			type={type} 
			inputmode={inputmode}
			id={id} 
			name={id} 
			value={value}
			min={min}
			max={max}
			step={step}
			required={required}
			aria-describedby={tooltip ? `tooltip-${id}` : undefined}
			class={`input-premium text-sm text-navy-900 dark:text-navy-100 placeholder:text-navy-400 dark:placeholder:text-navy-500 focus:outline-none w-full ${inputPadding}`}
		/>
		{suffix && <span class="absolute right-3.5 text-xs text-navy-400 dark:text-navy-500 select-none font-sans">{suffix}</span>}
	</div>
</div>
