---
export interface Props {
	id: string;
	label: string;
	required?: boolean;
	helpText?: string;
	tooltip?: string;
	formattedId?: string;
	formattedClass?: string;
	formattedDefault?: string;
	prefix?: string;
	suffix?: string;
	type?: 'text' | 'number';
	inputmode?: 'numeric' | 'text' | 'decimal';
	value?: string | number;
	min?: string | number;
	max?: string | number;
	step?: string | number;
	/**
	 * A field the engine writes and the reader only reads - the priced premium
	 * on both calculators. The planner already passed this and it was silently
	 * dropped, because the prop did not exist: a field its own tooltip calls
	 * "priced, not chosen" has been editable this whole time.
	 */
	readonly?: boolean;
}

const { 
	id, 
	label, 
	required = false, 
	helpText, 
	tooltip,
	formattedId, 
	formattedClass = "text-[11px] text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30 px-2 py-0.5 rounded font-medium border border-emerald-200 dark:border-emerald-800/50",
	formattedDefault,
	prefix, 
	suffix, 
	type = 'text', 
	inputmode = 'numeric',
	value,
	min,
	max,
	step,
	readonly = false
} = Astro.props;

// Determine padding based on prefix and suffix
let inputPadding = "py-3"; // increased padding for better touch target and elegance
if (prefix) inputPadding += " pl-9";
else inputPadding += " px-4";

if (suffix && suffix.length > 3) inputPadding += " pr-16";
else if (suffix) inputPadding += " pr-14";
else inputPadding += " pr-4";
---

<div class="flex flex-col gap-1.5">
	<div class="flex justify-between items-end">
		<label for={id} class="text-sm font-semibold text-navy-700 dark:text-navy-300">
			{label} {required && <span class="text-rose-700 dark:text-rose-400">*</span>}
		</label>

		{formattedId && (
			<span class={formattedClass} id={formattedId}>
				{formattedDefault}
			</span>
		)}
	</div>
	
	<div class="relative flex items-center group">
		{prefix && <span class="absolute left-3.5 text-base font-medium text-navy-500 dark:text-navy-400 select-none transition-colors group-focus-within:text-navy-700 dark:group-focus-within:text-navy-200">{prefix}</span>}
		<input 
			type={type} 
			inputmode={inputmode}
			id={id} 
			name={id} 
			value={value}
			min={min}
			max={max}
			step={step}
			required={required}
			readonly={readonly}
			aria-readonly={readonly ? 'true' : undefined}
			class={`w-full bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-700 text-base font-medium text-navy-900 dark:text-navy-100 placeholder:text-navy-500 dark:placeholder:text-navy-400 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-500 dark:focus:ring-navy-400 focus:border-transparent transition-all shadow-sm ${inputPadding} ${readonly ? 'cursor-default text-navy-600 dark:text-navy-400 bg-navy-50 dark:bg-navy-950' : ''}`}
		/>
		{suffix && <span class="absolute right-3.5 text-sm font-medium text-navy-500 dark:text-navy-400 select-none transition-colors group-focus-within:text-navy-700 dark:group-focus-within:text-navy-200">{suffix}</span>}
	</div>

    {(helpText || tooltip) && (
        <p class="text-xs leading-snug text-navy-600 dark:text-navy-400 max-w-[90%]">
            {helpText || tooltip}
        </p>
    )}
</div>
