---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const twitterUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const linkedinUrl = `https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}`;
const whatsappUrl = `https://api.whatsapp.com/send?text=${encodedTitle} ${encodedUrl}`;
---

<div class="flex items-center gap-3 mt-12 py-6 border-t border-navy-200 dark:border-navy-800">
  <span class="text-sm font-semibold text-navy-900 dark:text-navy-100 uppercase tracking-wider">Share:</span>
  
  <div class="flex gap-2">
    <a href={twitterUrl} target="_blank" rel="noopener noreferrer" class="p-2 border border-navy-200 dark:border-navy-700 rounded-full text-navy-600 dark:text-navy-400 hover:text-gold-600 hover:border-gold-500 dark:hover:text-gold-500 dark:hover:border-gold-500 transition-colors" aria-label="Share on X (Twitter)">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 24.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.008 5.961h-1.96z"/></svg>
    </a>
    
    <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="p-2 border border-navy-200 dark:border-navy-700 rounded-full text-navy-600 dark:text-navy-400 hover:text-gold-600 hover:border-gold-500 dark:hover:text-gold-500 dark:hover:border-gold-500 transition-colors" aria-label="Share on LinkedIn">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
    </a>
    
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="p-2 border border-navy-200 dark:border-navy-700 rounded-full text-navy-600 dark:text-navy-400 hover:text-gold-600 hover:border-gold-500 dark:hover:text-gold-500 dark:hover:border-gold-500 transition-colors" aria-label="Share on WhatsApp">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.891-4.444 9.891-9.891 0-5.446-4.443-9.89-9.891-9.89-5.446 0-9.89 4.444-9.89 9.89 0 2.094.646 3.811 1.756 5.516l-.986 3.606 3.732-.983zm6.864-7.94c-.333-.167-1.966-.973-2.272-1.083-.306-.11-.53-.167-.753.167-.223.334-.855 1.083-1.05 1.306-.194.222-.387.25-.72.083-.332-.167-1.401-.517-2.67-1.655-.986-.885-1.65-1.979-1.844-2.313-.193-.334-.02-.516.147-.682.149-.149.333-.388.5-.583.167-.194.223-.333.333-.555.11-.223.056-.417-.027-.584-.083-.167-.754-1.816-1.033-2.489-.271-.655-.546-.566-.753-.576-.194-.01-.417-.01-.64-.01s-.583.084-.888.417c-.305.334-1.166 1.139-1.166 2.778s1.194 3.222 1.36 3.444c.167.222 2.348 3.583 5.689 5.028.796.344 1.417.55 1.902.704.798.254 1.524.218 2.096.132.639-.096 1.966-.803 2.244-1.579.278-.776.278-1.442.195-1.579-.084-.136-.306-.217-.64-.383z"/></svg>
    </a>
    
    <button id="copy-link-btn" data-url={url} class="relative p-2 border border-navy-200 dark:border-navy-700 rounded-full text-navy-600 dark:text-navy-400 hover:text-gold-600 hover:border-gold-500 dark:hover:text-gold-500 dark:hover:border-gold-500 transition-colors" aria-label="Copy link">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
      <span id="copy-tooltip" class="absolute -top-10 left-1/2 -translate-x-1/2 bg-navy-900 text-white text-xs px-2 py-1 rounded opacity-0 transition-opacity duration-200 pointer-events-none whitespace-nowrap">Copied!</span>
    </button>
  </div>
</div>

<script>
  function setupCopyButton() {
    const copyBtn = document.getElementById('copy-link-btn');
    const tooltip = document.getElementById('copy-tooltip');
    
    if (copyBtn && tooltip) {
      // Remove old event listeners by replacing the node
      const newBtn = copyBtn.cloneNode(true) as HTMLButtonElement;
      if (copyBtn.parentNode) {
        copyBtn.parentNode.replaceChild(newBtn, copyBtn);
      }
      
      newBtn.addEventListener('click', async () => {
        const urlToCopy = newBtn.getAttribute('data-url');
        const newTooltip = newBtn.querySelector('#copy-tooltip') as HTMLElement;
        if (urlToCopy && newTooltip) {
          try {
            await navigator.clipboard.writeText(urlToCopy);
            newTooltip.classList.remove('opacity-0');
            newTooltip.classList.add('opacity-100');
            setTimeout(() => {
              newTooltip.classList.remove('opacity-100');
              newTooltip.classList.add('opacity-0');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy text: ', err);
          }
        }
      });
    }
  }

  // Setup on initial load
  setupCopyButton();
  // Setup on page navigation (view transitions)
  document.addEventListener('astro:page-load', setupCopyButton);
</script>
