---
import Layout from '../layouts/Layout.astro';
import reelScripts from '../data/reel-scripts.json';
---

<Layout title="100-Second Reels - FinSight INDIA" description="Short-form video scripts designed for high retention and virality.">
	
	<main class="min-h-screen bg-slate-50 dark:bg-navy-900 pt-24 pb-16">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
			
			<div class="mb-12 text-center">
				<h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4 flex items-center justify-center gap-3">
					<span class="text-4xl">🎬</span> 100-Second Reels
				</h1>
				<p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
					High-retention, anxiety-to-relief video scripts engineered for short-form platforms (Instagram Reels, YouTube Shorts).
				</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
				{reelScripts.map((reel) => (
					<div class="bg-white dark:bg-navy-800 rounded-3xl overflow-hidden shadow-sm border border-slate-200 dark:border-navy-700 flex flex-col group hover:shadow-xl transition-all duration-300 relative">
						
                        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-rose-500 to-amber-500"></div>

						<div class="p-6 md:p-8 flex-1">
                            <div class="flex items-center justify-between mb-4">
                                <span class="bg-rose-100 dark:bg-rose-950/50 text-rose-700 dark:text-rose-400 text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full border border-rose-200 dark:border-rose-900">
                                    {reel.duration} Script
                                </span>
                                <a href={`/tax-code/${reel.articleSlug}`} target="_blank" class="text-navy-400 hover:text-gold-500 transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                </a>
                            </div>

							<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6 group-hover:text-gold-500 transition-colors">
								{reel.title}
							</h2>
							
							<div class="mb-8 p-4 bg-amber-50 dark:bg-amber-950/20 border-l-4 border-amber-500 rounded-r-xl">
                                <p class="text-xs font-bold text-amber-700 dark:text-amber-500 uppercase tracking-wider mb-2">The Hook (0:00 - 0:05)</p>
								<p class="text-slate-800 dark:text-slate-200 font-medium italic">
                                    "{reel.hook}"
                                </p>
							</div>
							
							<div class="space-y-6">
                                {reel.script.map((segment) => (
                                    <div class="relative pl-6 border-l-2 border-slate-200 dark:border-navy-600">
                                        <div class="absolute -left-[9px] top-1 h-4 w-4 rounded-full border-4 border-white dark:border-navy-800 bg-navy-300 dark:bg-navy-500"></div>
                                        
                                        <span class="text-xs font-mono font-bold text-navy-500 dark:text-navy-400 block mb-2">{segment.time}</span>
                                        
                                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                                            <div class="md:col-span-5 bg-slate-50 dark:bg-navy-900/50 p-3 rounded-lg border border-slate-100 dark:border-navy-700">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                                    <span class="text-[10px] uppercase font-bold text-slate-500">Visual</span>
                                                </div>
                                                <p class="text-xs text-slate-600 dark:text-slate-400">{segment.visual}</p>
                                            </div>
                                            
                                            <div class="md:col-span-7">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <svg class="w-3 h-3 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path></svg>
                                                    <span class="text-[10px] uppercase font-bold text-gold-500">Audio</span>
                                                </div>
                                                <p class="text-sm font-medium text-slate-800 dark:text-slate-200">"{segment.audio}"</p>
                                            </div>
                                        </div>
                                    </div>
                                ))}
							</div>
						</div>
					</div>
				))}
			</div>
			
		</div>
	</main>
	
</Layout>
