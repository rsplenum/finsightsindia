---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SVG vs CSS Demo">
	<main class="min-h-screen bg-slate-50 dark:bg-navy-900 pt-32 pb-24 font-sans">
		<div class="max-w-7xl mx-auto px-4">
			<h1 class="text-3xl font-bold mb-12 text-slate-900 dark:text-white text-center">Hand-Coded Art Examples</h1>
			
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
				
				<!-- BAD EXAMPLE -->
				<div class="bg-white dark:bg-navy-800 p-8 rounded-3xl border-2 border-red-200 dark:border-red-900/50 shadow-xl">
					<div class="text-xs font-bold text-red-500 tracking-widest uppercase mb-2">Example 1: The "Metaphorical Scale"</div>
					<h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6">What happens when I try to draw organic art with raw math</h2>
					<p class="text-sm text-slate-600 dark:text-navy-300 mb-8">This is pure SVG code attempting to draw a scale. It looks incredibly rigid and amateurish because I am guessing coordinates instead of painting.</p>
					
					<div class="bg-white flex justify-center p-4 border border-slate-200 rounded-2xl">
						<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
							<!-- Base of the scale -->
							<path d="M 150 250 L 250 250 L 200 200 Z" fill="none" stroke="black" stroke-width="4"/>
							<line x1="200" y1="200" x2="200" y2="100" stroke="black" stroke-width="6"/>
							<!-- The balance beam -->
							<line x1="100" y1="100" x2="300" y2="100" stroke="black" stroke-width="4"/>
							<!-- Left pan (Property Deed) -->
							<line x1="100" y1="100" x2="60" y2="160" stroke="black" stroke-width="2"/>
							<line x1="100" y1="100" x2="140" y2="160" stroke="black" stroke-width="2"/>
							<path d="M 50 160 Q 100 180 150 160" fill="none" stroke="black" stroke-width="2"/>
							<rect x="80" y="120" width="40" height="50" fill="none" stroke="#D4AF37" stroke-width="2"/>
							<line x1="85" y1="130" x2="115" y2="130" stroke="#D4AF37" stroke-width="1"/>
							<line x1="85" y1="140" x2="105" y2="140" stroke="#D4AF37" stroke-width="1"/>
							<!-- Right pan (Bank Statements) -->
							<line x1="300" y1="100" x2="260" y2="180" stroke="black" stroke-width="2"/>
							<line x1="300" y1="100" x2="340" y2="180" stroke="black" stroke-width="2"/>
							<path d="M 250 180 Q 300 200 350 180" fill="none" stroke="black" stroke-width="2"/>
							<rect x="280" y="140" width="40" height="50" fill="none" stroke="#D4AF37" stroke-width="2"/>
							<circle cx="300" cy="160" r="10" fill="none" stroke="#D4AF37" stroke-width="2"/>
						</svg>
					</div>
				</div>

				<!-- GOOD EXAMPLE -->
				<div class="bg-white dark:bg-navy-800 p-8 rounded-3xl border-2 border-emerald-200 dark:border-emerald-900/50 shadow-xl">
					<div class="text-xs font-bold text-emerald-500 tracking-widest uppercase mb-2">Example 2: The "Compliance Flowchart"</div>
					<h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6">What I am actually good at building</h2>
					<p class="text-sm text-slate-600 dark:text-navy-300 mb-8">This is built using structural HTML/Tailwind CSS. It perfectly explains the concept (algorithm prioritizing ink over cash) and looks like a premium magazine.</p>
					
					<div class="bg-slate-50 dark:bg-navy-900 p-8 rounded-3xl border border-slate-200 dark:border-navy-700 font-sans">
						<div class="text-xs font-bold text-slate-400 dark:text-navy-400 tracking-widest uppercase mb-6">Systemic Priority Algorithm</div>
						<div class="flex items-center justify-between gap-4">
							<!-- Property Deed Block -->
							<div class="flex-1 bg-white dark:bg-navy-800 border-2 border-slate-200 dark:border-navy-700 p-6 rounded-2xl relative shadow-sm">
								<div class="w-8 h-8 rounded-full bg-slate-900 dark:bg-white text-white dark:text-navy-900 flex items-center justify-center font-bold absolute -top-4 -left-4">1</div>
								<h4 class="font-bold text-slate-900 dark:text-white mb-2">Legal Property Deed</h4>
								<p class="text-sm text-slate-500 dark:text-navy-300">Registered ink on paper.</p>
								<div class="mt-4 pt-4 border-t border-slate-200 dark:border-navy-700 text-gold-700 dark:text-gold-500 font-bold text-sm tracking-wide">SYSTEM WEIGHT: 95%</div>
							</div>
							
							<!-- Arrow -->
							<svg class="w-8 h-8 text-slate-300 dark:text-navy-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
							</svg>

							<!-- Bank Statement Block -->
							<div class="flex-1 bg-white dark:bg-navy-800 border-2 border-slate-200 dark:border-navy-700 p-6 rounded-2xl opacity-50 relative">
								<div class="w-8 h-8 rounded-full bg-slate-300 dark:bg-navy-700 text-slate-600 dark:text-navy-300 flex items-center justify-center font-bold absolute -top-4 -left-4">2</div>
								<h4 class="font-bold text-slate-500 dark:text-navy-400 mb-2">Actual Cash Flow</h4>
								<p class="text-sm text-slate-400 dark:text-navy-500">Real bank statements.</p>
								<div class="mt-4 pt-4 border-t border-slate-200 dark:border-navy-700 text-slate-400 dark:text-navy-500 font-bold text-sm tracking-wide">SYSTEM WEIGHT: 5%</div>
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>
	</main>
</Layout>
