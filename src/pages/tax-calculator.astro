---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardPremium from '../components/CardPremium.astro';
import InputGroup from '../components/InputGroup.astro';
import SectionTitle from '../components/SectionTitle.astro';
import TaxAnswer from '../components/Calculators/TaxAnswer.astro';
---

<Layout title="India Direct Tax Code 2025 & Calculators — SWP Intelligence">
	
	<Hero 
		badge="COMPUTATIONAL TAX ENGINE (FY 2025-26)"
		title="Interactive Slab & Scenario Engine"
		description="Run institutional-grade math on your gross income. Instantly visualize your effective tax rates, itemized deductions, and mathematically optimal regime choices."
	/>

	<hr class="section-divider" />
	
	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 space-y-10">

		<div class="max-w-7xl mx-auto"><TaxAnswer /></div>

		<!-- INTERACTIVE INDIA TAX REGIME CALCULATOR PANEL -->
		<CardPremium class="max-w-7xl mx-auto space-y-6">
			
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-navy-200 dark:border-white/10 pb-4">
				<div>
					<span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">INTERACTIVE SLAB ENGINE</span>
					<SectionTitle title="India Income Tax Calculator (FY 2025-26)" className="mt-1" />
				</div>
				<div id="indiaSavingsBadge" class="badge-safe px-3 py-1.5 text-[10px] font-bold self-start sm:self-auto">
					New Regime Recommended
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
				
				<!-- Inputs Column (5/12) -->
				<div class="lg:col-span-5 space-y-6">
					
					<!-- Income & Demographics -->
					<div>
						<div class="border-b border-navy-200 dark:border-navy-800 pb-2 mb-4">
							<h3 class="text-[10px] font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">Income & Demographics</h3>
						</div>
						<div class="space-y-4">
							<InputGroup id="inGrossSalary" label="Gross Salary" tooltip="Total yearly salary before exemptions" prefix="₹" value="15,00,000" />
							<InputGroup id="inOtherIncome" label="Other Income" tooltip="Interest, capital gains (normal slab rate), house property, etc." prefix="₹" value="0" />
							<div class="space-y-1">
								<label class="block text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">Age Bracket</label>
								<select id="inAgeBracket" class="w-full bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-700 rounded-lg px-3 py-2 text-sm text-navy-900 dark:text-navy-100 focus:outline-none focus:ring-2 focus:ring-gold-500">
									<option value="below60">Below 60 Years</option>
									<option value="60_80">60 to 80 Years (Senior)</option>
									<option value="above80">Above 80 Years (Super Senior)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- HRA Exemption -->
					<div>
						<div class="border-b border-navy-200 dark:border-navy-800 pb-2 mb-4">
							<h3 class="text-[10px] font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">HRA Exemption (Old Regime)</h3>
						</div>
						<div class="space-y-4">
							<div class="grid grid-cols-2 gap-4">
								<InputGroup id="inBasicSalary" label="Basic Salary" prefix="₹" value="7,50,000" />
								<InputGroup id="inHraReceived" label="HRA Received" prefix="₹" value="3,00,000" />
							</div>
							<div class="grid grid-cols-2 gap-4 items-end">
								<InputGroup id="inRentPaid" label="Rent (Annual)" prefix="₹" value="2,40,000" />
								<div class="space-y-1">
									<label class="block text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">City Type</label>
									<select id="inIsMetro" class="w-full bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-700 rounded-lg px-3 py-2 text-sm text-navy-900 dark:text-navy-100 focus:outline-none focus:ring-2 focus:ring-gold-500">
										<option value="true">Metro (50%)</option>
										<option value="false" selected>Non-Metro (40%)</option>
									</select>
								</div>
							</div>
							<div class="text-[10px] text-navy-500 dark:text-navy-400 bg-navy-50 dark:bg-navy-900 p-2 rounded border border-navy-200 dark:border-navy-800 flex justify-between">
								<span>Computed Exempt HRA:</span>
								<span id="valHraExempt" class="font-bold text-navy-900 dark:text-navy-100">₹0</span>
							</div>
						</div>
					</div>

					<!-- Itemized Deductions -->
					<div>
						<div class="border-b border-navy-200 dark:border-navy-800 pb-2 mb-4">
							<h3 class="text-[10px] font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">Deductions (Old Regime)</h3>
						</div>
						<div class="grid grid-cols-2 gap-4">
							<InputGroup id="inSec80c" label="Section 80C" tooltip="Max ₹1.5L" prefix="₹" value="1,50,000" />
							<InputGroup id="inSec80d" label="Section 80D" tooltip="Health Insurance. Max ₹1L." prefix="₹" value="25,000" />
							<InputGroup id="inSec80ccd" label="80CCD(1B)" tooltip="NPS tier-1. Max ₹50k" prefix="₹" value="50,000" />
						</div>
						<p id="deductionBoundary" class="mt-3 text-[11px] text-navy-500 dark:text-navy-400 leading-relaxed"></p>
					</div>

					<!--
						THE DISCLOSURE. Each head is a chip, closed by default, so a
						salaried reader never sees a business field. A chip is NOT a mode
						(dd-006): opening one ADDS income the reader has, rather than
						swapping one view of the same data for another. The regime
						comparison - which genuinely IS the lesson - stays two adjacent
						columns and never becomes a switch.

						Native <details>, so the disclosure works without script and each
						summary is the reader's own question rather than a label.
					-->
					<div class="space-y-3">
						<div class="border-b border-navy-200 dark:border-navy-800 pb-2">
							<h3 class="text-[10px] font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">Do you have any of these too?</h3>
						</div>

						<details class="tax-chip rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-900/40 px-4 py-3">
							<summary class="text-xs font-bold text-navy-900 dark:text-navy-100">A home, or a property you rent out</summary>
							<div class="space-y-4 pt-4">
								<div class="space-y-1">
									<label class="block text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">Which is it?</label>
									<select id="inHpKind" class="w-full bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-700 rounded-lg px-3 py-2 text-sm text-navy-900 dark:text-navy-100 focus:outline-none focus:ring-2 focus:ring-gold-500">
										<option value="none">Neither</option>
										<option value="selfOccupied" selected>A home I live in</option>
										<option value="letOut">A property I rent out</option>
									</select>
								</div>
								<div id="hpLetOutFields" class="hidden grid grid-cols-2 gap-4">
									<InputGroup id="inHpRent" label="Rent (Annual)" prefix="₹" value="0" />
									<InputGroup id="inHpMunicipalTaxes" label="Municipal Tax Paid" tooltip="Comes off before the 30% standard deduction." prefix="₹" value="0" />
								</div>
								<div id="hpInterestField">
									<InputGroup id="inHomeLoan" label="Loan Interest (Annual)" tooltip="Section 24(b). Capped at ₹2L on a home you live in and allowed only under the old regime; uncapped on a property you rent out." prefix="₹" value="0" />
								</div>
								<p id="hpNote" class="text-[11px] text-navy-500 dark:text-navy-400 leading-relaxed"></p>
							</div>
						</details>

						<details class="tax-chip rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-900/40 px-4 py-3">
							<summary class="text-xs font-bold text-navy-900 dark:text-navy-100">Business or professional income</summary>
							<div class="space-y-4 pt-4">
								<div class="grid grid-cols-2 gap-4">
									<InputGroup id="inBusinessTurnover" label="Business Turnover" tooltip="For the s.44AD presumptive scheme." prefix="₹" value="0" />
									<InputGroup id="inProfessionalReceipts" label="Professional Receipts" tooltip="For the s.44ADA presumptive scheme." prefix="₹" value="0" />
								</div>
								<div class="grid grid-cols-2 gap-4">
									<InputGroup id="inBusinessProfit" label="Net Profit (books)" prefix="₹" value="0" />
									<div class="space-y-1">
										<label class="block text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">Received via bank (%)</label>
										<input id="inBusinessDigitalShare" type="number" min="0" max="100" value="100" class="w-full bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-700 rounded-lg px-3 py-2 text-sm text-navy-900 dark:text-navy-100 focus:outline-none focus:ring-2 focus:ring-gold-500" />
									</div>
								</div>
								<!--
									dd-006/dont-2: the difference between declaring actual
									profit and a deemed one IS the lesson here, so both are
									priced and shown at once rather than one at a time behind
									the selector below.
								-->
								<div id="presumptiveCompare" class="text-[11px] rounded-lg border border-navy-200 dark:border-navy-800 bg-navy-50 dark:bg-navy-900 p-3 space-y-1.5"></div>
								<div class="space-y-1">
									<label class="block text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">Tax me on</label>
									<select id="inBusinessBasis" class="w-full bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-700 rounded-lg px-3 py-2 text-sm text-navy-900 dark:text-navy-100 focus:outline-none focus:ring-2 focus:ring-gold-500">
										<option value="books">My actual profit</option>
										<option value="44AD">Deemed profit — s.44AD</option>
										<option value="44ADA">Deemed profit — s.44ADA</option>
									</select>
								</div>
							</div>
						</details>

						<details class="tax-chip rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-900/40 px-4 py-3">
							<summary class="text-xs font-bold text-navy-900 dark:text-navy-100">Capital gains</summary>
							<div class="space-y-4 pt-4">
								<div class="grid grid-cols-2 gap-4">
									<InputGroup id="inCgStcgEquity" label="Equity, held under a year" tooltip="Section 111A. A flat 20%." prefix="₹" value="0" />
									<InputGroup id="inCgLtcgEquity" label="Equity, held over a year" tooltip="Section 112A. 12.5%, and the first ₹1.25 lakh each year is free." prefix="₹" value="0" />
								</div>
								<details class="tax-subchip rounded-lg border border-navy-200 dark:border-navy-800 bg-navy-50 dark:bg-navy-900/60 px-3 py-2">
									<summary class="text-[11px] font-semibold text-navy-600 dark:text-navy-300">Property, gold, debt funds, unlisted shares</summary>
									<div class="grid grid-cols-2 gap-4 pt-3">
										<InputGroup id="inCgLtcgOther" label="Held long term" tooltip="Section 112. 12.5%." prefix="₹" value="0" />
										<InputGroup id="inCgStcgOther" label="Held short term" tooltip="NOT section 111A. This is ordinary income at your slab rate, not 20%." prefix="₹" value="0" />
									</div>
								</details>
							</div>
						</details>

						<details class="tax-chip rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-900/40 px-4 py-3">
							<summary class="text-xs font-bold text-navy-900 dark:text-navy-100">Losses to set off</summary>
							<div class="space-y-4 pt-4">
								<p class="text-[11px] text-navy-500 dark:text-navy-400 leading-relaxed">
									A capital loss can only ever meet a capital gain — never salary, rent or interest.
								</p>
								<div class="grid grid-cols-2 gap-4">
									<InputGroup id="inLossStcgCurrent" label="Short-term loss, this year" prefix="₹" value="0" />
									<InputGroup id="inLossLtcgCurrent" label="Long-term loss, this year" prefix="₹" value="0" />
								</div>
								<details class="tax-subchip rounded-lg border border-navy-200 dark:border-navy-800 bg-navy-50 dark:bg-navy-900/60 px-3 py-2">
									<summary class="text-[11px] font-semibold text-navy-600 dark:text-navy-300">Brought forward from earlier years</summary>
									<div class="space-y-4 pt-3">
										<p class="text-[11px] text-navy-500 dark:text-navy-400 leading-relaxed">
											Carried losses are set off in flat rupees. The law gives no
											inflation adjustment, so a loss from seven years ago buys far
											less than the number suggests.
										</p>
										<div class="grid grid-cols-2 gap-4">
											<InputGroup id="inLossBfBusiness" label="Business" prefix="₹" value="0" />
											<InputGroup id="inLossBfHouseProperty" label="House property" prefix="₹" value="0" />
											<InputGroup id="inLossBfShortTerm" label="Short-term capital" prefix="₹" value="0" />
											<InputGroup id="inLossBfLongTerm" label="Long-term capital" prefix="₹" value="0" />
										</div>
									</div>
								</details>
								<p id="lossNote" class="text-[11px] text-navy-500 dark:text-navy-400 leading-relaxed"></p>
							</div>
						</details>
					</div>
				</div>

				<!-- Outputs Column (7/12) -->
				<div class="lg:col-span-7 space-y-6">
					
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<!-- New Tax Regime Card -->
						<div id="cardNewRegime" class="p-5 card-premium rounded-lg space-y-3">
							<div class="flex justify-between items-center text-[10px] font-bold tracking-widest">
								<span class="text-navy-500 dark:text-navy-400 uppercase">NEW REGIME</span>
								<span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 text-[9px] uppercase">FY 25-26</span>
							</div>
							<div class="space-y-1">
								<div class="text-[10px] uppercase font-bold tracking-widest text-navy-500 dark:text-navy-400">Total Tax Payable:</div>
								<div id="valNewTax" class="text-3xl font-bold text-navy-900 dark:text-navy-100">₹ 0</div>
							</div>
							<div class="pt-3 border-t border-navy-200 dark:border-white/10 text-[10px] text-navy-500 dark:text-navy-400 space-y-1.5 uppercase font-bold tracking-widest">
								<div id="valNewEffectiveRate" class="font-bold text-navy-800 dark:text-navy-200">Effective Rate: 0.0%</div>
							</div>
						</div>

						<!-- Old Tax Regime Card -->
						<div id="cardOldRegime" class="p-5 card-premium rounded-lg space-y-3">
							<div class="flex justify-between items-center text-[10px] font-bold tracking-widest">
								<span class="text-navy-500 dark:text-navy-400 uppercase">OLD REGIME</span>
								<span class="px-2 py-0.5 rounded bg-navy-200 dark:bg-navy-800 text-navy-600 dark:text-navy-400 text-[9px] uppercase">FY 25-26</span>
							</div>
							<div class="space-y-1">
								<div class="text-[10px] uppercase font-bold tracking-widest text-navy-500 dark:text-navy-400">Total Tax Payable:</div>
								<div id="valOldTax" class="text-3xl font-bold text-navy-900 dark:text-navy-100">₹ 0</div>
							</div>
							<div class="pt-3 border-t border-navy-200 dark:border-white/10 text-[10px] text-navy-500 dark:text-navy-400 space-y-1.5 uppercase font-bold tracking-widest">
								<div id="valOldEffectiveRate" class="font-bold text-navy-800 dark:text-navy-200">Effective Rate: 0.0%</div>
							</div>
						</div>
					</div>

					<!-- Slab Breakdown -->
					<div class="bg-navy-50 dark:bg-navy-900 rounded-lg border border-navy-200 dark:border-navy-800 p-5 space-y-4">
						<h3 class="text-xs font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">Tax Computation Breakdown</h3>
						<div class="overflow-x-auto">
							<table class="w-full text-left text-xs">
								<thead>
									<tr class="border-b border-navy-200 dark:border-navy-800 text-[10px] uppercase text-navy-500 tracking-widest">
										<th class="py-2">Component</th>
										<th id="colHeadNew" class="py-2 text-right w-28">New Regime</th>
										<th id="colHeadOld" class="py-2 text-right w-28">Old Regime</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-navy-200 dark:divide-navy-800 text-navy-900 dark:text-navy-100">
									<tr>
										<td class="py-2">Gross Income</td>
										<td class="py-2 text-right font-mono" id="brNewGross">0</td>
										<td class="py-2 text-right font-mono" id="brOldGross">0</td>
									</tr>
									<tr>
										<td class="py-2">Exemptions (HRA)</td>
										<td class="py-2 text-right font-mono text-navy-400">-</td>
										<td class="py-2 text-right font-mono" id="brOldExempt">0</td>
									</tr>
									<tr>
										<td class="py-2">Itemized Deductions</td>
										<td class="py-2 text-right font-mono text-navy-400">-</td>
										<td class="py-2 text-right font-mono" id="brOldDed">0</td>
									</tr>
									<!--
										House property is a HEAD, not a deduction. It carries its own
										row because the loan interest used to be netted off inside
										"Itemized Deductions", and once it moved head the table would
										have stopped adding up - the taxable income no longer followed
										from the rows on screen (dd-009/do-1).
									-->
									<tr>
										<td class="py-2">Income from House Property</td>
										<td class="py-2 text-right font-mono" id="brNewHp">0</td>
										<td class="py-2 text-right font-mono" id="brOldHp">0</td>
									</tr>
									<tr id="brHpCarryRow" class="hidden">
										<td class="py-2 pl-4 text-navy-500 dark:text-navy-400">↳ loss carried forward, not used this year</td>
										<td class="py-2 text-right font-mono text-navy-500" id="brNewHpCarry">0</td>
										<td class="py-2 text-right font-mono text-navy-500" id="brOldHpCarry">0</td>
									</tr>
									<tr>
										<td class="py-2">Standard Deduction</td>
										<td class="py-2 text-right font-mono" id="brNewStd">0</td>
										<td class="py-2 text-right font-mono" id="brOldStd">0</td>
									</tr>
									<tr class="font-bold bg-black/5 dark:bg-white/5">
										<td class="py-2 px-2">Taxable Income</td>
										<td class="py-2 px-2 text-right font-mono" id="brNewTaxable">0</td>
										<td class="py-2 px-2 text-right font-mono" id="brOldTaxable">0</td>
									</tr>
									<tr>
										<td class="py-2">Base Tax (per Slabs)</td>
										<td class="py-2 text-right font-mono" id="brNewBase">0</td>
										<td class="py-2 text-right font-mono" id="brOldBase">0</td>
									</tr>
									<!--
										Capital gains at special rates never touch the slabs, so they
										cannot be folded into the row above without making it a figure
										that no longer follows from the slab table (dd-009/do-1).
									-->
									<tr id="brCgRow" class="hidden">
										<td class="py-2">Tax on Capital Gains (own rates)</td>
										<td class="py-2 text-right font-mono" id="brNewCg">0</td>
										<td class="py-2 text-right font-mono" id="brOldCg">0</td>
									</tr>
									<tr>
										<td class="py-2">Sec 87A Rebate</td>
										<td class="py-2 text-right font-mono text-emerald-600" id="brNewRebate">0</td>
										<td class="py-2 text-right font-mono text-emerald-600" id="brOldRebate">0</td>
									</tr>
									<tr>
										<td class="py-2">Surcharge</td>
										<td class="py-2 text-right font-mono" id="brNewSur">0</td>
										<td class="py-2 text-right font-mono" id="brOldSur">0</td>
									</tr>
									<tr>
										<td class="py-2">Marginal Relief</td>
										<td class="py-2 text-right font-mono text-emerald-600" id="brNewMarginal">0</td>
										<td class="py-2 text-right font-mono text-emerald-600" id="brOldMarginal">0</td>
									</tr>
									<tr>
										<td class="py-2">Health & Ed Cess (4%)</td>
										<td class="py-2 text-right font-mono" id="brNewCess">0</td>
										<td class="py-2 text-right font-mono" id="brOldCess">0</td>
									</tr>
									<tr class="font-black text-sm text-navy-900 dark:text-white">
										<td class="py-3">Total Tax Liability</td>
										<td class="py-3 text-right font-mono" id="brNewTotal">0</td>
										<td class="py-3 text-right font-mono" id="brOldTotal">0</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
					
				</div>
			</div>

		</CardPremium>

	</main>
</Layout>

<script>
	import { calculateIndiaTaxEngine } from '../utils/tax';
	import { buildTaxAnswer } from '../utils/taxAnswer';
	import { readTaxInputs, MONEY_FIELD_IDS, CHOICE_FIELD_IDS } from '../utils/taxInputs';
	import { tableFormatter, setupFormattingField } from '../utils/formatters';

	function formatRupee(val: number): string {
		if (isNaN(val)) return '₹0';
		return `${tableFormatter.format(Math.round(val))}`;
	}
    
    function formatNegative(val: number): string {
        if (val === 0) return '0';
        return `-${formatRupee(val)}`;
    }

	const setText = (id: string, v: string) => { const e = document.getElementById(id); if (e) e.innerText = v; };

	/** Rupees the way a person says them, for prose rather than a table. */
	function inWords(n: number): string {
		if (n >= 10000000) return `₹${(n / 10000000).toFixed(2)} crore`;
		if (n >= 100000) return `₹${(n / 100000).toFixed(2)} lakh`;
		return formatRupee(n);
	}

	function renderAnswer(model: ReturnType<typeof buildTaxAnswer>) {
		const { verdict, breakEven } = model;
		const b = verdict.better;

		setText('ansMonthly', formatRupee(model.monthly));
		setText('ansAnnual', formatRupee(b.totalTax));
		setText('ansGross', formatRupee(b.grossIncome));
		setText('ansRate', `${b.effectiveRate}%`);

		// The effective rate divides by TOTAL INCOME, which a loss reduces. A
		// reader earning 15 lakh who is told "income of 13,00,000" has been
		// handed a question the screen must answer in the same breath
		// (dd-009/dont-1), so the gap is reconciled inline whenever it exists -
		// and the clause disappears when there is nothing to explain.
		const h = b.heads;
		const earned =
			h.salary + b.standardDeduction + b.exemptions +
			Math.max(0, h.housePropertyIncome) + h.business + h.otherSources +
			b.capitalGains.specialRateIncome + b.capitalGains.slabTaxed;
		const reduced = Math.round(earned - b.grossIncome);
		setText(
			'ansReconcile',
			reduced > 0
				? `That is your ${formatRupee(earned)} of income less ${formatRupee(reduced)} of losses the law lets you set against it.`
				: ''
		);

		setText('ansTaxNew', formatRupee(model.result.newRegime.totalTax));
		setText('ansTaxOld', formatRupee(model.result.oldRegime.totalTax));
		setText('ansSubNew', `Effective rate ${model.result.newRegime.effectiveRate}%`);
		setText('ansSubOld', `Effective rate ${model.result.oldRegime.effectiveRate}%`);

		// THE BOUNDARY, not the current position (dd-008). The sentence states a
		// principle that stays true at every input; only the values move.
		const el = document.getElementById('ansBreakEven');
		if (!el) return;
		if (verdict.winner === 'tie') {
			el.innerText = 'Both regimes cost the same on these figures, so the choice is yours.';
		} else if (verdict.winner === 'old') {
			el.innerText =
				`The old regime wins here because you claim ${inWords(breakEven.claimed)} of deductions and ` +
				`exemptions. It stops winning if that falls below roughly ${inWords(breakEven.required)}.`;
		} else if (!breakEven.exists) {
			el.innerText =
				'No amount of deductions makes the old regime cheaper here — the gap is in how the two ' +
				'regimes treat capital gains, which deductions cannot touch.';
		} else {
			el.innerText =
				`The new regime is a bet that your deductions stay small. The old one only wins if you can ` +
				`claim ${inWords(breakEven.required)}; you are claiming ${inWords(breakEven.claimed)}, so you ` +
				`would need ${inWords(breakEven.shortfall)} more.`;
		}
		setText(
			'deductionBoundary',
			breakEven.exists && breakEven.shortfall > 0
				? `Claiming ${inWords(breakEven.shortfall)} more than you do now would make the old regime the cheaper one.`
				: breakEven.exists
					? 'You already claim enough for the old regime to be the cheaper one.'
					: ''
		);
	}

	/**
	 * sol-043. EVERY emphasis on this page is applied here, from one verdict.
	 *
	 * It used to be five independent decisions written into the markup - emerald
	 * text, font-weight 900, DEFAULT/OPTIONAL captions, an emerald column header
	 * and an emerald total - all fixed at "the new regime is the answer". At
	 * maxed deductions, or on an ordinary ₹2 lakh home loan, the badge read "OLD
	 * REGIME SAVES ..." while the losing bill stayed the boldest, greenest number
	 * on the screen. Nothing here may decide for itself.
	 */
	function applyVerdict(verdict: ReturnType<typeof buildTaxAnswer>['verdict']) {
		const WIN = ['ring-2', 'ring-emerald-500/60', 'border-emerald-500/40'];
		const WIN_TEXT = ['text-emerald-600', 'dark:text-emerald-400', 'font-black'];

		for (const [regime, cardId, ansCardId, tagId, valId, colId, totalId] of [
			['new', 'cardNewRegime', 'ansCardNew', 'ansTagNew', 'valNewTax', 'colHeadNew', 'brNewTotal'],
			['old', 'cardOldRegime', 'ansCardOld', 'ansTagOld', 'valOldTax', 'colHeadOld', 'brOldTotal'],
		] as const) {
			const won = verdict.winner === regime;
			for (const id of [cardId, ansCardId]) {
				const e = document.getElementById(id);
				if (e) WIN.forEach(c => e.classList.toggle(c, won));
			}
			for (const id of [valId, colId, totalId]) {
				const e = document.getElementById(id);
				if (e) WIN_TEXT.forEach(c => e.classList.toggle(c, won));
			}
			const tag = document.getElementById(tagId);
			if (tag) {
				tag.innerText = won ? 'Cheaper for you' : '';
				tag.className = won
					? 'text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'
					: 'text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded';
			}
		}
	}

	/** The copy inside each chip that depends on what the engine actually did. */
	function renderChipNotes(result: ReturnType<typeof calculateIndiaTaxEngine>) {
		const kind = (document.getElementById('inHpKind') as HTMLSelectElement | null)?.value;
		document.getElementById('hpLetOutFields')?.classList.toggle('hidden', kind !== 'letOut');
		// The interest field goes with the property. Leaving it on screen under
		// "Neither" lets the reader type a number that silently does nothing -
		// the sol-041 shape, in the view layer rather than the reader.
		document.getElementById('hpInterestField')?.classList.toggle('hidden', kind === 'none');

		const hpNew = result.newRegime.heads.housePropertyIncome;
		const hpOld = result.oldRegime.heads.housePropertyIncome;
		setText(
			'hpNote',
			kind === 'selfOccupied' && hpOld < 0
				? `A home you live in earns nothing, so this interest is a loss of ${formatRupee(-hpOld)} — worth claiming only under the old regime. The new regime allows none of it, which is the single biggest reason a borrower stays on the old one.`
				: kind === 'letOut' && hpNew !== 0
					? `Rent less municipal tax, less 30%, less the interest: ${formatRupee(hpNew)}. Interest is uncapped here — it is the LOSS that gets capped, at ₹2 lakh a year against your other income.`
					: ''
		);

		// Both presumptive bases, side by side, from one turnover figure.
		const d = result.newRegime.heads.businessDetail;
		const cmp = document.getElementById('presumptiveCompare');
		if (cmp) {
			const row = (label: string, value: string, note: string) =>
				`<div class="flex justify-between gap-3"><span class="text-navy-500 dark:text-navy-400">${label}</span><span class="font-bold tabular-nums text-navy-900 dark:text-navy-100">${value}</span></div>${note ? `<div class="text-navy-400 dark:text-navy-500">${note}</div>` : ''}`;
			cmp.innerHTML =
				row('Your actual profit', formatRupee(d.booksProfit), '') +
				row(
					`Deemed under 44AD (${(d.ad44.effectiveRate * 100).toFixed(1)}%)`,
					d.ad44.available ? formatRupee(d.ad44.deemedProfit) : '—',
					d.ad44.available ? '' : d.ad44.unavailableReason
				) +
				row(
					'Deemed under 44ADA (50%)',
					d.ada44.available ? formatRupee(d.ada44.deemedProfit) : '—',
					d.ada44.available ? '' : d.ada44.unavailableReason
				);
		}

		const L = result.newRegime.losses;
		const carried =
			L.shortTerm.carriedForward + L.longTerm.carriedForward + L.business.carriedForward + L.houseProperty.carriedForward;
		setText(
			'lossNote',
			carried > 0
				? `${formatRupee(carried)} could not be used this year and carries forward for up to eight years, against its own kind of income only.`
				: ''
		);
	}

	function calculateIndiaTax() {
		// The page is a view: read, compute, render. Every field on it is read by
		// `readTaxInputs()` and by nothing else - see taxInputs.ts for why that
		// matters before the second surface exists rather than after.
		const model = buildTaxAnswer(readTaxInputs());
		const result = model.result;
		renderAnswer(model);
		applyVerdict(model.verdict);
		renderChipNotes(result);

		// Update UI DOM - Top level
		const newTaxEl = document.getElementById('valNewTax');
		const oldTaxEl = document.getElementById('valOldTax');
		const newEffEl = document.getElementById('valNewEffectiveRate');
		const oldEffEl = document.getElementById('valOldEffectiveRate');
		const badgeEl = document.getElementById('indiaSavingsBadge');

		if (newTaxEl) newTaxEl.innerText = formatRupee(result.newRegime.totalTax);
		if (oldTaxEl) oldTaxEl.innerText = formatRupee(result.oldRegime.totalTax);
		if (newEffEl) newEffEl.innerText = `Effective Rate: ${result.newRegime.effectiveRate}%`;
		if (oldEffEl) oldEffEl.innerText = `Effective Rate: ${result.oldRegime.effectiveRate}%`;

        // Update HRA Exempt tag
        const hraTag = document.getElementById('valHraExempt');
        if (hraTag) hraTag.innerText = formatRupee(result.oldRegime.exemptions); // Since HRA is the only exemption currently

        // Update Breakdown Table
        const setHtml = (id: string, val: string) => { const el = document.getElementById(id); if (el) el.innerText = val; };
        
        setHtml('brNewGross', formatRupee(result.newRegime.grossIncome));
        setHtml('brOldGross', formatRupee(result.oldRegime.grossIncome));
        
        setHtml('brOldExempt', formatNegative(result.oldRegime.exemptions));
        setHtml('brOldDed', formatNegative(result.oldRegime.deductions));

        // What the head actually contributed: its income if positive, or only
        // the part of its loss the set-off rules allowed. Showing the full loss
        // here would be a figure that never reached the taxable income.
        const hpContribution = (h: typeof result.newRegime.heads) =>
            h.housePropertyIncome >= 0 ? formatRupee(h.housePropertyIncome) : formatNegative(h.housePropertySetOff);
        setHtml('brNewHp', hpContribution(result.newRegime.heads));
        setHtml('brOldHp', hpContribution(result.oldRegime.heads));

        // The unused part of a loss is stated rather than dropped. Under the new
        // regime that is the WHOLE loss - s.115BAC allows none of it against
        // other heads - and a reader comparing the columns deserves to see why
        // the two differ by more than the deductions explain.
        const carry = Math.max(
            result.newRegime.heads.housePropertyCarriedForward,
            result.oldRegime.heads.housePropertyCarriedForward
        );
        document.getElementById('brHpCarryRow')?.classList.toggle('hidden', carry <= 0);
        setHtml('brNewHpCarry', formatRupee(result.newRegime.heads.housePropertyCarriedForward));
        setHtml('brOldHpCarry', formatRupee(result.oldRegime.heads.housePropertyCarriedForward));
        
        setHtml('brNewStd', formatNegative(result.newRegime.standardDeduction));
        setHtml('brOldStd', formatNegative(result.oldRegime.standardDeduction));
        
        setHtml('brNewTaxable', formatRupee(result.newRegime.taxableIncome));
        setHtml('brOldTaxable', formatRupee(result.oldRegime.taxableIncome));
        
        // The slab tax alone, so the row still follows from the slab table
        // above it. `baseTax` now also carries the special-rate tax, which gets
        // its own row rather than being hidden inside this one.
        setHtml('brNewBase', formatRupee(result.newRegime.slabTax - result.newRegime.rebate87A));
        setHtml('brOldBase', formatRupee(result.oldRegime.slabTax - result.oldRegime.rebate87A));

        const anyCg = result.newRegime.specialRateTax > 0 || result.oldRegime.specialRateTax > 0;
        document.getElementById('brCgRow')?.classList.toggle('hidden', !anyCg);
        setHtml('brNewCg', formatRupee(result.newRegime.specialRateTax));
        setHtml('brOldCg', formatRupee(result.oldRegime.specialRateTax));
        
        setHtml('brNewRebate', formatNegative(result.newRegime.rebate87A));
        setHtml('brOldRebate', formatNegative(result.oldRegime.rebate87A));
        
        setHtml('brNewSur', formatRupee(result.newRegime.surcharge));
        setHtml('brOldSur', formatRupee(result.oldRegime.surcharge));
        
        setHtml('brNewMarginal', formatNegative(result.newRegime.marginalRelief));
        setHtml('brOldMarginal', formatNegative(result.oldRegime.marginalRelief));
        
        setHtml('brNewCess', formatRupee(result.newRegime.cess));
        setHtml('brOldCess', formatRupee(result.oldRegime.cess));
        
        setHtml('brNewTotal', formatRupee(result.newRegime.totalTax));
        setHtml('brOldTotal', formatRupee(result.oldRegime.totalTax));

		if (badgeEl) {
			if (result.isNewBetter) {
				badgeEl.innerText = `New Regime Saves ${formatRupee(result.savingsAmount)}`;
				badgeEl.className = "badge-safe px-3 py-1.5 text-[10px] font-bold self-start sm:self-auto";
			} else if (result.isOldBetter) {
				badgeEl.innerText = `Old Regime Saves ${formatRupee(result.savingsAmount)}`;
				badgeEl.className = "badge-warning px-3 py-1.5 text-[10px] font-bold self-start sm:self-auto";
			} else {
				badgeEl.innerText = "Both Regimes Equal Tax";
				badgeEl.className = "px-3 py-1.5 text-[10px] font-bold self-start sm:self-auto rounded bg-navy-200 dark:bg-navy-800 text-navy-600 dark:text-navy-400 border border-navy-300 dark:border-white/10 uppercase tracking-widest";
			}
		}
	}

	document.addEventListener('DOMContentLoaded', () => {
		// The field lists come from the reader too. A page that keeps its own
		// copy is a page where a field can be added to the form and to the
		// input set and still never trigger a recompute.
		MONEY_FIELD_IDS.forEach(id => {
			const el = document.getElementById(id);
			if (el) setupFormattingField(el as HTMLInputElement, calculateIndiaTax);
		});

		CHOICE_FIELD_IDS.forEach(id => {
			document.getElementById(id)?.addEventListener('change', calculateIndiaTax);
		});

		calculateIndiaTax();
	});
</script>

<style>
	/*
		The chips. Plain CSS rather than @apply: Tailwind v4 needs an @reference
		in a scoped style block, and the rest of this codebase puts utilities on
		the element anyway. Only the marker needs CSS at all.
	*/
	.tax-chip > summary,
	.tax-subchip > summary {
		cursor: pointer;
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.tax-chip > summary::-webkit-details-marker,
	.tax-subchip > summary::-webkit-details-marker {
		display: none;
	}
	.tax-chip > summary::after,
	.tax-subchip > summary::after {
		content: '+';
		font-weight: 400;
		font-size: 1rem;
		line-height: 1;
		opacity: 0.5;
	}
	.tax-chip[open] > summary::after,
	.tax-subchip[open] > summary::after {
		content: '\2212';
	}
</style>
