---
import Layout from '../layouts/Layout.astro';
import CardPremium from '../components/CardPremium.astro';
import TaxIntro from '../components/Calculators/TaxIntro.astro';
import TaxAnswer from '../components/Calculators/TaxAnswer.astro';
import TaxInputForm from '../components/Calculators/TaxInputForm.astro';
import TaxIncomeComputation from '../components/Calculators/TaxIncomeComputation.astro';
import TaxComputation from '../components/Calculators/TaxComputation.astro';
---

<Layout title="Income tax calculator, FY 2025-26 — old regime or new">

	<!--
		THE HERO IS GONE, and its going is the point. It said the same thing
		`TaxIntro` says, one section above it, so the page introduced itself twice
		and then asked its question a screen and a half down. dd-024 asks for ONE
		welcome that hands the reader the first question; two is not a warmer one.
	-->
	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">

		<!--
			The answer does not exist until there is income to answer about, so it
			is not on the screen saying nil. The page at rest is one question
			(dd-022); this is the same rule applied to the output.
		-->
		<div id="taxAnswerWrap" class="max-w-7xl mx-auto" hidden><TaxAnswer /></div>

		<TaxIntro />

		<!--
			The page has two states and the change between them is the design
			(dd-024). Before the first answer there is a welcome and one question;
			after it the welcome collapses and this resolves into the form and the
			working. Sheet 2's arrangement is kept - inputs left, the two panels
			right - because that is the drawing that can be verified.
		-->
		<div id="taxWorkbench" hidden>
		<CardPremium class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
				<div class="lg:col-span-5"><TaxInputForm /></div>
				<div class="lg:col-span-7">
					<p id="taxPanelsWaiting" class="text-sm text-navy-600 dark:text-navy-400 leading-relaxed">
						The working appears here as soon as you tell us what you earned — every head, every
						deduction, and what each one did to the bill.
					</p>
					<div id="taxPanels" class="space-y-6" hidden>
						<TaxIncomeComputation />
						<TaxComputation />
					</div>
				</div>
			</div>
		</CardPremium>
		</div>

	</main>
</Layout>

<script>
	import { calculateIndiaTaxEngine, type TaxRegimeResult } from '../utils/tax';
	import { buildTaxAnswer } from '../utils/taxAnswer';
	import { readTaxInputs, MONEY_FIELD_IDS, CHOICE_FIELD_IDS } from '../utils/taxInputs';
	import {
		CATEGORIES,
		DEDUCTIONS,
		HEAD_LABEL,
		INCOME_SOURCES,
		incomeSourcesFor,
		whyExcluded,
		type CatalogueEntry,
	} from '../utils/taxCatalogue';
	import { tableFormatter, setupFormattingField } from '../utils/formatters';

	// ---------------------------------------------------------------- formatting

	function formatRupee(val: number): string {
		if (isNaN(val)) return '₹0';
		// `|| 0` normalises negative zero. A house property head that contributed
		// nothing was printing `-₹0`, which reads as a rounded-away debt rather
		// than as nothing at all.
		return `${tableFormatter.format(Math.round(val) || 0)}`;
	}

	function formatNegative(val: number): string {
		// A cell that reads `0` where every other cell reads `₹0` has lost its
		// frame for the sake of two characters - dd-019/dont-1. A nil deduction is
		// a rupee figure like any other.
		if (Math.round(val) === 0) return '₹0';
		return `-${formatRupee(val)}`;
	}

	const setText = (id: string, v: string) => {
		const e = document.getElementById(id);
		if (e) e.innerText = v;
	};

	/** Rupees the way a person says them, for prose rather than a table. */
	function inWords(n: number): string {
		if (n >= 10000000) return `₹${(n / 10000000).toFixed(2)} crore`;
		if (n >= 100000) return `₹${(n / 100000).toFixed(2)} lakh`;
		return formatRupee(n);
	}

	// ---------------------------------------------------------------- the form
	//
	// THE ONE RULE THAT GOVERNS THIS SECTION. The category decides what the form
	// OFFERS and never what it holds. A field the reader has already answered
	// stays on screen when it stops being eligible, carrying the statute that now
	// excludes it, because removing it would change the tax for a reason the
	// screen never gave - dd-020/dont-3.
	//
	// A field is ACTIVE exactly when it is on screen, and `readTaxInputs()` reads
	// that attribute rather than presence: every eligible field is rendered by the
	// server, so presence means nothing at all.

	const ALL_ENTRIES: CatalogueEntry[] = [...INCOME_SOURCES, ...DEDUCTIONS];
	const entryById = new Map(ALL_ENTRIES.map((e) => [e.id, e]));

	const category = () =>
		(document.getElementById('inCategory') as HTMLSelectElement | null)?.value ?? '';

	/**
	 * The page has two states, and the change between them is the design (dd-024).
	 *
	 * Before the first answer: a welcome and one question. After it: the welcome
	 * collapses and the workbench resolves into the form and the working. The
	 * collapse is a transition rather than a keyframe, and it ends in
	 * `display: none` rather than a zero-height box, because a welcome that stays
	 * in the flow becomes furniture the reader scrolls past on every recompute.
	 */
	function resolvePage() {
		const intro = document.getElementById('taxIntro');
		const workbench = document.getElementById('taxWorkbench');
		if (!intro || !workbench) return;
		if (!category() || intro.dataset.collapsed === 'true') return;

		workbench.hidden = false;
		// The shared card carries `.reveal`, which starts at opacity 0 and is lit
		// by an IntersectionObserver on load. An element that was `hidden` at load
		// never intersected, so the whole workbench came back invisible. Lighting
		// it here is the fix; the observer keeps its job for everything else.
		workbench.querySelectorAll('.reveal, .reveal-scale').forEach((el) => el.classList.add('visible'));

		intro.dataset.leaving = 'true';

		let done = false;
		const finish = () => {
			if (done) return;
			done = true;
			intro.dataset.collapsed = 'true';
			// The form's first field is where the reader is going next, so the page
			// takes them there rather than leaving them to find it.
			workbench.scrollIntoView({ block: 'start', behavior: 'smooth' });
		};

		// `transitionend` is the signal, and a timer is the guarantee. The event
		// does not fire in a backgrounded tab, under some reduced-motion settings,
		// or if the element stops transitioning for any reason - and every one of
		// those failures would leave the welcome sitting on the page for good,
		// which is worse than losing the animation.
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduced) finish();
		else {
			intro.addEventListener('transitionend', finish, { once: true });
			window.setTimeout(finish, 600);
		}
	}

	const isPrimary = (entry: CatalogueEntry, cat: string) =>
		(entry.primaryFor ?? []).includes(cat);

	const fieldNodes = () =>
		[...document.querySelectorAll<HTMLElement>('.tax-field')];

	const inputOf = (wrap: HTMLElement) =>
		wrap.querySelector('input') as HTMLInputElement | null;

	const isEligible = (entry: CatalogueEntry, cat: string) =>
		!(entry.excluded ?? []).some((x) => x.category === cat);

	/** Has the reader answered this field? A typed zero is an answer (sol-041). */
	const hasAnswer = (wrap: HTMLElement) => (inputOf(wrap)?.value ?? '').trim() !== '';

	/**
	 * Show a field, and therefore activate it. Kept as one function because the
	 * two must never come apart: a field on screen that reads as inactive is a box
	 * the reader fills in and a bill that does not move.
	 */
	function setShown(wrap: HTMLElement, shown: boolean) {
		wrap.hidden = !shown;
		const input = inputOf(wrap);
		if (input) input.dataset.active = shown ? 'true' : 'false';
	}

	/**
	 * Apply the category to every field on the form, then rebuild the dropdowns.
	 *
	 * Order matters: a field is shown if it is permanently visible and eligible,
	 * OR if it is already active. The second half is what keeps an answered field
	 * alive across a category change.
	 */
	function refreshOffers() {
		const cat = category();
		setText('categoryHint', CATEGORIES.find((c) => c.id === cat)?.hint ?? '');

		// NOTHING EXISTS BEFORE THE CATEGORY. Until we know who is asking, every
		// field we could show is one that might not apply to them, and showing it
		// is asking a question we already know may be wrong (dd-022).
		const body = document.getElementById('taxFormBody');
		if (body) body.hidden = !cat;
		if (!cat) return;

		const shownIds = new Set<string>();

		for (const wrap of fieldNodes()) {
			const id = wrap.dataset.field!;
			const entry = entryById.get(id);
			if (!entry) continue;

			const eligible = isEligible(entry, cat);
			const wasActive = inputOf(wrap)?.dataset.active === 'true';

			// An answered field survives everything. An unanswered one that has
			// stopped being offered goes quietly, because it moves no money and so
			// nothing can change behind the reader's back.
			const keep = wasActive && (eligible || hasAnswer(wrap));
			// THE ONE FIELD THIS CATEGORY OPENS ON. Everything else on this form
			// got here because the reader asked for it.
			const primary = isPrimary(entry, cat);
			const shown = keep || primary;
			setShown(wrap, shown);
			if (shown) shownIds.add(id);

			// The statute, where a field is on screen that this category could not
			// have chosen. Never asserted by us: it is the provision the catalogue
			// names, which is what makes dd-020 checkable rather than a promise.
			const statuteEl = wrap.querySelector<HTMLElement>('.tax-field-statute');
			const statute = shown && !eligible ? whyExcluded(id, cat) : null;
			if (statuteEl) {
				statuteEl.innerText = statute
					? `You have entered a figure here, so it is still being counted. ${statute}`
					: '';
				statuteEl.hidden = !statute;
			}

			// Removable unless it is the one field the category opens on — that one
			// is the form's floor, and a form with nothing in it is not a state the
			// reader can do anything from.
			const drop = wrap.querySelector<HTMLElement>('.tax-field-drop');
			if (drop) drop.hidden = !shown || primary;
		}

		rebuildAdders(cat, shownIds);
		document.getElementById('taxPresumptiveControls')!.hidden =
			!shownIds.has('presumptive44AD') && !shownIds.has('presumptive44ADA');
	}

	/**
	 * The three dropdowns - EXHAUSTIVE within the eligible set (dd-001/do-3).
	 *
	 * "Only the most common options should be permanently visible" is answered by
	 * what stays on screen, never by what exists here. Everything a category may
	 * lawfully declare is one click away.
	 */
	function rebuildAdders(cat: string, shownIds: Set<string>) {
		const eligibleIncome = new Set(incomeSourcesFor(cat).map((s) => s.id));

		const fill = (
			selectId: string,
			groups: Array<{ label: string; entries: CatalogueEntry[] }>
		) => {
			const select = document.getElementById(selectId) as HTMLSelectElement | null;
			if (!select) return;
			select.innerHTML = '';
			const placeholder = document.createElement('option');
			placeholder.value = '';
			// The control reads as an add button and behaves as a picker, so its
			// resting text is the invitation rather than the word "Choose".
			placeholder.innerText = `＋  ${select.dataset.addLabel ?? 'Add'}`;
			select.appendChild(placeholder);

			for (const group of groups) {
				const available = group.entries.filter((e) => !shownIds.has(e.id));
				if (!available.length) continue;
				const optgroup = document.createElement('optgroup');
				optgroup.label = group.label;
				for (const e of available) {
					const option = document.createElement('option');
					option.value = e.id;
					option.innerText = e.label;
					optgroup.appendChild(option);
				}
				select.appendChild(optgroup);
			}
			// A dropdown with nothing left in it is a control that does nothing, so
			// it says so rather than sitting there looking broken.
			// A control with nothing left in it does nothing, so it says so rather
			// than sitting there looking tappable.
			select.disabled = select.options.length <= 1;
			if (select.disabled) placeholder.innerText = 'You have added everything on offer here';
		};

		const bySource = (want: 'clubbable' | 'separate') =>
			(Object.keys(HEAD_LABEL) as Array<keyof typeof HEAD_LABEL>)
				.map((head) => ({
					label: HEAD_LABEL[head],
					entries: INCOME_SOURCES.filter(
						(s) =>
							s.head === head &&
							eligibleIncome.has(s.id) &&
							(want === 'separate' ? Boolean(s.unclubbable) : !s.unclubbable)
					) as CatalogueEntry[],
				}))
				.filter((g) => g.entries.length > 0);

		fill('taxAddIncome', bySource('clubbable'));
		fill('taxAddSeparate', bySource('separate'));
		fill('taxAddDeduction', [
			{
				label: 'Deductions',
				entries: DEDUCTIONS.filter((d) => d.target && isEligible(d, cat)) as CatalogueEntry[],
			},
		]);
	}

	function wrapFor(entryId: string) {
		return document.querySelector<HTMLElement>(`.tax-field[data-field="${entryId}"]`);
	}

	function addEntry(entryId: string) {
		const wrap = wrapFor(entryId);
		if (!wrap) return;

		// THE FIELD LANDS WHERE THE ADD CONTROL WAS, and the control moves down
		// under it. Fields are rendered by the server in catalogue order; moving
		// the node to the end of its block puts them in the order the READER
		// added them, so the form reads back as the conversation they just had
		// rather than as our list. dd-022.
		wrap.parentElement?.appendChild(wrap);
		setShown(wrap, true);

		// Electing a presumptive basis IS choosing to be taxed on it. Leaving the
		// selector on "my actual profit" while the reader types a turnover would be
		// a field that moves no money - sol-041, in the view layer.
		const basis = document.getElementById('inBusinessBasis') as HTMLSelectElement | null;
		if (basis && (entryId === 'presumptive44AD' || entryId === 'presumptive44ADA')) {
			basis.value = entryId === 'presumptive44AD' ? '44AD' : '44ADA';
		}

		refreshOffers();
		inputOf(wrap)?.focus();
		calculate();
	}

	function dropEntry(entryId: string) {
		const wrap = wrapFor(entryId);
		if (!wrap) return;
		const input = inputOf(wrap);
		if (input) input.value = '';
		setShown(wrap, false);

		const basis = document.getElementById('inBusinessBasis') as HTMLSelectElement | null;
		if (basis && (entryId === 'presumptive44AD' || entryId === 'presumptive44ADA')) {
			basis.value = 'books';
		}

		refreshOffers();
		calculate();
	}

	// ---------------------------------------------------------------- the panels

	type Row = {
		label: string;
		newVal: string;
		oldVal: string;
		/** `sub` and `total` carry a rule above them; `minor` is an indented aside. */
		kind?: 'sub' | 'total' | 'minor';
		newId?: string;
		oldId?: string;
	};

	function renderRows(tbodyId: string, rows: Row[]) {
		const body = document.getElementById(tbodyId);
		if (!body) return;
		body.innerHTML = rows
			.map((r) => {
				const rowClass =
					r.kind === 'total'
						? 'font-bold text-navy-900 dark:text-white'
						: r.kind === 'sub'
							? 'font-semibold bg-black/5 dark:bg-white/5'
							: r.kind === 'minor'
								? 'text-navy-600 dark:text-navy-400'
								: '';
				const pad = r.kind === 'minor' ? ' pl-4' : '';
				const cell = (value: string, id?: string) =>
					`<td class="py-2 text-right tabular-nums"${id ? ` id="${id}"` : ''}>${value}</td>`;
				return (
					`<tr class="${rowClass}">` +
					`<td class="py-2${pad}">${r.label}</td>` +
					cell(r.newVal, r.newId) +
					cell(r.oldVal, r.oldId) +
					'</tr>'
				);
			})
			.join('');
	}

	/** Both regimes, or nothing: a row exists only when it carries a figure. */
	const anyOf = (n: number, o: number) => Math.round(n) !== 0 || Math.round(o) !== 0;

	/**
	 * What the rows above gross total income add up to, so the panel can show the
	 * losses that were set against them rather than silently failing to reconcile.
	 * dd-009/dont-1 - a subtotal must follow from what is on screen.
	 */
	function slabRowsTotal(r: TaxRegimeResult): number {
		const h = r.heads;
		const hp = h.housePropertyIncome >= 0 ? h.housePropertyIncome : -h.housePropertySetOff;
		return h.salary + hp + h.business + h.otherSources + r.capitalGains.slabTaxed;
	}

	function renderIncomeComputation(input: ReturnType<typeof readTaxInputs>, result: ReturnType<typeof calculateIndiaTaxEngine>) {
		const n = result.newRegime;
		const o = result.oldRegime;
		const rows: Row[] = [];
		const add = (label: string, nv: number, ov: number, kind?: Row['kind'], negative = false) => {
			if (kind !== 'total' && kind !== 'sub' && !anyOf(nv, ov)) return;
			rows.push({
				label,
				newVal: negative ? formatNegative(nv) : formatRupee(nv),
				oldVal: negative ? formatNegative(ov) : formatRupee(ov),
				kind,
			});
		};

		if (input.grossSalary > 0) {
			add('Salary, before anything comes off', input.grossSalary, input.grossSalary);
			add('House rent allowance exempt', n.exemptions, o.exemptions, undefined, true);
			add('Standard deduction', n.standardDeduction, o.standardDeduction, undefined, true);
			add('Professional tax', n.professionalTax, o.professionalTax, undefined, true);
			add('Income from salary', n.heads.salary, o.heads.salary, 'sub');
		}

		const hp = (r: TaxRegimeResult) =>
			r.heads.housePropertyIncome >= 0 ? r.heads.housePropertyIncome : -r.heads.housePropertySetOff;
		add('House property', hp(n), hp(o));
		add(
			'of which carried to next year, unused',
			n.heads.housePropertyCarriedForward,
			o.heads.housePropertyCarriedForward,
			'minor'
		);
		add('Business or profession', n.heads.business, o.heads.business);
		add(
			'of which a loss with nowhere to go this year',
			n.heads.businessLossNotSetOff,
			o.heads.businessLossNotSetOff,
			'minor'
		);
		add('Other sources', n.heads.otherSources, o.heads.otherSources);
		add(
			'Short-term gains taxed at your slab rate',
			n.capitalGains.slabTaxed,
			o.capitalGains.slabTaxed
		);
		add(
			'Losses the law lets you set against these',
			slabRowsTotal(n) - n.grossTotalIncome,
			slabRowsTotal(o) - o.grossTotalIncome,
			undefined,
			true
		);
		add('Gross total income', n.grossTotalIncome, o.grossTotalIncome, 'sub');

		// Chapter VI-A, a line per section the reader claimed. sol-056 built these
		// so the panel could say what happened to each rather than print one total
		// that silently absorbed the difference.
		const sections = [...new Set([...n.chapterVIADetail.lines, ...o.chapterVIADetail.lines].map((l) => l.section))];
		for (const section of sections) {
			const nl = n.chapterVIADetail.lines.find((l) => l.section === section);
			const ol = o.chapterVIADetail.lines.find((l) => l.section === section);
			if (!(nl?.claimed || ol?.claimed)) continue;
			// PUSHED, NOT `add`ed, because `add` drops a row whose figures are all
			// zero - and a deduction the reader claimed and the law allowed NOTHING
			// of is the one row that must never disappear. s.80CCE can zero a claim
			// outright, and a reader who typed Rs 1 lakh and sees no line for it has
			// been left to wonder whether we took it at all.
			rows.push({
				label: `Deduction under s.${section}`,
				newVal: formatNegative(nl?.allowed ?? 0),
				oldVal: formatNegative(ol?.allowed ?? 0),
			});
		}
		add(
			'Restricted so deductions cannot exceed income',
			n.chapterVIADetail.clampedByGti,
			o.chapterVIADetail.clampedByGti
		);
		add('Income taxed at slab rates', n.slabIncome, o.slabIncome, 'sub');

		// THE ROW IS THE GAIN, NOT THE PART OF IT THAT WAS TAXED. `specialRateIncome`
		// is the gain, so a bucket row showing `taxed` would leave the subtotal
		// unreachable from the rows above it - ₹1,75,000 standing under a total of
		// ₹3,00,000, which is precisely the figure-that-does-not-follow this panel
		// exists to prevent. What the exemptions took comes off on its own line.
		const gains: Array<[string, 'stcg111A' | 'ltcg112A' | 'ltcg112']> = [
			['Gains on shares held under a year, at 20%', 'stcg111A'],
			['Gains on shares held over a year, at 12.5%', 'ltcg112A'],
			['Gains on other assets, long term, at 12.5%', 'ltcg112'],
		];
		for (const [label, key] of gains) {
			const nd = n.capitalGains[key];
			const od = o.capitalGains[key];
			add(label, nd.gain, od.gain);
			add(
				'of which exempt under s.112A, and not taxed',
				nd.ownExemption,
				od.ownExemption,
				'minor'
			);
			add(
				'of which covered by the basic exemption your other income did not use',
				nd.basicExemptionUsed,
				od.basicExemptionUsed,
				'minor'
			);
		}
		add(
			'Gains taxed at their own rates',
			n.capitalGains.specialRateIncome,
			o.capitalGains.specialRateIncome,
			anyOf(n.capitalGains.specialRateIncome, o.capitalGains.specialRateIncome) ? 'sub' : undefined
		);

		add('Total income', n.taxableIncome, o.taxableIncome, 'total');

		// DECLARED AND NOT TAXED, and it sits BELOW the total on purpose: putting
		// it above would make the total stop following from the rows, and putting
		// it nowhere would leave the reader unable to see that real money they
		// told us about was accounted for. This is the one row on the panel that
		// is meant to change nothing, and it says so.
		add('Exempt income, declared and not taxed', n.exemptIncome, o.exemptIncome, 'minor');
		renderRows('incRows', rows);
		renderIncomeNotes(input, result);
	}

	/** The words. A figure that was cut says so where it happened, not later. */
	function renderIncomeNotes(input: ReturnType<typeof readTaxInputs>, result: ReturnType<typeof calculateIndiaTaxEngine>) {
		const notes: string[] = [];
		const n = result.newRegime;
		const o = result.oldRegime;

		if (input.houseProperty.kind === 'selfOccupied' && o.heads.housePropertyIncome < 0) {
			notes.push(
				`A home you live in earns nothing, so this interest is a loss of ` +
					`${formatRupee(-o.heads.housePropertyIncome)} — worth claiming only under the old ` +
					`regime. The new regime allows none of it, which is the single biggest reason a ` +
					`borrower stays on the old one.`
			);
		} else if (input.houseProperty.kind === 'letOut' && n.heads.housePropertyIncome > 0) {
			notes.push(
				`Rent, less the municipal tax you paid, less 30%, less the interest: ` +
					`${formatRupee(n.heads.housePropertyIncome)} of income from the property.`
			);
		} else if (input.houseProperty.kind === 'letOut' && n.heads.housePropertyIncome < 0) {
			notes.push(
				`The interest costs you more than the rent brings in, so this property is a loss of ` +
					`${formatRupee(-n.heads.housePropertyIncome)}. On a property you let out the interest ` +
					`itself is uncapped — it is the LOSS that gets capped, at ₹2 lakh a year against your ` +
					`other income, and the rest carries forward.`
			);
		}

		// An elected presumptive basis DISPLACES the books rather than adding to
		// them, so a reader who typed a profit and sees a different one on this
		// panel has been handed a figure that does not follow from what they
		// entered - dd-009/dont-1. The election is stated where the difference
		// appears, not only in the form beside the control.
		const bd = n.heads.businessDetail;
		if (input.business.basis !== 'books' && bd.booksProfit !== n.heads.business) {
			notes.push(
				`You have elected to be taxed on the deemed profit under s.${input.business.basis}, so ` +
					`the ${formatRupee(bd.booksProfit)} in your books is not what is being charged — ` +
					`${formatRupee(n.heads.business)} is. Both are priced beside the election.`
			);
		}

		// One note per REASON rather than one per section. A reader claiming 80C,
		// 80D and 80CCD(1B) under the new regime does not need to be told three
		// times that s.115BAC withdrew them; they need to be told once, with the
		// sections named. Grouping by the engine's own reason string does that
		// without the page having to know which reasons exist.
		for (const [regime, result] of [['New regime', n], ['Old regime', o]] as const) {
			const byReason = new Map<string, string[]>();
			for (const line of result.chapterVIADetail.lines) {
				if (!line.claimed || !line.reason || line.allowed >= line.claimed) continue;
				byReason.set(line.reason, [...(byReason.get(line.reason) ?? []), `s.${line.section}`]);
			}
			for (const [reason, sections] of byReason) {
				const claimed = result.chapterVIADetail.lines
					.filter((l) => sections.includes(`s.${l.section}`))
					.reduce((sum, l) => sum + l.claimed - l.allowed, 0);
				notes.push(
					`${regime}: ${reason} That costs you ${formatRupee(claimed)} of what you claimed under ` +
						`${sections.join(', ')}.`
				);
			}
		}

		if (o.chapterVIADetail.clampedByGti > 0 || n.chapterVIADetail.clampedByGti > 0) {
			notes.push(
				'Chapter VI-A can reduce your income to nil but never below it, so the part of your ' +
					'claim that had no income left to come off was restricted rather than carried anywhere.'
			);
		}

		const exemptGains =
			o.capitalGains.ltcg112A.ownExemption + o.capitalGains.basicExemptionAbsorbed;
		if (exemptGains > 0) {
			const parts: string[] = [];
			if (o.capitalGains.ltcg112A.ownExemption > 0) {
				parts.push(
					`${formatRupee(o.capitalGains.ltcg112A.ownExemption)} of your long-term share gains is ` +
						`exempt under s.112A's own yearly allowance`
				);
			}
			if (o.capitalGains.basicExemptionAbsorbed > 0) {
				parts.push(
					`${formatRupee(o.capitalGains.basicExemptionAbsorbed)} was covered by the part of your ` +
						`basic exemption your other income did not use`
				);
			}
			notes.push(`${parts.join(', and ')}. That is why the gains taxed are less than the gains made.`);
		}

		if (o.losses.capitalLossBarredFromOtherHeads) {
			notes.push(
				'A capital loss you could not use is carried forward rather than set against your ' +
					'salary or your interest. s.71 bars it from every head but its own.'
			);
		}

		const notesEl = document.getElementById('incNotes');
		if (!notesEl) return;
		notesEl.innerHTML = '';
		for (const text of notes) {
			const p = document.createElement('p');
			p.className = 'text-sm text-navy-600 dark:text-navy-400 leading-relaxed';
			p.innerText = text;
			notesEl.appendChild(p);
		}
	}

	function renderTaxComputation(result: ReturnType<typeof calculateIndiaTaxEngine>) {
		const n = result.newRegime;
		const o = result.oldRegime;
		const rows: Row[] = [];
		const add = (label: string, nv: number, ov: number, kind?: Row['kind'], negative = false, ids?: [string, string]) => {
			if (!kind && !anyOf(nv, ov)) return;
			rows.push({
				label,
				newVal: negative ? formatNegative(nv) : formatRupee(nv),
				oldVal: negative ? formatNegative(ov) : formatRupee(ov),
				kind,
				newId: ids?.[0],
				oldId: ids?.[1],
			});
		};

		rows.push({
			label: 'Tax on income at slab rates',
			newVal: formatRupee(n.slabTax),
			oldVal: formatRupee(o.slabTax),
		});
		add('Tax on gains at their own rates', n.specialRateTax, o.specialRateTax);
		add('Rebate under s.87A', n.rebate87A, o.rebate87A, undefined, true);
		add('Surcharge', n.surcharge, o.surcharge);
		add('Marginal relief', n.marginalRelief, o.marginalRelief, undefined, true);
		add('Health and education cess, 4%', n.cess, o.cess);
		add('Total tax', n.totalTax, o.totalTax, 'total', false, ['taxTotalNew', 'taxTotalOld']);

		renderRows('taxRows', rows);

		setText(
			'taxMarginalNote',
			n.marginalRelief > 0 || o.marginalRelief > 0
				? 'Marginal relief is the rule that crossing a threshold must never cost more than the ' +
						'income that crossed it. Where the extra tax would exceed the extra income, the ' +
						'difference is given back.'
				: ''
		);

		const slabRow = (s: { range: string; rate: string; tax: number }) =>
			`<tr><td class="py-2">${s.range}</td><td class="py-2 text-navy-600 dark:text-navy-400">${s.rate}</td>` +
			`<td class="py-2 text-right tabular-nums">${formatRupee(s.tax)}</td></tr>`;
		const slabsInto = (id: string, r: TaxRegimeResult) => {
			const body = document.getElementById(id);
			if (body) body.innerHTML = r.slabs.map(slabRow).join('');
		};
		slabsInto('slabRowsNew', n);
		slabsInto('slabRowsOld', o);
	}

	// ---------------------------------------------------------------- the answer

	function renderAnswer(model: ReturnType<typeof buildTaxAnswer>) {
		const { verdict, breakEven } = model;
		const b = verdict.better;

		setText('ansMonthly', formatRupee(model.monthly));
		setText('ansAnnual', formatRupee(b.totalTax));
		setText('ansGross', formatRupee(b.grossIncome));
		setText('ansRate', `${b.effectiveRate}%`);

		// The effective rate divides by TOTAL INCOME, which a loss reduces. A
		// reader earning 15 lakh who is told "income of 13,00,000" has been handed
		// a question the screen must answer in the same breath (dd-009/dont-1), so
		// the gap is reconciled inline whenever it exists - and the clause
		// disappears when there is nothing to explain.
		const h = b.heads;
		const earned =
			h.salary + b.standardDeduction + b.exemptions +
			Math.max(0, h.housePropertyIncome) + h.business + h.otherSources +
			b.capitalGains.specialRateIncome + b.capitalGains.slabTaxed;
		const reduced = Math.round(earned - b.grossIncome);
		setText(
			'ansReconcile',
			reduced > 0
				? `That is your ${formatRupee(earned)} of income less ${formatRupee(reduced)} of losses the law lets you set against it.`
				: ''
		);

		setText('ansTaxNew', formatRupee(model.result.newRegime.totalTax));
		setText('ansTaxOld', formatRupee(model.result.oldRegime.totalTax));
		setText('ansSubNew', `Effective rate ${model.result.newRegime.effectiveRate}%`);
		setText('ansSubOld', `Effective rate ${model.result.oldRegime.effectiveRate}%`);

		// THE BOUNDARY, not the current position (dd-008). The sentence states a
		// principle that stays true at every input; only the values move.
		const el = document.getElementById('ansBreakEven');
		if (!el) return;
		if (verdict.winner === 'tie') {
			el.innerText = 'Both regimes cost the same on these figures, so the choice is yours.';
		} else if (verdict.winner === 'old') {
			el.innerText =
				`The old regime wins here because you claim ${inWords(breakEven.claimed)} of deductions and ` +
				`exemptions. It stops winning if that falls below roughly ${inWords(breakEven.required)}.`;
		} else if (!breakEven.exists) {
			el.innerText =
				'No amount of deductions makes the old regime cheaper here — the gap is in how the two ' +
				'regimes treat capital gains, which deductions cannot touch.';
		} else {
			el.innerText =
				`The new regime is a bet that your deductions stay small. The old one only wins if you can ` +
				`claim ${inWords(breakEven.required)}; you are claiming ${inWords(breakEven.claimed)}, so you ` +
				`would need ${inWords(breakEven.shortfall)} more.`;
		}
		setText(
			'deductionBoundary',
			breakEven.exists && breakEven.shortfall > 0
				? `Claiming ${inWords(breakEven.shortfall)} more than you do now would make the old regime the cheaper one.`
				: breakEven.exists
					? 'You already claim enough for the old regime to be the cheaper one.'
					: ''
		);
	}

	/**
	 * sol-043. EVERY emphasis on this page is applied here, from one verdict.
	 *
	 * It used to be five independent decisions written into the markup, all fixed
	 * at "the new regime is the answer". At maxed deductions, or on an ordinary
	 * ₹2 lakh home loan, the badge read "OLD REGIME SAVES ..." while the losing
	 * bill stayed the boldest, greenest number on the screen. Nothing in the
	 * markup may decide this for itself.
	 */
	function applyVerdict(verdict: ReturnType<typeof buildTaxAnswer>['verdict']) {
		const WIN = ['ring-2', 'ring-emerald-500/60', 'border-emerald-500/40'];
		const WIN_TEXT = ['text-emerald-700', 'dark:text-emerald-400', 'font-black'];

		for (const [regime, ansCardId, tagId, incColId, taxColId, totalId] of [
			['new', 'ansCardNew', 'ansTagNew', 'incColNew', 'taxColNew', 'taxTotalNew'],
			['old', 'ansCardOld', 'ansTagOld', 'incColOld', 'taxColOld', 'taxTotalOld'],
		] as const) {
			const won = verdict.winner === regime;
			const card = document.getElementById(ansCardId);
			if (card) WIN.forEach((c) => card.classList.toggle(c, won));
			for (const id of [incColId, taxColId, totalId]) {
				const e = document.getElementById(id);
				if (e) WIN_TEXT.forEach((c) => e.classList.toggle(c, won));
			}
			const tag = document.getElementById(tagId);
			if (tag) {
				tag.innerText = won ? 'Cheaper for you' : '';
				tag.className = won
					? 'text-xs font-bold tracking-tight px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-700 dark:text-emerald-400'
					: 'text-xs font-bold tracking-tight px-2 py-0.5 rounded';
			}
		}
	}

	/** The copy inside the form that depends on what the engine actually did. */
	function renderFormNotes(result: ReturnType<typeof calculateIndiaTaxEngine>) {
		setText('valHraExempt', formatRupee(result.oldRegime.exemptions));

		// Both presumptive bases, side by side, from one turnover figure.
		// dd-006/dont-2: the difference between declaring an actual profit and a
		// deemed one IS the lesson here, so both are priced and shown at once.
		const d = result.newRegime.heads.businessDetail;
		const cmp = document.getElementById('presumptiveCompare');
		if (cmp) {
			const row = (label: string, value: string, note: string) =>
				`<div class="flex justify-between gap-3"><span class="text-navy-600 dark:text-navy-400">${label}</span>` +
				`<span class="font-bold tabular-nums text-navy-900 dark:text-navy-100">${value}</span></div>` +
				(note ? `<div class="text-navy-600 dark:text-navy-400">${note}</div>` : '');
			cmp.innerHTML =
				row('Your actual profit', formatRupee(d.booksProfit), '') +
				row(
					`Deemed under s.44AD, at ${(d.ad44.effectiveRate * 100).toFixed(1)}%`,
					d.ad44.available ? formatRupee(d.ad44.deemedProfit) : '—',
					d.ad44.available ? '' : d.ad44.unavailableReason
				) +
				row(
					'Deemed under s.44ADA, at 50%',
					d.ada44.available ? formatRupee(d.ada44.deemedProfit) : '—',
					d.ada44.available ? '' : d.ada44.unavailableReason
				);
		}

		const L = result.newRegime.losses;
		const carried =
			L.shortTerm.carriedForward + L.longTerm.carriedForward +
			L.business.carriedForward + L.houseProperty.carriedForward;
		setText(
			'lossNote',
			carried > 0
				? `${formatRupee(carried)} could not be used this year and carries forward for up to eight years, against its own kind of income only.`
				: ''
		);
	}

	// ---------------------------------------------------------------- the loop

	function calculate() {
		// The page is a view: read, compute, render. Every field on it is read by
		// `readTaxInputs()` and by nothing else - see taxInputs.ts for why that
		// matters before the second surface exists rather than after.
		const input = readTaxInputs();
		const model = buildTaxAnswer(input);

		// Nothing to answer yet, so nothing claims to. A screen showing a
		// confident nil is worse than an empty one: the reader cannot tell a
		// result from a starting position.
		const hasIncome = model.result.newRegime.grossIncome > 0;
		const show = (id: string, on: boolean) => {
			const e = document.getElementById(id);
			if (e) e.hidden = !on;
		};
		show('taxAnswerWrap', hasIncome);
		show('taxPanels', hasIncome);
		show('taxPanelsWaiting', !hasIncome);
		if (!hasIncome) return;

		renderAnswer(model);
		applyVerdict(model.verdict);
		renderIncomeComputation(input, model.result);
		renderTaxComputation(model.result);
		renderFormNotes(model.result);
	}

	document.addEventListener('DOMContentLoaded', () => {
		// The field lists come from the reader too. A page that keeps its own copy
		// is a page where a field can be added to the form and to the input set and
		// still never trigger a recompute.
		MONEY_FIELD_IDS.forEach((id) => {
			const el = document.getElementById(id);
			if (el) setupFormattingField(el as HTMLInputElement, calculate);
		});

		CHOICE_FIELD_IDS.forEach((id) => {
			document.getElementById(id)?.addEventListener('change', calculate);
		});

		// TWO CONTROLS, ONE ANSWER. The question is asked in the welcome and
		// restated compactly at the top of the form, so the reader can change it
		// without going back to a screen that has collapsed. They are kept in step
		// here rather than by each writing its own copy - dd-013/dont-2, one
		// quantity standing on a page twice with two values.
		const restate = document.getElementById('inCategoryRestate') as HTMLSelectElement | null;
		const onCategoryChanged = (value: string) => {
			const primary = document.getElementById('inCategory') as HTMLSelectElement | null;
			if (primary && primary.value !== value) primary.value = value;
			if (restate && restate.value !== value) restate.value = value;
			// The opening question can be answered but not un-answered. Going back
			// to "Choose one to begin" would hide the form while its fields kept
			// their values and kept computing - figures the reader can no longer
			// see moving a bill they can.
			if (value) primary?.querySelector('option[value=""]')?.remove();
			resolvePage();
			refreshOffers();
			calculate();
		};

		document.getElementById('inCategory')?.addEventListener('change', (e) => {
			onCategoryChanged((e.target as HTMLSelectElement).value);
		});
		restate?.addEventListener('change', (e) => {
			onCategoryChanged((e.target as HTMLSelectElement).value);
		});

		for (const selectId of ['taxAddIncome', 'taxAddSeparate', 'taxAddDeduction']) {
			document.getElementById(selectId)?.addEventListener('change', (e) => {
				const select = e.target as HTMLSelectElement;
				const id = select.value;
				select.value = '';
				if (id) addEntry(id);
			});
		}

		document.getElementById('taxInputForm')?.addEventListener('click', (e) => {
			const drop = (e.target as HTMLElement).closest<HTMLElement>('.tax-field-drop');
			if (drop?.dataset.drop) dropEntry(drop.dataset.drop);
		});

		refreshOffers();
		calculate();
	});
</script>
