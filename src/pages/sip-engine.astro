  function renderScheduleTable(inputs: any, sim: any) {
    const tbody = document.getElementById('sipScheduleTableBody');
    if (!tbody) return;
    tbody.innerHTML = '';

    const years = inputs.horizonYears;
    const p10 = sim.p10Real || [];
    const p50 = sim.p50Real || [];
    const p90 = sim.p90Real || [];
    const plan = contributionPlan(inputs);

    let cumulativeInvestedReal = inputs.seedCapital || 0;

    for (let yr = 1; yr <= years; yr++) {
      const monthlyNominal = instalmentInYear(inputs, yr);
      const monthlyReal = (plan?.monthly ?? inputs.monthlySip) * Math.pow(1 + (plan?.realStep ?? 0), Math.max(0, yr - 1));
      const yearContributionReal = monthlyReal * 12;
      cumulativeInvestedReal += yearContributionReal;

      const b10 = p10[yr] || 0;
      const b50 = p50[yr] || 0;
      const b90 = p90[yr] || 0;
      const wealthGained = Math.max(0, b50 - cumulativeInvestedReal);

      const row = document.createElement('tr');
      row.className = 'hover:bg-navy-50/50 dark:hover:bg-navy-900/50 transition-colors';
      row.innerHTML = `
        <td class="py-2 px-3 text-left font-bold text-navy-800 dark:text-navy-200">Year ${yr}</td>
        <td class="py-2 px-3 text-right font-medium text-navy-700 dark:text-navy-300">₹ ${grp(monthlyNominal)}</td>
        <td class="py-2 px-3 text-right font-semibold text-navy-700 dark:text-navy-300">${formatMoney(cumulativeInvestedReal)}</td>
        <td class="py-2 px-3 text-right font-bold text-emerald-700 dark:text-emerald-400">+${formatMoney(wealthGained)}</td>
        <td class="py-2 px-3 text-right text-rose-700 dark:text-rose-400">${formatMoney(b10)}</td>
        <td class="py-2 px-3 text-right font-bold text-navy-900 dark:text-white">${formatMoney(b50)}</td>
        <td class="py-2 px-3 text-right font-bold text-emerald-700 dark:text-emerald-400">${formatMoney(b90)}</td>
      `;
      tbody.appendChild(row);
    }
  }

  function renderMetrics(inputs: any, sim: any, outlook: any) {
    const totalInvested = (outlook?.flow?.investedReal ?? sim.realOutflowPV) || 0;
    const p50 = sim.p50Real ? sim.p50Real[inputs.horizonYears] : 0;
    const p10 = sim.p10Real ? sim.p10Real[inputs.horizonYears] : 0;
    const p90 = sim.p90Real ? sim.p90Real[inputs.horizonYears] : 0;
    const p50Nominal = sim.p50Nominal ? sim.p50Nominal[inputs.horizonYears] : 0;
    const totalInvestedNominal = (outlook?.flow?.investedNominal ?? sim.nominalTotalInvested) || (totalInvested * Math.pow(1 + (inputs.expectedInflation || 6) / 100, inputs.horizonYears / 2));

    const elInvested = document.getElementById('statTotalInvested');
    if (elInvested) elInvested.textContent = formatMoney(totalInvested);

    const elReal = document.getElementById('statRealWealth');
    if (elReal) elReal.textContent = formatMoney(p50);

    const elNom = document.getElementById('statNominalEquivalent');
    if (elNom) elNom.textContent = `Bank statement in yr ${inputs.horizonYears}: ${formatMoney(p50Nominal)}`;

    // Yours vs Market Created Split
    const marketCreated = Math.max(0, p50 - totalInvested);
    const totalWealth = totalInvested + marketCreated;
    const pctYours = totalWealth > 0 ? Math.round((totalInvested / totalWealth) * 100) : 50;
    const pctMkt = 100 - pctYours;

    const elPctSacrifice = document.getElementById('pctSacrifice');
    if (elPctSacrifice) elPctSacrifice.textContent = `${pctYours}%`;

    const elPctCreated = document.getElementById('pctCreated');
    if (elPctCreated) elPctCreated.textContent = `${pctMkt}%`;

    const elBarSacrifice = document.getElementById('barSacrifice');
    if (elBarSacrifice) elBarSacrifice.style.width = `${pctYours}%`;

    const elBarCreated = document.getElementById('barCreated');
    if (elBarCreated) elBarCreated.style.width = `${pctMkt}%`;

    // Multipliers
    const multExp = outlook?.flow?.multiple ? outlook.flow.multiple.toFixed(2) : (totalInvested > 0 ? (p50 / totalInvested).toFixed(2) : '1.00');
    const multWorst = totalInvested > 0 ? (p10 / totalInvested).toFixed(2) : '1.00';
    const multBest = totalInvested > 0 ? (p90 / totalInvested).toFixed(2) : '1.00';

    const elExpMult = document.getElementById('expectedMultiplierTag');
    if (elExpMult) elExpMult.textContent = `${multExp}x Purchasing Power`;

    const elWorstMult = document.getElementById('worstMultiplierTag');
    if (elWorstMult) elWorstMult.textContent = `${multWorst}x (10th)`;

    const elBestMult = document.getElementById('bestMultiplierTag');
    if (elBestMult) elBestMult.textContent = `${multBest}x (90th)`;

    // Real CAGR Return above inflation
    const realCagr = computeRealCagr(
      inputs.seedCapital || 0,
      inputs.monthlySip || 0,
      inputs.realStepUp || 0,
      inputs.horizonYears || 20,
      p50
    );

    const elYield = document.getElementById('valAdjustedYield');
    if (elYield) {
      elYield.textContent = `+${realCagr.toFixed(1)}% / yr real`;
    }

    // Bear / Bull cards
    const elBear = document.getElementById('statBearWealth');
    if (elBear) elBear.textContent = formatMoney(p10);

    const elBull = document.getElementById('statBullWealth');
    if (elBull) elBull.textContent = formatMoney(p90);

    // Tab 2: Invested vs Wealth Gained Split Bar & Breakdown
    const splitInvAmt = document.getElementById('splitInvestedAmount');
    if (splitInvAmt) splitInvAmt.textContent = formatMoney(totalInvested);

    const splitInvPct = document.getElementById('splitInvestedPct');
    if (splitInvPct) splitInvPct.textContent = `${pctYours}%`;

    const splitGainAmt = document.getElementById('splitGainedAmount');
    if (splitGainAmt) splitGainAmt.textContent = formatMoney(marketCreated);

    const splitGainPct = document.getElementById('splitGainedPct');
    if (splitGainPct) splitGainPct.textContent = `${pctMkt}%`;

    const splitInvBar = document.getElementById('splitInvestedBar');
    if (splitInvBar) splitInvBar.style.width = `${pctYours}%`;

    const splitGainBar = document.getElementById('splitGainedBar');
    if (splitGainBar) splitGainBar.style.width = `${pctMkt}%`;

    // 4-Card Summary Grid in Tab 2
    const elCompInvReal = document.getElementById('compoundingInvestedReal');
    if (elCompInvReal) elCompInvReal.textContent = formatMoney(totalInvested);

    const elCompInvNom = document.getElementById('compoundingInvestedNominal');
    if (elCompInvNom) elCompInvNom.textContent = `Nominal outlay: ${formatMoney(totalInvestedNominal)}`;

    const elCompGainReal = document.getElementById('compoundingGainedReal');
    if (elCompGainReal) elCompGainReal.textContent = `+${formatMoney(marketCreated)}`;

    const marketCreatedNominal = Math.max(0, p50Nominal - totalInvestedNominal);
    const elCompGainNom = document.getElementById('compoundingGainedNominal');
    if (elCompGainNom) elCompGainNom.textContent = `Nominal gain: +${formatMoney(marketCreatedNominal)}`;

    const elCompReal = document.getElementById('compoundingRealValue');
    if (elCompReal) elCompReal.textContent = formatMoney(p50);

    const elCompNom = document.getElementById('compoundingNominalValue');
    if (elCompNom) elCompNom.textContent = `Nominal value: ${formatMoney(p50Nominal)}`;

    const elCompMult = document.getElementById('compoundingMultiplier');
    if (elCompMult) elCompMult.textContent = `${multExp}x Real`;

    const elCompXirr = document.getElementById('compoundingRealXirr');
    if (elCompXirr) {
      elCompXirr.textContent = `Real CAGR: +${realCagr.toFixed(1)}% / yr`;
    }

    // Check Sanity Notice & Render Table
    checkSanity(inputs, sim);
    renderScheduleTable(inputs, sim);
  }

  function setupNumericField(
    el: HTMLInputElement | null,
    min: number,
    max: number,
    fallback: number,
    onChange: () => void
  ) {
    if (!el) return;
    el.addEventListener('keydown', (e) => {
      const allowedSpecialKeys = [
        'Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown',
        'Tab', 'Home', 'End', 'Enter', 'Escape', '.'
      ];
      if (allowedSpecialKeys.includes(e.key) || e.ctrlKey || e.metaKey) return;
      if (!/^[0-9]$/.test(e.key)) {
        e.preventDefault();
      }
    });
    el.addEventListener('blur', () => {
      let val = parseFloat(el.value);
      if (isNaN(val) || !Number.isFinite(val)) {
        val = fallback;
      } else {
        val = Math.max(min, Math.min(max, val));
      }
      el.value = String(val);
      syncEntryFromAdvanced();
      updateDisplayBadges();
      onChange();
    });
  }

