  function renderChart(inputs: any, sim: any) {
    const canvas = document.getElementById('sipChart') as HTMLCanvasElement | null;
    const container = document.getElementById('sipChartContainer');
    if (!canvas || !container) return;

    const rect = container.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    const width = rect.width - 24;
    const height = Math.max(260, rect.height - 24);

    canvas.width = width * dpr;
    canvas.height = height * dpr;
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.scale(dpr, dpr);

    const isDark = document.documentElement.classList.contains('dark');
    ctx.clearRect(0, 0, width, height);

    const padding = { top: 20, right: 30, bottom: 35, left: 60 };
    const chartW = width - padding.left - padding.right;
    const chartH = height - padding.top - padding.bottom;

    const years = inputs.horizonYears;
    const p90 = sim.p90Real || [];
    const p50 = sim.p50Real || [];
    const p10 = sim.p10Real || [];
    const target = inputs.targetRealWealth;

    let maxVal = Math.max(target * 1.15, ...p90.slice(0, years + 1));
    if (maxVal <= 0) maxVal = 10000000;

    const getX = (yr: number) => padding.left + (yr / years) * chartW;
    const getY = (val: number) => padding.top + chartH - (val / maxVal) * chartH;

    // Grid lines
    ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.06)';
    ctx.lineWidth = 1;
    const yTicks = 4;
    for (let i = 0; i <= yTicks; i++) {
      const val = (maxVal / yTicks) * i;
      const y = getY(val);
      ctx.beginPath();
      ctx.moveTo(padding.left, y);
      ctx.lineTo(padding.left + chartW, y);
      ctx.stroke();

      ctx.fillStyle = isDark ? '#94a3b8' : '#64748b';
      ctx.font = '10px ui-sans-serif, system-ui';
      ctx.textAlign = 'right';
      ctx.fillText(formatMoney(val), padding.left - 8, y + 3);
    }

    // X Axis Labels
    ctx.textAlign = 'center';
    const xStep = Math.max(1, Math.round(years / 5));
    for (let yr = 0; yr <= years; yr += xStep) {
      const x = getX(yr);
      ctx.fillText(`Yr ${yr}`, x, padding.top + chartH + 20);
    }

    // Cone Fill (p10 to p90)
    ctx.beginPath();
    ctx.moveTo(getX(0), getY(p10[0] || 0));
    for (let yr = 1; yr <= years; yr++) ctx.lineTo(getX(yr), getY(p10[yr] || 0));
    for (let yr = years; yr >= 0; yr--) ctx.lineTo(getX(yr), getY(p90[yr] || 0));
    ctx.closePath();
    ctx.fillStyle = isDark ? 'rgba(56, 189, 248, 0.12)' : 'rgba(14, 165, 233, 0.1)';
    ctx.fill();

    // p10 Curve (Rose)
    ctx.beginPath();
    ctx.strokeStyle = isDark ? '#f43f5e' : '#e11d48';
    ctx.lineWidth = 2;
    for (let yr = 0; yr <= years; yr++) {
      const x = getX(yr), y = getY(p10[yr] || 0);
      if (yr === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // p90 Curve (Emerald)
    ctx.beginPath();
    ctx.strokeStyle = isDark ? '#10b981' : '#059669';
    ctx.lineWidth = 2;
    for (let yr = 0; yr <= years; yr++) {
      const x = getX(yr), y = getY(p90[yr] || 0);
      if (yr === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // p50 Median Curve (Navy/White)
    ctx.beginPath();
    ctx.strokeStyle = isDark ? '#f8fafc' : '#0f172a';
    ctx.lineWidth = 3;
    for (let yr = 0; yr <= years; yr++) {
      const x = getX(yr), y = getY(p50[yr] || 0);
      if (yr === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Target Line (Dashed Gold)
    ctx.beginPath();
    ctx.setLineDash([6, 4]);
    ctx.strokeStyle = '#d97706';
    ctx.lineWidth = 2;
    const targetY = getY(target);
    ctx.moveTo(padding.left, targetY);
    ctx.lineTo(padding.left + chartW, targetY);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = '#d97706';
    ctx.font = 'bold 10px ui-sans-serif, system-ui';
    ctx.textAlign = 'right';
    ctx.fillText(`Target: ${formatMoney(target)}`, padding.left + chartW, targetY - 6);
  }

  function renderMilestones(inputs: any, sim: any) {
    const container = document.getElementById('milestoneTimeline');
    if (!container) return;
    container.innerHTML = '';

    const p50 = sim.p50Real || [];
    const target = inputs.targetRealWealth;
    const steps = [
      { label: '₹25 Lakh', amount: 2500000 },
      { label: '₹50 Lakh', amount: 5000000 },
      { label: '₹1 Crore', amount: 10000000 },
      { label: '₹2 Crore', amount: 20000000 },
      { label: `Goal (${formatMoney(target)})`, amount: target },
    ].filter((s) => s.amount <= target * 1.5);

    steps.forEach((step) => {
      let reachYear: number | null = null;
      for (let yr = 1; yr <= inputs.horizonYears; yr++) {
        if ((p50[yr] || 0) >= step.amount) {
          reachYear = yr;
          break;
        }
      }

      const pill = document.createElement('div');
      pill.className = reachYear !== null
        ? 'px-3 py-1.5 rounded-lg border border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 font-medium inline-flex items-center gap-1.5 shadow-2xs'
        : 'px-3 py-1.5 rounded-lg border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 text-navy-400 font-medium inline-flex items-center gap-1.5';

      pill.innerHTML = reachYear !== null
        ? `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span><strong>${step.label}:</strong> Year ${reachYear}</span>`
        : `<span class="w-2 h-2 rounded-full bg-navy-300 dark:bg-navy-700"></span><span>${step.label}: Missed</span>`;

      container.appendChild(pill);
    });
  }

