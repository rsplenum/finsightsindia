	function initPresets() {
		const btns = document.querySelectorAll('.preset-btn');
		btns.forEach(btn => {
			btn.addEventListener('click', () => {
				const type = btn.getAttribute('data-preset');
				const eq = document.getElementById('equitySlider') as HTMLInputElement;
				const dt = document.getElementById('debtSlider') as HTMLInputElement;
				const gd = document.getElementById('goldSlider') as HTMLInputElement;
				const years = document.getElementById('investmentYears') as HTMLInputElement;

				const eqV = document.getElementById('equityVal');
				const dtV = document.getElementById('debtVal');
				const gdV = document.getElementById('goldVal');

				if (type === 'conservative') {
					if (eq) eq.value = '50';
					if (dt) dt.value = '40';
					if (gd) gd.value = '10';
				} else if (type === 'balanced') {
					if (eq) eq.value = '70';
					if (dt) dt.value = '20';
					if (gd) gd.value = '10';
				} else if (type === 'aggressive') {
					if (eq) eq.value = '80';
					if (dt) dt.value = '10';
					if (gd) gd.value = '10';
				} else if (type === 'fire') {
					if (eq) eq.value = '80';
					if (dt) dt.value = '10';
					if (gd) gd.value = '10';
					if (years) years.value = '15';
				}

				if (eqV && eq) eqV.innerText = `${eq.value}%`;
				if (dtV && dt) dtV.innerText = `${dt.value}%`;
				if (gdV && gd) gdV.innerText = `${gd.value}%`;

				handleCalculationTrigger();
			});
		});
	}

	function initSliders() {
		const eq = document.getElementById('equitySlider') as HTMLInputElement;
		const dt = document.getElementById('debtSlider') as HTMLInputElement;
		const gd = document.getElementById('goldSlider') as HTMLInputElement;
		const eqV = document.getElementById('equityVal');
		const dtV = document.getElementById('debtVal');
		const gdV = document.getElementById('goldVal');

		if (!eq || !dt || !gd) return;

		function adjust(changed: string) {
			let e = parseInt(eq.value) || 0;
			let d = parseInt(dt.value) || 0;
			let g = parseInt(gd.value) || 0;

			if (changed === 'eq') {
				const rem = 100 - e;
				const sumOthers = d + g;
				if (sumOthers > 0) { d = Math.round((d / sumOthers) * rem); g = rem - d; }
				else { d = Math.round(rem / 2); g = rem - d; }
			} else if (changed === 'dt') {
				const rem = 100 - d;
				const sumOthers = e + g;
				if (sumOthers > 0) { e = Math.round((e / sumOthers) * rem); g = rem - e; }
				else { e = Math.round(rem / 2); g = rem - e; }
			} else if (changed === 'gd') {
				const rem = 100 - g;
				const sumOthers = e + d;
				if (sumOthers > 0) { e = Math.round((e / sumOthers) * rem); d = rem - e; }
				else { e = Math.round(rem / 2); d = rem - e; }
			}

			eq.value = e.toString();
			dt.value = d.toString();
			gd.value = g.toString();

			if (eqV) eqV.innerText = `${e}%`;
			if (dtV) dtV.innerText = `${d}%`;
			if (gdV) gdV.innerText = `${g}%`;

			handleCalculationTrigger();
		}

		eq.addEventListener('input', () => adjust('eq'));
		dt.addEventListener('input', () => adjust('dt'));
		gd.addEventListener('input', () => adjust('gd'));
	}

	function exportToCSV() {
		if (!lastSimulationResult) return;
		const { horizonYears, p90Real, p50Real, p10Real } = lastSimulationResult;
		let csv = 'Year,10th Bear Real (PV),50th Expected Real (PV),90th Bull Real (PV)\n';
		for (let yr = 0; yr <= horizonYears; yr++) {
			csv += `${yr},${p10Real[yr] || 0},${p50Real[yr] || 0},${p90Real[yr] || 0}\n`;
		}
		const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const link = document.createElement('a');
		link.setAttribute('href', url);
		link.setAttribute('download', 'quant_tvm_ledger.csv');
		document.body.appendChild(link);
		link.click();
		document.body.removeChild(link);
	}

	async function runSimulation() {
		const btnText = document.querySelector('#runSipBtn span') as HTMLElement;
		const originalText = btnText ? btnText.innerText : '';
		if (btnText) btnText.innerText = 'SIMULATING...';

		const seedCapital = getNumValue('seedCapital', 0);
		const monthlySip = getNumValue('monthlySip', 25000);
		const stepUpRate = getNumValue('stepUpRate', 0) / 100;
		const horizonYears = getNumValue('investmentYears', 20);
		const inflationRate = getNumValue('inflationRate', 6.0) / 100;
		
		const eqPct = getNumValue('equitySlider', 70) / 100;
		const debtPct = getNumValue('debtSlider', 20) / 100;
		const goldPct = getNumValue('goldSlider', 10) / 100;

		const bsToggle = document.getElementById('bsHedgingToggle') as HTMLInputElement;
		const bsEnabled = bsToggle ? bsToggle.checked : false;
		const annualHedgingDragCost = 0.0185 * eqPct;

		const simResult = await runWorkerTask('SIMULATE', {
			seedCapital, monthlySip, stepUpRate, horizonYears, inflationRate,
			eqPct, debtPct, goldPct, bsEnabled, annualHedgingDragCost
		});

		if (btnText) btnText.innerText = originalText;
		if (!simResult) return;

		const { p90Nominal, p50Nominal, p10Nominal, p90Real, p50Real, p10Real, realOutflowPV, expectedNominalMedian, nominalTotalInvested } = simResult;

		const sacrificePVEl = document.getElementById('valSacrificePV');
		const totalInvestedEl = document.getElementById('statTotalInvested');
		const realWealthEl = document.getElementById('statRealWealth');
		const bearWealthEl = document.getElementById('statBearWealth');
		const bullWealthEl = document.getElementById('statBullWealth');
		const worstTagEl = document.getElementById('worstMultiplierTag');
		const expectedTagEl = document.getElementById('expectedMultiplierTag');
		const bestTagEl = document.getElementById('bestMultiplierTag');

		const expectedRealFinal = calculateNetRealWealth(p50Nominal[horizonYears], nominalTotalInvested, inflationRate, horizonYears);
		const bearRealFinal = calculateNetRealWealth(p10Nominal[horizonYears], nominalTotalInvested, inflationRate, horizonYears);
		const bullRealFinal = calculateNetRealWealth(p90Nominal[horizonYears], nominalTotalInvested, inflationRate, horizonYears);

		const pctSacrificed = expectedRealFinal > 0 ? Math.min(100, (realOutflowPV / expectedRealFinal) * 100) : 100;
		const pctCreated = Math.max(0, 100 - pctSacrificed);
		const elPctSacrifice = document.getElementById('pctSacrifice');
		const elPctCreated = document.getElementById('pctCreated');
		const elBarSacrifice = document.getElementById('barSacrifice');
		const elBarCreated = document.getElementById('barCreated');
		
		if (elPctSacrifice) elPctSacrifice.innerText = `${pctSacrificed.toFixed(1)}%`;
		if (elPctCreated) elPctCreated.innerText = `${pctCreated.toFixed(1)}%`;
		if (elBarSacrifice) elBarSacrifice.style.width = `${pctSacrificed}%`;
		if (elBarCreated) elBarCreated.style.width = `${pctCreated}%`;

		const nominalEquivalentEl = document.getElementById('statNominalEquivalent');
		if (nominalEquivalentEl) nominalEquivalentEl.innerText = `Nominal Equivalent: ${tableFormatter.format(expectedNominalMedian)}`;

		lastSimulationResult = { horizonYears, monthlySip, inflationRate, p90Real, p50Real, p10Real };

		if (sacrificePVEl) sacrificePVEl.innerText = tableFormatter.format(realOutflowPV);
		if (totalInvestedEl) totalInvestedEl.innerText = tableFormatter.format(realOutflowPV);
		if (realWealthEl) realWealthEl.innerText = tableFormatter.format(expectedRealFinal);
		if (bearWealthEl) bearWealthEl.innerText = tableFormatter.format(bearRealFinal);
		if (bullWealthEl) bullWealthEl.innerText = tableFormatter.format(bullRealFinal);

		if (realOutflowPV > 0) {
			const worstMult = (bearRealFinal / realOutflowPV).toFixed(2);
			const expectedMult = (expectedRealFinal / realOutflowPV).toFixed(2);
			const bestMult = (bullRealFinal / realOutflowPV).toFixed(2);

			if (worstTagEl) worstTagEl.innerText = `${worstMult}x Worst (10th)`;
			if (expectedTagEl) expectedTagEl.innerText = `${expectedMult}x Expected (50th)`;
			if (bestTagEl) bestTagEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span><span>${bestMult}x Best (90th)</span>`;
		}

		// Black-Scholes Panel Updates
		const statusBadgeEl = document.getElementById('bsStatusBadge');
		const dragEl = document.getElementById('valHedgingDrag');
		const floorEl = document.getElementById('valProtectedFloor');
		const yieldEl = document.getElementById('valAdjustedYield');

		if (statusBadgeEl) {
			if (bsEnabled) {
				statusBadgeEl.innerText = "ACTIVE PUT HEDGING ON";
				statusBadgeEl.className = "px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800";
			} else {
				statusBadgeEl.innerText = "UNHEDGED PORTFOLIO";
				statusBadgeEl.className = "badge-warning text-xs";
			}
		}

		if (dragEl) dragEl.innerText = bsEnabled ? `${(annualHedgingDragCost * 100).toFixed(2)}% / Year` : "0.00% / Year";
		if (floorEl) floorEl.innerText = tableFormatter.format(bsEnabled ? Math.max(realOutflowPV, bearRealFinal * 1.15) : bearRealFinal);

		// Calculate exact XIRR using CashFlows
		const cfs: {amount: number, date: Date}[] = [];
		const d = new Date();
		let curSip = monthlySip;
		if (seedCapital > 0) cfs.push({ amount: -seedCapital, date: new Date(d) });
		
		for(let yr = 1; yr <= horizonYears; yr++) {
			if (yr > 1) curSip *= (1 + stepUpRate);
			for(let m = 1; m <= 12; m++) {
				d.setMonth(d.getMonth() + 1);
				cfs.push({ amount: -curSip, date: new Date(d) });
			}
		}
		cfs.push({ amount: expectedRealFinal, date: new Date(d) });
		
		const netRealXIRR = calculateXIRR(cfs, 0.1) || 0;
		if (yieldEl) yieldEl.innerText = `${netRealXIRR.toFixed(2)}% Real XIRR`;

		renderHedgingLedger(horizonYears, monthlySip, inflationRate, p50Real, bsEnabled, annualHedgingDragCost);

		const targets = [5000000, 10000000, 25000000, 50000000, 100000000];
		const timelineContainer = document.getElementById('milestoneTimeline');
		if (timelineContainer) {
			let timelineHTML = `<span class="text-navy-500 dark:text-navy-500 uppercase tracking-widest font-bold text-[10px] mr-1">Milestones (PV):</span>`;
			let milestonesHit = 0;
			targets.forEach(target => {
				const hitYear = p50Real.findIndex(val => val >= target);
				if (hitYear > 0) {
					milestonesHit++;
					timelineHTML += `<span class="px-2 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 rounded text-[10px] font-bold tracking-tight">Yr ${hitYear}: ${formatShortRupee(target)}</span>`;
				}
			});
			if (milestonesHit === 0) timelineHTML += `<span class="text-navy-400 dark:text-navy-600 text-[10px] italic">No major milestones reached in horizon.</span>`;
			timelineContainer.innerHTML = timelineHTML;
		}

		renderChart(horizonYears, p90Real, p50Real, p10Real);
	}

	function renderHedgingLedger(years: number, monthlySip: number, inflationRate: number, p50Real: number[], bsEnabled: boolean, dragCostPercent: number) {
		const tbody = document.getElementById('hedgingLedgerBody');
		if (!tbody) return;
		let html = '';
		let cumPV = 0;
		for (let yr = 1; yr <= years; yr++) {
			let yrPV = 0;
			for (let m = (yr - 1) * 12 + 1; m <= yr * 12; m++) {
				yrPV += monthlySip / Math.pow(1 + inflationRate, m / 12);
			}
			cumPV += yrPV;
			const unhedgedReal = p50Real[yr] || 0;
			const optionDragRupees = bsEnabled ? (unhedgedReal * dragCostPercent) : 0;
			const floorBenefit = bsEnabled ? Math.max(0, cumPV - unhedgedReal * 0.92) : 0;
			const netHedgedReal = bsEnabled ? Math.max(unhedgedReal - optionDragRupees, cumPV) : unhedgedReal;
			const zebraClass = yr % 2 === 0 ? 'bg-navy-50/70 dark:bg-navy-900/90' : 'bg-white dark:bg-navy-950';

			html += `
				<tr class="${zebraClass} hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors border-b border-navy-200/60 dark:border-white/10">
					<td class="py-2.5 px-3 text-left font-bold text-navy-800 dark:text-navy-200">Yr ${yr}</td>
					<td class="py-2.5 px-3 text-right text-navy-600 dark:text-navy-400">${tableFormatter.format(cumPV)}</td>
					<td class="py-2.5 px-3 text-right font-medium text-navy-800 dark:text-navy-200">${tableFormatter.format(unhedgedReal)}</td>
					<td class="py-2.5 px-3 text-right ${bsEnabled ? 'text-rose-600 dark:text-rose-400 font-semibold' : 'text-navy-400 dark:text-navy-600'}">
						${bsEnabled ? `-${tableFormatter.format(optionDragRupees)} (${(dragCostPercent * 100).toFixed(2)}%)` : '₹ 0 (0.00%)'}
					</td>
					<td class="py-2.5 px-3 text-right ${floorBenefit > 0 ? 'text-emerald-600 dark:text-emerald-400 font-bold' : 'text-navy-400 dark:text-navy-500'}">
						${floorBenefit > 0 ? `+${tableFormatter.format(floorBenefit)}` : 'Floor Intact'}
					</td>
					<td class="py-2.5 px-3 text-right font-bold text-emerald-600 dark:text-emerald-400">${tableFormatter.format(netHedgedReal)}</td>
				</tr>
			`;
		}
		tbody.innerHTML = html;
	}

	async function renderChart(horizonYears: number, p90: number[], p50: number[], p10: number[]) {
		const canvas = document.getElementById('sipChart') as HTMLCanvasElement;
		if (!canvas) return;

		const { Chart } = await import('chart.js/auto');

		if (sipChartInstance) { sipChartInstance.destroy(); sipChartInstance = null; }
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const labels = Array.from({ length: horizonYears + 1 }, (_, i) => `Yr ${i}`);
		const isDark = document.documentElement.classList.contains('dark');
		const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : '#e2e8f0';
		const tickTextColor = isDark ? '#a1a1aa' : '#64748b';
		const expectedLineColor = isDark ? '#f4f4f5' : '#0f172a';

		sipChartInstance = new Chart(ctx, {
			type: 'line',
			data: {
				labels,
				datasets: [
					{
						label: '90th Bull Real TVM',
						data: p90,
						borderColor: isDark ? '#34d399' : '#059669',
						backgroundColor: isDark ? 'rgba(52, 211, 153, 0.04)' : 'rgba(5, 150, 105, 0.04)',
						borderWidth: 2, pointRadius: 0, tension: 0.35, fill: false
					},
					{
						label: '50th Expected Real TVM',
						data: p50,
						borderColor: expectedLineColor,
						backgroundColor: isDark ? 'rgba(244, 244, 245, 0.04)' : 'rgba(15, 23, 42, 0.04)',
						borderWidth: 2.5, pointRadius: 0, tension: 0.35, fill: false
					},
					{
						label: '10th Bear Real TVM',
						data: p10,
						borderColor: isDark ? '#f87171' : '#dc2626',
						backgroundColor: isDark ? 'rgba(248, 113, 113, 0.04)' : 'rgba(220, 38, 38, 0.04)',
						borderWidth: 2, pointRadius: 0, tension: 0.35, fill: false
					}
				]
			},
			options: {
				responsive: true, maintainAspectRatio: false, animation: { duration: 200 },
				interaction: { mode: 'index', intersect: false },
				plugins: {
					legend: { display: false },
					tooltip: {
						backgroundColor: isDark ? '#000000' : '#0f172a',
						borderColor: isDark ? 'rgba(255, 255, 255, 0.15)' : '#334155',
						borderWidth: 1, titleColor: '#f8fafc', bodyColor: '#e2e8f0', padding: 12,
						callbacks: {
							label: function (context: any) {
								const val = context.raw;
								let formatted = val;
								if (typeof val === 'number') {
									if (val >= 10000000) formatted = `₹ ${(val / 10000000).toFixed(2)} Cr`;
									else if (val >= 100000) formatted = `₹ ${(val / 100000).toFixed(2)} Lakh`;
									else formatted = `₹ ${Math.round(val).toLocaleString('en-IN')}`;
								}
								return ` ${context.dataset.label}: ${formatted}`;
							}
						}
					}
				},
				scales: {
					x: { grid: { color: gridColor }, ticks: { color: tickTextColor, font: { family: 'Inter', size: 11 } } },
					y: {
						grid: { color: gridColor },
						ticks: {
							color: tickTextColor, font: { family: 'Inter', size: 11 },
							callback: function (val: any) {
								if (val >= 10000000) return `₹${(val / 10000000).toFixed(1)}Cr`;
								if (val >= 100000) return `₹${(val / 100000).toFixed(0)}L`;
								return `₹${val.toLocaleString('en-IN')}`;
							}
						}
					}
				}
			}
		});
	}

