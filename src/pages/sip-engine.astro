---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardPremium from '../components/CardPremium.astro';
import InputGroup from '../components/InputGroup.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ButtonGold from '../components/ButtonGold.astro';
---

<Layout 
	title="SIP Wealth Builder — Real Value & Market Scenarios"
	description="Advanced Time Value of Money (TVM) Purchasing Power Simulator with 10,000 market paths, Real Capital Sacrifice vs Real Wealth Created analysis, and year-by-year Black-Scholes put option hedging ledger."
>
	<Hero 
		badge="WEALTH ACCUMULATION ENGINE"
		title="SIP Wealth Builder"
		description="Visualize your future wealth in today's purchasing power, stress-tested across 10,000 market scenarios to give you a realistic picture of your financial future."
	/>

	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-16 sm:pt-6 sm:pb-24 space-y-8">

		<!-- SECTION 1: COMPACT 2-COLUMN DASHBOARD (5/12 vs 7/12 Proportions) -->
		<section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">

			<!-- Left Column: Input Parameters & Asset Matrix (5/12 Width) -->
			<CardPremium class="lg:col-span-5">
				
				<div class="flex items-center justify-between border-b border-navy-200 dark:border-navy-800 pb-3 mb-4">
					<h2 class="text-xs font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100 flex items-center gap-2">
						<svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
						</svg>
						SACRIFICE MATRIX
					</h2>
					<span class="text-[10px] text-navy-400 dark:text-navy-500">INPUT CONTROLS</span>
				</div>

				<form id="sipForm" onsubmit="event.preventDefault();" class="space-y-6">
					
					<!-- ENGINE MODE SWITCHER -->
					<div class="p-1 bg-navy-100 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg flex items-center justify-between gap-1 text-[10px] uppercase font-bold">
						<button id="modeForwardBtn" type="button" class="btn-primary flex-1 py-1.5 text-center cursor-pointer rounded">
							FORWARD: STOCHASTIC
						</button>
						<button id="modeReverseBtn" type="button" class="btn-ghost flex-1 py-1.5 text-center cursor-pointer rounded">
							REVERSE: GOAL-SEEK
						</button>
					</div>

					<div class="space-y-4">
						<InputGroup 
							id="seedCapital"
							label="Initial Seed Capital"
							tooltip="Initial lump sum capital deployed at t = 0."
							prefix="₹"
							suffix="Lump Sum"
							value="0"
							formattedId="seedFormatted"
							formattedClass="text-xs text-navy-500"
						/>

						<div id="monthlySipContainer">
							<InputGroup 
								id="monthlySip"
								label="Monthly SIP Contribution"
								tooltip="Monthly capital deployed into your portfolio."
								prefix="₹"
								suffix="/ Month"
								value="25,000"
								formattedId="sipFormatted"
								formattedClass="text-xs text-navy-500"
							/>
						</div>

						<div id="targetRealWealthContainer" class="hidden">
							<InputGroup 
								id="targetRealWealth"
								label="Target Real Wealth"
								tooltip="Target real purchasing power in today's rupees."
								prefix="₹"
								suffix="Target PV"
								value="5,00,00,000"
							/>
						</div>

						<!-- Required Starting SIP Hairline Result Card -->
						<div id="requiredSipResultCard" class="hidden bg-emerald-500/10 border border-emerald-500/30 rounded-md p-3 space-y-1">
							<div class="flex justify-between items-center text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">
								<span>REQUIRED STARTING SIP</span>
								<span>GOAL-SEEK RESULT</span>
							</div>
							<div id="valRequiredSip" class="stat-value text-xl text-emerald-600 dark:text-emerald-400">
								₹ 0 / Month
							</div>
						</div>
					</div>

					<hr class="section-divider" />

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<InputGroup 
							id="stepUpRate"
							label="Annual Step-Up"
							tooltip="Annual escalation percentage on monthly SIP."
							suffix="% / YR"
							type="number"
							value="0"
						/>
						<InputGroup 
							id="investmentYears"
							label="Horizon"
							tooltip="Total accumulation horizon."
							suffix="YRS"
							type="number"
							value="20"
						/>
						<InputGroup 
							id="inflationRate"
							label="Inflation Rate"
							tooltip="Discount rate for Real TVM purchasing power."
							suffix="%"
							type="number"
							value="6.0"
						/>
					</div>

					<!-- PURCHASING POWER SACRIFICE HIGHLIGHT CELL -->
					<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-3.5 space-y-1">
						<div class="flex justify-between items-center">
							<span class="text-[11px] uppercase tracking-wider font-semibold text-navy-500 dark:text-navy-400">Purchasing Power Sacrificed (PV)</span>
							<span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase">TODAY'S VALUE</span>
						</div>
						<div id="valSacrificePV" class="stat-value text-xl text-navy-900 dark:text-navy-100">₹ 0</div>
					</div>

					<hr class="section-divider" />

					<!-- ASSET ALLOCATION MATRIX -->
					<div class="space-y-4">
						<div class="flex items-center justify-between">
							<SectionTitle title="PROPORTIONAL ASSET MATRIX" />
							<span id="allocationTotalBadge" class="text-xs font-bold text-emerald-600 dark:text-emerald-400">Total: 100%</span>
						</div>

						<div class="grid grid-cols-4 gap-1.5 mb-4">
							<button type="button" data-preset="conservative" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-[9px] uppercase font-bold text-navy-600 dark:text-navy-400 rounded transition-colors p-1">CONSERVATIVE</button>
							<button type="button" data-preset="balanced" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-[9px] uppercase font-bold text-navy-600 dark:text-navy-400 rounded transition-colors p-1">BALANCED</button>
							<button type="button" data-preset="aggressive" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-[9px] uppercase font-bold text-navy-600 dark:text-navy-400 rounded transition-colors p-1">AGGRESSIVE</button>
							<button type="button" data-preset="fire" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-[9px] uppercase font-bold text-navy-600 dark:text-navy-400 rounded transition-colors p-1">FIRE 15-YR</button>
						</div>

						<!-- Equity Slider -->
						<div class="space-y-1.5">
							<div class="flex justify-between items-center text-xs">
								<span class="text-navy-700 dark:text-navy-300 font-medium">Equity (12% CAGR, 15% Vol)</span>
								<span id="equityVal" class="font-bold text-navy-900 dark:text-navy-100">70%</span>
							</div>
							<input type="range" id="equitySlider" min="0" max="100" value="70" class="w-full accent-navy-900 dark:accent-white cursor-pointer h-1.5 rounded-md bg-navy-200 dark:bg-navy-800" />
						</div>

						<!-- Debt Slider -->
						<div class="space-y-1.5">
							<div class="flex justify-between items-center text-xs">
								<span class="text-navy-700 dark:text-navy-300 font-medium">Debt (7.1% Risk-Free)</span>
								<span id="debtVal" class="font-bold text-navy-900 dark:text-navy-100">20%</span>
							</div>
							<input type="range" id="debtSlider" min="0" max="100" value="20" class="w-full accent-navy-900 dark:accent-white cursor-pointer h-1.5 rounded-md bg-navy-200 dark:bg-navy-800" />
						</div>

						<!-- Gold Slider -->
						<div class="space-y-1.5">
							<div class="flex justify-between items-center text-xs">
								<span class="text-navy-700 dark:text-navy-300 font-medium">Gold (8.5% Inflation Hedge)</span>
								<span id="goldVal" class="font-bold text-navy-900 dark:text-navy-100">10%</span>
							</div>
							<input type="range" id="goldSlider" min="0" max="100" value="10" class="w-full accent-navy-900 dark:accent-white cursor-pointer h-1.5 rounded-md bg-navy-200 dark:bg-navy-800" />
						</div>
					</div>

					<div class="pt-2">
						<ButtonGold id="runSipBtn">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path></svg>
							<span>SIMULATE REAL TVM PATHS</span>
						</ButtonGold>
					</div>
				</form>
			</CardPremium>

			<!-- Right Column: Real TVM Dashboard (7/12 Width) -->
			<div class="col-span-1 lg:col-span-7 flex flex-col space-y-6">
				
				<CardPremium class="p-0 overflow-hidden">
					<!-- Top Data Ribbon -->
					<div class="border-b border-navy-200 dark:border-navy-800 p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center bg-navy-50 dark:bg-navy-900 gap-3">
						<div class="flex items-center gap-2 flex-wrap">
							<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
							<h2 class="text-xs font-bold tracking-widest text-navy-800 dark:text-navy-200 uppercase">REAL PURCHASING POWER PROJECTION</h2>
							<button id="taxToggleBtn" type="button" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider transition-all duration-200 bg-navy-200 text-navy-800 dark:bg-navy-800 dark:text-navy-200 border border-navy-300 dark:border-navy-700 cursor-pointer">PRE-TAX</button>
						</div>
						
						<!-- Multiplier Badges -->
						<div class="flex flex-wrap items-center gap-2">
							<span id="worstMultiplierTag" class="badge-danger">--x Worst (10th)</span>
							<span id="expectedMultiplierTag" class="badge-warning">--x Expected (50th)</span>
							<span id="bestMultiplierTag" class="badge-safe flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span><span>--x Best (90th)</span></span>
						</div>
					</div>

					<!-- Real Purchasing Power HUD Ribbon -->
					<div class="p-4 sm:p-5 border-b border-navy-200 dark:border-navy-800 bg-navy-50 dark:bg-navy-950 space-y-4">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pb-4 border-b border-navy-200/80 dark:border-navy-800 items-center">
							<div class="space-y-0.5">
								<span class="stat-label">Real Capital Sacrificed (PV Outflow)</span>
								<div id="statTotalInvested" class="stat-value text-xl sm:text-2xl text-navy-900 dark:text-navy-100">₹ 0</div>
							</div>
							<div class="space-y-0.5 sm:text-right">
								<span class="stat-label">50th Expected Real Wealth (PV)</span>
								<div id="statRealWealth" class="stat-value text-2xl sm:text-3xl text-gold-500">₹ 0</div>
								<div id="statNominalEquivalent" class="text-[10px] text-navy-600 tracking-tight mt-1">Nominal Equivalent: ₹ 0</div>
								
								<!-- Leverage Split Bar -->
								<div class="mt-4 space-y-1.5 w-full">
									<div class="flex justify-between text-[10px] uppercase tracking-widest font-bold">
										<span class="text-navy-500 dark:text-navy-500">Sacrificed (<span id="pctSacrifice">0%</span>)</span>
										<span class="text-emerald-600 dark:text-emerald-400">Created (<span id="pctCreated">0%</span>)</span>
									</div>
									<div class="w-full h-1.5 flex rounded-full overflow-hidden bg-navy-200 dark:bg-navy-800">
										<div id="barSacrifice" class="h-full bg-navy-400 dark:bg-navy-500 transition-all duration-500" style="width: 100%"></div>
										<div id="barCreated" class="h-full bg-emerald-500 transition-all duration-500" style="width: 0%"></div>
									</div>
								</div>
							</div>
						</div>

						<div class="grid grid-cols-2 gap-4 pt-0.5">
							<div class="space-y-0.5">
								<span class="stat-label">10th Bear (Worst Case)</span>
								<div id="statBearWealth" class="stat-value text-lg sm:text-xl text-rose-600 dark:text-rose-400">₹ 0</div>
							</div>
							<div class="space-y-0.5 text-right">
								<span class="stat-label">90th Bull (Best Case)</span>
								<div id="statBullWealth" class="stat-value text-lg sm:text-xl text-emerald-600 dark:text-emerald-400">₹ 0</div>
							</div>
						</div>
					</div>

					<!-- Chart Canvas Container -->
					<div class="relative w-full h-[300px] sm:h-[330px] bg-white dark:bg-navy-950 p-4 flex items-center justify-center">
						<canvas id="sipChart" class="w-full h-full"></canvas>
					</div>

					<div class="p-3.5 border-t border-navy-200 dark:border-navy-800 bg-navy-50 dark:bg-navy-900 flex flex-wrap items-center justify-between text-xs text-navy-600 dark:text-navy-400 gap-3">
						<div class="flex flex-wrap items-center gap-4">
							<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-600 dark:bg-emerald-400"></span><span class="font-bold tracking-tight text-navy-900 dark:text-navy-100">90th Bull</span></span>
							<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-navy-900 dark:bg-navy-100"></span><span class="font-bold tracking-tight text-navy-900 dark:text-navy-100">50th Expected</span></span>
							<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-600 dark:bg-rose-400"></span><span class="font-bold tracking-tight text-navy-900 dark:text-navy-100">10th Bear</span></span>
						</div>
						<div class="flex gap-2">
							<button id="downloadPdfBtn" class="btn-ghost px-3 py-1 text-[10px] uppercase tracking-widest cursor-pointer border border-navy-200 dark:border-navy-800 rounded hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors">↓ Download PDF Report</button>
							<button id="exportCsvBtn" class="btn-ghost px-3 py-1 text-[10px] uppercase tracking-widest cursor-pointer border border-navy-200 dark:border-navy-800 rounded hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors">↓ Export CSV</button>
						</div>
					</div>
					
					<div id="milestoneTimeline" class="p-3.5 border-t border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 flex flex-wrap gap-2.5 items-center text-xs min-h-[48px]">
					   <!-- Populated by JS -->
					</div>
				</CardPremium>
			</div>
		</section>

		<!-- SECTION 2: BLACK-SCHOLES HEDGING & YEAR-BY-YEAR LEDGER -->
		<CardPremium>
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-navy-200 dark:border-navy-800 pb-4 mb-4">
				<div class="flex items-center gap-3">
					<label class="relative inline-flex items-center cursor-pointer shrink-0">
						<input type="checkbox" id="bsHedgingToggle" class="sr-only peer" />
						<div class="w-11 h-6 bg-navy-300 dark:bg-navy-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-navy-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:peer-checked:bg-emerald-500"></div>
					</label>
					<div>
						<h3 class="text-sm sm:text-base font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">
							Black-Scholes Put Option Downside Hedging
						</h3>
						<p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5 leading-relaxed">
							Continuously purchase rolling European put options to cap equity drawdowns during severe bear markets.
						</p>
					</div>
				</div>
				<span id="bsStatusBadge" class="badge-warning text-xs">UNHEDGED PORTFOLIO</span>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
				<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 space-y-1">
					<span class="text-xs font-bold text-navy-500 dark:text-navy-400 uppercase tracking-widest">Option Premium Drag</span>
					<div id="valHedgingDrag" class="stat-value text-xl text-navy-900 dark:text-navy-100">0.00% / Year</div>
				</div>
				<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 space-y-1">
					<span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">Protected Floor (PV)</span>
					<div id="valProtectedFloor" class="stat-value text-xl text-emerald-600 dark:text-emerald-400">₹ 0</div>
				</div>
				<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 space-y-1">
					<span class="text-xs font-bold text-navy-500 dark:text-navy-400 uppercase tracking-widest">Hedged Real Yield</span>
					<div id="valAdjustedYield" class="stat-value text-xl text-navy-900 dark:text-navy-100">0.00% Real XIRR</div>
				</div>
			</div>

			<SectionTitle title="YEAR-BY-YEAR OPTION COST & PROTECTION LEDGER" />
			<div class="w-full mt-2 max-h-[360px] overflow-x-auto overflow-y-auto border border-navy-200 dark:border-navy-800 rounded-md bg-white dark:bg-navy-950 scrollbar-thin scrollbar-thumb-navy-300 dark:scrollbar-thumb-navy-700">
				<table class="table-premium w-full min-w-[600px]">
					<thead class="sticky top-0 z-20 bg-navy-100 dark:bg-navy-900 border-b border-navy-200 dark:border-navy-800 shadow-xs">
						<tr>
							<th class="py-2.5 px-3 text-left font-bold text-navy-700 dark:text-navy-300">Year</th>
							<th class="py-2.5 px-3 text-right font-bold text-navy-700 dark:text-navy-300">Real Sacrificed (PV)</th>
							<th class="py-2.5 px-3 text-right font-bold text-navy-700 dark:text-navy-300">Unhedged Real Wealth</th>
							<th class="py-2.5 px-3 text-right font-bold text-navy-700 dark:text-navy-300">Option Drag</th>
							<th class="py-2.5 px-3 text-right font-bold text-navy-700 dark:text-navy-300">Floor Benefit</th>
							<th class="py-2.5 px-3 text-right font-bold text-emerald-600 dark:text-emerald-400">Net Hedged Real</th>
						</tr>
					</thead>
					<tbody id="hedgingLedgerBody" class="divide-y divide-navy-100 dark:divide-white/5 bg-white dark:bg-navy-950">
						<!-- Dynamically populated via JS -->
					</tbody>
				</table>
			</div>
		</CardPremium>
	</main>
</Layout>

<script>
	import { 
		parseFormattedNumber, 
		formatShortRupee, 
		tableFormatter, 
		setupFormattingField,
		formatIndianRupeeLabel 
	} from '../utils/formatters';

	import { calculateXIRR } from '../utils/xirr';
	import html2pdf from 'html2pdf.js';

	// Quantitative Stochastic Engine Controller
	let sipChartInstance: any = null;
	let lastSimulationResult: any = null;
	let isPostTax = false;
	let isReverseGoalSeek = false;

	let sipWorker: Worker | null = null;
	if (typeof window !== 'undefined' && window.Worker) {
		sipWorker = new Worker(new URL('../workers/sipWorker.ts', import.meta.url), { type: 'module' });
	}

	function runWorkerTask(type: string, params: any): Promise<any> {
		return new Promise((resolve) => {
			if (!sipWorker) return resolve(null);
			const handler = (e: MessageEvent) => {
				if (e.data.type === type + '_RESULT') {
					sipWorker?.removeEventListener('message', handler);
					resolve(e.data.result);
				}
			};
			sipWorker.addEventListener('message', handler);
			sipWorker.postMessage({ type, params });
		});
	}

	function debounce(fn: Function, ms = 300) { let t: any; return (...a: any) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }

	function getNumValue(id: string, defaultVal: number): number {
		const el = document.getElementById(id) as HTMLInputElement;
		if (!el) return defaultVal;
		const parsed = parseFormattedNumber(el.value);
		return isNaN(parsed) ? defaultVal : parsed;
	}

	function handleCalculationTrigger() {
		syncStateToUrl();
		if (isReverseGoalSeek) {
			runGoalSeek();
		} else {
			runSimulation();
		}
	}

	function parseUrlParams() {
		const params = new URLSearchParams(window.location.search);
		const fields = ['seedCapital', 'monthlySip', 'targetRealWealth', 'stepUpRate', 'investmentYears', 'inflationRate', 'equitySlider', 'debtSlider', 'goldSlider'];
		
		fields.forEach(id => {
			if (params.has(id)) {
				const el = document.getElementById(id) as HTMLInputElement;
				if (el) {
					if (el.type === 'range' || el.type === 'number') {
						el.value = params.get(id)!;
					} else {
						el.value = Number(params.get(id)).toLocaleString('en-IN');
					}
				}
			}
		});
		
		if (params.has('bsHedgingToggle')) {
			const el = document.getElementById('bsHedgingToggle') as HTMLInputElement;
			if (el) el.checked = params.get('bsHedgingToggle') === 'true';
		}

		if (params.has('isPostTax')) {
			isPostTax = params.get('isPostTax') === 'true';
		}
		
		if (params.has('isReverseGoalSeek') && params.get('isReverseGoalSeek') === 'true') {
			isReverseGoalSeek = true;
		}
	}

	function syncStateToUrl() {
		const params = new URLSearchParams(window.location.search);
		const fields = ['seedCapital', 'monthlySip', 'targetRealWealth', 'stepUpRate', 'investmentYears', 'inflationRate', 'equitySlider', 'debtSlider', 'goldSlider'];
		
		fields.forEach(id => {
			const el = document.getElementById(id) as HTMLInputElement;
			if (el) {
				const val = (el.type === 'range' || el.type === 'number') ? el.value : parseFormattedNumber(el.value);
				params.set(id, val.toString());
			}
		});
		
		const bsToggle = document.getElementById('bsHedgingToggle') as HTMLInputElement;
		if (bsToggle) params.set('bsHedgingToggle', bsToggle.checked.toString());
		
		params.set('isReverseGoalSeek', isReverseGoalSeek.toString());
		params.set('isPostTax', isPostTax.toString());
		
		window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
	}

	function initModeSwitcher() {
		const fwdBtn = document.getElementById('modeForwardBtn');
		const revBtn = document.getElementById('modeReverseBtn');
		const sipContainer = document.getElementById('monthlySipContainer');
		const targetContainer = document.getElementById('targetRealWealthContainer');
		const reqCard = document.getElementById('requiredSipResultCard');
		const runBtn = document.getElementById('runSipBtn');
		const btnText = runBtn ? runBtn.querySelector('span') : null;

		if (!fwdBtn || !revBtn) return;

		fwdBtn.addEventListener('click', () => {
			isReverseGoalSeek = false;
			fwdBtn.className = 'btn-primary flex-1 py-1.5 text-center cursor-pointer rounded';
			revBtn.className = 'btn-ghost flex-1 py-1.5 text-center cursor-pointer rounded text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-white transition-colors';
			
			sipContainer?.classList.remove('hidden');
			targetContainer?.classList.add('hidden');
			reqCard?.classList.add('hidden');

			if (btnText) btnText.innerText = 'SIMULATE REAL TVM PATHS';
			runSimulation();
		});

		revBtn.addEventListener('click', () => {
			isReverseGoalSeek = true;
			revBtn.className = 'btn-primary flex-1 py-1.5 text-center cursor-pointer rounded';
			fwdBtn.className = 'btn-ghost flex-1 py-1.5 text-center cursor-pointer rounded text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-white transition-colors';

			sipContainer?.classList.add('hidden');
			targetContainer?.classList.remove('hidden');
			reqCard?.classList.remove('hidden');

			if (btnText) btnText.innerText = 'CALCULATE REQUIRED SIP';
			runGoalSeek();
		});
	}

	async function runGoalSeek() {
		const btnText = document.querySelector('#runSipBtn span') as HTMLElement;
		const originalText = btnText ? btnText.innerText : '';
		if (btnText) btnText.innerText = 'CALCULATING...';

		const targetRealWealth = getNumValue('targetRealWealth', 50000000);
		const seedCapital = getNumValue('seedCapital', 0);
		const stepUpRate = getNumValue('stepUpRate', 0) / 100;
		const horizonYears = getNumValue('investmentYears', 20);
		const inflationRate = getNumValue('inflationRate', 6.0) / 100;

		const eqPct = getNumValue('equitySlider', 70) / 100;
		const debtPct = getNumValue('debtSlider', 20) / 100;
		const goldPct = getNumValue('goldSlider', 10) / 100;

		const bsToggle = document.getElementById('bsHedgingToggle') as HTMLInputElement;
		const bsEnabled = bsToggle ? bsToggle.checked : false;
		const annualHedgingDragCost = bsEnabled ? (0.0185 * eqPct) : 0;

		const reqSip = await runWorkerTask('GOAL_SEEK', {
			targetRealWealth, seedCapital, stepUpRate, horizonYears, inflationRate,
			eqPct, debtPct, goldPct, bsEnabled, annualHedgingDragCost, isPostTax
		});

		const reqCardVal = document.getElementById('valRequiredSip');
		if (reqCardVal) reqCardVal.innerText = `${tableFormatter.format(reqSip)} / Month`;

		const sipInput = document.getElementById('monthlySip') as HTMLInputElement;
		if (sipInput) sipInput.value = reqSip.toLocaleString('en-IN');

		if (btnText) btnText.innerText = originalText;
		runSimulation();
	}

	function calculateNetRealWealth(nominalVal: number, totalNominalInvested: number, inflationRate: number, horizonYears: number): number {
		if (!isPostTax) {
			return nominalVal / Math.pow(1 + inflationRate, horizonYears);
		}
		const taxableGain = Math.max(0, nominalVal - totalNominalInvested - 125000);
		const ltcgTax = taxableGain * 0.125;
		const postTaxNominal = nominalVal - ltcgTax;
		return Math.max(0, Math.round(postTaxNominal / Math.pow(1 + inflationRate, horizonYears)));
	}

