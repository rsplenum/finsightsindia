  }

  function checkSanity(inputs: any, sim: any) {
    const warningEl = document.getElementById('inputSanityWarning');
    const messageEl = document.getElementById('inputSanityMessage');
    if (!warningEl || !messageEl) return;

    const messages: string[] = [];

    if (inputs.horizonYears < 3 && inputs.eqPct >= 0.5) {
      messages.push(`Your horizon is only ${inputs.horizonYears} year${inputs.horizonYears === 1 ? '' : 's'} with ${(inputs.eqPct * 100).toFixed(0)}% in equity. Over short horizons under 3 years, market volatility dominates returns.`);
    }

    if (inputs.expectedInflation < 3.0) {
      messages.push(`CPI inflation is set to ${inputs.expectedInflation}%. Indian consumer inflation historically averages 5%–7%. Setting inflation unusually low overestimates future purchasing power.`);
    }

    if (messages.length > 0) {
      messageEl.textContent = messages[0];
      warningEl.classList.remove('hidden');
    } else {
      warningEl.classList.add('hidden');
    }
  }

  function initTabNavigation() {
