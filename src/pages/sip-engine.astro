			if (el && val) val.innerText = `${el.value}%`;
		});

		initSliders();
		initPresets();
		initTaxToggle();
		initModeSwitcher();
		
		if (isReverseGoalSeek) {
			const revBtn = document.getElementById('modeReverseBtn');
			if (revBtn) revBtn.click();
		} else {
			runSimulation();
		}

		const debouncedHandleCalculationTrigger = debounce(handleCalculationTrigger, 300);

		const runBtn = document.getElementById('runSipBtn');
		if (runBtn) runBtn.addEventListener('click', debouncedHandleCalculationTrigger);

		const toggle = document.getElementById('bsHedgingToggle');
		if (toggle) toggle.addEventListener('change', debouncedHandleCalculationTrigger);

		const exportCsvBtn = document.getElementById('exportCsvBtn');
		if (exportCsvBtn) exportCsvBtn.addEventListener('click', exportToCSV);

		['seedCapital', 'monthlySip', 'targetRealWealth', 'stepUpRate', 'investmentYears', 'inflationRate'].forEach(id => {
			document.getElementById(id)?.addEventListener('input', debouncedHandleCalculationTrigger);
		});

		window.addEventListener('theme-changed', () => debouncedHandleCalculationTrigger());

		document.getElementById('downloadPdfBtn')?.addEventListener('click', () => {
			const element = document.querySelector('main');
			if (!element) return;
			
			const opt = {
				margin:       10,
				filename:     'sip_engine_report.pdf',
				image:        { type: 'jpeg', quality: 0.98 },
				html2canvas:  { scale: 2, useCORS: true },
				jsPDF:        { unit: 'mm', format: 'a3', orientation: 'portrait' }
			};
			
			const btn = document.getElementById('downloadPdfBtn');
			if(btn) btn.innerText = "Generating PDF...";
			
			html2pdf().set(opt).from(element).save().then(() => {
				if(btn) btn.innerText = "↓ Download PDF Report";
			});
		});
	});
</script>
