  let currentShockAmount = 1500000;
  let currentShockYear = 10;

  function calculateEmergencyFortress() {
    const expenseInput = document.getElementById('emergencyExpenseInput') as HTMLInputElement | null;
    const dependentsSelect = document.getElementById('emergencyDependentsSelect') as HTMLSelectElement | null;
    const medicalInput = document.getElementById('emergencyMedicalInput') as HTMLInputElement | null;
    const milestoneInput = document.getElementById('emergencyMilestoneInput') as HTMLInputElement | null;

    const monthlyExpense = Math.max(0, parseFloat(expenseInput?.value || '50000') || 50000);
    const dependents = parseInt(dependentsSelect?.value || '2', 10);
    const medicalShield = Math.max(0, parseFloat(medicalInput?.value || '500000') || 0);
    const milestoneFund = Math.max(0, parseFloat(milestoneInput?.value || '500000') || 0);

    const runwayMonths = 6 + dependents * 2;
    const livingExpenseTotal = monthlyExpense * runwayMonths;
    const totalFortress = livingExpenseTotal + medicalShield + milestoneFund;

    // Update UI Cards
    const elRunwayTotal = document.getElementById('statRunwayTotal');
    if (elRunwayTotal) elRunwayTotal.textContent = formatMoney(livingExpenseTotal);

    const elRunwayMonths = document.getElementById('statRunwayMonths');
    if (elRunwayMonths) elRunwayMonths.textContent = `${runwayMonths} Months Coverage`;

    const elMedicalShield = document.getElementById('statMedicalShield');
    if (elMedicalShield) elMedicalShield.textContent = formatMoney(medicalShield);

    const elMilestoneFund = document.getElementById('statMilestoneFund');
    if (elMilestoneFund) elMilestoneFund.textContent = formatMoney(milestoneFund);

    const elTotalFortress = document.getElementById('statTotalFortress');
    if (elTotalFortress) elTotalFortress.textContent = formatMoney(totalFortress);

    // Calculate Withdrawal Shock Compounding Impact
    const totalHorizon = lastInputs?.horizonYears || 20;
    const remainingYears = Math.max(1, totalHorizon - currentShockYear);
    const nominalRate = ((lastInputs?.expectedReturn || 12.0) / 100);

    // Future value of the withdrawn amount over remaining horizon
    const futureValueOfWithdrawal = currentShockAmount * Math.pow(1 + nominalRate, remainingYears);
    const lostCompoundingGrowth = futureValueOfWithdrawal - currentShockAmount;
    const totalTerminalDeficit = futureValueOfWithdrawal;

    const elShockWithdrawal = document.getElementById('shockUnprotectedWithdrawal');
    if (elShockWithdrawal) elShockWithdrawal.textContent = formatMoney(currentShockAmount);

    const elShockLostGrowth = document.getElementById('shockUnprotectedLostGrowth');
    if (elShockLostGrowth) elShockLostGrowth.textContent = formatMoney(lostCompoundingGrowth);

    const elShockTotalDeficit = document.getElementById('shockUnprotectedTotalDeficit');
    if (elShockTotalDeficit) elShockTotalDeficit.textContent = `-${formatMoney(totalTerminalDeficit)}`;

    const elShockSaved = document.getElementById('shockProtectedWealthSaved');
    if (elShockSaved) elShockSaved.textContent = `+${formatMoney(totalTerminalDeficit)}`;
  }

  function initEmergencyBufferControls() {
    const expenseInput = document.getElementById('emergencyExpenseInput');
    const dependentsSelect = document.getElementById('emergencyDependentsSelect');
