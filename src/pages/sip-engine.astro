---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardPremium from '../components/CardPremium.astro';
import InputGroup from '../components/InputGroup.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ButtonGold from '../components/ButtonGold.astro';
import { REGIME_PRESETS, DEFAULT_REGIME } from '../utils/regimePresets';
import {
	FUND_COST_PLANS, DEFAULT_FUND_COST, SEBI_EQUITY_TER_CAP, EXIT_LOAD_NOT_MODELLED,
} from '../utils/fundCosts';
import SipAnswer from '../components/Calculators/SipAnswer.astro';
import RungSipRates from '../components/Calculators/RungSipRates.astro';
import RungSipFlow from '../components/Calculators/RungSipFlow.astro';
import RungSipGrowth from '../components/Calculators/RungSipGrowth.astro';
import RungSipSequence from '../components/Calculators/RungSipSequence.astro';
import RungSipProtection from '../components/Calculators/RungSipProtection.astro';
import RungSipExpert from '../components/Calculators/RungSipExpert.astro';
---

<Layout
	title="SIP Planner — will I get there?"
	description="Tell us what you can put away, for how long, and what you are aiming at. We stress-test it across 10,000 market paths built from the Nifty 50's own record, and tell you what to change if the answer is not good enough."
>
	<Hero
		badge="Savings Planner"
		title="Will I get there?"
		description="Tell us three things and we will tell you whether your savings reach your goal — and what to change if they do not."
	/>

	<!-- Layer 1: the Answer (sol-019) -->
	<SipAnswer />

	<!-- The ladder (dd-002): one question per rung, in the order a reader has
	     them. The two-rates rung comes first: it is the model everything else is
	     a push on (dd-005), and it teaches the money distinction the later rungs
	     depend on (dd-004). -->
	<RungSipRates />
	<RungSipFlow />
	<RungSipGrowth />
	<RungSipSequence />
	<RungSipProtection />

	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-16 sm:pt-6 sm:pb-24">

		<RungSipExpert>

		<div slot="controls">
			<CardPremium glass={true}>
				<div class="pb-4 border-b border-navy-200 dark:border-navy-800">
					<h3 class="text-lg font-bold tracking-tight text-navy-900 dark:text-navy-100">Your Plan Details</h3>
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">What you invest, what you are aiming at, and what you assume the market does.</p>
				</div>

				<form onsubmit="event.preventDefault();" class="space-y-6">

					<!-- Section 1: What you are putting in, and what for -->
					<div class="space-y-4">
						<SectionTitle title="What you put in, and what you want" />

						<InputGroup
							id="monthlySip"
							label="Monthly Investment"
							required={true}
							tooltip="What you put away every month, before any step-up."
							prefix="₹"
							suffix="/month"
							value="25,000"
							formattedId="sipFormatted"
							formattedClass="text-xs text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 px-2 py-0.5 rounded-md font-medium"
							formattedDefault="₹ 25,000 / month"
						/>

						<InputGroup
							id="targetRealWealth"
							label="What You Are Aiming At"
							required={true}
							tooltip="In TODAY'S money — what the amount buys now, not what the number will read at the end. A goal stated in future rupees is not a goal."
							prefix="₹"
							suffix="today's ₹"
							value="1,00,00,000"
							formattedId="targetFormatted"
							formattedClass="text-xs text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 px-2 py-0.5 rounded-md font-medium"
							formattedDefault="₹ 1,00,00,000 (1 Cr)"
						/>

						<InputGroup
							id="seedCapital"
							label="Lump Sum You Already Have"
							tooltip="Anything already invested today. Leave it at zero if you are starting from nothing."
							prefix="₹"
							suffix="one-off"
							value="0"
							formattedId="seedFormatted"
							formattedClass="text-xs text-navy-500"
						/>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
							<InputGroup
								id="investmentYears"
								label="How Long You Invest For"
								tooltip="The number of years you keep putting money in before you stop."
								suffix="years"
								type="number"
								value="20"
								min="1" max="60" step="1" required={true}
							/>

							<InputGroup
								id="sipRealStepUp"
								label="Yearly Raise, On Top"
								tooltip="Career progression. Your instalment already rises with prices to hold its value — this is any REAL increase beyond that. Zero is a complete plan, not an absent one."
								suffix="% real / yr"
								type="number"
								value="0"
								min="0" max="15" step="0.5"
							/>
						</div>

						<!-- dd-017. The contribution is read as TODAY'S money, and this is
						     where that reading can be changed. It is not asked at the entry:
						     stating an interpretation is allowed, adding a fourth question to
						     a three-question contract is not. -->
						<div class="space-y-2">
							<span class="text-[11px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">
								What your monthly figure means
							</span>
							<select id="sipContributionMode"
									class="w-full rounded border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-2 py-1.5 text-xs text-navy-800 dark:text-navy-200">
								<option value="real" selected>₹25,000 of today's spending power — raised each year with prices</option>
								<option value="salary">A fixed share of my monthly income</option>
								<option value="fixed">A flat ₹25,000 a month, never raised</option>
							</select>
							<p id="sipModeNote" class="text-[10px] leading-relaxed text-navy-500 dark:text-navy-400"></p>

							<div id="sipSalaryFields" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
								<InputGroup
									id="sipMonthlyIncome"
									label="Monthly Income"
									tooltip="What you take home each month, today. Your instalment is a share of it, and a share of a salary keeps pace with prices by itself."
									prefix="₹"
									suffix="/month"
									value="1,25,000"
								/>
								<InputGroup
									id="sipSavingsRate"
									label="Share You Save"
									tooltip="How much of each month's income goes into this plan."
									suffix="% of income"
									type="number"
									value="20"
									min="1" max="80" step="1"
								/>
							</div>
						</div>
					</div>

					<hr class="section-divider" />

					<!-- Section 2: The market you assume -->
					<div class="space-y-4">
						<SectionTitle title="What you assume the market does" />

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
							<InputGroup
								id="inflationRate"
								label="Expected Inflation %"
								tooltip="How fast prices rise. This is what turns the final number into what it will actually buy."
								suffix="% / yr"
								type="number"
								value="6.0"
								min="0" max="20" step="0.5" required={true}
							/>

							<InputGroup
								id="sipLtcgTax"
								label="Tax on Gains %"
								tooltip="Long-term capital gains, charged only on profit and only when you sell. The first ₹1.25 lakh of gain is exempt."
								suffix="% tax"
								type="number"
								value="12.5"
								min="0" max="50" step="0.1" required={true}
							/>

							<InputGroup
								id="sipExpectedReturn"
								label="Expected Growth on Shares %"
								tooltip="Long-term average annual return on the equity part, including dividends. Pick a period below rather than a number, so the growth and the roughness come from the same world."
								suffix="% a year"
								type="number"
								value={DEFAULT_REGIME.growth.toFixed(1)}
								min="0" max="30" step="0.5" required={true}
							/>

							<InputGroup
								id="sipVolatility"
								label="Market Roughness %"
								tooltip="The spread of the Nifty 50's ANNUAL returns. Not the day-to-day figure people quote: over the last 10 years this was 8.9%, but over the last 30 it was 28.4%."
								suffix="% swings"
								type="number"
								value={DEFAULT_REGIME.roughness.toFixed(1)}
								min="5" max="50" step="0.5" required={true}
							/>

							<!-- sol-028, second instance. Until now these two numbers were not
							     inputs at all on this page: `eqDrift` and `eqVolMult` were
							     module constants inside sipWorker at 12% and 15%, so a preset
							     here would have moved a label and nothing else. The engine takes
							     them now, and refuses to run without them. Each preset sets BOTH,
							     because a regime is a pair. -->
							<div class="sm:col-span-2 space-y-2">
								<div class="flex items-baseline justify-between gap-3">
									<span class="text-[11px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">
										Or take both from a real period
									</span>
									<span class="text-[10px] text-navy-500 dark:text-navy-400">Nifty 50, to {REGIME_PRESETS[0].span.split('–')[1]}</span>
								</div>
								<div role="radiogroup" aria-label="Take growth and roughness from a real period"
									 class="grid grid-cols-3 gap-1.5">
									{REGIME_PRESETS.map((p) => (
										<button type="button" role="radio" data-regime={p.id}
												data-growth={String(p.growth)} data-roughness={String(p.roughness)}
												class="sip-regime-btn border border-navy-200 dark:border-navy-800 rounded p-1.5 text-left transition-colors hover:bg-navy-100 dark:hover:bg-navy-800">
											<span class="block text-[9px] font-bold uppercase text-navy-700 dark:text-navy-300">{p.label.replace('The last ', '')}</span>
											<span class="block text-[10px] tabular-nums text-navy-600 dark:text-navy-400">{p.growth}% · {p.roughness}% swings</span>
										</button>
									))}
								</div>
								<p id="sipRegimeNote" class="text-[10px] leading-relaxed text-navy-500 dark:text-navy-400"></p>
							</div>

							<!-- The fund's own fee. Until 16 Aug both engines assumed a fund
							     that costs nothing to own - a zero arrived at by omission on
							     the one cost that is certain. Named plans rather than a free
							     number, for sol-028's reason: the reader picks something they
							     could actually hold, and the percentage follows. -->
							<div class="sm:col-span-2 space-y-2">
								<div class="flex items-baseline justify-between gap-3">
									<span class="text-[11px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">
										What the fund charges you
									</span>
									<span class="text-[10px] text-navy-500 dark:text-navy-400">SEBI caps equity funds at {SEBI_EQUITY_TER_CAP}%</span>
								</div>
								<select id="sipFundPlan"
										class="w-full rounded border border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 px-2 py-1.5 text-xs text-navy-800 dark:text-navy-200">
									{FUND_COST_PLANS.map((p) => (
										<option value={p.id} selected={p.id === DEFAULT_FUND_COST.id}>
											{p.label} — {p.expenseRatio.toFixed(2)}% a year
										</option>
									))}
								</select>
								<p id="sipFundNote" class="text-[10px] leading-relaxed text-navy-500 dark:text-navy-400"></p>
							</div>
						</div>
					</div>

					<hr class="section-divider" />

					<!-- Section 3: How the money is split -->
					<div class="space-y-4">
						<div class="flex items-center justify-between">
							<SectionTitle title="How the money is split" />
							<span id="allocationTotalBadge" class="text-xs font-bold text-emerald-700 dark:text-emerald-400">Total: 100%</span>
						</div>

						<div class="grid grid-cols-4 gap-1.5">
							<button type="button" data-preset="conservative" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-[9px] uppercase font-bold text-navy-600 dark:text-navy-400 rounded transition-colors p-1">CAUTIOUS</button>
							<button type="button" data-preset="balanced" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-[9px] uppercase font-bold text-navy-600 dark:text-navy-400 rounded transition-colors p-1">BALANCED</button>
							<button type="button" data-preset="aggressive" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-[9px] uppercase font-bold text-navy-600 dark:text-navy-400 rounded transition-colors p-1">BOLD</button>
							<button type="button" data-preset="fire" class="preset-btn border border-navy-200 dark:border-navy-800 hover:bg-navy-100 dark:hover:bg-navy-800 text-[9px] uppercase font-bold text-navy-600 dark:text-navy-400 rounded transition-colors p-1">RETIRE IN 15</button>
						</div>

						<div class="space-y-1.5">
							<div class="flex justify-between items-center text-xs">
								<span class="text-navy-700 dark:text-navy-300 font-medium">
									Shares — <span id="sipEquityLabel">the period you chose above</span>
								</span>
								<span id="equityVal" class="font-bold text-navy-900 dark:text-navy-100">70%</span>
							</div>
							<input type="range" id="equitySlider" min="0" max="100" value="70" class="w-full accent-navy-900 dark:accent-white cursor-pointer h-1.5 rounded-md bg-navy-200 dark:bg-navy-800" />
						</div>

						<div class="space-y-1.5">
							<div class="flex justify-between items-center text-xs">
								<span class="text-navy-700 dark:text-navy-300 font-medium">Bonds and deposits — 7.1% a year, barely moves</span>
								<span id="debtVal" class="font-bold text-navy-900 dark:text-navy-100">20%</span>
							</div>
							<input type="range" id="debtSlider" min="0" max="100" value="20" class="w-full accent-navy-900 dark:accent-white cursor-pointer h-1.5 rounded-md bg-navy-200 dark:bg-navy-800" />
						</div>

						<div class="space-y-1.5">
							<div class="flex justify-between items-center text-xs">
								<span class="text-navy-700 dark:text-navy-300 font-medium">Gold — 8.5% a year, moves when shares fall</span>
								<span id="goldVal" class="font-bold text-navy-900 dark:text-navy-100">10%</span>
							</div>
							<input type="range" id="goldSlider" min="0" max="100" value="10" class="w-full accent-navy-900 dark:accent-white cursor-pointer h-1.5 rounded-md bg-navy-200 dark:bg-navy-800" />
						</div>

						<p class="text-[10px] leading-relaxed text-navy-500 dark:text-navy-400">
							The share figures come from the period you picked above. The bond and
							gold figures do not — they are long-run averages we typed in, and the
							gate records that as an open debt rather than dressing them up as
							measurements.
						</p>
					</div>

					<hr class="section-divider" />

					<!-- Section 4: Protection -->
					<div class="space-y-4">
						<SectionTitle title="Whether you buy a floor" />
						<div class="flex items-center justify-between gap-3">
							<span class="text-xs font-semibold text-navy-800 dark:text-navy-200">
								Buy Portfolio Insurance
							</span>
							<label class="relative inline-flex items-center cursor-pointer shrink-0">
								<input type="checkbox" id="bsHedgingToggle" name="bsHedgingToggle" class="sr-only peer" />
								<div class="w-11 h-6 bg-navy-200 dark:bg-navy-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-navy-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:peer-checked:bg-emerald-500"></div>
							</label>
						</div>
						<p class="text-xs text-navy-500 dark:text-navy-400 leading-relaxed">
							You buy rolling put options on the share part of your savings. You pay a
							premium every year whether or not it is needed; in exchange, in any year
							the market falls past your floor, the contract pays the difference. The
							premium is paid in every year of the plan and the floor pays out in very
							few of them — the ledger below shows both.
						</p>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
							<InputGroup
								id="sipHedgingDrag"
								label="Premium"
								tooltip="Priced, not chosen: Black-Scholes on the floor depth and the roughness above, at implied volatility. A floor you could set a price for independently would be a contract nobody would write."
								suffix="% / yr"
								type="number"
								value="1.85"
								min="0" max="10" step="0.05"
								readonly={true}
							/>

							<InputGroup
								id="sipHedgingFloor"
								label="Protected Floor"
								tooltip="How far the market may fall in a year before the contract pays. Matches the planner's own floor, so the two calculators price the same contract."
								suffix="% drop"
								type="number"
								value="-10"
								max="0" min="-50" step="1" required={true}
							/>
						</div>
					</div>

					<div class="pt-2">
						<ButtonGold id="runSipBtn">
							<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
							<span class="text-sm font-semibold">Stress-Test This Plan (10,000 Futures)</span>
						</ButtonGold>
					</div>
				</form>
			</CardPremium>
		</div>

		<div slot="results">
			<section class="space-y-6">
				<CardPremium glass={true} class="p-0 overflow-hidden">
					<div class="border-b border-navy-200 dark:border-navy-800 p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center bg-navy-50 dark:bg-navy-900 gap-3">
						<div class="flex items-center gap-2 flex-wrap">
							<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
							<h2 class="text-xs font-bold tracking-widest text-navy-800 dark:text-navy-200 uppercase">What your savings are worth, in today's money</h2>
							<!-- The post-tax state lives on the button now, where the one
							     input reader can find it. It used to be a module-scoped
							     variable no other surface could see. -->
							<button id="taxToggleBtn" type="button" aria-pressed="false" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider transition-all duration-200 bg-navy-200 text-navy-800 dark:bg-navy-800 dark:text-navy-200 border border-navy-300 dark:border-navy-700 cursor-pointer">BEFORE TAX</button>
						</div>

						<div class="flex flex-wrap items-center gap-2">
							<span id="worstMultiplierTag" class="badge-danger">--x Unlucky (10th)</span>
							<span id="expectedMultiplierTag" class="badge-warning">--x Typical (50th)</span>
							<span id="bestMultiplierTag" class="badge-safe">--x Lucky (90th)</span>
						</div>
					</div>

					<div class="p-4 sm:p-5 border-b border-navy-200 dark:border-navy-800 bg-navy-50 dark:bg-navy-950 space-y-4">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pb-4 border-b border-navy-200/80 dark:border-navy-800 items-center">
							<div class="space-y-0.5">
								<span class="stat-label">What you put in, in today's money</span>
								<div id="statTotalInvested" class="stat-value text-xl sm:text-2xl text-navy-900 dark:text-navy-100">₹ 0</div>
							</div>
							<div class="space-y-0.5 sm:text-right">
								<span class="stat-label">What you typically end up with</span>
								<div id="statRealWealth" class="stat-value text-2xl sm:text-3xl text-gold-700 dark:text-gold-500">₹ 0</div>
								<div id="statNominalEquivalent" class="text-[10px] text-navy-600 dark:text-navy-400 tracking-tight mt-1">The number on screen that year: ₹ 0</div>

								<div class="mt-4 space-y-1.5 w-full">
									<div class="flex justify-between text-[10px] uppercase tracking-widest font-bold">
										<span class="text-navy-500 dark:text-navy-400">Yours (<span id="pctSacrifice">0%</span>)</span>
										<span class="text-emerald-700 dark:text-emerald-400">The market's (<span id="pctCreated">0%</span>)</span>
									</div>
									<div class="w-full h-1.5 flex rounded-full overflow-hidden bg-navy-200 dark:bg-navy-800">
										<div id="barSacrifice" class="h-full bg-navy-400 dark:bg-navy-500 transition-all duration-500" style="width: 100%"></div>
										<div id="barCreated" class="h-full bg-emerald-500 transition-all duration-500" style="width: 0%"></div>
									</div>
								</div>
							</div>
						</div>

						<div class="grid grid-cols-2 gap-4 pt-0.5">
							<div class="space-y-0.5">
								<span class="stat-label">If you are unlucky (10th)</span>
								<div id="statBearWealth" class="stat-value text-lg sm:text-xl text-rose-700 dark:text-rose-400">₹ 0</div>
							</div>
							<div class="space-y-0.5 text-right">
								<span class="stat-label">If you are lucky (90th)</span>
								<div id="statBullWealth" class="stat-value text-lg sm:text-xl text-emerald-700 dark:text-emerald-400">₹ 0</div>
							</div>
						</div>
					</div>

					<div class="relative w-full h-[300px] sm:h-[330px] bg-white dark:bg-navy-950 p-4 flex items-center justify-center">
						<canvas id="sipChart" class="w-full h-full"></canvas>
					</div>

					<div class="p-3.5 border-t border-navy-200 dark:border-navy-800 bg-navy-50 dark:bg-navy-900 flex flex-wrap items-center justify-between text-xs text-navy-600 dark:text-navy-400 gap-3">
						<div class="flex flex-wrap items-center gap-4">
							<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-600 dark:bg-emerald-400"></span><span class="font-bold tracking-tight text-navy-900 dark:text-navy-100">Lucky</span></span>
							<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-navy-900 dark:bg-navy-100"></span><span class="font-bold tracking-tight text-navy-900 dark:text-navy-100">Typical</span></span>
							<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-600 dark:bg-rose-400"></span><span class="font-bold tracking-tight text-navy-900 dark:text-navy-100">Unlucky</span></span>
							<span class="flex items-center gap-1.5"><span class="w-4 border-t-2 border-dashed border-gold-500"></span><span class="font-bold tracking-tight text-navy-900 dark:text-navy-100">Your goal</span></span>
						</div>
						<div class="flex gap-2">
							<button id="downloadPdfBtn" class="btn-ghost px-3 py-1 text-[10px] uppercase tracking-widest cursor-pointer border border-navy-200 dark:border-navy-800 rounded hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors">↓ Download PDF Report</button>
							<button id="exportCsvBtn" class="btn-ghost px-3 py-1 text-[10px] uppercase tracking-widest cursor-pointer border border-navy-200 dark:border-navy-800 rounded hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors">↓ Export CSV</button>
						</div>
					</div>

					<div id="milestoneTimeline" class="p-3.5 border-t border-navy-200 dark:border-navy-800 bg-white dark:bg-navy-950 flex flex-wrap gap-2.5 items-center text-xs min-h-[48px]">
					   <!-- Populated by JS -->
					</div>
				</CardPremium>
			</section>
		</div>

		<div slot="workings">
			<CardPremium glass={true} class="w-full">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-navy-200 dark:border-navy-800 pb-4 mb-4">
					<div class="flex flex-col gap-1">
						<h3 class="text-sm sm:text-base font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">
							What the protection cost, and what it absorbed
						</h3>
						<p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5 leading-relaxed">
							Rolling put options on the share sleeve, re-struck every twelve months.
						</p>
					</div>
					<span id="bsStatusBadge" class="badge-warning text-xs">NO PROTECTION BOUGHT</span>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
					<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 space-y-1">
						<span class="text-xs font-bold text-navy-500 dark:text-navy-400 uppercase tracking-widest">Premium, a year</span>
						<div id="valHedgingDrag" class="stat-value text-xl text-navy-900 dark:text-navy-100">0.00% / Year</div>
					</div>
					<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 space-y-1">
						<span class="text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-widest">What the floor paid out</span>
						<div id="valProtectedFloor" class="stat-value text-xl text-emerald-700 dark:text-emerald-400">₹ 0</div>
					</div>
					<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 space-y-1">
						<span class="text-xs font-bold text-navy-500 dark:text-navy-400 uppercase tracking-widest">Your return, after inflation</span>
						<div id="valAdjustedYield" class="stat-value text-xl text-navy-900 dark:text-navy-100">0.00% a year</div>
					</div>
				</div>

				<SectionTitle title="YEAR-BY-YEAR COST AND PROTECTION LEDGER" />
				<p id="ledgerCaption" class="mt-2 text-xs text-navy-500 dark:text-navy-400">
					Every figure below is in today's money and comes from the simulation itself —
					the same market paths run twice, once with the floor and once without.
				</p>
				<!-- sol-023: these columns used to be invented at render time beside the
				     engine. They are now read from its output, so a change to the hedging
				     model moves them. Widths are fixed by colgroup and every numeric cell
				     is nowrap: six currency columns were wrapping mid-figure, which made
				     "₹ 1,03,85,340" read as two numbers. -->
				<div class="w-full mt-2 max-h-[360px] overflow-x-auto overflow-y-auto border border-navy-200 dark:border-navy-800 rounded-md bg-white dark:bg-navy-950 scrollbar-thin scrollbar-thumb-navy-300 dark:scrollbar-thumb-navy-700">
					<table class="table-premium w-full min-w-[760px] tabular-nums">
						<colgroup>
							<col class="w-[9%]" />
							<col class="w-[18%]" />
							<col class="w-[19%]" />
							<col class="w-[19%]" />
							<col class="w-[17%]" />
							<col class="w-[18%]" />
						</colgroup>
						<thead class="sticky top-0 z-20 bg-navy-100 dark:bg-navy-900 border-b border-navy-200 dark:border-navy-800 shadow-xs">
							<tr>
								<th class="py-2.5 px-3 text-left font-bold text-navy-700 dark:text-navy-300 whitespace-nowrap">Year</th>
								<th class="py-2.5 px-3 text-right font-bold text-navy-700 dark:text-navy-300 whitespace-nowrap">Put In So Far</th>
								<th class="py-2.5 px-3 text-right font-bold text-navy-700 dark:text-navy-300 whitespace-nowrap">Unprotected</th>
								<th class="py-2.5 px-3 text-right font-bold text-emerald-700 dark:text-emerald-400 whitespace-nowrap">Protected</th>
								<th class="py-2.5 px-3 text-right font-bold text-navy-700 dark:text-navy-300 whitespace-nowrap">Premium Paid</th>
								<th class="py-2.5 px-3 text-right font-bold text-navy-700 dark:text-navy-300 whitespace-nowrap">Floor Paid Out</th>
							</tr>
						</thead>
						<tbody id="hedgingLedgerBody" class="divide-y divide-navy-100 dark:divide-white/5 bg-white dark:bg-navy-950">
							<!-- Populated from the engine's `hedging` output. -->
						</tbody>
					</table>
				</div>
			</CardPremium>
		</div>

		</RungSipExpert>
	</main>
</Layout>

<script>
	import {
		parseFormattedNumber,
		formatShortRupee,
		tableFormatter,
		setupFormattingField,
	} from '../utils/formatters';

	import { calculateXIRR } from '../utils/xirr';
	// sol-046: the escalation is not re-derived here any more. `instalmentInYear`
	// is the same function the engine is parameterised from, so the instalment
	// this page discounts and the instalment the simulation invests cannot drift.
	import { instalmentInYear } from '../utils/sipAdvice';
	// sol-050: imported inside the click handler instead - see the note on the
	// same handler in swp-planner.astro. ~916 KB that only a downloader needs.
	import { debounce } from '../utils/debounce';

	// sol-026 / dd-013: this page no longer computes anything. It reads the one
	// input set and renders the one simulation, which the compute host in
	// SipAnswer broadcasts. It used to own a worker of its own, a second input
	// reader made of `getNumValue` calls, a module-scoped `isPostTax` no other
	// surface could see, and two separate literal `0.0185` premiums.
	import { FUND_COST_PLANS, EXIT_LOAD_NOT_MODELLED, ACTIVE_FUND_CAVEAT } from '../utils/fundCosts';
	import {
		readSipInputs,
		syncEntryFromAdvanced,
		requestRecompute,
	} from '../utils/sipInputs';

	let sipChartInstance: any = null;
	let lastSimulation: any = null;
	let lastInputs: any = null;
	// Subscribes exactly once. A boolean rather than the old `if (!worker)`
	// guard, which would have attached a fresh listener on every run once the
	// worker went away.
	let subscribed = false;

	// One reader for the whole page (sol-026).
	const getInputs = readSipInputs;

	function subscribe() {
		if (subscribed) return;
		subscribed = true;
		window.addEventListener('sip:result', (e) => {
			const d = (e as CustomEvent).detail;
			if (!d?.simulation) return;
			lastSimulation = d.simulation;
			lastInputs = d.inputs;
			renderPanel(d.inputs, d.simulation, d.outlook);
		});
	}

	function trigger() {
		subscribe();
		syncEntryFromAdvanced();
		syncStateToUrl();
		requestRecompute();
	}

	const debouncedTrigger = debounce(trigger, 300);

	// ---- URL state ---------------------------------------------------------

	const URL_FIELDS = [
		'seedCapital', 'monthlySip', 'targetRealWealth', 'stepUpRate',
		'investmentYears', 'inflationRate', 'sipExpectedReturn', 'sipVolatility',
		'sipLtcgTax', 'sipHedgingFloor', 'equitySlider', 'debtSlider', 'goldSlider',
		'sipRealStepUp', 'sipSavingsRate',
	];

	function parseUrlParams() {
		const params = new URLSearchParams(window.location.search);
		URL_FIELDS.forEach(id => {
			if (!params.has(id)) return;
			const el = document.getElementById(id) as HTMLInputElement;
			if (!el) return;
			if (el.type === 'range' || el.type === 'number') {
				el.value = params.get(id)!;
			} else {
				el.value = Number(params.get(id)).toLocaleString('en-IN');
			}
		});

		if (params.has('bsHedgingToggle')) {
			const el = document.getElementById('bsHedgingToggle') as HTMLInputElement;
			if (el) el.checked = params.get('bsHedgingToggle') === 'true';
		}
		if (params.has('isPostTax')) {
			setPostTax(params.get('isPostTax') === 'true');
		}
	}

	function syncStateToUrl() {
		const params = new URLSearchParams(window.location.search);
		URL_FIELDS.forEach(id => {
			const el = document.getElementById(id) as HTMLInputElement;
			if (!el) return;
			const val = (el.type === 'range' || el.type === 'number')
				? el.value : parseFormattedNumber(el.value);
			params.set(id, val.toString());
		});
		const bsToggle = document.getElementById('bsHedgingToggle') as HTMLInputElement;
		if (bsToggle) params.set('bsHedgingToggle', bsToggle.checked.toString());
		params.set('isPostTax', String(isPostTax()));
		window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
	}

	// ---- the post-tax view -------------------------------------------------

	const taxBtn = () => document.getElementById('taxToggleBtn');
	const isPostTax = () => taxBtn()?.getAttribute('aria-pressed') === 'true';

	function setPostTax(on: boolean) {
		const btn = taxBtn();
		if (!btn) return;
		btn.setAttribute('aria-pressed', String(on));
		btn.innerText = on ? 'AFTER TAX' : 'BEFORE TAX';
		btn.className = on
			? 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider transition-all duration-200 bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 cursor-pointer'
			: 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider transition-all duration-200 bg-navy-200 text-navy-800 dark:bg-navy-800 dark:text-navy-200 border border-navy-300 dark:border-navy-700 cursor-pointer';
	}

	// ---- rendering ---------------------------------------------------------

	function renderPanel(inputs: any, sim: any, outlook: any) {
		const years = inputs.horizonYears;
		const set = (id: string, text: string) => {
			const el = document.getElementById(id);
			if (el) el.innerText = text;
		};

		// Every figure here is the engine's. sol-023 at the scale of a page: a
		// view must never re-derive what the engine already knows, and the old
		// version of this function recomputed the tax, the real values and the
		// multiples from three percentiles it had been handed.
		const invested = outlook.flow.investedReal;
		const typical = outlook.endReal.p50;

		set('statTotalInvested', tableFormatter.format(invested));
		set('statRealWealth', tableFormatter.format(typical));
		set('statNominalEquivalent', `The number on screen that year: ${tableFormatter.format(outlook.flow.endNominal)}`);
		set('statBearWealth', tableFormatter.format(outlook.endReal.p10));
		set('statBullWealth', tableFormatter.format(outlook.endReal.p90));

		// What is yours and what compounding added, as a share of the total.
		const yours = typical > 0 ? Math.min(100, (invested / typical) * 100) : 100;
		const market = Math.max(0, 100 - yours);
		set('pctSacrifice', `${yours.toFixed(1)}%`);
		set('pctCreated', `${market.toFixed(1)}%`);
		const barA = document.getElementById('barSacrifice');
		const barB = document.getElementById('barCreated');
		if (barA) barA.style.width = `${yours}%`;
		if (barB) barB.style.width = `${market}%`;

		if (invested > 0) {
			set('worstMultiplierTag', `${(outlook.endReal.p10 / invested).toFixed(2)}x Unlucky (10th)`);
			set('expectedMultiplierTag', `${(typical / invested).toFixed(2)}x Typical (50th)`);
			set('bestMultiplierTag', `${(outlook.endReal.p90 / invested).toFixed(2)}x Lucky (90th)`);
		}

		// Protection panel
		const statusBadgeEl = document.getElementById('bsStatusBadge');
		if (statusBadgeEl) {
			if (inputs.bsEnabled) {
				statusBadgeEl.innerText = 'PROTECTION BOUGHT';
				statusBadgeEl.className = 'px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800';
			} else {
				statusBadgeEl.innerText = 'NO PROTECTION BOUGHT';
				statusBadgeEl.className = 'badge-warning text-xs';
			}
		}
		// The quoted premium is a percentage of the share sleeve, which is what
		// the contract is written on. Saying "1.85% a year" beside a portfolio
		// that is 70% shares without saying which base it is on is how sol-029
		// happened.
		set('valHedgingDrag', inputs.bsEnabled
			? `${inputs.hedgingDragCost.toFixed(2)}% of the share sleeve`
			: 'nothing — not bought');
		set('valProtectedFloor', sim.hedging
			? tableFormatter.format(sim.hedging.floorPayoutReal[years] ?? 0)
			: 'not bought');

		// What the plan actually returned the reader, after inflation: the real
		// XIRR of the money in against the money out.
		const cfs: { amount: number, date: Date }[] = [];
		const d = new Date();
		if (inputs.seedCapital > 0) cfs.push({ amount: -inputs.seedCapital, date: new Date(d) });
		for (let yr = 1; yr <= years; yr++) {
			// sol-046: this read `inputs.annualStepUp`, which readSipInputs has never
			// returned - the field is `realStepUp`. Every instalment from year 2 on
			// was therefore NaN, and calculateXIRR absorbed 348 NaN flows out of 361
			// and returned a confident 19.20% "after inflation" instead of ~5.7%.
			// It also started from `monthlySip`, which is not the instalment at all
			// in salary mode. `instalmentInYear` answers both.
			const curSip = instalmentInYear(inputs, yr);
			for (let m = 1; m <= 12; m++) {
				d.setMonth(d.getMonth() + 1);
				// Each instalment discounted from the month it is actually paid,
				// so the rate that comes out is genuinely after inflation.
				const monthsIn = (yr - 1) * 12 + m;
				cfs.push({
					amount: -curSip / Math.pow(1 + inputs.expectedInflation / 100, monthsIn / 12),
					date: new Date(d),
				});
			}
		}
		cfs.push({ amount: typical, date: new Date(d) });
		set('valAdjustedYield', `${(calculateXIRR(cfs, 0.1) || 0).toFixed(2)}% a year, after inflation`);

		renderHedgingLedger(inputs, sim);
		renderMilestones(inputs, sim);
		renderChart(inputs, sim);
	}

	function renderMilestones(inputs: any, sim: any) {
		const curve: number[] = sim.final.p50RealNet ?? sim.p50Real;
		const container = document.getElementById('milestoneTimeline');
		if (!container) return;

		let html = `<span class="text-navy-500 dark:text-navy-400 uppercase tracking-widest font-bold text-[10px] mr-1">In today's money, you pass:</span>`;
		let hits = 0;
		for (const target of [5000000, 10000000, 25000000, 50000000, 100000000]) {
			const hitYear = curve.findIndex((val) => val >= target);
			if (hitYear > 0) {
				hits++;
				html += `<span class="px-2 py-1 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 rounded text-[10px] font-bold tracking-tight">Yr ${hitYear}: ${formatShortRupee(target)}</span>`;
			}
		}
		if (!hits) html += `<span class="text-navy-500 dark:text-navy-400 text-[10px] italic">None of the usual milestones inside this horizon.</span>`;
		container.innerHTML = html;
	}

	/**
	 * The ledger, rendered from the engine's own output.
	 *
	 * sol-023: four of these columns used to be computed here, beside the
	 * simulation rather than from it - a "Floor Benefit" of contributions minus
	 * 92% of the median balance, and a net figure floored at total
	 * contributions. None of them moved when the hedging model was corrected,
	 * and none would have moved if it never had been.
	 *
	 * `hedging` is null whenever protection is off, in which case there is
	 * nothing to account for and the table says so rather than printing zeroes.
	 */
	function renderHedgingLedger(inputs: any, sim: any) {
		const tbody = document.getElementById('hedgingLedgerBody');
		const caption = document.getElementById('ledgerCaption');
		if (!tbody) return;

		const ledger = sim.hedging;
		const years = inputs.horizonYears;

		if (!ledger) {
			tbody.innerHTML =
				'<tr><td colspan="6" class="py-8 px-3 text-center text-sm text-navy-500 dark:text-navy-400">' +
				'Protection is off, so there is no premium to pay and no floor to pay out. ' +
				'Switch it on above to see what it would cost.' +
				'</td></tr>';
			if (caption) {
				caption.textContent =
					"Every figure below is in today's money and comes from the simulation itself.";
			}
			return;
		}

		if (caption) {
			caption.textContent =
				"Every figure below is in today's money and comes from the simulation itself — " +
				"the same market paths run twice, once with the floor and once without. " +
				`The floor paid out in ${ledger.yearsFloorPaid} of the ${years} years for a typical path; ` +
				"the premium was paid in every one of them.";
		}

		const protectedReal: number[] = sim.p50Real;
		let html = '';
		let cumPV = 0;
		for (let yr = 1; yr <= years; yr++) {
			// sol-046: the same wrong field as the yield above, so the "Put In So
			// Far" column was NaN from year 2 in every row of this ledger whenever
			// protection was switched on.
			const sip = instalmentInYear(inputs, yr);
			for (let m = (yr - 1) * 12 + 1; m <= yr * 12; m++) {
				cumPV += sip / Math.pow(1 + inputs.expectedInflation / 100, m / 12);
			}

			const unprotected = ledger.unhedgedReal[yr] ?? 0;
			const withFloor = protectedReal[yr] ?? 0;
			const premium = ledger.premiumPaidReal[yr] ?? 0;
			const payout = ledger.floorPayoutReal[yr] ?? 0;
			// Cumulative, deliberately. A per-year "the floor paid this year"
			// flag looks obvious and is not available: these are medians ACROSS
			// paths, so the median cumulative rises in years when no one path
			// necessarily collected. Deriving a per-year event from it would be
			// the same class of invention sol-023 was opened for. The typical
			// number of paying years is in the caption, counted per path.

			const zebraClass = yr % 2 === 0 ? 'bg-navy-50/70 dark:bg-navy-900/90' : 'bg-white dark:bg-navy-950';
			const num = 'py-2.5 px-3 text-right whitespace-nowrap';

			html += `
				<tr class="${zebraClass} hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors border-b border-navy-200/60 dark:border-white/10">
					<td class="py-2.5 px-3 text-left font-bold whitespace-nowrap text-navy-800 dark:text-navy-200">Yr ${yr}</td>
					<td class="${num} text-navy-600 dark:text-navy-400">${tableFormatter.format(cumPV)}</td>
					<td class="${num} font-medium text-navy-800 dark:text-navy-200">${tableFormatter.format(unprotected)}</td>
					<td class="${num} font-bold ${withFloor >= unprotected ? 'text-emerald-700 dark:text-emerald-400' : 'text-navy-800 dark:text-navy-200'}">${tableFormatter.format(withFloor)}</td>
					<td class="${num} text-rose-700 dark:text-rose-400">−${tableFormatter.format(premium)}</td>
					<td class="${num} ${payout > 0 ? 'text-emerald-700 dark:text-emerald-400' : 'text-navy-500 dark:text-navy-400'}">${payout > 0 ? '+' + tableFormatter.format(payout) : '—'}</td>
				</tr>
			`;
		}
		tbody.innerHTML = html;
	}

	async function renderChart(inputs: any, sim: any) {
		const canvas = document.getElementById('sipChart') as HTMLCanvasElement;
		if (!canvas) return;

		const { Chart } = await import('chart.js/auto');
		if (sipChartInstance) { sipChartInstance.destroy(); sipChartInstance = null; }
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const years = inputs.horizonYears;
		const labels = Array.from({ length: years + 1 }, (_, i) => `Yr ${i}`);
		const isDark = document.documentElement.classList.contains('dark');
		const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : '#e2e8f0';
		const tickTextColor = isDark ? '#a1a1aa' : '#64748b';
		const expectedLineColor = isDark ? '#f4f4f5' : '#0f172a';

		const line = (label: string, data: number[], color: string, width: number) => ({
			label, data, borderColor: color, borderWidth: width,
			pointRadius: 0, tension: 0.35, fill: false,
		});

		sipChartInstance = new Chart(ctx, {
			type: 'line',
			data: {
				labels,
				datasets: [
					line('Lucky (90th)', sim.p90Real, isDark ? '#34d399' : '#059669', 2),
					line('Typical (50th)', sim.p50Real, expectedLineColor, 2.5),
					line('Unlucky (10th)', sim.p10Real, isDark ? '#f87171' : '#dc2626', 2),
					{
						// The goal, drawn on the same axis as the outcome. A target
						// the reader has to hold in their head while reading a chart
						// is the reader doing the tool's work (dd-006).
						label: 'Your goal',
						data: Array.from({ length: years + 1 }, () => inputs.targetRealWealth),
						borderColor: isDark ? '#fbbf24' : '#d97706',
						borderWidth: 1.5, borderDash: [6, 4], pointRadius: 0, fill: false,
					},
				],
			},
			options: {
				responsive: true, maintainAspectRatio: false, animation: { duration: 200 },
				interaction: { mode: 'index', intersect: false },
				plugins: {
					legend: { display: false },
					tooltip: {
						backgroundColor: isDark ? '#000000' : '#0f172a',
						borderColor: isDark ? 'rgba(255, 255, 255, 0.15)' : '#334155',
						borderWidth: 1, titleColor: '#f8fafc', bodyColor: '#e2e8f0', padding: 12,
						callbacks: {
							label: (context: any) => {
								const val = context.raw;
								let formatted = val;
								if (typeof val === 'number') {
									if (val >= 10000000) formatted = `₹ ${(val / 10000000).toFixed(2)} Cr`;
									else if (val >= 100000) formatted = `₹ ${(val / 100000).toFixed(2)} Lakh`;
									else formatted = `₹ ${Math.round(val).toLocaleString('en-IN')}`;
								}
								return ` ${context.dataset.label}: ${formatted}`;
							},
						},
					},
				},
				scales: {
					x: { grid: { color: gridColor }, ticks: { color: tickTextColor, font: { family: 'Inter', size: 11 } } },
					y: {
						grid: { color: gridColor },
						ticks: {
							color: tickTextColor, font: { family: 'Inter', size: 11 },
							callback: (val: any) => {
								if (val >= 10000000) return `₹${(val / 10000000).toFixed(1)}Cr`;
								if (val >= 100000) return `₹${(val / 100000).toFixed(0)}L`;
								return `₹${val.toLocaleString('en-IN')}`;
							},
						},
					},
				},
			},
		});
	}

	function exportToCSV() {
		if (!lastSimulation || !lastInputs) return;
		const years = lastInputs.horizonYears;
		let csv = 'Year,Unlucky (10th) today\'s ₹,Typical (50th) today\'s ₹,Lucky (90th) today\'s ₹\n';
		for (let yr = 0; yr <= years; yr++) {
			csv += `${yr},${lastSimulation.p10Real[yr] || 0},${lastSimulation.p50Real[yr] || 0},${lastSimulation.p90Real[yr] || 0}\n`;
		}
		const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const link = document.createElement('a');
		link.setAttribute('href', url);
		link.setAttribute('download', 'sip_projection.csv');
		document.body.appendChild(link);
		link.click();
		document.body.removeChild(link);
	}

	// ---- controls ----------------------------------------------------------

	function initRegimePresets() {
		const growth = document.getElementById('sipExpectedReturn') as HTMLInputElement;
		const rough = document.getElementById('sipVolatility') as HTMLInputElement;
		const note = document.getElementById('sipRegimeNote');
		const label = document.getElementById('sipEquityLabel');
		const btns = Array.from(document.querySelectorAll('.sip-regime-btn')) as HTMLButtonElement[];

		const paint = () => {
			const g = growth?.value, r = rough?.value;
			let matched: HTMLButtonElement | null = null;
			for (const b of btns) {
				const on = b.dataset.growth === g && b.dataset.roughness === r;
				if (on) matched = b;
				b.setAttribute('aria-checked', String(on));
				b.classList.toggle('border-gold-500', on);
				b.classList.toggle('bg-gold-500/10', on);
			}
			if (label) {
				label.textContent = matched
					? `${g}% a year, ${r}% swings`
					: `${g}% a year, ${r}% swings — your own numbers`;
			}
			if (note) {
				note.textContent = matched
					? `Growth and roughness both taken from ${matched.querySelector('span')?.textContent?.toLowerCase()} of the Nifty 50. A period sets both, because a calm market and a generous one are not independent choices.`
					: `These are your own numbers rather than a period from the record. Every complete 30-year window on the Nifty 50 has swings near 29%.`;
			}
		};

		for (const b of btns) {
			b.addEventListener('click', () => {
				if (growth) growth.value = b.dataset.growth!;
				if (rough) rough.value = b.dataset.roughness!;
				paint();
				trigger();
			});
		}
		growth?.addEventListener('input', paint);
		rough?.addEventListener('input', paint);
		paint();
	}

	// dd-017. Switching the mode swaps which fields are asked for rather than
	// adding to them: 'real' and 'fixed' stay at the same three, 'salary' trades
	// the monthly amount for an income and a share of it.
	function initContributionMode() {
		const sel = document.getElementById('sipContributionMode') as HTMLSelectElement | null;
		const salary = document.getElementById('sipSalaryFields');
		const monthly = document.getElementById('monthlySip')?.closest('div');
		const note = document.getElementById('sipModeNote');
		if (!sel) return;

		const paint = () => {
			const mode = sel.value;
			salary?.classList.toggle('hidden', mode !== 'salary');
			(monthly as HTMLElement | null)?.classList.toggle('hidden', mode === 'salary');
			if (note) {
				note.textContent =
					mode === 'salary'
						? 'A share of income rises with your pay, and pay rises with prices — so this holds its value without you doing anything. Add a raise on top for career progression.'
						: mode === 'fixed'
							? 'A flat instalment is a plan to save less in real terms every year. At 6% inflation it buys about a third as much by year 20. Kept because some people do mean it.'
							: 'The amount you typed is treated as today\'s spending power and raised each year in line with prices, so what you give up every month never changes.';
			}
		};

		sel.addEventListener('change', () => { paint(); trigger(); });
		paint();
	}

	// The fund's fee. A cost the reader can actually act on - unlike growth,
	// inflation or a crash, this one is a choice - so the note says what the
	// choice is worth rather than merely restating the percentage.
	function initFundPlan() {
		const sel = document.getElementById('sipFundPlan') as HTMLSelectElement | null;
		const note = document.getElementById('sipFundNote');
		if (!sel) return;

		const paint = () => {
			const plan = FUND_COST_PLANS.find((p) => p.id === sel.value);
			if (note && plan) {
				// The fee and the return series are a PAIR (sol-036). The growth
				// assumption is the Nifty 50's own record, so choosing an active
				// fund is a claim about a manager, and the reader is told what
				// they are implicitly assuming rather than left to notice.
				const pairing = plan.id === 'index-direct' ? '' : ` ${ACTIVE_FUND_CAVEAT}`;
				note.textContent = `${plan.note}${pairing} ${EXIT_LOAD_NOT_MODELLED}`;
			}
		};

		sel.addEventListener('change', () => { paint(); trigger(); });
		paint();
	}

	function initPresets() {
		document.querySelectorAll('.preset-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				const type = btn.getAttribute('data-preset');
				const eq = document.getElementById('equitySlider') as HTMLInputElement;
				const dt = document.getElementById('debtSlider') as HTMLInputElement;
				const gd = document.getElementById('goldSlider') as HTMLInputElement;
				const years = document.getElementById('investmentYears') as HTMLInputElement;

				const split: Record<string, [string, string, string]> = {
					conservative: ['50', '40', '10'],
					balanced: ['70', '20', '10'],
					aggressive: ['80', '10', '10'],
					fire: ['80', '10', '10'],
				};
				const chosen = split[type ?? 'balanced'] ?? split.balanced;
				if (eq) eq.value = chosen[0];
				if (dt) dt.value = chosen[1];
				if (gd) gd.value = chosen[2];
				if (type === 'fire' && years) years.value = '15';

				paintAllocation();
				trigger();
			});
		});
	}

	function paintAllocation() {
		const eq = document.getElementById('equitySlider') as HTMLInputElement;
		const dt = document.getElementById('debtSlider') as HTMLInputElement;
		const gd = document.getElementById('goldSlider') as HTMLInputElement;
		const set = (id: string, v: string) => {
			const el = document.getElementById(id);
			if (el) el.innerText = v;
		};
		if (eq) set('equityVal', `${eq.value}%`);
		if (dt) set('debtVal', `${dt.value}%`);
		if (gd) set('goldVal', `${gd.value}%`);
		const total = (parseInt(eq?.value ?? '0') || 0) + (parseInt(dt?.value ?? '0') || 0) + (parseInt(gd?.value ?? '0') || 0);
		set('allocationTotalBadge', `Total: ${total}%`);
	}

	function initSliders() {
		const eq = document.getElementById('equitySlider') as HTMLInputElement;
		const dt = document.getElementById('debtSlider') as HTMLInputElement;
		const gd = document.getElementById('goldSlider') as HTMLInputElement;
		if (!eq || !dt || !gd) return;

		function adjust(changed: string) {
			let e = parseInt(eq.value) || 0;
			let d = parseInt(dt.value) || 0;
			let g = parseInt(gd.value) || 0;

			if (changed === 'eq') {
				const rem = 100 - e;
				const sumOthers = d + g;
				if (sumOthers > 0) { d = Math.round((d / sumOthers) * rem); g = rem - d; }
				else { d = Math.round(rem / 2); g = rem - d; }
			} else if (changed === 'dt') {
				const rem = 100 - d;
				const sumOthers = e + g;
				if (sumOthers > 0) { e = Math.round((e / sumOthers) * rem); g = rem - e; }
				else { e = Math.round(rem / 2); g = rem - e; }
			} else {
				const rem = 100 - g;
				const sumOthers = e + d;
				if (sumOthers > 0) { e = Math.round((e / sumOthers) * rem); d = rem - e; }
				else { e = Math.round(rem / 2); d = rem - e; }
			}

			eq.value = String(e);
			dt.value = String(d);
			gd.value = String(g);
			paintAllocation();
			debouncedTrigger();
		}

		eq.addEventListener('input', () => adjust('eq'));
		dt.addEventListener('input', () => adjust('dt'));
		gd.addEventListener('input', () => adjust('gd'));
	}

	function init() {
		subscribe();
		parseUrlParams();

		setupFormattingField(document.getElementById('seedCapital') as HTMLInputElement, () => {});
		setupFormattingField(document.getElementById('monthlySip') as HTMLInputElement, () => {});
		setupFormattingField(document.getElementById('targetRealWealth') as HTMLInputElement, () => {});

		paintAllocation();
		initSliders();
		initPresets();
		initRegimePresets();
		initFundPlan();
		initContributionMode();
		setPostTax(isPostTax());

		document.getElementById('runSipBtn')?.addEventListener('click', debouncedTrigger);
		document.getElementById('bsHedgingToggle')?.addEventListener('change', debouncedTrigger);
		document.getElementById('taxToggleBtn')?.addEventListener('click', () => {
			setPostTax(!isPostTax());
			trigger();
		});
		document.getElementById('exportCsvBtn')?.addEventListener('click', exportToCSV);

		[
			'seedCapital', 'monthlySip', 'targetRealWealth', 'stepUpRate',
			'investmentYears', 'inflationRate', 'sipExpectedReturn', 'sipVolatility',
			'sipLtcgTax', 'sipHedgingFloor',
		].forEach(id => {
			document.getElementById(id)?.addEventListener('input', debouncedTrigger);
		});

		window.addEventListener('theme-changed', () => {
			if (lastInputs && lastSimulation) renderChart(lastInputs, lastSimulation);
		});

		document.getElementById('downloadPdfBtn')?.addEventListener('click', async () => {
			const element = document.querySelector('main');
			if (!element) return;
			const opt = {
				margin: 10,
				filename: 'sip_plan.pdf',
				image: { type: 'jpeg', quality: 0.98 },
				html2canvas: { scale: 2, useCORS: true },
				jsPDF: { unit: 'mm', format: 'a3', orientation: 'portrait' },
			};
			const btn = document.getElementById('downloadPdfBtn');
			if (btn) btn.innerText = 'Generating PDF...';
			try {
				const { default: html2pdf } = await import('html2pdf.js');
				await html2pdf().set(opt).from(element).save();
			} finally {
				if (btn) btn.innerText = '↓ Download PDF Report';
			}
		});

		// The Answer's own worker fires the first run; this page only listens.
		// Kicking off a second one here is exactly what sol-026 was about.
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}
</script>
