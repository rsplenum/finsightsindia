    const rough = document.getElementById('sipVolatility') as HTMLInputElement;
    const regimeBtns = document.querySelectorAll('.sip-regime-btn');

    function paintRegime() {
      const g = growth?.value, r = rough?.value;
      regimeBtns.forEach((b) => {
        const bg = b.getAttribute('data-growth');
        const br = b.getAttribute('data-roughness');
        const on = bg === g && br === r;
        b.classList.toggle('border-gold-500', on);
        b.classList.toggle('bg-gold-500/10', on);
      });
    }

    regimeBtns.forEach((b) => {
      b.addEventListener('click', () => {
        if (growth) growth.value = b.getAttribute('data-growth') || '';
        if (rough) rough.value = b.getAttribute('data-roughness') || '';
        paintRegime();
        debouncedTrigger();
      });
    });

    growth?.addEventListener('input', () => { paintRegime(); debouncedTrigger(); });
    rough?.addEventListener('input', () => { paintRegime(); debouncedTrigger(); });
    paintRegime();

    // Asset allocation presets & sliders
    function paintAllocation() {
      const eq = document.getElementById('equitySlider') as HTMLInputElement;
      const dt = document.getElementById('debtSlider') as HTMLInputElement;
      const gd = document.getElementById('goldSlider') as HTMLInputElement;
      const set = (id: string, v: string) => {
        const el = document.getElementById(id);
        if (el) el.innerText = v;
      };
      if (eq) set('equityVal', `${eq.value}%`);
      if (dt) set('debtVal', `${dt.value}%`);
      if (gd) set('goldVal', `${gd.value}%`);
      const total = (parseInt(eq?.value ?? '0') || 0) + (parseInt(dt?.value ?? '0') || 0) + (parseInt(gd?.value ?? '0') || 0);
      set('allocationTotalBadge', `Total: ${total}%`);
    }

    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.getAttribute('data-preset');
        const eq = document.getElementById('equitySlider') as HTMLInputElement | null;
        const dt = document.getElementById('debtSlider') as HTMLInputElement | null;
        const gd = document.getElementById('goldSlider') as HTMLInputElement | null;
        const split: Record<string, [string, string, string]> = {
          conservative: ['50', '40', '10'],
          balanced: ['70', '20', '10'],
          aggressive: ['80', '10', '10'],
          fire: ['80', '10', '10'],
        };
        const chosen = (type && split[type]) ? split[type] : split.balanced;
        if (chosen && chosen.length >= 3) {
          if (eq) eq.value = chosen[0];
          if (dt) dt.value = chosen[1];
          if (gd) gd.value = chosen[2];
        }
        paintAllocation();
        debouncedTrigger();
      });
    });

    ['equitySlider', 'debtSlider', 'goldSlider'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', () => {
        paintAllocation();
        debouncedTrigger();
      });
    });
    paintAllocation();

    // Hedging toggle & fields
    document.getElementById('bsHedgingToggle')?.addEventListener('change', debouncedTrigger);
    document.getElementById('sipHedgingFloor')?.addEventListener('input', debouncedTrigger);

    // Tax toggle button
    const taxBtn = document.getElementById('taxToggleBtn');
    taxBtn?.addEventListener('click', () => {
      const isPost = taxBtn.getAttribute('aria-pressed') === 'true';
      const next = !isPost;
      taxBtn.setAttribute('aria-pressed', String(next));
      taxBtn.textContent = next ? 'After tax (12.5% LTCG)' : 'Before tax';
      trigger();
    });

    // Fund Plan
    const fundSel = document.getElementById('sipFundPlan') as HTMLSelectElement | null;
    const fundNote = document.getElementById('sipFundNote');
    function paintFund() {
      const plan = FUND_COST_PLANS.find((p) => p.id === fundSel?.value);
      if (fundNote && plan) {
        const pairing = plan.id === 'index-direct' ? '' : ` ${ACTIVE_FUND_CAVEAT}`;
        fundNote.textContent = `${plan.note}${pairing} ${EXIT_LOAD_NOT_MODELLED}`;
      }
    }
    fundSel?.addEventListener('change', () => { paintFund(); debouncedTrigger(); });
    paintFund();

    // Contribution mode
    const modeSel = document.getElementById('sipContributionMode') as HTMLSelectElement | null;
    const salaryFields = document.getElementById('sipSalaryFields');
    const modeNote = document.getElementById('sipModeNote');
    function paintMode() {
      const mode = modeSel?.value;
      salaryFields?.classList.toggle('hidden', mode !== 'salary');
      if (modeNote) {
        modeNote.textContent =
          mode === 'salary'
            ? 'A share of income rises with your pay, holding its purchasing power automatically.'
            : mode === 'fixed'
              ? 'A flat rupee instalment loses value to inflation each year. By year 20 it buys a third as much.'
              : 'Your contribution is treated as today\'s spending power, raised annually with prices to hold value.';
      }
    }
    modeSel?.addEventListener('change', () => { paintMode(); debouncedTrigger(); });
    paintMode();

    // CSV Export
    document.getElementById('exportCsvBtn')?.addEventListener('click', () => {
      if (!lastSimulation || !lastInputs) return;
      const years = lastInputs.horizonYears;
      let csv = 'Year,Unlucky (10th) Today ₹,Typical (50th) Today ₹,Lucky (90th) Today ₹\n';
      for (let yr = 0; yr <= years; yr++) {
        csv += `${yr},${Math.round(lastSimulation.p10Real[yr] || 0)},${Math.round(lastSimulation.p50Real[yr] || 0)},${Math.round(lastSimulation.p90Real[yr] || 0)}\n`;
      }
      const blob = new Blob([csv], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `sip_wealth_projection_${years}years.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // PDF Export
    document.getElementById('downloadPdfBtn')?.addEventListener('click', async () => {
      const element = document.querySelector('main');
      if (!element) return;
      const btn = document.getElementById('downloadPdfBtn');
      if (btn) btn.innerText = 'Generating PDF...';
      try {
        const { default: html2pdf } = await import('html2pdf.js');
        await html2pdf().set({
          margin: 10,
          filename: 'sip_wealth_plan.pdf',
          image: { type: 'jpeg', quality: 0.98 },
          html2canvas: { scale: 2, useCORS: true },
          jsPDF: { unit: 'mm', format: 'a3', orientation: 'portrait' },
        }).from(element).save();
      } finally {
        if (btn) btn.innerHTML = `
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>PDF Report</span>
        `;
      }
    });
  }

  function initChartResizeObserver() {
    const chartContainer = document.getElementById('sipChartContainer');
    if (!chartContainer) return;

    let lastRenderedWidth = chartContainer.clientWidth;
    let resizeTimer: any = null;

    const triggerResizeRedraw = (newWidth: number) => {
      if (Math.abs(newWidth - lastRenderedWidth) >= 4) {
        lastRenderedWidth = newWidth;
        if (lastInputs && lastSimulation) {
          renderChart(lastInputs, lastSimulation);
        }
      }
    };

    if (typeof ResizeObserver !== 'undefined') {
      const observer = new ResizeObserver((entries) => {
        for (const entry of entries) {
          const w = Math.round(entry.contentRect.width);
          if (w > 0) {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => triggerResizeRedraw(w), 60);
          }
        }
      });
      observer.observe(chartContainer);
    } else {
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          triggerResizeRedraw(chartContainer.clientWidth);
        }, 100);
      });
    }
  }

  function init() {
    initTabNavigation();
    initControls();
    initEmergencyBufferControls();
    initChartResizeObserver();
    updateDisplayBadges();

    // Listen for simulation broadcast events from SipAnswer compute host
    window.addEventListener('sip:result', (e: any) => {
      const d = e.detail;
      if (!d?.simulation) return;
      lastInputs = d.inputs;
      lastSimulation = d.simulation;
      renderMetrics(d.inputs, d.simulation, d.outlook);
      renderChart(d.inputs, d.simulation);
      renderMilestones(d.inputs, d.simulation);
      calculateEmergencyFortress();
    });

    window.addEventListener('sip:protection', (e: any) => {
      const d = e.detail;
      lastProtection = d.protection;
      if (lastInputs) {
        renderProtectionLedger(lastInputs, d.protection);
      }
    });

    window.addEventListener('theme-changed', () => {
      if (lastInputs && lastSimulation) {
        renderChart(lastInputs, lastSimulation);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
