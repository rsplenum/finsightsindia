  import { contributionPlan, instalmentInYear } from '../utils/sipAdvice';

  let lastInputs: any = null;
  let lastSimulation: any = null;
  let lastProtection: any = null;

  const grp = (n: number) => Math.round(n).toLocaleString('en-IN', { maximumFractionDigits: 0 });

  function formatMoney(n: number): string {
    const v = Math.round(n);
    if (v >= 10000000) return `₹ ${(v / 10000000).toFixed(2)} Cr`;
    if (v >= 100000) return `₹ ${(v / 100000).toFixed(1)} L`;
    return `₹ ${grp(v)}`;
  }

  /**
   * Computes the annualized real compound growth rate (real CAGR / real IRR)
   * of the median portfolio trajectory above inflation.
   */
  function computeRealCagr(
    seedCapital: number,
    monthlySip: number,
    realStepUpPct: number,
    horizonYears: number,
    terminalWealthReal: number
  ): number {
    if (horizonYears <= 0 || terminalWealthReal <= 0) return 0;
    
    let low = -0.5;
    let high = 2.0;
    const stepRate = realStepUpPct / 100;
    
    for (let iter = 0; iter < 30; iter++) {
      const mid = (low + high) / 2;
      let fv = seedCapital * Math.pow(1 + mid, horizonYears);
      for (let yr = 1; yr <= horizonYears; yr++) {
        const annualRealInstalment = monthlySip * 12 * Math.pow(1 + stepRate, yr - 1);
        fv += annualRealInstalment * Math.pow(1 + mid, horizonYears - yr + 0.5);
      }
      
      if (fv < terminalWealthReal) {
        low = mid;
      } else {
        high = mid;
      }
    }
    
    return ((low + high) / 2) * 100;
  }

  function trigger() {
    requestRecompute();
  }

  let debounceTimer: any = null;
  function debouncedTrigger() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(trigger, 150);
  }

