---
import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="Stochastic Purchasing Power Engine — Real Value SIP & Options Protection"
	description="Advanced Time Value of Money (TVM) Purchasing Power Simulator with 10,000 Monte Carlo paths, Real Capital Sacrifice vs Real Wealth Created analysis, and year-by-year Black-Scholes put option hedging ledger."
>
	<main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-8">

		<!-- Sophisticated Vercel Header -->
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-white/10 pb-5">
			<div class="space-y-1">
				<div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-slate-100 dark:bg-zinc-900 text-slate-800 dark:text-zinc-200 text-xs font-mono font-medium uppercase tracking-widest border border-slate-200 dark:border-white/10">
					<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
					<span>REAL VALUE (TVM) PURCHASING POWER ENGINE</span>
				</div>
				<h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-zinc-100 font-sans">
					Stochastic Accumulation Engine
				</h1>
				<p class="text-xs sm:text-sm text-slate-500 dark:text-zinc-400 max-w-2xl leading-relaxed">
					Quantifying today's real purchasing power sacrificed against future real purchasing power created under stochastic market stress.
				</p>
			</div>
			
			<div class="flex items-center gap-2 self-start sm:self-auto">
				<span class="px-3 py-1.5 rounded-md bg-slate-100 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 text-xs font-mono font-semibold border border-slate-200 dark:border-white/10">
					STRESS TEST: 2,000 PATHS
				</span>
			</div>
		</div>

		<!-- SECTION 1: COMPACT 2-COLUMN DASHBOARD (5/12 vs 7/12 Proportions) -->
		<section class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">

			<!-- Left Column: Input Parameters & Asset Matrix (5/12 Width) -->
			<div class="col-span-1 lg:col-span-5 flex flex-col gap-5 bg-white dark:bg-zinc-950 border border-slate-200 dark:border-white/10 rounded-xl p-5 shadow-xs w-full transition-all duration-200 ease-geist">
				
				<div class="flex items-center justify-between border-b border-slate-200 dark:border-white/10 pb-3">
					<h2 class="text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-zinc-100 flex items-center gap-2">
						<svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
						</svg>
						SACRIFICE MATRIX
					</h2>
					<span class="text-[10px] font-mono text-slate-400 dark:text-zinc-500">INPUT CONTROLS</span>
				</div>

				<form id="sipForm" onsubmit="event.preventDefault();" class="space-y-4">
					
					<!-- ENGINE MODE SWITCHER -->
					<div class="p-1 bg-slate-100 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-lg flex items-center justify-between gap-1 font-mono text-[10px] uppercase font-bold">
						<button id="modeForwardBtn" type="button" class="flex-1 py-1.5 rounded-md transition-all duration-200 bg-slate-900 text-white dark:bg-white dark:text-black shadow-xs text-center cursor-pointer">
							FORWARD: STOCHASTIC
						</button>
						<button id="modeReverseBtn" type="button" class="flex-1 py-1.5 rounded-md transition-all duration-200 bg-transparent text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-100 text-center cursor-pointer">
							REVERSE: GOAL-SEEK
						</button>
					</div>

					<!-- Initial Seed Capital (Lump Sum) with Qtip -->
					<div class="space-y-1.5">
						<div class="flex justify-between items-center text-xs">
							<div class="inline-flex items-center gap-1.5">
								<label for="seedCapital" class="font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
									Initial Seed Capital (₹)
								</label>
								<div class="relative group inline-flex items-center cursor-pointer">
									<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									<div class="absolute opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200 z-50 w-52 p-2 text-xs font-mono bg-slate-900 text-white dark:bg-zinc-900 dark:text-zinc-100 rounded-md shadow-md bottom-full mb-2 left-1/2 -translate-x-1/2 text-center border border-slate-700 dark:border-white/20">
										Initial lump sum capital deployed at t = 0.
									</div>
								</div>
							</div>
							<span class="font-mono text-slate-400 dark:text-zinc-500">₹ Lump Sum</span>
						</div>
						<div class="relative">
							<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm font-mono font-medium">₹</span>
							<input 
								type="number" 
								id="seedCapital" 
								value="0" 
								min="0" 
								step="50000"
								class="w-full pl-8 pr-4 py-2 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-mono font-bold text-sm focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-400 transition-all duration-200"
							/>
						</div>
					</div>

					<!-- Monthly SIP Amount Container -->
					<div id="monthlySipContainer" class="space-y-1.5">
						<div class="flex justify-between items-center text-xs">
							<div class="inline-flex items-center gap-1.5">
								<label for="monthlySip" class="font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
									Monthly SIP Contribution
								</label>
								<div class="relative group inline-flex items-center cursor-pointer">
									<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									<div class="absolute opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200 z-50 w-52 p-2 text-xs font-mono bg-slate-900 text-white dark:bg-zinc-900 dark:text-zinc-100 rounded-md shadow-md bottom-full mb-2 left-1/2 -translate-x-1/2 text-center border border-slate-700 dark:border-white/20">
										Monthly capital deployed into your portfolio.
									</div>
								</div>
							</div>
							<span class="font-mono text-slate-400 dark:text-zinc-500">₹ / Month</span>
						</div>
						<div class="relative">
							<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm font-mono font-medium">₹</span>
							<input 
								type="number" 
								id="monthlySip" 
								value="25000" 
								min="1000" 
								step="1000"
								class="w-full pl-8 pr-4 py-2 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-mono font-bold text-sm focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-400 transition-all duration-200"
							/>
						</div>
					</div>

					<!-- Target Real Wealth Container (Reverse Mode) -->
					<div id="targetRealWealthContainer" class="space-y-1.5 hidden">
						<div class="flex justify-between items-center text-xs">
							<div class="inline-flex items-center gap-1.5">
								<label for="targetRealWealth" class="font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
									Target Real Wealth (₹)
								</label>
								<div class="relative group inline-flex items-center cursor-pointer">
									<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									<div class="absolute opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200 z-50 w-52 p-2 text-xs font-mono bg-slate-900 text-white dark:bg-zinc-900 dark:text-zinc-100 rounded-md shadow-md bottom-full mb-2 left-1/2 -translate-x-1/2 text-center border border-slate-700 dark:border-white/20">
										Target real purchasing power in today's rupees.
									</div>
								</div>
							</div>
							<span class="font-mono text-slate-400 dark:text-zinc-500">₹ Target PV</span>
						</div>
						<div class="relative">
							<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm font-mono font-medium">₹</span>
							<input 
								type="number" 
								id="targetRealWealth" 
								value="50000000" 
								min="1000000" 
								step="1000000"
								class="w-full pl-8 pr-4 py-2 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-mono font-bold text-sm focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-400 transition-all duration-200"
							/>
						</div>
					</div>

					<!-- Required Starting SIP Hairline Result Card -->
					<div id="requiredSipResultCard" class="hidden bg-emerald-500/10 border border-emerald-500/30 rounded-md p-3 space-y-1">
						<div class="flex justify-between items-center text-[10px] font-mono font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">
							<span>REQUIRED STARTING SIP</span>
							<span>GOAL-SEEK RESULT</span>
						</div>
						<div id="valRequiredSip" class="text-xl font-mono font-bold tracking-tight text-emerald-600 dark:text-emerald-400">
							₹ 0 / Month
						</div>
					</div>

					<!-- Annual Step-Up Rate (%) with Qtip -->
					<div class="space-y-1.5">
						<div class="flex justify-between items-center gap-2">
							<div class="relative group inline-flex items-center gap-1.5 cursor-pointer shrink-0">
								<label for="stepUpRate" class="text-[10px] sm:text-xs font-mono text-slate-500 dark:text-zinc-500 uppercase tracking-widest font-semibold cursor-pointer truncate">
									Annual Step-Up
								</label>
								<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
								<div class="absolute opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200 z-50 w-52 p-2 text-xs font-mono bg-slate-900 text-white dark:bg-zinc-900 dark:text-zinc-100 rounded-md shadow-md bottom-full mb-2 left-1/2 -translate-x-1/2 text-center border border-slate-700 dark:border-white/20">
									Annual escalation percentage on monthly SIP.
								</div>
							</div>
							<span class="text-[9px] sm:text-[10px] font-mono text-slate-400 dark:text-zinc-500 shrink-0 whitespace-nowrap">% / YR</span>
						</div>
						<div class="relative">
							<input 
								type="number" 
								id="stepUpRate" 
								value="0" 
								min="0" 
								max="20"
								step="1"
								class="w-full px-3 py-2 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-mono font-bold text-sm focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-400 transition-all duration-200"
							/>
							<span class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 text-xs font-mono">%</span>
						</div>
					</div>

					<!-- Investment Horizon & Inflation Grid -->
					<div class="grid grid-cols-2 gap-3">
						
						<!-- Horizon Years with Qtip -->
						<div class="space-y-1.5">
							<div class="flex items-center justify-between">
								<div class="inline-flex items-center gap-1">
									<label for="investmentYears" class="text-xs font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
										Horizon
									</label>
									<div class="relative group inline-flex items-center cursor-pointer">
										<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
										<div class="absolute opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200 z-50 w-44 p-2 text-xs font-mono bg-slate-900 text-white dark:bg-zinc-900 dark:text-zinc-100 rounded-md shadow-md bottom-full mb-2 left-1/2 -translate-x-1/2 text-center border border-slate-700 dark:border-white/20">
											Total accumulation horizon.
										</div>
									</div>
								</div>
								<span class="font-mono text-[10px] text-slate-400 dark:text-zinc-500">YRS</span>
							</div>
							<input 
								type="number" 
								id="investmentYears" 
								value="20" 
								min="1" 
								max="50"
								class="w-full px-3 py-2 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-mono font-bold text-sm focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-400 transition-all duration-200"
							/>
						</div>

						<!-- Inflation Rate with Qtip -->
						<div class="space-y-1.5">
							<div class="flex items-center justify-between">
								<div class="inline-flex items-center gap-1">
									<label for="inflationRate" class="text-xs font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
										Inflation Rate
									</label>
									<div class="relative group inline-flex items-center cursor-pointer">
										<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
										<div class="absolute opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200 z-50 w-48 p-2 text-xs font-mono bg-slate-900 text-white dark:bg-zinc-900 dark:text-zinc-100 rounded-md shadow-md bottom-full mb-2 left-1/2 -translate-x-1/2 text-center border border-slate-700 dark:border-white/20">
											Discount rate for Real TVM purchasing power.
										</div>
									</div>
								</div>
								<span class="font-mono text-[10px] text-slate-400 dark:text-zinc-500">%</span>
							</div>
							<div class="relative">
								<input 
									type="number" 
									id="inflationRate" 
									value="6.0" 
									min="0" 
									max="20" 
									step="0.5"
									class="w-full pl-3 pr-7 py-2 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-mono font-bold text-sm focus:outline-none focus:border-emerald-500 dark:focus:border-emerald-400 transition-all duration-200"
								/>
								<span class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 text-xs font-mono">%</span>
							</div>
						</div>

					</div>

					<!-- PURCHASING POWER SACRIFICE HIGHLIGHT CELL -->
					<div class="bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md p-3.5 space-y-1">
						<div class="flex justify-between items-center">
							<div class="inline-flex items-center gap-1">
								<span class="text-[11px] font-mono uppercase tracking-wider font-semibold text-slate-500 dark:text-zinc-400">Purchasing Power Sacrificed (PV)</span>
								<div class="relative group inline-flex items-center cursor-pointer">
									<svg class="w-3 h-3 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
									<div class="absolute opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200 z-50 w-52 p-2 text-xs font-mono bg-slate-900 text-white dark:bg-zinc-900 dark:text-zinc-100 rounded-md shadow-md bottom-full mb-2 left-1/2 -translate-x-1/2 text-center border border-slate-700 dark:border-white/20">
										Sum of all future monthly contributions discounted to today's rupees.
									</div>
								</div>
							</div>
							<span class="text-[10px] font-mono font-bold text-emerald-600 dark:text-emerald-400 uppercase">TODAY'S VALUE</span>
						</div>
						<div id="valSacrificePV" class="text-xl font-mono font-bold tracking-tight text-slate-900 dark:text-zinc-100">
							₹ 0
						</div>
					</div>

					<!-- QUANT PRESETS -->
					<div class="pt-3 border-t border-slate-200 dark:border-white/10 space-y-2">
						<span class="text-[10px] font-mono font-bold uppercase tracking-widest text-slate-500 dark:text-zinc-400">QUANT PRESETS</span>
						<div class="grid grid-cols-2 gap-1.5">
							<button type="button" data-preset="conservative" class="preset-btn border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-zinc-900 text-[10px] uppercase font-mono tracking-widest text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-100 py-1.5 rounded-md transition-colors text-center cursor-pointer">
								[ CONSERVATIVE ]
							</button>
							<button type="button" data-preset="balanced" class="preset-btn border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-zinc-900 text-[10px] uppercase font-mono tracking-widest text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-100 py-1.5 rounded-md transition-colors text-center cursor-pointer">
								[ BALANCED ]
							</button>
							<button type="button" data-preset="aggressive" class="preset-btn border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-zinc-900 text-[10px] uppercase font-mono tracking-widest text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-100 py-1.5 rounded-md transition-colors text-center cursor-pointer">
								[ AGGRESSIVE ]
							</button>
							<button type="button" data-preset="fire" class="preset-btn border border-slate-200 dark:border-white/10 hover:bg-slate-100 dark:hover:bg-zinc-900 text-[10px] uppercase font-mono tracking-widest text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-100 py-1.5 rounded-md transition-colors text-center cursor-pointer">
								[ FIRE 15-YR ]
							</button>
						</div>
					</div>



					<!-- ASSET ALLOCATION MATRIX (PROPORTIONAL AUTO-ADJUSTING SLIDERS) -->
					<div class="pt-3 border-t border-slate-200 dark:border-white/10 space-y-3">
						<div class="flex items-center justify-between">
							<span class="text-xs font-mono font-bold uppercase tracking-widest text-slate-900 dark:text-zinc-100">PROPORTIONAL ASSET MATRIX</span>
							<span id="allocationTotalBadge" class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">Total: 100%</span>
						</div>

						<!-- Equity Slider -->
						<div class="space-y-1.5">
							<div class="flex justify-between items-center text-xs font-mono">
								<div class="inline-flex items-center gap-1">
									<span class="text-slate-700 dark:text-zinc-300 font-medium">Equity (12% CAGR, 15% Vol)</span>
									<div class="relative group inline-flex items-center cursor-pointer">
										<svg class="w-3 h-3 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
										<div class="absolute opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-200 z-50 w-48 p-2 text-xs font-mono bg-slate-900 text-white dark:bg-zinc-900 dark:text-zinc-100 rounded-md shadow-md bottom-full mb-2 left-1/2 -translate-x-1/2 text-center border border-slate-700 dark:border-white/20">
											High growth stocks (12% CAGR, 15% Volatility).
										</div>
									</div>
								</div>
								<span id="equityVal" class="font-bold text-slate-900 dark:text-zinc-100">70%</span>
							</div>
							<input type="range" id="equitySlider" min="0" max="100" value="70" class="w-full accent-slate-900 dark:accent-white cursor-pointer h-1.5 rounded-md bg-slate-200 dark:bg-zinc-800" />
						</div>

						<!-- Debt Slider -->
						<div class="space-y-1.5">
							<div class="flex justify-between items-center text-xs font-mono">
								<div class="inline-flex items-center gap-1">
									<span class="text-slate-700 dark:text-zinc-300 font-medium">Debt (7.1% Risk-Free)</span>
									<div class="relative group inline-flex items-center cursor-pointer">
										<svg class="w-3 h-3 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
