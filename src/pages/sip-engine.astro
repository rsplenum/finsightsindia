    // Shock Amount Buttons
    document.querySelectorAll('.shock-amount-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.shock-amount-btn').forEach((b) => {
          b.classList.remove('active-shock', 'border-rose-400', 'bg-rose-50', 'dark:bg-rose-950/40', 'text-rose-900', 'dark:text-rose-200', 'font-bold', 'shadow-xs');
          b.classList.add('border-navy-200', 'dark:border-navy-800', 'bg-navy-50/60', 'dark:bg-navy-900', 'text-navy-800', 'dark:text-navy-200', 'font-semibold');
