<script>
	// Quantitative Stochastic Engine Controller
	let sipChartInstance: any = null;
	let lastSimulationResult: any = null;
	let isPostTax = false;
	let isReverseGoalSeek = false;

	let sipWorker: Worker | null = null;
	if (typeof window !== 'undefined' && window.Worker) {
		sipWorker = new Worker(new URL('../workers/sipWorker.ts', import.meta.url), { type: 'module' });
	}

	function runWorkerTask(type: string, params: any): Promise<any> {
		return new Promise((resolve) => {
			if (!sipWorker) return resolve(null);
			const handler = (e: MessageEvent) => {
				if (e.data.type === type + '_RESULT') {
					sipWorker?.removeEventListener('message', handler);
					resolve(e.data.result);
				}
			};
			sipWorker.addEventListener('message', handler);
			sipWorker.postMessage({ type, params });
		});
	}

	function debounce(fn: Function, ms = 300) { let t: any; return (...a: any) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }


	function parseNum(id: string, defaultVal: number): number {
		const el = document.getElementById(id) as HTMLInputElement;
		if (!el) return defaultVal;
		const parsed = parseFloat(el.value);
		return isNaN(parsed) ? defaultVal : parsed;
	}

	function formatRupee(val: number): string {
		if (isNaN(val)) return '₹ 0';
		const abs = Math.abs(val);
		if (abs >= 10000000) return `₹ ${(val / 10000000).toFixed(2)} Cr`;
		if (abs >= 100000) return `₹ ${(val / 100000).toFixed(2)} Lakh`;
		return `₹ ${Math.round(val).toLocaleString('en-IN')}`;
	}

	function handleCalculationTrigger() {
		if (isReverseGoalSeek) {
			runGoalSeek();
		} else {
			runSimulation();
		}
	}

	// Mode Switcher Handler (FORWARD STOCHASTIC vs REVERSE GOAL-SEEK)
	function initModeSwitcher() {
		const fwdBtn = document.getElementById('modeForwardBtn');
		const revBtn = document.getElementById('modeReverseBtn');
		const sipContainer = document.getElementById('monthlySipContainer');
		const targetContainer = document.getElementById('targetRealWealthContainer');
		const reqCard = document.getElementById('requiredSipResultCard');
		const runBtn = document.getElementById('runSipBtn');
		const btnText = runBtn ? runBtn.querySelector('span') : null;

		if (!fwdBtn || !revBtn) return;

		fwdBtn.addEventListener('click', () => {
			isReverseGoalSeek = false;
			fwdBtn.className = 'flex-1 py-1.5 rounded-md transition-all duration-200 bg-slate-900 text-white dark:bg-white dark:text-black shadow-xs text-center cursor-pointer';
			revBtn.className = 'flex-1 py-1.5 rounded-md transition-all duration-200 bg-transparent text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-100 text-center cursor-pointer';
			
			sipContainer?.classList.remove('hidden');
			targetContainer?.classList.add('hidden');
			reqCard?.classList.add('hidden');

			if (btnText) btnText.innerText = 'SIMULATE REAL TVM PATHS';
			runSimulation();
		});

		revBtn.addEventListener('click', () => {
			isReverseGoalSeek = true;
			revBtn.className = 'flex-1 py-1.5 rounded-md transition-all duration-200 bg-slate-900 text-white dark:bg-white dark:text-black shadow-xs text-center cursor-pointer';
			fwdBtn.className = 'flex-1 py-1.5 rounded-md transition-all duration-200 bg-transparent text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-100 text-center cursor-pointer';

			sipContainer?.classList.add('hidden');
			targetContainer?.classList.remove('hidden');
			reqCard?.classList.remove('hidden');

			if (btnText) btnText.innerText = 'CALCULATE REQUIRED SIP';
			runGoalSeek();
		});
	}

	// Clean Goal-Seek Engine (250-path Binary Search)
	async function runGoalSeek() {
		const btnText = document.querySelector('#runSipBtn span') as HTMLElement;
		const originalText = btnText ? btnText.innerText : '';
		if (btnText) btnText.innerText = 'CALCULATING...';

		const targetRealWealth = parseNum('targetRealWealth', 50000000);
		const seedCapital = parseNum('seedCapital', 0);
		const stepUpRate = parseNum('stepUpRate', 0) / 100;
		const horizonYears = parseNum('investmentYears', 20);
		const inflationRate = parseNum('inflationRate', 6.0) / 100;

		const eqPct = parseNum('equitySlider', 70) / 100;
		const debtPct = parseNum('debtSlider', 20) / 100;
		const goldPct = parseNum('goldSlider', 10) / 100;

		const bsToggle = document.getElementById('bsHedgingToggle') as HTMLInputElement;
		const bsEnabled = bsToggle ? bsToggle.checked : false;
		const annualHedgingDragCost = bsEnabled ? (0.0185 * eqPct) : 0;

		const reqSip = await runWorkerTask('GOAL_SEEK', {
			targetRealWealth, seedCapital, stepUpRate, horizonYears, inflationRate,
			eqPct, debtPct, goldPct, bsEnabled, annualHedgingDragCost, isPostTax
		});

		const reqCardVal = document.getElementById('valRequiredSip');
		if (reqCardVal) reqCardVal.innerText = `${formatRupee(reqSip)} / Month`;

		const sipInput = document.getElementById('monthlySip') as HTMLInputElement;
		if (sipInput) sipInput.value = reqSip.toString();

		if (btnText) btnText.innerText = originalText;
		runSimulation();
	}

	// Historical Market Crash Stress Test Engine (Context-Aware Architecture)


	// Post-Tax Net Real Wealth Calculator (12.5% LTCG on gains exceeding ₹1.25 Lakh)
	function calculateNetRealWealth(pv: number, totalInvested: number): number {
		if (!isPostTax) return pv;
		const taxableGain = Math.max(0, pv - totalInvested - 125000);
		const ltcgTax = taxableGain * 0.125;
		return Math.max(0, Math.round(pv - ltcgTax));
	}

	// Post-Tax Toggle Listener Handler
	function initTaxToggle() {
		const btn = document.getElementById('taxToggleBtn');
		if (!btn) return;

		btn.addEventListener('click', () => {
			isPostTax = !isPostTax;
			if (isPostTax) {
				btn.innerText = 'POST-TAX (12.5% LTCG)';
				btn.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider transition-all duration-200 bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 cursor-pointer';
			} else {
				btn.innerText = 'PRE-TAX';
				btn.className = 'px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider transition-all duration-200 bg-slate-200 text-slate-800 dark:bg-zinc-800 dark:text-zinc-200 border border-slate-300 dark:border-white/10 cursor-pointer';
			}
			handleCalculationTrigger();
		});
	}

	// 1-Click Quant Presets Handler
	function initPresets() {
		const btns = document.querySelectorAll('.preset-btn');
		btns.forEach(btn => {
			btn.addEventListener('click', () => {
				const type = btn.getAttribute('data-preset');
				const eq = document.getElementById('equitySlider') as HTMLInputElement;
				const dt = document.getElementById('debtSlider') as HTMLInputElement;
				const gd = document.getElementById('goldSlider') as HTMLInputElement;
				const years = document.getElementById('investmentYears') as HTMLInputElement;

				const eqV = document.getElementById('equityVal');
				const dtV = document.getElementById('debtVal');
				const gdV = document.getElementById('goldVal');

				if (type === 'conservative') {
					if (eq) eq.value = '50';
					if (dt) dt.value = '40';
					if (gd) gd.value = '10';
				} else if (type === 'balanced') {
					if (eq) eq.value = '70';
					if (dt) dt.value = '20';
					if (gd) gd.value = '10';
				} else if (type === 'aggressive') {
					if (eq) eq.value = '80';
					if (dt) dt.value = '10';
					if (gd) gd.value = '10';
				} else if (type === 'fire') {
					if (eq) eq.value = '80';
					if (dt) dt.value = '10';
					if (gd) gd.value = '10';
					if (years) years.value = '15';
				}

				if (eqV && eq) eqV.innerText = `${eq.value}%`;
				if (dtV && dt) dtV.innerText = `${dt.value}%`;
				if (gdV && gd) gdV.innerText = `${gd.value}%`;

				handleCalculationTrigger();
			});
		});
	}

	// Proportional Auto-Adjusting Sliders (Total ALWAYS = 100%)
	function initSliders() {
		const eq = document.getElementById('equitySlider') as HTMLInputElement;
		const dt = document.getElementById('debtSlider') as HTMLInputElement;
		const gd = document.getElementById('goldSlider') as HTMLInputElement;

		const eqV = document.getElementById('equityVal');
		const dtV = document.getElementById('debtVal');
		const gdV = document.getElementById('goldVal');

		if (!eq || !dt || !gd) return;

		function adjust(changed: string) {
			let e = parseInt(eq.value) || 0;
			let d = parseInt(dt.value) || 0;
			let g = parseInt(gd.value) || 0;

			if (changed === 'eq') {
				const rem = 100 - e;
				const sumOthers = d + g;
				if (sumOthers > 0) {
					d = Math.round((d / sumOthers) * rem);
					g = rem - d;
				} else {
					d = Math.round(rem / 2);
					g = rem - d;
				}
			} else if (changed === 'dt') {
				const rem = 100 - d;
				const sumOthers = e + g;
				if (sumOthers > 0) {
					e = Math.round((e / sumOthers) * rem);
					g = rem - e;
				} else {
					e = Math.round(rem / 2);
					g = rem - e;
				}
			} else if (changed === 'gd') {
				const rem = 100 - g;
				const sumOthers = e + d;
				if (sumOthers > 0) {
					e = Math.round((e / sumOthers) * rem);
					d = rem - e;
				} else {
					e = Math.round(rem / 2);
					d = rem - e;
				}
			}

			eq.value = e.toString();
			dt.value = d.toString();
			gd.value = g.toString();

			if (eqV) eqV.innerText = `${e}%`;
			if (dtV) dtV.innerText = `${d}%`;
			if (gdV) gdV.innerText = `${g}%`;

			handleCalculationTrigger();
		}

		eq.addEventListener('input', () => adjust('eq'));
		dt.addEventListener('input', () => adjust('dt'));
		gd.addEventListener('input', () => adjust('gd'));
	}

	// FAQ Category Filter Handler
	function initFaqFilter() {
		const filterContainer = document.getElementById('faqFilterContainer');
		if (!filterContainer) return;

		const filterBtns = filterContainer.querySelectorAll('.faq-filter-btn');
		const faqCards = document.querySelectorAll('.faq-card');

		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const category = btn.getAttribute('data-faq-cat');

				filterBtns.forEach(b => {
					b.className = 'faq-filter-btn px-3 py-1.5 rounded-md text-xs font-mono font-bold uppercase tracking-wider transition-all duration-200 bg-transparent text-slate-600 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-200 cursor-pointer whitespace-nowrap';
				});

				btn.className = 'faq-filter-btn px-3 py-1.5 rounded-md text-xs font-mono font-bold uppercase tracking-wider transition-all duration-200 bg-slate-900 text-white dark:bg-white dark:text-black cursor-pointer shadow-xs whitespace-nowrap';

				faqCards.forEach(card => {
					const cardCat = card.getAttribute('data-category');
					if (category === 'all' || cardCat === category) {
						(card as HTMLElement).style.display = 'flex';
					} else {
						(card as HTMLElement).style.display = 'none';
					}
				});
			});
		});
	}

	// CSV Export Handler
	function exportToCSV() {
		if (!lastSimulationResult) return;
		const { horizonYears, p90Real, p50Real, p10Real } = lastSimulationResult;
		
		let csv = 'Year,10th Bear Real (PV),50th Expected Real (PV),90th Bull Real (PV)\n';
		for (let yr = 0; yr <= horizonYears; yr++) {
			csv += `${yr},${p10Real[yr] || 0},${p50Real[yr] || 0},${p90Real[yr] || 0}\n`;
		}

		const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
		const url = URL.createObjectURL(blob);
		const link = document.createElement('a');
		link.setAttribute('href', url);
		link.setAttribute('download', 'quant_tvm_ledger.csv');
		document.body.appendChild(link);
		link.click();
		document.body.removeChild(link);
	}

	// Core Quant Simulation Engine
	async function runSimulation() {
		const btnText = document.querySelector('#runSipBtn span') as HTMLElement;
		const originalText = btnText ? btnText.innerText : '';
		if (btnText) btnText.innerText = 'SIMULATING...';

		const seedCapital = parseNum('seedCapital', 0);
		const monthlySip = parseNum('monthlySip', 25000);
		const stepUpRate = parseNum('stepUpRate', 0) / 100;
		const horizonYears = parseNum('investmentYears', 20);
		const inflationRate = parseNum('inflationRate', 6.0) / 100;
		
		const eqPct = parseNum('equitySlider', 70) / 100;
		const debtPct = parseNum('debtSlider', 20) / 100;
		const goldPct = parseNum('goldSlider', 10) / 100;

		const bsToggle = document.getElementById('bsHedgingToggle') as HTMLInputElement;
		const bsEnabled = bsToggle ? bsToggle.checked : false;

		const annualHedgingDragCost = 0.0185 * eqPct;

		const simResult = await runWorkerTask('SIMULATE', {
			seedCapital, monthlySip, stepUpRate, horizonYears, inflationRate,
			eqPct, debtPct, goldPct, bsEnabled, annualHedgingDragCost
		});

		if (btnText) btnText.innerText = originalText;
		if (!simResult) return;

		const { p90Real, p50Real, p10Real, realOutflowPV, expectedNominalMedian } = simResult;

		// Update UI Stats
		const sacrificePVEl = document.getElementById('valSacrificePV');
		const totalInvestedEl = document.getElementById('statTotalInvested');
		const realWealthEl = document.getElementById('statRealWealth');
		const bearWealthEl = document.getElementById('statBearWealth');
		const bullWealthEl = document.getElementById('statBullWealth');

		const worstTagEl = document.getElementById('worstMultiplierTag');
		const expectedTagEl = document.getElementById('expectedMultiplierTag');
		const bestTagEl = document.getElementById('bestMultiplierTag');

		const rawExpectedRealFinal = p50Real[horizonYears];
		const rawBearRealFinal = p10Real[horizonYears];
		const rawBullRealFinal = p90Real[horizonYears];

		const expectedRealFinal = calculateNetRealWealth(rawExpectedRealFinal, realOutflowPV);
		const bearRealFinal = calculateNetRealWealth(rawBearRealFinal, realOutflowPV);
		const bullRealFinal = calculateNetRealWealth(rawBullRealFinal, realOutflowPV);

		// Split Bar Logic
		const pctSacrificed = expectedRealFinal > 0 ? Math.min(100, (realOutflowPV / expectedRealFinal) * 100) : 100;
		const pctCreated = Math.max(0, 100 - pctSacrificed);
		const elPctSacrifice = document.getElementById('pctSacrifice');
		const elPctCreated = document.getElementById('pctCreated');
		const elBarSacrifice = document.getElementById('barSacrifice');
		const elBarCreated = document.getElementById('barCreated');
		if (elPctSacrifice) elPctSacrifice.innerText = `${pctSacrificed.toFixed(1)}%`;
		if (elPctCreated) elPctCreated.innerText = `${pctCreated.toFixed(1)}%`;
		if (elBarSacrifice) elBarSacrifice.style.width = `${pctSacrificed}%`;
		if (elBarCreated) elBarCreated.style.width = `${pctCreated}%`;

		if (elBarCreated) elBarCreated.style.width = `${pctCreated}%`;

		const nominalEquivalentEl = document.getElementById('statNominalEquivalent');
		if (nominalEquivalentEl) nominalEquivalentEl.innerText = `Nominal Equivalent: ${formatRupee(expectedNominalMedian)}`;

		lastSimulationResult = {
			horizonYears,
			monthlySip,
			inflationRate,
			p90Real,
			p50Real,
			p10Real
		};

		if (sacrificePVEl) sacrificePVEl.innerText = formatRupee(realOutflowPV);
		if (totalInvestedEl) totalInvestedEl.innerText = formatRupee(realOutflowPV);
		if (realWealthEl) realWealthEl.innerText = formatRupee(expectedRealFinal);
		if (bearWealthEl) bearWealthEl.innerText = formatRupee(bearRealFinal);
		if (bullWealthEl) bullWealthEl.innerText = formatRupee(bullRealFinal);

		if (realOutflowPV > 0) {
			const worstMult = (bearRealFinal / realOutflowPV).toFixed(2);
			const expectedMult = (expectedRealFinal / realOutflowPV).toFixed(2);
			const bestMult = (bullRealFinal / realOutflowPV).toFixed(2);

			if (worstTagEl) worstTagEl.innerText = `${worstMult}x Worst (10th)`;
			if (expectedTagEl) expectedTagEl.innerText = `${expectedMult}x Expected (50th)`;
			if (bestTagEl) bestTagEl.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span><span>${bestMult}x Best (90th)</span>`;
		}

		// Black-Scholes Panel Updates
		const statusBadgeEl = document.getElementById('bsStatusBadge');
		const dragEl = document.getElementById('valHedgingDrag');
		const floorEl = document.getElementById('valProtectedFloor');
		const yieldEl = document.getElementById('valAdjustedYield');

		if (statusBadgeEl) {
			if (bsEnabled) {
				statusBadgeEl.innerText = "ACTIVE PUT HEDGING ON";
				statusBadgeEl.className = "px-3 py-1 text-xs font-mono font-bold uppercase tracking-wider rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800";
			} else {
				statusBadgeEl.innerText = "UNHEDGED PORTFOLIO";
				statusBadgeEl.className = "px-3 py-1 text-xs font-mono font-bold uppercase tracking-wider rounded-md bg-slate-100 text-slate-600 dark:bg-zinc-900 dark:text-zinc-400 border border-slate-200 dark:border-white/10";
			}
		}

		if (dragEl) dragEl.innerText = bsEnabled ? `${(annualHedgingDragCost * 100).toFixed(2)}% / Year` : "0.00% / Year";
		if (floorEl) floorEl.innerText = formatRupee(bsEnabled ? Math.max(realOutflowPV, bearRealFinal * 1.15) : bearRealFinal);

		const netRealXIRR = Math.max(0, ((Math.pow(expectedRealFinal / Math.max(1, realOutflowPV / 2), 1 / horizonYears) - 1) * 100));
		if (yieldEl) yieldEl.innerText = `${netRealXIRR.toFixed(2)}% Real XIRR`;

		// Render Year-by-Year Hedging Ledger
		renderHedgingLedger(horizonYears, monthlySip, inflationRate, p50Real, bsEnabled, annualHedgingDragCost);

		// Milestone Timeline Logic
		const targets = [5000000, 10000000, 25000000, 50000000, 100000000]; // 50L, 1Cr, 2.5Cr, 5Cr, 10Cr
		const timelineContainer = document.getElementById('milestoneTimeline');
		if (timelineContainer) {
			let timelineHTML = `<span class="text-slate-500 dark:text-zinc-500 uppercase tracking-widest font-bold text-[10px] mr-1">Milestones (PV):</span>`;
			let milestonesHit = 0;
			
			targets.forEach(target => {
				const hitYear = p50Real.findIndex(val => val >= target);
				if (hitYear > 0) {
					milestonesHit++;
					timelineHTML += `<span class="px-2 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 rounded text-[10px] font-bold tracking-tight">Yr ${hitYear}: ${formatRupee(target)}</span>`;
				}
			});
			
			if (milestonesHit === 0) {
				timelineHTML += `<span class="text-slate-400 dark:text-zinc-600 text-[10px] italic">No major milestones reached in horizon.</span>`;
			}
			timelineContainer.innerHTML = timelineHTML;
		}

		// Render Chart.js
		renderChart(horizonYears, p90Real, p50Real, p10Real);
	}

	// Render Year-by-Year Hedging Ledger Table
	function renderHedgingLedger(
		years: number, 
		monthlySip: number, 
		inflationRate: number, 
		p50Real: number[], 
		bsEnabled: boolean,
		dragCostPercent: number
	) {
		const tbody = document.getElementById('hedgingLedgerBody');
		if (!tbody) return;

		let html = '';
		let cumPV = 0;

		for (let yr = 1; yr <= years; yr++) {
			let yrPV = 0;
			for (let m = (yr - 1) * 12 + 1; m <= yr * 12; m++) {
				yrPV += monthlySip / Math.pow(1 + inflationRate, m / 12);
			}
			cumPV += yrPV;

			const unhedgedReal = p50Real[yr] || 0;
			const optionDragRupees = bsEnabled ? (unhedgedReal * dragCostPercent) : 0;
			const floorBenefit = bsEnabled ? Math.max(0, cumPV - unhedgedReal * 0.92) : 0;
			const netHedgedReal = bsEnabled ? Math.max(unhedgedReal - optionDragRupees, cumPV) : unhedgedReal;

			const zebraClass = yr % 2 === 0 ? 'bg-slate-50/70 dark:bg-zinc-900/90' : 'bg-white dark:bg-zinc-950';

			html += `
				<tr class="${zebraClass} hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors border-b border-slate-200/60 dark:border-white/10">
					<td class="py-2.5 px-3 text-left font-bold text-slate-800 dark:text-zinc-200">Yr ${yr}</td>
					<td class="py-2.5 px-3 text-right text-slate-600 dark:text-zinc-400">${formatRupee(cumPV)}</td>
					<td class="py-2.5 px-3 text-right font-medium text-slate-800 dark:text-zinc-200">${formatRupee(unhedgedReal)}</td>
					<td class="py-2.5 px-3 text-right ${bsEnabled ? 'text-rose-600 dark:text-rose-400 font-semibold' : 'text-slate-400 dark:text-zinc-600'}">
						${bsEnabled ? `-${formatRupee(optionDragRupees)} (${(dragCostPercent * 100).toFixed(2)}%)` : '₹ 0 (0.00%)'}
					</td>
					<td class="py-2.5 px-3 text-right ${floorBenefit > 0 ? 'text-emerald-600 dark:text-emerald-400 font-bold' : 'text-slate-400 dark:text-zinc-500'}">
						${floorBenefit > 0 ? `+${formatRupee(floorBenefit)}` : 'Floor Intact'}
					</td>
					<td class="py-2.5 px-3 text-right font-bold text-emerald-600 dark:text-emerald-400">${formatRupee(netHedgedReal)}</td>
				</tr>
			`;
		}

		tbody.innerHTML = html;
	}

	// Render Chart.js Canvas
	async function renderChart(horizonYears: number, p90: number[], p50: number[], p10: number[]) {
		const canvas = document.getElementById('sipChart') as HTMLCanvasElement;
		if (!canvas) return;

		const { Chart } = await import('chart.js/auto');

		if (sipChartInstance) {
			sipChartInstance.destroy();
			sipChartInstance = null;
		}

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const labels = Array.from({ length: horizonYears + 1 }, (_, i) => `Yr ${i}`);
		const isDark = document.documentElement.classList.contains('dark');

		const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : '#e2e8f0';
		const tickTextColor = isDark ? '#a1a1aa' : '#64748b';
		const expectedLineColor = isDark ? '#f4f4f5' : '#0f172a';

		sipChartInstance = new Chart(ctx, {
			type: 'line',
			data: {
				labels,
				datasets: [
					{
						label: '90th Bull Real TVM',
						data: p90,
						borderColor: isDark ? '#34d399' : '#059669',
						backgroundColor: isDark ? 'rgba(52, 211, 153, 0.04)' : 'rgba(5, 150, 105, 0.04)',
						borderWidth: 2,
						pointRadius: 0,
						tension: 0.35,
						fill: false
					},
					{
						label: '50th Expected Real TVM',
						data: p50,
						borderColor: expectedLineColor,
						backgroundColor: isDark ? 'rgba(244, 244, 245, 0.04)' : 'rgba(15, 23, 42, 0.04)',
						borderWidth: 2.5,
						pointRadius: 0,
						tension: 0.35,
						fill: false
					},
					{
						label: '10th Bear Real TVM',
						data: p10,
						borderColor: isDark ? '#f87171' : '#dc2626',
						backgroundColor: isDark ? 'rgba(248, 113, 113, 0.04)' : 'rgba(220, 38, 38, 0.04)',
						borderWidth: 2,
						pointRadius: 0,
						tension: 0.35,
						fill: false
					}
				]
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				animation: { duration: 200 },
				interaction: {
					mode: 'index',
					intersect: false,
				},
				plugins: {
					legend: { display: false },
					tooltip: {
						backgroundColor: isDark ? '#000000' : '#0f172a',
						borderColor: isDark ? 'rgba(255, 255, 255, 0.15)' : '#334155',
						borderWidth: 1,
						titleColor: '#f8fafc',
						bodyColor: '#e2e8f0',
						padding: 12,
						callbacks: {
							label: function (context: any) {
								const val = context.raw;
								let formatted = val;
								if (typeof val === 'number') {
									if (val >= 10000000) formatted = `₹ ${(val / 10000000).toFixed(2)} Cr`;
									else if (val >= 100000) formatted = `₹ ${(val / 100000).toFixed(2)} Lakh`;
									else formatted = `₹ ${Math.round(val).toLocaleString('en-IN')}`;
								}
								return ` ${context.dataset.label}: ${formatted}`;
							}
						}
					}
				},
				scales: {
					x: {
						grid: { color: gridColor },
						ticks: { color: tickTextColor, font: { family: 'Geist Mono, monospace', size: 11 } }
					},
					y: {
						grid: { color: gridColor },
						ticks: {
							color: tickTextColor,
							font: { family: 'Geist Mono, monospace', size: 11 },
							callback: function (val: any) {
								if (val >= 10000000) return `₹${(val / 10000000).toFixed(1)}Cr`;
								if (val >= 100000) return `₹${(val / 100000).toFixed(0)}L`;
								return `₹${val.toLocaleString('en-IN')}`;
							}
						}
					}
				}
			}
		});
	}

	// Initialization Setup
	document.addEventListener('DOMContentLoaded', () => {
		initSliders();
		initPresets();
		initTaxToggle();
		initModeSwitcher();
		initFaqFilter();
		runSimulation();

		const debouncedHandleCalculationTrigger = debounce(handleCalculationTrigger, 300);

		const runBtn = document.getElementById('runSipBtn');
		if (runBtn) {
			runBtn.addEventListener('click', debouncedHandleCalculationTrigger);
		}

		const toggle = document.getElementById('bsHedgingToggle');
		if (toggle) toggle.addEventListener('change', debouncedHandleCalculationTrigger);

		const exportCsvBtn = document.getElementById('exportCsvBtn');
		if (exportCsvBtn) exportCsvBtn.addEventListener('click', exportToCSV);

		const seedInput = document.getElementById('seedCapital');
		const sipInput = document.getElementById('monthlySip');
		const targetInput = document.getElementById('targetRealWealth');
		const stepUpInput = document.getElementById('stepUpRate');
		const yearsInput = document.getElementById('investmentYears');
		const infInput = document.getElementById('inflationRate');

		seedInput?.addEventListener('input', debouncedHandleCalculationTrigger);
		sipInput?.addEventListener('input', debouncedHandleCalculationTrigger);
		targetInput?.addEventListener('input', debouncedHandleCalculationTrigger);
		stepUpInput?.addEventListener('input', debouncedHandleCalculationTrigger);
		yearsInput?.addEventListener('input', debouncedHandleCalculationTrigger);
		infInput?.addEventListener('input', debouncedHandleCalculationTrigger);

		// Re-render chart on theme toggle event
		window.addEventListener('theme-changed', () => {
			debouncedHandleCalculationTrigger();
		});
	});
</script>

