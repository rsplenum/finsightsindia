				<div class="faq-card bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-xl p-5 sm:p-6 space-y-3.5 hover:border-slate-300 dark:hover:border-white/20 transition-all duration-200 ease-geist shadow-xs flex flex-col justify-between" data-category="inflation">
					<div class="space-y-2">
						<div class="flex items-center justify-between">
							<span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-widest bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
								LIQUIDITY FRICTIONS
							</span>
