							What happens if I miss a premium payment, and what is the Treadmill Effect?
						</h3>
						<p class="text-xs text-slate-600 dark:text-zinc-400 leading-relaxed font-sans">
							Stopping premium payments early triggers heavy surrender penalties (losing 50%–70% of capital). Furthermore, earning 6% yield against 6% inflation is running on a treadmill—locking up capital for 20 years to stay in the exact same place.
						</p>
					</div>
					<div class="pt-2 border-t border-slate-200/80 dark:border-white/10 bg-rose-500/5 dark:bg-rose-500/10 p-3 rounded-lg border-l-2 border-rose-500">
						<div class="text-[11px] font-mono font-bold text-rose-800 dark:text-rose-300 uppercase tracking-wide">💡 Key Takeaway</div>
						<div class="text-xs text-slate-700 dark:text-zinc-300 font-sans mt-0.5">Insurance lock-ins penalize early exit; always maintain flexible liquid investments.</div>
					</div>
				</div>

			</div>

		</section>

	</main>
</Layout>

<script>
	import { calculateXIRR } from '../utils/xirr.js';

	function formatRupeeShort(val: number) {
		if (isNaN(val)) return '₹0';
		const absVal = Math.abs(val);
		if (absVal >= 10000000) return `₹${(val / 10000000).toFixed(2)} Cr`;
		if (absVal >= 100000) return `₹${(val / 100000).toFixed(2)} Lakh`;
		return `₹${Math.round(val).toLocaleString('en-IN')}`;
	}

	// Auto-calculation: Sync risk costs from cover amounts
	function syncRiskCostsFromCover() {
		const termCover = parseFloat((document.getElementById('inTermCover') as HTMLInputElement)?.value || '0');
		const accidentCover = parseFloat((document.getElementById('inAccidentCover') as HTMLInputElement)?.value || '0');

		const termCostEl = document.getElementById('inTermCostOverride') as HTMLInputElement;
		const accidentCostEl = document.getElementById('inAccidentCostOverride') as HTMLInputElement;

		if (termCostEl) {
			termCostEl.value = Math.round((termCover / 1000000) * 1200).toString();
		}
		if (accidentCostEl) {
			accidentCostEl.value = Math.round((accidentCover / 1000000) * 1000).toString();
		}
	}

	// Core Analytical Engine: 3-Way Synthetic Replication
	function runReplicationAnalysis() {
		const toggleUnbundle = ((document.getElementById('unbundleToggle') || document.getElementById('toggleUnbundle')) as HTMLInputElement)?.checked ?? true;

		// 1. Gather Inputs
		const inputs = {
			premium: parseFloat((document.getElementById('inPremium') as HTMLInputElement)?.value) || 100000,
			ppt: parseInt((document.getElementById('inPPT') as HTMLInputElement)?.value) || 10,
			payoutStartYear: parseInt((document.getElementById('inPayoutStart') as HTMLInputElement)?.value) || 11,
			payoutYears: parseInt((document.getElementById('inPayoutYears') as HTMLInputElement)?.value) || 20,
			payoutAmount: parseFloat((document.getElementById('inPayout') as HTMLInputElement)?.value) || 120000,
			maturityBenefit: parseFloat((document.getElementById('inMaturity') as HTMLInputElement)?.value) || 1000000,
			inflationRate: parseFloat((document.getElementById('inInflation') as HTMLInputElement)?.value) || 6.0,
			safeRate: 7.1,
			equityRate: 12.0
		};

		// 2. Calculate Institutional Pure Insurance Costs
		let termCost = 0;
		let accidentCost = 0;

		if (toggleUnbundle) {
			termCost = parseFloat((document.getElementById('inTermCostOverride') as HTMLInputElement)?.value) || 0;
			accidentCost = parseFloat((document.getElementById('inAccidentCostOverride') as HTMLInputElement)?.value) || 0;
		}

		const totalRiskCost = termCost + accidentCost;
		const investableCapital = Math.max(0, inputs.premium - totalRiskCost);

		// 3. Build the 100-Year Unified Master Ledger (Resolving Overlaps)
		const payoutStartYear = inputs.payoutStartYear;
		const payoutEndYear = payoutStartYear + inputs.payoutYears - 1;
		const totalYears = Math.max(inputs.ppt, payoutEndYear);
		
		let ledger: any[] = [];
		let totalNominalPayout = 0;
		let totalRealPayout = 0;
		let cashFlowsForXirr: { amount: number; date: Date }[] = [];

		const startDate = new Date();

		for (let yr = 1; yr <= totalYears; yr++) {
			let yearPremium = (yr <= inputs.ppt) ? inputs.premium : 0;
			let yearPayout = (yr >= payoutStartYear && yr <= payoutEndYear) ? inputs.payoutAmount : 0;
			
			if (yr === payoutEndYear) {
				yearPayout += inputs.maturityBenefit;
			}

			let netCash = yearPayout - yearPremium;
			
			// NPV: Discounting for Purchasing Power
			let discountFactor = Math.pow(1 + (inputs.inflationRate / 100), yr);
			let realPayoutValue = yearPayout / discountFactor;

			totalNominalPayout += yearPayout;
			totalRealPayout += realPayoutValue;

			ledger.push({
				year: yr,
				premiumOut: yearPremium,
				payoutIn: yearPayout,
				net: netCash,
				realValue: realPayoutValue
			});

			// Push to XIRR Array
			let cfDate = new Date(startDate);
			cfDate.setFullYear(startDate.getFullYear() + (yr - 1));
			if (netCash !== 0) {
				cashFlowsForXirr.push({ amount: netCash, date: cfDate });
			}
		}

		// 4. Engine A: The Bundled Reality (Calculating True XIRR)
		const bundledXirrRaw = calculateXIRR(cashFlowsForXirr);
		const bundledXirr = bundledXirrRaw !== null ? bundledXirrRaw : 0; 

		// 5. Engine B & C: The Synthetic Arbitrage Simulators
		let balanceSafe = 0;
		let balanceEquity = 0;

		for (let yr = 1; yr <= totalYears; yr++) {
			let investableThisYear = (yr <= inputs.ppt) ? investableCapital : 0;
			let payoutDemandedThisYear = ledger[yr-1].payoutIn;

			// Grow start-of-year balance
			balanceSafe = balanceSafe * (1 + (inputs.safeRate / 100));
			balanceEquity = balanceEquity * (1 + (inputs.equityRate / 100));

			// Add new capital, subtract demanded payouts
			balanceSafe = balanceSafe + investableThisYear - payoutDemandedThisYear;
			balanceEquity = balanceEquity + investableThisYear - payoutDemandedThisYear;
		}

		return {
			engineA: {
				name: "The Bundled Policy",
				totalNominalPayout: totalNominalPayout,
				totalRealPayout: totalRealPayout,
				xirr: bundledXirr.toFixed(2) + '%'
			},
			engineB: {
				name: "DIY Safe (Term + PPF)",
				finalArbitrageProfit: balanceSafe,
				riskCostPaid: totalRiskCost * inputs.ppt
			},
			engineC: {
				name: "DIY Growth (Term + Equity)",
				finalArbitrageProfit: balanceEquity,
				riskCostPaid: totalRiskCost * inputs.ppt
			},
			ledger: ledger
		};
	}

	function updateDashboardUI() {
		const results = runReplicationAnalysis();

		// Engine A DOM Updates
		const engineAXirrEl = document.getElementById('engineAXIRR');
		const engineANominalEl = document.getElementById('engineANominal');
		const engineARealEl = document.getElementById('engineAReal');
		const xirrBadgeEl = document.getElementById('xirrHealthBadge');

		if (engineAXirrEl) engineAXirrEl.innerText = results.engineA.xirr;
		if (engineANominalEl) engineANominalEl.innerText = formatRupeeShort(results.engineA.totalNominalPayout);
		if (engineARealEl) engineARealEl.innerText = formatRupeeShort(results.engineA.totalRealPayout);

		const xirrNum = parseFloat(results.engineA.xirr);
		if (xirrBadgeEl) {
			if (xirrNum < 6.0) {
				xirrBadgeEl.innerText = 'LAGGING INFLATION';
				xirrBadgeEl.className = 'px-3 py-1 text-[10px] sm:text-xs font-bold uppercase tracking-wider rounded-full bg-rose-50 dark:bg-rose-900/30 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-700/50';
			} else if (xirrNum < 9.0) {
				xirrBadgeEl.innerText = 'MODERATE YIELD';
				xirrBadgeEl.className = 'px-3 py-1 text-[10px] sm:text-xs font-bold uppercase tracking-wider rounded-full bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-700/50';
			} else {
				xirrBadgeEl.innerText = 'HIGH YIELD';
				xirrBadgeEl.className = 'px-3 py-1 text-[10px] sm:text-xs font-bold uppercase tracking-wider rounded-full bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-700/50';
			}
		}

		// Engine B DOM Updates
		const engineBSurplusEl = document.getElementById('engineBSurplus');
		const engineBRiskCostEl = document.getElementById('valRiskCostB') || document.getElementById('engineBRiskCost');
		const engineBBadgeEl = document.getElementById('engineBBadge');
		const engineBTextEl = document.getElementById('engineBText');

		const safeProfit = results.engineB.finalArbitrageProfit;

		if (engineBSurplusEl) engineBSurplusEl.innerText = formatRupeeShort(safeProfit);
		if (engineBRiskCostEl) engineBRiskCostEl.innerText = formatRupeeShort(results.engineB.riskCostPaid);

		if (engineBBadgeEl && engineBTextEl) {
			if (safeProfit > 0) {
				engineBBadgeEl.innerText = 'DIY WINS';
				engineBBadgeEl.className = 'px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full shrink-0 mt-0.5 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-700/50';
				engineBTextEl.innerHTML = `By unbundling, you fund the exact same payouts and keep an extra <strong class="font-bold text-emerald-700 dark:text-emerald-300">${formatRupeeShort(safeProfit)}</strong> in surplus wealth.`;
			} else {
				engineBBadgeEl.innerText = 'POLICY WINS';
				engineBBadgeEl.className = 'px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full shrink-0 mt-0.5 bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-700/50';
				engineBTextEl.innerHTML = `This policy's yield beats the 7.1% safe government rate. DIY replication fails by <strong class="font-bold text-amber-700 dark:text-amber-300">${formatRupeeShort(Math.abs(safeProfit))}</strong>.`;
			}
		}

		// Engine C DOM Updates
		const engineCSurplusEl = document.getElementById('engineCSurplus');
		const engineCRiskCostEl = document.getElementById('valRiskCostC') || document.getElementById('engineCRiskCost');
		const engineCTextEl = document.getElementById('engineCText');

		const equityProfit = results.engineC.finalArbitrageProfit;

		if (engineCSurplusEl) engineCSurplusEl.innerText = formatRupeeShort(equityProfit);
		if (engineCRiskCostEl) engineCRiskCostEl.innerText = formatRupeeShort(results.engineC.riskCostPaid);

		if (engineCTextEl) {
			if (equityProfit > 0) {
				engineCTextEl.innerHTML = `By accepting equity volatility, you fund the exact same payouts and generate <strong class="font-bold text-indigo-700 dark:text-indigo-300">${formatRupeeShort(equityProfit)}</strong> in massive surplus wealth.`;
			} else {
				engineCTextEl.innerHTML = `The payouts demand too much cash too early. Sequence risk breaks the equity portfolio by <strong class="font-bold text-rose-600 dark:text-rose-400">${formatRupeeShort(Math.abs(equityProfit))}</strong>.`;
			}
		}

		// Takeaway text
		const takeawayEl = document.getElementById('replicationTakeaway');
		const toggleUnbundle = (document.getElementById('toggleUnbundle') as HTMLInputElement)?.checked ?? true;

		if (takeawayEl) {
			if (toggleUnbundle) {
				takeawayEl.innerText = `By unbundling insurance from investment, purchasing pure Term Life + Accident cover (${formatRupeeShort(results.engineB.riskCostPaid)} total risk cost), and investing the rest, DIY Equity leaves you with ${formatRupeeShort(results.engineC.finalArbitrageProfit)} in SURPLUS WEALTH after paying out all requested cash flows!`;
			} else {
				takeawayEl.innerText = `Without deducting any insurance cost, investing 100% of your premiums into DIY Equity leaves you with ${formatRupeeShort(results.engineC.finalArbitrageProfit)} in SURPLUS WEALTH after paying out all requested cash flows!`;
			}
		}

		// Calculate Hidden Frictions
		const inputPremium = parseFloat((document.getElementById('inPremium') as HTMLInputElement)?.value) || 100000;
		const inputPPT = parseInt((document.getElementById('inPPT') as HTMLInputElement)?.value) || 10;

		let totalGstPaid = 0;
		for (let yr = 1; yr <= inputPPT; yr++) {
			let gstRate = (yr === 1) ? 0.045 : 0.0225; // Standard Indian insurance GST proxy
			totalGstPaid += inputPremium * gstRate;
		}

		// Estimate First Year Agent Commission (~20% of Year 1 Premium)
		let estCommission = inputPremium * 0.20;

		// Find Real Break-Even Year (When cumulative real net cash turns positive)
		let breakEvenYear = "Never / Term";
		let cumulativeReal = 0;
		const ledger = results.ledger || [];
		for (let i = 0; i < ledger.length; i++) {
			cumulativeReal += ledger[i].realValue - ledger[i].premiumOut;
			if (cumulativeReal > 0) {
				breakEvenYear = `Year ${ledger[i].year}`;
				break;
			}
		}

		// Update DOM Elements for Hidden Frictions
		const frictionalGstEl = document.getElementById('frictionalGst');
		const frictionalCommissionEl = document.getElementById('frictionalCommission');
		const frictionalBreakEvenEl = document.getElementById('frictionalBreakEven');

		if (frictionalGstEl) frictionalGstEl.innerText = '₹ ' + Math.round(totalGstPaid).toLocaleString('en-IN');
		if (frictionalCommissionEl) frictionalCommissionEl.innerText = '₹ ' + Math.round(estCommission).toLocaleString('en-IN');
		if (frictionalBreakEvenEl) frictionalBreakEvenEl.innerText = breakEvenYear;
	}

	// Toggle Visibility Listeners
	const toggleUnbundleEl = (document.getElementById('unbundleToggle') || document.getElementById('toggleUnbundle')) as HTMLInputElement;
	const simpleRiskViewEl = document.getElementById('simpleRiskView');
	const btnAdvancedRiskEl = document.getElementById('advancedToggleBtn') || document.getElementById('btnAdvancedRisk');
	const advancedRiskViewEl = document.getElementById('advancedRiskView');

	if (toggleUnbundleEl && simpleRiskViewEl) {
		toggleUnbundleEl.addEventListener('change', () => {
			if (toggleUnbundleEl.checked) {
				simpleRiskViewEl.classList.remove('hidden');
			} else {
				simpleRiskViewEl.classList.add('hidden');
				if (advancedRiskViewEl) advancedRiskViewEl.classList.add('hidden');
			}
			updateDashboardUI();
		});
	}

	if (btnAdvancedRiskEl && advancedRiskViewEl) {
		btnAdvancedRiskEl.addEventListener('click', () => {
			advancedRiskViewEl.classList.toggle('hidden');
		});
	}

	// Simple View inputs sync listeners
	const inTermCoverEl = document.getElementById('inTermCover');
	const inAccidentCoverEl = document.getElementById('inAccidentCover');

	if (inTermCoverEl) {
		inTermCoverEl.addEventListener('input', () => {
			syncRiskCostsFromCover();
			updateDashboardUI();
		});
	}
	if (inAccidentCoverEl) {
		inAccidentCoverEl.addEventListener('input', () => {
			syncRiskCostsFromCover();
			updateDashboardUI();
		});
	}

	// Advanced Override View inputs listeners
	const inTermCostOverrideEl = document.getElementById('inTermCostOverride');
	const inAccidentCostOverrideEl = document.getElementById('inAccidentCostOverride');

	if (inTermCostOverrideEl) {
		inTermCostOverrideEl.addEventListener('input', updateDashboardUI);
	}
	if (inAccidentCostOverrideEl) {
		inAccidentCostOverrideEl.addEventListener('input', updateDashboardUI);
	}

	// Add event listeners for main policy inputs
	const inputIds = ['inPremium', 'inPPT', 'inPayoutStart', 'inPayoutYears', 'inPayout', 'inMaturity', 'inInflation'];
	inputIds.forEach(id => {
		const el = document.getElementById(id);
		if (el) {
			el.addEventListener('input', updateDashboardUI);
			el.addEventListener('change', updateDashboardUI);
		}
	});

	// FAQ Category Filter Handler
	function initFaqFilter() {
		const filterContainer = document.getElementById('faqFilterContainer');
		if (!filterContainer) return;

		const filterBtns = filterContainer.querySelectorAll('.faq-filter-btn');
		const faqCards = document.querySelectorAll('.faq-card');

		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const category = btn.getAttribute('data-faq-cat');

				filterBtns.forEach(b => {
					b.className = 'faq-filter-btn px-3 py-1.5 rounded-md text-xs font-mono font-bold uppercase tracking-wider transition-all duration-200 bg-transparent text-slate-600 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-200 cursor-pointer whitespace-nowrap';
				});

				btn.className = 'faq-filter-btn px-3 py-1.5 rounded-md text-xs font-mono font-bold uppercase tracking-wider transition-all duration-200 bg-slate-900 text-white dark:bg-white dark:text-black cursor-pointer shadow-xs whitespace-nowrap';

				faqCards.forEach(card => {
					const cardCat = card.getAttribute('data-category');
					if (category === 'all' || cardCat === category) {
						(card as HTMLElement).style.display = 'flex';
					} else {
						(card as HTMLElement).style.display = 'none';
					}
				});
			});
		});
	}

	// Initial execution
	document.addEventListener('DOMContentLoaded', () => {
		initFaqFilter();
		syncRiskCostsFromCover();
		updateDashboardUI();
	});
	syncRiskCostsFromCover();
	updateDashboardUI();
</script>
