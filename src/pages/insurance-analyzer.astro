---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Guaranteed Income ROI Analyzer — SWP Intelligence">
	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
		
		<!-- Centered Funnel Hero Header -->
		<section class="max-w-4xl mx-auto px-4 flex flex-col items-center text-center mb-12">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-100 dark:bg-zinc-900 text-slate-900 dark:text-zinc-100 text-xs font-semibold tracking-wider uppercase mb-6 border border-slate-200 dark:border-zinc-800">
				Smart Policy Reality Check
			</div>
			<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900 dark:text-zinc-100 mt-4">
				Guaranteed Income ROI Analyzer
			</h1>
			<p class="text-base sm:text-lg text-slate-500 dark:text-zinc-400 font-normal leading-relaxed max-w-2xl mt-3">
				Unmask the true annualized yield (XIRR), inflation-adjusted real purchasing power, and DIY term replication arbitrage of traditional insurance policies.
			</p>
		</section>

		<!-- How This Intelligence Engine Works - 3-Step Explainer Guide -->
		<div class="bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 rounded-xl p-6 md:p-8 mb-10 max-w-7xl mx-auto">
			<div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
				<div class="flex items-center gap-2">
					<div class="w-2 h-2 rounded-full bg-slate-900 dark:bg-white"></div>
					<h2 class="text-lg font-bold tracking-tight text-slate-900 dark:text-zinc-100">How This Intelligence Engine Works</h2>
				</div>
				<!-- Fixed Contrast on Subtitle -->
				<span class="text-xs font-mono text-slate-500 dark:text-zinc-400 tracking-wider uppercase">3-Step Breakdown</span>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Step 1 -->
				<div class="bg-slate-50 dark:bg-zinc-900 rounded-lg p-5 border border-slate-200 dark:border-zinc-800">
					<div class="flex items-center gap-3 mb-3">
						<span class="px-2 py-0.5 rounded-md bg-slate-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-100 text-xs font-bold font-mono">01</span>
						<h3 class="text-sm font-bold tracking-tight text-slate-900 dark:text-zinc-100 uppercase">Map the Cash Flow</h3>
					</div>
					<p class="text-sm text-slate-500 dark:text-zinc-400 leading-relaxed">You input the premiums you pay and the payouts you are promised. We strip away the marketing jargon to build a raw timeline.</p>
				</div>
				<!-- Step 2 -->
				<div class="bg-slate-50 dark:bg-zinc-900 rounded-lg p-5 border border-slate-200 dark:border-zinc-800">
					<div class="flex items-center gap-3 mb-3">
						<span class="px-2 py-0.5 rounded-md bg-slate-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-100 text-xs font-bold font-mono">02</span>
						<h3 class="text-sm font-bold tracking-tight text-slate-900 dark:text-zinc-100 uppercase">Calculate Real Value</h3>
					</div>
					<p class="text-sm text-slate-500 dark:text-zinc-400 leading-relaxed">We discount future payouts against inflation (NPV). A ₹10 Lakh payout in 20 years is mathematically worth far less today. We show you the true purchasing power.</p>
				</div>
				<!-- Step 3 -->
				<div class="bg-slate-50 dark:bg-zinc-900 rounded-lg p-5 border border-slate-200 dark:border-zinc-800">
					<div class="flex items-center gap-3 mb-3">
						<span class="px-2 py-0.5 rounded-md bg-slate-200 dark:bg-zinc-800 text-slate-900 dark:text-zinc-100 text-xs font-bold font-mono">03</span>
						<h3 class="text-sm font-bold tracking-tight text-slate-900 dark:text-zinc-100 uppercase">Unbundle & Replicate</h3>
					</div>
					<p class="text-sm text-slate-500 dark:text-zinc-400 leading-relaxed">We unbundle the life cover from the investment. We mathematically test if it's cheaper to buy pure term insurance and invest the rest yourself in PPF or Equity.</p>
				</div>
			</div>
		</div>

		<!-- Main 2-Column Grid Layout -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-7xl mx-auto">
			
			<!-- Left Column: Input Control Panel (5 Cols) -->
			<div class="lg:col-span-5 bg-white dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 rounded-xl p-6 space-y-6">
				
				<div class="border-b border-slate-200 dark:border-zinc-800 pb-4">
					<h2 class="text-lg font-bold tracking-tight text-slate-900 dark:text-zinc-100">Policy & Risk Inputs</h2>
					<p class="text-sm text-slate-500 dark:text-zinc-400 mt-1 leading-relaxed">Enter premium schedules, payout parameters, and term cover proxies.</p>
				</div>

				<div class="space-y-4">

					<!-- Input 1: Annual Premium Paid (₹) -->
					<div>
						<div class="flex justify-between items-center mb-1">
							<div class="relative group inline-flex items-center gap-1.5 cursor-pointer">
								<label for="inPremium" class="text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer">
									Annual Premium Paid (₹)
								</label>
								<svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
								<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-800 text-white text-xs rounded-lg p-3 w-64 shadow-xl transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
									The exact gross amount leaving your bank account every year. Include GST if applicable.
								</div>
							</div>
							<span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">Policy Outflow</span>
						</div>
						<div class="relative">
							<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm">₹</span>
							<input 
								type="number" 
								id="inPremium" 
								value="100000" 
								min="1000" 
								step="5000"
								class="w-full pl-8 pr-4 py-2.5 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-semibold text-sm focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist"
							/>
						</div>
					</div>

					<!-- Input 2: Premium Payment Term (PPT) -->
					<div>
						<div class="flex justify-between items-center mb-1">
							<div class="relative group inline-flex items-center gap-1.5 cursor-pointer">
								<label for="inPPT" class="text-xs font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
									Premium Payment Term (Years)
								</label>
								<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
								<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
									The total number of years you are contractually required to pay premiums (e.g., 10 or 12 years).
								</div>
							</div>
							<span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-zinc-500">PPT</span>
						</div>
						<input 
							type="number" 
							id="inPPT" 
							value="10" 
							min="1" 
							max="50"
							class="w-full px-4 py-2.5 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-semibold text-sm focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist"
						/>
					</div>

					<!-- Input 3: Income Payout Start Year -->
					<div>
						<div class="flex justify-between items-center mb-1">
							<div class="relative group inline-flex items-center gap-1.5 cursor-pointer">
								<label for="inPayoutStart" class="text-xs font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
									Payout Start Year (Policy Year)
								</label>
								<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
								<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
									The exact policy year when money starts flowing back into your bank account. For immediate income, set to 1. For deferred income, set to PPT + 1.
								</div>
							</div>
							<span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Deferral</span>
						</div>
						<input 
							type="number" 
							id="inPayoutStart" 
							value="11" 
							min="1" 
							max="50"
							step="1"
							class="w-full px-4 py-2.5 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-semibold text-sm focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist"
						/>
						<p class="text-[10px] text-slate-400 dark:text-zinc-500 mt-1">The exact year the income payouts begin (e.g., Type '2' if cashbacks start in the 2nd year).</p>
					</div>

					<!-- Income Payout Duration (Years) -->
					<div>
						<div class="flex justify-between items-center mb-1">
							<div class="relative group inline-flex items-center gap-1.5 cursor-pointer">
								<label for="inPayoutYears" class="text-xs font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
									Income Payout Duration
								</label>
								<svg class="w-3.5 h-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-zinc-200 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
									The total number of years you will receive the guaranteed regular income stream.
								</div>
							</div>
							<span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Payout Years</span>
						</div>
						<input 
							type="number" 
							id="inPayoutYears" 
							value="20" 
							min="1" 
							max="50"
							step="1"
							class="w-full px-4 py-2.5 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-semibold text-sm focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist"
						/>
					</div>

					<!-- Annual Income Received (₹) -->
					<div>
						<div class="flex justify-between items-center mb-1">
							<div class="relative group inline-flex items-center gap-1.5 cursor-pointer">
								<label for="inPayout" class="text-xs font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
									Annual Income Received (₹)
								</label>
								<svg class="w-3.5 h-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-zinc-200 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
									The recurring yearly payout amount promised by the policy.
								</div>
							</div>
							<span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Inflow / Year</span>
						</div>
						<div class="relative">
							<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm">₹</span>
							<input 
								type="number" 
								id="inPayout" 
								value="120000" 
								min="0" 
								step="5000"
								class="w-full pl-8 pr-4 py-2.5 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-semibold text-sm focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist"
							/>
						</div>
					</div>

					<!-- Terminal Maturity Benefit (₹) -->
					<div>
						<div class="flex justify-between items-center mb-1">
							<div class="relative group inline-flex items-center gap-1.5 cursor-pointer">
								<label for="inMaturity" class="text-xs font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
									Terminal Maturity Benefit (₹)
								</label>
								<svg class="w-3.5 h-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-zinc-200 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
									The final lump-sum bonus paid at the very end of the policy. (Often framed as 'Return of Premium'). Type 0 if there is no final bonus.
								</div>
							</div>
							<span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Lump-Sum at End</span>
						</div>
						<div class="relative">
							<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm">₹</span>
							<input 
								type="number" 
								id="inMaturity" 
								value="1000000" 
								min="0" 
								step="50000"
								class="w-full pl-8 pr-4 py-2.5 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-semibold text-sm focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist"
							/>
						</div>
					</div>

					<!-- Inflation Rate (%) -->
					<div>
						<div class="flex justify-between items-center mb-1">
							<div class="relative group inline-flex items-center gap-1.5 cursor-pointer">
								<label for="inInflation" class="text-xs font-semibold text-slate-700 dark:text-zinc-300 cursor-pointer">
									Inflation Rate (%)
								</label>
								<svg class="w-3.5 h-3.5 text-slate-400 hover:text-slate-600 dark:hover:text-zinc-200 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
								<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
									The expected annual increase in the cost of living. The engine uses this to discount future payouts, revealing exactly what that money will buy in today's purchasing power.
								</div>
							</div>
							<span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Purchasing Power Drag</span>
						</div>
						<input 
							type="number" 
							id="inInflation" 
							value="6.0" 
							min="0" 
							max="20"
							step="0.5"
							class="w-full px-4 py-2.5 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-md text-slate-900 dark:text-zinc-100 font-semibold text-sm focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist"
						/>
					</div>

					<!-- Hybrid Input: Unbundle Insurance Costs Section -->
					<div class="border-t border-slate-200 dark:border-zinc-800 pt-4 space-y-4">
						
						<!-- Master Toggle Header & Advanced Gear Button -->
						<div class="flex items-center justify-between bg-slate-50 dark:bg-zinc-900 p-4 rounded-lg border border-slate-200 dark:border-zinc-800 gap-3">
							<div class="flex items-center gap-3 min-w-0">
								<label class="relative inline-flex items-center cursor-pointer shrink-0">
									<input type="checkbox" id="unbundleToggle" class="sr-only peer" checked>
									<div class="w-11 h-6 bg-slate-300 dark:bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-slate-900 dark:peer-checked:bg-white"></div>
								</label>
								<!-- Removed truncate, added min-w-0 to allow text wrapping -->
								<div class="flex flex-col min-w-0">
									<span class="text-sm font-bold tracking-tight text-slate-900 dark:text-zinc-100">Unbundle Costs</span>
									<span class="text-xs sm:text-sm text-slate-500 dark:text-zinc-400 leading-snug mt-0.5">Deduct pure term & rider premiums</span>
								</div>
							</div>
							<button type="button" id="advancedToggleBtn" class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-slate-700 dark:text-zinc-300 bg-transparent hover:bg-slate-200/60 dark:hover:bg-zinc-800 rounded-md transition-all duration-200 ease-geist border border-slate-200 dark:border-zinc-800 cursor-pointer">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
								Advanced
							</button>
						</div>

						<!-- Simple View (Visible when Unbundle toggle is ON) -->
						<div id="simpleRiskView" class="space-y-3.5">
							<!-- Life Cover Amount (₹) -->
							<div>
								<div class="flex justify-between items-center mb-1">
									<label for="inTermCover" class="text-xs font-semibold text-slate-700 dark:text-zinc-300">
										Life Cover Amount (₹)
									</label>
									<span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Death Benefit</span>
								</div>
								<div class="relative">
									<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm">₹</span>
									<input 
										type="number" 
										id="inTermCover" 
										value="10000000" 
										min="0" 
										step="1000000"
										class="w-full pl-8 pr-4 py-2.5 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-md text-slate-900 dark:text-zinc-100 font-semibold text-sm focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist"
									/>
								</div>
							</div>

							<!-- Accident Cover Amount (₹) -->
							<div>
								<div class="flex justify-between items-center mb-1">
									<label for="inAccidentCover" class="text-xs font-semibold text-slate-700 dark:text-zinc-300">
										Accident Cover Amount (₹)
									</label>
									<span class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Rider</span>
								</div>
								<div class="relative">
									<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm">₹</span>
									<input 
										type="number" 
										id="inAccidentCover" 
										value="5000000" 
										min="0" 
										step="1000000"
