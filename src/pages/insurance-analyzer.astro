---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardPremium from '../components/CardPremium.astro';
import InputGroup from '../components/InputGroup.astro';
import SectionTitle from '../components/SectionTitle.astro';
import InsuranceAnswer from '../components/Calculators/InsuranceAnswer.astro';
---

<Layout title="Guaranteed Income ROI Analyzer — SWP Intelligence">
	<Hero 
		badge="Smart Policy Reality Check"
		title="Guaranteed Income ROI Analyzer"
		description="Unmask the true annualized yield (XIRR), inflation-adjusted real purchasing power, and DIY term replication arbitrage of traditional insurance policies."
	/>

	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-16 sm:pt-6 sm:pb-24 space-y-8">
		
		<!--
			Layer 1. The answer, before the machinery that produced it.
			The page used to open with a three-step description of our own engine,
			which is not the question the reader arrived with (dd-002). That card
			still exists, moved below the analysis - nothing is deleted to make a
			screen simpler (dd-001).
		-->
		<InsuranceAnswer />

		<!-- Main 2-Column Grid Layout -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-7xl mx-auto">
			
			<!-- Left Column: Input Control Panel (5 Cols) -->
			<CardPremium glass={true} class="lg:col-span-5 space-y-6">
				
				<div class="border-b border-navy-200 dark:border-navy-800 pb-4">
					<SectionTitle title="Policy & Risk Inputs" />
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-1 leading-relaxed">Enter premium schedules, payout parameters, and term cover proxies.</p>
				</div>

				<div class="space-y-4">
					<InputGroup 
						id="inPremium"
						label="Annual Premium Paid"
						tooltip="The exact gross amount leaving your bank account every year. Include GST if applicable."
						prefix="₹"
						suffix="Policy Outflow"
						value="1,00,000"
					/>

					<div class="grid grid-cols-2 gap-4">
						<InputGroup 
							id="inPPT"
							label="Premium Payment Term"
							tooltip="The total number of years you are contractually required to pay premiums (e.g., 10 or 12 years)."
							suffix="Years"
							type="number"
							value="10"
						/>
						<InputGroup 
							id="inPayoutStart"
							label="Payout Start Year"
							tooltip="The exact policy year when money starts flowing back into your bank account."
							suffix="Policy Yr"
							type="number"
							value="11"
						/>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<InputGroup 
							id="inPayoutYears"
							label="Income Payout Duration"
							tooltip="The total number of years you will receive the guaranteed regular income stream."
							suffix="Years"
							type="number"
							value="20"
						/>
						<InputGroup 
							id="inInflation"
							label="Inflation Rate"
							tooltip="The expected annual increase in the cost of living."
							suffix="%"
							type="number"
							value="6.0"
						/>
					</div>

					<InputGroup 
						id="inPayout"
						label="Annual Income Received"
						tooltip="The recurring yearly payout amount promised by the policy."
						prefix="₹"
						suffix="Inflow / Year"
						value="1,20,000"
					/>

					<InputGroup 
						id="inMaturity"
						label="Terminal Maturity Benefit"
						tooltip="The final lump-sum bonus paid at the very end of the policy. Type 0 if there is no final bonus."
						prefix="₹"
						suffix="Lump-Sum at End"
						value="10,00,000"
					/>

					<hr class="section-divider" />

					<!-- Hybrid Input: Unbundle Insurance Costs Section -->
					<div class="space-y-4">
						<div class="flex items-center justify-between bg-navy-50 dark:bg-navy-900 p-4 rounded-lg border border-navy-200 dark:border-navy-800 gap-3">
							<div class="flex items-center gap-3 min-w-0">
								<label class="relative inline-flex items-center cursor-pointer shrink-0">
									<input type="checkbox" id="unbundleToggle" class="sr-only peer" checked>
									<div class="w-11 h-6 bg-navy-300 dark:bg-navy-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-navy-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-navy-900 dark:peer-checked:bg-white"></div>
								</label>
								<div class="flex flex-col min-w-0">
									<span class="text-sm font-bold tracking-tight text-navy-900 dark:text-navy-100">Unbundle Costs</span>
									<span class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">Deduct pure term & rider premiums</span>
								</div>
							</div>
							<button type="button" id="advancedToggleBtn" class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-navy-700 dark:text-navy-300 bg-transparent hover:bg-navy-200/60 dark:hover:bg-navy-800 rounded transition-all duration-200 border border-navy-200 dark:border-navy-800 cursor-pointer">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
								Advanced
							</button>
						</div>

						<div id="simpleRiskView" class="space-y-4">
							<InputGroup 
								id="inTermCover"
								label="Life Cover Amount"
								tooltip="The death benefit promised by the insurance policy."
								prefix="₹"
								suffix="Death Benefit"
								value="1,00,00,000"
							/>
							<InputGroup 
								id="inAccidentCover"
								label="Accident Cover Amount"
								tooltip="The accidental death or disability rider amount."
								prefix="₹"
								suffix="Rider"
								value="50,00,000"
							/>
						</div>

						<div id="advancedRiskView" class="hidden p-4 bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg space-y-4">
							<div class="text-[10px] font-bold text-navy-900 dark:text-navy-100 uppercase tracking-widest">
								Actuarial Premium Overrides
							</div>
							<InputGroup 
								id="inTermCostOverride"
								label="Annual Term Premium"
								tooltip="The open market cost of pure term insurance for this cover amount."
								prefix="₹"
								suffix="Term Cost"
								value="12,000"
							/>
							<InputGroup 
								id="inAccidentCostOverride"
								label="Annual Accident Premium"
								tooltip="The open market cost of an accident rider."
								prefix="₹"
								suffix="Rider Cost"
								value="5,000"
							/>
						</div>

					</div>

				</div>
			</CardPremium>

			<!-- Right Column: Dashboard (7 Cols) -->
			<div class="lg:col-span-7 space-y-6">
				
				<!-- Engine A: The Insurance Policy's Promise -->
				<CardPremium glass={true} class="space-y-5">
					<div class="flex items-center justify-between border-b border-navy-200 dark:border-navy-800 pb-4">
						<div>
							<h3 class="text-xs font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">1. The Insurance Policy's Promise</h3>
							<p class="text-xs text-navy-500 dark:text-navy-400 mt-1 leading-relaxed">What you actually get after accounting for inflation.</p>
						</div>
						<div id="xirrHealthBadge" class="badge-warning">EVALUATING</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
						<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-4 border border-navy-200 dark:border-navy-800">
							<div class="text-xs font-semibold text-navy-500 dark:text-navy-400 uppercase tracking-widest">True Yield (XIRR)</div>
							<div id="engineAXIRR" class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 font-sans tracking-tight mt-1">0.00%</div>
						</div>
						<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-4 border border-navy-200 dark:border-navy-800">
							<div class="text-xs font-semibold text-navy-500 dark:text-navy-400 uppercase tracking-widest">Total paid out<span class="block font-normal normal-case tracking-normal text-[10px] text-navy-400 dark:text-navy-500">in the rupees of each year</span></div>
							<div id="engineANominal" class="text-xl font-bold text-navy-900 dark:text-navy-100 font-sans mt-2">₹0</div>
						</div>
						<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-4 border border-navy-200 dark:border-navy-800">
							<div class="text-xs font-semibold text-amber-600 dark:text-amber-400 uppercase tracking-widest">The same money<span class="block font-normal normal-case tracking-normal text-[10px] text-amber-600/70 dark:text-amber-400/70">in today’s prices</span></div>
							<div id="engineAReal" class="text-xl font-bold text-amber-600 dark:text-amber-400 font-sans mt-2">₹0</div>
						</div>
					</div>
				</CardPremium>

				<!-- Engine B & Engine C: Synthetic Arbitrage Replication Pillars -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
					
					<!-- Engine B: The Safe DIY Route -->
					<CardPremium glass={true} class="flex flex-col h-full space-y-4">
						<div class="flex items-start justify-between mb-4 border-b border-navy-100 dark:border-navy-800 pb-3">
							<div>
								<h3 class="text-xs font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">2. The Safe DIY Route</h3>
								<p class="text-[10px] uppercase font-bold tracking-widest text-navy-500 dark:text-navy-400 mt-1">Term Life + Govt Bonds</p>
							</div>
							<div id="engineBBadge" class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-widest rounded bg-navy-100 dark:bg-navy-800 text-navy-600 dark:text-navy-400">--</div>
						</div>
						<!--
							The heading, the figure, the colour and the badge are all written
							from ONE verdict now. They used to be four independent decisions
							about one fact, and they disagreed: -₹11.08 lakh printed in
							emerald green under the word "Surplus" beside a badge saying
							POLICY WINS.
						-->
						<div>
							<div id="engineBLabel" class="text-xs font-semibold text-navy-500 dark:text-navy-400 uppercase tracking-widest">Left over at the end</div>
							<div id="engineBSurplus" class="text-2xl font-extrabold text-navy-900 dark:text-navy-100 mt-1">₹0</div>
							<div id="engineBSurplusReal" class="text-xs font-semibold text-navy-500 dark:text-navy-400 mt-0.5">&nbsp;</div>
							<p id="engineBText" class="text-xs text-navy-600 dark:text-navy-400 mt-3 leading-relaxed">Evaluating the bond route…</p>
						</div>
						<div class="mt-auto pt-4 border-t border-navy-100 dark:border-navy-800 w-full">
							<div class="flex items-center justify-between w-full">
								<span class="text-xs font-medium text-navy-500 dark:text-navy-400">Term Insurance Paid:</span>
								<span class="text-xs font-bold text-rose-600 dark:text-rose-400" id="valRiskCostB">₹0</span>
							</div>
						</div>
					</CardPremium>

					<!-- Engine C: The Growth DIY Route -->
					<CardPremium glass={true} class="flex flex-col h-full space-y-4">
						<div class="flex items-start justify-between mb-4 border-b border-navy-100 dark:border-navy-800 pb-3">
							<div>
								<h3 class="text-xs font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">3. The Growth DIY Route</h3>
								<p class="text-[10px] uppercase font-bold tracking-widest text-navy-500 dark:text-navy-400 mt-1">Term Life + Index Funds</p>
							</div>
							<!-- dd-007: two routes shown as equals. Only one of them used to carry a badge. -->
							<div id="engineCBadge" class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-widest rounded bg-navy-100 dark:bg-navy-800 text-navy-600 dark:text-navy-400">--</div>
						</div>
						<div>
							<div id="engineCLabel" class="text-xs font-semibold text-navy-500 dark:text-navy-400 uppercase tracking-widest">Left over at the end</div>
							<div id="engineCSurplus" class="text-2xl font-extrabold text-navy-900 dark:text-navy-100 mt-1">₹0</div>
							<div id="engineCSurplusReal" class="text-xs font-semibold text-navy-500 dark:text-navy-400 mt-0.5">&nbsp;</div>
							<p id="engineCText" class="text-xs text-navy-600 dark:text-navy-400 mt-3 leading-relaxed">Evaluating the index-fund route…</p>
						</div>
						<div class="mt-auto pt-4 border-t border-navy-100 dark:border-navy-800 w-full space-y-2">
							<div class="flex items-center justify-between w-full">
								<span class="text-xs font-medium text-navy-500 dark:text-navy-400">Term Insurance Paid:</span>
								<span class="text-xs font-bold text-rose-600 dark:text-rose-400" id="valRiskCostC">₹0</span>
							</div>
							<div class="flex items-center justify-between w-full pb-1">
								<span class="text-xs font-medium text-navy-500 dark:text-navy-400">Est. 12.5% LTCG Tax Drag:</span>
								<span class="text-xs font-bold text-rose-600 dark:text-rose-400" id="valTaxDragC">-₹0</span>
							</div>
						</div>
					</CardPremium>

				</div>

				<div class="p-4 bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg text-xs text-navy-600 dark:text-navy-400 leading-relaxed space-y-1">
					<strong class="font-bold text-navy-900 dark:text-navy-100 block uppercase tracking-widest text-[10px]">The Bottom Line:</strong>
					<p id="replicationTakeaway" class="block mt-1">
						By unbundling insurance from investment, purchasing pure Term Life + Accident cover, and investing the rest, you fund the exact same income payouts while keeping substantial surplus wealth.
					</p>
				</div>

				<div class="relative w-full h-[250px] bg-white dark:bg-navy-950 border border-navy-200 dark:border-navy-800 rounded-lg p-4 flex flex-col justify-center">
					<h4 class="text-[10px] uppercase font-bold tracking-widest text-navy-500 dark:text-navy-400 mb-2">Net Cash Flow Profile</h4>
					<div class="flex-1 w-full relative">
						<canvas id="cashflowChart" class="w-full h-full"></canvas>
					</div>
				</div>

			</div>
		</div>

		<!--
			The machinery, below the answer it produces. Moved rather than removed:
			a reader who wants to know how the comparison is built still gets the
			whole of it, one layer down (dd-001).
		-->
		<!-- How This Intelligence Engine Works - 3-Step Explainer Guide -->
		<CardPremium glass={true} class="mb-10 max-w-7xl mx-auto">
			<div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4 border-b border-navy-200 dark:border-navy-800 pb-4">
				<SectionTitle title="How This Intelligence Engine Works" />
				<span class="text-[10px] font-bold text-navy-500 dark:text-navy-400 tracking-widest uppercase">3-Step Breakdown</span>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Step 1 -->
				<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-6 border border-navy-200 dark:border-navy-800">
					<div class="flex items-center gap-3 mb-4">
						<span class="px-2.5 py-1 rounded-md bg-navy-200 dark:bg-navy-800 text-navy-900 dark:text-navy-100 text-xs font-bold font-mono">01</span>
						<h3 class="text-sm font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">Map the Cash Flow</h3>
					</div>
					<p class="text-sm text-navy-600 dark:text-navy-300 leading-relaxed">You input the premiums you pay and the payouts you are promised. We strip away the marketing jargon to build a raw timeline.</p>
				</div>
				<!-- Step 2 -->
				<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-6 border border-navy-200 dark:border-navy-800">
					<div class="flex items-center gap-3 mb-4">
						<span class="px-2.5 py-1 rounded-md bg-navy-200 dark:bg-navy-800 text-navy-900 dark:text-navy-100 text-xs font-bold font-mono">02</span>
						<h3 class="text-sm font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">Calculate Real Value</h3>
					</div>
					<p class="text-sm text-navy-600 dark:text-navy-300 leading-relaxed">We discount future payouts against inflation (NPV). A ₹10 Lakh payout in 20 years is mathematically worth far less today. We show you the true purchasing power.</p>
				</div>
				<!-- Step 3 -->
				<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-6 border border-navy-200 dark:border-navy-800">
					<div class="flex items-center gap-3 mb-4">
						<span class="px-2.5 py-1 rounded-md bg-navy-200 dark:bg-navy-800 text-navy-900 dark:text-navy-100 text-xs font-bold font-mono">03</span>
						<h3 class="text-sm font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">Unbundle & Replicate</h3>
					</div>
					<p class="text-sm text-navy-600 dark:text-navy-300 leading-relaxed">We unbundle the life cover from the investment. We mathematically test if it's cheaper to buy pure term insurance and invest the rest yourself in PPF or Equity.</p>
				</div>
			</div>
		</CardPremium>

		<!-- Hidden Frictions X-Ray Panel -->
		<CardPremium glass={true} class="max-w-7xl mx-auto mt-8">
			<SectionTitle title="Hidden Policy Frictions (The X-Ray)" />
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
				<!-- Card 1: GST Capital Leakage -->
				<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 flex flex-col justify-between">
					<div>
						<span class="text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">Total GST Tax Drag</span>
						<div id="frictionalGst" class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-2">₹0</div>
					</div>
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-2 leading-relaxed">Government tax deducted from gross premiums (~4.5% Year 1, ~2.25% thereafter).</p>
				</div>
				<!-- Card 2: Real Break-Even Year -->
				<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 flex flex-col justify-between">
					<div>
						<span class="text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">Real Break-Even Year</span>
						<div id="frictionalBreakEven" class="text-xl font-bold text-amber-600 dark:text-amber-400 mt-2">Year --</div>
					</div>
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-2 leading-relaxed">The exact year inflation-adjusted purchasing power crosses back into positive territory.</p>
				</div>
				<!-- Card 3: Agent Commission Estimate -->
				<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 flex flex-col justify-between">
					<div>
						<span class="text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">Est. Agent Commission</span>
						<div id="frictionalCommission" class="text-xl font-bold text-purple-600 dark:text-purple-400 mt-2">₹0</div>
					</div>
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-2 leading-relaxed">Estimated first-year distribution kickback built into traditional policy structures (~20%).</p>
				</div>
			</div>
		</CardPremium>

		<!-- Sensitivity Check: Assumption Fragility -->
		<CardPremium glass={true} class="max-w-7xl mx-auto mt-8">
			<SectionTitle title="Sensitivity Check: Assumption Fragility" />
			<p class="text-xs text-navy-500 dark:text-navy-400 mt-2 mb-4 leading-relaxed">
				The index-fund route above assumes markets deliver their long-run average. They may not. Here is the same comparison at returns either side of it — and note that a lower return does not just leave less over, it can mean the income stops arriving at all.
			</p>
			<div class="overflow-x-auto rounded-lg border border-navy-200 dark:border-navy-800">
				<table class="w-full text-xs text-left whitespace-nowrap">
					<thead class="bg-navy-100 dark:bg-navy-900 text-navy-600 dark:text-navy-300 font-semibold uppercase tracking-wider text-[10px]">
						<tr>
							<th class="px-4 py-2.5">Equity CAGR</th>
							<th class="px-4 py-2.5 text-right">Left over at the end</th>
							<th class="px-4 py-2.5 text-right">Did it fund the promise?</th>
						</tr>
					</thead>
					<tbody id="insuranceSensitivityBody" class="divide-y divide-navy-100 dark:divide-navy-800 bg-white/50 dark:bg-navy-950/50 font-mono">
						<!-- populated by JS -->
					</tbody>
				</table>
			</div>
		</CardPremium>

	</main>
</Layout>

<script>
	import {
		formatShortRupee,
		tableFormatter,
		setupFormattingField
	} from '../utils/formatters';
	import { analyseReplication, verdictFor, type LedgerRow, type RouteResult } from '../utils/insuranceReplication';
	import { readPolicyInputs, isUnbundling, syncRiskCostsFromCover } from '../utils/insuranceInputs';

	// This file is a view. The arithmetic lives in insuranceReplication.ts and
	// the form is read only by insuranceInputs.ts; nothing below computes a
	// figure of its own. sol-039.

	let cashflowChartInstance: any = null;

	async function renderCashflowChart(ledger: LedgerRow[]) {
		const canvas = document.getElementById('cashflowChart') as HTMLCanvasElement;
		if (!canvas) return;

		const { Chart } = await import('chart.js/auto');

		if (cashflowChartInstance) {
			cashflowChartInstance.destroy();
			cashflowChartInstance = null;
		}

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const labels = ledger.map(l => `Yr ${l.year}`);
		const data = ledger.map(l => Math.sign(l.net) * Math.sqrt(Math.abs(l.net)));
		const bgColors = data.map(val => val < 0 ? 'rgba(244, 63, 94, 0.8)' : 'rgba(16, 185, 129, 0.8)'); // Rose-500 for out, Emerald-500 for in

		const isDark = document.documentElement.classList.contains('dark');
		const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : '#e2e8f0';
		const tickTextColor = isDark ? '#a1a1aa' : '#64748b';

		cashflowChartInstance = new Chart(ctx, {
			type: 'bar',
			data: {
				labels,
				datasets: [{
					label: 'Net Cash Flow',
					data,
					backgroundColor: bgColors,
					borderRadius: 4
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				plugins: {
					legend: { display: false },
					tooltip: {
						callbacks: {
							label: (ctx) => ` ${formatShortRupee(ledger[ctx.dataIndex].net)}`
						}
					}
				},
				scales: {
					x: { grid: { display: false }, ticks: { color: tickTextColor, font: { size: 10 } } },
					y: {
						grid: { color: gridColor },
						ticks: { 
							color: tickTextColor, font: { size: 10 },
							callback: (val) => formatShortRupee(Math.sign(val as number) * Math.pow(val as number, 2))
						}
					}
				}
			}
		});
	}

	/** The one place a verdict becomes words and colours. */
	function renderRoute(spec: {
		route: RouteResult;
		labelEl: string; figureEl: string; realEl: string;
		badgeEl: string; textEl: string; riskCostEl: string;
		fundedLine: string; shortLine: string;
	}) {
		const v = verdictFor(spec.route);
		const el = (id: string) => document.getElementById(id);

		const good = 'text-emerald-600 dark:text-emerald-400';
		const bad = 'text-rose-600 dark:text-rose-400';

		const labelEl = el(spec.labelEl);
		const figureEl = el(spec.figureEl);
		const realEl = el(spec.realEl);
		const badgeEl = el(spec.badgeEl);
		const textEl = el(spec.textEl);
		const riskEl = el(spec.riskCostEl);

		if (riskEl) riskEl.innerText = formatShortRupee(spec.route.riskCostPaid);

		if (v.kind === 'shortfall') {
			if (labelEl) labelEl.innerText = 'Promised income it could not pay';
			if (figureEl) {
				figureEl.innerText = formatShortRupee(v.unfunded);
				figureEl.className = `text-2xl font-extrabold mt-1 ${bad}`;
			}
			if (realEl) realEl.innerText = `${formatShortRupee(v.unfundedReal)} in today's prices`;
			if (badgeEl) {
				badgeEl.innerText = `RUNS OUT · YEAR ${v.exhaustedInYear}`;
				badgeEl.className = 'badge-danger';
			}
			if (textEl) textEl.innerText = spec.shortLine;
			return;
		}

		if (labelEl) labelEl.innerText = 'Left over at the end';
		if (figureEl) {
			figureEl.innerText = formatShortRupee(v.kind === 'surplus' ? v.amount : 0);
			figureEl.className = `text-2xl font-extrabold mt-1 ${good}`;
		}
		if (realEl) {
			realEl.innerText = v.kind === 'surplus'
				? `${formatShortRupee(v.amountReal)} in today's prices`
				: 'nothing meaningful left over';
		}
		if (badgeEl) {
			badgeEl.innerText = 'FUNDS THE PROMISE';
			badgeEl.className = 'badge-safe';
		}
		if (textEl) textEl.innerText = spec.fundedLine;
	}

	/**
	 * Layer 1. The comparison the whole page reduces to, in one sentence.
	 *
	 * The growth route is the one the headline speaks for, because it is the
	 * route a person unbundling would actually take - the safe route is the
	 * floor beneath it and keeps its own card.
	 */
	function renderAnswer(r: ReturnType<typeof analyseReplication>) {
		const el = (id: string) => document.getElementById(id);
		const v = verdictFor(r.growth);
		const set = (id: string, text: string) => { const e = el(id); if (e) e.innerText = text; };

		const badge = el('answerBadge');
		const headline = el('answerHeadline');
		const figureLabel = el('answerFigureLabel');
		const nominal = el('answerFigureNominal');
		const real = el('answerFigureReal');

		const good = 'text-emerald-600 dark:text-emerald-400';
		const bad = 'text-rose-600 dark:text-rose-400';
		const figureClass = 'text-2xl font-extrabold tracking-tight ';

		if (v.kind === 'shortfall') {
			if (badge) {
				badge.innerText = 'KEEP THE POLICY';
				badge.className = 'badge-warning';
			}
			if (headline) {
				headline.innerHTML = `This policy pays back more than you could replicate on your own. `
					+ `Buying the cover separately and investing the rest runs out of money in `
					+ `<strong class="font-bold ${bad}">year ${v.exhaustedInYear}</strong>, `
					+ `leaving <strong class="font-bold ${bad}">${formatShortRupee(v.unfunded)}</strong> `
					+ `of the promised income unpaid.`;
			}
			set('answerFigureLabel', 'Income the DIY route could not pay');
			if (nominal) { nominal.innerText = formatShortRupee(v.unfunded); nominal.className = figureClass + bad; }
			if (real) { real.innerText = formatShortRupee(v.unfundedReal); real.className = figureClass + bad; }
		} else {
			const amount = v.kind === 'surplus' ? v.amount : 0;
			const amountReal = v.kind === 'surplus' ? v.amountReal : 0;
			if (badge) {
				badge.innerText = 'UNBUNDLE IT';
				badge.className = 'badge-safe';
			}
			if (headline) {
				headline.innerHTML = `Buy the cover on its own and invest the difference. `
					+ `You collect the same income this policy promises, in the same years, and finish with `
					+ `<strong class="font-bold ${good}">${formatShortRupee(amount)}</strong> more — `
					+ `<strong class="font-bold ${good}">${formatShortRupee(amountReal)}</strong> in today's prices.`;
			}
			set('answerFigureLabel', 'Left over at the end');
			if (nominal) { nominal.innerText = formatShortRupee(amount); nominal.className = figureClass + good; }
			if (real) { real.innerText = formatShortRupee(amountReal); real.className = figureClass + good; }
		}

		set('answerYield', r.policy.xirrPct.toFixed(2) + '%');
		set('answerYieldNote',
			`Against ${r.inputs.inflationRate}% inflation, ${r.inputs.safeRate}% on government bonds `
			+ `and ${r.inputs.equityRate}% assumed on index funds.`);

		const cover = r.riskCostPaid;
		set('answerCoverCost', formatShortRupee(cover));
		set('answerCoverNote', cover > 0
			? `Over ${r.inputs.ppt} years, for the same life and accident cover — bought separately, at market rates.`
			: 'Nothing. Unbundling is switched off, so this comparison buys no protection at all and is not like for like.');

		set('answerPremiumDecay',
			`Your premium is fixed at ${formatShortRupee(r.inputs.premium)} a year for ${r.inputs.ppt} years. `
			+ `The policy never raises it, so the last instalment costs you `
			+ `${formatShortRupee(r.policy.lastPremiumReal)} in today's prices — the commitment gets lighter every year, `
			+ `and so does what it buys.`);
	}

	function updateDashboardUI() {
		const results = analyseReplication(readPolicyInputs());

		const engineAXirrEl = document.getElementById('engineAXIRR');
		const engineANominalEl = document.getElementById('engineANominal');
		const engineARealEl = document.getElementById('engineAReal');
		const xirrBadgeEl = document.getElementById('xirrHealthBadge');

		// The badge judges the number the reader can actually see, not a fuller
		// precision one behind it. dd-013: one quantity, one value.
		const xirrShown = results.policy.xirrPct.toFixed(2);
		const xirrNum = parseFloat(xirrShown);

		if (engineAXirrEl) engineAXirrEl.innerText = xirrShown + '%';
		if (engineANominalEl) engineANominalEl.innerText = formatShortRupee(results.policy.totalNominalPayout);
		if (engineARealEl) engineARealEl.innerText = formatShortRupee(results.policy.totalRealPayout);

		if (xirrBadgeEl) {
			if (xirrNum < 6.0) {
				xirrBadgeEl.innerText = 'LAGGING INFLATION';
				xirrBadgeEl.className = 'badge-danger';
			} else if (xirrNum < 9.0) {
				xirrBadgeEl.innerText = 'MODERATE YIELD';
				xirrBadgeEl.className = 'badge-warning';
			} else {
				xirrBadgeEl.innerText = 'HIGH YIELD';
				xirrBadgeEl.className = 'badge-safe';
			}
		}

		// ONE verdict per route, rendered everywhere. `verdictFor` decides whether
		// a route funded the promise; the card's heading, figure, colour, badge and
		// sentence all follow from that single answer, and the bottom line reads
		// the same one. Nothing below inspects the sign of a number for itself.
		renderRoute({
			route: results.safe,
			labelEl: 'engineBLabel',
			figureEl: 'engineBSurplus',
			realEl: 'engineBSurplusReal',
			badgeEl: 'engineBBadge',
			textEl: 'engineBText',
			riskCostEl: 'valRiskCostB',
			fundedLine: 'Buying the cover separately and putting the rest in government bonds funds every rupee this policy promises.',
			shortLine: `Government bonds at ${results.inputs.safeRate}% cannot keep up with this policy — it pays back more than they earn.`,
		});

		renderRoute({
			route: results.growth,
			labelEl: 'engineCLabel',
			figureEl: 'engineCSurplus',
			realEl: 'engineCSurplusReal',
			badgeEl: 'engineCBadge',
			textEl: 'engineCText',
			riskCostEl: 'valRiskCostC',
			fundedLine: 'Buying the cover separately and putting the rest in index funds funds every rupee this policy promises.',
			shortLine: 'The income is demanded faster than the fund can grow into it — the early payouts come out before the compounding has happened.',
		});

		const engineCTaxDragEl = document.getElementById('valTaxDragC');
		if (engineCTaxDragEl) engineCTaxDragEl.innerText = `-${formatShortRupee(results.growth.taxDrag)}`;

		renderAnswer(results);

		const takeawayEl = document.getElementById('replicationTakeaway');
		if (takeawayEl) {
			const v = verdictFor(results.growth);
			const premise = isUnbundling()
				? `Buying the same life and accident cover on the open market costs ${formatShortRupee(results.riskCostPaid)} over ${results.inputs.ppt} years. Put what is left of each premium into index funds and`
				: `Unbundling is switched off, so this buys no cover at all and is not a like-for-like comparison. On that basis,`;

			const outcome = v.kind === 'shortfall'
				? `the money still runs out — in year ${v.exhaustedInYear}, leaving ${formatShortRupee(v.unfunded)} of the promised income unpaid.`
				: v.kind === 'surplus'
					? `you fund every rupee this policy promises, finishing with ${formatShortRupee(v.amount)} over — ${formatShortRupee(v.amountReal)} in today's prices.`
					: `you fund every rupee this policy promises, with nothing meaningful left over.`;

			takeawayEl.innerText = `${premise} ${outcome}`;
		}

		const ledger = results.ledger;
		const breakEvenYear = results.policy.breakEvenYear;

		const frictionalGstEl = document.getElementById('frictionalGst');
		const frictionalCommissionEl = document.getElementById('frictionalCommission');
		const frictionalBreakEvenEl = document.getElementById('frictionalBreakEven');

		if (frictionalGstEl) frictionalGstEl.innerText = tableFormatter.format(Math.round(results.frictions.gstPaid));
		if (frictionalCommissionEl) frictionalCommissionEl.innerText = tableFormatter.format(Math.round(results.frictions.estCommission));
		if (frictionalBreakEvenEl) frictionalBreakEvenEl.innerText = breakEvenYear === null ? 'Never / Term' : `Year ${breakEvenYear}`;

		const sensBody = document.getElementById('insuranceSensitivityBody');
		if (sensBody) {
			let tbodyHtml = '';
			// Same verdict, same words as the cards above. A row that runs out
			// reports the YEAR it ran out and what went unpaid - it used to report a
			// negative balance, which is how the table came to tell the reader that
			// a higher return left them worse off.
			results.sensitivity.forEach((row) => {
				const isBaseline = row.isBaseline;
				const highlight = isBaseline ? 'bg-gold-50 dark:bg-gold-900/20 font-bold' : '';
				const v = row.verdict;
				const good = 'text-emerald-600 dark:text-emerald-400';
				const bad = 'text-rose-600 dark:text-rose-400';

				const leftOver = v.kind === 'shortfall' ? '—' : formatShortRupee(row.surplus);
				const outcomeClass = v.tone === 'good' ? good : bad;
				// The rupee figure lives in the column beside this one; repeating it
				// here says nothing the reader cannot already see (dd-009).
				const outcomeText = v.kind === 'shortfall'
					? `Runs out in year ${v.exhaustedInYear} · ${formatShortRupee(v.unfunded)} unpaid`
					: 'Funds every rupee promised';

				tbodyHtml += `<tr class="${highlight}">
					<td class="px-4 py-2.5 ${isBaseline ? 'text-gold-600 dark:text-gold-400' : 'text-navy-700 dark:text-navy-300'}">${row.rate}% ${isBaseline ? '<span class="font-sans text-[10px] ml-1">(Your Input)</span>' : ''}</td>
					<td class="px-4 py-2.5 text-right ${isBaseline ? 'text-gold-600 dark:text-gold-400' : 'text-navy-900 dark:text-navy-100'}">${leftOver}</td>
					<td class="px-4 py-2.5 text-right ${outcomeClass}">${outcomeText}</td>
				</tr>`;
			});
			sensBody.innerHTML = tbodyHtml;
		}

        // Render Chart
        renderCashflowChart(ledger);
	}

	document.addEventListener('DOMContentLoaded', () => {
		['inPremium', 'inPayout', 'inMaturity', 'inTermCover', 'inAccidentCover', 'inTermCostOverride', 'inAccidentCostOverride'].forEach(id => {
			const el = document.getElementById(id);
			if (el) setupFormattingField(el as HTMLInputElement, updateDashboardUI);
		});

		const toggleUnbundleEl = document.getElementById('unbundleToggle') as HTMLInputElement;
		const simpleRiskViewEl = document.getElementById('simpleRiskView');
		const btnAdvancedRiskEl = document.getElementById('advancedToggleBtn');
		const advancedRiskViewEl = document.getElementById('advancedRiskView');

		if (toggleUnbundleEl && simpleRiskViewEl) {
			toggleUnbundleEl.addEventListener('change', () => {
				if (toggleUnbundleEl.checked) simpleRiskViewEl.classList.remove('hidden');
				else { simpleRiskViewEl.classList.add('hidden'); advancedRiskViewEl?.classList.add('hidden'); }
				updateDashboardUI();
			});
		}

		if (btnAdvancedRiskEl && advancedRiskViewEl) {
			btnAdvancedRiskEl.addEventListener('click', () => advancedRiskViewEl.classList.toggle('hidden'));
		}

		['inTermCover', 'inAccidentCover'].forEach(id => {
			document.getElementById(id)?.addEventListener('input', () => { syncRiskCostsFromCover(); updateDashboardUI(); });
		});

		['inPPT', 'inPayoutStart', 'inPayoutYears', 'inInflation'].forEach(id => {
			const el = document.getElementById(id);
			if (el) { el.addEventListener('input', updateDashboardUI); el.addEventListener('change', updateDashboardUI); }
		});

		syncRiskCostsFromCover();
		updateDashboardUI();
	});
</script>
