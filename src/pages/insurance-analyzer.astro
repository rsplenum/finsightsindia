---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardPremium from '../components/CardPremium.astro';
import InputGroup from '../components/InputGroup.astro';
import SectionTitle from '../components/SectionTitle.astro';
---

<Layout title="Guaranteed Income ROI Analyzer — SWP Intelligence">
	<Hero 
		badge="Smart Policy Reality Check"
		title="Guaranteed Income ROI Analyzer"
		description="Unmask the true annualized yield (XIRR), inflation-adjusted real purchasing power, and DIY term replication arbitrage of traditional insurance policies."
	/>

	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-16 sm:pt-6 sm:pb-24 space-y-8">
		
		<!-- How This Intelligence Engine Works - 3-Step Explainer Guide -->
		<CardPremium class="mb-10 max-w-7xl mx-auto">
			<div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4 border-b border-navy-200 dark:border-navy-800 pb-4">
				<SectionTitle title="How This Intelligence Engine Works" />
				<span class="text-[10px] font-bold text-navy-500 dark:text-navy-400 tracking-widest uppercase">3-Step Breakdown</span>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Step 1 -->
				<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-6 border border-navy-200 dark:border-navy-800">
					<div class="flex items-center gap-3 mb-4">
						<span class="px-2.5 py-1 rounded-md bg-navy-200 dark:bg-navy-800 text-navy-900 dark:text-navy-100 text-xs font-bold font-mono">01</span>
						<h3 class="text-sm font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">Map the Cash Flow</h3>
					</div>
					<p class="text-sm text-navy-600 dark:text-navy-300 leading-relaxed">You input the premiums you pay and the payouts you are promised. We strip away the marketing jargon to build a raw timeline.</p>
				</div>
				<!-- Step 2 -->
				<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-6 border border-navy-200 dark:border-navy-800">
					<div class="flex items-center gap-3 mb-4">
						<span class="px-2.5 py-1 rounded-md bg-navy-200 dark:bg-navy-800 text-navy-900 dark:text-navy-100 text-xs font-bold font-mono">02</span>
						<h3 class="text-sm font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">Calculate Real Value</h3>
					</div>
					<p class="text-sm text-navy-600 dark:text-navy-300 leading-relaxed">We discount future payouts against inflation (NPV). A ₹10 Lakh payout in 20 years is mathematically worth far less today. We show you the true purchasing power.</p>
				</div>
				<!-- Step 3 -->
				<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-6 border border-navy-200 dark:border-navy-800">
					<div class="flex items-center gap-3 mb-4">
						<span class="px-2.5 py-1 rounded-md bg-navy-200 dark:bg-navy-800 text-navy-900 dark:text-navy-100 text-xs font-bold font-mono">03</span>
						<h3 class="text-sm font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">Unbundle & Replicate</h3>
					</div>
					<p class="text-sm text-navy-600 dark:text-navy-300 leading-relaxed">We unbundle the life cover from the investment. We mathematically test if it's cheaper to buy pure term insurance and invest the rest yourself in PPF or Equity.</p>
				</div>
			</div>
		</CardPremium>

		<!-- Main 2-Column Grid Layout -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-7xl mx-auto">
			
			<!-- Left Column: Input Control Panel (5 Cols) -->
			<CardPremium class="lg:col-span-5 space-y-6">
				
				<div class="border-b border-navy-200 dark:border-navy-800 pb-4">
					<SectionTitle title="Policy & Risk Inputs" />
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-1 leading-relaxed">Enter premium schedules, payout parameters, and term cover proxies.</p>
				</div>

				<div class="space-y-4">
					<InputGroup 
						id="inPremium"
						label="Annual Premium Paid"
						tooltip="The exact gross amount leaving your bank account every year. Include GST if applicable."
						prefix="₹"
						suffix="Policy Outflow"
						value="1,00,000"
					/>

					<div class="grid grid-cols-2 gap-4">
						<InputGroup 
							id="inPPT"
							label="Premium Payment Term"
							tooltip="The total number of years you are contractually required to pay premiums (e.g., 10 or 12 years)."
							suffix="Years"
							type="number"
							value="10"
						/>
						<InputGroup 
							id="inPayoutStart"
							label="Payout Start Year"
							tooltip="The exact policy year when money starts flowing back into your bank account."
							suffix="Policy Yr"
							type="number"
							value="11"
						/>
					</div>

					<div class="grid grid-cols-2 gap-4">
						<InputGroup 
							id="inPayoutYears"
							label="Income Payout Duration"
							tooltip="The total number of years you will receive the guaranteed regular income stream."
							suffix="Years"
							type="number"
							value="20"
						/>
						<InputGroup 
							id="inInflation"
							label="Inflation Rate"
							tooltip="The expected annual increase in the cost of living."
							suffix="%"
							type="number"
							value="6.0"
						/>
					</div>

					<InputGroup 
						id="inPayout"
						label="Annual Income Received"
						tooltip="The recurring yearly payout amount promised by the policy."
						prefix="₹"
						suffix="Inflow / Year"
						value="1,20,000"
					/>

					<InputGroup 
						id="inMaturity"
						label="Terminal Maturity Benefit"
						tooltip="The final lump-sum bonus paid at the very end of the policy. Type 0 if there is no final bonus."
						prefix="₹"
						suffix="Lump-Sum at End"
						value="10,00,000"
					/>

					<hr class="section-divider" />

					<!-- Hybrid Input: Unbundle Insurance Costs Section -->
					<div class="space-y-4">
						<div class="flex items-center justify-between bg-navy-50 dark:bg-navy-900 p-4 rounded-lg border border-navy-200 dark:border-navy-800 gap-3">
							<div class="flex items-center gap-3 min-w-0">
								<label class="relative inline-flex items-center cursor-pointer shrink-0">
									<input type="checkbox" id="unbundleToggle" class="sr-only peer" checked>
									<div class="w-11 h-6 bg-navy-300 dark:bg-navy-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-navy-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-navy-900 dark:peer-checked:bg-white"></div>
								</label>
								<div class="flex flex-col min-w-0">
									<span class="text-sm font-bold tracking-tight text-navy-900 dark:text-navy-100">Unbundle Costs</span>
									<span class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">Deduct pure term & rider premiums</span>
								</div>
							</div>
							<button type="button" id="advancedToggleBtn" class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-navy-700 dark:text-navy-300 bg-transparent hover:bg-navy-200/60 dark:hover:bg-navy-800 rounded transition-all duration-200 border border-navy-200 dark:border-navy-800 cursor-pointer">
								<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
								Advanced
							</button>
						</div>

						<div id="simpleRiskView" class="space-y-4">
							<InputGroup 
								id="inTermCover"
								label="Life Cover Amount"
								tooltip="The death benefit promised by the insurance policy."
								prefix="₹"
								suffix="Death Benefit"
								value="1,00,00,000"
							/>
							<InputGroup 
								id="inAccidentCover"
								label="Accident Cover Amount"
								tooltip="The accidental death or disability rider amount."
								prefix="₹"
								suffix="Rider"
								value="50,00,000"
							/>
						</div>

						<div id="advancedRiskView" class="hidden p-4 bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg space-y-4">
							<div class="text-[10px] font-bold text-navy-900 dark:text-navy-100 uppercase tracking-widest">
								Actuarial Premium Overrides
							</div>
							<InputGroup 
								id="inTermCostOverride"
								label="Annual Term Premium"
								tooltip="The open market cost of pure term insurance for this cover amount."
								prefix="₹"
								suffix="Term Cost"
								value="12,000"
							/>
							<InputGroup 
								id="inAccidentCostOverride"
								label="Annual Accident Premium"
								tooltip="The open market cost of an accident rider."
								prefix="₹"
								suffix="Rider Cost"
								value="5,000"
							/>
						</div>

					</div>

				</div>
			</CardPremium>

			<!-- Right Column: Dashboard (7 Cols) -->
			<div class="lg:col-span-7 space-y-6">
				
				<!-- Engine A: The Insurance Policy's Promise -->
				<CardPremium class="space-y-5">
					<div class="flex items-center justify-between border-b border-navy-200 dark:border-navy-800 pb-4">
						<div>
							<h3 class="text-xs font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">1. The Insurance Policy's Promise</h3>
							<p class="text-xs text-navy-500 dark:text-navy-400 mt-1 leading-relaxed">What you actually get after accounting for inflation.</p>
						</div>
						<div id="xirrHealthBadge" class="badge-warning">EVALUATING</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
						<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-4 border border-navy-200 dark:border-navy-800">
							<div class="text-xs font-semibold text-navy-500 dark:text-navy-400 uppercase tracking-widest">True Yield (XIRR)</div>
							<div id="engineAXIRR" class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 font-sans tracking-tight mt-1">0.00%</div>
						</div>
						<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-4 border border-navy-200 dark:border-navy-800">
							<div class="text-xs font-semibold text-navy-500 dark:text-navy-400 uppercase tracking-widest">Nominal Payout</div>
							<div id="engineANominal" class="text-xl font-bold text-navy-900 dark:text-navy-100 font-sans mt-2">₹0</div>
						</div>
						<div class="bg-navy-50 dark:bg-navy-900 rounded-lg p-4 border border-navy-200 dark:border-navy-800">
							<div class="text-xs font-semibold text-amber-600 dark:text-amber-400 uppercase tracking-widest">Inflation Real Value</div>
							<div id="engineAReal" class="text-xl font-bold text-amber-600 dark:text-amber-400 font-sans mt-2">₹0</div>
						</div>
					</div>
				</CardPremium>

				<!-- Engine B & Engine C: Synthetic Arbitrage Replication Pillars -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
					
					<!-- Engine B: The Safe DIY Route -->
					<CardPremium class="flex flex-col h-full space-y-4">
						<div class="flex items-start justify-between mb-4 border-b border-navy-100 dark:border-navy-800 pb-3">
							<div>
								<h3 class="text-xs font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">2. The Safe DIY Route</h3>
								<p class="text-[10px] uppercase font-bold tracking-widest text-navy-500 dark:text-navy-400 mt-1">Term Life + Govt Bonds</p>
							</div>
							<div id="engineBBadge" class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-widest rounded bg-navy-100 dark:bg-navy-800 text-navy-600 dark:text-navy-400">--</div>
						</div>
						<div>
							<div class="text-xs font-semibold text-navy-500 dark:text-navy-400 uppercase tracking-widest">Surplus Wealth / Deficit</div>
							<div id="engineBSurplus" class="text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1">₹0</div>
							<p id="engineBText" class="text-xs text-navy-600 dark:text-navy-400 mt-3 leading-relaxed">Evaluating risk-free arbitrage...</p>
						</div>
						<div class="mt-auto pt-4 border-t border-navy-100 dark:border-navy-800 w-full">
							<div class="flex items-center justify-between w-full">
								<span class="text-xs font-medium text-navy-500 dark:text-navy-400">Term Insurance Paid:</span>
								<span class="text-xs font-bold text-rose-600 dark:text-rose-400" id="valRiskCostB">₹0</span>
							</div>
						</div>
					</CardPremium>

					<!-- Engine C: The Growth DIY Route -->
					<CardPremium class="flex flex-col h-full space-y-4">
						<div class="flex items-start justify-between mb-4 border-b border-navy-100 dark:border-navy-800 pb-3">
							<div>
								<h3 class="text-xs font-bold tracking-widest text-navy-900 dark:text-navy-100 uppercase">3. The Growth DIY Route</h3>
								<p class="text-[10px] uppercase font-bold tracking-widest text-navy-500 dark:text-navy-400 mt-1">Term Life + Index Funds</p>
							</div>
						</div>
						<div>
							<div class="text-xs font-semibold text-navy-500 dark:text-navy-400 uppercase tracking-widest">Surplus Wealth / Deficit</div>
							<div id="engineCSurplus" class="text-2xl font-extrabold text-indigo-600 dark:text-indigo-400 mt-1">₹0</div>
							<p id="engineCText" class="text-xs text-navy-600 dark:text-navy-400 mt-3 leading-relaxed">Evaluating equity volatility arbitrage...</p>
						</div>
						<div class="mt-auto pt-4 border-t border-navy-100 dark:border-navy-800 w-full space-y-2">
							<div class="flex items-center justify-between w-full">
								<span class="text-xs font-medium text-navy-500 dark:text-navy-400">Term Insurance Paid:</span>
								<span class="text-xs font-bold text-rose-600 dark:text-rose-400" id="valRiskCostC">₹0</span>
							</div>
							<div class="flex items-center justify-between w-full pb-1">
								<span class="text-xs font-medium text-navy-500 dark:text-navy-400">Est. 12.5% LTCG Tax Drag:</span>
								<span class="text-xs font-bold text-rose-600 dark:text-rose-400" id="valTaxDragC">-₹0</span>
							</div>
						</div>
					</CardPremium>

				</div>

				<div class="p-4 bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg text-xs text-navy-600 dark:text-navy-400 leading-relaxed space-y-1">
					<strong class="font-bold text-navy-900 dark:text-navy-100 block uppercase tracking-widest text-[10px]">The Bottom Line:</strong>
					<p id="replicationTakeaway" class="block mt-1">
						By unbundling insurance from investment, purchasing pure Term Life + Accident cover, and investing the rest, you fund the exact same income payouts while keeping substantial surplus wealth.
					</p>
				</div>

				<div class="relative w-full h-[250px] bg-white dark:bg-navy-950 border border-navy-200 dark:border-navy-800 rounded-lg p-4 flex flex-col justify-center">
					<h4 class="text-[10px] uppercase font-bold tracking-widest text-navy-500 dark:text-navy-400 mb-2">Net Cash Flow Profile</h4>
					<div class="flex-1 w-full relative">
						<canvas id="cashflowChart" class="w-full h-full"></canvas>
					</div>
				</div>

			</div>
		</div>

		<!-- Hidden Frictions X-Ray Panel -->
		<CardPremium class="max-w-7xl mx-auto mt-8">
			<SectionTitle title="Hidden Policy Frictions (The X-Ray)" />
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
				<!-- Card 1: GST Capital Leakage -->
				<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 flex flex-col justify-between">
					<div>
						<span class="text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">Total GST Tax Drag</span>
						<div id="frictionalGst" class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-2">₹0</div>
					</div>
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-2 leading-relaxed">Government tax deducted from gross premiums (~4.5% Year 1, ~2.25% thereafter).</p>
				</div>
				<!-- Card 2: Real Break-Even Year -->
				<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 flex flex-col justify-between">
					<div>
						<span class="text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">Real Break-Even Year</span>
						<div id="frictionalBreakEven" class="text-xl font-bold text-amber-600 dark:text-amber-400 mt-2">Year --</div>
					</div>
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-2 leading-relaxed">The exact year inflation-adjusted purchasing power crosses back into positive territory.</p>
				</div>
				<!-- Card 3: Agent Commission Estimate -->
				<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 flex flex-col justify-between">
					<div>
						<span class="text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">Est. Agent Commission</span>
						<div id="frictionalCommission" class="text-xl font-bold text-purple-600 dark:text-purple-400 mt-2">₹0</div>
					</div>
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-2 leading-relaxed">Estimated first-year distribution kickback built into traditional policy structures (~20%).</p>
				</div>
			</div>
		</CardPremium>

	</main>
</Layout>

<script>
	import { calculateXIRR } from '../utils/xirr';
	import { 
		parseFormattedNumber, 
		formatShortRupee, 
		tableFormatter, 
		setupFormattingField 
	} from '../utils/formatters';

	let cashflowChartInstance: any = null;

	async function renderCashflowChart(ledger: any[]) {
		const canvas = document.getElementById('cashflowChart') as HTMLCanvasElement;
		if (!canvas) return;

		const { Chart } = await import('chart.js/auto');

		if (cashflowChartInstance) {
			cashflowChartInstance.destroy();
			cashflowChartInstance = null;
		}

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const labels = ledger.map(l => `Yr ${l.year}`);
		const data = ledger.map(l => Math.sign(l.net) * Math.sqrt(Math.abs(l.net)));
		const bgColors = data.map(val => val < 0 ? 'rgba(244, 63, 94, 0.8)' : 'rgba(16, 185, 129, 0.8)'); // Rose-500 for out, Emerald-500 for in

		const isDark = document.documentElement.classList.contains('dark');
		const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : '#e2e8f0';
		const tickTextColor = isDark ? '#a1a1aa' : '#64748b';

		cashflowChartInstance = new Chart(ctx, {
			type: 'bar',
			data: {
				labels,
				datasets: [{
					label: 'Net Cash Flow',
					data,
					backgroundColor: bgColors,
					borderRadius: 4
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				plugins: {
					legend: { display: false },
					tooltip: {
						callbacks: {
							label: (ctx) => ` ${formatShortRupee(ledger[ctx.dataIndex].net)}`
						}
					}
				},
				scales: {
					x: { grid: { display: false }, ticks: { color: tickTextColor, font: { size: 10 } } },
					y: {
						grid: { color: gridColor },
						ticks: { 
							color: tickTextColor, font: { size: 10 },
							callback: (val) => formatShortRupee(Math.sign(val as number) * Math.pow(val as number, 2))
						}
					}
				}
			}
		});
	}

	function syncRiskCostsFromCover() {
		const termCover = parseFormattedNumber((document.getElementById('inTermCover') as HTMLInputElement)?.value || '0');
		const accidentCover = parseFormattedNumber((document.getElementById('inAccidentCover') as HTMLInputElement)?.value || '0');

		const termCostEl = document.getElementById('inTermCostOverride') as HTMLInputElement;
		const accidentCostEl = document.getElementById('inAccidentCostOverride') as HTMLInputElement;

		if (termCostEl) termCostEl.value = Math.round((termCover / 1000000) * 1200).toLocaleString('en-IN');
		if (accidentCostEl) accidentCostEl.value = Math.round((accidentCover / 1000000) * 1000).toLocaleString('en-IN');
	}

	function runReplicationAnalysis() {
		const toggleUnbundle = ((document.getElementById('unbundleToggle')) as HTMLInputElement)?.checked ?? true;

		const inputs = {
			premium: parseFormattedNumber((document.getElementById('inPremium') as HTMLInputElement)?.value) || 100000,
			ppt: parseInt((document.getElementById('inPPT') as HTMLInputElement)?.value) || 10,
			payoutStartYear: parseInt((document.getElementById('inPayoutStart') as HTMLInputElement)?.value) || 11,
			payoutYears: parseInt((document.getElementById('inPayoutYears') as HTMLInputElement)?.value) || 20,
			payoutAmount: parseFormattedNumber((document.getElementById('inPayout') as HTMLInputElement)?.value) || 120000,
			maturityBenefit: parseFormattedNumber((document.getElementById('inMaturity') as HTMLInputElement)?.value) || 1000000,
			inflationRate: parseFloat((document.getElementById('inInflation') as HTMLInputElement)?.value) || 6.0,
			safeRate: 7.1,
			equityRate: 12.0
		};

		let termCost = 0;
		let accidentCost = 0;

		if (toggleUnbundle) {
			termCost = parseFormattedNumber((document.getElementById('inTermCostOverride') as HTMLInputElement)?.value) || 0;
			accidentCost = parseFormattedNumber((document.getElementById('inAccidentCostOverride') as HTMLInputElement)?.value) || 0;
		}

		const totalRiskCost = termCost + accidentCost;
		const investableCapital = Math.max(0, inputs.premium - totalRiskCost);

		const payoutStartYear = inputs.payoutStartYear;
		const payoutEndYear = payoutStartYear + inputs.payoutYears - 1;
		const totalYears = Math.max(inputs.ppt, payoutEndYear);
		
		let ledger: any[] = [];
		let totalNominalPayout = 0;
		let totalRealPayout = 0;
		let cashFlowsForXirr: { amount: number; date: Date }[] = [];

		const startDate = new Date();

		for (let yr = 1; yr <= totalYears; yr++) {
			let yearPremium = (yr <= inputs.ppt) ? inputs.premium : 0;
			let yearPayout = (yr >= payoutStartYear && yr <= payoutEndYear) ? inputs.payoutAmount : 0;
			
			if (yr === payoutEndYear) yearPayout += inputs.maturityBenefit;

			let netCash = yearPayout - yearPremium;
            
			// Premium is paid at start of year (yr - 1), Payout is received at end of year (yr)
			let premiumDiscountFactor = Math.pow(1 + (inputs.inflationRate / 100), yr - 1);
			let payoutDiscountFactor = Math.pow(1 + (inputs.inflationRate / 100), yr);
            
			let realPremiumValue = yearPremium / premiumDiscountFactor;
			let realPayoutValue = yearPayout / payoutDiscountFactor;

			totalNominalPayout += yearPayout;
			totalRealPayout += realPayoutValue;

			ledger.push({
				year: yr, premiumOut: yearPremium, payoutIn: yearPayout, net: netCash, realValue: realPayoutValue, realPremium: realPremiumValue
			});

			let cfDatePremium = new Date(startDate);
			cfDatePremium.setFullYear(startDate.getFullYear() + (yr - 1));
            
			let cfDatePayout = new Date(startDate);
			cfDatePayout.setFullYear(startDate.getFullYear() + yr);

            if (yearPremium !== 0) cashFlowsForXirr.push({ amount: -yearPremium, date: cfDatePremium });
            if (yearPayout !== 0) cashFlowsForXirr.push({ amount: yearPayout, date: cfDatePayout });
		}

		const bundledXirrRaw = calculateXIRR(cashFlowsForXirr);
		const bundledXirr = bundledXirrRaw !== null ? bundledXirrRaw : 0; 

		let balanceSafe = 0;
		let balanceEquity = 0;

		let totalEquityCapitalInvested = 0;
		for (let yr = 1; yr <= totalYears; yr++) {
			let investableThisYear = (yr <= inputs.ppt) ? investableCapital : 0;
			let payoutDemandedThisYear = ledger[yr-1].payoutIn;
            totalEquityCapitalInvested += investableThisYear;

			// Add premium at start of year, then compound everything
			balanceSafe = balanceSafe + investableThisYear;
			balanceEquity = balanceEquity + investableThisYear;

			balanceSafe = balanceSafe * (1 + (inputs.safeRate / 100));
			balanceEquity = balanceEquity * (1 + (inputs.equityRate / 100));

			// Payouts are received at the end of the year
			balanceSafe = balanceSafe - payoutDemandedThisYear;
			balanceEquity = balanceEquity - payoutDemandedThisYear;
		}

        // Apply 12.5% LTCG Tax Drag on Equity DIY
        let equityTaxDrag = 0;
        if (balanceEquity > 0) {
            let taxableGain = Math.max(0, balanceEquity - totalEquityCapitalInvested - 125000);
            equityTaxDrag = taxableGain * 0.125;
            balanceEquity -= equityTaxDrag;
        }

		return {
			engineA: { xirr: bundledXirr.toFixed(2) + '%', totalNominalPayout, totalRealPayout },
			engineB: { finalArbitrageProfit: balanceSafe, riskCostPaid: totalRiskCost * inputs.ppt },
			engineC: { finalArbitrageProfit: balanceEquity, riskCostPaid: totalRiskCost * inputs.ppt, taxDrag: equityTaxDrag },
			ledger
		};
	}

	function updateDashboardUI() {
		const results = runReplicationAnalysis();

		const engineAXirrEl = document.getElementById('engineAXIRR');
		const engineANominalEl = document.getElementById('engineANominal');
		const engineARealEl = document.getElementById('engineAReal');
		const xirrBadgeEl = document.getElementById('xirrHealthBadge');

		if (engineAXirrEl) engineAXirrEl.innerText = results.engineA.xirr;
		if (engineANominalEl) engineANominalEl.innerText = formatShortRupee(results.engineA.totalNominalPayout);
		if (engineARealEl) engineARealEl.innerText = formatShortRupee(results.engineA.totalRealPayout);

		const xirrNum = parseFloat(results.engineA.xirr);
		if (xirrBadgeEl) {
			if (xirrNum < 6.0) {
				xirrBadgeEl.innerText = 'LAGGING INFLATION';
				xirrBadgeEl.className = 'badge-danger';
			} else if (xirrNum < 9.0) {
				xirrBadgeEl.innerText = 'MODERATE YIELD';
				xirrBadgeEl.className = 'badge-warning';
			} else {
				xirrBadgeEl.innerText = 'HIGH YIELD';
				xirrBadgeEl.className = 'badge-safe';
			}
		}

		const engineBSurplusEl = document.getElementById('engineBSurplus');
		const engineBRiskCostEl = document.getElementById('valRiskCostB');
		const engineBBadgeEl = document.getElementById('engineBBadge');
		const engineBTextEl = document.getElementById('engineBText');
		const safeProfit = results.engineB.finalArbitrageProfit;

		if (engineBSurplusEl) engineBSurplusEl.innerText = formatShortRupee(safeProfit);
		if (engineBRiskCostEl) engineBRiskCostEl.innerText = formatShortRupee(results.engineB.riskCostPaid);

		if (engineBBadgeEl && engineBTextEl) {
			if (safeProfit > 0) {
				engineBBadgeEl.innerText = 'DIY WINS';
				engineBBadgeEl.className = 'badge-safe';
				engineBTextEl.innerHTML = `By unbundling, you fund the exact same payouts and keep an extra <strong class="font-bold text-emerald-600 dark:text-emerald-400">${formatShortRupee(safeProfit)}</strong> in surplus wealth.`;
			} else {
				engineBBadgeEl.innerText = 'POLICY WINS';
				engineBBadgeEl.className = 'badge-warning';
				engineBTextEl.innerHTML = `This policy's yield beats the 7.1% safe government rate. DIY replication fails by <strong class="font-bold text-amber-600 dark:text-amber-400">${formatShortRupee(Math.abs(safeProfit))}</strong>.`;
			}
		}

		const engineCSurplusEl = document.getElementById('engineCSurplus');
		const engineCRiskCostEl = document.getElementById('valRiskCostC');
		const engineCTaxDragEl = document.getElementById('valTaxDragC');
		const engineCTextEl = document.getElementById('engineCText');
		const equityProfit = results.engineC.finalArbitrageProfit;

		if (engineCSurplusEl) engineCSurplusEl.innerText = formatShortRupee(equityProfit);
		if (engineCRiskCostEl) engineCRiskCostEl.innerText = formatShortRupee(results.engineC.riskCostPaid);
		if (engineCTaxDragEl) engineCTaxDragEl.innerText = `-${formatShortRupee(results.engineC.taxDrag)}`;

		if (engineCTextEl) {
			if (equityProfit > 0) {
				engineCTextEl.innerHTML = `By accepting equity volatility, you fund the exact same payouts and generate <strong class="font-bold text-indigo-600 dark:text-indigo-400">${formatShortRupee(equityProfit)}</strong> in massive surplus wealth.`;
			} else {
				engineCTextEl.innerHTML = `The payouts demand too much cash too early. Sequence risk breaks the equity portfolio by <strong class="font-bold text-rose-600 dark:text-rose-400">${formatShortRupee(Math.abs(equityProfit))}</strong>.`;
			}
		}

		const takeawayEl = document.getElementById('replicationTakeaway');
		const toggleUnbundle = (document.getElementById('unbundleToggle') as HTMLInputElement)?.checked ?? true;

		if (takeawayEl) {
			if (toggleUnbundle) {
				takeawayEl.innerText = `By unbundling insurance from investment, purchasing pure Term Life + Accident cover (${formatShortRupee(results.engineB.riskCostPaid)} total risk cost), and investing the rest, DIY Equity leaves you with ${formatShortRupee(results.engineC.finalArbitrageProfit)} in SURPLUS WEALTH after paying out all requested cash flows!`;
			} else {
				takeawayEl.innerText = `Without deducting any insurance cost, investing 100% of your premiums into DIY Equity leaves you with ${formatShortRupee(results.engineC.finalArbitrageProfit)} in SURPLUS WEALTH after paying out all requested cash flows!`;
			}
		}

		const inputPremium = parseFormattedNumber((document.getElementById('inPremium') as HTMLInputElement)?.value) || 100000;
		const inputPPT = parseInt((document.getElementById('inPPT') as HTMLInputElement)?.value) || 10;
		let totalGstPaid = 0;
		for (let yr = 1; yr <= inputPPT; yr++) {
			let gstRate = (yr === 1) ? 0.045 : 0.0225;
			totalGstPaid += inputPremium * gstRate;
		}
		let estCommission = inputPremium * 0.20;
		
		let breakEvenYear = "Never / Term";
		let cumulativeReal = 0;
		const ledger = results.ledger || [];
		for (let i = 0; i < ledger.length; i++) {
			cumulativeReal += ledger[i].realValue - ledger[i].realPremium;
			if (cumulativeReal > 0) { breakEvenYear = `Year ${ledger[i].year}`; break; }
		}

		const frictionalGstEl = document.getElementById('frictionalGst');
		const frictionalCommissionEl = document.getElementById('frictionalCommission');
		const frictionalBreakEvenEl = document.getElementById('frictionalBreakEven');

		if (frictionalGstEl) frictionalGstEl.innerText = tableFormatter.format(Math.round(totalGstPaid));
		if (frictionalCommissionEl) frictionalCommissionEl.innerText = tableFormatter.format(Math.round(estCommission));
		if (frictionalBreakEvenEl) frictionalBreakEvenEl.innerText = breakEvenYear;

        // Render Chart
        renderCashflowChart(ledger);
	}

	document.addEventListener('DOMContentLoaded', () => {
		['inPremium', 'inPayout', 'inMaturity', 'inTermCover', 'inAccidentCover', 'inTermCostOverride', 'inAccidentCostOverride'].forEach(id => {
			const el = document.getElementById(id);
			if (el) setupFormattingField(el as HTMLInputElement, updateDashboardUI);
		});

		const toggleUnbundleEl = document.getElementById('unbundleToggle') as HTMLInputElement;
		const simpleRiskViewEl = document.getElementById('simpleRiskView');
		const btnAdvancedRiskEl = document.getElementById('advancedToggleBtn');
		const advancedRiskViewEl = document.getElementById('advancedRiskView');

		if (toggleUnbundleEl && simpleRiskViewEl) {
			toggleUnbundleEl.addEventListener('change', () => {
				if (toggleUnbundleEl.checked) simpleRiskViewEl.classList.remove('hidden');
				else { simpleRiskViewEl.classList.add('hidden'); advancedRiskViewEl?.classList.add('hidden'); }
				updateDashboardUI();
			});
		}

		if (btnAdvancedRiskEl && advancedRiskViewEl) {
			btnAdvancedRiskEl.addEventListener('click', () => advancedRiskViewEl.classList.toggle('hidden'));
		}

		['inTermCover', 'inAccidentCover'].forEach(id => {
			document.getElementById(id)?.addEventListener('input', () => { syncRiskCostsFromCover(); updateDashboardUI(); });
		});

		['inPPT', 'inPayoutStart', 'inPayoutYears', 'inInflation'].forEach(id => {
			const el = document.getElementById(id);
			if (el) { el.addEventListener('input', updateDashboardUI); el.addEventListener('change', updateDashboardUI); }
		});

		syncRiskCostsFromCover();
		updateDashboardUI();
	});
</script>
