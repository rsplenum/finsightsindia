<script>
	document.addEventListener('DOMContentLoaded', () => {
		const highlightContainer = document.getElementById('highlightText');
		const words = document.querySelectorAll('.highlight-word');
		const buttons = document.querySelectorAll('.intent-btn');

		// 1. Intent pill smooth scrolling
		buttons.forEach(btn => {
			btn.addEventListener('click', () => {
				const targetId = btn.getAttribute('data-intent');
				if (!targetId) return;
				const targetCard = document.getElementById(targetId);
				if (targetCard) {
					// Clear the navbar
					const cardTopOffset = 88;

					const cardPosition = targetCard.getBoundingClientRect().top + window.pageYOffset;
					const offsetPosition = cardPosition - cardTopOffset;

					window.scrollTo({
						top: Math.max(0, offsetPosition),
						behavior: 'smooth'
					});

					targetCard.classList.add('ring-2', 'ring-gold-500');
					setTimeout(() => {
						targetCard.classList.remove('ring-2', 'ring-gold-500');
					}, 2000);
				}
			});
		});

		// 2. High-performance scroll animation handlers
		function updateWordHighlight() {
			if (!highlightContainer || words.length === 0) return;
			const rect = highlightContainer.getBoundingClientRect();
			const windowHeight = window.innerHeight;

			const start = windowHeight * 0.85;
			const end = windowHeight * 0.25;

			let progress = (start - rect.top) / (start - end);
			progress = Math.max(0, Math.min(1, progress));

			const activeIndex = Math.floor(progress * words.length);

			words.forEach((word, idx) => {
				if (idx <= activeIndex) {
					word.classList.remove('text-navy-400', 'opacity-30');
					word.classList.add('opacity-100');
					if (!word.classList.contains('text-gold-400')) {
						word.classList.add('text-white');
					}
				} else {
					word.classList.add('text-navy-400', 'opacity-30');
					word.classList.remove('opacity-100');
					if (!word.classList.contains('text-gold-400')) {
						word.classList.remove('text-white');
					}
				}
			});
		}

		// Optimized single-ticking 60fps scroll & resize listener
		let isTicking = false;
		function onScrollOrResize() {
			if (!isTicking) {
				window.requestAnimationFrame(() => {
					updateWordHighlight();
					isTicking = false;
				});
				isTicking = true;
			}
		}

		window.addEventListener('scroll', onScrollOrResize, { passive: true });
		window.addEventListener('resize', onScrollOrResize, { passive: true });

		// Initial execution
		updateWordHighlight();
	});
</script>

