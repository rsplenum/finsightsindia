---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Retirement Withdrawal Planner — SWP Intelligence Engine">
	<!-- Centered Symmetrical Hero Funnel -->
	<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-10 flex flex-col items-center text-center">
		<span class="inline-block text-xs font-semibold tracking-wider text-slate-900 dark:text-zinc-100 uppercase px-3 py-1 bg-slate-100 dark:bg-zinc-900 rounded-md border border-slate-200 dark:border-zinc-800">
			SWP Intelligence Engine
		</span>
		<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 dark:text-zinc-100 max-w-4xl mt-4">
			Retirement Withdrawal Planner
		</h1>
		<p class="mt-5 text-lg sm:text-xl text-slate-500 dark:text-zinc-400 max-w-2xl leading-relaxed font-normal">
			A systematic withdrawal engine engineered to stress-test your wealth against inflation, market volatility, and tax friction over your lifetime.
		</p>
	</section>

		<!-- Main Application Content -->
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

			<!-- 2-Column Responsive Grid -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
				
				<!-- Left Column: Input Form Card -->
				<section class="lg:col-span-5 bg-white dark:bg-zinc-950 rounded-xl border border-slate-200 dark:border-zinc-800 p-6 sm:p-8 space-y-6 transition-colors duration-200">
					<div class="pb-4 border-b border-slate-200 dark:border-zinc-800 flex items-center justify-between">
						<div>
							<h3 class="text-lg font-bold tracking-tight text-slate-900 dark:text-zinc-100">Your Plan Details</h3>
							<p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Enter your savings, monthly income needs, and growth expectations.</p>
						</div>
					</div>

					<form id="swpForm" onsubmit="event.preventDefault();" class="space-y-6">
						
						<!-- Section 1: Starting Investments -->
						<div class="space-y-4">
							<h4 class="text-xs font-semibold text-slate-500 dark:text-zinc-400 tracking-wider uppercase">01 / Starting Investments</h4>
							
							<!-- Initial Corpus -->
							<div>
								<div class="flex justify-between items-center mb-1.5">
									<!-- Hoverable Tooltip Label -->
									<div class="relative group inline-flex items-center gap-1.5 cursor-pointer">
										<label for="initialCorpus" class="text-xs font-semibold text-slate-800 dark:text-zinc-200 cursor-pointer">
											Total Savings / Initial Corpus <span class="text-rose-500">*</span>
										</label>
										<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
										</svg>
										<!-- Absolute Tooltip Div -->
										<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
											The total lump sum you are starting with today.
										</div>
									</div>

									<span class="text-xs text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/80 border border-emerald-200 dark:border-emerald-800 px-2 py-0.5 rounded-md font-medium" id="corpusFormatted">
										₹ 1,00,00,000 (1 Cr)
									</span>
								</div>
								<div class="relative flex items-center">
									<span class="absolute left-3.5 text-sm text-slate-400 dark:text-zinc-500 select-none">₹</span>
									<input 
										type="text" 
										inputmode="numeric"
										id="initialCorpus" 
										name="initialCorpus" 
										value="1,00,00,000"
										required
										class="w-full min-h-[44px] bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-md pl-9 pr-14 py-2.5 text-sm text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist font-sans"
									/>
									<span class="absolute right-3.5 text-xs text-slate-400 dark:text-zinc-500 select-none font-sans">INR</span>
								</div>
							</div>

							<!-- Monthly Withdrawal -->
							<div>
								<div class="flex justify-between items-center mb-1.5">
									<!-- Hoverable Tooltip Label -->
									<div class="relative group inline-flex items-center gap-1.5 cursor-pointer">
										<label for="monthlyWithdrawal" class="text-xs font-semibold text-slate-800 dark:text-zinc-200 cursor-pointer">
											First Year Monthly Paycheck <span class="text-rose-500">*</span>
										</label>
										<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
										</svg>
										<!-- Absolute Tooltip Div -->
										<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
											This is your GROSS target. Your actual net-in-hand income will be slightly lower because LTCG taxes will be deducted from the profit portion of this withdrawal.
										</div>
									</div>

									<span class="text-xs text-slate-600 dark:text-zinc-400 bg-slate-100 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 px-2 py-0.5 rounded-md font-medium" id="withdrawalFormatted">
										₹ 50,000 / month
									</span>
								</div>
								<div class="relative flex items-center">
									<span class="absolute left-3.5 text-sm text-slate-400 dark:text-zinc-500 select-none">₹</span>
									<input 
										type="text" 
										inputmode="numeric"
										id="monthlyWithdrawal" 
										name="monthlyWithdrawal" 
										value="50,000"
										required
										class="w-full min-h-[44px] bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-md pl-9 pr-16 py-2.5 text-sm text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist font-sans"
									/>
									<span class="absolute right-3.5 text-xs text-slate-400 dark:text-zinc-500 select-none font-sans">/month</span>
								</div>
							</div>
						</div>

						<div class="h-px bg-slate-200 dark:bg-zinc-800"></div>

						<!-- Section 2: Escalation & Market Expectations -->
						<div class="space-y-4">
							<h4 class="text-xs font-semibold text-slate-500 dark:text-zinc-400 tracking-wider uppercase">02 / Escalation & Expected Rates</h4>

							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<!-- Annual Step-Up % -->
								<div>
									<div class="relative group inline-flex items-center gap-1.5 cursor-pointer mb-1.5">
										<label for="stepUp" class="block text-xs font-semibold text-slate-800 dark:text-zinc-200 cursor-pointer">
											Annual Step-Up (Inflation)
										</label>
										<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
										</svg>
										<!-- Absolute Tooltip Div -->
										<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
											The percentage by which your monthly paycheck increases each year to keep pace with inflation.
										</div>
									</div>
									<div class="relative flex items-center">
										<input 
											type="number" 
											id="stepUp" 
											name="stepUp" 
											value="6.0"
											min="0"
											max="20"
											step="0.5"
											required
											class="w-full min-h-[44px] bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-md px-3.5 pr-14 py-2.5 text-sm text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist font-sans"
										/>
										<span class="absolute right-3.5 text-xs text-slate-400 dark:text-zinc-500 select-none font-sans">% / yr</span>
									</div>
								</div>

								<!-- Expected Return % -->
								<div>
									<div class="relative group inline-flex items-center gap-1.5 cursor-pointer mb-1.5">
										<label for="expectedReturn" class="block text-xs font-semibold text-slate-800 dark:text-zinc-200 cursor-pointer">
											Expected CAGR %
										</label>
										<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
										</svg>
										<!-- Absolute Tooltip Div -->
										<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 sm:right-0 sm:left-auto pointer-events-none font-normal leading-normal">
											The long-term average annual return rate of your portfolio.
										</div>
									</div>
									<div class="relative flex items-center">
										<input 
											type="number" 
											id="expectedReturn" 
											name="expectedReturn" 
											value="12.0"
											min="0"
											max="30"
											step="0.5"
											required
											class="w-full min-h-[44px] bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-md px-3.5 pr-14 py-2.5 text-sm text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist font-sans"
										/>
										<span class="absolute right-3.5 text-xs text-slate-400 dark:text-zinc-500 select-none font-sans">% cagr</span>
									</div>
								</div>
							</div>
						</div>

						<div class="h-px bg-slate-200 dark:bg-zinc-800"></div>

						<!-- Section 3: Tax Friction & Horizon -->
						<div class="space-y-4">
							<h4 class="text-xs font-semibold text-slate-500 dark:text-zinc-400 tracking-wider uppercase">03 / Tax Friction & Time Horizon</h4>

							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<!-- LTCG Tax % -->
								<div>
									<div class="relative group inline-flex items-center gap-1.5 cursor-pointer mb-1.5">
										<label for="ltcgTax" class="block text-xs font-semibold text-slate-800 dark:text-zinc-200 cursor-pointer">
											LTCG Tax Rate %
										</label>
										<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
										</svg>
										<!-- Absolute Tooltip Div -->
										<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 pointer-events-none font-normal leading-normal">
											Long Term Capital Gains tax. This friction is only applied to your profits, not your original invested capital.
										</div>
									</div>
									<div class="relative flex items-center">
										<input 
											type="number" 
											id="ltcgTax" 
											name="ltcgTax" 
											value="12.5"
											min="0"
											max="50"
											step="0.1"
											required
											class="w-full min-h-[44px] bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-md px-3.5 pr-16 py-2.5 text-sm text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist font-sans"
										/>
										<span class="absolute right-3.5 text-xs text-slate-400 dark:text-zinc-500 select-none font-sans">% tax</span>
									</div>
								</div>

								<!-- Time Horizon -->
								<div>
									<div class="relative group inline-flex items-center gap-1.5 cursor-pointer mb-1.5">
										<label for="horizonYears" class="block text-xs font-semibold text-slate-800 dark:text-zinc-200 cursor-pointer">
											Retirement Length (Years)
										</label>
										<svg class="w-3.5 h-3.5 text-slate-400 dark:text-zinc-500 hover:text-slate-600 dark:hover:text-zinc-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
										</svg>
										<!-- Absolute Tooltip Div -->
										<div class="absolute z-50 invisible opacity-0 group-hover:visible group-hover:opacity-100 bg-slate-900 dark:bg-zinc-800 text-white text-xs rounded-md p-3 w-64 shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-200 bottom-full mb-2 left-0 sm:right-0 sm:left-auto pointer-events-none font-normal leading-normal">
											The total number of years you plan to withdraw monthly paychecks during your retirement.
										</div>
									</div>
									<div class="relative flex items-center">
										<input 
											type="number" 
											id="horizonYears" 
											name="horizonYears" 
											value="30"
											min="5"
											max="50"
											step="1"
											required
											class="w-full min-h-[44px] bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-md px-3.5 pr-16 py-2.5 text-sm text-slate-900 dark:text-zinc-100 placeholder:text-slate-400 dark:placeholder:text-zinc-500 focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist font-sans"
										/>
										<span class="absolute right-3.5 text-xs text-slate-400 dark:text-zinc-500 select-none font-sans">years</span>
									</div>
								</div>
							</div>
						</div>

						<div class="h-px bg-slate-200 dark:bg-zinc-800"></div>

						<!-- Section 04: Advanced Risk Controls -->
						<div class="space-y-3">
							<h4 class="text-xs font-semibold text-slate-500 dark:text-zinc-400 tracking-wider uppercase">04 / Advanced Risk Controls</h4>

							<div class="flex items-center justify-between gap-3">
								<span class="text-xs font-semibold text-slate-800 dark:text-zinc-200">
									Enable Dynamic Guardrails
								</span>
								<label class="relative inline-flex items-center cursor-pointer shrink-0">
									<input type="checkbox" id="useGuardrails" name="useGuardrails" class="sr-only peer">
									<div class="w-11 h-6 bg-slate-200 dark:bg-zinc-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-slate-900 dark:peer-checked:bg-white"></div>
								</label>
							</div>
							<p class="text-xs text-slate-500 dark:text-zinc-400 leading-relaxed">
								Simulates a rational investor. If a severe market crash occurs, the system automatically reduces your monthly paycheck by 10% to protect the underlying collateral. This trades guaranteed income for higher portfolio survival.
							</p>
						</div>

						<!-- Submit Button -->
						<div class="pt-2">
							<button 
								type="button" 
								id="runSimBtn"
								class="w-full min-h-[44px] bg-slate-900 hover:bg-slate-800 text-white dark:bg-white dark:hover:bg-zinc-200 dark:text-black font-semibold py-3 px-6 rounded-md transition-all duration-200 ease-geist flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]"
							>
								<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
									<path d="M8 5v14l11-7z"/>
								</svg>
								<span class="text-sm font-semibold">Run 10,000 Market Simulations</span>
							</button>
						</div>
					</form>
				</section>

				<!-- Right Column: Results Section (Sleek Tabbed Layout) -->
				<section class="lg:col-span-7 space-y-6">
					
					<!-- Modern Tabbed Navigation Header (Touch Friendly Targets) -->
					<div class="flex items-center gap-8 border-b border-slate-200 dark:border-white/10 pb-px">
						<button 
							id="tabPlanSummaryBtn"
							type="button"
							class="min-h-[44px] pb-3 text-sm font-bold text-slate-900 dark:text-zinc-100 border-b-2 border-slate-900 dark:border-white transition-all cursor-pointer flex items-center"
						>
							Plan Summary
						</button>
						<button 
							id="tabScheduleBtn"
							type="button"
							class="min-h-[44px] pb-3 text-sm font-semibold text-slate-500 hover:text-slate-800 dark:text-zinc-400 dark:hover:text-zinc-200 border-b-2 border-transparent transition-all cursor-pointer flex items-center"
						>
							Yearly Paycheck Schedule
						</button>
					</div>

					<!-- View 1: Plan Summary Tab Content -->
					<div id="viewPlanSummary" class="space-y-6">
						
						<!-- Primary Results Card -->
						<div class="bg-white dark:bg-zinc-950 rounded-xl border border-slate-200 dark:border-white/10 p-6 sm:p-8 space-y-6 transition-colors duration-200">
							
							<!-- Actionable Portfolio Health & Endurance Hero Section -->
							<div class="pb-6 border-b border-slate-200 dark:border-white/10 space-y-3">
								<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
									<div>
										<h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-zinc-100">Projected Runway</h3>
										<p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Projected portfolio endurance under real-world market stress tests.</p>
									</div>

									<!-- Health Status Badge & Hero Metric Div -->
									<div class="flex items-center gap-2 self-start sm:self-auto flex-wrap justify-end">
										<div id="portfolioEnduranceHero" class="text-3xl sm:text-4xl font-extrabold tracking-tight font-sans text-slate-900 dark:text-zinc-100">
											--
										</div>
										<div id="guardrailsActiveBadge" class="hidden px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
											GUARDRAILS ACTIVE
										</div>
										<div id="portfolioHealthBadge" class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md bg-slate-100 text-slate-700 dark:bg-zinc-900 dark:text-zinc-300 border border-slate-200 dark:border-white/10">
											CALCULATING
										</div>
									</div>
								</div>

								<!-- Reality Check Subtext -->
								<p id="portfolioRealityCheck" class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed font-sans pt-1">
									Running 10,000 market stress tests...
								</p>

								<!-- Lifestyle Degradation / Prosperity Bonus Alert Box -->
								<div id="lifestyleSacrificeAlertBox" class="hidden mt-4 p-4 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/60 rounded-lg space-y-2.5 transition-colors duration-200">
									<div class="flex items-center gap-2">
										<svg id="sacrificeIcon" class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
										</svg>
										<h4 id="sacrificeTitle" class="text-xs font-bold text-amber-900 dark:text-amber-200 uppercase tracking-wider">
											Lifestyle Degradation Alert
										</h4>
									</div>
									<div class="space-y-2 text-xs text-amber-800 dark:text-amber-300 leading-relaxed font-sans">
										<p id="sacrificeMetric1">
											To force your portfolio to survive, the system withheld <strong id="valSacrificeTotalCash" class="font-bold text-amber-950 dark:text-amber-100">--</strong> in planned lifetime income.
										</p>
										<p id="sacrificeMetric2">
											During the worst market crashes, your monthly paycheck was slashed. At its lowest point, your income dropped to the equivalent purchasing power of just <strong id="valSacrificeRockBottom" class="font-bold text-amber-950 dark:text-amber-100">--</strong> in today's money.
										</p>
									</div>
								</div>

								<!-- Guardrail Weather Forecast Grid -->
								<div id="weatherForecastContainer" class="hidden mt-4 p-4 sm:p-5 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-lg space-y-3">
									<div class="flex items-center justify-between">
