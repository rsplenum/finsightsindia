---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('direct-tax');
const articles = allArticles
  .sort((a, b) => b.id.localeCompare(a.id))
  .slice(0, 3);
const articleCount = allArticles.length;
---

<Layout
	title="FinSight India — Make Your Next Money Decision With the Whole Picture"
	description="Start with the financial decision in front of you. FinSight gives you a plain-language answer, shows what moves it, and keeps the full workings within reach."
>
	<section class="hero-glow relative overflow-hidden border-b border-navy-200/70 dark:border-navy-800">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 lg:py-24">
			<div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
				<div class="max-w-3xl space-y-7 reveal">
					<p class="text-caption text-gold-700 dark:text-gold-400">Financial decisions, made clear</p>
					<h1 class="text-hero text-navy-900 dark:text-navy-100 font-extrabold tracking-tight text-balance">
						Make your next money decision with the whole picture.
					</h1>
					<p class="max-w-2xl text-lg sm:text-xl leading-relaxed text-navy-600 dark:text-navy-300">
						Start with the decision in front of you. Get a plain-language answer, see what changes it, then inspect the full workings when you are ready.
					</p>
					<div class="flex flex-wrap gap-x-5 gap-y-3 text-sm text-navy-600 dark:text-navy-300">
						<span class="inline-flex items-center gap-2"><span class="text-emerald-700 dark:text-emerald-400" aria-hidden="true">✓</span> Your data stays in your browser</span>
						<span class="inline-flex items-center gap-2"><span class="text-emerald-700 dark:text-emerald-400" aria-hidden="true">✓</span> No product commissions</span>
						<span class="inline-flex items-center gap-2"><span class="text-emerald-700 dark:text-emerald-400" aria-hidden="true">✓</span> Assumptions stay visible</span>
					</div>
					<a href="#decisions" class="btn-gold w-fit focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500">
						Choose a decision <span aria-hidden="true">↓</span>
					</a>
				</div>

				<aside class="card-premium card-glow relative overflow-hidden p-6 sm:p-8 reveal" aria-label="What FinSight gives you">
					<div class="flex items-center justify-between gap-4 border-b border-navy-200 pb-4 dark:border-navy-700">
						<p class="text-xs font-bold uppercase tracking-[0.16em] text-gold-700 dark:text-gold-400">What you leave with</p>
						<span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-gold-500/10 text-gold-700 dark:text-gold-400" aria-hidden="true">→</span>
					</div>
					<div class="space-y-5 py-6">
						<div>
							<p class="text-sm text-navy-500 dark:text-navy-400">Not a dashboard. A usable conclusion.</p>
							<p class="mt-2 text-2xl font-bold tracking-tight text-navy-900 dark:text-navy-100">“This plan is tight. Here is the one change that helps most.”</p>
						</div>
						<div class="grid gap-3 sm:grid-cols-3">
							<div class="rounded-xl bg-navy-50 p-3 dark:bg-navy-800/70"><p class="text-[11px] font-bold uppercase tracking-wider text-navy-500 dark:text-navy-400">1</p><p class="mt-1 text-sm font-semibold text-navy-900 dark:text-navy-100">Your situation</p></div>
							<div class="rounded-xl bg-navy-50 p-3 dark:bg-navy-800/70"><p class="text-[11px] font-bold uppercase tracking-wider text-navy-500 dark:text-navy-400">2</p><p class="mt-1 text-sm font-semibold text-navy-900 dark:text-navy-100">The answer</p></div>
							<div class="rounded-xl bg-navy-50 p-3 dark:bg-navy-800/70"><p class="text-[11px] font-bold uppercase tracking-wider text-navy-500 dark:text-navy-400">3</p><p class="mt-1 text-sm font-semibold text-navy-900 dark:text-navy-100">Why it moves</p></div>
						</div>
					</div>
					<p class="border-t border-navy-200 pt-4 text-sm leading-relaxed text-navy-500 dark:border-navy-700 dark:text-navy-400">
						Every calculator keeps its assumptions, trade-offs, and detailed ledger available. Simple is the entry, not the limit.
					</p>
				</aside>
			</div>
		</div>
	</section>

	<section id="decisions" class="scroll-mt-24 py-14 sm:py-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="max-w-2xl">
				<p class="text-caption text-gold-700 dark:text-gold-400">Start here</p>
				<h2 class="mt-2 text-section text-navy-900 dark:text-navy-100">What are you trying to decide?</h2>
				<p class="mt-3 text-base leading-relaxed text-navy-600 dark:text-navy-300">Choose the question that is already taking up your attention. You do not need to learn the vocabulary before you begin.</p>
			</div>

			<div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
				<a href="/tax-calculator" class="group rounded-2xl border border-navy-200 bg-white p-6 shadow-sm transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-gold-500/50 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 dark:border-navy-800 dark:bg-navy-900">
					<div class="flex items-start justify-between gap-4"><span class="text-2xl" aria-hidden="true">₹</span><span class="text-gold-700 transition-transform duration-200 group-hover:translate-x-1 dark:text-gold-400" aria-hidden="true">→</span></div>
					<p class="mt-6 text-xs font-bold uppercase tracking-[0.14em] text-gold-700 dark:text-gold-400">Income tax</p>
					<h3 class="mt-2 text-xl font-bold tracking-tight text-navy-900 dark:text-navy-100">How much tax will I actually pay?</h3>
					<p class="mt-3 text-sm leading-relaxed text-navy-600 dark:text-navy-300">See the tax under each regime, the deductions that matter, and the next calculation to check.</p>
					<p class="mt-6 text-sm font-semibold text-navy-900 dark:text-navy-100">Open Tax Calculator</p>
				</a>

				<a href="/swp-planner" class="group rounded-2xl border border-navy-200 bg-white p-6 shadow-sm transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-gold-500/50 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 dark:border-navy-800 dark:bg-navy-900">
					<div class="flex items-start justify-between gap-4"><span class="text-2xl" aria-hidden="true">⌁</span><span class="text-gold-700 transition-transform duration-200 group-hover:translate-x-1 dark:text-gold-400" aria-hidden="true">→</span></div>
					<p class="mt-6 text-xs font-bold uppercase tracking-[0.14em] text-gold-700 dark:text-gold-400">Retirement income</p>
					<h3 class="mt-2 text-xl font-bold tracking-tight text-navy-900 dark:text-navy-100">Can my monthly income last?</h3>
					<p class="mt-3 text-sm leading-relaxed text-navy-600 dark:text-navy-300">See the typical path, the difficult futures, and the one lever that makes your plan safer.</p>
					<p class="mt-6 text-sm font-semibold text-navy-900 dark:text-navy-100">Open Retirement Planner</p>
				</a>

				<a href="/sip-engine" class="group rounded-2xl border border-navy-200 bg-white p-6 shadow-sm transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-gold-500/50 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 dark:border-navy-800 dark:bg-navy-900">
					<div class="flex items-start justify-between gap-4"><span class="text-2xl" aria-hidden="true">↗</span><span class="text-gold-700 transition-transform duration-200 group-hover:translate-x-1 dark:text-gold-400" aria-hidden="true">→</span></div>
					<p class="mt-6 text-xs font-bold uppercase tracking-[0.14em] text-gold-700 dark:text-gold-400">Saving & investing</p>
					<h3 class="mt-2 text-xl font-bold tracking-tight text-navy-900 dark:text-navy-100">What monthly SIP gets me there?</h3>
					<p class="mt-3 text-sm leading-relaxed text-navy-600 dark:text-navy-300">Start with your goal. FinSight works backwards to show the monthly saving your plan asks of you.</p>
					<p class="mt-6 text-sm font-semibold text-navy-900 dark:text-navy-100">Open SIP Engine</p>
				</a>

				<a href="/insurance-analyzer" class="group rounded-2xl border border-navy-200 bg-white p-6 shadow-sm transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-gold-500/50 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 dark:border-navy-800 dark:bg-navy-900">
					<div class="flex items-start justify-between gap-4"><span class="text-2xl" aria-hidden="true">◇</span><span class="text-gold-700 transition-transform duration-200 group-hover:translate-x-1 dark:text-gold-400" aria-hidden="true">→</span></div>
					<p class="mt-6 text-xs font-bold uppercase tracking-[0.14em] text-gold-700 dark:text-gold-400">Insurance</p>
					<h3 class="mt-2 text-xl font-bold tracking-tight text-navy-900 dark:text-navy-100">Is this policy worth what it costs?</h3>
					<p class="mt-3 text-sm leading-relaxed text-navy-600 dark:text-navy-300">Separate the protection from the investment return, then compare the real trade-off before you commit.</p>
					<p class="mt-6 text-sm font-semibold text-navy-900 dark:text-navy-100">Analyze a Policy</p>
				</a>

				<a href="/black-scholes" class="group rounded-2xl border border-navy-200 bg-white p-6 shadow-sm transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-gold-500/50 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 dark:border-navy-800 dark:bg-navy-900">
					<div class="flex items-start justify-between gap-4"><span class="text-2xl" aria-hidden="true">⌇</span><span class="text-gold-700 transition-transform duration-200 group-hover:translate-x-1 dark:text-gold-400" aria-hidden="true">→</span></div>
					<p class="mt-6 text-xs font-bold uppercase tracking-[0.14em] text-gold-700 dark:text-gold-400">Market protection</p>
					<h3 class="mt-2 text-xl font-bold tracking-tight text-navy-900 dark:text-navy-100">What does protection cost before a fall?</h3>
					<p class="mt-3 text-sm leading-relaxed text-navy-600 dark:text-navy-300">Price the protection first, then judge it against the specific future it is meant to change.</p>
					<p class="mt-6 text-sm font-semibold text-navy-900 dark:text-navy-100">Open Options Lab</p>
				</a>
			</div>
		</div>
	</section>

	<section class="border-y border-navy-200 bg-navy-900 py-14 text-white dark:border-navy-800 dark:bg-navy-950 sm:py-16">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-end">
				<div>
					<p class="text-caption text-gold-400">The method</p>
					<h2 class="mt-2 text-section text-white">A number is only the start of the answer.</h2>
				</div>
				<div class="grid gap-4 sm:grid-cols-3">
					<div class="border-l border-gold-500/60 pl-4"><p class="text-sm font-bold text-gold-300">1. Ask plainly</p><p class="mt-2 text-sm leading-relaxed text-navy-300">Use the question you already have, not finance jargon.</p></div>
					<div class="border-l border-gold-500/60 pl-4"><p class="text-sm font-bold text-gold-300">2. See the pressure</p><p class="mt-2 text-sm leading-relaxed text-navy-300">Watch tax, time, inflation, cost, and a difficult market push the answer.</p></div>
					<div class="border-l border-gold-500/60 pl-4"><p class="text-sm font-bold text-gold-300">3. Check the workings</p><p class="mt-2 text-sm leading-relaxed text-navy-300">Open the assumptions and the ledger whenever you need the full picture.</p></div>
				</div>
			</div>
		</div>
	</section>

	<section class="py-14 sm:py-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
				<div class="max-w-2xl"><p class="text-caption text-gold-700 dark:text-gold-400">Research when you need it</p><h2 class="mt-2 text-section text-navy-900 dark:text-navy-100">The explanations behind the decisions.</h2><p class="mt-3 text-base leading-relaxed text-navy-600 dark:text-navy-300">Start with an answer. Use the research to understand the rule, the edge case, or the trade-off behind it.</p></div>
				<a href="/tax-code" class="btn-ghost w-fit focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500">Browse {articleCount} tax guides <span aria-hidden="true">→</span></a>
			</div>
			<div class="mt-8 grid gap-4 md:grid-cols-3">
				{articles.map((article) => (
					<a href={`/tax-code/${article.id}`} class="group rounded-2xl border border-navy-200 bg-white p-6 transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:border-gold-500/50 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 dark:border-navy-800 dark:bg-navy-900">
						<div class="flex items-center justify-between gap-4"><span class="text-xs font-bold uppercase tracking-[0.12em] text-gold-700 dark:text-gold-400">{article.data.categoryName}</span><span class="text-xs text-navy-500 dark:text-navy-400">{article.data.readTime}</span></div>
						<h3 class="mt-5 text-lg font-bold leading-snug tracking-tight text-navy-900 transition-colors group-hover:text-gold-700 dark:text-navy-100 dark:group-hover:text-gold-400">{article.data.title}</h3>
						<p class="mt-3 line-clamp-3 text-sm leading-relaxed text-navy-600 dark:text-navy-300">{article.data.summary}</p>
						<p class="mt-6 text-sm font-semibold text-navy-900 dark:text-navy-100">Read the explanation <span class="text-gold-700 dark:text-gold-400" aria-hidden="true">→</span></p>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="border-t border-navy-200 bg-navy-50 py-10 dark:border-navy-800 dark:bg-navy-900/40">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid gap-6 text-sm sm:grid-cols-3">
				<p class="text-navy-600 dark:text-navy-300"><span class="font-bold text-navy-900 dark:text-navy-100">Private by design.</span> Your financial inputs stay in your browser.</p>
				<p class="text-navy-600 dark:text-navy-300"><span class="font-bold text-navy-900 dark:text-navy-100">No product push.</span> FinSight does not sell you the product it evaluates.</p>
				<p class="text-navy-600 dark:text-navy-300"><span class="font-bold text-navy-900 dark:text-navy-100">The full picture stays reachable.</span> Assumptions, sources, and detailed ledgers are never hidden.</p>
			</div>
		</div>
	</section>
</Layout>
