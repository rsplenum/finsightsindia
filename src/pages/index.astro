<script>
	// Strict Table & Currency Formatter (en-IN, INR, 0 decimals)
	const tableFormatter = new Intl.NumberFormat('en-IN', { 
		style: 'currency', 
		currency: 'INR', 
		maximumFractionDigits: 0 
	});

	// Client-side JavaScript with Natural Proportional Column Spacing (No Artificial Gap Stretching)
	let worker: Worker | null = null;
	let chartInstance: any = null;
	let microChartInstance: any = null;
	let lastWorkerResponse: any = null;
	let activeViewMode: 'percentiles' | 'samples' = 'percentiles';

	const corpusInput = document.getElementById('initialCorpus') as HTMLInputElement;
	const corpusDisplay = document.getElementById('corpusFormatted');
	const withdrawalInput = document.getElementById('monthlyWithdrawal') as HTMLInputElement;
	const withdrawalDisplay = document.getElementById('withdrawalFormatted');
	const runBtn = document.getElementById('runSimBtn') as HTMLButtonElement;
	const viewPercentilesBtn = document.getElementById('viewPercentilesBtn');
	const viewSamplePathsBtn = document.getElementById('viewSamplePathsBtn');

	// 1. Tab Switching Logic (Plan Summary vs Yearly Paycheck Schedule)
	function initTabNavigation() {
		const tabSummaryBtn = document.getElementById('tabPlanSummaryBtn');
		const tabScheduleBtn = document.getElementById('tabScheduleBtn');
		const viewSummaryEl = document.getElementById('viewPlanSummary');
		const viewScheduleEl = document.getElementById('viewSchedule');

		function switchTab(target: 'summary' | 'schedule') {
			if (target === 'summary') {
				viewSummaryEl?.classList.remove('hidden');
				viewScheduleEl?.classList.add('hidden');
				
				tabSummaryBtn?.classList.add('border-slate-900', 'text-slate-900', 'dark:border-white', 'dark:text-zinc-100', 'font-bold');
				tabSummaryBtn?.classList.remove('border-transparent', 'text-slate-500', 'dark:text-zinc-400');
				
				tabScheduleBtn?.classList.remove('border-slate-900', 'text-slate-900', 'dark:border-white', 'dark:text-zinc-100', 'font-bold');
				tabScheduleBtn?.classList.add('border-transparent', 'text-slate-500', 'dark:text-zinc-400');
			} else {
				viewScheduleEl?.classList.remove('hidden');
				viewSummaryEl?.classList.add('hidden');
				
				tabScheduleBtn?.classList.add('border-slate-900', 'text-slate-900', 'dark:border-white', 'dark:text-zinc-100', 'font-bold');
				tabScheduleBtn?.classList.remove('border-transparent', 'text-slate-500', 'dark:text-zinc-400');
				
				tabSummaryBtn?.classList.remove('border-slate-900', 'text-slate-900', 'dark:border-white', 'dark:text-zinc-100', 'font-bold');
				tabSummaryBtn?.classList.add('border-transparent', 'text-slate-500', 'dark:text-zinc-400');
			}
		}

		tabSummaryBtn?.addEventListener('click', () => switchTab('summary'));
		tabScheduleBtn?.addEventListener('click', () => switchTab('schedule'));
	}

	// 2. Theme Toggle Engine (Listens for global theme-changed event to refresh charts)
	function initThemeMachine() {
		window.addEventListener('theme-changed', () => {
			if (lastWorkerResponse) {
				renderConsumerChart(lastWorkerResponse);
				renderMicroCashflowChart(lastWorkerResponse);
			}
		});
	}

	// Parse unformatted numbers (stripping commas)
	function parseRawNumber(val: string | number): number {
		if (typeof val === 'number') return val;
		const cleanStr = String(val || '').replace(/,/g, '').trim();
		const parsed = parseFloat(cleanStr);
		return isNaN(parsed) ? 0 : parsed;
	}

	// South Asian / Indian Numbering System Formatter (e.g. 10000000 -> 1,00,00,000)
	function formatSouthAsianNumber(val: number | string): string {
		const num = parseRawNumber(val);
		if (num === 0 && String(val).trim() === '') return '';
		return num.toLocaleString('en-IN');
	}

	function formatIndianRupeeLabel(val: number): string {
		if (isNaN(val) || val <= 0) return '₹ 0';
		const absVal = Math.abs(val);
		if (absVal >= 10000000) {
			return `₹ ${(val / 10000000).toFixed(2)} Cr (${val.toLocaleString('en-IN')})`;
		} else if (absVal >= 100000) {
			return `₹ ${(val / 100000).toFixed(2)} Lakh (${val.toLocaleString('en-IN')})`;
		}
		return `₹ ${val.toLocaleString('en-IN')}`;
	}

	function formatShortRupee(val: number): string {
		const absVal = Math.abs(val);
		if (absVal >= 10000000) return `₹ ${(val / 10000000).toFixed(2)} Cr`;
		if (absVal >= 100000) return `₹ ${(val / 100000).toFixed(2)} Lakh`;
		return `₹ ${val.toLocaleString('en-IN')}`;
	}

	// Dynamic Helper Badges Update
	function updateDisplayBadges() {
		if (corpusInput && corpusDisplay) {
			const val = parseRawNumber(corpusInput.value);
			corpusDisplay.innerText = formatIndianRupeeLabel(val);
		}
		if (withdrawalInput && withdrawalDisplay) {
			const val = parseRawNumber(withdrawalInput.value);
			withdrawalDisplay.innerText = `₹ ${val.toLocaleString('en-IN')} / month`;
		}
	}

	// Setup South Asian formatting on Blur & Focus for input fields
	function setupFormattingField(inputEl: HTMLInputElement, updateFn: () => void) {
		if (!inputEl) return;

		inputEl.addEventListener('blur', () => {
			const num = parseRawNumber(inputEl.value);
			if (num > 0) {
				inputEl.value = formatSouthAsianNumber(num);
			}
			updateFn();
		});

		inputEl.addEventListener('focus', () => {
			const num = parseRawNumber(inputEl.value);
			if (num > 0) {
				inputEl.value = String(num);
			}
		});

		inputEl.addEventListener('input', updateFn);
	}

	// Web Worker Initialization
	function initWorker() {
		if (window.Worker) {
			worker = new Worker('/worker.js');

			worker.onmessage = function (e: MessageEvent) {
				lastWorkerResponse = e.data;
				handleWorkerResponse(lastWorkerResponse);
			};
		}
	}

	// Run Simulation: Collect inputs, set loading state, post to Worker
	function triggerSimulation() {
		if (!worker) {
			initWorker();
		}

		if (runBtn) {
			runBtn.disabled = true;
			runBtn.innerHTML = `
				<span class="inline-block w-4 h-4 border-2 border-white dark:border-black border-t-transparent rounded-full animate-spin"></span>
				<span class="text-sm font-semibold">Simulating 10,000 Market Simulations...</span>
			`;
		}

		const payload = {
			initialCorpus: parseRawNumber((document.getElementById('initialCorpus') as HTMLInputElement)?.value || 10000000),
			monthlyWithdrawal: parseRawNumber((document.getElementById('monthlyWithdrawal') as HTMLInputElement)?.value || 50000),
			annualStepUp: parseFloat((document.getElementById('annualStepUp') as HTMLInputElement)?.value || '5'),
			expectedReturn: parseFloat((document.getElementById('expectedReturn') as HTMLInputElement)?.value || '12'),
			annualVolatility: parseFloat((document.getElementById('annualVolatility') as HTMLInputElement)?.value || '15'),
			expectedInflation: parseFloat((document.getElementById('expectedInflation') as HTMLInputElement)?.value || '6'),
			ltcgTax: parseFloat((document.getElementById('ltcgTax') as HTMLInputElement)?.value || '12.5'),
			horizonYears: parseInt((document.getElementById('horizonYears') as HTMLInputElement)?.value || '30', 10),
			useGuardrails: (document.getElementById('useGuardrails') as HTMLInputElement)?.checked || false,
			numSimulations: 10000,
		};

		worker?.postMessage(payload);
	}

	// Render Schedule Table with Tight Proportional Padding (Eliminating Excess Gaps)
	function renderScheduleTable(
		initialMonthly: number, 
		expectedInflation: number, 
		annualStepUp: number, 
		yearsCount: number,
		initialCorpus: number,
		p50Array: number[] = [],
		medianTaxesArray: number[] = [],
		medianWithdrawalsArray: number[] = []
	) {
		const tableBody = document.getElementById('scheduleTableBody');
		const badgeEl = document.getElementById('scheduleStepUpBadge');
		if (badgeEl) {
			badgeEl.innerText = `+${expectedInflation}% Inflation & +${annualStepUp}% Step-Up`;
		}

		if (!tableBody) return;

		// 1. Instantiate Strict Table Currency Formatter (en-IN, INR, 0 decimals)
		const tableFormatter = new Intl.NumberFormat('en-IN', { 
			style: 'currency', 
			currency: 'INR', 
			maximumFractionDigits: 0 
		});

		let html = '';
		let currentMonthly = initialMonthly;
		const escalationFactor = (1 + expectedInflation / 100) * (1 + annualStepUp / 100);

		for (let yr = 1; yr <= yearsCount; yr++) {
			const i = yr - 1; // 0-indexed loop counter for zebra striping
			const rowBgClass = i % 2 === 1 ? 'bg-slate-50 dark:bg-zinc-900/50' : 'bg-transparent';

			if (yr > 1) {
				currentMonthly = currentMonthly * escalationFactor;
			}

			const currentBal = (p50Array && p50Array[yr] !== undefined) ? p50Array[yr] : 0;
			const prevBal = (yr === 1) ? initialCorpus : ((p50Array && p50Array[yr - 1] !== undefined) ? p50Array[yr - 1] : 0);

			if (prevBal <= 0 && currentBal <= 0) {
				// Case C: Ghost Years (Post-Exhaustion) - Muted visual text to indicate dead plan
				html += `
					<tr class="${rowBgClass} hover:bg-slate-100 dark:hover:bg-zinc-900 transition-colors border-b border-slate-100 dark:border-white/10">
						<td class="py-3 px-3 sm:px-4 text-left whitespace-nowrap text-sm font-medium text-slate-400 dark:text-zinc-600">Year ${yr}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-slate-300 dark:text-zinc-600">${tableFormatter.format(0)}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-slate-300 dark:text-zinc-600">${tableFormatter.format(0)}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-slate-300 dark:text-zinc-600">${tableFormatter.format(0)}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-slate-300 dark:text-zinc-600">-</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-slate-300 dark:text-zinc-600">${tableFormatter.format(0)}</td>
					</tr>
				`;
			} else if (prevBal > 0 && currentBal <= 0) {
				// Case B: The "Death Row" (The Final Partial Year)
				const grossExtracted = (medianWithdrawalsArray && medianWithdrawalsArray[yr] !== undefined) ? medianWithdrawalsArray[yr] : prevBal;
				const annualTax = (medianTaxesArray && medianTaxesArray[yr] !== undefined) ? medianTaxesArray[yr] : 0;
				const netExtracted = Math.max(0, grossExtracted - annualTax);

				const formattedTargetMonthly = tableFormatter.format(Math.round(currentMonthly));
				const formattedNetAnnual = tableFormatter.format(Math.round(netExtracted));
				const formattedAnnualTax = tableFormatter.format(Math.round(annualTax));

				html += `
					<tr class="${rowBgClass} hover:bg-slate-100 dark:hover:bg-zinc-900 transition-colors border-b border-slate-100 dark:border-white/10">
						<td class="py-3 px-3 sm:px-4 text-left whitespace-nowrap text-sm font-semibold text-slate-800 dark:text-zinc-200">Year ${yr}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-emerald-600 dark:text-emerald-400">${formattedTargetMonthly}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-amber-600 dark:text-amber-400">${formattedNetAnnual}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-rose-600 dark:text-rose-400">${formattedAnnualTax}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-slate-400 dark:text-zinc-500">-</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-rose-600 dark:text-rose-400">${tableFormatter.format(0)}</td>
					</tr>
				`;
			} else {
				// Case A: Active Surviving Year
				let grossAnnual = currentMonthly * 12;
				if (medianWithdrawalsArray && medianWithdrawalsArray[yr] !== undefined) {
					grossAnnual = medianWithdrawalsArray[yr];
				}
				
				const annualTax = (medianTaxesArray && medianTaxesArray[yr] !== undefined) ? medianTaxesArray[yr] : 0;
				const netAnnual = Math.max(0, grossAnnual - annualTax);
				const netMonthly = grossAnnual > 0 ? netAnnual / 12 : 0;

				const growth = currentBal - prevBal;

				const formattedNetMonthly = tableFormatter.format(Math.round(netMonthly));
				const formattedNetAnnual = tableFormatter.format(Math.round(netAnnual));
				const formattedAnnualTax = tableFormatter.format(Math.round(annualTax));
				
				const formattedGrowth = growth >= 0 
					? `+${tableFormatter.format(Math.round(growth))}` 
					: `-${tableFormatter.format(Math.round(Math.abs(growth)))}`;
				const growthColorClass = growth >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400';
				const formattedBal = tableFormatter.format(Math.round(currentBal));

				html += `
					<tr class="${rowBgClass} hover:bg-slate-100 dark:hover:bg-zinc-900 transition-colors border-b border-slate-100 dark:border-white/10">
						<td class="py-3 px-3 sm:px-4 text-left whitespace-nowrap text-sm font-semibold text-slate-800 dark:text-zinc-200">Year ${yr}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-emerald-600 dark:text-emerald-400">${formattedNetMonthly}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-emerald-600 dark:text-emerald-400">${formattedNetAnnual}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-rose-600 dark:text-rose-400">${formattedAnnualTax}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium ${growthColorClass}">${formattedGrowth}</td>
						<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-slate-900 dark:text-zinc-100">${formattedBal}</td>
					</tr>
				`;
			}
		}

		tableBody.innerHTML = html;
	}

	// Render Interactive Micro-Chart (Paycheck Growth vs Savings Balance)
	function renderMicroCashflowChart(data: any) {
		const canvas = document.getElementById('cashflowMicroChart') as HTMLCanvasElement;
		if (!canvas) return;

		if (microChartInstance) {
			microChartInstance.destroy();
			microChartInstance = null;
		}

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const initialMonthly = parseRawNumber((document.getElementById('monthlyWithdrawal') as HTMLInputElement)?.value || 50000);
		const expectedInflation = parseFloat((document.getElementById('expectedInflation') as HTMLInputElement)?.value || '6');
		const annualStepUp = parseFloat((document.getElementById('annualStepUp') as HTMLInputElement)?.value || '5');
		const horizonYears = parseInt((document.getElementById('horizonYears') as HTMLInputElement)?.value || '30', 10);
		const escalationFactor = (1 + expectedInflation / 100) * (1 + annualStepUp / 100);

		const labels = ['Yr 0'];
		const actualMonthlyData: number[] = data.actualPaycheckTimeline ? [...data.actualPaycheckTimeline] : [initialMonthly];
		const idealMonthlyData: number[] = data.idealPaycheckTimeline ? [...data.idealPaycheckTimeline] : [initialMonthly];
		const corpusData: number[] = [parseRawNumber((document.getElementById('initialCorpus') as HTMLInputElement)?.value || 10000000)];

		if (!data.actualPaycheckTimeline || !data.idealPaycheckTimeline) {
			let currentMonthly = initialMonthly;
			let idealMonthly = initialMonthly;
			for (let yr = 1; yr <= horizonYears; yr++) {
				labels.push(`Yr ${yr}`);
				if (yr > 1) {
					currentMonthly = currentMonthly * escalationFactor;
					idealMonthly = idealMonthly * escalationFactor;
				}
				let grossAnnual = currentMonthly * 12;
				if (data.medianWithdrawals && data.medianWithdrawals[yr] !== undefined) {
					grossAnnual = data.medianWithdrawals[yr];
				}
				const annualTax = (data.medianTaxes && data.medianTaxes[yr] !== undefined) ? data.medianTaxes[yr] : 0;
				const netAnnual = Math.max(0, grossAnnual - annualTax);
				actualMonthlyData.push(grossAnnual > 0 ? Math.round(netAnnual / 12) : 0);
				idealMonthlyData.push(Math.round(idealMonthly));

				const bal = (data.p50 && data.p50[yr] !== undefined) ? data.p50[yr] : 0;
				corpusData.push(bal);
			}
		} else {
			for (let yr = 1; yr <= horizonYears; yr++) {
				labels.push(`Yr ${yr}`);
				const bal = (data.p50 && data.p50[yr] !== undefined) ? data.p50[yr] : 0;
				corpusData.push(bal);
			}
		}

		const isDark = document.documentElement.classList.contains('dark');
		const tickColor = isDark ? '#94a3b8' : '#64748b';

		microChartInstance = new (window as any).Chart(ctx, {
			type: 'line',
			data: {
				labels,
				datasets: [
					{
						label: 'Actual Income (Realized)',
						data: actualMonthlyData,
						borderColor: isDark ? '#818cf8' : '#4f46e5',
						backgroundColor: 'transparent',
						borderWidth: 2.5,
						borderDash: [],
						pointRadius: 0,
						tension: 0.4,
						yAxisID: 'y'
					},
					{
						label: 'Ideal Income (Target)',
						data: idealMonthlyData,
						borderColor: isDark ? '#fbbf24' : '#d97706',
						backgroundColor: 'transparent',
						borderWidth: 1.5,
						borderDash: [5, 5],
						fill: false,
						pointRadius: 0,
						tension: 0.4,
						yAxisID: 'y'
					},
					{
						label: 'Savings Balance (₹)',
						data: corpusData,
						borderColor: isDark ? '#34d399' : '#059669',
						backgroundColor: 'transparent',
						borderWidth: 2,
						borderDash: [4, 4],
						pointRadius: 0,
						tension: 0.4,
						yAxisID: 'y1'
					}
				]
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				animation: { duration: 300 },
				interaction: { mode: 'index', intersect: false },
				plugins: {
					legend: { display: false },
					tooltip: {
						backgroundColor: '#0f172a',
						borderColor: '#334155',
						borderWidth: 1,
						titleColor: '#f8fafc',
						bodyColor: '#e2e8f0',
						padding: 10,
						callbacks: {
							label: function (context: any) {
								const val = context.raw;
								if (context.datasetIndex === 0) {
									return ` Actual Income (Realized): ₹ ${Math.round(val).toLocaleString('en-IN')}`;
								} else if (context.datasetIndex === 1) {
									return ` Ideal Income (Target): ₹ ${Math.round(val).toLocaleString('en-IN')}`;
								} else {
									return ` Balance: ${formatShortRupee(val)}`;
								}
							}
						}
					}
				},
				scales: {
					x: {
						grid: { display: false },
						ticks: { color: tickColor, font: { family: 'Inter', size: 10 }, maxTicksLimit: 8 }
					},
					y: {
						type: 'linear',
						display: true,
						position: 'left',
						grid: { display: false },
						ticks: {
							color: isDark ? '#818cf8' : '#4f46e5',
							font: { family: 'Inter', size: 10 },
							callback: function(val: any) {
								return `₹${Math.round(val / 1000)}k`;
							}
						}
					},
					y1: {
						type: 'linear',
						display: true,
						position: 'right',
						grid: { display: false },
						ticks: {
							color: isDark ? '#34d399' : '#059669',
							font: { family: 'Inter', size: 10 },
							callback: function(val: any) {
								if (val >= 10000000) return `₹${(val / 10000000).toFixed(1)}Cr`;
								if (val >= 100000) return `₹${(val / 100000).toFixed(0)}L`;
								return `₹${val}`;
							}
						}
					}
				}
			}
		});
	}

	// Handle Worker Output Data & Render Command Center Results
	function handleWorkerResponse(data: any) {
		if (runBtn) {
			runBtn.disabled = false;
			runBtn.innerHTML = `
				<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
					<path d="M8 5v14l11-7z"/>
				</svg>
				<span class="text-sm font-semibold">Run 10,000 Market Simulations</span>
			`;
		}

		if (!data) return;

		const inputCorpus = parseRawNumber((document.getElementById('initialCorpus') as HTMLInputElement)?.value || 10000000);
		const initialMonthly = parseRawNumber((document.getElementById('monthlyWithdrawal') as HTMLInputElement)?.value || 50000);
		const expectedInflation = parseFloat((document.getElementById('expectedInflation') as HTMLInputElement)?.value || '6');
		const annualStepUp = parseFloat((document.getElementById('annualStepUp') as HTMLInputElement)?.value || '5');
		const horizonYears = parseInt((document.getElementById('horizonYears') as HTMLInputElement)?.value || '30', 10);
		const annualWithdrawal = initialMonthly * 12;

		// 1. Calculate Exact Fractional Survival Duration (Years & Months) and Final Balance Remaining
		let deathYear = (data.p50 || []).findIndex((balance: number, idx: number) => idx > 0 && balance <= 0);
		let balanceRemaining = 0;
		let durationString = `${horizonYears} Years`;
		let actualDuration = horizonYears;
		let survivedMonths = 0;

		if (deathYear === -1) {
			actualDuration = horizonYears;
			balanceRemaining = (data.p50 && data.p50[horizonYears] !== undefined) ? data.p50[horizonYears] : 0;
			durationString = `${horizonYears} Years`;
			survivedMonths = 0;
		} else {
			actualDuration = deathYear;
			balanceRemaining = 0;

			const completedYears = deathYear - 1;
			const startingBalance = (data.p50 && data.p50[completedYears] !== undefined) ? data.p50[completedYears] : 0;

			// Net Monthly Withdrawal for the final partial year
			const escalationFactor = (1 + expectedInflation / 100) * (1 + annualStepUp / 100);
			const deathYearGrossMonthly = initialMonthly * Math.pow(escalationFactor, completedYears);
			const deathYearGrossAnnual = deathYearGrossMonthly * 12;
			const deathYearTax = (data.medianTaxes && data.medianTaxes[deathYear] !== undefined) ? data.medianTaxes[deathYear] : 0;
			const deathYearNetAnnual = Math.max(0, deathYearGrossAnnual - deathYearTax);
			const deathYearNetMonthly = deathYearNetAnnual > 0 ? deathYearNetAnnual / 12 : deathYearGrossMonthly;

			survivedMonths = deathYearNetMonthly > 0 ? Math.floor(startingBalance / deathYearNetMonthly) : 0;
			survivedMonths = Math.min(11, Math.max(0, survivedMonths));

			if (survivedMonths > 0) {
				durationString = `${completedYears} Yrs, ${survivedMonths} Mos`;
			} else {
				durationString = `${completedYears} Years`;
			}
		}

		// 2. Actionable Portfolio Health & Endurance Hero Metric, Health Badge, and Reality Check Subtext
		const enduranceHeroEl = document.getElementById('portfolioEnduranceHero');
		const healthBadgeEl = document.getElementById('portfolioHealthBadge');
		const guardrailsActiveBadgeEl = document.getElementById('guardrailsActiveBadge');
		const realityCheckEl = document.getElementById('portfolioRealityCheck');

		if (guardrailsActiveBadgeEl) {
			if (data.useGuardrails) {
				guardrailsActiveBadgeEl.classList.remove('hidden');
			} else {
				guardrailsActiveBadgeEl.classList.add('hidden');
			}
		}

		if (enduranceHeroEl && healthBadgeEl && realityCheckEl) {
			enduranceHeroEl.innerText = durationString;

			if (actualDuration >= horizonYears) {
				enduranceHeroEl.className = "text-3xl sm:text-4xl font-extrabold tracking-tight font-sans text-emerald-600 dark:text-emerald-400";
				healthBadgeEl.innerText = "SAFE";
				healthBadgeEl.className = "px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800";
			} else if (actualDuration >= 20) {
				enduranceHeroEl.className = "text-3xl sm:text-4xl font-extrabold tracking-tight font-sans text-amber-600 dark:text-amber-400";
				healthBadgeEl.innerText = "AT RISK";
				healthBadgeEl.className = "px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 border border-amber-200 dark:border-amber-800";
			} else {
				enduranceHeroEl.className = "text-3xl sm:text-4xl font-extrabold tracking-tight font-sans text-rose-600 dark:text-rose-400";
				healthBadgeEl.innerText = "AGGRESSIVE DEPLETION";
				healthBadgeEl.className = "px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200 dark:border-rose-800";
			}

			if (data.useGuardrails) {
				realityCheckEl.innerHTML = `Based on 10,000 stress tests with Guardrails active. Your portfolio survived by automatically reducing your monthly lifestyle payouts during severe market crashes.`;
			} else {
				if (actualDuration >= horizonYears) {
					realityCheckEl.innerHTML = `Based on 10,000 market stress tests, your savings comfortably survive your full <strong class="font-semibold text-slate-800 dark:text-zinc-200">${horizonYears}-year</strong> retirement target while compounding against inflation.`;
				} else if (actualDuration >= 20) {
					realityCheckEl.innerHTML = `Based on 10,000 market stress tests, your savings are projected to exhaust in <strong class="font-semibold text-slate-800 dark:text-zinc-200">${durationString}</strong> due to the combined drag of inflation, step-up payouts, and market volatility.`;
				} else {
					realityCheckEl.innerHTML = `Based on 10,000 market stress tests, your savings are projected to exhaust rapidly in <strong class="font-semibold text-slate-800 dark:text-zinc-200">${durationString}</strong> due to heavy initial withdrawal pressure.`;
				}
			}
		}

		// Lifestyle Degradation / Prosperity Bonus Alert Box DOM Update
		const sacrificeAlertBoxEl = document.getElementById('lifestyleSacrificeAlertBox');
		const sacrificeTitleEl = document.getElementById('sacrificeTitle');
		const sacrificeMetric1El = document.getElementById('sacrificeMetric1');
		const sacrificeMetric2El = document.getElementById('sacrificeMetric2');

		if (sacrificeAlertBoxEl) {
			if (data.useGuardrails && data.lifestyleSacrificeAmount !== undefined && data.lifestyleSacrificeAmount !== 0) {
				if (data.lifestyleSacrificeAmount > 0) {
					// Lifestyle Degradation Alert (Amber)
					sacrificeAlertBoxEl.className = "mt-4 p-4 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/60 rounded-xl space-y-2.5 transition-colors duration-200";
					if (sacrificeTitleEl) {
						sacrificeTitleEl.className = "text-xs font-bold text-amber-900 dark:text-amber-200 uppercase tracking-wider";
						sacrificeTitleEl.innerText = "Lifestyle Degradation Alert";
					}
					if (sacrificeMetric1El) {
						sacrificeMetric1El.className = "text-xs text-amber-800 dark:text-amber-300 leading-relaxed font-sans";
						sacrificeMetric1El.innerHTML = `To force your portfolio to survive, the system withheld <strong class="font-bold text-amber-950 dark:text-amber-100">${tableFormatter.format(data.lifestyleSacrificeAmount)}</strong> in planned lifetime income.`;
					}
					if (sacrificeMetric2El) {
						sacrificeMetric2El.className = "text-xs text-amber-800 dark:text-amber-300 leading-relaxed font-sans";
						sacrificeMetric2El.innerHTML = `During market drops, your monthly paycheck took a cut. At its lowest point, your income dropped to the equivalent purchasing power of <strong class="font-bold text-amber-950 dark:text-amber-100">${tableFormatter.format(data.rockBottomRealValue)}</strong> in today's money.`;
					}
				} else {
					// Prosperity Bonus Alert (Green / Emerald)
					const bonusAmount = Math.abs(data.lifestyleSacrificeAmount);
					sacrificeAlertBoxEl.className = "mt-4 p-4 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900/60 rounded-xl space-y-2.5 transition-colors duration-200";
					if (sacrificeTitleEl) {
						sacrificeTitleEl.className = "text-xs font-bold text-emerald-900 dark:text-emerald-200 uppercase tracking-wider";
						sacrificeTitleEl.innerText = "Prosperity Bonus Alert";
					}
					if (sacrificeMetric1El) {
						sacrificeMetric1El.className = "text-xs text-emerald-800 dark:text-emerald-300 leading-relaxed font-sans";
						sacrificeMetric1El.innerHTML = `Thanks to strong market growth, the Guyton-Klinger Prosperity Rule awarded you an extra <strong class="font-bold text-emerald-950 dark:text-emerald-100">${tableFormatter.format(bonusAmount)}</strong> in bonus lifetime income above your initial baseline plan!`;
					}
					if (sacrificeMetric2El) {
						sacrificeMetric2El.className = "text-xs text-emerald-800 dark:text-emerald-300 leading-relaxed font-sans";
						sacrificeMetric2El.innerHTML = `During bull runs, your monthly paycheck automatically stepped up to let you enjoy your compounding wealth.`;
					}
				}
				sacrificeAlertBoxEl.classList.remove('hidden');
			} else {
				sacrificeAlertBoxEl.classList.add('hidden');
			}
		}

		// Weather Forecast Heatmap Render Logic
		const weatherContainerEl = document.getElementById('weatherForecastContainer');
		const weatherGridEl = document.getElementById('weatherGrid');

		if (weatherContainerEl && weatherGridEl) {
			if (data.useGuardrails && data.actualPaycheckTimeline && data.idealPaycheckTimeline) {
				let gridHtml = '';
				const horizon = parseInt((document.getElementById('horizonYears') as HTMLInputElement)?.value || '30', 10);
				
				for (let yr = 1; yr <= horizon; yr++) {
					// Default to full pay if data is missing for that specific year
					const actual = data.actualPaycheckTimeline[yr] || 0;
					const ideal = data.idealPaycheckTimeline[yr] || 0;
					
					// If actual is strictly less than ideal (allowing a tiny margin for float rounding)
					if (actual < (ideal - 10)) {
						// Pay Cut Triggered (Amber Block)
						gridHtml += `<div class="w-full aspect-square bg-amber-500/90 rounded-sm border border-amber-600/50" title="Year ${yr}: Pay Cut Triggered"></div>`;
					} else {
						// Full Paycheck (Emerald Block)
						gridHtml += `<div class="w-full aspect-square bg-emerald-500/80 rounded-sm border border-emerald-600/30" title="Year ${yr}: Full Paycheck"></div>`;
					}
				}
				
				weatherGridEl.innerHTML = gridHtml;
				weatherContainerEl.classList.remove('hidden');
			} else {
				weatherContainerEl.classList.add('hidden');
				weatherGridEl.innerHTML = '';
			}
		}

		// 3. Compute Total Gross, Total Taxes, and Net Lifetime Payouts for 5-Column Dashboard Grid
		let totalGrossPayout = 0;
		let totalTaxesPaid = 0;
		let totalNetPayout = 0;
		let currentMonthly = initialMonthly;
		const escalationFactor = (1 + expectedInflation / 100) * (1 + annualStepUp / 100);

		for (let yr = 1; yr <= horizonYears; yr++) {
			if (yr > 1) {
				currentMonthly = currentMonthly * escalationFactor;
			}
			let grossAnnual = currentMonthly * 12;
			if (data.medianWithdrawals && data.medianWithdrawals[yr] !== undefined) {
				grossAnnual = data.medianWithdrawals[yr];
			}
			const annualTax = (data.medianTaxes && data.medianTaxes[yr] !== undefined) ? data.medianTaxes[yr] : 0;
			const netAnnual = Math.max(0, grossAnnual - annualTax);

			totalGrossPayout += grossAnnual;
			totalTaxesPaid += annualTax;
			totalNetPayout += netAnnual;
		}

		// Tier 1 DOM Updates
		const wowInitialCorpusEl = document.getElementById('wowInitialCorpus');
		if (wowInitialCorpusEl) wowInitialCorpusEl.innerText = formatShortRupee(inputCorpus);

		const wowNetPayoutEl = document.getElementById('wowNetPayout');
		if (wowNetPayoutEl) wowNetPayoutEl.innerText = formatShortRupee(totalNetPayout);

		const multiplierBadgeEl = document.getElementById('wowMultiplierBadge');
		if (multiplierBadgeEl) {
			const mult = inputCorpus > 0 ? (totalNetPayout / inputCorpus).toFixed(1) : '0';
			multiplierBadgeEl.innerText = `${mult}x Lifetime Payout`;
		}

		// Tier 2 Ledger 5-Column Grid DOM Updates (Inject calculated durationString)
		const t2DurationEl = document.getElementById('tier2Duration');
		if (t2DurationEl) t2DurationEl.innerText = durationString;

		const t2GrossEl = document.getElementById('tier2Gross');
		if (t2GrossEl) t2GrossEl.innerText = formatShortRupee(totalGrossPayout);

		const t2TaxesEl = document.getElementById('tier2Taxes');
		if (t2TaxesEl) t2TaxesEl.innerText = formatShortRupee(totalTaxesPaid);

		const t2NetEl = document.getElementById('tier2Net');
		if (t2NetEl) t2NetEl.innerText = formatShortRupee(totalNetPayout);

		const t2BalRemEl = document.getElementById('tier2BalanceRemaining');
		if (t2BalRemEl) t2BalRemEl.innerText = formatShortRupee(balanceRemaining);

		// Guardrails Lowest Paycheck & Purchasing Power Metrics DOM Update
		const guardrailsLowestRowEl = document.getElementById('guardrailsLowestPaycheckRow');
		const valLowestPaycheckEl = document.getElementById('valLowestPaycheck');
		const valRockBottomEl = document.getElementById('valRockBottom');
		const valSacrificeEl = document.getElementById('valSacrifice');

		if (guardrailsLowestRowEl) {
			if (data.useGuardrails) {
				if (valLowestPaycheckEl && data.lowestMonthlyPaycheck) {
					valLowestPaycheckEl.innerText = tableFormatter.format(data.lowestMonthlyPaycheck);
				}
				if (valRockBottomEl && data.rockBottomRealValue !== undefined) {
					valRockBottomEl.innerText = tableFormatter.format(data.rockBottomRealValue);
				}
				if (valSacrificeEl && data.lifestyleSacrificeAmount !== undefined) {
					valSacrificeEl.innerText = formatShortRupee(data.lifestyleSacrificeAmount);
				}
				guardrailsLowestRowEl.classList.remove('hidden');
			} else {
				guardrailsLowestRowEl.classList.add('hidden');
			}
		}

		// Tier 3 Actionable Footer DOM Update (Proportional Reduction Algorithm)
		let currentPaycheck = initialMonthly;
		let targetMonths = horizonYears * 12;
		let survivedTotalMonths = (actualDuration - 1) * 12 + survivedMonths;

		let recommendedPaycheck = currentPaycheck;
		if (survivedTotalMonths < targetMonths) {
			let survivalRatio = survivedTotalMonths / targetMonths;
			recommendedPaycheck = Math.floor(currentPaycheck * survivalRatio * 0.95);
		}

		const formattedRecommendedPaycheck = tableFormatter.format(recommendedPaycheck);

		const tier3El = document.getElementById('tier3ActionableFooter');
		if (tier3El) {
			if (survivedTotalMonths < targetMonths) {
				tier3El.innerHTML = `At your requested rate, this plan mathematically exhausts in <strong class="font-bold text-slate-900 dark:text-white">${durationString}</strong>. To ensure it safely lasts your full <strong class="font-bold text-slate-900 dark:text-white">${horizonYears}-year</strong> target, experts recommend a starting paycheck of no more than <strong class="font-bold text-emerald-600 dark:text-emerald-400">${formattedRecommendedPaycheck}</strong> per month.`;
			} else {
				tier3El.innerHTML = `At your requested rate, this plan comfortably funds your entire <strong class="font-bold text-slate-900 dark:text-white">${horizonYears}-year</strong> retirement target with a high probability of success.`;
			}
		}

		// 4. Render Interactive Micro-Chart
		renderMicroCashflowChart(data);

		// 5. Calculate & Inject Perpetual Income Targets (Cards 1 & 2)
		const realRate = Math.max(0.001, (7 - expectedInflation) / 100);
		const requiredCorpus = annualWithdrawal / realRate;
		const reqCorpusEl = document.getElementById('statRequiredCorpus');
		if (reqCorpusEl) reqCorpusEl.innerText = formatShortRupee(requiredCorpus);

		// Institutional Hurdle Rate Algorithm (Accounting for Tax Drag & Volatility Drain)
		let startingCorpus = inputCorpus;
		let iwr = (annualWithdrawal / startingCorpus) * 100;
		let netRequired = iwr + expectedInflation;
		let marketVolatility = parseFloat((document.getElementById('annualVolatility') as HTMLInputElement)?.value || '15');
		let volatilityDrag = Math.pow(marketVolatility, 2) / 200;
		let ltcgTaxRate = parseFloat((document.getElementById('ltcgTax') as HTMLInputElement)?.value || '12.5');
		let requiredCAGR = (netRequired / (1 - (ltcgTaxRate / 100))) + volatilityDrag;

		const reqCagrEl = document.getElementById('statRequiredCAGR');
		if (reqCagrEl) reqCagrEl.innerText = requiredCAGR.toFixed(2) + '%';

		// 6. Render Schedule Table with Natural Proportional Spacing
		renderScheduleTable(initialMonthly, expectedInflation, annualStepUp, horizonYears, inputCorpus, data.p50, data.medianTaxes, data.medianWithdrawals);

		// 7. Render Common-Man Friendly Adaptive Chart.js
		renderConsumerChart(data);
	}

	// Render Dynamic Light/Dark Theme Adaptable Chart.js Line Chart with Friendly Labels
	function renderConsumerChart(data: any) {
		const canvas = document.getElementById('swpChart') as HTMLCanvasElement;
		if (!canvas) return;

		if (chartInstance) {
			chartInstance.destroy();
			chartInstance = null;
		}

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const labels = data.years.map((y: number) => `Year ${y}`);
		const isDark = document.documentElement.classList.contains('dark');

		const gridColor = isDark ? 'rgba(255, 255, 255, 0.1)' : '#e2e8f0';
		const tickTextColor = isDark ? '#a1a1aa' : '#64748b';
		const axisTitleColor = isDark ? '#d4d4d8' : '#475569';
		const expectedLineColor = isDark ? '#f4f4f5' : '#0f172a';
		const bestLineColor = isDark ? '#34d399' : '#059669';
		const worstLineColor = isDark ? '#f87171' : '#dc2626';

		let datasets = [];

		if (activeViewMode === 'percentiles') {
			datasets = [
				{
					label: 'Optimistic (Strong Markets)',
					data: data.p90,
					borderColor: bestLineColor,
					backgroundColor: isDark ? 'rgba(52, 211, 153, 0.04)' : 'rgba(5, 150, 105, 0.04)',
					borderWidth: 2,
					pointRadius: 0,
					tension: 0.3,
					fill: false
				},
				{
					label: 'Expected Path',
					data: data.p50,
					borderColor: expectedLineColor,
					backgroundColor: isDark ? 'rgba(244, 244, 245, 0.04)' : 'rgba(15, 23, 42, 0.04)',
					borderWidth: 2.5,
					pointRadius: 0,
					tension: 0.3,
					fill: false
				},
				{
					label: 'Conservative (Poor Markets)',
					data: data.p10,
					borderColor: worstLineColor,
					backgroundColor: isDark ? 'rgba(248, 113, 113, 0.04)' : 'rgba(220, 38, 38, 0.04)',
					borderWidth: 2,
					pointRadius: 0,
					tension: 0.3,
					fill: false
				}
			];
		} else {
			const pathColors = [
				'#38bdf8', '#818cf8', '#c084fc', '#f472b6', '#fb7185',
				'#34d399', '#a3e635', '#facc15', '#fb923c', '#a1a1aa'
			];
			datasets = (data.samplePaths || []).map((path: number[], idx: number) => ({
				label: `Simulated Lifetime #${idx + 1}`,
				data: path,
				borderColor: pathColors[idx % pathColors.length],
				borderWidth: 1.25,
				pointRadius: 0,
				tension: 0.3,
				fill: false
			}));
		}

		chartInstance = new (window as any).Chart(ctx, {
			type: 'line',
			data: {
				labels,
				datasets
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				animation: { duration: 300 },
				interaction: {
					mode: 'index',
					intersect: false,
				},
				plugins: {
					legend: { display: false },
					tooltip: {
						backgroundColor: isDark ? '#000000' : '#0f172a',
						borderColor: isDark ? 'rgba(255, 255, 255, 0.15)' : '#334155',
						borderWidth: 1,
						titleColor: '#f8fafc',
						bodyColor: '#e2e8f0',
						padding: 12,
						displayColors: true,
						callbacks: {
							label: function (context: any) {
								const val = context.raw;
								let formatted = val;
								if (typeof val === 'number') {
									if (val >= 10000000) formatted = `₹ ${(val / 10000000).toFixed(2)} Cr`;
									else if (val >= 100000) formatted = `₹ ${(val / 100000).toFixed(2)} Lakh`;
									else formatted = `₹ ${val.toLocaleString('en-IN')}`;
								}
								return ` ${context.dataset.label}: ${formatted}`;
							}
						}
					}
				},
				scales: {
					x: {
						border: { color: gridColor },
						grid: { display: false },
						ticks: { color: tickTextColor, font: { family: 'Inter', size: 11 } },
						title: { display: true, text: 'Retirement Horizon (Years)', color: axisTitleColor, font: { family: 'Inter', size: 11 } }
					},
					y: {
						border: { color: gridColor },
						grid: { color: gridColor },
						ticks: {
							color: tickTextColor,
							font: { family: 'Inter', size: 11 },
							callback: function (val: any) {
								if (val >= 10000000) return `₹${(val / 10000000).toFixed(1)}Cr`;
								if (val >= 100000) return `₹${(val / 100000).toFixed(0)}L`;
								return `₹${val}`;
							}
						},
						title: { display: true, text: 'Portfolio Balance (₹)', color: axisTitleColor, font: { family: 'Inter', size: 11 } }
					}
				}
			}
		});
	}

	viewPercentilesBtn?.addEventListener('click', () => {
		activeViewMode = 'percentiles';
		viewPercentilesBtn.className = 'min-h-[36px] px-3 py-1 rounded-md bg-white dark:bg-black text-slate-900 dark:text-zinc-100 font-semibold shadow-xs transition-colors flex items-center';
		viewSamplePathsBtn!.className = 'min-h-[36px] px-3 py-1 rounded-md text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-200 transition-colors flex items-center';
		if (lastWorkerResponse) renderConsumerChart(lastWorkerResponse);
	});

	viewSamplePathsBtn?.addEventListener('click', () => {
		activeViewMode = 'samples';
		viewSamplePathsBtn.className = 'min-h-[36px] px-3 py-1 rounded-md bg-white dark:bg-black text-slate-900 dark:text-zinc-100 font-semibold shadow-xs transition-colors flex items-center';
		viewPercentilesBtn!.className = 'min-h-[36px] px-3 py-1 rounded-md text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-zinc-200 transition-colors flex items-center';
		if (lastWorkerResponse) renderConsumerChart(lastWorkerResponse);
	});

	setupFormattingField(corpusInput, updateDisplayBadges);
	setupFormattingField(withdrawalInput, updateDisplayBadges);

	runBtn?.addEventListener('click', triggerSimulation);

	function startApp() {
		initTabNavigation();
		initThemeMachine();
		updateDisplayBadges();
		initWorker();
		triggerSimulation();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', startApp);
	} else {
		startApp();
	}
</script>
