---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('direct-tax');
const articleCount = allArticles.length;
const articleEntries = allArticles.slice(0, 6).map(art => [art.id, art.data]);
---

<Layout title="FinSight India — Financial Decision Intelligence Platform" description="Transforming financial calculations into guided, explainable decision intelligence. Tax optimization, retirement longevity, insurance deconstruction, and wealth accumulation.">

	<!-- ====================================================
	     1. HERO SECTION — Intent-Driven Decision Intelligence
	     ==================================================== -->
	<section class="hero-glow relative overflow-hidden">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-28">
			<div class="text-center max-w-4xl mx-auto space-y-8 reveal">
				
				<div class="inline-flex items-center gap-2 px-4 py-1.5 bg-gold-500/10 border border-gold-500/20 rounded-full">
					<div class="w-2 h-2 rounded-full bg-emerald-500 animate-glow-pulse"></div>
					<span class="text-xs font-semibold tracking-wider text-gold-600 dark:text-gold-400 uppercase">Decision Intelligence • 100% Client-Side • Privacy-First</span>
				</div>

				<h1 class="text-hero text-navy-900 dark:text-navy-100 font-extrabold tracking-tight">
					What financial decision are you trying to make today?
				</h1>

				<p class="text-lg sm:text-xl text-navy-600 dark:text-navy-300 leading-relaxed max-w-3xl mx-auto">
					FinSight transforms raw financial calculations into guided, explainable decision intelligence. Connect deep tax research with institutional quantitative models to make confident choices.
				</p>

				<!-- QUICK INTENT SELECTOR PILLS -->
				<div class="pt-2">
					<p class="text-xs font-bold uppercase tracking-widest text-navy-400 dark:text-navy-500 mb-4">Select your decision intent to navigate:</p>
					<div class="flex flex-wrap justify-center gap-2.5 max-w-4xl mx-auto">
						<button data-intent="hub-tax" class="intent-btn group flex items-center gap-2 px-4 py-2.5 rounded-full bg-navy-100/80 dark:bg-navy-800/80 border border-navy-200 dark:border-navy-700 hover:border-gold-500/50 hover:bg-gold-500/10 transition-all text-xs sm:text-sm font-medium text-navy-800 dark:text-navy-200 cursor-pointer">
							<span>💼</span>
							<span>"Legally reduce my income tax"</span>
							<span class="text-gold-500 group-hover:translate-y-0.5 transition-transform">↓</span>
						</button>
						<button data-intent="hub-retirement" class="intent-btn group flex items-center gap-2 px-4 py-2.5 rounded-full bg-navy-100/80 dark:bg-navy-800/80 border border-navy-200 dark:border-navy-700 hover:border-gold-500/50 hover:bg-gold-500/10 transition-all text-xs sm:text-sm font-medium text-navy-800 dark:text-navy-200 cursor-pointer">
							<span>🌴</span>
							<span>"Survive 30+ years of retirement"</span>
							<span class="text-gold-500 group-hover:translate-y-0.5 transition-transform">↓</span>
						</button>
						<button data-intent="hub-insurance" class="intent-btn group flex items-center gap-2 px-4 py-2.5 rounded-full bg-navy-100/80 dark:bg-navy-800/80 border border-navy-200 dark:border-navy-700 hover:border-gold-500/50 hover:bg-gold-500/10 transition-all text-xs sm:text-sm font-medium text-navy-800 dark:text-navy-200 cursor-pointer">
							<span>📜</span>
							<span>"Evaluate guaranteed insurance policy ROI"</span>
							<span class="text-gold-500 group-hover:translate-y-0.5 transition-transform">↓</span>
						</button>
						<button data-intent="hub-wealth" class="intent-btn group flex items-center gap-2 px-4 py-2.5 rounded-full bg-navy-100/80 dark:bg-navy-800/80 border border-navy-200 dark:border-navy-700 hover:border-gold-500/50 hover:bg-gold-500/10 transition-all text-xs sm:text-sm font-medium text-navy-800 dark:text-navy-200 cursor-pointer">
							<span>📈</span>
							<span>"Calculate required monthly SIP"</span>
							<span class="text-gold-500 group-hover:translate-y-0.5 transition-transform">↓</span>
						</button>
						<button data-intent="hub-hedging" class="intent-btn group flex items-center gap-2 px-4 py-2.5 rounded-full bg-navy-100/80 dark:bg-navy-800/80 border border-navy-200 dark:border-navy-700 hover:border-gold-500/50 hover:bg-gold-500/10 transition-all text-xs sm:text-sm font-medium text-navy-800 dark:text-navy-200 cursor-pointer">
							<span>🛡️</span>
							<span>"Protect portfolio from market crashes"</span>
							<span class="text-gold-500 group-hover:translate-y-0.5 transition-transform">↓</span>
						</button>
					</div>
				</div>

			</div>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- ====================================================
	     2. SCROLL TEXT HIGHLIGHT NARRATIVE (Etihad-Style typography)
	     ==================================================== -->
	<section class="py-16 sm:py-24 bg-navy-900 text-white relative overflow-hidden">
		<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
			<span class="text-xs font-bold uppercase tracking-widest text-gold-400">The Decision Paradigm Shift</span>
			<h2 id="highlightText" class="text-xl sm:text-3xl lg:text-4xl font-semibold leading-relaxed sm:leading-relaxed max-w-4xl mx-auto flex flex-wrap justify-center items-center">
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">Most</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">financial</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">tools</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">give</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">you</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">a</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">number</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">and</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">stop</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">there.</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">FinSight</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">connects</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">tax</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">rules,</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">deep</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">math,</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">and</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">clear</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">advice</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">so</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">you</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-navy-400 opacity-30">can</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-gold-400 font-bold">make</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-gold-400 font-bold">confident</span>
				<span class="highlight-word inline-block mr-2 mb-1.5 transition-all duration-200 text-gold-400 font-bold">decisions.</span>
			</h2>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- ====================================================
	     3. STACKING CARDS DECK (Etihad Bureau Inspired Motion)
	     Unified Decision Hubs (Problem -> Understanding -> Calculation -> Recommendation)
	     ==================================================== -->
	<section class="py-12 sm:py-20 relative">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
			
			<div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
				<span class="text-caption text-gold-500">Interactive Decision Frameworks</span>
				<h2 class="text-section text-navy-900 dark:text-navy-100 mt-2">
					Explore Decision Hubs
				</h2>
				<p class="mt-2 text-navy-500 dark:text-navy-400 leading-relaxed text-sm sm:text-base">
					Select or scroll through each decision framework. Deep legal research, calculation engines, and exact recommendations united in one place.
				</p>
			</div>

			<!-- DECK CONTAINER -->
			<div class="relative space-y-8 md:space-y-12">
				
				<!-- STACK CARD 1: TAX OPTIMIZATION -->
				<div id="hub-tax" class="relative z-10 bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-3xl p-5 sm:p-8 lg:p-10 shadow-xl scroll-mt-24">
					<div class="space-y-6 sm:space-y-8">
						<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-navy-200 dark:border-navy-800 pb-5">
							<div class="space-y-1.5">
								<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider">
									<span>💼 Decision #1</span>
									<span>•</span>
									<span>Tax Optimization</span>
								</div>
								<h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-navy-900 dark:text-navy-100">
									"How can I legally minimize my direct income tax?"
								</h3>
								<p class="text-xs sm:text-sm text-navy-500 dark:text-navy-400 max-w-2xl">
									Don't just calculate tax liability — compare New vs Old Regime, analyze Section 87A rebate denial traps, and optimize statutory deductions (44ADA, HRA, 80C).
								</p>
							</div>
							<a href="/tax-calculator" class="btn-gold shrink-0 text-center text-xs sm:text-sm">
								Open Tax Engine →
							</a>
						</div>

						<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
							<!-- Step 1 & 2: Problem & Research -->
							<div class="lg:col-span-7 space-y-3">
								<span class="text-xs font-bold uppercase tracking-widest text-navy-400 dark:text-navy-500 block">1. Legal & Research Foundation</span>
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
									<a href="/tax-code/new-vs-old-regime-guide" class="p-3.5 rounded-2xl bg-navy-50 dark:bg-navy-800/60 border border-navy-200 dark:border-navy-700/80 hover:border-gold-500/50 transition-all space-y-1 group">
										<span class="text-[10px] font-bold text-amber-500 uppercase">Regime Selection</span>
										<h5 class="text-xs sm:text-sm font-bold text-navy-900 dark:text-navy-100 group-hover:text-gold-500 transition-colors">New vs Old Break-Even Guide</h5>
										<p class="text-[11px] sm:text-xs text-navy-500 dark:text-navy-400 line-clamp-2">Exact deduction threshold where Old Regime beats New Regime.</p>
									</a>
									<a href="/tax-code/44ad-vs-44ada-freelance-trap" class="p-3.5 rounded-2xl bg-navy-50 dark:bg-navy-800/60 border border-navy-200 dark:border-navy-700/80 hover:border-gold-500/50 transition-all space-y-1 group">
										<span class="text-[10px] font-bold text-amber-500 uppercase">Presumptive Tax</span>
										<h5 class="text-xs sm:text-sm font-bold text-navy-900 dark:text-navy-100 group-hover:text-gold-500 transition-colors">44ADA Freelance & Consultant Rules</h5>
										<p class="text-[11px] sm:text-xs text-navy-500 dark:text-navy-400 line-clamp-2">Pay tax on only 50% of gross receipts legally under Section 44ADA.</p>
									</a>
									<a href="/tax-code/rent-to-parents-hra-exemption-guide" class="p-3.5 rounded-2xl bg-navy-50 dark:bg-navy-800/60 border border-navy-200 dark:border-navy-700/80 hover:border-gold-500/50 transition-all space-y-1 group">
										<span class="text-[10px] font-bold text-amber-500 uppercase">HRA Exemption</span>
										<h5 class="text-xs sm:text-sm font-bold text-navy-900 dark:text-navy-100 group-hover:text-gold-500 transition-colors">Rent to Parents Exemption</h5>
										<p class="text-[11px] sm:text-xs text-navy-500 dark:text-navy-400 line-clamp-2">Complete legal framework and banking paper trail rules.</p>
									</a>
									<a href="/tax-code/section-87a-rebate-denial-trap" class="p-3.5 rounded-2xl bg-navy-50 dark:bg-navy-800/60 border border-navy-200 dark:border-navy-700/80 hover:border-gold-500/50 transition-all space-y-1 group">
										<span class="text-[10px] font-bold text-amber-500 uppercase">Notice Prevention</span>
										<h5 class="text-xs sm:text-sm font-bold text-navy-900 dark:text-navy-100 group-hover:text-gold-500 transition-colors">Section 87A Rebate Denial Trap</h5>
										<p class="text-[11px] sm:text-xs text-navy-500 dark:text-navy-400 line-clamp-2">Why short-term capital gains ruin 87A tax rebates.</p>
									</a>
									<a href="/tax-code/influencer-barter-trap-194r" class="p-3.5 rounded-2xl bg-navy-50 dark:bg-navy-800/60 border border-navy-200 dark:border-navy-700/80 hover:border-gold-500/50 transition-all space-y-1 group">
										<span class="text-[10px] font-bold text-amber-500 uppercase">Barter Tax (194R)</span>
										<h5 class="text-xs sm:text-sm font-bold text-navy-900 dark:text-navy-100 group-hover:text-gold-500 transition-colors">The Influencer Barter Trap</h5>
										<p class="text-[11px] sm:text-xs text-navy-500 dark:text-navy-400 line-clamp-2">Why the IT department views "free" laptops as hard cash.</p>
									</a>
								</div>
							</div>

							<!-- Step 3 & 4: Calculation & Actionable Decision -->
							<div class="lg:col-span-5 bg-gold-500/10 dark:bg-navy-800/90 border border-gold-500/30 rounded-2xl p-5 flex flex-col justify-between space-y-4">
								<div class="space-y-2.5">
									<div class="flex items-center justify-between">
										<span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-gold-600 dark:text-gold-400">2. Decision Recommendation</span>
										<span class="badge-safe text-[10px]">FY 2025-26</span>
									</div>
									<h4 class="text-sm sm:text-base font-bold text-navy-900 dark:text-navy-100">Key Decision Rule</h4>
									<ul class="text-xs text-navy-700 dark:text-navy-300 space-y-2 leading-relaxed">
										<li class="flex items-start gap-2">
											<span class="text-emerald-500 font-bold">✓</span>
											<span>If total deductions exceed <strong>₹3,75,000</strong>, the <strong>Old Tax Regime</strong> saves more cash.</span>
										</li>
										<li class="flex items-start gap-2">
											<span class="text-emerald-500 font-bold">✓</span>
											<span>If income is below <strong>₹12,00,000</strong> under New Regime, tax is effectively <strong>₹0</strong> with 87A.</span>
										</li>
									</ul>
								</div>
								<a href="/tax-calculator" class="w-full btn-gold text-center py-2.5 text-xs font-bold uppercase tracking-wider">
									Run Line-By-Line Tax Comparison
								</a>
							</div>
						</div>
					</div>
				</div>

				<!-- STACK CARD 2: RETIREMENT LONGEVITY -->
				<div id="hub-retirement" class="relative z-20 bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-3xl p-5 sm:p-8 lg:p-10 shadow-xl scroll-mt-24">
					<div class="space-y-6 sm:space-y-8">
						<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-navy-200 dark:border-navy-800 pb-5">
							<div class="space-y-1.5">
								<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wider">
									<span>🌴 Decision #2</span>
									<span>•</span>
									<span>Retirement Longevity</span>
								</div>
								<h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-navy-900 dark:text-navy-100">
									"Will my corpus survive 30+ years of retirement?"
								</h3>
								<p class="text-xs sm:text-sm text-navy-500 dark:text-navy-400 max-w-2xl">
									Stress-test your SWP withdrawals against market sequence-of-returns risk, inflation compounding, and capital gains tax friction over 10,000 Monte Carlo simulations.
								</p>
							</div>
							<a href="/swp-planner" class="btn-gold shrink-0 text-center text-xs sm:text-sm">
								Launch SWP Monte Carlo →
							</a>
						</div>

						<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
							<div class="lg:col-span-7 space-y-3">
								<span class="text-xs font-bold uppercase tracking-widest text-navy-400 dark:text-navy-500 block">1. Retirement Tax & Friction Analysis</span>
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
									<a href="/tax-code/capital-markets-ltcg-budget-guide" class="p-3.5 rounded-2xl bg-navy-50 dark:bg-navy-800/60 border border-navy-200 dark:border-navy-700/80 hover:border-gold-500/50 transition-all space-y-1 group">
										<span class="text-[10px] font-bold text-emerald-500 uppercase">Capital Gains</span>
										<h5 class="text-xs sm:text-sm font-bold text-navy-900 dark:text-navy-100 group-hover:text-gold-500 transition-colors">New LTCG & STCG Tax Rules</h5>
										<p class="text-[11px] sm:text-xs text-navy-500 dark:text-navy-400 line-clamp-2">How 12.5% LTCG affects safe withdrawal rate.</p>
									</a>
									<a href="/tax-code/debt-mutual-fund-massacre" class="p-3.5 rounded-2xl bg-navy-50 dark:bg-navy-800/60 border border-navy-200 dark:border-navy-700/80 hover:border-gold-500/50 transition-all space-y-1 group">
										<span class="text-[10px] font-bold text-emerald-500 uppercase">Fixed Income</span>
										<h5 class="text-xs sm:text-sm font-bold text-navy-900 dark:text-navy-100 group-hover:text-gold-500 transition-colors">Debt Mutual Fund Tax Rules</h5>
										<p class="text-[11px] sm:text-xs text-navy-500 dark:text-navy-400 line-clamp-2">Slab-rate taxation on conservative debt allocations.</p>
									</a>
								</div>
							</div>

							<div class="lg:col-span-5 bg-emerald-500/10 dark:bg-navy-800/90 border border-emerald-500/30 rounded-2xl p-5 flex flex-col justify-between space-y-4">
								<div class="space-y-2.5">
									<div class="flex items-center justify-between">
										<span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">2. Decision Recommendation</span>
										<span class="badge-safe text-[10px]">10k Monte Carlo</span>
									</div>
									<h4 class="text-sm sm:text-base font-bold text-navy-900 dark:text-navy-100">Safe Withdrawal Rule</h4>
									<ul class="text-xs text-navy-700 dark:text-navy-300 space-y-2 leading-relaxed">
										<li class="flex items-start gap-2">
											<span class="text-emerald-500 font-bold">✓</span>
											<span>Keep initial SWP rate below <strong>4.0% - 4.5%</strong> for 95%+ 30-year survival.</span>
										</li>
										<li class="flex items-start gap-2">
											<span class="text-emerald-500 font-bold">✓</span>
											<span>Rebalance equity/debt annually to insulate against sequence risk.</span>
										</li>
									</ul>
								</div>
								<a href="/swp-planner" class="w-full btn-gold text-center py-2.5 text-xs font-bold uppercase tracking-wider">
									Simulate 30-Year Survival
								</a>
							</div>
						</div>
					</div>
				</div>

				<!-- STACK CARD 3: INSURANCE DECONSTRUCTION -->
				<div id="hub-insurance" class="relative z-30 bg-white dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-3xl p-5 sm:p-8 lg:p-10 shadow-xl scroll-mt-24">
					<div class="space-y-6 sm:space-y-8">
						<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-navy-200 dark:border-navy-800 pb-5">
							<div class="space-y-1.5">
								<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-bold uppercase tracking-wider">
									<span>📜 Decision #3</span>
									<span>•</span>
									<span>Insurance Deconstruction</span>
								</div>
								<h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-navy-900 dark:text-navy-100">
									"Is my guaranteed income policy actually a good investment?"
								</h3>
								<p class="text-xs sm:text-sm text-navy-500 dark:text-navy-400 max-w-2xl">
									Strip away insurance brochure marketing. Use Newton-Raphson solvers to calculate the true XIRR and compare against Buy Term + Invest the Rest.
								</p>
							</div>
							<a href="/insurance-analyzer" class="btn-gold shrink-0 text-center text-xs sm:text-sm">
								Deconstruct Policy →
							</a>
						</div>

						<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
							<div class="lg:col-span-7 space-y-3">
								<span class="text-xs font-bold uppercase tracking-widest text-navy-400 dark:text-navy-500 block">1. Legal & Tax Frame</span>
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
									<a href="/tax-code/capital-markets-ltcg-budget-guide" class="p-3.5 rounded-2xl bg-navy-50 dark:bg-navy-800/60 border border-navy-200 dark:border-navy-700/80 hover:border-gold-500/50 transition-all space-y-1 group">
