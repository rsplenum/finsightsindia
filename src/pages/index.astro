---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('direct-tax');
const articleEntries = allArticles.slice(0, 3).map(art => [art.id, art.data]);
---

<Layout title="FinSight India — Financial Intelligence Platform for Everyone" description="India's most trusted financial intelligence platform. Monte Carlo retirement simulators, SIP engines, insurance analyzers, options pricing, and 100+ expert tax articles.">

	<!-- ====================================================
	     HERO SECTION — Etihad Bureau-Inspired Asymmetric Split
	     ==================================================== -->
	<section class="hero-glow relative overflow-hidden">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 lg:py-36">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				
				<!-- Left Column: Value Proposition -->
				<div class="lg:col-span-7 space-y-8 reveal">
					<div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-gold-500/10 border border-gold-500/20 rounded-full">
						<div class="w-2 h-2 rounded-full bg-emerald-500 animate-glow-pulse"></div>
						<span class="text-xs font-semibold tracking-wider text-gold-600 dark:text-gold-400 uppercase">100% Free • Client-Side • No Data Leaves Your Device</span>
					</div>

					<h1 class="text-hero text-navy-900 dark:text-navy-100">
						India's Financial Intelligence Platform,
						<span class="text-gradient-gold"> Built for Everyone.</span>
					</h1>

					<p class="text-lg sm:text-xl text-navy-500 dark:text-navy-400 leading-relaxed max-w-2xl">
						Institutional-grade Monte Carlo simulators, insurance deconstructors, options pricing labs, and the deepest library of tax research in the country — all running on your device, completely free.
					</p>

					<div class="flex flex-col sm:flex-row gap-4">
						<a href="/swp-planner" class="btn-gold text-center">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" /></svg>
							Explore Calculators
						</a>
						<a href="/tax-code" class="btn-ghost text-center">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
							Read Tax Research
						</a>
					</div>
				</div>

				<!-- Right Column: Floating Preview Card -->
				<div class="lg:col-span-5 reveal" style="transition-delay: 200ms;">
					<div class="card-glass rounded-2xl p-6 sm:p-8 space-y-6 relative">
						<div class="card-glow absolute inset-0 rounded-2xl pointer-events-none"></div>
						
						<!-- Mini SWP Preview -->
						<div class="relative z-10 space-y-5">
							<div class="flex items-center justify-between">
								<span class="text-caption text-navy-500 dark:text-navy-400">Retirement Simulation Preview</span>
								<span class="badge-safe">Live Demo</span>
							</div>

							<div class="space-y-4">
								<div class="flex justify-between items-baseline">
									<span class="stat-label">Portfolio Corpus</span>
									<span class="stat-value text-xl text-navy-900 dark:text-navy-100">₹1,00,00,000</span>
								</div>
								<div class="flex justify-between items-baseline">
									<span class="stat-label">Monthly Withdrawal</span>
									<span class="stat-value text-xl text-gold-500">₹50,000</span>
								</div>
								<div class="h-px bg-navy-200 dark:bg-navy-700"></div>
								<div class="flex justify-between items-baseline">
									<span class="stat-label">Projected Endurance</span>
									<span class="stat-value text-2xl text-emerald-500">30 Years</span>
								</div>
							</div>

							<!-- Mini chart bars -->
							<div class="flex items-end gap-1 h-20">
								<div class="flex-1 rounded-t bg-emerald-500/20 dark:bg-emerald-500/30" style="height: 100%"></div>
								<div class="flex-1 rounded-t bg-emerald-500/25 dark:bg-emerald-500/35" style="height: 95%"></div>
								<div class="flex-1 rounded-t bg-emerald-500/30 dark:bg-emerald-500/40" style="height: 88%"></div>
								<div class="flex-1 rounded-t bg-emerald-500/35 dark:bg-emerald-500/45" style="height: 82%"></div>
								<div class="flex-1 rounded-t bg-emerald-500/40 dark:bg-emerald-500/50" style="height: 75%"></div>
								<div class="flex-1 rounded-t bg-gold-500/30 dark:bg-gold-500/40" style="height: 68%"></div>
								<div class="flex-1 rounded-t bg-gold-500/35 dark:bg-gold-500/45" style="height: 60%"></div>
								<div class="flex-1 rounded-t bg-gold-500/40 dark:bg-gold-500/50" style="height: 52%"></div>
								<div class="flex-1 rounded-t bg-gold-500/45 dark:bg-gold-500/55" style="height: 44%"></div>
								<div class="flex-1 rounded-t bg-amber-500/30 dark:bg-amber-500/40" style="height: 35%"></div>
								<div class="flex-1 rounded-t bg-amber-500/35 dark:bg-amber-500/45" style="height: 28%"></div>
								<div class="flex-1 rounded-t bg-amber-500/40 dark:bg-amber-500/50" style="height: 20%"></div>
							</div>

							<p class="text-xs text-navy-400 dark:text-navy-500 text-center">
								10,000 Monte Carlo simulations • Inflation-adjusted
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- ====================================================
	     CALCULATOR MODULES — Responsive Card Grid
	     ==================================================== -->
	<section class="section-glow relative py-16 sm:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="text-center mb-12 sm:mb-16 reveal">
				<span class="text-caption text-gold-500">Institutional-Grade Tools</span>
				<h2 class="text-section text-navy-900 dark:text-navy-100 mt-3">
					Every Calculator You'll Ever Need
				</h2>
				<p class="mt-4 text-navy-500 dark:text-navy-400 max-w-2xl mx-auto leading-relaxed">
					From retirement planning to options hedging — our engines process millions of computations entirely on your device. Zero data leaves your browser.
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
				
				<!-- SWP Retirement Planner -->
				<a href="/swp-planner" class="card-premium card-glow rounded-2xl p-7 flex flex-col h-full group reveal cursor-pointer">
					<div class="w-12 h-12 rounded-xl bg-emerald-500/10 dark:bg-emerald-500/15 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
						<svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" /></svg>
					</div>
					<h3 class="text-card-title text-navy-900 dark:text-navy-100 mb-2">SWP Retirement Planner</h3>
					<p class="text-sm text-navy-500 dark:text-navy-400 leading-relaxed flex-grow">
						10,000 Monte Carlo simulations stress-testing your retirement corpus against inflation, market volatility, and LTCG tax friction.
					</p>
					<div class="mt-5 flex items-center gap-2 text-xs font-semibold text-gold-500 group-hover:gap-3 transition-all duration-300">
						Launch Simulator <span class="text-sm">→</span>
					</div>
				</a>

				<!-- SIP Accumulation Engine -->
				<a href="/sip-engine" class="card-premium card-glow rounded-2xl p-7 flex flex-col h-full group reveal cursor-pointer">
					<div class="w-12 h-12 rounded-xl bg-gold-500/10 dark:bg-gold-500/15 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
						<svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941" /></svg>
					</div>
					<h3 class="text-card-title text-navy-900 dark:text-navy-100 mb-2">SIP Accumulation Engine</h3>
					<p class="text-sm text-navy-500 dark:text-navy-400 leading-relaxed flex-grow">
						Stochastic purchasing power simulator with multi-asset GBM, goal-seek reverse mode, and optional Black-Scholes put hedging.
					</p>
					<div class="mt-5 flex items-center gap-2 text-xs font-semibold text-gold-500 group-hover:gap-3 transition-all duration-300">
						Launch Engine <span class="text-sm">→</span>
					</div>
				</a>

				<!-- Insurance ROI Analyzer -->
				<a href="/insurance-analyzer" class="card-premium card-glow rounded-2xl p-7 flex flex-col h-full group reveal cursor-pointer">
					<div class="w-12 h-12 rounded-xl bg-navy-500/10 dark:bg-navy-500/15 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
						<svg class="w-6 h-6 text-navy-600 dark:text-navy-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
					</div>
					<h3 class="text-card-title text-navy-900 dark:text-navy-100 mb-2">Insurance ROI Analyzer</h3>
					<p class="text-sm text-navy-500 dark:text-navy-400 leading-relaxed flex-grow">
						Unmask guaranteed income policy returns with Newton-Raphson XIRR, inflation-adjusted PV, and synthetic 3-way replication.
					</p>
					<div class="mt-5 flex items-center gap-2 text-xs font-semibold text-gold-500 group-hover:gap-3 transition-all duration-300">
						Analyze Policy <span class="text-sm">→</span>
					</div>
				</a>

				<!-- Options Pricing Lab -->
				<a href="/black-scholes" class="card-premium card-glow rounded-2xl p-7 flex flex-col h-full group reveal cursor-pointer">
					<div class="w-12 h-12 rounded-xl bg-rose-500/10 dark:bg-rose-500/15 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
						<svg class="w-6 h-6 text-rose-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" /></svg>
					</div>
					<h3 class="text-card-title text-navy-900 dark:text-navy-100 mb-2">Options Pricing Lab</h3>
					<p class="text-sm text-navy-500 dark:text-navy-400 leading-relaxed flex-grow">
						Interactive Black-Scholes engine for European options. Premiums, d₁/d₂ probabilities, and all Greeks (Δ, Γ, Θ, ν) in real-time.
					</p>
					<div class="mt-5 flex items-center gap-2 text-xs font-semibold text-gold-500 group-hover:gap-3 transition-all duration-300">
						Price Options <span class="text-sm">→</span>
					</div>
				</a>

				<!-- Direct Tax Code 2025 -->
				<a href="/tax-code" class="card-premium card-glow rounded-2xl p-7 flex flex-col h-full group reveal cursor-pointer">
					<div class="w-12 h-12 rounded-xl bg-amber-500/10 dark:bg-amber-500/15 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
						<svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
					</div>
					<h3 class="text-card-title text-navy-900 dark:text-navy-100 mb-2">Direct Tax Code 2025</h3>
					<p class="text-sm text-navy-500 dark:text-navy-400 leading-relaxed flex-grow">
						New vs Old Regime comparison, slab calculators, and long-form whitepapers with embedded interactive workbenches.
					</p>
					<div class="mt-5 flex items-center gap-2 text-xs font-semibold text-gold-500 group-hover:gap-3 transition-all duration-300">
						Explore Tax Code <span class="text-sm">→</span>
					</div>
				</a>

				<!-- GST Hub — Coming Soon -->
				<div class="card-premium rounded-2xl p-7 flex flex-col h-full reveal opacity-70 relative overflow-hidden">
					<div class="absolute top-4 right-4">
						<span class="badge-gold">Coming Soon</span>
					</div>
					<div class="w-12 h-12 rounded-xl bg-navy-200/50 dark:bg-navy-800/50 flex items-center justify-center mb-5">
						<svg class="w-6 h-6 text-navy-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
					</div>
					<h3 class="text-card-title text-navy-900 dark:text-navy-100 mb-2">GST Intelligence Hub</h3>
					<p class="text-sm text-navy-500 dark:text-navy-400 leading-relaxed flex-grow">
						GST slab calculator, ITC eligibility checker, GSTR filing tracker, and 50 expert whitepapers on Goods & Services Tax.
					</p>
				</div>
			</div>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- ====================================================
	     TRUST SIGNALS — By The Numbers
	     ==================================================== -->
	<section class="py-16 sm:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 reveal-stagger">
				<div class="text-center reveal">
					<div class="stat-value text-3xl sm:text-4xl text-navy-900 dark:text-navy-100">10,000</div>
					<p class="stat-label mt-2">Monte Carlo Simulations</p>
					<p class="text-xs text-navy-400 dark:text-navy-500 mt-1">Per retirement scenario</p>
				</div>
				<div class="text-center reveal">
					<div class="stat-value text-3xl sm:text-4xl text-gold-500">100%</div>
					<p class="stat-label mt-2">Client-Side Processing</p>
					<p class="text-xs text-navy-400 dark:text-navy-500 mt-1">Zero data leaves your device</p>
				</div>
				<div class="text-center reveal">
					<div class="stat-value text-3xl sm:text-4xl text-navy-900 dark:text-navy-100">5+</div>
					<p class="stat-label mt-2">Quantitative Engines</p>
					<p class="text-xs text-navy-400 dark:text-navy-500 mt-1">SWP, SIP, Insurance, Options, Tax</p>
				</div>
				<div class="text-center reveal">
					<div class="stat-value text-3xl sm:text-4xl text-emerald-500">₹0</div>
					<p class="stat-label mt-2">Completely Free</p>
					<p class="text-xs text-navy-400 dark:text-navy-500 mt-1">No ads, no subscriptions, forever</p>
				</div>
			</div>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- ====================================================
	     FEATURED TAX RESEARCH ARTICLES
	     ==================================================== -->
	<section class="section-glow relative py-16 sm:py-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10 reveal">
				<div>
					<span class="text-caption text-gold-500">Expert Research</span>
					<h2 class="text-section text-navy-900 dark:text-navy-100 mt-2">
						Latest Tax Whitepapers
					</h2>
				</div>
				<a href="/tax-code" class="btn-ghost text-sm">
					View All Articles <span>→</span>
				</a>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
				{articleEntries.map(([slug, article]) => (
					<a href={`/tax-code/${slug}`} class="card-premium rounded-2xl overflow-hidden group reveal cursor-pointer">
						<!-- Category Header -->
						<div class="px-6 py-4 bg-navy-50 dark:bg-navy-800/50 border-b border-navy-200 dark:border-navy-700">
							<div class="flex items-center justify-between">
								<span class="badge-gold">{article.categoryName}</span>
								<span class="text-xs text-navy-400 dark:text-navy-500">{article.readTime}</span>
							</div>
						</div>
						<!-- Content -->
						<div class="p-6 space-y-3">
							<h3 class="text-card-title text-navy-900 dark:text-navy-100 group-hover:text-gold-500 transition-colors line-clamp-2">
								{article.title}
							</h3>
							<p class="text-sm text-navy-500 dark:text-navy-400 leading-relaxed line-clamp-3">
								{article.summary}
							</p>
							<div class="flex items-center gap-2 text-xs font-semibold text-gold-500 group-hover:gap-3 transition-all duration-300 pt-2">
								Read Whitepaper <span class="text-sm">→</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<hr class="section-divider" />

	<!-- ====================================================
	     BOTTOM CTA SECTION
	     ==================================================== -->
	<section class="hero-glow relative py-20 sm:py-28">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 reveal">
			<h2 class="text-section text-navy-900 dark:text-navy-100">
				Your Financial Future
				<span class="text-gradient-gold"> Deserves Better Tools.</span>
			</h2>
			<p class="mt-5 text-lg text-navy-500 dark:text-navy-400 max-w-2xl mx-auto leading-relaxed">
				Stop guessing. Start simulating. Every calculation runs 100% on your device — your financial data never touches a server.
			</p>
			<div class="flex flex-col sm:flex-row justify-center gap-4 mt-10">
				<a href="/swp-planner" class="btn-gold text-center">
					Start Planning Your Retirement
				</a>
				<a href="/sip-engine" class="btn-ghost text-center">
					Build Your Wealth with SIPs
				</a>
			</div>
		</div>
	</section>

</Layout>
