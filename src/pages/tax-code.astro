---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardPremium from '../components/CardPremium.astro';
import InputGroup from '../components/InputGroup.astro';
import SectionTitle from '../components/SectionTitle.astro';

// Fetch all MDX articles from the Content Collection
const allArticles = await getCollection('direct-tax');
// Optional: We can group them by bucket or sort them if needed. 
const articlesList = allArticles;

// Get unique categories
const uniqueCategories = [...new Set(articlesList.map(art => art.data.categoryName))].filter(Boolean);
---

<Layout 
	title="India Direct Tax Code 2025 & Calculators — SWP Intelligence"
	description="Comprehensive India Direct Tax Code guide featuring interactive slab calculators, capital gains rules, and quantitative master whitepapers under the Income Tax Act, 2025."
>
	
	<Hero 
		badge="AUTHENTIC INDIA DIRECT TAX CODE (FY 2025-26)"
		title="India Direct Tax Intelligence Hub"
		description="Step-by-step tax guidance, interactive slab calculators, capital gains rules, and quantitative master whitepapers under the Income Tax Act, 2025."
	/>

	<hr class="section-divider" />
	
	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 space-y-10">
		


		<!-- CATEGORIZED TOP DIRECT TAX MASTER WHITEPAPERS -->
		<CardPremium class="max-w-7xl mx-auto space-y-6">
			
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-navy-200 dark:border-white/10">
				<div>
					<SectionTitle title="Institutional Direct Tax Whitepapers (Symptom Index)" />
					<p class="text-xs text-navy-500 dark:text-navy-400 font-sans mt-1">
						The Top 100 most highly searched tax anxiety symptoms in India, mapped to exact statutory codes and live workbenches.
					</p>
				</div>
				<span id="articleCount" class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 px-3 py-1.5 rounded-md bg-emerald-500/10 border border-emerald-500/20 uppercase tracking-widest whitespace-nowrap">
					{articlesList.length} Published Master Guides
				</span>
			</div>

			<!-- Search and Filter Controls -->
			<div class="space-y-4">
				<div>
					<input 
						type="search" 
						id="searchInput" 
						placeholder="Search by title or symptom..." 
						class="input-premium text-sm text-navy-900 dark:text-navy-100 placeholder:text-navy-400 dark:placeholder:text-navy-500 focus:outline-none w-full py-2.5 px-3.5"
					/>
				</div>
				
				<div class="flex flex-wrap gap-2" id="categoryFilters">
					<button class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest badge-gold filter-btn active" data-filter="all">
						All
					</button>
					{uniqueCategories.map(cat => (
						<button class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest badge-safe opacity-70 hover:opacity-100 transition-opacity filter-btn" data-filter={cat}>
							{cat}
						</button>
					))}
				</div>
			</div>

			<!-- Dynamic Master Article Cards Grid -->
			<!-- Dynamic Master Article Cards Grid -->
			<div id="noResultsMsg" class="hidden text-center py-12 text-navy-500 dark:text-navy-400 font-sans">
				No articles found matching your criteria.
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 reveal-stagger" id="faqCardGrid">
				{articlesList.map((art, idx) => (
					<div 
						class="faq-card bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-6 space-y-4 hover:border-navy-300 dark:hover:border-white/20 transition-all duration-200 ease-geist shadow-xs flex flex-col justify-between article-card"
						data-title={art.data.title.toLowerCase()}
						data-summary={art.data.summary.toLowerCase()}
						data-category={art.data.categoryName}
					>
						<div class="space-y-3">
							<div class="flex items-center justify-between">
								<span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-widest badge-safe">
									🇮🇳 {art.data.categoryName}
								</span>
								<span class="text-[10px] font-bold text-navy-400 dark:text-navy-500 uppercase tracking-widest">Q0{idx + 1}</span>
							</div>

							<h3 class="text-lg font-bold text-navy-900 dark:text-navy-100 font-sans leading-snug">
								{art.data.title}
							</h3>

							<div class="text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400 flex items-center gap-2">
								<span>{art.data.readTime}</span>
								<span>•</span>
								<span class="text-emerald-600 dark:text-emerald-400 line-clamp-1">{art.data.statutoryAct}</span>
							</div>

							<p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed font-sans line-clamp-3">
								{art.data.summary}
							</p>
						</div>

						<div class="space-y-3 pt-3 border-t border-navy-200 dark:border-navy-800">
							<a 
								href={`/tax-code/${art.id}`} 
								class="inline-flex items-center justify-center w-full py-2.5 px-4 rounded-md btn-gold text-center text-xs mt-2"
							>
								Read Full Interactive Whitepaper →
							</a>
						</div>
					</div>
				))}
			</div>

		</CardPremium>

	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const searchInput = document.getElementById('searchInput');
		const filterBtns = document.querySelectorAll('.filter-btn');
		const articleCards = document.querySelectorAll('.article-card');
		const articleCount = document.getElementById('articleCount');
		const noResultsMsg = document.getElementById('noResultsMsg');
		
		let currentCategory = 'all';
		let currentSearch = '';

		function filterArticles() {
			let visibleCount = 0;
			
			articleCards.forEach((card) => {
				const title = card.getAttribute('data-title') || '';
				const summary = card.getAttribute('data-summary') || '';
				const category = card.getAttribute('data-category') || '';
				
				const matchesSearch = currentSearch === '' || title.includes(currentSearch) || summary.includes(currentSearch);
				const matchesCategory = currentCategory === 'all' || category === currentCategory;
				
				if (matchesSearch && matchesCategory) {
					(card as HTMLElement).style.display = 'flex';
					visibleCount++;
				} else {
					(card as HTMLElement).style.display = 'none';
				}
			});

			if (articleCount) {
				articleCount.textContent = `${visibleCount} Published Master Guide${visibleCount === 1 ? '' : 's'}`;
			}
			
			if (noResultsMsg) {
				if (visibleCount === 0) {
					noResultsMsg.classList.remove('hidden');
				} else {
					noResultsMsg.classList.add('hidden');
				}
			}
		}

		searchInput?.addEventListener('input', (e) => {
			currentSearch = (e.target as HTMLInputElement).value.toLowerCase();
			filterArticles();
		});

		filterBtns.forEach(btn => {
			btn.addEventListener('click', (e) => {
				const target = e.currentTarget as HTMLButtonElement;
				currentCategory = target.getAttribute('data-filter') || 'all';
				
				// Update active state of buttons
				filterBtns.forEach(b => {
					b.classList.remove('badge-gold', 'active');
					b.classList.add('badge-safe', 'opacity-70');
				});
				target.classList.remove('badge-safe', 'opacity-70');
				target.classList.add('badge-gold', 'active');
				
				filterArticles();
			});
		});
	});
</script>

