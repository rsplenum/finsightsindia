---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Fetch all MDX articles from the Content Collection
const allArticles = await getCollection('direct-tax');

// Compute timestamps and sort latest first
const articlesWithTime = allArticles.map(art => {
	let timestamp = 0;
	try {
		const fullPath = path.join(process.cwd(), 'src/content/direct-tax', art.id + (art.id.endsWith('.mdx') ? '' : '.mdx'));
		const stats = fs.statSync(fullPath);
		timestamp = stats.mtimeMs || stats.birthtimeMs || 0;
	} catch(e) {
		timestamp = 0;
	}
	return { ...art, timestamp };
});

// Sort Latest first
articlesWithTime.sort((a, b) => b.timestamp - a.timestamp);

const articlesList = articlesWithTime;
const totalArticles = articlesList.length;

// Get unique categories
const uniqueCategories = [...new Set(articlesList.map(art => art.data.categoryName))].filter(Boolean);

// Dynamically load images for cover shots
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpeg,jpg,png,gif,webp}');

// Helper to extract image from MDX body
const extractCoverFromMDX = (body) => {
	if (!body) return null;
	
	const mdMatch = body.match(/!\[.*?\]\([^)]*?\/assets\/images\/([^)]+)\)/);
	if (mdMatch) return mdMatch[1];
	
	const importMatch = body.match(/import\s+.*?\s+from\s+["'].*?\/assets\/images\/([^"']+)["']/);
	if (importMatch) return importMatch[1];
	
	return null;
};
---

<Layout 
	title="India Direct Tax Code 2025 & Calculators — FinSight INDIA"
	description="Comprehensive India Direct Tax Code guide featuring interactive slab calculators, capital gains rules, and quantitative master whitepapers under the Income Tax Act, 2025."
>
	
	<main class="min-h-screen bg-slate-50 dark:bg-navy-900 pt-24 pb-24">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			
			<div class="mb-16 text-center">
				<h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4 flex items-center justify-center gap-3">
					<span class="text-4xl">⚖️</span> Tax Code Vault
				</h1>
				<p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mb-10">
					The ultimate index of India's most complex tax anxiety symptoms, mapped to their exact statutory codes and resolved with live workbenches.
				</p>
				
				<!-- Giant Hero Search Bar -->
				<div class="max-w-3xl mx-auto relative group z-20">
					<div class="absolute inset-y-0 left-0 pl-6 flex items-center pointer-events-none transition-transform group-focus-within:scale-110 group-focus-within:text-gold-500">
						<svg class="h-6 w-6 text-slate-400 dark:text-navy-400" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
						</svg>
					</div>
					<input 
						type="text" 
						id="searchInput" 
						placeholder="Search symptoms, notices, or sections (e.g., Section 148A)..." 
						class="block w-full pl-16 pr-6 py-5 bg-white dark:bg-navy-800 border-2 border-transparent focus:border-gold-500 dark:border-navy-700 dark:focus:border-gold-500 rounded-3xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-navy-400 focus:outline-none shadow-lg transition-all duration-300 hover:shadow-xl text-lg sm:text-xl font-medium" 
					/>
				</div>

				<!-- Filters and Sorting Container -->
				<div class="mt-8 flex flex-col md:flex-row items-center justify-between gap-6 max-w-5xl mx-auto z-10 relative">
					
					<!-- Floating Categories Cloud (Horizontal Scroll) -->
					<div class="flex-1 w-full overflow-hidden relative">
                    <!-- Fade edges -->
                    <div class="absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-slate-50 dark:from-navy-900 to-transparent z-10 pointer-events-none"></div>
                    <div class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-slate-50 dark:from-navy-900 to-transparent z-10 pointer-events-none"></div>
                    
					<div class="flex overflow-x-auto gap-3 pb-4 pt-2 px-8 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] scroll-smooth snap-x" id="categoryFilters">
						<button class="snap-start shrink-0 px-6 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest border transition-all duration-300 filter-btn active bg-slate-900 text-white dark:bg-white dark:text-navy-900 border-transparent shadow-md" data-filter="all">
							Everything
						</button>
						{uniqueCategories.map(cat => (
							<button class="snap-start shrink-0 px-6 py-2.5 rounded-full text-sm font-bold uppercase tracking-widest border border-slate-200 dark:border-navy-700 bg-white/50 dark:bg-navy-800/50 text-slate-600 dark:text-navy-300 hover:bg-slate-100 dark:hover:bg-navy-700 transition-all duration-300 filter-btn backdrop-blur-sm shadow-sm hover:shadow-md" data-filter={cat}>
								{cat}
							</button>
						))}
					</div>
					</div>
					
					<!-- Elegant Sort Dropdown -->
					<div class="relative group z-50 shrink-0">
						<button class="flex items-center gap-2 px-6 py-2.5 bg-white/80 dark:bg-navy-800/80 backdrop-blur-md border border-slate-200 dark:border-navy-700 rounded-full text-sm font-bold uppercase tracking-widest text-slate-700 dark:text-navy-300 shadow-sm hover:shadow-lg hover:border-gold-500/50 transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-gold-500/30">
							<svg class="w-4 h-4 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
							<span id="activeSortLabel">Latest Release</span>
							<svg class="w-4 h-4 ml-1 opacity-50 group-hover:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
						</button>
						
						<!-- Dropdown Menu -->
                        <div class="absolute right-0 top-full pt-3 w-56 z-50">
                            <div class="bg-white/95 dark:bg-navy-800/95 backdrop-blur-xl border border-slate-200/50 dark:border-navy-700/50 rounded-2xl shadow-2xl opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:pointer-events-auto transition-all duration-300 ease-out transform origin-top scale-95 group-hover:scale-100 flex flex-col overflow-hidden py-2">
                                <button class="sort-btn flex items-center justify-between px-5 py-3 text-sm font-bold text-slate-700 dark:text-navy-200 hover:bg-slate-50 dark:hover:bg-navy-700/50 transition-colors w-full text-left" data-sort="latest" data-label="Latest Release">
                                    Latest Release
                                    <span class="sort-indicator hidden text-gold-500">●</span>
                                </button>
                                <button class="sort-btn flex items-center justify-between px-5 py-3 text-sm font-bold text-slate-700 dark:text-navy-200 hover:bg-slate-50 dark:hover:bg-navy-700/50 transition-colors w-full text-left" data-sort="oldest" data-label="Oldest First">
                                    Oldest First
                                    <span class="sort-indicator hidden text-gold-500">●</span>
                                </button>
                                <div class="h-px bg-slate-100 dark:bg-navy-700/50 my-1 mx-4"></div>
                                <button class="sort-btn flex items-center justify-between px-5 py-3 text-sm font-bold text-slate-700 dark:text-navy-200 hover:bg-slate-50 dark:hover:bg-navy-700/50 transition-colors w-full text-left" data-sort="az" data-label="A to Z">
                                    Alphabetical (A-Z)
                                    <span class="sort-indicator hidden text-gold-500">●</span>
                                </button>
                            </div>
						</div>
					</div>
				</div>
			</div>

			<div id="noResultsMsg" class="hidden text-center py-16 text-slate-500 dark:text-navy-400 font-sans">
                <div class="text-6xl mb-4">🕵️‍♂️</div>
				<h3 class="text-xl font-bold text-slate-800 dark:text-slate-200 mb-2">No anxiety found.</h3>
                <p>Try searching for a different symptom or statutory code.</p>
			</div>
			
			<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8" id="faqCardGrid">
				{articlesList.map(async (art, idx) => {
					let imgSrc = null;
					
					// Use frontmatter if Astro parsed it, otherwise fallback to regex extraction from body
					const rawImageName = art.data.coverImage || extractCoverFromMDX(art.body);

					if (rawImageName) {
						const imgPath = `/src/assets/images/${rawImageName}`;
						const imgLoader = images[imgPath];
						
						if (imgLoader) {
							const imgModule = await imgLoader();
							imgSrc = imgModule.default;
						}
					}

					const readTimeNum = parseInt(art.data.readTime) || 0;
					const timestamp = art.timestamp;
                    const articleNum = totalArticles - idx;
                    const formattedNumber = articleNum.toString().padStart(2, '0');

					return (
					<div 
						class="article-card group bg-white dark:bg-navy-800 rounded-[2rem] overflow-hidden border border-slate-200 dark:border-navy-700 hover:border-gold-500/50 dark:hover:border-gold-500/50 hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-500 ease-out flex flex-col justify-between cursor-pointer relative"
						data-title={art.data.title.toLowerCase()}
						data-summary={art.data.summary.toLowerCase()}
						data-category={art.data.categoryName}
						data-readtime={readTimeNum}
						data-timestamp={timestamp}
						data-index={idx}
                        onclick={`window.location.href='/tax-code/${art.id}'`}
					>
                        {/* Image Header */}
                        <div class="relative h-64 w-full overflow-hidden bg-slate-50 dark:bg-navy-900/50 flex items-center justify-center p-6 border-b border-slate-100 dark:border-navy-700/50">
                            {imgSrc ? (
                                <Image 
                                    src={imgSrc} 
                                    alt={art.data.title} 
                                    class="w-full h-full object-contain mix-blend-multiply dark:invert dark:hue-rotate-180 dark:mix-blend-screen group-hover:scale-105 transition-transform duration-700 ease-out rounded-t-md"
                                />
                            ) : (
                                <div class="text-6xl opacity-20 group-hover:scale-110 transition-transform duration-700">📄</div>
                            )}
                            
                            <div class="absolute top-5 right-5">
                                <span class="bg-white/90 dark:bg-navy-900/90 backdrop-blur-sm text-slate-900 dark:text-white text-[10px] font-bold px-3 py-1.5 rounded-full border border-slate-200 dark:border-navy-700 shadow-sm uppercase tracking-widest z-10">
                                    Q{formattedNumber}
                                </span>
                            </div>
                        </div>

						<div class="p-8 flex-1 flex flex-col bg-white dark:bg-navy-800 relative z-10">
							<div class="flex items-center justify-between mb-5">
								<span class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
									{art.data.categoryName}
								</span>
                                <span class="text-xs font-bold text-slate-400 dark:text-navy-400 font-mono">
                                    {art.data.readTime}
                                </span>
							</div>

							<h3 class="text-xl font-extrabold text-slate-900 dark:text-white leading-tight mb-4 group-hover:text-gold-600 dark:group-hover:text-gold-400 transition-colors line-clamp-3">
								{art.data.title}
							</h3>

							<p class="text-sm text-slate-600 dark:text-navy-300 leading-relaxed line-clamp-3 mb-8">
								{art.data.summary}
							</p>

                            <div class="mt-auto pt-5 border-t border-slate-100 dark:border-navy-700/50 flex flex-col gap-2 text-[11px] font-bold uppercase tracking-widest">
                                <div class="flex items-center justify-between w-full">
                                    <span class="text-slate-500 dark:text-navy-400 truncate max-w-[70%]">
                                        {art.data.statutoryAct}
                                    </span>
                                    <span class="text-gold-600 dark:text-gold-400 group-hover:translate-x-1.5 transition-transform flex items-center gap-1 shrink-0">
                                        Read <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                                    </span>
                                </div>
                                {art.data.statutoryAct2025 && art.data.statutoryAct2025.trim() !== "" && (
                                    <div class="flex items-center w-full">
                                        <span class="text-purple-600 dark:text-purple-400 truncate max-w-[100%]">
                                            Act 2025: {art.data.statutoryAct2025}
                                        </span>
                                    </div>
                                )}
                            </div>
						</div>
					</div>
				)})}
			</div>

		</div>
	</main>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const searchInput = document.getElementById('searchInput');
		const filterBtns = document.querySelectorAll('.filter-btn');
		const sortBtns = document.querySelectorAll('.sort-btn');
		const articleCards = document.querySelectorAll('.article-card');
		const gridContainer = document.getElementById('faqCardGrid');
		const noResultsMsg = document.getElementById('noResultsMsg');
		const activeSortLabel = document.getElementById('activeSortLabel');
		
		let currentCategory = 'all';
		let currentSearch = '';
		let currentSort = 'latest'; // Default sort

		function filterArticles() {
			let visibleCount = 0;
			
			articleCards.forEach((card) => {
				const title = card.getAttribute('data-title') || '';
				const summary = card.getAttribute('data-summary') || '';
				const category = card.getAttribute('data-category') || '';
				
				const matchesSearch = currentSearch === '' || title.includes(currentSearch) || summary.includes(currentSearch);
				const matchesCategory = currentCategory === 'all' || category === currentCategory;
				
				if (matchesSearch && matchesCategory) {
					(card as HTMLElement).style.display = 'flex';
					visibleCount++;
				} else {
					(card as HTMLElement).style.display = 'none';
				}
			});
			
			if (noResultsMsg) {
				if (visibleCount === 0) {
					noResultsMsg.classList.remove('hidden');
				} else {
					noResultsMsg.classList.add('hidden');
				}
			}
		}

		searchInput?.addEventListener('input', (e) => {
			currentSearch = (e.target as HTMLInputElement).value.toLowerCase();
			filterArticles();
		});

		filterBtns.forEach(btn => {
			btn.addEventListener('click', (e) => {
				const target = e.currentTarget as HTMLButtonElement;
				currentCategory = target.getAttribute('data-filter') || 'all';
				
				// Update active state of buttons
				filterBtns.forEach(b => {
					b.classList.remove('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-navy-900', 'border-transparent', 'active');
					b.classList.add('bg-white/50', 'dark:bg-navy-800/50', 'text-slate-600', 'dark:text-navy-300', 'border-slate-200', 'dark:border-navy-700');
				});
				target.classList.remove('bg-white/50', 'dark:bg-navy-800/50', 'text-slate-600', 'dark:text-navy-300', 'border-slate-200', 'dark:border-navy-700');
				target.classList.add('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-navy-900', 'border-transparent', 'active');
				
				filterArticles();
			});
		});

		function sortArticles() {
			if (!gridContainer) return;
			
			const cardsArray = Array.from(gridContainer.children) as HTMLElement[];
			
			cardsArray.sort((a, b) => {
				if (currentSort === 'latest') {
					return parseFloat(b.getAttribute('data-timestamp') || '0') - parseFloat(a.getAttribute('data-timestamp') || '0');
				} else if (currentSort === 'oldest') {
					return parseFloat(a.getAttribute('data-timestamp') || '0') - parseFloat(b.getAttribute('data-timestamp') || '0');
				} else if (currentSort === 'az') {
					return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
				} else {
					// Default index sort
					return parseInt(a.getAttribute('data-index') || '0') - parseInt(b.getAttribute('data-index') || '0');
				}
			});

			// Re-append in sorted order (this automatically moves them)
			cardsArray.forEach(card => {
				// Add a tiny stagger animation for that premium feel
				card.style.opacity = '0';
				card.style.transform = 'translateY(10px)';
				gridContainer.appendChild(card);
				
				setTimeout(() => {
					card.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
					card.style.opacity = '1';
					card.style.transform = 'translateY(0)';
				}, 50);
			});
		}

		sortBtns.forEach(btn => {
			btn.addEventListener('click', (e) => {
				const target = e.currentTarget as HTMLButtonElement;
				currentSort = target.getAttribute('data-sort') || 'latest';
				
				// Update UI Label
				if (activeSortLabel) {
					activeSortLabel.textContent = target.getAttribute('data-label') || 'Latest Release';
				}

				// Update active indicator
				sortBtns.forEach(b => {
					const indicator = b.querySelector('.sort-indicator');
					if (indicator) indicator.classList.add('hidden');
				});
				const activeIndicator = target.querySelector('.sort-indicator');
				if (activeIndicator) activeIndicator.classList.remove('hidden');

				sortArticles();
			});
		});

		// Initialize default sort indicator
		const defaultSortBtn = document.querySelector('.sort-btn[data-sort="latest"]');
		if (defaultSortBtn) {
			const indicator = defaultSortBtn.querySelector('.sort-indicator');
			if (indicator) indicator.classList.remove('hidden');
		}

	});
</script>
