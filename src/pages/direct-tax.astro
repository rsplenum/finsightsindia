---
import Layout from '../layouts/Layout.astro';
import { TAX_ARTICLES } from '../data/taxArticles';

const articlesList = Object.values(TAX_ARTICLES);
---

<Layout title="India Direct Tax Code 2025 & Calculators — SWP Intelligence">
	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 space-y-10">
		
		<!-- Hero Header Section -->
		<section class="max-w-4xl mx-auto text-center space-y-4 hero-glow reveal">
			<div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-navy-100 dark:bg-navy-900 text-navy-900 dark:text-navy-100 text-xs font-semibold tracking-wider uppercase border border-navy-200 dark:border-white/10 shadow-xs">
				<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
				<span>AUTHENTIC INDIA DIRECT TAX CODE (FY 2025-26)</span>
			</div>
			<h1 class="text-hero sm:text-4xl lg:text-5xl font-bold tracking-tight text-navy-900 dark:text-navy-100 font-sans leading-tight">
				India Direct Tax Intelligence Hub
			</h1>
			<p class="text-base sm:text-lg text-navy-600 dark:text-navy-400 font-normal leading-relaxed max-w-2xl mx-auto font-sans">
				First-principles tax guidance, interactive slab calculators, capital gains rules, and quantitative master whitepapers under the Income Tax Act, 2025.
			</p>
		</section>

		<!-- INTERACTIVE INDIA TAX REGIME CALCULATOR PANEL -->
		<section class="max-w-6xl mx-auto card-premium rounded-2xl p-6 sm:p-8 space-y-6 shadow-xs transition-all duration-200 ease-geist reveal">
			
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-navy-200 dark:border-white/10 pb-4">
				<div>
					<span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">INTERACTIVE SLAB ENGINE</span>
					<h2 class="text-xl font-bold tracking-tight text-navy-900 dark:text-navy-100">India Income Tax Calculator (FY 2025-26)</h2>
				</div>
				<div id="indiaSavingsBadge" class="badge-safe px-3 py-1.5 rounded-lg text-xs font-mono font-bold self-start sm:self-auto">
					New Regime Recommended
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
				<!-- Inputs Column (5/12) -->
				<div class="lg:col-span-5 space-y-4">
					<div class="space-y-1.5">
						<label for="inIndiaSalary" class="text-xs font-semibold text-navy-700 dark:text-navy-300">
							Gross Annual Income / Salary (₹)
						</label>
						<div class="relative">
							<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-navy-400 text-sm font-mono font-medium">₹</span>
							<input 
								type="number" 
								id="inIndiaSalary" 
								value="1500000" 
								min="0" 
								step="50000" 
								class="input-premium pl-8"
							/>
						</div>
					</div>

					<div class="space-y-1.5">
						<label for="inIndiaDeductions" class="text-xs font-semibold text-navy-700 dark:text-navy-300">
							Old Regime Deductions (80C, 80D, HRA, 24b Home Loan) (₹)
						</label>
						<div class="relative">
							<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-navy-400 text-sm font-mono font-medium">₹</span>
							<input 
								type="number" 
								id="inIndiaDeductions" 
								value="250000" 
								min="0" 
								step="25000" 
								class="input-premium pl-8"
							/>
						</div>
						<p class="text-[11px] text-navy-400 dark:text-navy-500 font-mono">Includes ₹1.5L 80C + ₹50k 80D + HRA/Interest.</p>
					</div>
				</div>

				<!-- Outputs Column (7/12) -->
				<div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
					<!-- New Tax Regime Card -->
					<div class="p-5 card-premium border-emerald-500/30 rounded-2xl space-y-3">
						<div class="flex justify-between items-center text-xs font-mono font-bold">
							<span class="text-emerald-600 dark:text-emerald-400 uppercase">NEW TAX REGIME (DEFAULT)</span>
							<span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 text-[10px]">FY 2025-26</span>
						</div>
						<div class="space-y-1">
							<div class="text-xs text-navy-500 dark:text-navy-400">Total Tax Payable:</div>
							<div id="valNewTax" class="text-2xl font-mono font-black text-navy-900 dark:text-navy-100">₹ 0</div>
						</div>
						<div class="pt-2 border-t border-navy-200 dark:border-white/10 text-[11px] font-mono text-navy-500 dark:text-navy-400 space-y-1">
							<div>Std Deduction: ₹75,000</div>
							<div>Sec 87A Rebate: Up to ₹12.75L Tax-Free</div>
							<div id="valNewEffectiveRate" class="font-bold text-navy-800 dark:text-navy-200">Effective Rate: 0.0%</div>
						</div>
					</div>

					<!-- Old Tax Regime Card -->
					<div class="p-5 card-premium rounded-2xl space-y-3">
						<div class="flex justify-between items-center text-xs font-mono font-bold">
							<span class="text-navy-500 dark:text-navy-400 uppercase">OLD TAX REGIME (OPTIONAL)</span>
							<span class="px-2 py-0.5 rounded bg-navy-200 dark:bg-navy-800 text-navy-600 dark:text-navy-400 text-[10px]">WITH DEDUCTIONS</span>
						</div>
						<div class="space-y-1">
							<div class="text-xs text-navy-500 dark:text-navy-400">Total Tax Payable:</div>
							<div id="valOldTax" class="text-2xl font-mono font-bold text-navy-900 dark:text-navy-100">₹ 0</div>
						</div>
						<div class="pt-2 border-t border-navy-200 dark:border-white/10 text-[11px] font-mono text-navy-500 dark:text-navy-400 space-y-1">
							<div>Std Deduction: ₹50,000</div>
							<div>User Deductions: <span id="valOldDeductionsText">₹2,50,000</span></div>
							<div id="valOldEffectiveRate" class="font-bold text-navy-800 dark:text-navy-200">Effective Rate: 0.0%</div>
						</div>
					</div>
				</div>
			</div>

		</section>

		<!-- CATEGORIZED TOP DIRECT TAX MASTER WHITEPAPERS -->
		<section class="card-premium rounded-2xl p-6 sm:p-8 space-y-6 shadow-xs transition-all duration-200 ease-geist max-w-7xl mx-auto reveal">
			
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-navy-200 dark:border-white/10">
				<div>
					<h2 class="text-xl font-bold tracking-tight text-navy-900 dark:text-navy-100 font-sans">
						Institutional Direct Tax Whitepapers (Income Tax Act 2025)
					</h2>
					<p class="text-xs text-navy-500 dark:text-navy-400 font-sans mt-0.5">
						Comprehensive, multi-section master guides structured into legal statutory basis, mathematical breakdowns, case study tables, and notice traps.
					</p>
				</div>
				<span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 px-3 py-1 rounded bg-emerald-500/10 border border-emerald-500/20">
					5 Published Master Guides
				</span>
			</div>

			<!-- Dynamic Master Article Cards Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="faqCardGrid" class="reveal-stagger">
				{articlesList.map((art, idx) => (
					<div class="faq-card card-premium rounded-2xl p-6 space-y-4 hover:border-navy-300 dark:hover:border-white/20 transition-all duration-200 ease-geist shadow-xs flex flex-col justify-between">
						<div class="space-y-3">
							<div class="flex items-center justify-between">
								<span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-widest badge-safe">
									🇮🇳 {art.categoryName}
								</span>
								<span class="text-xs font-mono text-navy-400 dark:text-navy-500 font-bold">Q0{idx + 1}</span>
							</div>

							<h3 class="text-lg font-bold text-navy-900 dark:text-navy-100 font-sans leading-snug">
								{art.title}
							</h3>

							<div class="text-xs font-mono text-navy-500 dark:text-navy-400 flex items-center gap-2">
								<span>{art.readTime}</span>
								<span>•</span>
								<span class="text-emerald-600 dark:text-emerald-400 font-bold">{art.statutoryAct}</span>
							</div>

							<p class="text-xs text-navy-600 dark:text-navy-400 leading-relaxed font-sans line-clamp-3">
								{art.summary}
							</p>
						</div>

						<div class="space-y-3 pt-2">
							<div class="p-3 bg-emerald-500/5 dark:bg-emerald-500/10 rounded-lg border-l-2 border-emerald-500 text-xs font-sans text-navy-700 dark:text-navy-300 space-y-1">
								<div class="text-[10px] font-mono font-bold text-emerald-800 dark:text-emerald-300 uppercase">💡 Key Insight</div>
								<div>{art.sec6_KeyTakeawaysChecklist.checklistItems[0]}</div>
							</div>

							<a 
								href={`/direct-tax/${art.slug}`} 
								class="inline-flex items-center justify-center w-full py-2.5 px-4 rounded-lg btn-gold w-full text-center"
							>
								Read Full 6-Section Whitepaper →
							</a>
						</div>
					</div>
				))}
			</div>

		</section>

	</main>
</Layout>

<script>
	function parseNum(id: string, defaultVal: number): number {
		const el = document.getElementById(id) as HTMLInputElement;
		if (!el) return defaultVal;
		const parsed = parseFloat(el.value);
		return isNaN(parsed) ? defaultVal : parsed;
	}

	function formatRupee(val: number): string {
		if (isNaN(val)) return '₹ 0';
		return `₹ ${Math.round(val).toLocaleString('en-IN')}`;
	}

	// 🇮🇳 INDIA INCOME TAX CALCULATOR (FY 2025-26)
	function calculateIndiaTax() {
		const grossSalary = parseNum('inIndiaSalary', 1500000);
		const userDeductions = parseNum('inIndiaDeductions', 250000);

		const oldDedText = document.getElementById('valOldDeductionsText');
		if (oldDedText) oldDedText.innerText = formatRupee(userDeductions);

		// NEW TAX REGIME (FY 2025-26)
		const newStdDed = 75000;
		const newTaxableIncome = Math.max(0, grossSalary - newStdDed);
		let newTax = 0;

		if (newTaxableIncome <= 400000) {
			newTax = 0;
		} else if (newTaxableIncome <= 800000) {
			newTax = (newTaxableIncome - 400000) * 0.05;
		} else if (newTaxableIncome <= 1200000) {
			newTax = (400000 * 0.05) + (newTaxableIncome - 800000) * 0.10;
		} else if (newTaxableIncome <= 1600000) {
			newTax = (400000 * 0.05) + (400000 * 0.10) + (newTaxableIncome - 1200000) * 0.15;
		} else if (newTaxableIncome <= 2000000) {
			newTax = (400000 * 0.05) + (400000 * 0.10) + (400000 * 0.15) + (newTaxableIncome - 1600000) * 0.20;
		} else if (newTaxableIncome <= 2400000) {
			newTax = (400000 * 0.05) + (400000 * 0.10) + (400000 * 0.15) + (400000 * 0.20) + (newTaxableIncome - 2000000) * 0.25;
		} else {
			newTax = (400000 * 0.05) + (400000 * 0.10) + (400000 * 0.15) + (400000 * 0.20) + (400000 * 0.25) + (newTaxableIncome - 2400000) * 0.30;
		}

		// Sec 87A Rebate for New Regime (Taxable Income <= ₹12 Lakh has 100% tax rebate)
		if (newTaxableIncome <= 1200000) {
			newTax = 0;
		}

		// Add 4% Cess
		newTax = Math.round(newTax * 1.04);

		// OLD TAX REGIME (FY 2025-26)
		const oldStdDed = 50000;
		const oldTaxableIncome = Math.max(0, grossSalary - oldStdDed - userDeductions);
		let oldTax = 0;

		if (oldTaxableIncome <= 250000) {
			oldTax = 0;
		} else if (oldTaxableIncome <= 500000) {
			oldTax = (oldTaxableIncome - 250000) * 0.05;
		} else if (oldTaxableIncome <= 1000000) {
			oldTax = (250000 * 0.05) + (oldTaxableIncome - 500000) * 0.20;
		} else {
			oldTax = (250000 * 0.05) + (500000 * 0.20) + (oldTaxableIncome - 1000000) * 0.30;
		}

		if (oldTaxableIncome <= 500000) {
			oldTax = 0; // Sec 87A rebate for old regime
		}

		oldTax = Math.round(oldTax * 1.04);

		// Update UI DOM
		const newTaxEl = document.getElementById('valNewTax');
		const oldTaxEl = document.getElementById('valOldTax');
		const newEffEl = document.getElementById('valNewEffectiveRate');
		const oldEffEl = document.getElementById('valOldEffectiveRate');
		const badgeEl = document.getElementById('indiaSavingsBadge');

		if (newTaxEl) newTaxEl.innerText = formatRupee(newTax);
		if (oldTaxEl) oldTaxEl.innerText = formatRupee(oldTax);

		const newEff = grossSalary > 0 ? ((newTax / grossSalary) * 100).toFixed(1) : '0.0';
		const oldEff = grossSalary > 0 ? ((oldTax / grossSalary) * 100).toFixed(1) : '0.0';

		if (newEffEl) newEffEl.innerText = `Effective Rate: ${newEff}%`;
		if (oldEffEl) oldEffEl.innerText = `Effective Rate: ${oldEff}%`;

		if (badgeEl) {
			if (newTax < oldTax) {
				badgeEl.innerText = `New Regime Saves ${formatRupee(oldTax - newTax)}`;
				badgeEl.className = "badge-safe px-3 py-1.5 rounded-lg text-xs font-mono font-bold self-start sm:self-auto";
			} else if (oldTax < newTax) {
				badgeEl.innerText = `Old Regime Saves ${formatRupee(newTax - oldTax)}`;
				badgeEl.className = "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 px-3 py-1.5 rounded-lg text-xs font-mono font-bold self-start sm:self-auto";
			} else {
				badgeEl.innerText = "Both Regimes Equal Tax";
				badgeEl.className = "bg-navy-200 dark:bg-navy-800 text-navy-600 dark:text-navy-400 border border-navy-300 dark:border-white/10 px-3 py-1.5 rounded-lg text-xs font-mono font-bold self-start sm:self-auto";
			}
		}
	}

	// Initialization setup
	document.addEventListener('DOMContentLoaded', () => {
		calculateIndiaTax();

		const inSal = document.getElementById('inIndiaSalary');
		const inDed = document.getElementById('inIndiaDeductions');
		inSal?.addEventListener('input', calculateIndiaTax);
		inDed?.addEventListener('input', calculateIndiaTax);
	});
</script>
