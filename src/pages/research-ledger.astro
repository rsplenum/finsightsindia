---
import Layout from '../layouts/Layout.astro';
import ledgerData from '../data/researchLedger.json';

const title = "FinSight Research Ledger";
const description = "Behind the scenes: The first-principles research, strategy, and molding decisions that shape every FinSight article.";
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-slate-50 dark:bg-navy-950 flex flex-col md:flex-row mt-16 border-t border-slate-200 dark:border-navy-800">
    
    {/* Sidebar Navigation */}
    <aside class="w-full md:w-80 bg-white dark:bg-navy-900 border-r border-slate-200 dark:border-navy-800 flex-shrink-0 h-[calc(100vh-4rem)] overflow-y-auto hidden md:block">
      <div class="p-6">
        <h2 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-6">Topic Database</h2>
        <ul class="space-y-2" id="ledger-nav">
          {ledgerData.map((item, index) => (
            <li>
              <button 
                class={`w-full text-left px-4 py-3 rounded-lg text-sm font-medium transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-opacity-50 ${index === 0 ? 'bg-brand-navy text-white shadow-md' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800 hover:text-brand-navy dark:hover:text-white'}`}

                data-target={item.slug}
                aria-selected={index === 0 ? 'true' : 'false'}
              >
                <span class="block text-xs opacity-75 mb-1 font-mono">{item.category}</span>
                {item.title}
              </button>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    {/* Mobile Dropdown (Visible on small screens) */}
    <div class="md:hidden p-4 bg-white dark:bg-navy-900 border-b border-slate-200 dark:border-navy-800 sticky top-16 z-20">
       <label for="mobile-ledger-select" class="sr-only">Select a Topic</label>
       <select id="mobile-ledger-select" class="block w-full rounded-md border-slate-300 dark:border-navy-700 bg-white dark:bg-navy-800 text-slate-900 dark:text-slate-100 py-2 pl-3 pr-10 text-base focus:border-brand-navy focus:outline-none focus:ring-brand-navy sm:text-sm">
         {ledgerData.map((item) => (
           <option value={item.slug}>{item.title}</option>
         ))}
       </select>
    </div>

    {/* Main Content Area */}
    <main class="flex-1 bg-slate-50 dark:bg-navy-950 h-[calc(100vh-4rem)] overflow-y-auto">
      <div class="max-w-4xl mx-auto p-6 md:p-12">
        
        <header class="mb-10 border-b border-slate-200 dark:border-navy-800 pb-8">
          <h1 class="text-3xl md:text-4xl font-extrabold text-brand-navy dark:text-white font-serif mb-4" id="content-title">
            {ledgerData[0].title}
          </h1>
          <div class="flex items-center space-x-4">
             <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-brand-gold bg-opacity-10 text-brand-gold border border-brand-gold border-opacity-20" id="content-category">
               {ledgerData[0].category}
             </span>
             <span class="text-sm text-slate-500 dark:text-slate-400 font-mono">Stage: Final Draft Executed</span>
          </div>
        </header>

        <div class="prose prose-slate dark:prose-invert prose-lg max-w-none prose-headings:font-serif prose-headings:text-brand-navy dark:prose-headings:text-white prose-a:text-brand-gold hover:prose-a:text-yellow-600">
          
          <div class="bg-white dark:bg-navy-900 p-8 rounded-xl shadow-sm border border-slate-200 dark:border-navy-800 mb-8 relative overflow-hidden group">
            <div class="absolute top-0 left-0 w-1 h-full bg-brand-navy dark:bg-brand-gold"></div>
            <h2 class="text-xl font-bold mt-0 mb-4 flex items-center text-brand-navy dark:text-white">
               <svg class="w-5 h-5 mr-2 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
               Deep Research & Analysis
            </h2>
            <p id="content-research" class="text-slate-600 dark:text-slate-300 leading-relaxed whitespace-pre-wrap">{ledgerData[0].research}</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
             <div class="bg-white dark:bg-navy-900 p-6 rounded-xl shadow-sm border border-slate-200 dark:border-navy-800">
                <h3 class="text-lg font-bold mt-0 mb-3 text-slate-800 dark:text-slate-100 flex items-center">
                  <svg class="w-4 h-4 mr-2 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                  Search Intent (The Panic)
                </h3>
                <p id="content-search" class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{ledgerData[0].searchIntent}</p>
             </div>
             
             <div class="bg-white dark:bg-navy-900 p-6 rounded-xl shadow-sm border border-slate-200 dark:border-navy-800">
                <h3 class="text-lg font-bold mt-0 mb-3 text-slate-800 dark:text-slate-100 flex items-center">
                  <svg class="w-4 h-4 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
                  What They Ought to Know
                </h3>
                <p id="content-ought" class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed whitespace-pre-wrap">{ledgerData[0].oughtToKnow}</p>
             </div>
          </div>

          <div class="bg-slate-800 text-slate-100 p-8 rounded-xl shadow-lg mb-8 relative overflow-hidden">
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-24 h-24 bg-brand-gold opacity-10 rounded-full blur-2xl"></div>
            <h2 class="text-xl font-bold mt-0 mb-4 text-white">The First-Principles Mechanics</h2>
            <p id="content-mechanics" class="text-slate-300 leading-relaxed whitespace-pre-wrap text-sm">{ledgerData[0].mechanics}</p>
          </div>

          <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700/50 p-8 rounded-xl mb-8">
            <h2 class="text-xl font-bold mt-0 mb-4 text-amber-900 dark:text-amber-500">The Delta (Safe vs Trapped)</h2>
            <p id="content-delta" class="text-amber-800 dark:text-amber-200/80 leading-relaxed text-sm">{ledgerData[0].delta}</p>
          </div>

          <div class="bg-white dark:bg-navy-900 p-8 rounded-xl shadow-sm border border-brand-gold border-opacity-30 relative overflow-hidden">
             <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-brand-gold to-yellow-600"></div>
             <h2 class="text-xl font-bold mt-0 mb-4 text-brand-navy dark:text-white">Molding Decisions & Strategy</h2>
             <p id="content-molding" class="text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-wrap font-medium">{ledgerData[0].moldingDecisions}</p>
          </div>

        </div>
      </div>
    </main>

  </div>
</Layout>

<script>
  // Expose the JSON data to the client
  import ledgerData from '../data/researchLedger.json';

  document.addEventListener('DOMContentLoaded', () => {
    const navButtons = document.querySelectorAll('#ledger-nav button');
    const mobileSelect = document.getElementById('mobile-ledger-select');
    
    const elements = {
      title: document.getElementById('content-title'),
      category: document.getElementById('content-category'),
      research: document.getElementById('content-research'),
      search: document.getElementById('content-search'),
      ought: document.getElementById('content-ought'),
      mechanics: document.getElementById('content-mechanics'),
      delta: document.getElementById('content-delta'),
      molding: document.getElementById('content-molding'),
    };

    function updateContent(slug) {
      const data = ledgerData.find(item => item.slug === slug);
      if (!data) return;

      // Update DOM
      elements.title.textContent = data.title;
      elements.category.textContent = data.category;
      elements.research.textContent = data.research;
      elements.search.textContent = data.searchIntent;
      elements.ought.textContent = data.oughtToKnow;
      elements.mechanics.textContent = data.mechanics;
      elements.delta.textContent = data.delta;
      elements.molding.textContent = data.moldingDecisions;

      // Update button active states
      navButtons.forEach(btn => {
        if (btn.getAttribute('data-target') === slug) {
          btn.classList.remove('text-slate-600', 'dark:text-slate-400', 'hover:bg-slate-100', 'dark:hover:bg-navy-800', 'hover:text-brand-navy', 'dark:hover:text-white');
          btn.classList.add('bg-brand-navy', 'text-white', 'shadow-md');
          btn.setAttribute('aria-selected', 'true');
        } else {
          btn.classList.add('text-slate-600', 'dark:text-slate-400', 'hover:bg-slate-100', 'dark:hover:bg-navy-800', 'hover:text-brand-navy', 'dark:hover:text-white');
          btn.classList.remove('bg-brand-navy', 'text-white', 'shadow-md');
          btn.setAttribute('aria-selected', 'false');
        }
      });
      
      // Update mobile select
      if(mobileSelect && mobileSelect.value !== slug) {
          mobileSelect.value = slug;
      }
    }

    // Add click listeners to sidebar
    navButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetSlug = btn.getAttribute('data-target');
        updateContent(targetSlug);
      });
    });
    
    // Add change listener to mobile select
    if (mobileSelect) {
        mobileSelect.addEventListener('change', (e) => {
            updateContent(e.target.value);
        });
    }
  });
</script>
