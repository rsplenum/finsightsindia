---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us — SWP Intelligence Engine" description="Contact SWP Intelligence Engine for support, feedback, bug reports, or business inquiries.">
	<main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-slate-700 dark:text-zinc-300 space-y-8">
		<div class="border-b border-slate-200 dark:border-white/10 pb-6">
			<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-zinc-100">
				Contact Us
			</h1>
			<p class="text-base text-slate-600 dark:text-zinc-400 mt-2 leading-relaxed">
				Have questions, feedback, or bug reports? We'd love to hear from you.
			</p>
		</div>

		<!-- Contact Information Card -->
		<div class="bg-white dark:bg-zinc-950 border border-slate-200 dark:border-white/10 rounded-xl p-6 sm:p-8 space-y-6">
			<div class="flex items-start gap-4">
				<div class="w-10 h-10 rounded-md bg-slate-100 dark:bg-zinc-900 text-slate-900 dark:text-zinc-100 flex items-center justify-center shrink-0 border border-slate-200 dark:border-white/10">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
					</svg>
				</div>
				<div>
					<h2 class="text-lg font-bold text-slate-900 dark:text-zinc-100">Direct Email Support</h2>
					<p class="text-sm text-slate-500 dark:text-zinc-400 mt-1">
						For general questions, mathematical feedback, or partnership inquiries, reach out to our team directly:
					</p>
					<a href="mailto:support@swpplanner.com" class="inline-block mt-3 text-base font-semibold text-slate-900 dark:text-zinc-100 underline hover:text-slate-600 dark:hover:text-white transition-colors duration-200 ease-geist">
						support@swpplanner.com
					</a>
				</div>
			</div>

			<div class="h-px bg-slate-200 dark:bg-white/10"></div>

			<div class="space-y-3 text-sm leading-relaxed">
				<h3 class="font-bold text-slate-900 dark:text-zinc-100">What you can contact us for:</h3>
				<ul class="list-disc pl-5 space-y-1.5 text-slate-600 dark:text-zinc-400">
					<li>Bug reports or calculation discrepancies</li>
					<li>Feature requests & mathematical suggestions</li>
					<li>Google AdSense & media partnerships</li>
				</ul>
			</div>
		</div>

		<!-- UI Message Card (No Functional Backend Required) -->
		<div class="bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-white/10 rounded-xl p-6 space-y-4">
			<h3 class="text-base font-bold text-slate-900 dark:text-zinc-100">Send us a Message</h3>
			<p class="text-xs text-slate-500 dark:text-zinc-400">
				Note: You can email us directly at <span class="font-mono text-slate-700 dark:text-zinc-300">support@swpplanner.com</span>. We typically respond within 24–48 business hours.
			</p>
			
			<form onsubmit="event.preventDefault(); alert('Thank you for reaching out! Please email support@swpplanner.com directly for immediate assistance.');" class="space-y-4 pt-2">
				<div>
					<label for="contactName" class="block text-xs font-semibold text-slate-700 dark:text-zinc-300 mb-1">Your Name</label>
					<input type="text" id="contactName" placeholder="Jane Doe" required class="w-full bg-white dark:bg-zinc-950 border border-slate-200 dark:border-white/10 rounded-md px-4 py-2.5 text-sm text-slate-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist" />
				</div>
				<div>
					<label for="contactEmail" class="block text-xs font-semibold text-slate-700 dark:text-zinc-300 mb-1">Your Email</label>
					<input type="email" id="contactEmail" placeholder="jane@example.com" required class="w-full bg-white dark:bg-zinc-950 border border-slate-200 dark:border-white/10 rounded-md px-4 py-2.5 text-sm text-slate-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist" />
				</div>
				<div>
					<label for="contactMessage" class="block text-xs font-semibold text-slate-700 dark:text-zinc-300 mb-1">Message</label>
					<textarea id="contactMessage" rows="4" placeholder="How can we help you?" required class="w-full bg-white dark:bg-zinc-950 border border-slate-200 dark:border-white/10 rounded-md px-4 py-2.5 text-sm text-slate-900 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-slate-900 dark:focus:ring-white transition-all duration-200 ease-geist"></textarea>
				</div>
				<button type="submit" class="w-full bg-slate-900 hover:bg-slate-800 text-white dark:bg-white dark:hover:bg-zinc-200 dark:text-black font-semibold py-3 px-6 rounded-md transition-all duration-200 ease-geist cursor-pointer text-sm">
					Submit Message
				</button>
			</form>
		</div>
	</main>
</Layout>
