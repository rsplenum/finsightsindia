---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardPremium from '../components/CardPremium.astro';
import InputGroup from '../components/InputGroup.astro';
import SectionTitle from '../components/SectionTitle.astro';
---

<Layout title="Black-Scholes Options Pricing Engine — SWP Intelligence">
	<Hero 
		badge="Derivative Risk & Options Analytics"
		title="Black-Scholes Options Pricing Engine"
		description="Evaluate call and put option premiums, implied volatility sensitivity (Vega), time decay drag (Theta), and delta hedging parameters in real-time."
	/>

	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-16 sm:pt-6 sm:pb-24 space-y-8">
		
		<!-- Main 2-Column Grid Layout -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-7xl mx-auto">
			
			<!-- Left Column: Input Control Panel (5 Cols) -->
			<CardPremium glass={true} class="lg:col-span-5 space-y-6">
				
				<div class="border-b border-navy-200 dark:border-navy-800 pb-4">
					<SectionTitle title="Option Contract Parameters" />
					<p class="text-xs text-navy-500 dark:text-navy-400 mt-1">Adjust market variables to price derivatives and compute sensitivities.</p>
				</div>

				<div class="space-y-4">
					<InputGroup 
						id="bsSpot"
						label="Spot Price (S)"
						tooltip="Current Asset Price in the spot market."
						prefix="₹"
						suffix="Current Asset Price"
						value="24000"
					/>
					<InputGroup 
						id="bsStrike"
						label="Strike Price (K)"
						tooltip="The price at which the option can be exercised."
						prefix="₹"
						suffix="Exercise Price"
						value="24000"
					/>
					<div class="space-y-4">
						<InputGroup 
							id="bsDays"
							label="Days to Expiration (D)"
							tooltip="Calendar days remaining until option expiration."
							suffix="Days"
							type="number"
							value="30"
						/>
						<div class="flex justify-between items-center text-xs px-1">
							<span class="text-navy-500 dark:text-navy-400">Time to Expiry:</span>
							<span id="bsTimeYears" class="font-bold text-navy-900 dark:text-navy-100">0.082 Yrs</span>
						</div>
					</div>
					<InputGroup 
						id="bsRate"
						label="Risk-Free Interest Rate (r)"
						tooltip="Annualized risk-free interest rate."
						suffix="% Annual"
						type="number"
						value="7.0"
					/>
					<InputGroup 
						id="bsVol"
						label="Implied Volatility (v)"
						tooltip="Annualized implied volatility (standard deviation)."
						suffix="% Volatility"
						type="number"
						value="15.0"
					/>
					<InputGroup 
						id="bsDivYield"
						label="Dividend Yield (q)"
						tooltip="Continuous annual dividend yield (e.g. Nifty is ~1.2%)."
						suffix="% Annual"
						type="number"
						value="1.2"
					/>
				</div>
			</CardPremium>

			<!-- Right Column: Outputs Dashboard (7 Cols) -->
			<div class="lg:col-span-7 space-y-6">
				
				<!-- Top Half: Dual-Theme Option Premium Card -->
				<CardPremium glass={true} class="space-y-6">
					
					<div class="flex items-center justify-between border-b border-navy-200 dark:border-navy-800 pb-4">
						<div>
							<h3 class="text-xs font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">Theoretical Option Premiums</h3>
							<div class="text-xs text-navy-500 dark:text-navy-400 mt-1">Fair value calculated via Black-Scholes continuous pricing model</div>
						</div>
						<div class="text-[10px] font-bold tracking-widest text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 px-3 py-1.5 rounded-md">
							d1: <span id="valD1" class="text-navy-900 dark:text-navy-100">0.00</span> | d2: <span id="valD2" class="text-navy-900 dark:text-navy-100">0.00</span>
						</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
						<!-- Call Option Premium -->
						<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-5 flex flex-col justify-between">
							<div class="flex items-center justify-between text-[10px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest mb-1">
								<span>Call Premium</span>
								<span class="bg-emerald-50 text-emerald-700 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 px-2 py-0.5 rounded-md">Bullish</span>
							</div>
							<div id="valCallPrice" class="text-3xl sm:text-4xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-2">
								₹0.00
							</div>
							<div class="text-xs text-navy-500 dark:text-navy-400 mt-3">Right to BUY at ₹<span id="callStrikeLabel" class="font-bold text-navy-900 dark:text-navy-100">100</span></div>
						</div>

						<!-- Put Option Premium -->
						<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-5 flex flex-col justify-between">
							<div class="flex items-center justify-between text-[10px] font-bold text-rose-600 dark:text-rose-400 uppercase tracking-widest mb-1">
								<span>Put Premium</span>
								<span class="bg-rose-50 text-rose-700 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200 dark:border-rose-800 px-2 py-0.5 rounded-md">Bearish / Hedge</span>
							</div>
							<div id="valPutPrice" class="text-3xl sm:text-4xl font-extrabold text-rose-600 dark:text-rose-400 mt-2">
								₹0.00
							</div>
							<div class="text-xs text-navy-500 dark:text-navy-400 mt-3">Right to SELL at ₹<span id="putStrikeLabel" class="font-bold text-navy-900 dark:text-navy-100">100</span></div>
						</div>
					</div>
				</CardPremium>

				<!-- Bottom Half: The Greeks Sensitivity Grid -->
				<CardPremium glass={true} class="space-y-4">
					
					<div class="border-b border-navy-200 dark:border-navy-800 pb-3">
						<SectionTitle title="Option Risk Sensitivities (The Greeks)" />
						<p class="text-xs text-navy-500 dark:text-navy-400 mt-1">First and second-order partial derivatives relative to price, time, and volatility.</p>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
						<!-- Delta -->
						<div class="p-4 bg-navy-50 dark:bg-navy-900 rounded-lg border border-navy-200 dark:border-navy-800 flex flex-col justify-between">
							<div class="flex justify-between items-baseline mb-2">
								<span class="text-[10px] font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">Delta (Δ)</span>
								<span class="text-[9px] font-bold text-navy-500 dark:text-navy-400">Velocity</span>
							</div>
							<div class="space-y-1.5 text-xs text-navy-600 dark:text-navy-400 mt-1">
								<div class="flex justify-between border-b border-navy-200 dark:border-navy-800 pb-1">
									<span>Call:</span>
									<span id="valDeltaCall" class="font-bold text-emerald-600 dark:text-emerald-400">+0.0000</span>
								</div>
								<div class="flex justify-between pt-0.5">
									<span>Put:</span>
									<span id="valDeltaPut" class="font-bold text-rose-600 dark:text-rose-400">-0.0000</span>
								</div>
							</div>
							<div class="text-[10px] text-navy-500 dark:text-navy-400 mt-3 pt-2 border-t border-navy-200 dark:border-navy-800 leading-tight">
								If Nifty goes up ₹100, the call option goes up approx ₹<span id="ctxDeltaCall" class="font-bold text-navy-700 dark:text-navy-300">0</span>.
							</div>
						</div>

						<!-- Gamma -->
						<div class="p-4 bg-navy-50 dark:bg-navy-900 rounded-lg border border-navy-200 dark:border-navy-800 flex flex-col justify-between">
							<div class="flex justify-between items-baseline mb-2">
								<span class="text-[10px] font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">Gamma (Γ)</span>
								<span class="text-[9px] font-bold text-navy-500 dark:text-navy-400">Acceleration</span>
							</div>
							<div class="text-xl font-extrabold text-navy-900 dark:text-navy-100 mt-1">
								<span id="valGamma">0.000000</span>
							</div>
							<div class="text-[10px] text-navy-500 dark:text-navy-400 mt-3 pt-2 border-t border-navy-200 dark:border-navy-800 leading-tight">
								Rate of change in Delta per ₹1 move in spot price. Higher near ATM.
							</div>
						</div>

						<!-- Theta -->
						<div class="p-4 bg-navy-50 dark:bg-navy-900 rounded-lg border border-navy-200 dark:border-navy-800 flex flex-col justify-between">
							<div class="flex justify-between items-baseline mb-2">
								<span class="text-[10px] font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">Theta (Θ)</span>
								<span class="text-[9px] font-bold text-navy-500 dark:text-navy-400">Time Decay</span>
							</div>
							<div class="space-y-1.5 text-xs text-navy-600 dark:text-navy-400 mt-1">
								<div class="flex justify-between border-b border-navy-200 dark:border-navy-800 pb-1">
									<span>Call:</span>
									<span id="valThetaCall" class="font-bold text-amber-600 dark:text-amber-400">-₹0.0000</span>
								</div>
								<div class="flex justify-between pt-0.5">
									<span>Put:</span>
									<span id="valThetaPut" class="font-bold text-amber-600 dark:text-amber-400">-₹0.0000</span>
								</div>
							</div>
							<div class="text-[10px] text-navy-500 dark:text-navy-400 mt-3 pt-2 border-t border-navy-200 dark:border-navy-800 leading-tight">
								Every day you hold this option, it loses approx ₹<span id="ctxThetaCall" class="font-bold text-navy-700 dark:text-navy-300">0</span> in time value.
							</div>
						</div>

						<!-- Vega -->
						<div class="p-4 bg-navy-50 dark:bg-navy-900 rounded-lg border border-navy-200 dark:border-navy-800 flex flex-col justify-between">
							<div class="flex justify-between items-baseline mb-2">
								<span class="text-[10px] font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">Vega (ν)</span>
								<span class="text-[9px] font-bold text-navy-500 dark:text-navy-400">Volatility</span>
							</div>
							<div class="text-xl font-extrabold text-cyan-600 dark:text-cyan-400 mt-1">
								₹<span id="valVega">0.0000</span>
							</div>
							<div class="text-[10px] text-navy-500 dark:text-navy-400 mt-3 pt-2 border-t border-navy-200 dark:border-navy-800 leading-tight">
								If IV rises 1%, your option gains approx ₹<span id="ctxVega" class="font-bold text-navy-700 dark:text-navy-300">0</span>.
							</div>
						</div>

						<!-- Rho -->
						<div class="p-4 bg-navy-50 dark:bg-navy-900 rounded-lg border border-navy-200 dark:border-navy-800 flex flex-col justify-between">
							<div class="flex justify-between items-baseline mb-2">
								<span class="text-[10px] font-bold uppercase tracking-widest text-navy-900 dark:text-navy-100">Rho (ρ)</span>
								<span class="text-[9px] font-bold text-navy-500 dark:text-navy-400">Interest Rates</span>
							</div>
							<div class="space-y-1.5 text-xs text-navy-600 dark:text-navy-400 mt-1">
								<div class="flex justify-between border-b border-navy-200 dark:border-navy-800 pb-1">
									<span>Call:</span>
									<span id="valRhoCall" class="font-bold text-indigo-600 dark:text-indigo-400">+0.0000</span>
								</div>
								<div class="flex justify-between pt-0.5">
									<span>Put:</span>
									<span id="valRhoPut" class="font-bold text-indigo-600 dark:text-indigo-400">-0.0000</span>
								</div>
							</div>
							<div class="text-[10px] text-navy-500 dark:text-navy-400 mt-3 pt-2 border-t border-navy-200 dark:border-navy-800 leading-tight">
								Price change per 1% change in risk-free rate.
							</div>
						</div>

					</div>
				</CardPremium>

				<!-- IV Solver Card -->
				<CardPremium glass={true} class="space-y-4">
					<div class="border-b border-navy-200 dark:border-navy-800 pb-3">
						<SectionTitle title="Implied Volatility (IV) Solver" />
						<p class="text-xs text-navy-500 dark:text-navy-400 mt-1">Input the market price of an option to reverse-engineer the market's volatility expectation.</p>
					</div>
					<div class="flex items-end gap-4">
						<div class="w-1/2">
							<label class="block text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400 mb-1">Target Premium (₹)</label>
							<input type="number" id="ivTargetPrice" class="w-full bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-700 rounded-lg px-3 py-2 text-sm text-navy-900 dark:text-navy-100 focus:outline-none focus:ring-2 focus:ring-gold-500" placeholder="e.g. 150" />
						</div>
						<div class="w-1/2">
							<label class="block text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400 mb-1">Option Type</label>
							<select id="ivOptionType" class="w-full bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-700 rounded-lg px-3 py-2 text-sm text-navy-900 dark:text-navy-100 focus:outline-none focus:ring-2 focus:ring-gold-500">
								<option value="call">Call Option</option>
								<option value="put">Put Option</option>
							</select>
						</div>
					</div>
					<button id="btnSolveIV" class="w-full bg-navy-900 dark:bg-navy-100 text-white dark:text-navy-900 font-medium py-2 rounded-lg text-sm hover:bg-navy-800 dark:hover:bg-white transition-colors">Solve for IV</button>
					<div class="bg-navy-50 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 rounded-lg p-4 mt-2">
						<div class="text-[10px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400 text-center">Calculated Implied Volatility</div>
						<div id="valSolvedIV" class="text-2xl font-extrabold text-navy-900 dark:text-navy-100 text-center mt-1">--</div>
					</div>
				</CardPremium>

				<!-- Sensitivity Heatmap -->
				<CardPremium glass={true} class="space-y-4 mt-6">
					<div class="border-b border-navy-200 dark:border-navy-800 pb-3">
						<SectionTitle title="Call Premium Sensitivity Matrix" />
						<p class="text-xs text-navy-500 dark:text-navy-400 mt-1 leading-relaxed">Theoretical call price across changing days-to-expiry (rows) and implied volatility (columns).</p>
					</div>
					<div class="overflow-x-auto rounded-lg border border-navy-200 dark:border-navy-800">
						<table class="w-full text-[10px] sm:text-xs text-center whitespace-nowrap">
							<thead class="bg-navy-100 dark:bg-navy-900 text-navy-600 dark:text-navy-300 font-semibold uppercase tracking-wider text-[10px]">
								<tr>
									<th class="px-2 py-2 text-left border-r border-navy-200 dark:border-navy-800">Days \ IV</th>
									<th class="px-2 py-2" id="bsCol1">-5%</th>
									<th class="px-2 py-2 font-bold text-emerald-600 dark:text-emerald-400" id="bsCol2">Current</th>
									<th class="px-2 py-2" id="bsCol3">+5%</th>
								</tr>
							</thead>
							<tbody id="bsSensitivityBody" class="divide-y divide-navy-100 dark:divide-navy-800 bg-white/50 dark:bg-navy-950/50 font-mono">
								<!-- JS -->
							</tbody>
						</table>
					</div>
				</CardPremium>

			</div>
		</div>

	</main>
</Layout>

<script>
	import { calculateBlackScholes, impliedVolatility } from '../utils/blackScholes';
	import { parseFormattedNumber, setupFormattingField } from '../utils/formatters';

	function getNumValue(id: string, defaultVal: number): number {
		const el = document.getElementById(id) as HTMLInputElement;
		if (!el) return defaultVal;
		const parsed = parseFormattedNumber(el.value);
		return isNaN(parsed) ? defaultVal : parsed;
	}

	function updateBlackScholesUI() {
		const spot = getNumValue('bsSpot', 24000);
		const strike = getNumValue('bsStrike', 24000);
		const days = parseFloat((document.getElementById('bsDays') as HTMLInputElement)?.value || '30');
		const rate = parseFloat((document.getElementById('bsRate') as HTMLInputElement)?.value || '7.0');
		const vol = parseFloat((document.getElementById('bsVol') as HTMLInputElement)?.value || '15.0');
		const divYield = parseFloat((document.getElementById('bsDivYield') as HTMLInputElement)?.value || '1.2');

		const timeYears = Math.max(0.0001, days / 365);
		const timeYearsEl = document.getElementById('bsTimeYears');
		if (timeYearsEl) timeYearsEl.innerText = `${timeYears.toFixed(3)} Yrs`;

		const result = calculateBlackScholes(spot, strike, timeYears, rate, vol, divYield);

		const callEl = document.getElementById('valCallPrice');
		const putEl = document.getElementById('valPutPrice');
		if (callEl) callEl.innerText = `₹${result.callPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
		if (putEl) putEl.innerText = `₹${result.putPrice.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

		const callStrikeLabel = document.getElementById('callStrikeLabel');
		const putStrikeLabel = document.getElementById('putStrikeLabel');
		if (callStrikeLabel) callStrikeLabel.innerText = strike.toLocaleString('en-IN');
		if (putStrikeLabel) putStrikeLabel.innerText = strike.toLocaleString('en-IN');

		const d1El = document.getElementById('valD1');
		const d2El = document.getElementById('valD2');
		if (d1El) d1El.innerText = result.d1.toFixed(3);
		if (d2El) d2El.innerText = result.d2.toFixed(3);

		const deltaCallEl = document.getElementById('valDeltaCall');
		const deltaPutEl = document.getElementById('valDeltaPut');
		if (deltaCallEl) deltaCallEl.innerText = `${result.deltaCall >= 0 ? '+' : ''}${result.deltaCall.toFixed(4)}`;
		if (deltaPutEl) deltaPutEl.innerText = `${result.deltaPut.toFixed(4)}`;

		const gammaEl = document.getElementById('valGamma');
		if (gammaEl) gammaEl.innerText = result.gamma.toFixed(6);

		const thetaCallEl = document.getElementById('valThetaCall');
		const thetaPutEl = document.getElementById('valThetaPut');
		if (thetaCallEl) thetaCallEl.innerText = `-₹${Math.abs(result.thetaCallDaily).toFixed(4)}`;
		if (thetaPutEl) thetaPutEl.innerText = `-₹${Math.abs(result.thetaPutDaily).toFixed(4)}`;

		const vegaEl = document.getElementById('valVega');
		if (vegaEl) vegaEl.innerText = result.vegaPerPercent.toFixed(4);

		const rhoCallEl = document.getElementById('valRhoCall');
		const rhoPutEl = document.getElementById('valRhoPut');
		if (rhoCallEl) rhoCallEl.innerText = `${result.rhoCallPerPercent >= 0 ? '+' : ''}${result.rhoCallPerPercent.toFixed(4)}`;
		if (rhoPutEl) rhoPutEl.innerText = `${result.rhoPutPerPercent.toFixed(4)}`;

		const ctxDeltaCall = document.getElementById('ctxDeltaCall');
		if (ctxDeltaCall) ctxDeltaCall.innerText = (result.deltaCall * 100).toFixed(0);
		
		const ctxThetaCall = document.getElementById('ctxThetaCall');
		if (ctxThetaCall) ctxThetaCall.innerText = Math.abs(result.thetaCallDaily).toFixed(0);
		
		const ctxVega = document.getElementById('ctxVega');
		if (ctxVega) ctxVega.innerText = result.vegaPerPercent.toFixed(0);

		// Heatmap rendering
		const col1 = document.getElementById('bsCol1');
		const col2 = document.getElementById('bsCol2');
		const col3 = document.getElementById('bsCol3');
		if (col1) col1.innerText = `${Math.max(1, vol - 5).toFixed(1)}%`;
		if (col2) col2.innerText = `${vol.toFixed(1)}%`;
		if (col3) col3.innerText = `${(vol + 5).toFixed(1)}%`;

		const tbody = document.getElementById('bsSensitivityBody');
		if (tbody) {
			let html = '';
			const dayScenarios = [days, Math.max(1, days - 7), Math.max(1, days - 14), Math.max(1, days - 21)];
			const uniqueDays = Array.from(new Set(dayScenarios)).sort((a, b) => b - a);

			uniqueDays.forEach(d => {
				const t = Math.max(0.0001, d / 365);
				const p1 = calculateBlackScholes(spot, strike, t, rate, Math.max(1, vol - 5), divYield).callPrice;
				const p2 = calculateBlackScholes(spot, strike, t, rate, vol, divYield).callPrice;
				const p3 = calculateBlackScholes(spot, strike, t, rate, vol + 5, divYield).callPrice;

				const isCurrent = d === days;
				const highlight = isCurrent ? 'bg-gold-50 dark:bg-gold-900/20 font-bold text-navy-900 dark:text-navy-100' : 'text-navy-700 dark:text-navy-300';

				html += `<tr class="${highlight}">
					<td class="px-2 py-2.5 text-left border-r border-navy-200 dark:border-navy-800 ${isCurrent ? 'text-gold-700 dark:text-gold-400' : ''}">${d} Days</td>
					<td class="px-2 py-2.5">₹${p1.toFixed(2)}</td>
					<td class="px-2 py-2.5 ${isCurrent ? 'text-emerald-600 dark:text-emerald-400' : ''}">₹${p2.toFixed(2)}</td>
					<td class="px-2 py-2.5">₹${p3.toFixed(2)}</td>
				</tr>`;
			});
			tbody.innerHTML = html;
		}
	}

	function solveIV() {
		const targetPriceEl = document.getElementById('ivTargetPrice') as HTMLInputElement;
		const optionTypeEl = document.getElementById('ivOptionType') as HTMLSelectElement;
		const solvedIvEl = document.getElementById('valSolvedIV');
		
		if (!targetPriceEl || !targetPriceEl.value || !solvedIvEl) return;
		
		const targetPrice = parseFloat(targetPriceEl.value);
		const type = optionTypeEl.value as 'call' | 'put';
		
		const spot = getNumValue('bsSpot', 24000);
		const strike = getNumValue('bsStrike', 24000);
		const days = parseFloat((document.getElementById('bsDays') as HTMLInputElement)?.value || '30');
		const rate = parseFloat((document.getElementById('bsRate') as HTMLInputElement)?.value || '7.0');
		const divYield = parseFloat((document.getElementById('bsDivYield') as HTMLInputElement)?.value || '1.2');
		const timeYears = Math.max(0.0001, days / 365);
		
		solvedIvEl.innerText = 'Calculating...';
		
		setTimeout(() => {
			const iv = impliedVolatility(type, targetPrice, spot, strike, timeYears, rate, divYield);
			if (iv !== null) {
				solvedIvEl.innerText = `${(iv * 100).toFixed(2)}%`;
				const volInput = document.getElementById('bsVol') as HTMLInputElement;
				if (volInput) {
					volInput.value = (iv * 100).toFixed(2);
					updateBlackScholesUI();
				}
			} else {
				solvedIvEl.innerText = 'No Solution';
			}
		}, 50);
	}

	document.addEventListener('DOMContentLoaded', () => {
		const bsSpotEl = document.getElementById('bsSpot') as HTMLInputElement;
		const bsStrikeEl = document.getElementById('bsStrike') as HTMLInputElement;
		
		if (bsSpotEl) setupFormattingField(bsSpotEl, updateBlackScholesUI);
		if (bsStrikeEl) setupFormattingField(bsStrikeEl, updateBlackScholesUI);

		['bsDays', 'bsRate', 'bsVol', 'bsDivYield'].forEach(id => {
			const el = document.getElementById(id);
			if (el) {
				el.addEventListener('input', updateBlackScholesUI);
				el.addEventListener('change', updateBlackScholesUI);
			}
		});

		const btnSolve = document.getElementById('btnSolveIV');
		if (btnSolve) btnSolve.addEventListener('click', solveIV);

		updateBlackScholesUI();
	});
</script>
