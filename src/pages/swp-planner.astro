<script>
	import { 
		parseFormattedNumber, 
		formatShortRupee, 
		tableFormatter, 
		setupFormattingField,
		formatIndianRupeeLabel 
	} from '../utils/formatters';
	
	import html2pdf from 'html2pdf.js';
	
	import { 
		createLineChart, 
		createMicroCashflowChart 
	} from '../utils/chart-helpers';
	
	import { debounce } from '../utils/debounce';

	// Client-side JavaScript
	let worker: Worker | null = null;
	let currentChart: any = null;
	let currentMicroChart: any = null;
	let lastWorkerData: any = null;
	let lastWorkerResponse: any = null;
	let activeViewMode: 'percentiles' | 'samples' = 'percentiles';

	const corpusInput = document.getElementById('initialCorpus') as HTMLInputElement;
	const corpusDisplay = document.getElementById('corpusFormatted');
	const withdrawalInput = document.getElementById('monthlyWithdrawal') as HTMLInputElement;
	const withdrawalDisplay = document.getElementById('withdrawalFormatted');
	const runBtn = document.getElementById('runSimBtn') as HTMLButtonElement;
	const viewPercentilesBtn = document.getElementById('viewPercentilesBtn');
	const viewSamplePathsBtn = document.getElementById('viewSamplePathsBtn');

	function initTabNavigation() {
		const tabSummaryBtn = document.getElementById('tabPlanSummaryBtn');
		const tabScheduleBtn = document.getElementById('tabScheduleBtn');
		const viewSummaryEl = document.getElementById('viewPlanSummary');
		const viewScheduleEl = document.getElementById('viewSchedule');

		function switchTab(target: 'summary' | 'schedule') {
			if (target === 'summary') {
				viewSummaryEl?.classList.remove('hidden');
				viewScheduleEl?.classList.add('hidden');
				tabSummaryBtn?.classList.add('border-navy-900', 'text-navy-900', 'dark:border-white', 'dark:text-navy-100', 'font-bold');
				tabSummaryBtn?.classList.remove('border-transparent', 'text-navy-500', 'dark:text-navy-400');
				tabScheduleBtn?.classList.remove('border-navy-900', 'text-navy-900', 'dark:border-white', 'dark:text-navy-100', 'font-bold');
				tabScheduleBtn?.classList.add('border-transparent', 'text-navy-500', 'dark:text-navy-400');
			} else {
				viewScheduleEl?.classList.remove('hidden');
				viewSummaryEl?.classList.add('hidden');
				tabScheduleBtn?.classList.add('border-navy-900', 'text-navy-900', 'dark:border-white', 'dark:text-navy-100', 'font-bold');
				tabScheduleBtn?.classList.remove('border-transparent', 'text-navy-500', 'dark:text-navy-400');
				tabSummaryBtn?.classList.remove('border-navy-900', 'text-navy-900', 'dark:border-white', 'dark:text-navy-100', 'font-bold');
				tabSummaryBtn?.classList.add('border-transparent', 'text-navy-500', 'dark:text-navy-400');
			}
		}

		tabSummaryBtn?.addEventListener('click', () => switchTab('summary'));
		tabScheduleBtn?.addEventListener('click', () => switchTab('schedule'));
	}

	function initThemeMachine() {
		window.addEventListener('theme-changed', async () => {
			if (lastWorkerResponse) {
				currentChart = await createLineChart('swpChart', lastWorkerResponse, activeViewMode, currentChart);
				const inputs = getInputs();
				currentMicroChart = await createMicroCashflowChart('cashflowMicroChart', lastWorkerResponse, inputs, currentMicroChart);
			}
		});
	}

	function updateDisplayBadges() {
		if (corpusInput && corpusDisplay) {
			const val = parseFormattedNumber(corpusInput.value);
			corpusDisplay.innerText = formatIndianRupeeLabel(val);
		}
		if (withdrawalInput && withdrawalDisplay) {
			const val = parseFormattedNumber(withdrawalInput.value);
			withdrawalDisplay.innerText = `₹ ${val.toLocaleString('en-IN')} / month`;
		}
	}

	function initWorker() {
		if (window.Worker) {
			worker = new Worker(new URL('../workers/swpWorker.ts', import.meta.url), { type: 'module' });
			worker.onmessage = function (e: MessageEvent) {
				lastWorkerResponse = e.data;
				renderDashboard(lastWorkerResponse);
			};
		}
	}

	function getInputs() {
		return {
			initialCorpus: parseFormattedNumber((document.getElementById('initialCorpus') as HTMLInputElement)?.value || 10000000),
			monthlyWithdrawal: parseFormattedNumber((document.getElementById('monthlyWithdrawal') as HTMLInputElement)?.value || 50000),
			annualStepUp: parseFloat((document.getElementById('stepUp') as HTMLInputElement)?.value || '5'),
			expectedReturn: parseFloat((document.getElementById('expectedReturn') as HTMLInputElement)?.value || '12'),
			annualVolatility: parseFloat((document.getElementById('annualVolatility') as HTMLInputElement)?.value || '15'),
			expectedInflation: parseFloat((document.getElementById('expectedInflation') as HTMLInputElement)?.value || '6'),
			ltcgTax: parseFloat((document.getElementById('ltcgTax') as HTMLInputElement)?.value || '12.5'),
			horizonYears: parseInt((document.getElementById('horizonYears') as HTMLInputElement)?.value || '30', 10),
			useGuardrails: (document.getElementById('useGuardrails') as HTMLInputElement)?.checked || false,
			bsEnabled: (document.getElementById('bsHedgingToggle') as HTMLInputElement)?.checked || false,
			hedgingDragCost: parseFloat((document.getElementById('hedgingDragCost') as HTMLInputElement)?.value || '1.85'),
			hedgingFloorLimit: parseFloat((document.getElementById('hedgingFloorLimit') as HTMLInputElement)?.value || '-10'),
			numSimulations: 10000,
			initialMonthly: parseFormattedNumber((document.getElementById('monthlyWithdrawal') as HTMLInputElement)?.value || 50000)
		};
	}

	function syncUrlParams(inputs: any) {
		const params = new URLSearchParams(window.location.search);
		Object.keys(inputs).forEach(key => {
			if (key !== 'numSimulations' && key !== 'initialMonthly') {
				params.set(key, inputs[key]);
			}
		});
		window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
	}

	function parseUrlParams() {
		const params = new URLSearchParams(window.location.search);
		
		const numFields = ['initialCorpus', 'monthlyWithdrawal', 'annualStepUp', 'expectedReturn', 'annualVolatility', 'expectedInflation', 'ltcgTax', 'horizonYears', 'hedgingDragCost', 'hedgingFloorLimit'];
		const mapping: any = {
			'annualStepUp': 'stepUp'
		};

		numFields.forEach(id => {
			if (params.has(id)) {
				const targetId = mapping[id] || id;
				const el = document.getElementById(targetId) as HTMLInputElement;
				if (el) {
					if (targetId === 'initialCorpus' || targetId === 'monthlyWithdrawal') {
						el.value = Number(params.get(id)).toLocaleString('en-IN');
					} else {
						el.value = params.get(id) || el.value;
					}
				}
			}
		});
		
		['useGuardrails', 'bsEnabled'].forEach(id => {
			if (params.has(id)) {
				const targetId = id === 'bsEnabled' ? 'bsHedgingToggle' : id;
				const el = document.getElementById(targetId) as HTMLInputElement;
				if (el) el.checked = params.get(id) === 'true';
			}
		});
	}

	function checkSanity(inputs: any) {
		const warningEl = document.getElementById('inputSanityWarning');
		const messageEl = document.getElementById('inputSanityMessage');
		if (!warningEl || !messageEl) return;
		
		let initialWithdrawalRate = inputs.initialCorpus > 0 ? (inputs.initialMonthly * 12) / inputs.initialCorpus * 100 : 0;
		
		if (inputs.expectedReturn <= inputs.expectedInflation) {
			messageEl.innerHTML = `<strong>Warning:</strong> Your expected return (${inputs.expectedReturn}%) is below expected inflation (${inputs.expectedInflation}%). Your purchasing power will erode rapidly every year.`;
			warningEl.classList.remove('hidden');
			return;
		}
		
		if (initialWithdrawalRate > 6) {
			messageEl.innerHTML = `<strong>Warning:</strong> Your first-year withdrawal rate is <strong>${initialWithdrawalRate.toFixed(1)}%</strong>. This exceeds the commonly cited 4-6% safe withdrawal range and makes your portfolio highly sensitive to early market crashes.`;
			warningEl.classList.remove('hidden');
			return;
		}
		
		if (inputs.horizonYears > 40 && inputs.expectedReturn < 10) {
			messageEl.innerHTML = `<strong>Warning:</strong> A ${inputs.horizonYears}-year horizon with sub-10% returns has historically been unsustainable unless your withdrawal rate is extremely low.`;
			warningEl.classList.remove('hidden');
			return;
		}
		
		warningEl.classList.add('hidden');
	}

	function triggerSimulation() {
		if (!worker) initWorker();

		if (runBtn) {
			runBtn.disabled = true;
			runBtn.innerHTML = `
				<span class="inline-block w-4 h-4 border-2 border-white dark:border-black border-t-transparent rounded-full animate-spin"></span>
				<span class="text-sm font-semibold">Simulating...</span>
			`;
		}

		const inputs = getInputs();
		checkSanity(inputs);
		syncUrlParams(inputs);
		worker?.postMessage(inputs);
	}

	function renderScheduleTable(
		initialMonthly: number, 
		expectedInflation: number, 
		annualStepUp: number, 
		yearsCount: number,
		initialCorpus: number,
		p50Array: number[] = [],
		medianTaxesArray: number[] = [],
		medianWithdrawalsArray: number[] = []
	) {
		const tableBody = document.getElementById('scheduleTableBody');
		const badgeEl = document.getElementById('scheduleStepUpBadge');
		if (badgeEl) badgeEl.innerText = `+${expectedInflation}% Inflation & +${annualStepUp}% Step-Up`;
		if (!tableBody) return;

		let html = '';
		let currentMonthly = initialMonthly;
		const escalationFactor = (1 + expectedInflation / 100) * (1 + annualStepUp / 100);

		let hasDippedIntoPrincipal = false;
		let totalNetAnnual = 0;
		let totalTaxes = 0;

		for (let yr = 1; yr <= yearsCount; yr++) {
			const i = yr - 1;
			let rowBgClass = i % 2 === 1 ? 'bg-navy-50 dark:bg-navy-900/50' : 'bg-transparent';

			if (yr > 1) currentMonthly = currentMonthly * escalationFactor;

			const currentBal = (p50Array && p50Array[yr] !== undefined) ? p50Array[yr] : 0;
			const prevBal = (yr === 1) ? initialCorpus : ((p50Array && p50Array[yr - 1] !== undefined) ? p50Array[yr - 1] : 0);

			if (prevBal <= 0 && currentBal <= 0) {
				rowBgClass = 'bg-rose-50 dark:bg-rose-950/30';
				html += `<tr class="${rowBgClass} hover:bg-rose-100 dark:hover:bg-rose-900/50 transition-colors border-b border-rose-200 dark:border-rose-900/50"><td class="py-3 px-3 sm:px-4 text-left whitespace-nowrap text-sm font-medium text-rose-500 dark:text-rose-400">Year ${yr} ⚠️</td><td colspan="5" class="py-3 px-3 sm:px-4 text-center whitespace-nowrap text-sm font-medium text-rose-500 dark:text-rose-400">Portfolio Depleted</td></tr>`;
			} else if (prevBal > 0 && currentBal <= 0) {
				rowBgClass = 'bg-rose-50 dark:bg-rose-950/30';
				const grossExtracted = (medianWithdrawalsArray && medianWithdrawalsArray[yr] !== undefined) ? medianWithdrawalsArray[yr] : prevBal;
				const annualTax = (medianTaxesArray && medianTaxesArray[yr] !== undefined) ? medianTaxesArray[yr] : 0;
				const netExtracted = Math.max(0, grossExtracted - annualTax);
				totalNetAnnual += netExtracted;
				totalTaxes += annualTax;
				html += `<tr class="${rowBgClass} hover:bg-rose-100 dark:hover:bg-rose-900/50 transition-colors border-b border-rose-200 dark:border-rose-900/50"><td class="py-3 px-3 sm:px-4 text-left whitespace-nowrap text-sm font-semibold text-rose-700 dark:text-rose-300">Year ${yr} ⚠️</td><td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-gold-500 dark:text-gold-400">${tableFormatter.format(Math.round(currentMonthly))}</td><td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-amber-600 dark:amber-400">${tableFormatter.format(Math.round(netExtracted))}</td><td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-rose-600 dark:text-rose-400">${tableFormatter.format(Math.round(annualTax))}</td><td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-navy-400 dark:text-navy-500">-</td><td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-rose-600 dark:text-rose-400">₹0</td></tr>`;
			} else {
				let grossAnnual = currentMonthly * 12;
				if (medianWithdrawalsArray && medianWithdrawalsArray[yr] !== undefined) grossAnnual = medianWithdrawalsArray[yr];
				const annualTax = (medianTaxesArray && medianTaxesArray[yr] !== undefined) ? medianTaxesArray[yr] : 0;
				const netAnnual = Math.max(0, grossAnnual - annualTax);
				const netMonthly = grossAnnual > 0 ? netAnnual / 12 : 0;
				totalNetAnnual += netAnnual;
				totalTaxes += annualTax;
				const growth = currentBal - prevBal;
				
				let extraClasses = '';
				let yearLabel = `Year ${yr}`;
				if (currentBal < prevBal && !hasDippedIntoPrincipal) {
					hasDippedIntoPrincipal = true;
					extraClasses = 'border-l-4 border-l-amber-500 bg-amber-50/50 dark:bg-amber-900/20';
					yearLabel = `Year ${yr} <span class="ml-1 px-1.5 py-0.5 rounded text-[10px] uppercase font-bold tracking-wider bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 border border-amber-200 dark:border-amber-800">Growth &lt; Withdrawals</span>`;
				}
				
				const growthColorClass = growth >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400';
				const formattedGrowth = growth >= 0 ? `+${tableFormatter.format(Math.round(growth))}` : `-${tableFormatter.format(Math.round(Math.abs(growth)))}`;
				
				const progressPct = Math.min(100, Math.max(0, (currentBal / initialCorpus) * 100));
				const progressHtml = `<div class="w-full max-w-[120px] ml-auto bg-navy-100 dark:bg-navy-800 h-1 mt-1.5 rounded-full overflow-hidden flex justify-end"><div class="h-full bg-emerald-500 rounded-full" style="width: ${progressPct}%"></div></div>`;
				
				html += `<tr class="${rowBgClass} ${extraClasses} hover:bg-navy-100 dark:hover:bg-navy-900 transition-colors border-b border-navy-100 dark:border-white/10">
					<td class="py-3 px-3 sm:px-4 text-left whitespace-nowrap text-sm font-semibold text-navy-800 dark:text-navy-200">${yearLabel}</td>
					<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-gold-500 dark:text-gold-400">${tableFormatter.format(Math.round(netMonthly))}</td>
					<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-gold-500 dark:text-gold-400">${tableFormatter.format(Math.round(netAnnual))}</td>
					<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-rose-600 dark:text-rose-400">${tableFormatter.format(Math.round(annualTax))}</td>
					<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium ${growthColorClass}">${formattedGrowth}</td>
					<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-medium text-navy-900 dark:text-navy-100">
						${tableFormatter.format(Math.round(currentBal))}
						${progressHtml}
					</td>
				</tr>`;
			}
		}
		
		html += `<tr class="sticky bottom-0 z-10 bg-navy-100 dark:bg-navy-900 border-t-2 border-navy-300 dark:border-navy-700">
			<td class="py-3 px-3 sm:px-4 text-left whitespace-nowrap text-sm font-bold text-navy-800 dark:text-navy-200">Lifetime Totals</td>
			<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-bold text-navy-500 dark:text-navy-400">-</td>
			<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-bold text-gold-600 dark:text-gold-400">${tableFormatter.format(Math.round(totalNetAnnual))}</td>
			<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-bold text-rose-600 dark:text-rose-400">${tableFormatter.format(Math.round(totalTaxes))}</td>
			<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-bold text-navy-500 dark:text-navy-400">-</td>
			<td class="py-3 px-3 sm:px-4 text-right whitespace-nowrap text-sm font-bold text-navy-500 dark:text-navy-400">-</td>
		</tr>`;

		tableBody.innerHTML = html;
	}

	async function renderDashboard(originalData: any, skipChartUpdate = false) {
		lastWorkerData = originalData;
		const inputs = getInputs();
		const { initialMonthly, expectedInflation, annualStepUp, horizonYears, initialCorpus, ltcgTax } = inputs;
		const isDeflated = (document.getElementById('inflationDeflatorToggle') as HTMLInputElement)?.checked || false;

		const data = {
			...originalData,
			p10: [...(originalData.p10 || [])],
			p50: [...(originalData.p50 || [])],
			p90: [...(originalData.p90 || [])],
			medianTaxes: [...(originalData.medianTaxes || [])],
			medianWithdrawals: [...(originalData.medianWithdrawals || [])],
			actualPaycheckTimeline: originalData.actualPaycheckTimeline ? [...originalData.actualPaycheckTimeline] : undefined,
			idealPaycheckTimeline: originalData.idealPaycheckTimeline ? [...originalData.idealPaycheckTimeline] : undefined,
			samplePaths: originalData.samplePaths ? originalData.samplePaths.map((arr: number[]) => [...arr]) : [],
			diagnostics: originalData.diagnostics ? { ...originalData.diagnostics } : undefined
		};

		if (isDeflated) {
			const infRate = expectedInflation / 100;
			for (let yr = 1; yr <= horizonYears; yr++) {
				const deflator = Math.pow(1 + infRate, yr - 1);
				if (data.p10[yr] !== undefined) data.p10[yr] /= deflator;
				if (data.p50[yr] !== undefined) data.p50[yr] /= deflator;
				if (data.p90[yr] !== undefined) data.p90[yr] /= deflator;
				if (data.medianTaxes[yr] !== undefined) data.medianTaxes[yr] /= deflator;
				if (data.medianWithdrawals[yr] !== undefined) data.medianWithdrawals[yr] /= deflator;
				if (data.actualPaycheckTimeline && data.actualPaycheckTimeline[yr] !== undefined) data.actualPaycheckTimeline[yr] /= deflator;
				if (data.idealPaycheckTimeline && data.idealPaycheckTimeline[yr] !== undefined) data.idealPaycheckTimeline[yr] /= deflator;
				data.samplePaths.forEach((path: number[]) => {
					if (path[yr] !== undefined) path[yr] /= deflator;
				});
			}

			const finalDeflator = Math.pow(1 + infRate, horizonYears);
			if (data.diagnostics) {
				data.diagnostics.meanFinalBalance /= finalDeflator;
				data.diagnostics.stdDevFinalBalance /= finalDeflator;
			}
			data.medianFinalBalance /= finalDeflator;
			const midDeflator = Math.pow(1 + infRate, horizonYears / 2);
			data.lowestMonthlyPaycheck /= midDeflator;
			data.lifestyleSacrificeAmount /= midDeflator;
		}

		if (runBtn) {
			runBtn.innerHTML = '<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg><span class="text-sm font-semibold">Re-run Simulation</span>';
			runBtn.disabled = false;
		}
		const annualWithdrawal = initialMonthly * 12;

		let deathYear = (data.p50 || []).findIndex((balance: number, idx: number) => idx > 0 && balance <= 0);
		let balanceRemaining = 0;
		let durationString = `${horizonYears} Years`;
		let actualDuration = horizonYears;
		let survivedMonths = 0;

		if (deathYear === -1) {
			actualDuration = horizonYears;
			balanceRemaining = (data.p50 && data.p50[horizonYears] !== undefined) ? data.p50[horizonYears] : 0;
		} else {
			actualDuration = deathYear;
			const completedYears = deathYear - 1;
			const startingBalance = (data.p50 && data.p50[completedYears] !== undefined) ? data.p50[completedYears] : 0;
			const escalationFactor = (1 + expectedInflation / 100) * (1 + annualStepUp / 100);
			const deathYearGrossMonthly = initialMonthly * Math.pow(escalationFactor, completedYears);
			const deathYearGrossAnnual = deathYearGrossMonthly * 12;
			const deathYearTax = (data.medianTaxes && data.medianTaxes[deathYear] !== undefined) ? data.medianTaxes[deathYear] : 0;
			const deathYearNetAnnual = Math.max(0, deathYearGrossAnnual - deathYearTax);
			const deathYearNetMonthly = deathYearNetAnnual > 0 ? deathYearNetAnnual / 12 : deathYearGrossMonthly;

			survivedMonths = deathYearNetMonthly > 0 ? Math.floor(startingBalance / deathYearNetMonthly) : 0;
			survivedMonths = Math.min(11, Math.max(0, survivedMonths));
			durationString = survivedMonths > 0 ? `${completedYears} Yrs, ${survivedMonths} Mos` : `${completedYears} Years`;
		}

		const enduranceHeroEl = document.getElementById('portfolioEnduranceHero');
		const healthBadgeEl = document.getElementById('portfolioHealthBadge');
		const guardrailsActiveBadgeEl = document.getElementById('guardrailsActiveBadge');
		
		if (guardrailsActiveBadgeEl) {
			if (data.useGuardrails) guardrailsActiveBadgeEl.classList.remove('hidden');
			else guardrailsActiveBadgeEl.classList.add('hidden');
		}

		if (enduranceHeroEl && healthBadgeEl) {
			const successRate = data.probabilityOfSuccess || 0;
			enduranceHeroEl.innerText = `${successRate}%`;
			
			const realityCheckEl = document.getElementById('portfolioRealityCheck');
			if (realityCheckEl) {
				realityCheckEl.innerHTML = `In <strong>${Math.round((successRate / 100) * 10000)}</strong> out of 10,000 scenarios, your money lasted all ${horizonYears} years.`;
			}

			if (successRate >= 90) {
				enduranceHeroEl.className = "text-3xl sm:text-4xl font-extrabold stat-value tracking-tight font-sans text-emerald-600 dark:text-emerald-400";
				healthBadgeEl.innerText = "HIGHLY SECURE";
				healthBadgeEl.className = "px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md badge-safe";
			} else if (successRate >= 70) {
				enduranceHeroEl.className = "text-3xl sm:text-4xl font-extrabold stat-value tracking-tight font-sans text-amber-600 dark:text-amber-400";
				healthBadgeEl.innerText = "MODERATE RISK";
				healthBadgeEl.className = "px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md bg-amber-100 text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 border border-amber-200 dark:border-amber-800";
			} else {
				enduranceHeroEl.className = "text-3xl sm:text-4xl font-extrabold stat-value tracking-tight font-sans text-rose-600 dark:text-rose-400";
				healthBadgeEl.innerText = "HIGH RISK OF DEPLETION";
				healthBadgeEl.className = "px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md bg-rose-100 text-rose-800 dark:bg-rose-950/80 dark:text-rose-300 border border-rose-200 dark:border-rose-800";
			}
		}

		const sacrificeBox = document.getElementById('lifestyleSacrificeAlertBox');
		const valSacrificeTotal = document.getElementById('valSacrificeTotalCash');
		const valSacrificeRockBottom = document.getElementById('valSacrificeRockBottom');
		
		if (sacrificeBox) {
			if (data.useGuardrails && data.lifestyleSacrificeAmount > 0) {
				sacrificeBox.classList.remove('hidden');
				if (valSacrificeTotal) valSacrificeTotal.innerText = formatShortRupee(data.lifestyleSacrificeAmount);
				if (valSacrificeRockBottom) valSacrificeRockBottom.innerText = formatShortRupee(data.rockBottomRealValue);
			} else {
				sacrificeBox.classList.add('hidden');
			}
		}

		const guardrailsRow = document.getElementById('guardrailsLowestPaycheckRow');
		const valLowest = document.getElementById('valLowestPaycheck');
		const valRock = document.getElementById('valRockBottom');
		const valSac = document.getElementById('valSacrifice');

		if (guardrailsRow) {
			if (data.useGuardrails && data.lifestyleSacrificeAmount > 0) {
				guardrailsRow.classList.remove('hidden');
				guardrailsRow.classList.add('flex'); // Because the element has flex col/row classes, restoring flex display
				if (valLowest) valLowest.innerText = formatShortRupee(data.lowestMonthlyPaycheck);
				if (valRock) valRock.innerText = formatShortRupee(data.rockBottomRealValue);
				if (valSac) valSac.innerText = formatShortRupee(data.lifestyleSacrificeAmount);
			} else {
				guardrailsRow.classList.add('hidden');
				guardrailsRow.classList.remove('flex');
			}
		}

		const weatherContainerEl = document.getElementById('weatherForecastContainer');
		const weatherGridEl = document.getElementById('weatherGrid');
		if (weatherContainerEl && weatherGridEl) {
			if (data.useGuardrails && data.actualPaycheckTimeline && data.idealPaycheckTimeline) {
				let gridHtml = '';
				for (let yr = 1; yr <= horizonYears; yr++) {
					const actual = data.actualPaycheckTimeline[yr] || 0;
					const ideal = data.idealPaycheckTimeline[yr] || 0;
					if (actual < (ideal - 10)) {
						gridHtml += `<div class="w-full aspect-square bg-amber-500/90 rounded-sm border border-amber-600/50" title="Year ${yr}: Pay Cut Triggered"></div>`;
					} else {
						gridHtml += `<div class="w-full aspect-square bg-emerald-500/80 rounded-sm border border-emerald-600/30" title="Year ${yr}: Full Paycheck"></div>`;
					}
				}
				weatherGridEl.innerHTML = gridHtml;
				weatherContainerEl.classList.remove('hidden');
			} else {
				weatherContainerEl.classList.add('hidden');
			}
		}

		let totalGrossPayout = 0;
		let totalTaxesPaid = 0;
		let totalNetPayout = 0;
		let currentMonthly = initialMonthly;
		const escalationFactor = (1 + expectedInflation / 100) * (1 + annualStepUp / 100);

		for (let yr = 1; yr <= horizonYears; yr++) {
			if (yr > 1) currentMonthly = currentMonthly * escalationFactor;
			let grossAnnual = currentMonthly * 12;
			if (data.medianWithdrawals && data.medianWithdrawals[yr] !== undefined) grossAnnual = data.medianWithdrawals[yr];
			const annualTax = (data.medianTaxes && data.medianTaxes[yr] !== undefined) ? data.medianTaxes[yr] : 0;
			const netAnnual = Math.max(0, grossAnnual - annualTax);
			totalGrossPayout += grossAnnual;
			totalTaxesPaid += annualTax;
			totalNetPayout += netAnnual;
		}

		const wowInitialCorpusEl = document.getElementById('wowInitialCorpus');
		if (wowInitialCorpusEl) wowInitialCorpusEl.innerText = formatShortRupee(initialCorpus);
		const wowNetPayoutEl = document.getElementById('wowNetPayout');
		if (wowNetPayoutEl) wowNetPayoutEl.innerText = formatShortRupee(totalNetPayout);
		const multiplierBadgeEl = document.getElementById('wowMultiplierBadge');
		if (multiplierBadgeEl) {
			const mult = initialCorpus > 0 ? (totalNetPayout / initialCorpus).toFixed(1) : '0';
			multiplierBadgeEl.innerText = `${mult}x Lifetime Payout`;
		}

		const t2DurationEl = document.getElementById('tier2Duration');
		if (t2DurationEl) t2DurationEl.innerText = durationString;
		const t2GrossEl = document.getElementById('tier2Gross');
		if (t2GrossEl) t2GrossEl.innerText = formatShortRupee(totalGrossPayout);
		const t2TaxesEl = document.getElementById('tier2Taxes');
		if (t2TaxesEl) t2TaxesEl.innerText = formatShortRupee(totalTaxesPaid);
		const t2NetEl = document.getElementById('tier2Net');
		if (t2NetEl) t2NetEl.innerText = formatShortRupee(totalNetPayout);
		const t2BalRemEl = document.getElementById('tier2BalanceRemaining');
		if (t2BalRemEl) t2BalRemEl.innerText = formatShortRupee(balanceRemaining);

		let iwr = (annualWithdrawal / initialCorpus) * 100;
		let netRequired = iwr + expectedInflation;
		let marketVolatility = inputs.annualVolatility;
		
		const volInputEl = document.getElementById('sensVolatilityInput');
		if (volInputEl) volInputEl.innerText = marketVolatility + '%';
		const iwrEl = document.getElementById('sensIWR');
		if (iwrEl) iwrEl.innerText = iwr.toFixed(1) + '%';

		const sensTbody = document.getElementById('sensitivityTableBody');
		if (sensTbody) {
			let tbodyHtml = '';
			[5, 10, 15, 20].forEach(vol => {
				let volDrag = Math.pow(vol, 2) / 200;
				let reqCAGR = (netRequired / (1 - (ltcgTax / 100))) + volDrag;
				let isCurrent = vol === marketVolatility;
				let highlight = isCurrent ? 'bg-gold-50 dark:bg-gold-900/20 font-bold' : '';
				let label = vol <= 5 ? 'Bonds/Index' : vol === 10 ? 'Balanced' : vol === 15 ? 'NIFTY 50' : 'Small Cap';
				
				tbodyHtml += `<tr class="${highlight}">
					<td class="px-4 py-2.5 ${isCurrent ? 'text-gold-600 dark:text-gold-400' : 'text-navy-700 dark:text-navy-300'}">${vol}% <span class="font-sans text-[10px] text-navy-400 ml-1">(${label})</span></td>
					<td class="px-4 py-2.5 text-right ${isCurrent ? 'text-gold-600 dark:text-gold-400' : 'text-navy-900 dark:text-navy-100'}">${reqCAGR.toFixed(2)}%</td>
				</tr>`;
			});
			sensTbody.innerHTML = tbodyHtml;
		}
		
		const diagnostics = data.diagnostics;
		if (diagnostics) {
			const diagMeanEl = document.getElementById('diagMean');
			const diagMedianEl = document.getElementById('diagMedian');
			const diagStdDevEl = document.getElementById('diagStdDev');
			const diagSkewEl = document.getElementById('diagSkew');
			
			if (diagMeanEl) diagMeanEl.innerText = formatShortRupee(diagnostics.meanFinalBalance);
			if (diagMedianEl) diagMedianEl.innerText = formatShortRupee(data.medianFinalBalance);
			if (diagStdDevEl) diagStdDevEl.innerText = formatShortRupee(diagnostics.stdDevFinalBalance);
			if (diagSkewEl) diagSkewEl.innerText = diagnostics.skewnessFinalBalance.toFixed(2);
		}

		renderScheduleTable(initialMonthly, expectedInflation, annualStepUp, horizonYears, initialCorpus, data.p50, data.medianTaxes, data.medianWithdrawals);
		renderHedgingDashboard(data, inputs);
		currentChart = await createLineChart('swpChart', data, activeViewMode, currentChart);
		currentMicroChart = await createMicroCashflowChart('cashflowMicroChart', data, inputs, currentMicroChart);
	}

	function renderHedgingDashboard(data: any, inputs: any) {
		const bsEnabled = data.bsEnabled;
		const dragCostPercent = data.dragCostPercent || 0;
		
		const statusBadgeEl = document.getElementById('bsStatusBadge');
		const dragEl = document.getElementById('valHedgingDrag');
		const floorEl = document.getElementById('valProtectedFloor');
		const yieldEl = document.getElementById('valAdjustedYield');

		if (statusBadgeEl) {
			if (bsEnabled) {
				statusBadgeEl.innerText = "ACTIVE PUT HEDGING ON";
				statusBadgeEl.className = "px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800";
			} else {
				statusBadgeEl.innerText = "UNHEDGED PORTFOLIO";
				statusBadgeEl.className = "badge-warning text-xs";
			}
		}

		if (dragEl) dragEl.innerText = bsEnabled ? `${(dragCostPercent * 100).toFixed(2)}% / Year` : "0.00% / Year";
		if (floorEl) floorEl.innerText = bsEnabled ? `${(data.floorLimit * 100).toFixed(0)}% Drop` : "Unprotected";

		// Ledger Table
		const tbody = document.getElementById('hedgingLedgerBody');
		if (tbody) {
			let html = '';
			const p50 = data.p50 || [];
			const withdrawals = data.medianWithdrawals || [];
			for (let yr = 1; yr <= inputs.horizonYears; yr++) {
				const unhedgedReal = p50[yr] || 0;
				const annualWithdrawal = withdrawals[yr] || 0;
				const optionDragRupees = bsEnabled ? (unhedgedReal * dragCostPercent) : 0;
				// In SWP, floor benefit is approx how much the floor saved on crashes, but for the median path, it's rarely hit. 
				// The real value of options in SWP is preventing the 10th percentile path from failing.
				// For the ledger, we show the drag on the expected path.
				const netHedgedReal = bsEnabled ? Math.max(0, unhedgedReal - optionDragRupees) : unhedgedReal;
				const zebraClass = yr % 2 === 0 ? 'bg-navy-50/70 dark:bg-navy-900/90' : 'bg-white dark:bg-navy-950';

				html += `
					<tr class="${zebraClass} hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors border-b border-navy-200/60 dark:border-white/10">
						<td class="py-2.5 px-3 text-left font-bold text-navy-800 dark:text-navy-200">Yr ${yr}</td>
						<td class="py-2.5 px-3 text-right text-navy-600 dark:text-navy-400">${tableFormatter.format(annualWithdrawal)}</td>
						<td class="py-2.5 px-3 text-right font-medium text-navy-800 dark:text-navy-200">${tableFormatter.format(unhedgedReal)}</td>
						<td class="py-2.5 px-3 text-right ${bsEnabled ? 'text-rose-600 dark:text-rose-400 font-semibold' : 'text-navy-400 dark:text-navy-600'}">
							${bsEnabled ? `-${tableFormatter.format(optionDragRupees)}` : '₹ 0'}
						</td>
						<td class="py-2.5 px-3 text-right text-navy-400 dark:text-navy-500">
							${bsEnabled ? 'Floor Active' : 'None'}
						</td>
						<td class="py-2.5 px-3 text-right font-bold text-emerald-600 dark:text-emerald-400">${tableFormatter.format(netHedgedReal)}</td>
					</tr>
				`;
			}
			tbody.innerHTML = html;
		}

		if (yieldEl) {
			const finalBal = (data.p50 && data.p50.length > 0) ? data.p50[data.p50.length - 1] : 0;
			if (bsEnabled) {
				const finalHedged = Math.max(0, finalBal * Math.pow(1 - dragCostPercent, inputs.horizonYears));
				yieldEl.innerText = tableFormatter.format(finalHedged);
			} else {
				yieldEl.innerText = tableFormatter.format(finalBal);
			}
		}
	}

	viewPercentilesBtn?.addEventListener('click', async () => {
		activeViewMode = 'percentiles';
		viewPercentilesBtn.className = 'min-h-[36px] px-3 py-1 rounded-md bg-white dark:bg-navy-950 text-navy-900 dark:text-navy-100 font-semibold shadow-xs transition-colors flex items-center';
		viewSamplePathsBtn!.className = 'min-h-[36px] px-3 py-1 rounded-md text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-200 transition-colors flex items-center';
		if (lastWorkerResponse) {
			chartInstance = await createLineChart('swpChart', lastWorkerResponse, activeViewMode, chartInstance);
		}
	});

	viewSamplePathsBtn?.addEventListener('click', async () => {
		activeViewMode = 'samples';
		viewSamplePathsBtn.className = 'min-h-[36px] px-3 py-1 rounded-md bg-white dark:bg-navy-950 text-navy-900 dark:text-navy-100 font-semibold shadow-xs transition-colors flex items-center';
		viewPercentilesBtn!.className = 'min-h-[36px] px-3 py-1 rounded-md text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-200 transition-colors flex items-center';
		if (lastWorkerResponse) {
			chartInstance = await createLineChart('swpChart', lastWorkerResponse, activeViewMode, chartInstance);
		}
	});

	setupFormattingField(corpusInput, updateDisplayBadges);
	setupFormattingField(withdrawalInput, updateDisplayBadges);
	runBtn?.addEventListener('click', triggerSimulation);
	
	const debouncedSimulate = debounce(() => {
		triggerSimulation();
	}, 600);

	const swpForm = document.getElementById('swpForm');
	swpForm?.addEventListener('input', () => {
		debouncedSimulate();
	});
	
	const toggleDiagnosticsBtn = document.getElementById('toggleDiagnosticsBtn');
	toggleDiagnosticsBtn?.addEventListener('click', () => {
		const panel = document.getElementById('diagnosticsPanel');
		if (panel) {
			panel.classList.toggle('hidden');
		}
	});

	const inflationDeflatorToggle = document.getElementById('inflationDeflatorToggle');
	inflationDeflatorToggle?.addEventListener('change', () => {
		if (lastWorkerData) {
			renderDashboard(lastWorkerData, false);
		}
	});

	const toggleTaxFormulaBtn = document.getElementById('toggleTaxFormulaBtn');
	toggleTaxFormulaBtn?.addEventListener('click', () => {
		const panel = document.getElementById('taxFormulaPanel');
		if (panel) {
			panel.classList.toggle('hidden');
		}
	});

	function startApp() {
		parseUrlParams();
		initTabNavigation();
		initThemeMachine();
		updateDisplayBadges();
		initWorker();
		triggerSimulation();

		document.getElementById('downloadPdfBtn')?.addEventListener('click', () => {
			const element = document.querySelector('main');
			if (!element) return;
			
			const opt = {
				margin:       10,
				filename:     'swp_planner_report.pdf',
				image:        { type: 'jpeg', quality: 0.98 },
				html2canvas:  { scale: 2, useCORS: true },
				jsPDF:        { unit: 'mm', format: 'a3', orientation: 'portrait' }
			};
			
			const btn = document.getElementById('downloadPdfBtn');
			if(btn) btn.innerText = "Generating PDF...";
			
			html2pdf().set(opt).from(element).save().then(() => {
				if(btn) btn.innerText = "↓ Download PDF Report";
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', startApp);
	} else {
		startApp();
	}
</script>
