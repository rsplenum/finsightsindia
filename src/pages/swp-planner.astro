---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SwpIntro from '../components/Calculators/SwpIntro.astro';
import RetirementAnswer from '../components/Calculators/RetirementAnswer.astro';
import SwpInputForm from '../components/Calculators/SwpInputForm.astro';
import SwpWorking from '../components/Calculators/SwpWorking.astro';
---

<Layout title="Retirement Withdrawal Planner — SWP Intelligence Engine">
  <Hero
    badge="Retirement Cashflow Planner"
    title="How long will your savings last?"
    description="Stress-test your retirement against 10,000 market futures. Model real inflation-adjusted purchasing power, LTCG taxes, and downside protection."
  />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 pb-16 sm:pt-4 sm:pb-24 space-y-8">
    
    <!-- State 1: The Welcome (dd-024) -->
    <SwpIntro />

    <!-- State 2: Answer & Workbench (revealed on first interaction) -->
    <div id="swpWorkbenchContainer" class="hidden space-y-8">
      
      <!-- Top Answer / Verdict Layer (single compute host) -->
      <RetirementAnswer />

      <!-- Interactive Workbench Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Left Column: Input Form -->
        <aside class="lg:col-span-4 lg:sticky lg:top-6 space-y-6">
          <SwpInputForm />
        </aside>

        <!-- Right Column: Working & Diagnostics -->
        <section class="lg:col-span-8 space-y-6" aria-label="Simulation results and projections">
          <SwpWorking />
        </section>

      </div>

    </div>

  </main>
</Layout>

<script>
  import { 
    parseFormattedNumber, 
    formatShortRupee, 
    tableFormatter, 
    setupFormattingField,
    formatIndianRupeeLabel 
  } from '../utils/formatters';

  import {
    readPlannerInputs,
    syncEntryFromAdvanced,
    requestRecompute,
  } from '../utils/plannerInputs';

  import {
    createLineChart, 
    createMicroCashflowChart 
  } from '../utils/chart-helpers';
  
  import { debounce } from '../utils/debounce';

  let subscribed = false;
  let lastOutlook: any = null;
  let lastWorkerData: any = null;
  let currentChart: any = null;
  let currentMicroChart: any = null;
  let activeViewMode: 'percentiles' | 'samples' = 'percentiles';
  let isWorkbenchRevealed = false;

  const getInputs = readPlannerInputs;

  /**
   * Transitions from the Welcome intro to the interactive workbench (dd-024).
   */
  function revealWorkbench() {
    if (isWorkbenchRevealed) return;
    isWorkbenchRevealed = true;

    const introEl = document.getElementById('swpIntro');
    const containerEl = document.getElementById('swpWorkbenchContainer');

    if (introEl) {
      introEl.style.opacity = '0';
      setTimeout(() => {
        introEl.classList.add('hidden');
      }, 250);
    }

    if (containerEl) {
      containerEl.classList.remove('hidden');
      containerEl.style.opacity = '0';
      setTimeout(() => {
        containerEl.style.transition = 'opacity 300ms ease-in';
        containerEl.style.opacity = '1';
      }, 50);
    }
  }

  function initWelcomeState() {
    const introCorpus = document.getElementById('introCorpus') as HTMLInputElement | null;
    const introStartBtn = document.getElementById('introStartBtn');
    const milestoneBtns = document.querySelectorAll('.intro-milestone-btn');

    function handleStart(val?: string) {
      const canonicalCorpus = document.getElementById('initialCorpus') as HTMLInputElement | null;
      const ansCorpus = document.getElementById('ansCorpus') as HTMLInputElement | null;
      if (canonicalCorpus) {
        if (val) {
          canonicalCorpus.value = Number(val).toLocaleString('en-IN');
        } else if (introCorpus && introCorpus.value) {
          const cleanVal = parseFormattedNumber(introCorpus.value);
          if (cleanVal > 0) canonicalCorpus.value = cleanVal.toLocaleString('en-IN');
        }
      }
      if (ansCorpus && canonicalCorpus) {
        ansCorpus.value = canonicalCorpus.value;
      }
      updateDisplayBadges();
      revealWorkbench();
      requestRecompute();
    }

    if (introCorpus) {
      setupFormattingField(introCorpus, () => {});
      introCorpus.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') handleStart();
      });
    }

    milestoneBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-value');
        if (val) handleStart(val);
      });
    });

    introStartBtn?.addEventListener('click', () => handleStart());
  }

  function initTabNavigation() {
    const tabSummaryBtn = document.getElementById('tabPlanSummaryBtn');
    const tabScheduleBtn = document.getElementById('tabScheduleBtn');
    const tabHedgingBtn = document.getElementById('tabHedgingBtn');

    const viewSummaryEl = document.getElementById('viewPlanSummary');
    const viewScheduleEl = document.getElementById('viewSchedule');
    const viewHedgingEl = document.getElementById('viewHedging');

    function switchTab(target: 'summary' | 'schedule' | 'hedging') {
      const activeClass = ['border-navy-900', 'bg-navy-900', 'text-white', 'dark:border-white', 'dark:bg-white', 'dark:text-navy-950', 'font-bold'];
      const inactiveClass = ['border-transparent', 'text-navy-600', 'dark:text-navy-400'];

      viewSummaryEl?.classList.toggle('hidden', target !== 'summary');
      viewScheduleEl?.classList.toggle('hidden', target !== 'schedule');
      viewHedgingEl?.classList.toggle('hidden', target !== 'hedging');

      [
        { btn: tabSummaryBtn, active: target === 'summary' },
        { btn: tabScheduleBtn, active: target === 'schedule' },
        { btn: tabHedgingBtn, active: target === 'hedging' },
      ].forEach(({ btn, active }) => {
        if (!btn) return;
        if (active) {
          btn.classList.add(...activeClass);
          btn.classList.remove(...inactiveClass);
        } else {
          btn.classList.remove(...activeClass);
          btn.classList.add(...inactiveClass);
        }
      });
    }

    tabSummaryBtn?.addEventListener('click', () => switchTab('summary'));
    tabScheduleBtn?.addEventListener('click', () => switchTab('schedule'));
    tabHedgingBtn?.addEventListener('click', () => switchTab('hedging'));
  }

  function updateDisplayBadges() {
    const inputs = getInputs();
    const corpusFormatted = document.getElementById('corpusFormatted');
    const withdrawalFormatted = document.getElementById('withdrawalFormatted');

    if (corpusFormatted) {
      corpusFormatted.textContent = formatIndianRupeeLabel(inputs.initialCorpus);
    }
    if (withdrawalFormatted) {
      withdrawalFormatted.textContent = `₹ ${inputs.monthlyWithdrawal.toLocaleString('en-IN')} / month`;
    }
  }

  function checkSanity(inputs: any) {
    const warningEl = document.getElementById('inputSanityWarning');
    const messageEl = document.getElementById('inputSanityMessage');
    if (!warningEl || !messageEl) return;

    const annualWithdrawal = inputs.monthlyWithdrawal * 12;
    const initialRate = inputs.initialCorpus > 0 ? (annualWithdrawal / inputs.initialCorpus) * 100 : 0;

    let warningText = '';
    if (initialRate > 8.0) {
      warningText = `Your initial withdrawal rate is ${initialRate.toFixed(1)}% / year. Across Indian financial history, withdrawal rates above 6.0% have a very high risk of early portfolio depletion.`;
    } else if (inputs.expectedInflation < 3.0) {
      warningText = `Expected inflation is set to ${inputs.expectedInflation}%. Historically, Indian CPI inflation averages 5%–7%.`;
    }

    if (warningText) {
      messageEl.textContent = warningText;
      warningEl.classList.remove('hidden');
    } else {
      warningEl.classList.add('hidden');
    }
  }

  function renderHedgingDashboard(data: any, inputs: any) {
    const bsToggle = document.getElementById('bsHedgingToggle') as HTMLInputElement | null;
    const bsEnabled = bsToggle?.checked || false;
    const statusBadge = document.getElementById('bsStatusBadge');
    const valDrag = document.getElementById('valHedgingDrag');
    const valFloor = document.getElementById('valProtectedFloor');
    const valYield = document.getElementById('valAdjustedYield');
    const tbody = document.getElementById('hedgingLedgerBody');
    const caption = document.getElementById('swpLedgerCaption');

    if (caption) {
      caption.textContent = bsEnabled
        ? `Option drag costs ~${inputs.hedgingDragCost}% / year, establishing a hard -${Math.round(inputs.hedgingFloorLimit * 100)}% floor on annual equity losses.`
        : 'Portfolio is unhedged. Annual returns bear the full volatility of market drawdowns.';
    }

    if (statusBadge) {
      if (bsEnabled) {
        statusBadge.className = 'badge-safe text-xs self-start sm:self-auto';
        statusBadge.textContent = 'FLOOR HEDGED';
      } else {
        statusBadge.className = 'badge-warning text-xs self-start sm:self-auto';
        statusBadge.textContent = 'UNHEDGED';
      }
    }

    const dragCostPercent = inputs.hedgingDragCost / 100;
    if (valDrag) valDrag.innerText = bsEnabled ? `${inputs.hedgingDragCost.toFixed(2)}% / Year` : '0.00% / Year';
    if (valFloor) valFloor.innerText = bsEnabled ? `-${Math.round(inputs.hedgingFloorLimit * 100)}% Max Drop` : 'Unprotected';

    const fees = data.optionFees || [];
    const absorbed = data.drawdownsAbsorbed || [];

    if (tbody) {
      let html = '';
      const p50 = data.p50 || [];
      const withdrawals = data.medianWithdrawals || [];
      for (let yr = 1; yr <= inputs.horizonYears; yr++) {
        const zebraClass = yr % 2 === 0 ? 'bg-navy-50/70 dark:bg-navy-900/90' : 'bg-white dark:bg-navy-950';
        const num = 'py-2 px-3 text-right whitespace-nowrap';
        html += `
          <tr class="${zebraClass} hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors border-b border-navy-200/60 dark:border-white/10">
            <td class="py-2 px-3 text-left font-bold whitespace-nowrap text-navy-800 dark:text-navy-200">Yr ${yr}</td>
            <td class="${num} text-navy-600 dark:text-navy-400">${tableFormatter.format(withdrawals[yr] || 0)}</td>
            <td class="${num} font-medium text-navy-800 dark:text-navy-200">${tableFormatter.format(p50[yr] || 0)}</td>
            <td class="${num} text-rose-700 dark:text-rose-400">${bsEnabled ? '−' + tableFormatter.format(fees[yr] || 0) : '—'}</td>
            <td class="${num} ${(absorbed[yr] || 0) > 0 ? 'text-emerald-700 dark:text-emerald-400' : 'text-navy-500 dark:text-navy-400'}">${bsEnabled ? '+' + tableFormatter.format(absorbed[yr] || 0) : '—'}</td>
          </tr>
        `;
      }
      tbody.innerHTML = html;
    }

    if (valYield) {
      const finalBal = (data.p50 && data.p50.length > 0) ? data.p50[data.p50.length - 1] : 0;
      if (bsEnabled) {
        const finalHedged = Math.max(0, finalBal * Math.pow(1 - dragCostPercent, inputs.horizonYears));
        valYield.innerText = tableFormatter.format(finalHedged);
      } else {
        valYield.innerText = tableFormatter.format(finalBal);
      }
    }
  }

  async function renderDashboard(originalData: any) {
    lastWorkerData = originalData;
    const inputs = getInputs();
    const { monthlyWithdrawal: initialMonthly, expectedInflation, annualStepUp, horizonYears, initialCorpus, ltcgTax } = inputs;
    checkSanity(inputs);

    const isDeflated = (document.getElementById('inflationDeflatorToggle') as HTMLInputElement)?.checked || false;

    const frameEl = document.getElementById('scheduleMoneyFrame');
    if (frameEl) {
      frameEl.textContent = isDeflated
        ? 'Every figure below is at today’s prices — what the money would buy if you spent it now.'
        : 'Every figure below is in the rupees of its own year, not today’s. They grow because prices do; switch the toggle to see what they actually buy.';
    }

    const data = {
      ...originalData,
      p10: [...(originalData.p10 || [])],
      p50: [...(originalData.p50 || [])],
      p90: [...(originalData.p90 || [])],
      medianTaxes: [...(originalData.medianTaxes || [])],
      medianWithdrawals: [...(originalData.medianWithdrawals || [])],
      actualPaycheckTimeline: originalData.actualPaycheckTimeline ? [...originalData.actualPaycheckTimeline] : undefined,
      idealPaycheckTimeline: originalData.idealPaycheckTimeline ? [...originalData.idealPaycheckTimeline] : undefined,
      samplePaths: originalData.samplePaths ? originalData.samplePaths.map((arr: number[]) => [...arr]) : [],
      diagnostics: originalData.diagnostics ? { ...originalData.diagnostics } : undefined
    };

    if (isDeflated) {
      const infRate = expectedInflation / 100;
      for (let yr = 1; yr <= horizonYears; yr++) {
        const deflator = Math.pow(1 + infRate, yr - 1);
        if (data.p10[yr] !== undefined) data.p10[yr] /= deflator;
        if (data.p50[yr] !== undefined) data.p50[yr] /= deflator;
        if (data.p90[yr] !== undefined) data.p90[yr] /= deflator;
        if (data.medianTaxes[yr] !== undefined) data.medianTaxes[yr] /= deflator;
        if (data.medianWithdrawals[yr] !== undefined) data.medianWithdrawals[yr] /= deflator;
        if (data.actualPaycheckTimeline && data.actualPaycheckTimeline[yr] !== undefined) data.actualPaycheckTimeline[yr] /= deflator;
        if (data.idealPaycheckTimeline && data.idealPaycheckTimeline[yr] !== undefined) data.idealPaycheckTimeline[yr] /= deflator;
        data.samplePaths.forEach((path: number[]) => {
          if (path[yr] !== undefined) path[yr] /= deflator;
        });
      }

      const finalDeflator = Math.pow(1 + infRate, horizonYears);
      if (data.diagnostics) {
        data.diagnostics.meanFinalBalance /= finalDeflator;
        data.diagnostics.stdDevFinalBalance /= finalDeflator;
      }
      data.medianFinalBalance /= finalDeflator;
    }

    const runBtn = document.getElementById('runSimBtn') as HTMLButtonElement | null;
    if (runBtn) {
      runBtn.innerHTML = '<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg><span class="text-sm font-semibold">Re-run Simulation</span>';
      runBtn.disabled = false;
    }

    const annualWithdrawal = initialMonthly * 12;
    let deathYear = (data.p50 || []).findIndex((balance: number, idx: number) => idx > 0 && balance <= 0);
    let balanceRemaining = 0;
    let durationString = `${horizonYears} Years`;

    if (deathYear === -1) {
      balanceRemaining = (data.p50 && data.p50[horizonYears] !== undefined) ? data.p50[horizonYears] : 0;
    } else {
      const completedYears = deathYear - 1;
      const startingBalance = (data.p50 && data.p50[completedYears] !== undefined) ? data.p50[completedYears] : 0;
      const escalationFactor = (1 + expectedInflation / 100) * (1 + annualStepUp / 100);
      const deathYearGrossMonthly = initialMonthly * Math.pow(escalationFactor, completedYears);
      const deathYearGrossAnnual = deathYearGrossMonthly * 12;
      const deathYearTax = (data.medianTaxes && data.medianTaxes[deathYear] !== undefined) ? data.medianTaxes[deathYear] : 0;
      const deathYearNetAnnual = Math.max(0, deathYearGrossAnnual - deathYearTax);
      const deathYearNetMonthly = deathYearNetAnnual > 0 ? deathYearNetAnnual / 12 : deathYearGrossMonthly;

      let survivedMonths = deathYearNetMonthly > 0 ? Math.floor(startingBalance / deathYearNetMonthly) : 0;
      survivedMonths = Math.min(11, Math.max(0, survivedMonths));
      durationString = survivedMonths > 0 ? `${completedYears} Yrs, ${survivedMonths} Mos` : `${completedYears} Years`;
    }

    const totalGrossPayout = lastOutlook ? lastOutlook.flow.drawn : (data.avgTotalWithdrawals ?? 0);
    const totalTaxesPaid = lastOutlook ? lastOutlook.flow.tax : (data.avgTotalTaxPaid ?? 0);
    const totalNetPayout = lastOutlook ? lastOutlook.flow.netToYou : Math.max(0, totalGrossPayout - totalTaxesPaid);

    const wowInitialCorpusEl = document.getElementById('wowInitialCorpus');
    if (wowInitialCorpusEl) wowInitialCorpusEl.innerText = formatShortRupee(initialCorpus);
    const wowNetPayoutEl = document.getElementById('wowNetPayout');
    if (wowNetPayoutEl) wowNetPayoutEl.innerText = formatShortRupee(totalNetPayout);
    const multiplierBadgeEl = document.getElementById('wowMultiplierBadge');
    if (multiplierBadgeEl) {
      const mult = initialCorpus > 0 ? (totalNetPayout / initialCorpus).toFixed(1) : '0';
      multiplierBadgeEl.innerText = `${mult}x Lifetime Payout`;
    }

    const t2DurationEl = document.getElementById('tier2Duration');
    if (t2DurationEl) t2DurationEl.innerText = durationString;
    const t2GrossEl = document.getElementById('tier2Gross');
    if (t2GrossEl) t2GrossEl.innerText = formatShortRupee(totalGrossPayout);
    const t2TaxesEl = document.getElementById('tier2Taxes');
    if (t2TaxesEl) t2TaxesEl.innerText = formatShortRupee(totalTaxesPaid);
    const t2NetEl = document.getElementById('tier2Net');
    if (t2NetEl) t2NetEl.innerText = formatShortRupee(totalNetPayout);
    const t2BalRemEl = document.getElementById('tier2BalanceRemaining');
    if (t2BalRemEl) t2BalRemEl.innerText = formatShortRupee(balanceRemaining);

    // Sensitivity
    let iwr = (annualWithdrawal / initialCorpus) * 100;
    let netRequired = iwr + expectedInflation;
    let marketVolatility = inputs.annualVolatility;
    
    const volInputEl = document.getElementById('sensVolatilityInput');
    if (volInputEl) volInputEl.innerText = marketVolatility + '%';
    const iwrEl = document.getElementById('sensIWR');
    if (iwrEl) iwrEl.innerText = iwr.toFixed(1) + '%';

    const sensTbody = document.getElementById('sensitivityTableBody');
    if (sensTbody) {
      let tbodyHtml = '';
      [5, 10, 15, 20].forEach(vol => {
        let volDrag = Math.pow(vol, 2) / 200;
        let reqCAGR = (netRequired / (1 - (ltcgTax / 100))) + volDrag;
        let isCurrent = vol === marketVolatility;
        let highlight = isCurrent ? 'bg-gold-50/60 dark:bg-gold-900/20 font-bold' : '';
        let label = vol <= 5 ? 'Bonds' : vol === 10 ? 'Balanced' : vol === 15 ? 'NIFTY 50' : 'Small Cap';
        
        tbodyHtml += `<tr class="${highlight} hover:bg-navy-50 dark:hover:bg-navy-900 transition-colors">
          <td class="py-2 px-3 ${isCurrent ? 'text-gold-700 dark:text-gold-400 font-bold' : 'text-navy-700 dark:text-navy-300'}">${vol}% <span class="font-sans text-xs text-navy-500 dark:text-navy-400 ml-1">(${label})</span></td>
          <td class="py-2 px-3 text-right ${isCurrent ? 'text-gold-700 dark:text-gold-400 font-bold' : 'text-navy-900 dark:text-navy-100'}">${reqCAGR.toFixed(2)}%</td>
        </tr>`;
      });
      sensTbody.innerHTML = tbodyHtml;
    }
    
    const diagnostics = data.diagnostics;
    if (diagnostics) {
      const diagMeanEl = document.getElementById('diagMean');
      const diagMedianEl = document.getElementById('diagMedian');
      const diagStdDevEl = document.getElementById('diagStdDev');
      const diagSkewEl = document.getElementById('diagSkew');
      
      if (diagMeanEl) diagMeanEl.innerText = formatShortRupee(diagnostics.meanFinalBalance);
      if (diagMedianEl) diagMedianEl.innerText = formatShortRupee(data.medianFinalBalance);
      if (diagStdDevEl) diagStdDevEl.innerText = formatShortRupee(diagnostics.stdDevFinalBalance);
      if (diagSkewEl) diagSkewEl.innerText = diagnostics.skewnessFinalBalance.toFixed(2);
    }

    renderScheduleTable(initialMonthly, expectedInflation, annualStepUp, horizonYears, initialCorpus, data.p50, data.medianTaxes, data.medianWithdrawals);
    renderHedgingDashboard(data, inputs);
    currentChart = await createLineChart('swpChart', data, activeViewMode, currentChart);
    currentMicroChart = await createMicroCashflowChart('cashflowMicroChart', data, inputs, currentMicroChart);
  }

  function renderScheduleTable(
    initialMonthly: number, 
    expectedInflation: number, 
    annualStepUp: number, 
    yearsCount: number,
    initialCorpus: number,
    p50Array: number[] = [],
    medianTaxesArray: number[] = [],
    medianWithdrawalsArray: number[] = []
  ) {
    const tableBody = document.getElementById('scheduleTableBody');
    const badgeEl = document.getElementById('scheduleStepUpBadge');
    if (badgeEl) badgeEl.innerText = `+${expectedInflation.toFixed(1)}% Inflation & +${annualStepUp.toFixed(1)}% Step-Up`;
    if (!tableBody) return;

    let html = '';
    let currentMonthly = initialMonthly;
    const escalationFactor = (1 + expectedInflation / 100) * (1 + annualStepUp / 100);

    for (let yr = 1; yr <= yearsCount; yr++) {
      const i = yr - 1;
      let rowBgClass = i % 2 === 1 ? 'bg-navy-50/60 dark:bg-navy-900/40' : 'bg-transparent';

      if (yr > 1) currentMonthly = currentMonthly * escalationFactor;

      const currentBal = (p50Array && p50Array[yr] !== undefined) ? p50Array[yr] : 0;
      const prevBal = (yr === 1) ? initialCorpus : ((p50Array && p50Array[yr - 1] !== undefined) ? p50Array[yr - 1] : 0);

      if (prevBal <= 0 && currentBal <= 0) {
        rowBgClass = 'bg-rose-50 dark:bg-rose-950/30';
        html += `<tr class="${rowBgClass} hover:bg-rose-100 dark:hover:bg-rose-900/50 transition-colors border-b border-rose-200 dark:border-rose-900/50"><td class="py-2.5 px-3 sm:px-4 text-left whitespace-nowrap text-xs font-semibold text-rose-700 dark:text-rose-400">Year ${yr} ⚠️</td><td colspan="5" class="py-2.5 px-3 sm:px-4 text-center whitespace-nowrap text-xs font-medium text-rose-700 dark:text-rose-400">Portfolio Depleted</td></tr>`;
      } else if (prevBal > 0 && currentBal <= 0) {
        rowBgClass = 'bg-rose-50 dark:bg-rose-950/30';
        const netDrawnThisYear = (medianWithdrawalsArray && medianWithdrawalsArray[yr] !== undefined) ? medianWithdrawalsArray[yr] : currentMonthly * 12;
        const taxThisYear = (medianTaxesArray && medianTaxesArray[yr] !== undefined) ? medianTaxesArray[yr] : 0;
        html += `
          <tr class="${rowBgClass} hover:bg-rose-100 dark:hover:bg-rose-900/50 transition-colors border-b border-rose-200 dark:border-rose-900/50">
            <td class="py-2.5 px-3 sm:px-4 text-left whitespace-nowrap text-xs font-bold text-rose-700 dark:text-rose-400">Year ${yr} ⚠️</td>
            <td class="py-2.5 px-3 sm:px-4 text-right whitespace-nowrap text-xs text-rose-700 dark:text-rose-400">${tableFormatter.format(currentMonthly)}</td>
            <td class="py-2.5 px-3 sm:px-4 text-right whitespace-nowrap text-xs text-rose-700 dark:text-rose-400">${tableFormatter.format(netDrawnThisYear)}</td>
            <td class="py-2.5 px-3 sm:px-4 text-right whitespace-nowrap text-xs text-rose-700 dark:text-rose-400">${tableFormatter.format(taxThisYear)}</td>
            <td class="py-2.5 px-3 sm:px-4 text-right whitespace-nowrap text-xs text-rose-700 dark:text-rose-400">₹ 0</td>
            <td class="py-2.5 px-3 sm:px-4 text-right whitespace-nowrap text-xs font-bold text-rose-700 dark:text-rose-400">₹ 0 (Depleted)</td>
          </tr>
        `;
      } else {
        const netDrawnThisYear = (medianWithdrawalsArray && medianWithdrawalsArray[yr] !== undefined) ? medianWithdrawalsArray[yr] : currentMonthly * 12;
        const taxThisYear = (medianTaxesArray && medianTaxesArray[yr] !== undefined) ? medianTaxesArray[yr] : 0;
        const grossDrawn = netDrawnThisYear + taxThisYear;
        const additionsThisYear = Math.max(0, currentBal - (prevBal - grossDrawn));

        html += `
          <tr class="${rowBgClass} hover:bg-navy-100/60 dark:hover:bg-navy-800/50 transition-colors border-b border-navy-100 dark:border-white/5">
            <td class="py-2.5 px-3 sm:px-4 text-left whitespace-nowrap text-xs font-medium text-navy-800 dark:text-navy-200">Year ${yr}</td>
            <td class="py-2.5 px-3 sm:px-4 text-right whitespace-nowrap text-xs text-navy-600 dark:text-navy-400">${tableFormatter.format(currentMonthly)}</td>
            <td class="py-2.5 px-3 sm:px-4 text-right whitespace-nowrap text-xs text-navy-700 dark:text-navy-300 font-medium">${tableFormatter.format(netDrawnThisYear)}</td>
            <td class="py-2.5 px-3 sm:px-4 text-right whitespace-nowrap text-xs text-rose-700 dark:text-rose-400">${tableFormatter.format(taxThisYear)}</td>
            <td class="py-2.5 px-3 sm:px-4 text-right whitespace-nowrap text-xs text-emerald-700 dark:text-emerald-400">+${tableFormatter.format(additionsThisYear)}</td>
            <td class="py-2.5 px-3 sm:px-4 text-right whitespace-nowrap text-xs font-semibold text-navy-900 dark:text-navy-100">${tableFormatter.format(currentBal)}</td>
          </tr>
        `;
      }
    }

    tableBody.innerHTML = html;
  }

  function initWorkerListener() {
    if (subscribed) return;
    subscribed = true;
    window.addEventListener('swp:result', (e) => {
      const d = (e as CustomEvent).detail;
      if (!d?.simulation) return;
      lastWorkerData = d.simulation;
      lastOutlook = d.outlook;
      renderDashboard(d.simulation);
    });
  }

  function initControls() {
    const corpusInput = document.getElementById('initialCorpus') as HTMLInputElement | null;
    const withdrawalInput = document.getElementById('monthlyWithdrawal') as HTMLInputElement | null;
    const runBtn = document.getElementById('runSimBtn');
    const viewPercentilesBtn = document.getElementById('viewPercentilesBtn');
    const viewSamplePathsBtn = document.getElementById('viewSamplePathsBtn');

    if (corpusInput) setupFormattingField(corpusInput, updateDisplayBadges);
    if (withdrawalInput) setupFormattingField(withdrawalInput, updateDisplayBadges);

    runBtn?.addEventListener('click', () => {
      syncEntryFromAdvanced();
      requestRecompute();
    });

    viewPercentilesBtn?.addEventListener('click', async () => {
      activeViewMode = 'percentiles';
      viewPercentilesBtn.className = 'min-h-[32px] px-3 py-1 rounded-md bg-white dark:bg-navy-950 text-navy-900 dark:text-navy-100 font-semibold shadow-2xs transition-colors';
      if (viewSamplePathsBtn) viewSamplePathsBtn.className = 'min-h-[32px] px-3 py-1 rounded-md text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-200 transition-colors';
      if (lastWorkerData) currentChart = await createLineChart('swpChart', lastWorkerData, activeViewMode, currentChart);
    });

    viewSamplePathsBtn?.addEventListener('click', async () => {
      activeViewMode = 'samples';
      viewSamplePathsBtn.className = 'min-h-[32px] px-3 py-1 rounded-md bg-white dark:bg-navy-950 text-navy-900 dark:text-navy-100 font-semibold shadow-2xs transition-colors';
      if (viewPercentilesBtn) viewPercentilesBtn.className = 'min-h-[32px] px-3 py-1 rounded-md text-navy-600 dark:text-navy-400 hover:text-navy-900 dark:hover:text-navy-200 transition-colors';
      if (lastWorkerData) currentChart = await createLineChart('swpChart', lastWorkerData, activeViewMode, currentChart);
    });

    // Market Regime buttons
    const regimeButtons = document.querySelectorAll('.regime-btn');
    const expectedReturnInput = document.getElementById('expectedReturn') as HTMLInputElement | null;
    const annualVolatilityInput = document.getElementById('annualVolatility') as HTMLInputElement | null;
    const regimeNote = document.getElementById('regimeNote');

    function paintRegimeSelection() {
      const cagr = parseFloat(expectedReturnInput?.value || '12.0');
      const vol = parseFloat(annualVolatilityInput?.value || '15.0');
      let matched = false;

      regimeButtons.forEach((b) => {
        const bg = parseFloat(b.getAttribute('data-growth') || '');
        const bv = parseFloat(b.getAttribute('data-roughness') || '');
        if (Math.abs(bg - cagr) < 0.1 && Math.abs(bv - vol) < 0.1) {
          b.className = 'regime-btn px-2.5 py-2 rounded-lg border text-xs font-semibold text-left transition-colors border-gold-500 bg-gold-50/50 dark:bg-gold-950/30 text-gold-700 dark:text-gold-300 ring-1 ring-gold-500';
          matched = true;
        } else {
          b.className = 'regime-btn px-2.5 py-2 rounded-lg border text-xs font-semibold text-left transition-colors border-navy-200 dark:border-navy-700 bg-white dark:bg-navy-950 text-navy-800 dark:text-navy-200 hover:border-navy-300';
        }
      });

      if (regimeNote) {
        if (matched) {
          regimeNote.textContent = 'Selected historical Nifty 50 regime applied.';
        } else {
          regimeNote.textContent = 'Custom return and volatility scenario.';
        }
      }
    }

    regimeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const g = btn.getAttribute('data-growth');
        const v = btn.getAttribute('data-roughness');
        if (g && expectedReturnInput) expectedReturnInput.value = g;
        if (v && annualVolatilityInput) annualVolatilityInput.value = v;
        paintRegimeSelection();
        syncEntryFromAdvanced();
        requestRecompute();
      });
    });

    for (const id of ['expectedReturn', 'annualVolatility']) {
      document.getElementById(id)?.addEventListener('input', paintRegimeSelection);
    }
    paintRegimeSelection();

    const debouncedSimulate = debounce(() => {
      syncEntryFromAdvanced();
      requestRecompute();
    }, 500);

    const swpForm = document.getElementById('swpForm');
    swpForm?.addEventListener('input', () => {
      debouncedSimulate();
    });

    const toggleDiagnosticsBtn = document.getElementById('toggleDiagnosticsBtn');
    toggleDiagnosticsBtn?.addEventListener('click', () => {
      const panel = document.getElementById('diagnosticsPanel');
      if (panel) panel.classList.toggle('hidden');
    });

    const inflationDeflatorToggle = document.getElementById('inflationDeflatorToggle');
    inflationDeflatorToggle?.addEventListener('change', () => {
      if (lastWorkerData) renderDashboard(lastWorkerData);
    });

    document.getElementById('swpJumpAssumptionsBtn')?.addEventListener('click', () => {
      const formDetails = document.querySelectorAll('#swpForm details');
      formDetails.forEach((d) => (d as HTMLDetailsElement).open = true);
      document.getElementById('swpForm')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    document.getElementById('downloadPdfBtn')?.addEventListener('click', async () => {
      const element = document.querySelector('main');
      if (!element) return;

      const opt = {
        margin: 10,
        filename: 'swp_retirement_plan_report.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true },
        jsPDF: { unit: 'mm', format: 'a3', orientation: 'portrait' }
      };

      const btn = document.getElementById('downloadPdfBtn');
      if (btn) btn.innerText = "Generating PDF...";

      try {
        const { default: html2pdf } = await import('html2pdf.js');
        await html2pdf().set(opt).from(element).save();
      } finally {
        if (btn) btn.innerHTML = `
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download PDF Report</span>
        `;
      }
    });
  }

  function checkUrlParamsAndStart() {
    const params = new URLSearchParams(window.location.search);
    if (params.has('initialCorpus') || params.has('monthlyWithdrawal')) {
      revealWorkbench();
    }
  }

  function startApp() {
    initWelcomeState();
    initTabNavigation();
    initWorkerListener();
    initControls();
    updateDisplayBadges();
    checkUrlParamsAndStart();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startApp);
  } else {
    startApp();
  }
</script>
