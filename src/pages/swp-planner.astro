---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardPremium from '../components/CardPremium.astro';
import InputGroup from '../components/InputGroup.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ButtonGold from '../components/ButtonGold.astro';
import { REGIME_PRESETS, DEFAULT_REGIME } from '../utils/regimePresets';
import RetirementAnswer from '../components/Calculators/RetirementAnswer.astro';
import RungTwoRates from '../components/Calculators/RungTwoRates.astro';
import RungMoneyFlow from '../components/Calculators/RungMoneyFlow.astro';
import RungGrowth from '../components/Calculators/RungGrowth.astro';
import RungSequence from '../components/Calculators/RungSequence.astro';
import RungProtection from '../components/Calculators/RungProtection.astro';
import RungExpert from '../components/Calculators/RungExpert.astro';
---

<Layout title="Retirement Withdrawal Planner — SWP Intelligence Engine">
	<Hero
		badge="Retirement Planner"
		title="Will my savings last?"
		description="Tell us three things and we will tell you how long your money lasts — and what to change if the answer is not good enough."
	/>

	<!-- Layer 1: the Answer (sol-019) -->
	<RetirementAnswer />

	<!-- The ladder (dd-002): one question per rung, in the order a reader has
	     them. Each rung subscribes to the same computation, so no two views
	     can disagree. The two-rates rung comes first: it is the model everything
	     else is a push on (dd-005), and it teaches the money distinction the
	     later rungs depend on (dd-004). -->
	<RungTwoRates />
	<RungMoneyFlow />
	<RungGrowth />
	<RungSequence />
	<RungProtection />

	<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-16 sm:pt-6 sm:pb-24">

		<!-- dd-002: this was ONE <details> over ~590 lines. It is now the ladder's
		     last rung, split into three doors named by the question each answers. -->
		<RungExpert>

		<!-- 2-Column Responsive Grid -->
		<div slot="controls">
			<CardPremium glass={true}>
				<div class="pb-4 border-b border-navy-200 dark:border-navy-800 flex items-center justify-between">
					<div>
						<h3 class="text-lg font-bold tracking-tight text-navy-900 dark:text-navy-100">Your Plan Details</h3>
						<p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">Enter your savings, monthly income needs, and growth expectations.</p>
					</div>
				</div>

				<form id="swpForm" onsubmit="event.preventDefault();" class="space-y-6">
					
					<!-- Section 1: Starting Investments -->
					<div class="space-y-4">
						<SectionTitle title="What you have, and what you need" />
						
						<InputGroup 
							id="initialCorpus"
							label="Total Savings / Initial Corpus"
							required={true}
							tooltip="The total lump sum you are starting with today."
							formattedId="corpusFormatted"
							formattedDefault="₹ 1,50,00,000 (1.5 Cr)"
							prefix="₹"
							suffix="INR"
							value="1,50,00,000"
						/>

						<InputGroup 
							id="monthlyWithdrawal"
							label="First Year Monthly Paycheck"
							required={true}
							tooltip="This is your GROSS target. Your actual net-in-hand income will be slightly lower because LTCG taxes will be deducted from the profit portion of this withdrawal."
							formattedId="withdrawalFormatted"
							formattedClass="text-xs text-navy-600 dark:text-navy-400 bg-navy-100 dark:bg-navy-900 border border-navy-200 dark:border-navy-800 px-2 py-0.5 rounded-md font-medium"
							formattedDefault="₹ 40,000 / month"
							prefix="₹"
							suffix="/month"
							value="40,000"
						/>
					</div>

					<hr class="section-divider" />

					<!-- Section 2: Macro Economics & Market Expectations -->
					<div class="space-y-4">
						<SectionTitle title="What you assume the market does" />

						<div class="grid grid-cols-1 sm:grid-cols-2 reveal-stagger gap-6">
							<InputGroup 
								id="expectedInflation"
								label="Expected Inflation %"
								tooltip="The expected annual rate of inflation over your retirement horizon."
								suffix="% / yr"
								type="number"
								value="6.0"
								min="0" max="20" step="0.5" required={true}
							/>

							<InputGroup 
								id="stepUp"
								label="Lifestyle Step-Up %"
								tooltip="Extra annual paycheck increase ON TOP of inflation for lifestyle upgrades. Set to 0 to simply maintain purchasing power."
								suffix="% / yr"
								type="number"
								value="0.0"
								min="0" max="20" step="0.5" required={true}
							/>

							<InputGroup 
								id="expectedReturn"
								label="Expected CAGR %"
								tooltip="Long-term average annual return, including dividends. Pick a period below rather than a number, so the growth and the roughness come from the same world."
								suffix="% cagr"
								type="number"
								value={DEFAULT_REGIME.growth.toFixed(1)}
								min="0" max="30" step="0.5" required={true}
							/>

							<InputGroup 
								id="annualVolatility"
								label="Market Volatility %"
								tooltip="The spread of the Nifty 50's ANNUAL returns. Not the day-to-day figure people quote: over the last 10 years this was 8.9%, but over the last 30 it was 28.4%, and every 30-year stretch on record sits near 29%."
								suffix="% vol"
								type="number"
								value={DEFAULT_REGIME.roughness.toFixed(1)}
								min="5" max="50" step="0.5" required={true}
							/>

							<!-- sol-028. These two numbers used to be typed in, defaulting to
							     12% and 15% with a tooltip asserting "NIFTY 50 is ~15%" as a
							     plain fact. On the actual record 15% describes the calmest
							     decade in thirty-five years. Rahul's call: named periods, so
							     the assumption is chosen rather than inherited. Each sets BOTH
							     numbers, because a regime is a pair. -->
							<div class="sm:col-span-2 space-y-2">
								<div class="flex items-baseline justify-between gap-3">
									<span class="text-[11px] font-bold uppercase tracking-widest text-navy-500 dark:text-navy-400">
										Or take both from a real period
									</span>
									<span class="text-[10px] text-navy-400 dark:text-navy-500">Nifty 50, to {REGIME_PRESETS[0].span.split('\u2013')[1]}</span>
								</div>
								<div id="regimePresets" role="radiogroup" aria-label="Take growth and roughness from a real period"
									 class="grid grid-cols-3 gap-1.5">
									{REGIME_PRESETS.map((p) => (
										<button type="button" role="radio" data-regime={p.id}
												data-growth={String(p.growth)} data-roughness={String(p.roughness)}
												class="regime-btn border border-navy-200 dark:border-navy-800 rounded p-1.5 text-left transition-colors hover:bg-navy-100 dark:hover:bg-navy-800">
											<span class="block text-[9px] font-bold uppercase text-navy-700 dark:text-navy-300">{p.label.replace('The last ', '')}</span>
											<span class="block text-[10px] tabular-nums text-navy-500 dark:text-navy-400">{p.growth}% · {p.roughness}% swings</span>
										</button>
									))}
								</div>
								<p id="regimeNote" class="text-[10px] leading-relaxed text-navy-500 dark:text-navy-400"></p>
							</div>
						</div>
					</div>

					<hr class="section-divider" />

					<!-- Section 3: Tax Friction & Horizon -->
					<div class="space-y-4">
						<SectionTitle title="Tax, and how long it must last" />

						<div class="grid grid-cols-1 sm:grid-cols-2 reveal-stagger gap-6">
							<InputGroup 
								id="ltcgTax"
								label="LTCG Tax Rate %"
								tooltip="Long Term Capital Gains tax. This friction is only applied to your profits, not your original invested capital."
								suffix="% tax"
								type="number"
								value="12.5"
								min="0" max="50" step="0.1" required={true}
							/>

							<InputGroup 
								id="horizonYears"
								label="Retirement Length"
								tooltip="The total number of years you plan to withdraw monthly paychecks during your retirement."
								suffix="years"
								type="number"
								value="30"
								min="5" max="50" step="1" required={true}
							/>
						</div>
					</div>
					
					<hr class="section-divider" />
					
					<!-- Guardrails control removed on Rahul's instruction, 15 Aug. The
					     engine still supports useGuardrails and surfaceParity still
					     sweeps it; nothing on the page sets it, so it is now always
					     off. Removing the capability too would have been a bigger
					     decision than the one he made. -->

					<!-- Section 05: Portfolio Insurance (Hedging) -->
					<div class="space-y-4">
						<SectionTitle title="Whether you buy a floor" />
						<div class="flex items-center justify-between gap-3">
							<span class="text-xs font-semibold text-navy-800 dark:text-navy-200">
								Buy Portfolio Insurance
							</span>
							<label class="relative inline-flex items-center cursor-pointer shrink-0">
								<input type="checkbox" id="bsHedgingToggle" name="bsHedgingToggle" class="sr-only peer">
								<div class="w-11 h-6 bg-navy-200 dark:bg-navy-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-navy-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 dark:peer-checked:bg-emerald-500"></div>
							</label>
						</div>
						<p class="text-xs text-navy-500 dark:text-navy-400 leading-relaxed">
							You buy portfolio insurance. You agree to permanently sacrifice a small percentage of your returns every year to pay the premium. In exchange, your portfolio is guaranteed to never drop more than your protected floor, meaning you rarely have to take a pay cut.
						</p>
						<div class="grid grid-cols-1 sm:grid-cols-2 reveal-stagger gap-6">
							<InputGroup 
								id="hedgingDragCost"
								label="Premium Drag"
								tooltip="Priced, not chosen: Black-Scholes on the floor depth and the roughness above, at implied volatility. A floor you could set a price for independently would be a contract nobody would write."
								suffix="% / yr"
								type="number"
								value="1.85"
								min="0" max="10" step="0.05" required={true}
							readonly={true}
							/>

							<InputGroup 
								id="hedgingFloorLimit"
								label="Protected Floor"
								tooltip="The maximum portfolio drop allowed before the insurance pays out."
								suffix="% drop"
								type="number"
								value="-10"
								max="0" min="-50" step="1" required={true}
							/>
						</div>
					</div>

					<div class="pt-2">
						<ButtonGold id="runSimBtn">
							<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
							<span class="text-sm font-semibold">Stress-Test Your Retirement (10,000 Scenarios)</span>
						</ButtonGold>
					</div>

					<div id="inputSanityWarning" class="hidden mt-4 p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 rounded-lg text-xs text-amber-800 dark:text-amber-300 leading-relaxed font-sans flex items-start gap-2">
						<svg class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
						<span id="inputSanityMessage"></span>
					</div>
				</form>
			</CardPremium>
		</div>

		<div slot="results">
			<section class="space-y-6">
				
				<!-- Modern Tabbed Navigation Header -->
				<div class="flex items-center justify-between border-b border-navy-200 dark:border-white/10 pb-px">
					<div class="flex items-center gap-6">
						<button id="tabPlanSummaryBtn" type="button" class="min-h-[44px] pb-3 text-sm font-bold text-navy-900 dark:text-navy-100 border-b-2 border-gold-500 transition-all cursor-pointer flex items-center">
							Plan Summary
						</button>
						<button id="tabScheduleBtn" type="button" class="min-h-[44px] pb-3 text-sm font-semibold text-navy-500 hover:text-navy-800 dark:text-navy-400 dark:hover:text-navy-200 border-b-2 border-transparent transition-all cursor-pointer flex items-center">
							Yearly Paycheck Schedule
						</button>
					</div>
					<button id="downloadPdfBtn" type="button" class="btn-ghost px-3 py-1 text-[10px] uppercase tracking-widest cursor-pointer border border-navy-200 dark:border-navy-800 rounded mb-2 hover:bg-navy-100 dark:hover:bg-navy-800 transition-colors">
						↓ Download PDF Report
					</button>
				</div>

				<!-- View 1: Plan Summary Tab Content -->
				<div id="viewPlanSummary" class="space-y-6">
					<CardPremium glass={true}>
						
						<!-- Actionable Portfolio Health & Endurance Hero Section -->
						<div class="pb-6 border-b border-navy-200 dark:border-white/10 space-y-3">
							<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
								<div>
									<h3 class="text-xl font-bold tracking-tight text-navy-900 dark:text-navy-100">The Survival Score</h3>
									<p class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">Probability of your money lasting all 30 years without running out.</p>
								</div>
								<div class="flex items-center gap-2 self-start sm:self-auto flex-wrap justify-end">
									<div id="portfolioEnduranceHero" class="text-3xl sm:text-4xl font-extrabold stat-value tracking-tight font-sans text-navy-900 dark:text-navy-100">--</div>
									<div id="guardrailsActiveBadge" class="hidden px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md badge-safe">LIFESTYLE SACRIFICE ACTIVE</div>
									<div id="portfolioHealthBadge" class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-md badge-warning">CALCULATING</div>
								</div>
							</div>
							<p id="portfolioRealityCheck" class="text-xs sm:text-sm text-navy-600 dark:text-navy-400 leading-relaxed font-sans pt-1">
								Running 10,000 market stress tests...
							</p>

							<!-- Lifestyle Alert Box -->
							<div id="lifestyleSacrificeAlertBox" class="hidden mt-4 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/30 rounded-lg space-y-2.5 transition-colors duration-200">
								<div class="flex items-center gap-2">
									<svg id="sacrificeIcon" class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
									</svg>
									<h4 id="sacrificeTitle" class="text-xs font-bold text-amber-900 dark:text-amber-200 uppercase tracking-wider">Lifestyle Degradation Alert</h4>
								</div>
								<div class="space-y-2 text-xs text-amber-800 dark:text-amber-300 leading-relaxed font-sans">
									<p id="sacrificeMetric1">To force your portfolio to survive, the system withheld <strong id="valSacrificeTotalCash" class="font-bold stat-value text-amber-950 dark:text-amber-100">--</strong> in planned lifetime income.</p>
									<p id="sacrificeMetric2">At its lowest point, your income dropped to the equivalent purchasing power of just <strong id="valSacrificeRockBottom" class="font-bold stat-value text-amber-950 dark:text-amber-100">--</strong> in today's money.</p>
								</div>
							</div>

							<!-- Guardrail Weather Forecast Grid -->
							<div id="weatherForecastContainer" class="hidden mt-4 p-4 sm:p-5 card-premium rounded-2xl space-y-3">
								<div class="flex items-center justify-between">
									<h4 class="text-xs font-bold text-navy-800 dark:text-navy-200 uppercase tracking-wider">30-Year Retirement Weather</h4>
									<div class="flex items-center gap-3 text-[10px] font-medium text-navy-500 dark:text-navy-400">
										<span class="flex items-center gap-1"><span class="w-2 h-2 rounded bg-emerald-500/80"></span> Full Paycheck</span>
										<span class="flex items-center gap-1"><span class="w-2 h-2 rounded bg-amber-500/90 animate-pulse"></span> Pay Cut</span>
									</div>
								</div>
								<p class="text-xs text-navy-500 dark:text-navy-400">Visualizing the exact years your paycheck is curtailed.</p>
								<div id="weatherGrid" class="grid grid-cols-10 sm:grid-cols-15 gap-1.5 pt-2"></div>
							</div>
						</div>

						<!-- CONSOLIDATED 3-TIER DASHBOARD BANNER -->
						<div id="wowMetricBanner" class="relative overflow-hidden rounded-xl bg-white dark:bg-navy-950 border border-navy-200 dark:border-navy-800 p-6 sm:p-7 space-y-5">
							<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-navy-200 dark:border-navy-800">
								<div>
									<span class="text-xs font-semibold uppercase tracking-wider text-navy-900 dark:text-navy-100">Total Lifetime After-Tax Cash Flow</span>
									<div class="text-xs text-navy-500 dark:text-navy-400 mt-0.5">Your initial investment vs. total net paychecks collected over retirement</div>
								</div>
								<div id="wowMultiplierBadge" class="self-start sm:self-auto badge-safe text-xs font-bold px-3 py-1 rounded-md">--x Lifetime Payout</div>
							</div>

							<div class="grid grid-cols-1 sm:grid-cols-2 reveal-stagger gap-6 items-baseline">
								<div>
									<div class="text-xs font-medium text-navy-500 dark:text-navy-400">You Started With</div>
									<div id="wowInitialCorpus" class="text-2xl font-bold stat-value text-navy-900 dark:text-navy-100 mt-0.5 font-sans">--</div>
								</div>
								<div>
									<div class="text-xs font-medium text-gold-500 dark:text-gold-400">You Received (After Taxes)</div>
									<div id="wowNetPayout" class="text-3xl sm:text-4xl font-extrabold stat-value text-gold-500 dark:text-gold-400 mt-0.5 font-sans tracking-tight">--</div>
								</div>
							</div>

							<div class="card-premium rounded-2xl p-4 mt-2">
								<div class="grid grid-cols-2 md:grid-cols-5 reveal-stagger gap-6">
									<div><div class="stat-label uppercase tracking-wider">Duration</div><div id="tier2Duration" class="text-sm sm:text-base font-bold text-navy-900 dark:text-navy-100">--</div></div>
									<div><div class="stat-label uppercase tracking-wider">Total Gross</div><div id="tier2Gross" class="text-sm sm:text-base font-bold text-navy-900 dark:text-navy-100">--</div></div>
									<div>
										<div class="stat-label text-rose-600 dark:text-rose-400 uppercase tracking-wider flex items-center gap-1">
											Taxes Paid
											<button type="button" id="toggleTaxFormulaBtn" class="text-rose-400 hover:text-rose-600 dark:text-rose-500 dark:hover:text-rose-300">
												<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
											</button>
										</div>
										<div id="tier2Taxes" class="text-sm sm:text-base font-bold text-rose-600 dark:text-rose-400">--</div>
									</div>
									<div><div class="stat-label text-gold-500 dark:text-gold-400 uppercase tracking-wider">Net In-Hand</div><div id="tier2Net" class="text-sm sm:text-base font-bold text-gold-500 dark:text-gold-400">--</div></div>
									<div><div class="stat-label text-gold-500 dark:text-gold-400 uppercase tracking-wider">Bal Remaining</div><div id="tier2BalanceRemaining" class="text-sm sm:text-base font-bold text-gold-500 dark:text-gold-400">--</div></div>
									
									<div id="taxFormulaPanel" class="hidden col-span-2 md:col-span-5 mt-1 p-4 bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 rounded-lg text-xs font-sans text-navy-700 dark:text-navy-300">
										<div class="font-bold text-navy-900 dark:text-navy-100 mb-2">How are taxes calculated?</div>
										<div class="space-y-2">
											<p>Taxes are calculated yearly on the portfolio's growth.</p>
											<div class="bg-white dark:bg-navy-900 p-3 rounded border border-navy-200 dark:border-navy-800 font-mono text-[10px] sm:text-xs text-navy-800 dark:text-navy-200 overflow-x-auto">
												<div class="mb-1 text-navy-500 dark:text-navy-400">// 1. Determine capital gains ratio for the year</div>
												<div>CapitalGain = Max(0, CurrentBalance - CostBasis)</div>
												<div class="mb-2">GainRatio = CapitalGain / CurrentBalance</div>
												
												<div class="mb-1 text-navy-500 dark:text-navy-400">// 2. Apply ratio to the withdrawal</div>
												<div>TaxableGain = WithdrawalAmount × GainRatio</div>
												
												<div class="mb-1 text-navy-500 dark:text-navy-400">// 3. Calculate Long-Term Capital Gains Tax (LTCG)</div>
												<div>AnnualTax = TaxableGain × 12.5%</div>
											</div>
											<p class="text-[10px] text-navy-500 dark:text-navy-400 pt-1">*The Cost Basis is dynamically adjusted downwards as you withdraw the principal portion.</p>
										</div>
									</div>
								</div>
							</div>

							<div id="guardrailsLowestPaycheckRow" class="hidden card-premium rounded-2xl p-3.5 mt-2 flex flex-col lg:flex-row lg:items-center justify-between gap-3 text-xs">
								<div class="flex items-center gap-2 text-emerald-700 dark:text-emerald-400 shrink-0"><span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span><span class="font-semibold">Dynamic Guardrails Active</span></div>
								<div class="font-sans flex flex-wrap items-center gap-3 text-navy-600 dark:text-navy-400">
									<div>Min Paycheck: <span id="valLowestPaycheck" class="text-navy-900 dark:text-navy-100 font-bold">--</span></div><span class="text-navy-300 dark:text-navy-700 hidden sm:inline">•</span>
									<div>Real Floor: <span id="valRockBottom" class="text-amber-700 dark:text-amber-400 font-bold">--</span></div><span class="text-navy-300 dark:text-navy-700 hidden sm:inline">•</span>
									<div>Lifetime Sacrifice: <span id="valSacrifice" class="text-rose-600 dark:text-rose-400 font-bold">--</span></div>
								</div>
							</div>

							<div class="bg-navy-50 dark:bg-navy-900 border-t border-navy-200 dark:border-navy-800 rounded-b-lg -mx-6 -mb-6 sm:-mx-7 sm:-mb-7 p-4 text-xs flex items-start gap-3">
								<svg class="w-4 h-4 text-gold-500 dark:text-gold-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
								<div id="tier3ActionableFooter" class="leading-relaxed font-sans text-navy-600 dark:text-navy-400">Calculating actionable financial guidance...</div>
